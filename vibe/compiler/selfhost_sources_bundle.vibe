 emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./backend_builtins_array_alloc.vibe {\\n  gc_gen_arr_len_body, gc_gen_arr_new_body\\n}\\n\\nimport ./backend_builtins_array_get.vibe {\\n  gc_gen_arr_get_body\\n}\\n\\nimport ./backend_builtins_array_push.vibe {\\n  gc_gen_arr_push_body\\n}\\n\\nimport ./backend_builtins_array_set.vibe {\\n  gc_gen_arr_set_body\\n}\\n\\nimport ./backend_builtins_numeric.vibe {\\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\\n}\\n\\nimport ./backend_builtins_print.vibe {\\n  gc_gen_print_i64_body, gc_gen_print_str_body\\n}\\n\\nimport ./backend_builtins_string.vibe {\\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\\n}\\n\\nimport ./backend_builtins_string_extra.vibe {\\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\\n}\\n\\n//# Functions\\n\\n// The storage index of struct field `field`, mirroring the field-access lookup\\n// in backend_expr (search the struct-field-name matrix; first struct that\\n// declares the field wins). A struct lays its fields out like a constructor —\\n// field i at `8 + i*8`, pointer tag-cleared — so the offset is `8 + index*8`,\\n// identical to what `obj.field` reads.\\nlet field_index_in_gc: (Array[String], String) -> Int = (fnames, field) -> {\\n  let mut fi = 0\\n  let mut found = -1\\n  while fi < Array::length(fnames) {\\n    if Array::get(fnames, fi) == field {\\n      found = fi\\n      fi = Array::length(fnames)\\n    } else {\\n      fi = fi + 1\\n    }\\n  }\\n  found\\n}\\n\\n// The index of `field` WITHIN the struct named `sname`. The matched struct name\\n// MUST drive the lookup: two structs can share a field name at different\\n// positions (`A { x; y }` vs `B { y; x }`), so a name-agnostic scan binds the\\n// wrong offset. Falls back to a global first-match scan only when `sname` is\\n// absent from the table.\\nlet struct_field_index_gc: (CompileCtxGc, String, String) -> Int with { Error } = (ctx, sname, field) -> {\\n  let names = ctx.ctor_table.struct_names\\n  let mut si = 0\\n  let mut sidx = -1\\n  while si < Array::length(names) {\\n    if Array::get(names, si) == sname {\\n      sidx = si\\n      si = Array::length(names)\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  if sidx >= 0 {\\n    let found = field_index_in_gc(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\\n    if found < 0 {\\n      throw(String::concat(String::concat(String::concat(\\\"unknown field `\\\", field), \\\"` in struct \\\"), sname))\\n    } else {\\n      found\\n    }\\n  } else {\\n    let mut gsi = 0\\n    let mut gfound = -1\\n    while gsi < Array::length(names) {\\n      let f = field_index_in_gc(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\\n      if f >= 0 {\\n        gfound = f\\n        gsi = Array::length(names)\\n      } else {\\n        gsi = gsi + 1\\n      }\\n    }\\n    if gfound < 0 {\\n      throw(String::concat(\\\"unknown struct field in pattern: \\\", field))\\n    } else {\\n      gfound\\n    }\\n  }\\n}\\n\\nlet compile_match_gc: (Bytes, Expr, Array[(Pat, Expr)], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, scrutinee, arms, local_names, next_local, ctx, ld, ce) -> {\\n  let scrut_local = next_local\\n  Array::push(local_names, \\\"__match_scrut\\\")\\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\\n  emit_local_set(buf, scrut_local)\\n  let num_arms = Array::length(arms)\\n  let catchall_idx = find_catchall_idx(arms)\\n  let num_cond_arms = catchall_idx\\n  let mut max_nl = nl1\\n  let mut ai = 0\\n  while ai < num_cond_arms {\\n    let (p, _) = Array::get(arms, ai)\\n    match p {\\n      PInt(n) => {\\n        emit_local_get(buf, scrut_local)\\n        emit_i64_const(buf, n)\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n        0\\n      },\\n      PBool(bv) => {\\n        emit_local_get(buf, scrut_local)\\n        emit_i64_const(buf, if bv {\\n          1\\n        } else {\\n          0\\n        })\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n        0\\n      },\\n      PCtor(cname_cond, _) => {\\n        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\\n        let expected_tag = if ctor_ci >= 0 {\\n          Array::get(ctx.ctor_table.tags, ctor_ci)\\n        } else {\\n          -1\\n        }\\n        emit_local_get(buf, scrut_local)\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_load(buf, 2, 0)\\n        emit_i32_const(buf, expected_tag)\\n        emit_i32_eq(buf)\\n        emit_if_i64(buf)\\n        0\\n      },\\n      PString(sval) => {\\n        let str_idx = str_table_lookup(ctx.str_table.strs, sval)\\n        if str_idx >= 0 {\\n          emit_local_get(buf, scrut_local)\\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\\n          emit_call(buf, 4)\\n          emit_i64_const(buf, 1)\\n          emit_i64_eq(buf)\\n          emit_if_i64(buf)\\n        }\\n        0\\n      },\\n      _ => 0\\n    }\\n    let names_len_at_arm = Array::length(local_names)\\n    let (p2, arm_body) = Array::get(arms, ai)\\n    let ld_arm = if ld >= 0 {\\n      ld + ai + 1\\n    } else {\\n      -1\\n    }\\n    match p2 {\\n      PCtor(_, cargs_bind) => {\\n        let mut cbi = 0\\n        while cbi < Array::length(cargs_bind) {\\n          match Array::get(cargs_bind, cbi) {\\n            PBind(pname) => {\\n              let fl = Array::length(local_names)\\n              emit_local_get(buf, scrut_local)\\n              emit_i64_const(buf, -2)\\n              emit_i64_and(buf)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, 8 + cbi * 8)\\n              emit_local_set(buf, fl)\\n              Array::push(local_names, pname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => 0\\n          }\\n          cbi = cbi + 1\\n        }\\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\\n        if arm_nl > max_nl {\\n          max_nl = arm_nl\\n        }\\n        0\\n      },\\n      PTuple(tpats) => {\\n        let mut tbi = 0\\n        while tbi < Array::length(tpats) {\\n          match Array::get(tpats, tbi) {\\n            PBind(tname) => {\\n              let tl = Array::length(local_names)\\n              emit_local_get(buf, scrut_local)\\n              emit_i64_const(buf, -2)\\n              emit_i64_and(buf)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, 8 + tbi * 8)\\n              emit_local_set(buf, tl)\\n              Array::push(local_names, tname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => 0\\n          }\\n          tbi = tbi + 1\\n        }\\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\\n        if arm_nl > max_nl {\\n          max_nl = arm_nl\\n        }\\n        0\\n      },\\n      PBind(bname_arm) => {\\n        let bl = Array::length(local_names)\\n        emit_local_get(buf, scrut_local)\\n        emit_local_set(buf, bl)\\n        Array::push(local_names, bname_arm)\\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\\n        if arm_nl > max_nl {\\n          max_nl = arm_nl\\n        }\\n        0\\n      },\\n      _ => {\\n        let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)\\n        if arm_nl > max_nl {\\n          max_nl = arm_nl\\n        }\\n        0\\n      }\\n    }\\n    emit_else(buf)\\n    Array::truncate(local_names, names_len_at_arm)\\n    ai = ai + 1\\n  }\\n  let ld_catch = if ld >= 0 {\\n    ld + num_cond_arms\\n  } else {\\n    -1\\n  }\\n  let _names_len_at_catch = Array::length(local_names)\\n  if catchall_idx < num_arms {\\n    let (cp, cbody) = Array::get(arms, catchall_idx)\\n    let catch_nl = match cp {\\n      PBind(bname) => {\\n        let bind_local = Array::length(local_names)\\n        emit_local_get(buf, scrut_local)\\n        emit_local_set(buf, bind_local)\\n        Array::push(local_names, bname)\\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n      },\\n      PCtor(_cname, cargs) => {\\n        let mut cbi2 = 0\\n        while cbi2 < Array::length(cargs) {\\n          match Array::get(cargs, cbi2) {\\n            PBind(pname) => {\\n              let fl2 = Array::length(local_names)\\n              emit_local_get(buf, scrut_local)\\n              emit_i64_const(buf, -2)\\n              emit_i64_and(buf)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, 8 + cbi2 * 8)\\n              emit_local_set(buf, fl2)\\n              Array::push(local_names, pname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => 0\\n          }\\n          cbi2 = cbi2 + 1\\n        }\\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n      },\\n      PTuple(pats) => {\\n        let ptr_local2 = Array::length(local_names)\\n        emit_local_get(buf, scrut_local)\\n        emit_local_set(buf, ptr_local2)\\n        Array::push(local_names, \\\"__tup_ptr2\\\")\\n        let mut pi2 = 0\\n        while pi2 < Array::length(pats) {\\n          let tp = Array::get(pats, pi2)\\n          match tp {\\n            PBind(pname) => {\\n              let field_l = Array::length(local_names)\\n              emit_local_get(buf, ptr_local2)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, pi2 * 8)\\n              emit_local_set(buf, field_l)\\n              Array::push(local_names, pname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => throw(\\\"unsupported pattern in tuple destructure\\\")\\n          }\\n          pi2 = pi2 + 1\\n        }\\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n      },\\n      PStruct(__sname, sfields) => {\\n        // An irrefutable struct pattern `S::{ x, y }` as the catch-all arm: bind\\n        // every field by NAME from the scrutinee struct pointer (offset from the\\n        // field-name table, so pattern order is independent of declaration).\\n        let sp_ptr = Array::length(local_names)\\n        emit_local_get(buf, scrut_local)\\n        emit_local_set(buf, sp_ptr)\\n        Array::push(local_names, \\\"__struct_ptr\\\")\\n        let mut sfi = 0\\n        while sfi < Array::length(sfields) {\\n          let (fname, subpat) = Array::get(sfields, sfi)\\n          match subpat {\\n            PBind(pname) => {\\n              let off = 8 + struct_field_index_gc(ctx, __sname, fname) * 8\\n              let fl = Array::length(local_names)\\n              emit_local_get(buf, sp_ptr)\\n              emit_i64_const(buf, -2)\\n              emit_i64_and(buf)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, off)\\n              emit_local_set(buf, fl)\\n              Array::push(local_names, pname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => 0\\n          }\\n          sfi = sfi + 1\\n        }\\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n      },\\n      _ => ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n    }\\n    if catch_nl > max_nl {\\n      max_nl = catch_nl\\n    }\\n    0\\n  } else {\\n    bytebuf_push(buf, 0)\\n    0\\n  }\\n  let mut ci2 = 0\\n  while ci2 < num_cond_arms {\\n    emit_end(buf)\\n    ci2 = ci2 + 1\\n  }\\n  while Array::length(local_names) < max_nl {\\n    Array::push(local_names, \\\"\\\")\\n  }\\n  max_nl\\n}\\n\\n//# Misc\\n\\nexport {\\n  compile_match_gc\\n}\\n\")\n}\n\nlet cli_adapter_source_108 = () -> (String, String) {\n  (\"vibe/compiler/codegen/gc/backend_lambda_ctx.vibe\",\n\"//# Imports\\n\\nimport .. / common_base {\\n  CompileCtxGc\\n}\\n\\n//# Functions\\n\\nlet make_lambda_ctx_gc: (CompileCtxGc, Array[String], Array[Int]) -> CompileCtxGc = (ctx, ref_cell_names, ref_local_indices) -> {\\n  CompileCtxGc::{\\n    func_table: ctx.func_table, str_table: ctx.str_table,\\n    lambda_table: ctx.lambda_table,\\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\\n    ref_cell_names: ref_cell_names, ref_local_indices: ref_local_indices,\\n    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,\\n    ctor_table: ctx.ctor_table\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  make_lambda_ctx_gc\\n}\\n\")\n}\n\nlet cli_adapter_source_109 = () -> (String, String) {\n  (\"vibe/compiler/codegen/gc/backend_lambda_emit.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_new\\n}\\n\\nimport .. / common_analysis {\\n  emit_i64_extend_i32_u\\n}\\n\\nimport .. / common_base {\\n  emit_i64_store, resolve_local\\n}\\n\\nimport .. / wasm_emit {\\n  emit_global_get, emit_global_set, emit_i32_add, emit_i32_const, emit_i32_store, emit_i32_wrap_i64, emit_i64_const, emit_i64_or, emit_local_get, emit_local_tee\\n}\\n\\n//# Functions\\n\\nlet emit_lambda_closure_gc: (Bytes, Array[String], Int, Array[String], Int, Int) -> Int with { Error } = (buf, captures, num_captures, local_names, next_local, table_slot) -> {\\n  if num_captures == 0 {\\n    emit_i64_const(buf, (table_slot<<2)|2)\\n    next_local\\n  } else {\\n    let alloc_size = 8 + num_captures * 8\\n    let ptr_local = next_local\\n    let nl2 = next_local + 1\\n    Array::push(local_names, \\\"__closure_ptr\\\")\\n    emit_global_get(buf, 0)\\n    emit_i64_extend_i32_u(buf)\\n    emit_local_tee(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, alloc_size)\\n    emit_i32_add(buf)\\n    emit_global_set(buf, 0)\\n    // #415: gc-lane heap bump must grow linear memory like the linear\\n    // backend does -- without this any allocation past the initial page\\n    // traps OOB (the gc smoke fixture only ever allocated a few bytes).\\n    emit_heap_memory_grow_check(buf)\\n    emit_local_get(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, table_slot)\\n    emit_i32_store(buf, 2, 0)\\n    emit_local_get(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, num_captures)\\n    emit_i32_store(buf, 2, 4)\\n    let mut csi = 0\\n    while csi < num_captures {\\n      let cap_name = Array::get(captures, csi)\\n      let cap_idx = resolve_local(local_names, cap_name, \\\"gc_cap\\\")\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, cap_idx)\\n      emit_i64_store(buf, 3, 8 + csi * 8)\\n      csi = csi + 1\\n    }\\n    emit_local_get(buf, ptr_local)\\n    emit_i64_const(buf, 1)\\n    emit_i64_or(buf)\\n    nl2\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_lambda_closure_gc\\n}\\n\")\n}\n\nlet cli_adapter_source_110 = () -> (String, String) {\n  (\"vibe/compiler/codegen/gc/backend_lambda_sig.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr\\n}\\n\\nimport .. / common_base {\\n  CompileCtxGc\\n}\\n\\n//# Types\\n\\nexport type CompileLambdaGcFn = (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }\\n\")\n}\n\nlet cli_adapter_source_111 = () -> (String, String) {\n  (\"vibe/compiler/codegen/gc/backend_lambda_body.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, TypeExpr\\n}\\n\\nimport .. / common_base {\\n  CompileCtxGc\\n}\\n\\nimport ./backend_lambda_collect.vibe {\\n  collect_lambda_captures_gc\\n}\\n\\nimport ./backend_lambda_emit.vibe {\\n  emit_lambda_closure_gc\\n}\\n\\nimport ./backend_lambda_inner.vibe {\\n  compile_lambda_inner_gc\\n}\\n\\nimport ./backend_lambda_record.vibe {\\n  record_lambda_meta_gc\\n}\\n\\nimport ./backend_lambda_sig.vibe {\\n  CompileLambdaGcFn\\n}\\n\\n//# Functions\\n\\nexport let compile_lambda_gc: (Bytes, Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtxGc, Int, CompileLambdaGcFn) -> Int with { Error } = (buf, params, fn_body, local_names, next_local, ctx, ld, compile_fn) -> {\\n  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)\\n  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)\\n  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)\\n  let table_slot = ctx.num_user_funcs + lambda_idx\\n  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)\\n}\\n\")\n}\n\nlet cli_adapter_source_112 = () -> (String, String) {\n  (\"vibe/compiler/codegen/gc/backend_lambda_collect.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, TypeExpr\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars\\n}\\n\\nimport .. / common_base {\\n  CompileCtxGc, CtorTable, FuncTable\\n}\\n\\n//# Functions\\n\\nexport let collect_lambda_captures_gc: (Array[(String, Option[TypeExpr])], Expr, CompileCtxGc) -> (Array[String], Int, Int) = (params, fn_body, ctx) -> {\\n  let param_names_arr = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let func_table = ctx.func_table\\n  let ctor_table = ctx.ctor_table\\n  let mut pi = 0\\n  while pi < Array::length(params) {\\n    let (pname, _) = Array::get(params, pi)\\n    Array::push(param_names_arr, pname)\\n    pi = pi + 1\\n  }\\n  let fn_and_ctor = Array::concat(func_table.names, ctor_table.names)\\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\\n  let num_captures = Array::length(captures)\\n  let user_params = Array::length(params)\\n  (captures, num_captures, user_params)\\n}\\n\")\n}\n\nlet cli_adapter_source_113 = () -> (String, String) {\n  (\"vibe/compiler/codegen/gc/backend_lambda_inner.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, TypeExpr, bytebuf_new\\n}\\n\\nimport .. / common_base {\\n  CompileCtxGc, emit_i64_load\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str\\n}\\n\\nimport .. / wasm_emit {\\n  emit_i32_wrap_i64, emit_local_get, emit_local_set\\n}\\n\\nimport ./backend_lambda_ctx.vibe {\\n  make_lambda_ctx_gc\\n}\\n\\nimport ./backend_lambda_sig.vibe {\\n  CompileLambdaGcFn\\n}\\n\\n//# Functions\\n\\nexport let compile_lambda_inner_gc: (Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtxGc, CompileLambdaGcFn, Int) -> (Bytes, Int) with { Error } = (params, fn_body, captures, user_params, ctx, compile_fn, ld) -> {\\n  let lam_buf = bytebuf_new()\\n  let lam_locals = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut lpi = 0\\n  while lpi < user_params {\\n    let (lpname, _) = Array::get(params, lpi)\\n    Array::push(lam_locals, lpname)\\n    lpi = lpi + 1\\n  }\\n  Array::push(lam_locals, \\\"__env\\\")\\n  let env_param_idx = user_params\\n  let lam_nl_start = user_params + 1\\n  let lam_ref_cells = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_ref_local_indices = Array::slice([\\n    0\\n  ], 0, 0)\\n  let num_captures = Array::length(captures)\\n  let mut ci3 = 0\\n  let mut lam_nl = lam_nl_start\\n  while ci3 < num_captures {\\n    let cap_local = lam_nl\\n    let cap_name = Array::get(captures, ci3)\\n    emit_local_get(lam_buf, env_param_idx)\\n    emit_i32_wrap_i64(lam_buf)\\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\\n    emit_local_set(lam_buf, cap_local)\\n    Array::push(lam_locals, cap_name)\\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\\n      Array::push(lam_ref_cells, cap_name)\\n    }\\n    lam_nl = lam_nl + 1\\n    ci3 = ci3 + 1\\n  }\\n  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)\\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)\\n  (lam_buf, final_lam_nl)\\n}\\n\")\n}\n\nlet cli_adapter_source_114 = () -> (String, String) {\n  (\"vibe/compiler/codegen/gc/backend_lambda_record.vibe\",\n\"//# Imports\\n\\nimport .. / common_base {\\n  CompileCtxGc, LambdaTable\\n}\\n\\n//# Functions\\n\\nexport let record_lambda_meta_gc: (CompileCtxGc, Bytes, Int, Array[String], Int) -> Int = (ctx, lam_buf, user_params, captures, final_lam_nl) -> {\\n  let lambda_table = ctx.lambda_table\\n  let lambda_idx = Array::length(lambda_table.bodies)\\n  Array::push(lambda_table.bodies, lam_buf)\\n  Array::push(lambda_table.param_counts, user_params + 1)\\n  Array::push(lambda_table.captures, captures)\\n  let mut extra_lam = 0\\n  let min_lam_nl = user_params + 1\\n  if final_lam_nl > min_lam_nl {\\n    extra_lam = final_lam_nl - min_lam_nl\\n  }\\n  Array::push(lambda_table.meta_i32, 0)\\n  Array::push(lambda_table.meta_i64, extra_lam)\\n  lambda_idx\\n}\\n\")\n}\n\nlet cli_adapter_source_115 = () -> (String, String) {\n  (\"vibe/compiler/codegen/index.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Stmt\\n}\\n\\nimport ./common_base/index.vibe {\\n  DbgProv\\n}\\n\\nimport ./expr/index.vibe {\\n  compile_module_expr\\n}\\n\\nimport ./wasi/index.vibe {\\n  compile_wasi_module_impl,\\n  compile_wasi_module_coverage_impl,\\n  compile_wasi_module_trace_impl,\\n  compile_wasi_module_break_impl,\\n  compile_wasi_module_with_sources_impl,\\n  compile_wasi_module_rc_impl\\n}\\n\\n//# Functions\\n\\nexport let compile_module: (Array[Stmt]) -> Bytes with { Error } = (stmts) -> {\\n  compile_module_expr(stmts)\\n}\\n\\nexport let compile_wasi_module_with_sources: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {\\n  compile_wasi_module_with_sources_impl(stmts, entry_name, selfhost_srcs)\\n}\\n\\nexport let compile_wasi_module: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_impl(stmts, entry_name)\\n}\\n\\n// #701 RC variant: the Perceus RC codegen path (enable_rc) for the FS-compile\\n// entry, so `vibe run`/import-resolving programs honor VIBE_RC instead of\\n// silently using the bump path. Same merged stmts as compile_wasi_module.\\nexport let compile_wasi_module_rc: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_rc_impl(stmts, entry_name)\\n}\\n\\n// Coverage variant (#cov): function-level hit instrumentation + `vibe_cov`\\n// custom section. Used by the coverage self-compile entry.\\nexport let compile_wasi_module_coverage: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_coverage_impl(stmts, entry_name)\\n}\\n\\n// Trace variant (debugger / DAP P1 groundwork): function-call execution-trace\\n// instrumentation + `vibe.trace` custom section. Used by the FS-compile trace\\n// entry under VIBE_DEBUG=1.\\nexport let compile_wasi_module_trace: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_trace_impl(stmts, entry_name)\\n}\\n\\n// Break variant (debugger / DAP P1): `vibe::dbg_break` host-hook instrumentation\\n// at each user function entry. Used by the FS-compile break entry under\\n// VIBE_DEBUG_BREAK=1.\\nexport let compile_wasi_module_break: (Array[Stmt], String, DbgProv) -> Bytes with { Error } = (stmts, entry_name, prov) -> {\\n  compile_wasi_module_break_impl(stmts, entry_name, prov)\\n}\\n\\n// RC-mode variant (uniform object header); see compile_wasi_module_rc_impl.\\nexport let compile_wasi_module_rc: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_rc_impl(stmts, entry_name)\\n}\\n\")\n}\n\nlet cli_adapter_source_116 = () -> (String, String) {\n  (\"vibe/compiler/wasm_emit.vibe\",\n\"//# Imports\\n\\nexport ./codegen / wasm_emit {\\n  build_add_module, build_arithmetic_module, build_call_module, build_factorial_module, build_fibonacci_module, build_hello_module, build_print_string_module, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_call_ref, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_memory, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_ref_func, emit_ref_null, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, emit_vibe_abi_custom_section, string_to_data\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_br, emit_end, emit_call, emit_drop, emit_else, emit_name, emit_br_if, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_ne, emit_header, emit_i64_eq, emit_i64_ne, emit_i64_or, emit_if_i64, emit_return, emit_f64_add, emit_f64_div, emit_f64_mul, emit_f64_neg, emit_f64_sub, emit_i32_add, emit_i64_add, emit_i64_and, emit_i64_eqz, emit_i64_mul, emit_i64_shl, emit_i64_sub, emit_i64_xor, emit_if_void, emit_call_ref, emit_i32_load, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_ref_func, emit_ref_null, emit_block_i64, emit_func_type, emit_i32_const, emit_i32_store, emit_i64_const, emit_i64_div_s, emit_i64_rem_s, emit_i64_shr_s, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, string_to_data, emit_block_void, emit_global_get, emit_global_set, emit_i32_store8, emit_struct_get, emit_struct_new, emit_struct_set, build_add_module, emit_i32_load8_u, build_call_module, emit_code_section, emit_data_section, emit_exports_full, emit_i32_wrap_i64, emit_type_section, build_hello_module, emit_call_indirect, emit_export_memory, emit_func_type_raw, emit_export_section, emit_f64_const_bits, emit_memory_section, emit_i64_trunc_f64_s, emit_struct_type_raw, emit_function_section, emit_i64_extend_i32_s, build_factorial_module, build_fibonacci_module, emit_f64_convert_i64_s, build_arithmetic_module, emit_data_section_multi, emit_type_section_multi, emit_exports_with_memory, emit_f64_reinterpret_i64, emit_i64_reinterpret_f64, emit_import_section_func, build_print_string_module, emit_export_section_multi, emit_table_section_funcref, emit_element_section_active, emit_global_section_i32_mut, emit_code_section_with_locals, emit_vibe_abi_custom_section\\n}\\n\")\n}\n\nlet cli_adapter_source_117 = () -> (String, String) {\n  (\"vibe/compiler/runtime/eval_loader/index.vibe\",\n\"//# Imports\\n\\nimport ../../syntax/lexer.vibe {\\n  lex\\n}\\n\\nimport ../../syntax/parser_expr.vibe {\\n  parse\\n}\\n\\nimport ../../syntax/parser.vibe {\\n  parse_program\\n}\\n\\nimport ../../core/index.vibe {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\n//# Functions\\n\\nlet rec resolve_interp_expr: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EStringInterp(parts) => {\\n      let plen = Array::length(parts)\\n      let exprs = ArrayBuilder::new()\\n      let mut i = 0\\n      while i < plen {\\n        let lit = Array::get(parts, i)\\n        if String::length(lit) > 0 {\\n          ArrayBuilder::push(exprs, EString(lit))\\n        }\\n        if i + 1 < plen {\\n          let expr_src = Array::get(parts, i + 1)\\n          let resolved = resolve_interp_expr(parse(lex(expr_src)))\\n          ArrayBuilder::push(exprs, ECall(EIdent(\\\"__to_string\\\", -1), [\\n            resolved\\n          ], -1))\\n        }\\n        i = i + 2\\n      }\\n      let out = ArrayBuilder::freeze(exprs)\\n      let len = Array::length(out)\\n      if len == 0 {\\n        EString(\\\"\\\")\\n      }\\n      else {\\n        let mut acc = Array::get(out, 0)\\n        let mut j = 1\\n        while j < len {\\n          acc = ECall(EIdent(\\\"String::concat\\\", -1), [\\n            acc,\\n            Array::get(out, j)\\n          ], -1)\\n          j = j + 1\\n        }\\n        acc\\n      }\\n    },\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EUnit => expr,\\n    EIdent(_, _) => expr,\\n    ETuple(elems) => ETuple(for elem in elems {\\n      resolve_interp_expr(elem)\\n    }),\\n    EArray(elems) => EArray(for elem in elems {\\n      resolve_interp_expr(elem)\\n    }),\\n    ERecord(fields) => ERecord(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\\n    EMap(fields) => EMap(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\\n    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),\\n    ELet(name, value, body) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body)),\\n    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),\\n    ELetMut(name, value, body) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body)),\\n    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),\\n    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),\\n    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),\\n    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\\n    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\\n    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),\\n    ELoop(params, body) => ELoop(for param in params { let (name, init) = param; (name, resolve_interp_expr(init)) }, resolve_interp_expr(body)),\\n    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),\\n    ECall(callee, args, off) => ECall(resolve_interp_expr(callee), for arg in args {\\n      resolve_interp_expr(arg)\\n    }, off),\\n    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),\\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),\\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),\\n    EDot(inner, field, off) => EDot(resolve_interp_expr(inner), field, off),\\n    EThrow(inner) => EThrow(resolve_interp_expr(inner)),\\n    EReturn(inner) => EReturn(resolve_interp_expr(inner)),\\n    EBreak(opt) => match opt {\\n      None => expr,\\n      Some(value) => EBreak(Some(resolve_interp_expr(value)))\\n    },\\n    EContinue(args) => EContinue(for arg in args {\\n      resolve_interp_expr(arg)\\n    }),\\n    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),\\n    ESpread(inner) => ESpread(resolve_interp_expr(inner))\\n  }\\n}\\n\\nlet resolve_interp_stmt: (Stmt) -> Stmt with { Error } = (stmt) -> {\\n  match stmt {\\n    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),\\n    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),\\n    STest(name, body) => STest(name, resolve_interp_expr(body)),\\n    SBench(name, body) => SBench(name, resolve_interp_expr(body)),\\n    SExpr(expr) => SExpr(resolve_interp_expr(expr)),\\n    _ => stmt\\n  }\\n}\\n\\nexport let contains_str: (Array[String], String) -> Bool = (arr, target) -> {\\n  let rec go: (Int) -> Bool = (i) -> {\\n    if i >= Array::length(arr) {\\n      false\\n    }\\n    else {\\n      if Array::get(arr, i) == target {\\n        true\\n      }\\n      else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nexport let source_lookup: (Array[(String, String)], String) -> Option[String] = (sources, path_key) -> {\\n  let rec go: (Int) -> Option[String] = (i) -> {\\n    if i >= Array::length(sources) {\\n      None\\n    }\\n    else {\\n      let (p, src) = Array::get(sources, i)\\n      if p == path_key {\\n        Some(src)\\n      }\\n      else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nexport let load_and_parse: (String) -> Array[Stmt] with { Error } = (source) -> {\\n  let tokens = lex(source)\\n  for stmt in parse_program(tokens) {\\n    resolve_interp_stmt(stmt)\\n  }\\n}\\n\\nexport let collect_exports: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  // Out-param accumulation: each match arm pushes directly into `out`.\\n  // Previously each `Array::concat(acc, [x])` allocated and copied the\\n  // entire growing prefix — total O(N^2) for N exports across the file.\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(true, _, name, _, _) => Array::push(out, name),\\n      SEnum(true, _, _, variants, _) => {\\n        let mut j = 0\\n        while j < Array::length(variants) {\\n          let (cname, _) = Array::get(variants, j)\\n          Array::push(out, cname)\\n          j = j + 1\\n        }\\n      },\\n      SExport(names) => {\\n        let mut j = 0\\n        while j < Array::length(names) {\\n          Array::push(out, Array::get(names, j))\\n          j = j + 1\\n        }\\n      },\\n      SReExport(_, names) => {\\n        let mut j = 0\\n        while j < Array::length(names) {\\n          let (name, _) = Array::get(names, j)\\n          Array::push(out, name)\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\")\n}\n\nlet cli_adapter_source_118 = () -> (String, String) {\n  (\"vibe/compiler/ripple/index.vibe\",\n\"export let version = \\\"0.0.1\\\"\\n\\nexport ./ripple.vibe {\\n  RippleDb,\\n  ripple_new,\\n  ripple_set_source,\\n  ripple_get_source,\\n  ripple_get_fingerprint,\\n  ripple_get_deps,\\n  ripple_record_eval,\\n  ripple_eval_count\\n}\\n\\nexport {\\n  RippleDb,\\n  ripple_new,\\n  ripple_set_source,\\n  ripple_get_source,\\n  ripple_get_fingerprint,\\n  ripple_get_deps,\\n  ripple_record_eval,\\n  ripple_eval_count\\n}\\n\")\n}\n\nlet cli_adapter_source_119 = () -> (String, String) {\n  (\"vibe/compiler/ripple/ripple.vibe\",\n\"//# Types\\n\\n// RippleDb is the selfhost compiler's incremental module DB: it maps module\\n// path -> source, path -> fingerprint, and path -> dependency list.\\n//\\n// Previously each map was a flat association array (`Array[(String, _)]`):\\n// every lookup was O(n) and every upsert rebuilt the whole array O(n), so\\n// threading the DB through N modules was O(N^2) time AND allocations (matching\\n// the alloc-bound compile profile from moon-pprof). This replaces them with\\n// fixed-bucket hash maps: hash the path to one of NBUCKETS buckets and scan\\n// only that (small) bucket. Lookup/insert are O(1) amortized, so a full\\n// N-module compile is O(N).\\n//\\n// The maps mutate their buckets in place, so the DB is *linear*: callers must\\n// use the returned db and discard the old one. The selfhost compiler always\\n// threads `next_db`, so this is safe. eval_count lives in a 1-element array so\\n// it is bumped without rebuilding the enum payload.\\n\\nexport enum StrMap {\\n  StrMap(Array[Array[(String, String)]])\\n}\\n\\nexport enum DepsMap {\\n  DepsMap(Array[Array[(String, Array[String])]])\\n}\\n\\nexport enum RippleDb {\\n  RippleDb(StrMap, StrMap, DepsMap, Array[Int])\\n}\\n\\n//# Functions\\n\\nlet nbuckets: () -> Int = () -> {\\n  256\\n}\\n\\nlet bucket_mask: () -> Int = () -> {\\n  255\\n}\\n\\n// FNV-1a-style string hash, masked to a non-negative bucket index. NBUCKETS is\\n// a power of two so we mask with `& 255` instead of `%`. Intermediate values\\n// are kept within 30 bits so the multiply stays well under the 2^61 tag limit.\\nlet hash_bucket: (String) -> Int = (key) -> {\\n  let len = String::length(key)\\n  let rec go: (Int, Int) -> Int = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let c = String::char_code_at(key, i)\\n      let mixed = (acc ^ c) * 16777619\\n      let bounded = mixed & 1073741823\\n      go(i + 1, bounded)\\n    }\\n  }\\n  let h = go(0, 2166136261 & 1073741823)\\n  h & bucket_mask()\\n}\\n\\nlet empty_strings: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet empty_string_pairs: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nlet empty_deps_pairs: () -> Array[(String, Array[String])] = () -> {\\n  Array::slice([\\n    (\\\"\\\", empty_strings())\\n  ], 0, 0)\\n}\\n\\n// Build a bucket array of NBUCKETS DISTINCT empty assoc arrays. (Array::make\\n// would alias one array across every slot, so push fresh empties instead.)\\nlet new_string_buckets: () -> Array[Array[(String, String)]] = () -> {\\n  let n = nbuckets()\\n  let b = ArrayBuilder::new()\\n  let rec go: (Int) -> Unit = (i) -> {\\n    if i >= n {\\n      ()\\n    } else {\\n      ArrayBuilder::push(b, empty_string_pairs())\\n      go(i + 1)\\n    }\\n  }\\n  go(0)\\n  ArrayBuilder::freeze(b)\\n}\\n\\nlet new_deps_buckets: () -> Array[Array[(String, Array[String])]] = () -> {\\n  let n = nbuckets()\\n  let b = ArrayBuilder::new()\\n  let rec go: (Int) -> Unit = (i) -> {\\n    if i >= n {\\n      ()\\n    } else {\\n      ArrayBuilder::push(b, empty_deps_pairs())\\n      go(i + 1)\\n    }\\n  }\\n  go(0)\\n  ArrayBuilder::freeze(b)\\n}\\n\\nlet strmap_new: () -> StrMap = () -> {\\n  StrMap(new_string_buckets())\\n}\\n\\nlet rec assoc_get_string: (Array[(String, String)], String, Int) -> Option[String] = (bucket, key, i) -> {\\n  if i >= Array::length(bucket) {\\n    None\\n  } else {\\n    let (k, v) = Array::get(bucket, i)\\n    if k == key {\\n      Some(v)\\n    } else {\\n      assoc_get_string(bucket, key, i + 1)\\n    }\\n  }\\n}\\n\\nlet strmap_get: (StrMap, String) -> Option[String] = (m, key) -> {\\n  match m {\\n    StrMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      assoc_get_string(bucket, key, 0)\\n    }\\n  }\\n}\\n\\n// In-place upsert into the bucket for `key`.\\nlet strmap_set: (StrMap, String, String) -> Unit = (m, key, value) -> {\\n  match m {\\n    StrMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      let len = Array::length(bucket)\\n      let rec go: (Int) -> Unit = (i) -> {\\n        if i >= len {\\n          Array::push(bucket, (key, value))\\n        } else {\\n          let (k, _) = Array::get(bucket, i)\\n          if k == key {\\n            Array::set(bucket, i, (key, value))\\n          } else {\\n            go(i + 1)\\n          }\\n        }\\n      }\\n      go(0)\\n    }\\n  }\\n}\\n\\nlet depsmap_new: () -> DepsMap = () -> {\\n  DepsMap(new_deps_buckets())\\n}\\n\\nlet rec assoc_get_deps: (Array[(String, Array[String])], String, Int) -> Option[Array[String]] = (bucket, key, i) -> {\\n  if i >= Array::length(bucket) {\\n    None\\n  } else {\\n    let (k, v) = Array::get(bucket, i)\\n    if k == key {\\n      Some(v)\\n    } else {\\n      assoc_get_deps(bucket, key, i + 1)\\n    }\\n  }\\n}\\n\\nlet depsmap_get: (DepsMap, String) -> Option[Array[String]] = (m, key) -> {\\n  match m {\\n    DepsMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      assoc_get_deps(bucket, key, 0)\\n    }\\n  }\\n}\\n\\nlet depsmap_set: (DepsMap, String, Array[String]) -> Unit = (m, key, deps) -> {\\n  match m {\\n    DepsMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      let len = Array::length(bucket)\\n      let rec go: (Int) -> Unit = (i) -> {\\n        if i >= len {\\n          Array::push(bucket, (key, deps))\\n        } else {\\n          let (k, _) = Array::get(bucket, i)\\n          if k == key {\\n            Array::set(bucket, i, (key, deps))\\n          } else {\\n            go(i + 1)\\n          }\\n        }\\n      }\\n      go(0)\\n    }\\n  }\\n}\\n\\nexport let ripple_new: () -> RippleDb = () -> {\\n  let count = ArrayBuilder::new()\\n  ArrayBuilder::push(count, 0)\\n  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))\\n}\\n\\nexport let ripple_get_source: (RippleDb, String) -> Option[String] = (db, path) -> {\\n  match db {\\n    RippleDb(sources, _, _, _) => strmap_get(sources, path)\\n  }\\n}\\n\\nexport let ripple_get_fingerprint: (RippleDb, String) -> Option[String] = (db, path) -> {\\n  match db {\\n    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)\\n  }\\n}\\n\\nexport let ripple_get_deps: (RippleDb, String) -> Option[Array[String]] = (db, path) -> {\\n  match db {\\n    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)\\n  }\\n}\\n\\nexport let ripple_eval_count: (RippleDb) -> Int = (db) -> {\\n  match db {\\n    RippleDb(_, _, _, count) => Array::get(count, 0)\\n  }\\n}\\n\\nexport let ripple_set_source: (RippleDb, String, String) -> RippleDb = (db, path, source) -> {\\n  match db {\\n    RippleDb(sources, _, _, _) => {\\n      strmap_set(sources, path, source)\\n      db\\n    }\\n  }\\n}\\n\\nexport let ripple_record_eval: (RippleDb, String, String, Array[String]) -> RippleDb = (db, path, fingerprint, deps) -> {\\n  match db {\\n    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {\\n      Some(prev_fp) => if prev_fp == fingerprint {\\n        db\\n      } else {\\n        strmap_set(fingerprints, path, fingerprint)\\n        depsmap_set(deps_map, path, deps)\\n        Array::set(count, 0, Array::get(count, 0) + 1)\\n        db\\n      },\\n      None => {\\n        strmap_set(fingerprints, path, fingerprint)\\n        depsmap_set(deps_map, path, deps)\\n        Array::set(count, 0, Array::get(count, 0) + 1)\\n        db\\n      }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_120 = () -> (String, String) {\n  (\"vibe/compiler/runtime/typecheck_fs.vibe\",\n\"//# Imports\\n\\nimport .. / cache / persistent_cache.vibe {\\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path\\n}\\n\\nimport .. / checker / checker_stmt.vibe {\\n  check_program, check_program_with_env\\n}\\n\\nimport .. / core {\\n  Stmt, Type, TypeEnv, env_bind, env_flat_bindings, env_lookup_flat\\n}\\n\\nimport .. / module_graph_path.vibe {\\n  dir_of_path, resolve_import_path, resolve_import_path_candidates\\n}\\n\\nimport .. / module_loader.vibe {\\n  load_or_parse_module_header_fs\\n}\\n\\nimport .. / ripple {\\n  RippleDb, ripple_get_deps, ripple_get_fingerprint, ripple_get_source, ripple_record_eval\\n}\\n\\nimport .. / syntax {\\n  lex_with_offsets, parse_program_located, parse_program_recovering, offset_to_line_col\\n}\\n\\nimport ./eval_loader {\\n  contains_str\\n}\\n\\nexport ./persistent_env_codec.vibe {\\n  load_persistent_dep_list, load_persistent_leaf_fingerprint, load_persistent_type_env, persistent_dep_list_text, persistent_leaf_fingerprint_text, persistent_type_env_cache_text\\n}\\n\\n//# Functions\\n\\nlet empty_stack: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet empty_dep_fps: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nlet lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\\n  let len = Array::length(cache)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let (p, env) = Array::get(cache, i)\\n      if p == path {\\n        result = Some(env)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nlet resolve_cached_import_path: (String, String, Array[(String, TypeEnv)]) -> String = (base_dir, raw_path, cache) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut selected = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(candidates) && selected == \\\"\\\" {\\n    let candidate = Array::get(candidates, i)\\n    match lookup_env_cache(cache, candidate) {\\n      Some(_) => {\\n        selected = candidate\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  if selected == \\\"\\\" {\\n    resolve_import_path(base_dir, raw_path)\\n  } else {\\n    selected\\n  }\\n}\\n\\nlet starts_with_upper: (String) -> Bool = (name) -> {\\n  if String::length(name) == 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(name, 0)\\n    c >= 65 && c <= 90\\n  }\\n}\\n\\nlet rec type_returns_name: (Type, String) -> Bool = (ty, type_name) -> {\\n  match ty {\\n    CtEnum(name) => name == type_name,\\n    CtNamed(name, _) => name == type_name,\\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\\n    _ => false\\n  }\\n}\\n\\nlet bind_enum_constructor_companions: (TypeEnv, Array[(String, Type)], String) -> TypeEnv = (acc, dep_bindings, enum_name) -> {\\n  let mut out = acc\\n  let mut i = 0\\n  while i < Array::length(dep_bindings) {\\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\\n      out = env_bind(out, candidate_name, candidate_ty)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet bind_import_names_from_cache: (TypeEnv, String, Array[(String, Option[String])], Array[(String, TypeEnv)]) -> TypeEnv = (acc, resolved, names, cache) -> {\\n  let dep_env = match lookup_env_cache(cache, resolved) {\\n    Some(e) => e,\\n    None => EnvEmpty\\n  }\\n  let dep_bindings = env_flat_bindings(dep_env)\\n  let nlen = Array::length(names)\\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\\n    if j >= nlen {\\n      nacc\\n    } else {\\n      let (name, alias) = Array::get(names, j)\\n      let bound_name = match alias {\\n        Some(a) => a,\\n        None => name\\n      }\\n      let ty = match env_lookup_flat(dep_bindings, name) {\\n        Some(t) => t,\\n        None => CtUnknown\\n      }\\n      let with_name = env_bind(nacc, bound_name, ty)\\n      let with_companions = match ty {\\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\\n        _ => if starts_with_upper(name) {\\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\\n        } else {\\n          with_name\\n        }\\n      }\\n      bind_names(j + 1, with_companions)\\n    }\\n  }\\n  bind_names(0, acc)\\n}\\n\\nlet build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        SReExport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, EnvEmpty)\\n}\\n\\nlet upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {\\n  let len = Array::length(cache)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len && !found {\\n    let (p, _) = Array::get(cache, i)\\n    if p == path {\\n      Array::set(cache, i, (path, env))\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if !found {\\n    Array::push(cache, (path, env))\\n  }\\n  cache\\n}\\n\\nlet ensure_env_cache_for_path: (RippleDb, Array[(String, TypeEnv)], String) -> Array[(String, TypeEnv)] with { Error, Fs } = (rdb, env_cache, path) -> {\\n  match lookup_env_cache(env_cache, path) {\\n    Some(_) => env_cache,\\n    None =>\\n    match ripple_get_fingerprint(rdb, path) {\\n      Some(fingerprint) =>\\n      match load_persistent_type_env(fingerprint) {\\n        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),\\n        None => env_cache\\n      },\\n      None => env_cache\\n    }\\n  }\\n}\\n\\nlet ensure_env_cache_for_paths: (RippleDb, Array[(String, TypeEnv)], Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } = (rdb, env_cache, paths) -> {\\n  let mut cache = env_cache\\n  let mut i = 0\\n  while i < Array::length(paths) {\\n    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))\\n    i = i + 1\\n  }\\n  cache\\n}\\n\\nlet build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {\\n  let mut acc = compact_string_fingerprint(source)\\n  let mut i = 0\\n  while i < Array::length(dep_fps) {\\n    let dep_pair = Array::get(dep_fps, i)\\n    let dep_path = dep_pair.0\\n    let dep_fp = dep_pair.1\\n    let next = String::concat(acc, String::concat(\\\"|\\\", String::concat(dep_path, String::concat(\\\"=\\\", dep_fp))))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nlet copy_string_array: (Array[String]) -> Array[String] = (items) -> {\\n  // Iterative push: previous recursive Array::concat(acc, [x]) was\\n  // O(N^2) — copied the full prefix on each step.\\n  let out = empty_stack()\\n  let mut i = 0\\n  let len = Array::length(items)\\n  while i < len {\\n    Array::push(out, Array::get(items, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {\\n  let len = Array::length(pairs)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        result = Some(v)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nlet upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {\\n  let len = Array::length(pairs)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len && !found {\\n    let (k, _) = Array::get(pairs, i)\\n    if k == key {\\n      Array::set(pairs, i, (key, value))\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if !found {\\n    Array::push(pairs, (key, value))\\n  }\\n  pairs\\n}\\n\\nlet parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\\n  handle {\\n    // Located lex+parse so EIdent (and other) nodes carry real source char\\n    // offsets; the checker rides those offsets into type diagnostics via the\\n    // [@off=N] marker (decoded by locate_type_error). The plain\\n    // `parse_program(lex(source))` passed an empty starts array, leaving every\\n    // offset at -1, so located type errors fell back to a first-occurrence scan.\\n    let (tokens, starts, _ends) = lex_with_offsets(source)\\n    parse_program_located(tokens, starts, source)\\n  } with Error {\\n    Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), msg))\\n  }\\n}\\n\\nlet store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {\\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\\n}\\n\\nlet write_persistent_dep_list_if_missing: (String, String, Array[String]) -> Unit with { Fs } = (path, source, deps) -> {\\n  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(dep_cache_path)) {\\n    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Span of an identifier run starting at `start` (returns the end offset).\\nlet typecheck_ident_run: (String, Int) -> Int = (s, start) -> {\\n  let len = String::length(s)\\n  let mut e = start\\n  let mut go = true\\n  while go && e < len {\\n    let c = String::char_code_at(s, e)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    if is_id {\\n      e = e + 1\\n    } else {\\n      go = false\\n    }\\n  }\\n  e\\n}\\n\\n// Best-effort `line:col` for a type error: pull the symbol out of\\n// `unknown name: X` and locate its first occurrence in the source. Real\\n// expression-level spans (AST node positions) remain future work; this gives\\n// the common case a line number in both CLI and LSP (which parses the prefix).\\n// Built with String::concat only (not `+`) to avoid the selfhost NUL fragility.\\n// Prefix `msg` with the source `line:col` of the symbol that follows `marker`\\n// in `msg` (if both are found); otherwise return `msg` unchanged.\\nlet locate_by_marker: (String, String, String) -> String = (source, msg, marker) -> {\\n  let mi = String::index_of(msg, marker)\\n  if mi < 0 {\\n    msg\\n  } else {\\n    let sstart = mi + String::length(marker)\\n    let send = typecheck_ident_run(msg, sstart)\\n    if send <= sstart {\\n      msg\\n    } else {\\n      let sym = String::substring(msg, sstart, send)\\n      let off = String::index_of(source, sym)\\n      if off < 0 {\\n        msg\\n      } else {\\n        let (line, col) = offset_to_line_col(source, off)\\n        let loc = String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n        String::concat(loc, msg)\\n      }\\n    }\\n  }\\n}\\n\\n// First-occurrence heuristic locator (the original behavior). Kept separate so\\n// the offset-marker path can fall through to it on the marker-stripped message.\\nlet locate_type_error_heuristic: (String, String) -> String = (source, msg) -> {\\n  // Already located (e.g. a parse error that bubbled here)? leave it.\\n  if String::index_of(msg, \\\"line \\\") == 0 {\\n    msg\\n  } else {\\n    let with_name = locate_by_marker(source, msg, \\\"unknown name: \\\")\\n    if with_name != msg {\\n      with_name\\n    } else {\\n      let with_arity = locate_by_marker(source, msg, \\\"function arity mismatch for \\\")\\n      if with_arity != msg {\\n        with_arity\\n      } else {\\n        let with_field = locate_by_marker(source, msg, \\\"unknown field \\\")\\n        if with_field != msg {\\n          with_field\\n        } else {\\n          locate_by_marker(source, msg, \\\"unknown constructor \\\")\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n// Build the `line L:col C: ` prefix for a source char offset (same format as\\n// locate_by_marker). String::concat only — the selfhost `+`/interpolation NUL\\n// hazard applies here too.\\nlet offset_line_col_prefix: (String, Int) -> String = (source, off) -> {\\n  let (line, col) = offset_to_line_col(source, off)\\n  String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n}\\n\\n// Build a `line L:colC-E: ` RANGE prefix from a (start, end) char-offset span.\\n// When start and end fall on the same source line this carries the exact end\\n// column so the LSP can highlight the precise token (incl. qualified names);\\n// when end is on a later line (or not greater than start) it degrades to the\\n// point prefix. Backward compatible: `line L:` still leads, so existing\\n// `grep -F \\\"line N:\\\"` assertions keep matching. String::concat only.\\nlet offset_line_col_range_prefix: (String, Int, Int) -> String = (source, start, endo) -> {\\n  let (l1, c1) = offset_to_line_col(source, start)\\n  let (l2, c2) = offset_to_line_col(source, endo)\\n  if l1 == l2 && endo > start {\\n    String::concat(\\\"line \\\", String::concat(__to_string(l1), String::concat(\\\":\\\", String::concat(__to_string(c1), String::concat(\\\"-\\\", String::concat(__to_string(c2), \\\": \\\"))))))\\n  } else {\\n    offset_line_col_prefix(source, start)\\n  }\\n}\\n\\n// Parse a non-negative decimal integer from msg[start..end). Returns -1 if the\\n// span is empty or contains a non-digit (callers then fall through to the text\\n// heuristic).\\nlet parse_offset_digits: (String, Int, Int) -> Int = (msg, start, end) -> {\\n  if end <= start {\\n    -1\\n  } else {\\n    let mut i = start\\n    let mut acc = 0\\n    let mut ok = true\\n    while ok && i < end {\\n      let c = String::char_code_at(msg, i)\\n      if c >= '0' && c <= '9' {\\n        acc = acc * 10 + (c - '0')\\n        i = i + 1\\n      } else {\\n        ok = false\\n      }\\n    }\\n    if ok {\\n      acc\\n    } else {\\n      -1\\n    }\\n  }\\n}\\n\\n// Decode (and ALWAYS strip) the ` [@off=N]` marker the checker may have\\n// appended. If N is a valid in-range offset, prefix the stripped message with\\n// its exact `line:col`. Otherwise strip the marker and fall through to the\\n// existing first-occurrence heuristics on the cleaned message. If no marker is\\n// present, returns msg unchanged.\\nlet locate_type_error: (String, String) -> String = (source, msg) -> {\\n  let marker = \\\" [@off=\\\"\\n  let mi = String::index_of(msg, marker)\\n  if mi < 0 {\\n    locate_type_error_heuristic(source, msg)\\n  } else {\\n    let inner_start = mi + String::length(marker)\\n    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), \\\"]\\\")\\n    if rel_end < 0 {\\n      // Malformed marker (no closing `]`): strip from the marker onward.\\n      locate_type_error_heuristic(source, String::substring(msg, 0, mi))\\n    } else {\\n      let close = inner_start + rel_end\\n      // inner is `N` (start only) or `N:M` (start:end). Split on `:`.\\n      let inner = String::substring(msg, inner_start, close)\\n      let colon = String::index_of(inner, \\\":\\\")\\n      let n = if colon < 0 {\\n        parse_offset_digits(inner, 0, String::length(inner))\\n      } else {\\n        parse_offset_digits(inner, 0, colon)\\n      }\\n      let m = if colon < 0 {\\n        -1\\n      } else {\\n        parse_offset_digits(inner, colon + 1, String::length(inner))\\n      }\\n      // Strip the full ` [@off=...]` segment (marker .. closing `]` inclusive).\\n      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))\\n      let slen = String::length(source)\\n      if n >= 0 && n < slen {\\n        if m > n && m <= slen {\\n          String::concat(offset_line_col_range_prefix(source, n, m), stripped)\\n        } else {\\n          String::concat(offset_line_col_prefix(source, n), stripped)\\n        }\\n      } else {\\n        locate_type_error_heuristic(source, stripped)\\n      }\\n    }\\n  }\\n}\\n\\nlet finish_typecheck_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, String, Array[String], String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, source, deps, fingerprint) -> {\\n  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {\\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\\n    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)\\n  } else {\\n    let stmts = parse_program_with_path(path, source)\\n    let final_parse_count = parse_count + 1\\n    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)\\n    let import_env = build_import_env(stmts, dir_of_path(path), import_env_cache)\\n    let checked_env = handle {\\n      match import_env {\\n        EnvEmpty => check_program(stmts),\\n        _ => check_program_with_env(stmts, import_env)\\n      }\\n    } with Error {\\n      Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), locate_type_error(source, msg)))\\n    }\\n    store_persistent_type_env(fingerprint, checked_env)\\n    if Array::length(deps) == 0 {\\n      Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)), persistent_leaf_fingerprint_text(fingerprint))\\n    } else {\\n      ()\\n    }\\n    let next_env_cache = upsert_env_cache(import_env_cache, path, checked_env)\\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\\n    (fingerprint, next_db, next_env_cache, dep_source_cache, final_parse_count)\\n  }\\n}\\n\\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {\\n  // Iterative push: previously the recursive `Array::concat(acc, [x])`\\n  // copied the full prefix on each new dep — O(N^2) for files with\\n  // many imports.\\n  let out = empty_stack()\\n  let mut i = 0\\n  let len = Array::length(stmts)\\n  while i < len {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, _) => if String::length(raw_path) > 0 {\\n        let resolved = resolve_import_path(base_dir, raw_path)\\n        if !contains_str(out, resolved) {\\n          Array::push(out, resolved)\\n        }\\n      },\\n      SReExport(raw_path, _) => if String::length(raw_path) > 0 {\\n        let resolved = resolve_import_path(base_dir, raw_path)\\n        if !contains_str(out, resolved) {\\n          Array::push(out, resolved)\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {\\n  match load_persistent_dep_list(path, source) {\\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\\n    None => {\\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\\n    }\\n  }\\n}\\n\\nlet resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {\\n  match lookup_string_pair(dep_source_cache, path) {\\n    Some(cached_source) =>\\n    if cached_source == source {\\n      match ripple_get_deps(rdb, path) {\\n        Some(deps) => (deps, dep_source_cache, parse_count),\\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n      }\\n    } else {\\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n    },\\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n  }\\n}\\n\\nlet rec ensure_fingerprint_fs_go: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {\\n  if contains_str(stack, path) {\\n    throw(String::concat(\\\"type_db: import cycle detected at \\\", path))\\n  } else {\\n    match ripple_get_source(rdb, path) {\\n      None => (String::concat(\\\"missing:\\\", path), rdb, env_cache, dep_source_cache, parse_count),\\n      Some(source) => match lookup_string_pair(dep_source_cache, path) {\\n        Some(cached_source) => if cached_source == source {\\n          match ripple_get_fingerprint(rdb, path) {\\n            Some(cached_fingerprint) =>\\n            // The fingerprint is enough for dependency fingerprint folding.\\n            // Loading the env here caused shared leaf modules to re-read their\\n            // persistent leaf cache every time they were reached before a\\n            // parent needed their bindings.\\n            (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count),\\n            None => match load_persistent_leaf_fingerprint(path, source) {\\n              Some(leaf_fingerprint) => {\\n                write_persistent_dep_list_if_missing(path, source, empty_stack())\\n                let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n                (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n              },\\n              None => {\\n                let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n                let deps = copy_string_array(deps_raw)\\n                write_persistent_dep_list_if_missing(path, source, deps)\\n                let dlen = Array::length(deps)\\n                let saved_stack_len = Array::length(stack)\\n                Array::push(stack, path)\\n                let mut i = 0\\n                let mut db_after_deps = rdb\\n                let mut env_cache_after_deps = env_cache\\n                let mut dep_source_cache_after_deps = next_dep_source_cache\\n                let mut parse_count_after_deps = initial_parse_count\\n                let dep_fps = empty_dep_fps()\\n                while i < dlen {\\n                  let dep_path = Array::get(deps, i)\\n                  let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n                  db_after_deps = next_db\\n                  env_cache_after_deps = next_env_cache\\n                  dep_source_cache_after_deps = next_dep_source_cache2\\n                  parse_count_after_deps = next_parse_count\\n                  Array::push(dep_fps, (dep_path, dep_fp))\\n                  i = i + 1\\n                }\\n                Array::truncate(stack, saved_stack_len)\\n                let fingerprint = build_fingerprint(source, dep_fps)\\n                match ripple_get_fingerprint(db_after_deps, path) {\\n                  Some(cached_fp) =>\\n                  if cached_fp == fingerprint {\\n                    (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n                  } else {\\n                    finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                  },\\n                  None =>\\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                }\\n              }\\n            }\\n          }\\n        } else {\\n          match load_persistent_leaf_fingerprint(path, source) {\\n            Some(leaf_fingerprint) => {\\n              write_persistent_dep_list_if_missing(path, source, empty_stack())\\n              let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n              let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n              (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n            },\\n            None => {\\n              let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n              let deps = copy_string_array(deps_raw)\\n              write_persistent_dep_list_if_missing(path, source, deps)\\n              let dlen = Array::length(deps)\\n              let saved_stack_len = Array::length(stack)\\n              Array::push(stack, path)\\n              let mut i = 0\\n              let mut db_after_deps = rdb\\n              let mut env_cache_after_deps = env_cache\\n              let mut dep_source_cache_after_deps = next_dep_source_cache\\n              let mut parse_count_after_deps = initial_parse_count\\n              let dep_fps = empty_dep_fps()\\n              while i < dlen {\\n                let dep_path = Array::get(deps, i)\\n                let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n                db_after_deps = next_db\\n                env_cache_after_deps = next_env_cache\\n                dep_source_cache_after_deps = next_dep_source_cache2\\n                parse_count_after_deps = next_parse_count\\n                Array::push(dep_fps, (dep_path, dep_fp))\\n                i = i + 1\\n              }\\n              Array::truncate(stack, saved_stack_len)\\n              let fingerprint = build_fingerprint(source, dep_fps)\\n              match ripple_get_fingerprint(db_after_deps, path) {\\n                Some(cached_fp) =>\\n                if cached_fp == fingerprint {\\n                  (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n                } else {\\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                },\\n                None =>\\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n              }\\n            }\\n          }\\n        },\\n        None =>\\n        match load_persistent_leaf_fingerprint(path, source) {\\n          Some(leaf_fingerprint) => {\\n            write_persistent_dep_list_if_missing(path, source, empty_stack())\\n            let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n            let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n            (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n          },\\n          None => {\\n            let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n            let deps = copy_string_array(deps_raw)\\n            write_persistent_dep_list_if_missing(path, source, deps)\\n            let dlen = Array::length(deps)\\n            let saved_stack_len = Array::length(stack)\\n            Array::push(stack, path)\\n            let mut i = 0\\n            let mut db_after_deps = rdb\\n            let mut env_cache_after_deps = env_cache\\n            let mut dep_source_cache_after_deps = next_dep_source_cache\\n            let mut parse_count_after_deps = initial_parse_count\\n            let dep_fps = empty_dep_fps()\\n            while i < dlen {\\n              let dep_path = Array::get(deps, i)\\n              let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n              db_after_deps = next_db\\n              env_cache_after_deps = next_env_cache\\n              dep_source_cache_after_deps = next_dep_source_cache2\\n              parse_count_after_deps = next_parse_count\\n              Array::push(dep_fps, (dep_path, dep_fp))\\n              i = i + 1\\n            }\\n            Array::truncate(stack, saved_stack_len)\\n            let fingerprint = build_fingerprint(source, dep_fps)\\n            match ripple_get_fingerprint(db_after_deps, path) {\\n              Some(cached_fp) =>\\n              if cached_fp == fingerprint {\\n                (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n              } else {\\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n              },\\n              None =>\\n              finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport let ensure_fingerprint_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {\\n  let (fingerprint, next_db, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint_fs_go(rdb, env_cache, dep_source_cache, parse_count, path, stack)\\n  let final_env_cache = ensure_env_cache_for_path(next_db, next_env_cache, path)\\n  (fingerprint, next_db, final_env_cache, next_dep_source_cache, next_parse_count)\\n}\\n\\n// Collect ALL diagnostics for `source` as located (`line:col`) message strings.\\n// Uses the recovering parser to gather every top-level syntax error; only if\\n// the parse is clean does it run the type checker and report the (single,\\n// located) type error. Returns [] when the source parses and checks cleanly.\\n// Foundation for `vibe check` / LSP multi-diagnostic reporting.\\nexport let collect_all_diagnostics: (String) -> Array[String] with { Error } = (source) -> {\\n  let (tokens, starts, _ends) = lex_with_offsets(source)\\n  let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)\\n  if Array::length(parse_diags) > 0 {\\n    parse_diags\\n  } else {\\n    handle {\\n      let _env = check_program(stmts)\\n      Array::slice([\\n        \\\"_\\\"\\n      ], 0, 0)\\n    } with Error {\\n      Throw(msg) => [\\n        locate_type_error(source, msg)\\n      ]\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_121 = () -> (String, String) {\n  (\"vibe/compiler/runtime/type_at.vibe\",\n\"//# Imports\\n\\n// `vibe type-at` — first typed-hover (LSP) consumer of the real EIdent source\\n// offsets. Given a (line, col), locate the identifier node whose source span\\n// covers that position, typecheck the program, and return the inferred type of\\n// that name via env_lookup + type_to_string.\\n//\\n// MVP scope / LIMITATION: only env-visible names resolve — top-level bindings\\n// and imported names that the checker records in the returned TypeEnv. Locals\\n// and function parameters are NOT in that env (they live in nested scopes during\\n// inference and are gone by the time check_program returns), so hovering one\\n// yields \\\"\\\". A future per-node type table would lift this restriction.\\n//\\n// All strings are built with String::concat only (never `+`, never \\\"\\\\{x}\\\"\\n// interpolation): both mis-codegen to NUL in selfhost. Ints stringify via\\n// __to_string.\\n\\nimport ../core {\\n  Stmt, Expr, Pat, Type, TypeEnv, Subst, env_lookup, subst_apply, type_to_string\\n}\\n\\nimport ../checker/checker_stmt.vibe {\\n  check_program, check_program_type_table\\n}\\n\\nimport ../syntax {\\n  lex_with_offsets, parse_program_located, parse_program_spans, offset_to_line_col\\n}\\n\\n//# Functions\\n\\n// 1-based (line, col) -> 0-based char offset, the inverse of offset_to_line_col.\\n// `col` is the position WITHIN a line (col 1 = first char of the line). We count\\n// newlines: the offset of the start of line L is just past the (L-1)th newline,\\n// then add (col - 1). Defensive: clamp at the source length.\\nlet line_col_to_offset: (String, Int, Int) -> Int = (source, line, col) -> {\\n  let len = String::length(source)\\n  let mut i = 0\\n  let mut cur_line = 1\\n  // Advance to the first char of the target line.\\n  while cur_line < line && i < len {\\n    if String::char_code_at(source, i) == 10 {\\n      cur_line = cur_line + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  // i now points at the first char of `line` (or end). Add the column offset.\\n  let off = i + (col - 1)\\n  if off < 0 {\\n    0\\n  } else if off > len {\\n    len\\n  } else {\\n    off\\n  }\\n}\\n\\n// A located EIdent hit: name + source span [off, off + length(name)). `off` is\\n// -1 for synthetic / non-located idents (those are ignored by the search).\\nenum IdentHit {\\n  IdentHit(String, Int)\\n}\\n\\nlet empty_hits: () -> Array[IdentHit] = () -> {\\n  Array::slice([\\n    IdentHit(\\\"\\\", -1)\\n  ], 0, 0)\\n}\\n\\n// Read-only walker over the Expr structure (templated on normalize/index.vibe's\\n// `fold_expr`, but it only COLLECTS located EIdent nodes — it never rebuilds the\\n// tree). Every variant is enumerated so a new Expr arm is a compile error here,\\n// keeping the collector in sync with the AST.\\nlet rec collect_expr: (Expr, Array[IdentHit]) -> Unit = (expr, acc) -> {\\n  match expr {\\n    EInt(_) => (),\\n    EFloat(_) => (),\\n    EString(_) => (),\\n    EBool(_) => (),\\n    EIdent(name, off) => {\\n      if off >= 0 {\\n        Array::push(acc, IdentHit(name, off))\\n      } else {\\n        ()\\n      }\\n    },\\n    EUnit => (),\\n    EStringInterp(_) => (),\\n    ETuple(items) => collect_exprs(items, acc),\\n    EArray(items) => collect_exprs(items, acc),\\n    ERecord(fields) => collect_field_exprs(fields, acc),\\n    EIf(c, t, e) => {\\n      collect_expr(c, acc)\\n      collect_expr(t, acc)\\n      collect_expr(e, acc)\\n    },\\n    ELet(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELetRec(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELetMut(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    EAssign(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    EAssignOp(_, _, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ESeq(a, b) => {\\n      collect_expr(a, acc)\\n      collect_expr(b, acc)\\n    },\\n    EMatch(s, arms) => {\\n      collect_expr(s, acc)\\n      collect_arm_exprs(arms, acc)\\n    },\\n    EHandle(s, arms) => {\\n      collect_expr(s, acc)\\n      collect_arm_exprs(arms, acc)\\n    },\\n    EWhile(c, b) => {\\n      collect_expr(c, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELoop(params, b) => {\\n      collect_loop_param_exprs(params, acc)\\n      collect_expr(b, acc)\\n    },\\n    EForIn(_, _, it, b) => {\\n      collect_expr(it, acc)\\n      collect_expr(b, acc)\\n    },\\n    ECall(callee, args, _) => {\\n      collect_expr(callee, acc)\\n      collect_exprs(args, acc)\\n    },\\n    EBinOp(_, l, r) => {\\n      collect_expr(l, acc)\\n      collect_expr(r, acc)\\n    },\\n    EUnaryOp(_, e) => collect_expr(e, acc),\\n    EFn(_, _, _, _, _, body) => collect_expr(body, acc),\\n    EDot(e, _, _) => collect_expr(e, acc),\\n    ELabeledArg(_, _, v) => collect_expr(v, acc),\\n    EThrow(e) => collect_expr(e, acc),\\n    EReturn(e) => collect_expr(e, acc),\\n    EBreak(opt) => match opt {\\n      Some(v) => collect_expr(v, acc),\\n      None => ()\\n    },\\n    EContinue(args) => collect_exprs(args, acc),\\n    EMap(fields) => collect_field_exprs(fields, acc),\\n    ESpread(e) => collect_expr(e, acc)\\n  }\\n}\\n\\nlet collect_exprs: (Array[Expr], Array[IdentHit]) -> Unit = (items, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    collect_expr(Array::get(items, i), acc)\\n    i = i + 1\\n  }\\n}\\n\\nlet collect_field_exprs: (Array[(String, Expr)], Array[IdentHit]) -> Unit = (fields, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (_, v) = Array::get(fields, i)\\n    collect_expr(v, acc)\\n    i = i + 1\\n  }\\n}\\n\\nlet collect_arm_exprs: (Array[(Pat, Expr)], Array[IdentHit]) -> Unit = (arms, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (_, e) = Array::get(arms, i)\\n    collect_expr(e, acc)\\n    i = i + 1\\n  }\\n}\\n\\nlet collect_loop_param_exprs: (Array[(String, Expr)], Array[IdentHit]) -> Unit = (params, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (_, init) = Array::get(params, i)\\n    collect_expr(init, acc)\\n    i = i + 1\\n  }\\n}\\n\\nlet collect_stmt: (Stmt, Array[IdentHit]) -> Unit = (stmt, acc) -> {\\n  match stmt {\\n    SLet(_, _, _, _, body) => collect_expr(body, acc),\\n    SLetMut(_, _, body) => collect_expr(body, acc),\\n    STest(_, body) => collect_expr(body, acc),\\n    SBench(_, body) => collect_expr(body, acc),\\n    SExpr(e) => collect_expr(e, acc),\\n    SLetPat(_, body) => collect_expr(body, acc),\\n    SModule(_, _, body) => collect_stmts(body, acc),\\n    _ => ()\\n  }\\n}\\n\\nlet collect_stmts: (Array[Stmt], Array[IdentHit]) -> Unit = (stmts, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    collect_stmt(Array::get(stmts, i), acc)\\n    i = i + 1\\n  }\\n}\\n\\n// True when `source[off]` is NOT an identifier char (or off is out of range) —\\n// i.e. a valid word boundary. Used to match a binding name as a whole word.\\nlet is_boundary_at: (String, Int) -> Bool = (source, off) -> {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\n\\n// Find the first whole-word occurrence of `name` in `source[start..end)` and, if\\n// found, push a located IdentHit for it. This recovers a source offset for a\\n// let-binding NAME, which the parser stores only as a String on the Stmt (it is\\n// not an EIdent and so carries no offset). Binding names are exactly the\\n// env-visible top-level names, so making their definition site hoverable is the\\n// useful case for this MVP.\\nlet push_binding_name_hit: (String, Int, Int, String, Array[IdentHit]) -> Unit = (source, start, end, name, acc) -> {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    ()\\n  } else {\\n    let limit = if end > String::length(source) { String::length(source) } else { end }\\n    let mut i = if start < 0 { 0 } else { start }\\n    let mut found = false\\n    while !found && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {\\n        Array::push(acc, IdentHit(name, i))\\n        found = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\n\\n// Add located hits for the NAMES of top-level (and module-body) value bindings,\\n// using each statement's source span (from parse_program_spans) to scope the\\n// whole-word search. Only SLet/SLetMut names are env-visible value bindings.\\nlet collect_binding_name_hits: (Array[Stmt], Array[Int], Array[Int], String, Array[IdentHit]) -> Unit = (stmts, span_start, span_end, source, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let start = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\\n    let end = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),\\n      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n// Among all collected idents whose span [off, off+len(name)) contains `tgt`,\\n// pick the one with the largest `off` (innermost / closest start). Returns \\\"\\\"\\n// when no ident covers the position.\\nlet pick_ident_at: (Array[IdentHit], Int) -> String = (hits, tgt) -> {\\n  let mut best_name = \\\"\\\"\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      IdentHit(name, off) => {\\n        let span_end = off + String::length(name)\\n        if off <= tgt && tgt < span_end && off > best_off {\\n          best_name = name\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  best_name\\n}\\n\\n// Same selection as pick_ident_at, but returns the chosen ident's source\\n// `off` (the innermost / largest-off hit covering `tgt`), or -1 when none.\\n// Used to query the per-node type table by the hovered EIdent's offset.\\nlet pick_ident_off: (Array[IdentHit], Int) -> Int = (hits, tgt) -> {\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      IdentHit(name, off) => {\\n        let span_end = off + String::length(name)\\n        if off <= tgt && tgt < span_end && off > best_off {\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  best_off\\n}\\n\\n// Look up the recorded type for source offset `off` in the per-node type table\\n// produced by check_program_type_table. Returns None when no node recorded that\\n// exact offset. When multiple entries share an offset (re-checked node), the\\n// last recorded one wins (closest to the final inference state).\\nlet tytab_lookup: (Array[(Int, Type)], Int) -> Option[Type] = (table, off) -> {\\n  let mut found = None\\n  let mut i = 0\\n  while i < Array::length(table) {\\n    let (toff, tty) = Array::get(table, i)\\n    if toff == off {\\n      found = Some(tty)\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// Locate the identifier at (line, col), typecheck the program, and return its\\n// inferred type as a string. Resolution order:\\n//   1. per-node type table (covers LOCALS and PARAMETERS — names that live in\\n//      nested inference scopes and are gone from the returned TypeEnv);\\n//   2. fall back to the top-level TypeEnv lookup (top-level / imported names,\\n//      and let-binding definition sites whose offset is not an EIdent node).\\n// Returns \\\"\\\" when the position is not over a located identifier, or the name\\n// resolves nowhere. Any failure is swallowed and yields \\\"\\\".\\nexport let type_at_source: (String, Int, Int) -> String = (source, line, col) -> {\\n  handle {\\n    let tgt = line_col_to_offset(source, line, col)\\n    let (tokens, starts, ends) = lex_with_offsets(source)\\n    let stmts = parse_program_located(tokens, starts, source)\\n    let hits = empty_hits()\\n    // Identifier USES carry real offsets on their EIdent nodes.\\n    collect_stmts(stmts, hits)\\n    // Identifier DEFINITIONS (let-binding names) carry none, so recover their\\n    // source offset from each statement's span and the source text.\\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\\n    collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)\\n    let name = pick_ident_at(hits, tgt)\\n    if name == \\\"\\\" {\\n      \\\"\\\"\\n    } else {\\n      let chosen_off = pick_ident_off(hits, tgt)\\n      // 1. per-node type table (locals + parameters).\\n      let (table, final_s) = check_program_type_table(stmts)\\n      let table_hit = if chosen_off >= 0 {\\n        tytab_lookup(table, chosen_off)\\n      } else {\\n        None\\n      }\\n      match table_hit {\\n        Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),\\n        None => {\\n          // 2. fall back to the top-level env (top-level / imported names).\\n          let env = check_program(stmts)\\n          match env_lookup(env, name) {\\n            Some(t) => type_to_string(t),\\n            None => \\\"\\\"\\n          }\\n        }\\n      }\\n    }\\n  } with Error {\\n    Throw(_) => \\\"\\\"\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_122 = () -> (String, String) {\n  (\"vibe/compiler/runtime/binding_at.vibe\",\n\"//# Imports\\n\\n// `vibe binding-at` — AST-accurate, scope-aware binding occurrences: the\\n// foundation for scope-precision rename / references (テーマ4). Given a\\n// (line, col), locate the identifier under the cursor and return the source\\n// spans of every occurrence that resolves to the SAME binding — not merely the\\n// same NAME.\\n//\\n// Why this is better than a text scan: occurrences are taken from the real\\n// parsed AST, so there are NO false matches inside string literals, comments, or\\n// as substrings of a longer word — only actual identifier nodes count.\\n//\\n// SCOPE AWARENESS (テーマ4): a scope-stack walk resolves every `EIdent(name,off)`\\n// REFERENCE to the nearest enclosing introduction of `name` — a `let` / `let mut`\\n// local, a function/lambda parameter, a `for` binder, a `loop` parameter, or a\\n// match/handle pattern binder. Each introduction gets a unique binding id;\\n// references that resolve to the same introduction share it, so two distinct\\n// same-named locals (e.g. `x` in one function vs `x` in another, or a shadowing\\n// inner `let x`) are NOT conflated. A reference that resolves to no local\\n// introduction is treated as a module-level / free name and grouped FILE-WIDE by\\n// name (canonical key 0), so top-level `export let f` references across the file\\n// still resolve together.\\n//\\n// BINDER OFFSET RECOVERY: the AST stores binder NAMES as plain Strings without\\n// offsets (only `EIdent` carries an offset). We recover a binder's source span by\\n// scanning the source for the next whole-word occurrence of the name from a\\n// monotonically-advancing floor, walking constructs in source order. This is the\\n// same whole-word-scan machinery the previous name-wide implementation used for\\n// top-level binding names, generalized to nested binders.\\n//\\n// FALLBACK (honest): for `match`/`handle` arms whose patterns introduce nested\\n// sub-binders (ctor / tuple / struct / or patterns) the names ARE introduced into\\n// scope so references resolve correctly, but if a particular binder's source\\n// offset cannot be recovered from the floor its own occurrence span is omitted\\n// (the rename set may miss the binder site itself, never a crash). Resolution\\n// never crashes: any failure is swallowed and yields an empty list.\\n//\\n// All strings are built with String::concat only (never `+`, never \\\"\\\\{x}\\\"\\n// interpolation): both mis-codegen to NUL in selfhost.\\n\\nimport ../core {\\n  Stmt, Expr, Pat\\n}\\n\\nimport ../syntax {\\n  lex_with_offsets, parse_program_located\\n}\\n\\n//# Functions\\n\\n// 1-based (line, col) -> 0-based char offset. Mirror of type_at.vibe's\\n// line_col_to_offset: count newlines to reach the target line, add (col - 1),\\n// clamp to [0, len].\\nlet bind_line_col_to_offset: (String, Int, Int) -> Int = (source, line, col) -> {\\n  let len = String::length(source)\\n  let mut i = 0\\n  let mut cur_line = 1\\n  while cur_line < line && i < len {\\n    if String::char_code_at(source, i) == 10 {\\n      cur_line = cur_line + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  let off = i + (col - 1)\\n  if off < 0 {\\n    0\\n  } else if off > len {\\n    len\\n  } else {\\n    off\\n  }\\n}\\n\\n// A located occurrence resolved to a binding:\\n//   BindHit(name, off, key)\\n// where `off` is the start source offset (its span is [off, off+length(name)))\\n// and `key` is the canonical binding id this occurrence resolves to. key 0 means\\n// \\\"module-level / free name, grouped file-wide by name\\\". `off` is -1 for\\n// synthetic / non-located nodes, which the search ignores.\\nenum BindHit {\\n  BindHit(String, Int, Int)\\n}\\n\\nlet bind_empty_hits: () -> Array[BindHit] = () -> {\\n  Array::slice([\\n    BindHit(\\\"\\\", -1, 0)\\n  ], 0, 0)\\n}\\n\\n// True when `source[off]` is NOT an identifier char (or off out of range) — a\\n// word boundary. Used to match a binding name as a whole word.\\nlet bind_is_boundary_at: (String, Int) -> Bool = (source, off) -> {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\n\\n// Find the start offset of the first whole-word occurrence of `name` in\\n// `source` at or after `from`. Returns -1 when not found. Recovers a source\\n// offset for a binder NAME, which the parser stores only as a String.\\nlet bind_find_word: (String, String, Int) -> Int = (source, name, from) -> {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    -1\\n  } else {\\n    let limit = String::length(source)\\n    let mut i = if from < 0 { 0 } else { from }\\n    let mut found = -1\\n    while found < 0 && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && bind_is_boundary_at(source, i - 1) && bind_is_boundary_at(source, i + nlen) {\\n        found = i\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n    found\\n  }\\n}\\n\\n// Mutable walk state threaded through the AST traversal:\\n//   hits        — collected occurrences (references + recovered binders)\\n//   scope_names — scope-stack of in-scope binder names (parallel to scope_ids)\\n//   scope_ids   — scope-stack of binder ids (parallel to scope_names)\\n//   floor       — boxed monotonically-advancing scan floor for binder recovery\\n//   source      — the program text\\n//\\n// Binding ids are NOT a separate counter: each binder's canonical id is its\\n// recovered source offset + 1 (unique per binder, and >= 1 so it never collides\\n// with the module/free key 0). This avoids a separate mutable id-counter field.\\nstruct BindState {\\n  hits: Array[BindHit];\\n  scope_names: Array[String];\\n  scope_ids: Array[Int];\\n  floor: Array[Int];\\n  source: String\\n}\\n\\n// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box).\\n// Built via the slice+push idiom so the cell is a heap array supporting\\n// Array::set, not a static read-only literal.\\nlet bind_box_int: (Int) -> Array[Int] = (v) -> {\\n  let arr = Array::slice([0], 0, 0)\\n  Array::push(arr, v)\\n  arr\\n}\\n\\nlet bind_new_state: (String) -> BindState = (source) -> {\\n  BindState::{\\n    hits: bind_empty_hits(),\\n    scope_names: Array::slice([\\\"\\\"], 0, 0),\\n    scope_ids: Array::slice([0], 0, 0),\\n    floor: bind_box_int(0),\\n    source: source\\n  }\\n}\\n\\n// Resolve `name` to the nearest enclosing scope id, scanning the scope stack from\\n// the top (end) down. Returns 0 (module-level / free, grouped file-wide) when no\\n// local introduction is in scope.\\nlet bind_resolve: (BindState, String) -> Int = (st, name) -> {\\n  let n = Array::length(st.scope_names)\\n  let mut i = n - 1\\n  let mut found = 0\\n  while i >= 0 && found == 0 {\\n    if Array::get(st.scope_names, i) == name {\\n      found = Array::get(st.scope_ids, i)\\n    } else {\\n      ()\\n    }\\n    i = i - 1\\n  }\\n  found\\n}\\n\\n// Pop the scope stack back down to `mark` entries.\\nlet bind_pop_scope: (BindState, Int) -> Unit = (st, mark) -> {\\n  Array::truncate(st.scope_names, mark)\\n  Array::truncate(st.scope_ids, mark)\\n}\\n\\n// Recover a binder's source offset (from the scan floor forward), record it as an\\n// occurrence, advance the floor past it, and return its unique binding id (off+1,\\n// always >= 1; or 0 when the offset cannot be recovered — see file header\\n// FALLBACK note). Does NOT push to scope — callers control when the binder enters\\n// scope (e.g. a non-recursive `let x = v` must recover x's offset textually\\n// before v, yet not have x in scope while walking v).\\nlet bind_recover_binder: (BindState, String) -> Int = (st, name) -> {\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  let id = if off >= 0 { off + 1 } else { 0 }\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, id))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n  id\\n}\\n\\n// Push a binder (name, id) onto the current scope.\\nlet bind_push_binder: (BindState, String, Int) -> Unit = (st, name, id) -> {\\n  Array::push(st.scope_names, name)\\n  Array::push(st.scope_ids, id)\\n}\\n\\n// Introduce a binder: recover its offset/id then immediately push it into scope.\\n// Used where the binder's scope begins right at the binder site (params, for /\\n// loop binders, match-pattern binders).\\nlet bind_introduce: (BindState, String) -> Unit = (st, name) -> {\\n  let id = bind_recover_binder(st, name)\\n  bind_push_binder(st, name, id)\\n}\\n\\n// Record a reference `EIdent(name, off)`: resolve it to the nearest enclosing\\n// binding (or 0 = module-level/free) and store its located span. Advance the\\n// floor past it so later binder recovery does not re-find an earlier position.\\nlet bind_record_ref: (BindState, String, Int) -> Unit = (st, name, off) -> {\\n  if off >= 0 {\\n    let key = bind_resolve(st, name)\\n    Array::push(st.hits, BindHit(name, off, key))\\n    if off >= Array::get(st.floor, 0) {\\n      Array::set(st.floor, 0, off + String::length(name))\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Record an assignment target `name = ...` / `name op= ...`. Resolve to the\\n// enclosing binding and recover the name's source offset from the floor (the\\n// target name has no stored offset).\\nlet bind_record_assign_target: (BindState, String) -> Unit = (st, name) -> {\\n  let key = bind_resolve(st, name)\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, key))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Introduce the names bound by a pattern (PBind directly; nested binders in\\n// ctor / tuple / struct / or patterns recursively). Each is introduced into the\\n// current scope.\\nlet rec bind_introduce_pat: (BindState, Pat) -> Unit = (st, pat) -> {\\n  match pat {\\n    PWild => (),\\n    PBind(name) => bind_introduce(st, name),\\n    PInt(_) => (),\\n    PString(_) => (),\\n    PBool(_) => (),\\n    PCtor(_, sub) => bind_introduce_pats(st, sub),\\n    PTuple(sub) => bind_introduce_pats(st, sub),\\n    POr(a, b) => {\\n      bind_introduce_pat(st, a)\\n      bind_introduce_pat(st, b)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        bind_introduce_pat(st, fp)\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\n\\nlet bind_introduce_pats: (BindState, Array[Pat]) -> Unit = (st, sub) -> {\\n  let mut i = 0\\n  while i < Array::length(sub) {\\n    bind_introduce_pat(st, Array::get(sub, i))\\n    i = i + 1\\n  }\\n}\\n\\n// Scope-aware walker. `st.hits` accumulates references (resolved to a binding id)\\n// and recovered binders. Every Expr arm is enumerated so a new variant is a\\n// compile error here, keeping the collector in sync with the AST.\\nlet rec bind_walk_expr: (BindState, Expr) -> Unit = (st, expr) -> {\\n  match expr {\\n    EInt(_) => (),\\n    EFloat(_) => (),\\n    EString(_) => (),\\n    EBool(_) => (),\\n    EIdent(name, off) => bind_record_ref(st, name, off),\\n    EUnit => (),\\n    EStringInterp(_) => (),\\n    ETuple(items) => bind_walk_exprs(st, items),\\n    EArray(items) => bind_walk_exprs(st, items),\\n    ERecord(fields) => bind_walk_field_exprs(st, fields),\\n    EIf(c, t, e) => {\\n      bind_walk_expr(st, c)\\n      bind_walk_expr(st, t)\\n      bind_walk_expr(st, e)\\n    },\\n    ELet(name, v, b) => {\\n      // `let name = v; b`: the binder is textually BEFORE v, so recover its\\n      // offset first (advancing the floor past it), but keep it OUT of scope while\\n      // walking v — a non-recursive `let x = x + 1` references the OUTER x. Then\\n      // push it into scope for b only.\\n      let id = bind_recover_binder(st, name)\\n      bind_walk_expr(st, v)\\n      let mark = Array::length(st.scope_names)\\n      bind_push_binder(st, name, id)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ELetRec(name, v, b) => {\\n      // recursive let: name is in scope for both v and b.\\n      let mark = Array::length(st.scope_names)\\n      bind_introduce(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ELetMut(name, v, b) => {\\n      // same binder-before-value ordering as ELet.\\n      let id = bind_recover_binder(st, name)\\n      bind_walk_expr(st, v)\\n      let mark = Array::length(st.scope_names)\\n      bind_push_binder(st, name, id)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    EAssign(name, v, b) => {\\n      // assignment target is a reference to an in-scope binding.\\n      bind_record_assign_target(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n    },\\n    EAssignOp(name, _, v, b) => {\\n      bind_record_assign_target(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n    },\\n    ESeq(a, b) => {\\n      bind_walk_expr(st, a)\\n      bind_walk_expr(st, b)\\n    },\\n    EMatch(s, arms) => {\\n      bind_walk_expr(st, s)\\n      bind_walk_arms(st, arms)\\n    },\\n    EHandle(s, arms) => {\\n      bind_walk_expr(st, s)\\n      bind_walk_arms(st, arms)\\n    },\\n    EWhile(c, b) => {\\n      bind_walk_expr(st, c)\\n      bind_walk_expr(st, b)\\n    },\\n    ELoop(params, b) => {\\n      // loop params introduce names scoped to b; init exprs are outside scope.\\n      let mark = Array::length(st.scope_names)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, init) = Array::get(params, i)\\n        bind_walk_expr(st, init)\\n        bind_introduce(st, pname)\\n        i = i + 1\\n      }\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    EForIn(name, idx_opt, it, b) => {\\n      bind_walk_expr(st, it)\\n      let mark = Array::length(st.scope_names)\\n      bind_introduce(st, name)\\n      match idx_opt {\\n        Some(idx) => bind_introduce(st, idx),\\n        None => ()\\n      }\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ECall(callee, args, _) => {\\n      bind_walk_expr(st, callee)\\n      bind_walk_exprs(st, args)\\n    },\\n    EBinOp(_, l, r) => {\\n      bind_walk_expr(st, l)\\n      bind_walk_expr(st, r)\\n    },\\n    EUnaryOp(_, e) => bind_walk_expr(st, e),\\n    EFn(_, _, params, _, _, body) => {\\n      // function / lambda parameters are scoped to body.\\n      let mark = Array::length(st.scope_names)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, _) = Array::get(params, i)\\n        bind_introduce(st, pname)\\n        i = i + 1\\n      }\\n      bind_walk_expr(st, body)\\n      bind_pop_scope(st, mark)\\n    },\\n    EDot(e, _, _) => bind_walk_expr(st, e),\\n    ELabeledArg(_, _, v) => bind_walk_expr(st, v),\\n    EThrow(e) => bind_walk_expr(st, e),\\n    EReturn(e) => bind_walk_expr(st, e),\\n    EBreak(opt) => match opt {\\n      Some(v) => bind_walk_expr(st, v),\\n      None => ()\\n    },\\n    EContinue(args) => bind_walk_exprs(st, args),\\n    EMap(fields) => bind_walk_field_exprs(st, fields),\\n    ESpread(e) => bind_walk_expr(st, e)\\n  }\\n}\\n\\nlet bind_walk_exprs: (BindState, Array[Expr]) -> Unit = (st, items) -> {\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    bind_walk_expr(st, Array::get(items, i))\\n    i = i + 1\\n  }\\n}\\n\\nlet bind_walk_field_exprs: (BindState, Array[(String, Expr)]) -> Unit = (st, fields) -> {\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (_, v) = Array::get(fields, i)\\n    bind_walk_expr(st, v)\\n    i = i + 1\\n  }\\n}\\n\\n// A match/handle arm: the pattern binders are scoped to the arm body only.\\nlet bind_walk_arms: (BindState, Array[(Pat, Expr)]) -> Unit = (st, arms) -> {\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (pat, e) = Array::get(arms, i)\\n    let mark = Array::length(st.scope_names)\\n    bind_introduce_pat(st, pat)\\n    bind_walk_expr(st, e)\\n    bind_pop_scope(st, mark)\\n    i = i + 1\\n  }\\n}\\n\\n// Record a top-level / module-level binder NAME. These group file-wide (key 0),\\n// so all references to the same module name resolve together. We recover the\\n// binder's offset from the floor.\\nlet bind_record_module_binder: (BindState, String) -> Unit = (st, name) -> {\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, 0))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Walk a statement. Top-level value bindings (SLet/SLetMut) introduce a\\n// module-level name (key 0 => grouped file-wide); we record the binder's located\\n// NAME and walk the body. SModule recurses.\\nlet bind_walk_stmt: (BindState, Stmt) -> Unit = (st, stmt) -> {\\n  match stmt {\\n    SLet(_, _, name, _, body) => {\\n      bind_record_module_binder(st, name)\\n      bind_walk_expr(st, body)\\n    },\\n    SLetMut(name, _, body) => {\\n      bind_record_module_binder(st, name)\\n      bind_walk_expr(st, body)\\n    },\\n    STest(_, body) => bind_walk_expr(st, body),\\n    SBench(_, body) => bind_walk_expr(st, body),\\n    SExpr(e) => bind_walk_expr(st, e),\\n    SLetPat(_, body) => bind_walk_expr(st, body),\\n    SModule(_, _, body) => bind_walk_stmts(st, body),\\n    _ => ()\\n  }\\n}\\n\\nlet bind_walk_stmts: (BindState, Array[Stmt]) -> Unit = (st, stmts) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    bind_walk_stmt(st, Array::get(stmts, i))\\n    i = i + 1\\n  }\\n}\\n\\n// Among all hits whose span [off, off+len(name)) contains `tgt`, pick the one\\n// with the largest `off` (innermost / closest start). Returns the (name, key) of\\n// that hit, or (\\\"\\\", 0) when none.\\nlet bind_pick_at: (Array[BindHit], Int) -> (String, Int) = (hits, tgt) -> {\\n  let mut best_name = \\\"\\\"\\n  let mut best_key = 0\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      BindHit(name, off, key) => {\\n        let span_end = off + String::length(name)\\n        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {\\n          best_name = name\\n          best_key = key\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  (best_name, best_key)\\n}\\n\\n// Insert (start, end) into `out` keeping it sorted by start ascending and\\n// de-duplicated (skip when an identical start is already present — equal starts\\n// imply equal spans because the name length is fixed).\\nlet bind_insert_sorted_unique: (Array[(Int, Int)], Int, Int) -> Unit = (out, start, end) -> {\\n  let n = Array::length(out)\\n  let mut dup = false\\n  let mut idx = n\\n  let mut j = 0\\n  while j < n {\\n    let (s, _) = Array::get(out, j)\\n    if s == start {\\n      dup = true\\n    } else {\\n      ()\\n    }\\n    if s > start && idx == n {\\n      idx = j\\n    } else {\\n      ()\\n    }\\n    j = j + 1\\n  }\\n  if dup {\\n    ()\\n  } else if idx == n {\\n    Array::push(out, (start, end))\\n  } else {\\n    Array::push(out, Array::get(out, n - 1))\\n    let mut k = n - 1\\n    while k > idx {\\n      Array::set(out, k, Array::get(out, k - 1))\\n      k = k - 1\\n    }\\n    Array::set(out, idx, (start, end))\\n  }\\n}\\n\\n// Collect the (start, end) source spans of every occurrence that resolves to the\\n// SAME binding as the identifier under the cursor at 1-based (line, col). Steps:\\n//   1. lex + parse located; scope-aware walk collecting located references\\n//      (resolved to a binding id) plus recovered binders.\\n//   2. find the (name, key) covering the cursor offset; \\\"\\\" -> no occurrences.\\n//   3. emit a span for every hit with the same name AND key (key 0 = module /\\n//      free name grouped file-wide), de-duplicated and sorted by start.\\n// AST-accurate and scope-aware (see file header). Any failure is swallowed and\\n// yields an empty list.\\nlet binding_occurrences_impl: (String, Int, Int) -> Array[(Int, Int)] with { Error } = (source, line, col) -> {\\n  {\\n    let tgt = bind_line_col_to_offset(source, line, col)\\n    let (tokens, starts, _ends) = lex_with_offsets(source)\\n    let stmts = parse_program_located(tokens, starts, source)\\n    let st = bind_new_state(source)\\n    bind_walk_stmts(st, stmts)\\n    let hits = st.hits\\n    let (name, key) = bind_pick_at(hits, tgt)\\n    let out = Array::slice([\\n      (0, 0)\\n    ], 0, 0)\\n    if name == \\\"\\\" {\\n      out\\n    } else {\\n      let mut i = 0\\n      while i < Array::length(hits) {\\n        match Array::get(hits, i) {\\n          BindHit(hname, hoff, hkey) => {\\n            if hname == name && hkey == key && hoff >= 0 {\\n              bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))\\n            } else {\\n              ()\\n            }\\n          }\\n        }\\n        i = i + 1\\n      }\\n      out\\n    }\\n  }\\n}\\n\\nexport let binding_occurrences: (String, Int, Int) -> Array[(Int, Int)] = (source, line, col) -> {\\n  handle {\\n    binding_occurrences_impl(source, line, col)\\n  } with Error {\\n    Throw(_) => Array::slice([\\n      (0, 0)\\n    ], 0, 0)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_123 = () -> (String, String) {\n  (\"vibe/compiler/runtime/symbol_spans.vibe\",\n\"//# Imports\\n\\n// `vibe symbols` — AST-accurate top-level (and module-nested) declaration spans:\\n// the foundation for scope-precision document outline / go-to-definition\\n// (テーマ4 LSP). Given a source string, return one record per declared symbol:\\n//   (name, kind, start, end)\\n// where `kind` is an LSP SymbolKind number and [start, end) is the source span\\n// of the declaration NAME (char offsets).\\n//\\n// Why this beats the LSP server's previous line-regex scan: declarations are\\n// taken from the real parsed AST, so multi-line declarations, declarations not\\n// starting at column 0, and names that merely look like keywords inside strings\\n// or comments are handled correctly — only actual declaration nodes count. The\\n// name's source offset is recovered by a whole-word scan SCOPED to that\\n// statement's parse span (from parse_program_spans), so a name that also appears\\n// elsewhere in the statement body cannot be mis-located.\\n//\\n// FALLBACK (honest): a name whose offset cannot be recovered within its span is\\n// simply omitted (never a crash). Resolution never throws: any failure is\\n// swallowed and yields an empty list, so the LSP degrades to its regex scan.\\n//\\n// All strings are built with String::concat only (never `+`, never \\\"\\\\{x}\\\"\\n// interpolation): both mis-codegen to NUL in selfhost.\\n\\nimport ../core {\\n  Stmt, Expr\\n}\\n\\nimport ../syntax {\\n  lex_with_offsets, parse_program_spans\\n}\\n\\n//# Functions\\n\\n// True when `source[off]` is NOT an identifier char (or off out of range) — a\\n// word boundary. Used to match a declaration name as a whole word.\\nlet sym_is_boundary_at: (String, Int) -> Bool = (source, off) -> {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\n\\n// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box),\\n// built via slice+push so the cell is a heap array supporting Array::set.\\nlet sym_box_int: (Int) -> Array[Int] = (v) -> {\\n  let arr = Array::slice([0], 0, 0)\\n  Array::push(arr, v)\\n  arr\\n}\\n\\nlet sym_empty_items: () -> Array[(String, Int, Int, Int)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", 0, 0, 0)\\n  ], 0, 0)\\n}\\n\\n// Find the first whole-word occurrence of `name` in `source[from..hi)` and, when\\n// found, push `(name, kind, off, off+len)` and advance `floor` past it (so a\\n// later sibling declaration in the same window keeps scanning forward). No-op\\n// when the name cannot be located in the window.\\nlet sym_emit: (Array[(String, Int, Int, Int)], String, String, Int, Array[Int], Int) -> Unit = (out, source, name, kind, floor, hi) -> {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    ()\\n  } else {\\n    let limit = if hi > String::length(source) { String::length(source) } else { hi }\\n    let mut i = Array::get(floor, 0)\\n    if i < 0 {\\n      i = 0\\n    } else {\\n      ()\\n    }\\n    let mut found = false\\n    while !found && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && sym_is_boundary_at(source, i - 1) && sym_is_boundary_at(source, i + nlen) {\\n        Array::push(out, (name, kind, i, i + nlen))\\n        Array::set(floor, 0, i + nlen)\\n        found = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\n\\n// LSP SymbolKind for a top-level value binding: Function (12) when its body is a\\n// lambda, else Variable (13).\\nlet sym_let_kind: (Expr) -> Int = (body) -> {\\n  match body {\\n    EFn(_, _, _, _, _, _) => 12,\\n    _ => 13\\n  }\\n}\\n\\n// Emit the symbol for one statement within the window [floor, hi). SModule emits\\n// the module name (kind 2 = Module) then recurses into its body, threading the\\n// SAME advancing floor so nested declarations are located in source order.\\nlet rec sym_walk_stmt: (Array[(String, Int, Int, Int)], String, Stmt, Array[Int], Int) -> Unit = (out, source, stmt, floor, hi) -> {\\n  match stmt {\\n    SLet(_, _, name, _, body) => sym_emit(out, source, name, sym_let_kind(body), floor, hi),\\n    SLetMut(name, _, _) => sym_emit(out, source, name, 13, floor, hi),\\n    SEnum(_, name, _, _, _) => sym_emit(out, source, name, 10, floor, hi),\\n    SSuberror(_, name, _) => sym_emit(out, source, name, 10, floor, hi),\\n    SStruct(_, name, _, _, _) => sym_emit(out, source, name, 23, floor, hi),\\n    STypeAlias(_, name, _, _) => sym_emit(out, source, name, 26, floor, hi),\\n    STrait(_, name, _, _, _) => sym_emit(out, source, name, 11, floor, hi),\\n    SEffectDef(_, name, _, _) => sym_emit(out, source, name, 24, floor, hi),\\n    SModule(_, name, body) => {\\n      sym_emit(out, source, name, 2, floor, hi)\\n      let mut j = 0\\n      while j < Array::length(body) {\\n        sym_walk_stmt(out, source, Array::get(body, j), floor, hi)\\n        j = j + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\n// Collect declaration symbols. Steps:\\n//   1. lex + parse with per-statement spans (parse_program_spans).\\n//   2. for each top-level statement, scan its own [start, end) span for the\\n//      declaration name and emit (name, kind, start, end); SModule recurses.\\n// AST-accurate (see file header). Any failure is swallowed -> empty list.\\nlet symbol_spans_impl: (String) -> Array[(String, Int, Int, Int)] with { Error } = (source) -> {\\n  {\\n    let (tokens, starts, ends) = lex_with_offsets(source)\\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\\n    let out = sym_empty_items()\\n    let mut i = 0\\n    while i < Array::length(span_stmts) {\\n      let lo = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\\n      let hi = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\\n      let floor = sym_box_int(lo)\\n      sym_walk_stmt(out, source, Array::get(span_stmts, i), floor, hi)\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\n\\nexport let symbol_spans: (String) -> Array[(String, Int, Int, Int)] = (source) -> {\\n  handle {\\n    symbol_spans_impl(source)\\n  } with Error {\\n    Throw(_) => Array::slice([\\n      (\\\"\\\", 0, 0, 0)\\n    ], 0, 0)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_124 = () -> (String, String) {\n  (\"vibe/compiler/runtime/persistent_env_codec.vibe\",\n\"//# Imports\\n\\nimport .. / cache / persistent_cache.vibe {\\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path\\n}\\n\\nimport .. / core {\\n  Type, TypeEnv, env_flat_bindings\\n}\\n\\n//# Functions\\n\\nlet parse_int_unwrap: (String, Int) -> Int = (raw, fallback) -> {\\n  let len = String::length(raw)\\n  let mut result = 0\\n  let mut i = 0\\n  let mut neg = false\\n  let mut valid = true\\n  if len == 0 { valid = false }\\n  if valid {\\n    if String::char_code_at(raw, 0) == 45 { neg = true; i = 1 }\\n  }\\n  while valid {\\n    if i >= len { break }\\n    let c = String::char_code_at(raw, i)\\n    if c < 48 { valid = false }\\n    else if c > 57 { valid = false }\\n    else {\\n      result = result * 10 + (c - 48)\\n      i = i + 1\\n    }\\n  }\\n  if valid {\\n    if neg { 0 - result } else result\\n  } else fallback\\n}\\n\\nlet serialize_segment: (String) -> String = (text) -> {\\n  let len = String::length(text)\\n  let len_str = __to_string(len)\\n  let colon_text = String::concat(\\\":\\\", text)\\n  String::concat(len_str, colon_text)\\n}\\n\\nlet decode_effect_name: (String) -> String = (raw) -> {\\n  if raw == \\\"\\\" || raw == \\\"0\\\" {\\n    \\\"\\\"\\n  } else if raw == \\\"1\\\" {\\n    \\\"Error\\\"\\n  } else {\\n    raw\\n  }\\n}\\n\\nlet parse_count_header: (String, Int, Int) -> (Int, Int) with { Error } = (text, pos, terminator) -> {\\n  let len = String::length(text)\\n  let mut i = pos\\n  while i < len && String::char_code_at(text, i) != terminator {\\n    i = i + 1\\n  }\\n  if i >= len {\\n    throw(\\\"invalid persistent type env payload\\\")\\n  } else {\\n    let parsed = parse_int_unwrap(text[pos: i], 0)\\n    (parsed, i + 1)\\n  }\\n}\\n\\nlet parse_segment: (String, Int) -> (String, Int) with { Error } = (text, pos) -> {\\n  let (seg_len, start) = parse_count_header(text, pos, 58)\\n  let end = start + seg_len\\n  if end > String::length(text) {\\n    throw(\\\"invalid persistent type env segment\\\")\\n  } else {\\n    (text[start: end], end)\\n  }\\n}\\n\\nlet parse_int_array: (String, Int) -> (Array[Int], Int) with { Error } = (text, pos) -> {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (raw, next_cursor) = parse_segment(text, cursor)\\n    let parsed_val = parse_int_unwrap(raw, 0)\\n    Array::push(items, parsed_val)\\n    cursor = next_cursor\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env int array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\n\\nlet parse_string_array: (String, Int) -> (Array[String], Int) with { Error } = (text, pos) -> {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (item, next_cursor) = parse_segment(text, cursor)\\n    Array::push(items, item)\\n    cursor = next_cursor\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env string array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\n\\nlet parse_bounds_array: (String, Int) -> (Array[(Int, Array[String])], Int) with { Error } = (text, pos) -> {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    (0, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (raw_id, next_cursor) = parse_segment(text, cursor)\\n    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)\\n    let parsed_id = parse_int_unwrap(raw_id, 0)\\n    Array::push(items, (parsed_id, bounds))\\n    cursor = next_cursor2\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env bounds array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\n\\nlet rec parse_cached_type: (String, Int) -> (Type, Int) with { Error } = (source, pos) -> {\\n  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {\\n    let (count, start) = parse_count_header(text, pos, 91)\\n    let items = Array::slice([\\n      CtUnknown\\n    ], 0, 0)\\n    let mut i = 0\\n    let mut cursor = start\\n    while i < count {\\n      let (raw, next_cursor) = parse_segment(text, cursor)\\n      let (item, end_cursor) = parse_cached_type(raw, 0)\\n      if end_cursor != String::length(raw) {\\n        throw(\\\"invalid persistent type env nested type\\\")\\n      } else {\\n        Array::push(items, item)\\n        cursor = next_cursor\\n        i = i + 1\\n      }\\n    }\\n    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n      throw(\\\"invalid persistent type env type array\\\")\\n    } else {\\n      (items, cursor + 1)\\n    }\\n  }\\n  if pos >= String::length(source) {\\n    throw(\\\"invalid persistent type env type\\\")\\n  } else {\\n    let tag = String::char_code_at(source, pos)\\n    match tag {\\n      73 => (CtInt, pos + 1),\\n      68 => (CtDouble, pos + 1),\\n      66 => (CtBool, pos + 1),\\n      71 => (CtString, pos + 1),\\n      72 => (CtChar, pos + 1),\\n      85 => (CtUnit, pos + 1),\\n      89 => (CtBytes, pos + 1),\\n      88 => (CtUnknown, pos + 1),\\n      86 => {\\n        let (raw, next_pos) = parse_segment(source, pos + 1)\\n        let var_id = parse_int_unwrap(raw, 0)\\n        (CtVar(var_id), next_pos)\\n      },\\n      69 => {\\n        let (name, next_pos) = parse_segment(source, pos + 1)\\n        (CtEnum(name), next_pos)\\n      },\\n      82 => {\\n        let (name, next_pos) = parse_segment(source, pos + 1)\\n        (CtStruct(name), next_pos)\\n      },\\n      65 => {\\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\\n        (CtArray(elem), next_pos)\\n      },\\n      79 => {\\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\\n        (CtOption(elem), next_pos)\\n      },\\n      84 => {\\n        let (elems, next_pos) = parse_type_array(source, pos + 1)\\n        (CtTuple(elems), next_pos)\\n      },\\n      70 => {\\n        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)\\n        let (params, next_pos2) = parse_type_array(source, next_pos1)\\n        let (ret, next_pos3) = parse_cached_type(source, next_pos2)\\n        let eff_raw = decode_effect_name(raw_effect)\\n        let eff_name = if String::length(eff_raw) > 0 { Some(eff_raw) } else { None }\\n        (CtFn(params, ret, eff_name), next_pos3)\\n      },\\n      78 => {\\n        let (name, next_pos1) = parse_segment(source, pos + 1)\\n        let (args, next_pos2) = parse_type_array(source, next_pos1)\\n        (CtNamed(name, args), next_pos2)\\n      },\\n      81 => {\\n        let (vars, next_pos1) = parse_int_array(source, pos + 1)\\n        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)\\n        let (body, next_pos3) = parse_cached_type(source, next_pos2)\\n        (CtForAll(vars, bounds, body), next_pos3)\\n      },\\n      _ => throw(\\\"invalid persistent type env type tag\\\")\\n    }\\n  }\\n}\\n\\n// All `serialize_*_array` helpers below used a `String::concat(out, ...)`\\n// accumulator that was O(N²) over the array length. Cache-serialisation\\n// runs them on every TypeEnv save, and large modules hit thousands of\\n// bindings — the cumulative cost shows up in `vibe check` cold runs.\\n// StringBuilder collapses each one to O(N).\\nlet serialize_int_array: (Array[Int]) -> String = (items) -> {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\n\\nlet serialize_effect_name_str: (String) -> String = (effect_name) -> {\\n  effect_name\\n}\\n\\nlet serialize_string_array: (Array[String]) -> String = (items) -> {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\n\\nlet serialize_bounds_array: (Array[(Int, Array[String])]) -> String = (items) -> {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    let (id, bounds) = Array::get(items, i)\\n    StringBuilder::push(buf, serialize_segment(__to_string(id)))\\n    StringBuilder::push(buf, serialize_string_array(bounds))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\n\\nlet rec serialize_type: (Type) -> String = (ty) -> {\\n  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {\\n    let buf = StringBuilder::new()\\n    StringBuilder::push(buf, __to_string(Array::length(items)))\\n    StringBuilder::push(buf, \\\"[\\\")\\n    let mut i = 0\\n    while i < Array::length(items) {\\n      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))\\n      i = i + 1\\n    }\\n    StringBuilder::push(buf, \\\"]\\\")\\n    StringBuilder::freeze(buf)\\n  }\\n  match ty {\\n    CtInt => \\\"I\\\",\\n    CtDouble => \\\"D\\\",\\n    CtBool => \\\"B\\\",\\n    CtString => \\\"G\\\",\\n    CtChar => \\\"H\\\",\\n    CtUnit => \\\"U\\\",\\n    CtBytes => \\\"Y\\\",\\n    CtUnknown => \\\"X\\\",\\n    CtVar(id) => String::concat(\\\"V\\\", serialize_segment(__to_string(id))),\\n    CtEnum(name) => String::concat(\\\"E\\\", serialize_segment(name)),\\n    CtStruct(name) => String::concat(\\\"R\\\", serialize_segment(name)),\\n    CtArray(elem) => String::concat(\\\"A\\\", serialize_type(elem)),\\n    CtOption(elem) => String::concat(\\\"O\\\", serialize_type(elem)),\\n    CtTuple(elems) => String::concat(\\\"T\\\", serialize_type_array(elems)),\\n    CtFn(params, ret, effect_name) => {\\n      let eff_str = if effect_name is Some(n) { n } else { \\\"\\\" }\\n      String::concat(\\\"F\\\", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))\\n    },\\n    CtNamed(name, args) =>\\n    String::concat(\\\"N\\\", String::concat(serialize_segment(name), serialize_type_array(args))),\\n    CtForAll(vars, bounds, body) =>\\n    String::concat(\\\"Q\\\", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))\\n  }\\n}\\n\\nexport let persistent_dep_list_text: (Array[String]) -> String = (deps) -> {\\n  if Array::length(deps) == 0 {\\n    \\\"\\\"\\n  } else if Array::length(deps) == 1 {\\n    String::concat(\\\"version\\\\t3\\\\n\\\", Array::get(deps, 0))\\n  } else {\\n    String::concat(\\\"version\\\\t2\\\\n\\\", serialize_string_array(deps))\\n  }\\n}\\n\\nexport let load_persistent_dep_list: (String, String) -> Option[Array[String]] with { Error, Fs } = (path, source) -> {\\n  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    if String::length(text) == 0 {\\n      Some(Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))\\n    } else {\\n      let v2_prefix = \\\"version\\\\t2\\\\n\\\"\\n      let v3_prefix = \\\"version\\\\t3\\\\n\\\"\\n      let text_len = String::length(text)\\n      let v2_len = String::length(v2_prefix)\\n      let v3_len = String::length(v3_prefix)\\n      if text_len >= v2_len &&\\n      text[0: v2_len] == v2_prefix {\\n        let body = text[v2_len: text_len]\\n        let (deps, end_pos) = parse_string_array(body, 0)\\n        if end_pos == String::length(body) {\\n          Some(deps)\\n        } else {\\n          throw(String::concat(\\\"invalid persistent dep list body: \\\", cache_path))\\n        }\\n      } else if text_len >= v3_len &&\\n      text[0: v3_len] == v3_prefix {\\n        let dep = text[v3_len: text_len]\\n        if String::length(dep) == 0 {\\n          Some(Array::slice([\\n            \\\"\\\"\\n          ], 0, 0))\\n        } else {\\n          Some([dep])\\n        }\\n      } else {\\n        throw(String::concat(\\\"invalid persistent dep list header: \\\", cache_path))\\n      }\\n    }\\n  }\\n}\\n\\nlet rebuild_persistent_type_env: (Array[(String, Type)]) -> TypeEnv = (bindings) -> {\\n  EnvFlat(bindings)\\n}\\n\\nexport let load_persistent_type_env: (String) -> Option[TypeEnv] with { Error, Fs } = (fingerprint) -> {\\n  let path = persistent_type_env_cache_path(fingerprint)\\n  if !(Fs::exists(path)) {\\n    None\\n  } else {\\n    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), \\\"\\\\n\\\")\\n    let len = Array::length(lines)\\n    let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {\\n      if index >= len {\\n        if version_ok {\\n          Some(rebuild_persistent_type_env(bindings))\\n        } else {\\n          None\\n        }\\n      } else {\\n        let line = Array::get(lines, index)\\n        if String::length(line) == 0 {\\n          go(index + 1, version_ok, bindings)\\n        } else {\\n          let parts = String::split(line, \\\"\\\\t\\\")\\n          if !version_ok {\\n            if Array::length(parts) == 2 &&\\n            Array::get(parts, 0) == \\\"version\\\" &&\\n            Array::get(parts, 1) == \\\"1\\\" {\\n              go(index + 1, true, bindings)\\n            } else {\\n              throw(String::concat(\\\"invalid persistent type env header: \\\", line))\\n            }\\n          } else if Array::length(parts) == 3 && Array::get(parts, 0) == \\\"bind\\\" {\\n            let raw_type = Array::get(parts, 2)\\n            let (ty, end_pos) = parse_cached_type(raw_type, 0)\\n            if end_pos != String::length(raw_type) {\\n              throw(String::concat(\\\"invalid persistent type env bind row: \\\", line))\\n            } else {\\n              // Was `Array::concat(bindings, [tuple])` — O(N) copy per\\n              // row, O(N²) over the file. Linear-recursive accumulation\\n              // through `go`, so push-mutating the shared `bindings`\\n              // is equivalent to the per-call rebuild.\\n              Array::push(bindings, (Array::get(parts, 1), ty))\\n              go(index + 1, true, bindings)\\n            }\\n          } else {\\n            throw(String::concat(\\\"invalid persistent type env row: \\\", line))\\n          }\\n        }\\n      }\\n    }\\n    go(0, false, Array::slice([\\n      (\\\"\\\", CtUnknown)\\n    ], 0, 0))\\n  }\\n}\\n\\nexport let persistent_type_env_cache_text: (TypeEnv) -> String = (env) -> {\\n  let bindings = env_flat_bindings(env)\\n  // StringBuilder over the bindings list — was O(N²) via `out =\\n  // String::concat(out, ...)` for N bindings.\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, \\\"version\\\\t1\\\\n\\\")\\n  let mut i = 0\\n  while i < Array::length(bindings) {\\n    let (name, ty) = Array::get(bindings, i)\\n    StringBuilder::push(buf, \\\"bind\\\\t\\\")\\n    StringBuilder::push(buf, name)\\n    StringBuilder::push(buf, \\\"\\\\t\\\")\\n    StringBuilder::push(buf, serialize_type(ty))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nexport let load_persistent_leaf_fingerprint: (String, String) -> Option[String] with { Error, Fs } = (path, source) -> {\\n  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    let prefix = \\\"version\\\\t1\\\\n\\\"\\n    if String::length(text) > String::length(prefix) &&\\n    text[0: String::length(prefix)] == prefix {\\n      Some(String::substring(text, String::length(prefix), String::length(text) - 1))\\n    } else {\\n      None\\n    }\\n  }\\n}\\n\\nexport let persistent_leaf_fingerprint_text: (String) -> String = (fingerprint) -> {\\n  String::concat(\\\"version\\\\t1\\\\n\\\", String::concat(fingerprint, \\\"\\\\n\\\"))\\n}\\n\")\n}\n\nlet cli_adapter_source_125 = () -> (String, String) {\n  (\"vibe/compiler/runtime/module_source.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Stmt,\\n  Expr,\\n  dce_keep_flags\\n}\\n\\nimport ../syntax/index.vibe {\\n  lex_with_offsets,\\n  parse_program_spans,\\n  offset_to_line_col\\n}\\n\\n//# Module source emission (selfhost port of host `emit-module-source`)\\n\\n// Reconstruct a flat module source containing only the top-level statements\\n// reachable from `entry_name` (via DCE), emitted as their original source text.\\n//\\n// Mirrors the MoonBit host `emit-module-source`\\n// (`src/cmd/vibe/cli_module_source.mbt`) but recovers statement source spans\\n// from the selfhost lexer (`lex_with_offsets`) + parser (`parse_program_spans`)\\n// instead of AST node spans, since the selfhost AST does not carry offsets.\\n// Pure: no filesystem or host calls.\\nexport let build_module_source_from_source: (String, String) -> String with { Error } = (source, entry_name) -> {\\n  let lexed = lex_with_offsets(source)\\n  let tokens = lexed.0\\n  let starts = lexed.1\\n  let ends = lexed.2\\n  let parsed = parse_program_spans(tokens, starts, ends)\\n  let stmts = parsed.0\\n  let span_start = parsed.1\\n  let span_end = parsed.2\\n  let keep = dce_keep_flags(stmts, [entry_name])\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    if Array::get(keep, i) {\\n      let s = Array::get(span_start, i)\\n      let e = Array::get(span_end, i)\\n      if e > s {\\n        let snippet = String::substring(source, s, e)\\n        StringBuilder::push(buf, snippet)\\n        let n = String::length(snippet)\\n        if n == 0 || String::char_code_at(snippet, n - 1) != '\\\\n' {\\n          StringBuilder::push(buf, \\\"\\\\n\\\")\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\n// debugger テーマ3 / M2: build a `.funcmap` sidecar text mapping each ENTRY-file\\n// top-level function definition to its 1-based source line, one `name<TAB>line\\\\n`\\n// per function. The launcher (`runtime/vibe`) reads this to annotate runtime trap\\n// backtrace frames (which name user functions via the wasm \\\"name\\\" section) with\\n// `(file:line)`.\\n//\\n// MVP scope: ENTRY-file top-level functions only. Imported-module functions are\\n// not yet covered (future work) — they are flattened into the program at compile\\n// time but their original source lines are not recovered here.\\n//\\n// Reuses the lexer offsets + parse_program_spans span table (same as\\n// build_module_source_from_source) so it needs no checker. A top-level `SLet`\\n// whose bound expr is a function (`EFn`) maps `name` -> line of the statement's\\n// start offset. All strings via String::concat + __to_string only (never `+`,\\n// never \\\"\\\\{}\\\" interpolation): both mis-codegen to NUL in selfhost.\\nexport let build_funcmap_from_source: (String) -> String with { Error } = (source) -> {\\n  let lexed = lex_with_offsets(source)\\n  let tokens = lexed.0\\n  let starts = lexed.1\\n  let ends = lexed.2\\n  let parsed = parse_program_spans(tokens, starts, ends)\\n  let stmts = parsed.0\\n  let span_start = parsed.1\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    let entry = match stmt {\\n      SLet(_, _, name, _, expr) => match expr {\\n        EFn(_, _, _, _, _, _) => {\\n          let off = Array::get(span_start, i)\\n          let lc = offset_to_line_col(source, off)\\n          let line = lc.0\\n          String::concat(name, String::concat(\\\"\\\\t\\\", String::concat(__to_string(line), \\\"\\\\n\\\")))\\n        },\\n        _ => \\\"\\\"\\n      },\\n      _ => \\\"\\\"\\n    }\\n    StringBuilder::push(buf, entry)\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\")\n}\n\nlet cli_adapter_source_126 = () -> (String, String) {\n  (\"vibe/compiler/runtime/index.vibe\",\n\"//# Imports\\n\\nimport ../core/index.vibe {\\n  Stmt,\\n  Type,\\n  TypeEnv,\\n  env_bind,\\n  env_flat_bindings,\\n  env_lookup_flat\\n}\\n\\nimport ../checker/checker_stmt.vibe {\\n  check_program_with_env\\n}\\n\\nimport ./eval_loader/index.vibe {\\n  contains_str\\n}\\n\\nimport ./typecheck_fs.vibe {\\n  ensure_fingerprint_fs_impl,\\n  load_persistent_dep_list,\\n  load_persistent_leaf_fingerprint,\\n  persistent_dep_list_text,\\n  persistent_leaf_fingerprint_text,\\n  persistent_type_env_cache_text,\\n  load_persistent_type_env\\n}\\n\\nimport ../syntax/index.vibe {\\n  lex,\\n  parse_program,\\n  print_program\\n}\\n\\nimport ../syntax/import_alias_rewrite.vibe {\\n  append_import_alias_rewritten_non_import_stmts_skipping,\\n  append_non_import_stmts_without_alias_rewrite,\\n  collect_import_alias_collision_locals,\\n  collect_import_alias_collision_refs,\\n  namespace_private_value_stmts,\\n  rewrite_imported_value_stmt_to_local,\\n  stmts_have_import_deep\\n}\\n\\nimport ../module_loader.vibe {\\n  load_or_parse_module_header_fs\\n}\\n\\nimport ../module_graph_path.vibe {\\n  dir_of_path,\\n  resolve_import_path,\\n  resolve_import_path_candidates\\n}\\n\\nimport ../cache/persistent_cache.vibe {\\n  persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path,\\n  persistent_type_env_cache_path\\n}\\n\\nimport ../ripple/index.vibe {\\n  RippleDb,\\n  ripple_eval_count,\\n  ripple_get_deps,\\n  ripple_get_fingerprint,\\n  ripple_get_source,\\n  ripple_new,\\n  ripple_record_eval,\\n  ripple_set_source\\n}\\n\\n//# Types\\n\\nenum StringTriple {\\n  StringTriple(String, String, String)\\n}\\n\\nenum TypeDbState {\\n  TypeDbState(\\n    RippleDb,\\n    Array[(String, TypeEnv)],\\n    Array[(String, String)],\\n    Array[StringTriple],\\n    Array[StringTriple],\\n    Array[StringTriple],\\n    Int,\\n    Int,\\n    Int,\\n    Int\\n  )\\n}\\n\\nexport enum TypeDb {\\n  TypeDb(TypeDbState)\\n}\\n\\n//# Functions\\n\\nlet unwrap_db: (TypeDb) -> TypeDbState = (db) -> {\\n  match db {\\n    TypeDb(state) => state\\n  }\\n}\\n\\nlet wrap_db: (TypeDbState) -> TypeDb = (state) -> {\\n  TypeDb(state)\\n}\\n\\nlet parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\\n  handle {\\n    parse_program(lex(source))\\n  } with Error {\\n    Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), msg))\\n  }\\n}\\n\\nlet add_dep: (Array[String], String, String) -> Array[String] = (acc, raw_path, base_dir) -> {\\n  // Mutates `acc` in place. Caller pattern is `acc = add_dep(acc, ...)`\\n  // so the same reference is returned either way.\\n  if String::length(raw_path) == 0 {\\n    acc\\n  } else {\\n    let resolved = resolve_import_path(base_dir, raw_path)\\n    if contains_str(acc, resolved) {\\n      acc\\n    } else {\\n      Array::push(acc, resolved)\\n      acc\\n    }\\n  }\\n}\\n\\nlet empty_strings: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet empty_dep_fps: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nlet empty_env_cache: () -> Array[(String, TypeEnv)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", EnvEmpty)\\n  ], 0, 0)\\n}\\n\\nlet empty_string_pairs: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nlet empty_string_triples: () -> Array[StringTriple] = () -> {\\n  Array::slice([\\n    StringTriple(\\\"\\\", \\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nlet empty_stmt_array: () -> Array[Stmt] = () -> {\\n  Array::slice([\\n    SExport([\\\"_dummy\\\"])\\n  ], 0, 0)\\n}\\n\\nexport let db_new: () -> TypeDb = () -> {\\n  wrap_db(\\n    TypeDbState(\\n      ripple_new(),\\n      empty_env_cache(),\\n      empty_string_pairs(),\\n      empty_string_triples(),\\n      empty_string_triples(),\\n      empty_string_triples(),\\n      0,\\n      0,\\n      0,\\n      0\\n    )\\n  )\\n}\\n\\nlet lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {\\n  let len = Array::length(pairs)\\n  let rec go: (Int) -> Option[String] = (i) -> {\\n    if i >= len {\\n      None\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        Some(v)\\n      } else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nlet upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {\\n  let len = Array::length(pairs)\\n  let b = ArrayBuilder::new()\\n  let rec build: (Int) -> Array[(String, String)] = (i) -> {\\n    if i >= len {\\n      ArrayBuilder::push(b, (key, value))\\n      ArrayBuilder::freeze(b)\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        build(i + 1)\\n      } else {\\n        ArrayBuilder::push(b, (k, v))\\n        build(i + 1)\\n      }\\n    }\\n  }\\n  build(0)\\n}\\n\\nlet lookup_source_cache: (Array[StringTriple], String, String) -> Option[String] = (cache, path, fingerprint) -> {\\n  let len = Array::length(cache)\\n  let rec go: (Int) -> Option[String] = (i) -> {\\n    if i >= len {\\n      None\\n    } else {\\n      match Array::get(cache, i) {\\n        StringTriple(p, fp, source) =>\\n          if p == path && fp == fingerprint {\\n            Some(source)\\n          } else {\\n            go(i + 1)\\n          }\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nlet upsert_source_cache: (Array[StringTriple], String, String, String) -> Array[StringTriple] = (cache, path, fingerprint, source) -> {\\n  // O(N) in-place rebuild: previously each `Array::concat(acc, [x])`\\n  // copied the entire prefix per iteration → O(N^2) for large source\\n  // caches.\\n  let out = empty_string_triples()\\n  let mut i = 0\\n  let len = Array::length(cache)\\n  while i < len {\\n    match Array::get(cache, i) {\\n      StringTriple(p, fp, existing) =>\\n        if p == path && fp == fingerprint {\\n          ()\\n        } else {\\n          Array::push(out, StringTriple(p, fp, existing))\\n        }\\n    }\\n    i = i + 1\\n  }\\n  Array::push(out, StringTriple(path, fingerprint, source))\\n  out\\n}\\n\\nlet append_source_cache_entries: (Array[StringTriple], Array[StringTriple]) -> Array[StringTriple] = (cache, entries) -> {\\n  if Array::length(entries) == 0 {\\n    cache\\n  } else {\\n    let out = empty_string_triples()\\n    let mut i = 0\\n    while i < Array::length(cache) {\\n      Array::push(out, Array::get(cache, i))\\n      i = i + 1\\n    }\\n    let mut j = 0\\n    while j < Array::length(entries) {\\n      Array::push(out, Array::get(entries, j))\\n      j = j + 1\\n    }\\n    out\\n  }\\n}\\n\\nexport let db_set_source: (TypeDb, String, String) -> TypeDb = (db, path, source) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\\n      wrap_db(\\n        TypeDbState(\\n          ripple_set_source(rdb, path, source),\\n          env_cache,\\n          dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          artifact_cache,\\n          parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count\\n        )\\n      )\\n  }\\n}\\n\\nlet lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\\n  let len = Array::length(cache)\\n  let rec go: (Int) -> Option[TypeEnv] = (i) -> {\\n    if i >= len {\\n      None\\n    } else {\\n      let (p, env) = Array::get(cache, i)\\n      if p == path {\\n        Some(env)\\n      } else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\n\\nlet resolve_cached_import_path: (String, String, Array[(String, TypeEnv)]) -> String = (base_dir, raw_path, cache) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut selected = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(candidates) && selected == \\\"\\\" {\\n    let candidate = Array::get(candidates, i)\\n    match lookup_env_cache(cache, candidate) {\\n      Some(_) => {\\n        selected = candidate\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  if selected == \\\"\\\" {\\n    resolve_import_path(base_dir, raw_path)\\n  } else {\\n    selected\\n  }\\n}\\n\\nexport let db_check_env: (TypeDb, String) -> Option[TypeEnv] = (db, path) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)\\n  }\\n}\\n\\nlet starts_with_upper: (String) -> Bool = (name) -> {\\n  if String::length(name) == 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(name, 0)\\n    c >= 65 && c <= 90\\n  }\\n}\\n\\nlet rec type_returns_name: (Type, String) -> Bool = (ty, type_name) -> {\\n  match ty {\\n    CtEnum(name) => name == type_name,\\n    CtNamed(name, _) => name == type_name,\\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\\n    _ => false\\n  }\\n}\\n\\nlet bind_enum_constructor_companions: (TypeEnv, Array[(String, Type)], String) -> TypeEnv = (acc, dep_bindings, enum_name) -> {\\n  let mut out = acc\\n  let mut i = 0\\n  while i < Array::length(dep_bindings) {\\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\\n      out = env_bind(out, candidate_name, candidate_ty)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet bind_import_names_from_cache: (TypeEnv, String, Array[(String, Option[String])], Array[(String, TypeEnv)]) -> TypeEnv = (acc, resolved, names, cache) -> {\\n  let dep_env = match lookup_env_cache(cache, resolved) {\\n    Some(e) => e,\\n    None => EnvEmpty\\n  }\\n  let dep_bindings = env_flat_bindings(dep_env)\\n  let nlen = Array::length(names)\\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\\n    if j >= nlen {\\n      nacc\\n    } else {\\n      let (name, alias) = Array::get(names, j)\\n      let bound_name = match alias {\\n        Some(a) => a,\\n        None => name\\n      }\\n      let ty = match env_lookup_flat(dep_bindings, name) {\\n        Some(t) => t,\\n        None => CtUnknown\\n      }\\n      let with_name = env_bind(nacc, bound_name, ty)\\n      let with_companions = match ty {\\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\\n        _ => if starts_with_upper(name) {\\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\\n        } else {\\n          with_name\\n        }\\n      }\\n      bind_names(j + 1, with_companions)\\n    }\\n  }\\n  bind_names(0, acc)\\n}\\n\\nlet build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        SReExport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, EnvEmpty)\\n}\\n\\nlet upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {\\n  let len = Array::length(cache)\\n  let b = ArrayBuilder::new()\\n  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {\\n    if i >= len {\\n      ArrayBuilder::push(b, (path, env))\\n      ArrayBuilder::freeze(b)\\n    } else {\\n      let (p, e) = Array::get(cache, i)\\n      if p == path {\\n        build(i + 1)\\n      } else {\\n        ArrayBuilder::push(b, (p, e))\\n        build(i + 1)\\n      }\\n    }\\n  }\\n  build(0)\\n}\\n\\nlet compact_string_fingerprint: (String) -> String = (source) -> {\\n  let mod1 = 2147483647\\n  let mod2 = 2147483629\\n  let step1 = 131\\n  let step2 = 65599\\n  let len = String::length(source)\\n  let mut h1 = 17\\n  let mut h2 = 29\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(source, i)\\n    h1 = (h1 * step1 + c + 1) % mod1\\n    h2 = (h2 * step2 + c + i + 1) % mod2\\n    i = i + 1\\n  }\\n  String::concat(\\n    __to_string(len),\\n    String::concat(\\\":\\\", String::concat(__to_string(h1), String::concat(\\\":\\\", __to_string(h2))))\\n  )\\n}\\n\\nlet store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {\\n  Fs::write_file(\\n    persistent_type_env_cache_path(fingerprint),\\n    persistent_type_env_cache_text(env)\\n  )\\n}\\n\\nlet build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {\\n  let mut acc = compact_string_fingerprint(source)\\n  let mut i = 0\\n  while i < Array::length(dep_fps) {\\n    let dep_pair = Array::get(dep_fps, i)\\n    let dep_path = dep_pair.0\\n    let dep_fp = dep_pair.1\\n    let next = String::concat(\\n      acc,\\n      String::concat(\\\"|\\\", String::concat(dep_path, String::concat(\\\"=\\\", dep_fp)))\\n    )\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport let db_typecheck_count: (TypeDb) -> Int = (db) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)\\n  }\\n}\\n\\nexport let db_parse_count: (TypeDb) -> Int = (db) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count\\n  }\\n}\\n\\nexport let db_merge_count: (TypeDb) -> Int = (db) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count\\n  }\\n}\\n\\nexport let db_module_source_count: (TypeDb) -> Int = (db) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count\\n  }\\n}\\n\\nexport let db_codegen_count: (TypeDb) -> Int = (db) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count\\n  }\\n}\\n\\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, Array[String]) -> Array[String] = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, empty_strings())\\n}\\n\\nlet resolve_deps_for_source: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error } = (rdb, dep_source_cache, path, source, parse_count) -> {\\n  match lookup_string_pair(dep_source_cache, path) {\\n    Some(cached_source) =>\\n      if cached_source == source {\\n        match ripple_get_deps(rdb, path) {\\n          Some(deps) => (deps, dep_source_cache, parse_count),\\n          None => {\\n            let stmts = parse_program_with_path(path, source)\\n            let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\\n            (\\n              deps,\\n              upsert_string_pair(dep_source_cache, path, source),\\n              parse_count + 1\\n            )\\n          }\\n        }\\n      } else {\\n        let stmts = parse_program_with_path(path, source)\\n        let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\\n        (\\n          deps,\\n          upsert_string_pair(dep_source_cache, path, source),\\n          parse_count + 1\\n        )\\n      },\\n    None => {\\n      let stmts = parse_program_with_path(path, source)\\n      let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\\n      (\\n        deps,\\n        upsert_string_pair(dep_source_cache, path, source),\\n        parse_count + 1\\n      )\\n    }\\n  }\\n}\\n\\nlet load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {\\n  match load_persistent_dep_list(path, source) {\\n    Some(deps) => (\\n      deps,\\n      upsert_string_pair(dep_source_cache, path, source),\\n      parse_count\\n    ),\\n    None => {\\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\\n      (\\n        deps,\\n        upsert_string_pair(dep_source_cache, path, source),\\n        next_parse_count\\n      )\\n    }\\n  }\\n}\\n\\nlet resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {\\n  match lookup_string_pair(dep_source_cache, path) {\\n    Some(cached_source) =>\\n      if cached_source == source {\\n        match ripple_get_deps(rdb, path) {\\n          Some(deps) => (deps, dep_source_cache, parse_count),\\n          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n        }\\n      } else {\\n        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n      },\\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n  }\\n}\\n\\nlet rec ensure_fingerprint: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {\\n  if contains_str(stack, path) {\\n    throw(String::concat(\\\"type_db: import cycle detected at \\\", path))\\n  } else {\\n    match ripple_get_source(rdb, path) {\\n      None => (String::concat(\\\"missing:\\\", path), rdb, env_cache, dep_source_cache, parse_count),\\n      Some(source) => {\\n        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(\\n          rdb,\\n          dep_source_cache,\\n          path,\\n          source,\\n          parse_count\\n        )\\n        let dlen = Array::length(deps)\\n        // Cycle-detection stack: push self before recursing, truncate back after.\\n        // O(1) per frame vs. previous Array::concat(stack, [path]) which was O(depth) per frame.\\n        let saved_stack_len = Array::length(stack)\\n        Array::push(stack, path)\\n        // Tail-recursive over `deps`, accumulating (dep_path, dep_fp)\\n        // pairs into `dep_acc`. Previously each recursion did\\n        // `Array::concat(dep_acc, [tuple])` — O(N) copy per step,\\n        // O(N²) over the deps list. Mutating in place is safe because\\n        // `dep_acc` flows linearly down the recursion (one path, no\\n        // sibling branches that need the old prefix).\\n        let rec resolve_nested: (Int, Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } = (i, dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count) -> {\\n          if i >= dlen {\\n            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)\\n          } else {\\n            let dep_path = Array::get(deps, i)\\n            let (\\n              dep_fp,\\n              next_db,\\n              next_env_cache,\\n              next_dep_source_cache2,\\n              next_parse_count\\n            ) = ensure_fingerprint(\\n              dep_db,\\n              dep_env_cache,\\n              dep_source_cache2,\\n              dep_parse_count,\\n              dep_path,\\n              stack\\n            )\\n            Array::push(dep_acc, (dep_path, dep_fp))\\n            resolve_nested(\\n              i + 1,\\n              dep_acc,\\n              next_db,\\n              next_env_cache,\\n              next_dep_source_cache2,\\n              next_parse_count\\n            )\\n          }\\n        }\\n        let resolved_nested = resolve_nested(\\n          0,\\n          empty_dep_fps(),\\n          rdb,\\n          env_cache,\\n          next_dep_source_cache,\\n          initial_parse_count\\n        )\\n        Array::truncate(stack, saved_stack_len)\\n        let dep_fps = resolved_nested.0\\n        let db_after_deps = resolved_nested.1\\n        let env_cache_after_deps = resolved_nested.2\\n        let dep_source_cache_after_deps = resolved_nested.3\\n        let parse_count_after_deps = resolved_nested.4\\n        let fingerprint = build_fingerprint(source, dep_fps)\\n        match ripple_get_fingerprint(db_after_deps, path) {\\n          Some(cached_fp) =>\\n            if cached_fp == fingerprint {\\n              (\\n                fingerprint,\\n                db_after_deps,\\n                env_cache_after_deps,\\n                dep_source_cache_after_deps,\\n                parse_count_after_deps\\n              )\\n            } else {\\n              let stmts = parse_program_with_path(path, source)\\n              let final_parse_count = parse_count_after_deps + 1\\n              let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\\n              let checked_env = check_program_with_env(stmts, import_env)\\n              let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\\n              let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\\n              (\\n                fingerprint,\\n                next_db,\\n                next_env_cache,\\n                dep_source_cache_after_deps,\\n                final_parse_count\\n              )\\n            },\\n          None => {\\n            let stmts = parse_program_with_path(path, source)\\n            let final_parse_count = parse_count_after_deps + 1\\n            let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\\n            let checked_env = check_program_with_env(stmts, import_env)\\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\\n            (\\n              fingerprint,\\n              next_db,\\n              next_env_cache,\\n              dep_source_cache_after_deps,\\n              final_parse_count\\n            )\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport let db_typecheck: (TypeDb, String) -> TypeDb with { Error } = (db, path) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let (\\n        _,\\n        next_rdb,\\n        next_env_cache,\\n        next_dep_source_cache,\\n        next_parse_count\\n      ) = ensure_fingerprint(\\n        rdb,\\n        env_cache,\\n        dep_source_cache,\\n        parse_count,\\n        path,\\n        empty_strings()\\n      )\\n      wrap_db(\\n        TypeDbState(\\n          next_rdb,\\n          next_env_cache,\\n          next_dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          artifact_cache,\\n          next_parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count\\n        )\\n      )\\n    }\\n  }\\n}\\n\\nexport let db_typecheck_fs: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, path) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let (\\n        _,\\n        next_rdb,\\n        next_env_cache,\\n        next_dep_source_cache,\\n        next_parse_count\\n      ) = ensure_fingerprint_fs_impl(\\n        rdb,\\n        env_cache,\\n        dep_source_cache,\\n        parse_count,\\n        path,\\n        empty_strings()\\n      )\\n      wrap_db(\\n        TypeDbState(\\n          next_rdb,\\n          next_env_cache,\\n          next_dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          artifact_cache,\\n          next_parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count\\n        )\\n      )\\n    }\\n  }\\n}\\n\\nexport let db_program_source: (TypeDb, String) -> (String, String, TypeDb) with { Error } = (db, path) -> {\\n  let checked = db_typecheck(db, path)\\n  match unwrap_db(checked) {\\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>\\n      match ripple_get_source(rdb, path) {\\n        None => throw(String::concat(\\\"missing:\\\", path)),\\n        Some(source) =>\\n          match ripple_get_fingerprint(rdb, path) {\\n            Some(fingerprint) => (source, fingerprint, checked),\\n            None => (source, source, checked)\\n          }\\n      }\\n  }\\n}\\n\\nlet build_merge_fingerprint: (Array[(String, String)]) -> String = (sources) -> {\\n  let mut acc = \\\"merged\\\"\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (_, source) = Array::get(sources, i)\\n    let next = String::concat(\\n      acc,\\n      String::concat(\\\"|\\\", compact_string_fingerprint(source))\\n    )\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nlet lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    if path == target_path {\\n      found = Some(source)\\n      i = Array::length(sources)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)]) -> Unit with { Error } = (merged, current_path, stmts, sources) -> {\\n  let refs = collect_import_alias_collision_refs(stmts)\\n  let emitted = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let base_dir = dir_of_path(current_path)\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    let (raw_path, original, local) = Array::get(refs, i)\\n    if !contains_str(emitted, local) {\\n      let resolved = resolve_import_path(base_dir, raw_path)\\n      match lookup_source_by_path(sources, resolved) {\\n        Some(source) => {\\n          let source_stmts = namespace_private_value_stmts(\\n            resolved,\\n            parse_program_with_path(resolved, source)\\n          )\\n          let mut j = 0\\n          let mut done = false\\n          while j < Array::length(source_stmts) && !done {\\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\\n              Some(local_stmt) => {\\n                Array::push(merged, local_stmt)\\n                Array::push(emitted, local)\\n                done = true\\n              },\\n              None => ()\\n            }\\n            j = j + 1\\n          }\\n        },\\n        None => ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nlet build_merged_source: (String, Array[(String, String)]) -> String with { Error } = (entry_path, sources) -> {\\n  let merged = empty_stmt_array()\\n  let source_count = Array::length(sources)\\n  let mut si = 0\\n  while si < source_count {\\n    let (path, source) = Array::get(sources, si)\\n    let stmts = parse_program_with_path(path, source)\\n    let is_entry_source = if entry_path == \\\"\\\" {\\n      si == source_count - 1\\n    } else {\\n      path == entry_path\\n    }\\n    let namespaced_stmts = if is_entry_source {\\n      stmts\\n    } else {\\n      namespace_private_value_stmts(path, stmts)\\n    }\\n    if stmts_have_import_deep(stmts) {\\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\\n      append_import_alias_collision_defs_from_sources(merged, path, stmts, sources)\\n      append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)\\n    } else {\\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\\n    }\\n    si = si + 1\\n  }\\n  print_program(merged)\\n}\\n\\nlet join_group_sources: (Array[String]) -> String = (group_sources) -> {\\n  let len = Array::length(group_sources)\\n  // O(N) via StringBuilder; the recursive `String::concat(acc, ...)` was\\n  // O(N²) over the source-group count.\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < len {\\n    let source = Array::get(group_sources, i)\\n    if i > 0 {\\n      StringBuilder::push(buf, \\\"\\\\n\\\")\\n    }\\n    StringBuilder::push(buf, source)\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nexport let db_merged_source: (TypeDb, String, Array[(String, String)]) -> (String, String, TypeDb) with { Error } = (db, _entry_path, sources) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let merge_fingerprint = build_merge_fingerprint(sources)\\n      let merge_cache_key = \\\"merged\\\"\\n      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {\\n        Some(merged_source) => (merged_source, merge_fingerprint, db),\\n        None => {\\n          let merged_source = build_merged_source(_entry_path, sources)\\n          let next_merged_cache = upsert_source_cache(\\n            merged_cache,\\n            merge_cache_key,\\n            merge_fingerprint,\\n            merged_source\\n          )\\n          (\\n            merged_source,\\n            merge_fingerprint,\\n            wrap_db(\\n              TypeDbState(\\n                rdb,\\n                env_cache,\\n                dep_source_cache,\\n                next_merged_cache,\\n                module_source_cache,\\n                artifact_cache,\\n                parse_count,\\n                merge_count + 1,\\n                module_source_count,\\n                codegen_count\\n              )\\n            )\\n          )\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport let db_grouped_merged_source: (TypeDb, Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with { Error } = (db, groups) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      // Keep per-group results in side buffers, then append cache misses\\n      // once. Rebuilding the full cache on every group miss is O(N^2) for\\n      // the ~150-group selfhost compiler manifest.\\n      let group_sources = empty_strings()\\n      let mut grouped_fingerprint = \\\"merged-groups\\\"\\n      let new_group_cache_entries = empty_string_triples()\\n      let mut merge_count_acc = merge_count\\n      let mut i = 0\\n      while i < Array::length(groups) {\\n        let (group_name, sources) = Array::get(groups, i)\\n        let fingerprint = build_merge_fingerprint(sources)\\n        let grouped_next = String::concat(\\n          grouped_fingerprint,\\n          String::concat(\\\"|\\\", String::concat(group_name, String::concat(\\\"=\\\", fingerprint)))\\n        )\\n        grouped_fingerprint = compact_string_fingerprint(grouped_next)\\n        let cache_key = String::concat(\\\"merged-group|\\\", group_name)\\n        match lookup_source_cache(merged_cache, cache_key, fingerprint) {\\n          Some(source) => {\\n            Array::push(group_sources, source)\\n          },\\n          None =>\\n            match lookup_source_cache(new_group_cache_entries, cache_key, fingerprint) {\\n              Some(source) => {\\n                Array::push(group_sources, source)\\n              },\\n              None => {\\n                let source = build_merged_source(\\\"\\\", sources)\\n                Array::push(new_group_cache_entries, StringTriple(cache_key, fingerprint, source))\\n                merge_count_acc = merge_count_acc + 1\\n                Array::push(group_sources, source)\\n              }\\n            }\\n        }\\n        i = i + 1\\n      }\\n      let next_merged_cache = append_source_cache_entries(merged_cache, new_group_cache_entries)\\n      let next_merge_count = merge_count_acc\\n      let grouped_cache_key = \\\"merged-groups\\\"\\n      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {\\n        Some(source) =>\\n          (\\n            source,\\n            grouped_fingerprint,\\n            wrap_db(\\n              TypeDbState(\\n                rdb,\\n                env_cache,\\n                dep_source_cache,\\n                next_merged_cache,\\n                module_source_cache,\\n                artifact_cache,\\n                parse_count,\\n                next_merge_count,\\n                module_source_count,\\n                codegen_count\\n              )\\n            )\\n          ),\\n        None => {\\n          let source = join_group_sources(group_sources)\\n          let final_merged_cache = upsert_source_cache(\\n            next_merged_cache,\\n            grouped_cache_key,\\n            grouped_fingerprint,\\n            source\\n          )\\n          (\\n            source,\\n            grouped_fingerprint,\\n            wrap_db(\\n              TypeDbState(\\n                rdb,\\n                env_cache,\\n                dep_source_cache,\\n                final_merged_cache,\\n                module_source_cache,\\n                artifact_cache,\\n                parse_count,\\n                next_merge_count + 1,\\n                module_source_count,\\n                codegen_count\\n              )\\n            )\\n          )\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nlet build_module_source: (String) -> String with { Error } = (source) -> {\\n  let stmts = parse_program(lex(source))\\n  let filtered = empty_stmt_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    let keep = match stmt {\\n      SLet(_, _, _, _, expr) => {\\n        match expr {\\n          EFn(_, _, _, _, _, _) => true,\\n          _ => false\\n        }\\n      },\\n      _ => false\\n    }\\n    if keep {\\n      Array::push(filtered, stmt)\\n    }\\n    i = i + 1\\n  }\\n  print_program(filtered)\\n}\\n\\nexport let db_module_source: (TypeDb, String, String) -> (String, TypeDb) with { Error } = (db, fingerprint, source) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let module_cache_key = \\\"module-source\\\"\\n      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {\\n        Some(module_source) => (module_source, db),\\n        None => {\\n          let module_source = build_module_source(source)\\n          let next_module_source_cache = upsert_source_cache(\\n            module_source_cache,\\n            module_cache_key,\\n            fingerprint,\\n            module_source\\n          )\\n          (\\n            module_source,\\n            wrap_db(\\n              TypeDbState(\\n                rdb,\\n                env_cache,\\n                dep_source_cache,\\n                merged_cache,\\n                next_module_source_cache,\\n                artifact_cache,\\n                parse_count,\\n                merge_count,\\n                module_source_count + 1,\\n                codegen_count\\n              )\\n            )\\n          )\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nlet artifact_cache_key: (String, String) -> String = (kind, entry_name) -> {\\n  String::concat(kind, String::concat(\\\"|\\\", entry_name))\\n}\\n\\nlet bytes_to_hex_digit: (Int) -> String = (n) -> {\\n  if n < 10 {\\n    __to_string(n)\\n  } else if n == 10 {\\n    \\\"a\\\"\\n  } else if n == 11 {\\n    \\\"b\\\"\\n  } else if n == 12 {\\n    \\\"c\\\"\\n  } else if n == 13 {\\n    \\\"d\\\"\\n  } else if n == 14 {\\n    \\\"e\\\"\\n  } else {\\n    \\\"f\\\"\\n  }\\n}\\n\\nlet nibble_from_hex_char: (Int) -> Int with { Error } = (c) -> {\\n  if c >= 48 && c <= 57 {\\n    c - 48\\n  } else if c >= 97 && c <= 102 {\\n    c - 87\\n  } else if c >= 65 && c <= 70 {\\n    c - 55\\n  } else {\\n    throw(\\\"invalid hex digit\\\")\\n  }\\n}\\n\\nlet bytes_to_hex: (Bytes) -> String = (bytes) -> {\\n  let len = Bytes::length(bytes)\\n  let mut i = 0\\n  // O(N) via StringBuilder; previously each `String::concat(out, ...)`\\n  // copied the growing buffer, making this O(N²) for the N-byte module\\n  // hashes this routine serialises.\\n  let buf = StringBuilder::new()\\n  while i < len {\\n    let byte = Bytes::get(bytes, i)\\n    let hi = byte / 16\\n    let lo = byte % 16\\n    StringBuilder::push(buf, bytes_to_hex_digit(hi))\\n    StringBuilder::push(buf, bytes_to_hex_digit(lo))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nlet hex_to_bytes: (String) -> Bytes with { Error } = (hex) -> {\\n  let len = String::length(hex)\\n  if len % 2 != 0 {\\n    throw(\\\"invalid hex length\\\")\\n  } else {\\n    let out = Bytes::new()\\n    let mut i = 0\\n    while i < len {\\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\\n      Bytes::push(out, hi * 16 + lo)\\n      i = i + 2\\n    }\\n    out\\n  }\\n}\\n\\nexport let db_load_artifact: (TypeDb, String, String, String, String) -> Option[Bytes] with { Error } = (db, _path, kind, entry_name, fingerprint) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>\\n      match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {\\n        Some(hex) => Some(hex_to_bytes(hex)),\\n        None => None\\n      }\\n  }\\n}\\n\\nexport let db_store_artifact: (TypeDb, String, String, String, String, Bytes) -> TypeDb = (db, _path, kind, entry_name, fingerprint, bytes) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\\n      wrap_db(\\n        TypeDbState(\\n          rdb,\\n          env_cache,\\n          dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          upsert_source_cache(\\n            artifact_cache,\\n            artifact_cache_key(kind, entry_name),\\n            fingerprint,\\n            bytes_to_hex(bytes)\\n          ),\\n          parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count + 1\\n        )\\n      )\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_127 = () -> (String, String) {\n  (\"vibe/compiler/cache/selfhost_codegen_fingerprint.vibe\",\n\"// AUTO-GENERATED by scripts/generate_selfhost_bundle.sh (#630).\\n// Do not edit manually. Regenerate with: bash scripts/generate_selfhost_bundle.sh\\n//\\n// A hash of every compiler source file in selfhost_sources_manifest.tsv (the\\n// codegen included). persistent_cache folds it into the artifact cache key so a\\n// codegen change — which produces different wasm from the SAME user source —\\n// automatically invalidates stale compiled .hex artifacts (#630).\\n\\n//# Functions\\n\\nexport let selfhost_codegen_fingerprint: () -> String = () -> {\\n  \\\"9706cb6f901dd9f8\\\"\\n}\\n\")\n}\n\nlet cli_adapter_source_128 = () -> (String, String) {\n  (\"vibe/compiler/cache/persistent_cache.vibe\",\n\"//# Imports\\n\\nimport ./selfhost_codegen_fingerprint.vibe {\\n  selfhost_codegen_fingerprint\\n}\\n\\n//# Functions\\n\\nexport let compact_string_fingerprint: (String) -> String = (source) -> {\\n  let mod1 = 2147483647\\n  let mod2 = 2147483629\\n  let step1 = 131\\n  let step2 = 65599\\n  let len = String::length(source)\\n  let mut h1 = 17\\n  let mut h2 = 29\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(source, i)\\n    h1 = (h1 * step1 + c + 1) % mod1\\n    h2 = (h2 * step2 + c + i + 1) % mod2\\n    i = i + 1\\n  }\\n  String::concat(__to_string(len), String::concat(\\\":\\\", String::concat(__to_string(h1), String::concat(\\\":\\\", __to_string(h2)))))\\n}\\n\\n// Cache key version tag. TWO independent reasons to bump it (#630):\\n//  - cache FORMAT change (how `.hex` / `.tsv` entries are serialized): bump `vNN`.\\n//  - CODEGEN / wasm-ABI change (the SAME source now compiles to DIFFERENT wasm):\\n//    bump `cgNN`. The artifact cache is keyed by the source fingerprint only, so\\n//    without a codegen segment a codegen change returns a STALE compiled wasm for\\n//    unchanged source. Bump `cg` on any change to emitted wasm / runtime ABI.\\n//    The `cg` segment is `selfhost_codegen_fingerprint()` — a build-time hash of\\n//    all compiler source files (selfhost_sources_manifest.tsv), regenerated with\\n//    the bundle. So any codegen-source change automatically changes the key and\\n//    invalidates stale artifacts; no manual bump needed (#630). `vNN` is still a\\n//    manual knob for pure cache-FORMAT changes that don't change the source hash.\\nlet persistent_cache_version_tag: () -> String = () -> {\\n  // v11 (#632): artifact cache switched from hex text (`.hex`) to raw binary\\n  // (`.bin`, via Fs::write_bytes / Fs::read_bytes) — a cache FORMAT change, so\\n  // the manual `vNN` knob is bumped. Old `.hex` entries are now unreferenced\\n  // (different key + suffix) and reclaimable via `pkf run cache-clean` (#631).\\n  String::concat(\\\"v11|cg-\\\", selfhost_codegen_fingerprint())\\n}\\n\\nlet stable_cache_path: (String, String, String) -> String = (prefix, seed, suffix) -> {\\n  let raw = compact_string_fingerprint(String::concat(\\\"persistent-cache-\\\", String::concat(persistent_cache_version_tag(), String::concat(\\\"|\\\", seed))))\\n  // O(N) build via StringBuilder; the previous `token = String::concat(token, ...)`\\n  // per char was O(N²) over the fingerprint length (issue #366).\\n  let token_sb = StringBuilder::new()\\n  let mut i = 0\\n  while i < String::length(raw) {\\n    let c = String::char_code_at(raw, i)\\n    let piece = if c == 58 {\\n      \\\"_\\\"\\n    } else {\\n      String::from_char_code(c)\\n    }\\n    StringBuilder::push(token_sb, piece)\\n    i = i + 1\\n  }\\n  let token = StringBuilder::freeze(token_sb)\\n  String::concat(\\\"_build/vibe_\\\", String::concat(prefix, String::concat(\\\"_\\\", String::concat(token, suffix))))\\n}\\n\\nlet build_sources_fingerprint: (Array[(String, String)]) -> String = (sources) -> {\\n  let mut acc = \\\"merged\\\"\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (_, source) = Array::get(sources, i)\\n    let next = String::concat(acc, String::concat(\\\"|\\\", compact_string_fingerprint(source)))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport let persistent_artifact_cache_path: (String, String, String) -> String = (kind, entry_name, fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_artifact\\\", String::concat(kind, String::concat(\\\"|\\\", String::concat(entry_name, String::concat(\\\"|\\\", fingerprint)))), \\\".bin\\\")\\n}\\n\\nexport let store_persistent_artifact: (String, String, String, Bytes) -> Unit with { Error, Fs } = (kind, entry_name, fingerprint, bytes) -> {\\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\\n  // #632: store the compiled wasm RAW. Previously hex-encoded text (`.hex`),\\n  // doubling disk and paying encode/decode each store/load; the artifact is a\\n  // wasm binary (magic begins 0x00), so raw needs a byte-exact reader —\\n  // Fs::read_bytes (load below), the inverse of this Fs::write_bytes.\\n  Fs::write_bytes(path, bytes)\\n}\\n\\nexport let persistent_dep_list_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_dep_list\\\", String::concat(path, String::concat(\\\"|\\\", source_fingerprint)), \\\".tsv\\\")\\n}\\n\\nexport let persistent_type_env_cache_path: (String) -> String = (fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_type_env_v2\\\", fingerprint, \\\".tsv\\\")\\n}\\n\\nexport let build_source_groups_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (groups) -> {\\n  let mut acc = \\\"merged-groups\\\"\\n  let mut i = 0\\n  while i < Array::length(groups) {\\n    let (group_name, sources) = Array::get(groups, i)\\n    let fingerprint = build_sources_fingerprint(sources)\\n    let next = String::concat(acc, String::concat(\\\"|\\\", String::concat(group_name, String::concat(\\\"=\\\", fingerprint))))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport let normalize_persistent_cache_text: (String) -> String = (text) -> {\\n  let len = String::length(text)\\n  let mut start = 0\\n  while start < len && String::char_code_at(text, start) == 0 {\\n    start = start + 1\\n  }\\n  if start == 0 {\\n    text\\n  } else {\\n    text[start: len]\\n  }\\n}\\n\\nexport let load_persistent_artifact: (String, String, String) -> Option[Bytes] with { Error, Fs } = (kind, entry_name, fingerprint) -> {\\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\\n  if !(Fs::exists(path)) {\\n    None\\n  } else {\\n    // #632: read the raw wasm back byte-exact. No hex decode and no leading-NUL\\n    // normalize (that was a workaround for the utf8 read_file text path; raw\\n    // Fs::read_bytes returns the file bytes verbatim, incl. the 0x00 wasm magic).\\n    Some(Fs::read_bytes(path))\\n  }\\n}\\n\\nexport let persistent_source_list_cache_path: (String) -> String = (entry_path) -> {\\n  stable_cache_path(\\\"selfhost_source_list\\\", entry_path, \\\".tsv\\\")\\n}\\n\\nexport let persistent_source_group_cache_path: (String) -> String = (entry_path) -> {\\n  stable_cache_path(\\\"selfhost_source_groups\\\", entry_path, \\\".tsv\\\")\\n}\\n\\nexport let persistent_module_header_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_module_header_v2\\\", String::concat(path, String::concat(\\\"|\\\", source_fingerprint)), \\\".tsv\\\")\\n}\\n\\nexport let persistent_manifest_header_cache_path: (String) -> String = (entry_path) -> {\\n  stable_cache_path(\\\"selfhost_manifest_headers\\\", entry_path, \\\".tsv\\\")\\n}\\n\\nexport let persistent_leaf_fingerprint_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_leaf_fp_v2\\\", String::concat(path, String::concat(\\\"|\\\", source_fingerprint)), \\\".tsv\\\")\\n}\\n\\nlet build_sources_fingerprint_from_compact_fingerprints: (Array[String]) -> String = (source_fingerprints) -> {\\n  let mut acc = \\\"merged\\\"\\n  let mut i = 0\\n  while i < Array::length(source_fingerprints) {\\n    let next = String::concat(acc, String::concat(\\\"|\\\", Array::get(source_fingerprints, i)))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport let build_source_groups_fingerprint_from_compact_fingerprints: (Array[(String, Array[(String, String)])]) -> String = (groups) -> {\\n  let mut acc = \\\"merged-groups\\\"\\n  let mut i = 0\\n  while i < Array::length(groups) {\\n    let (group_name, specs) = Array::get(groups, i)\\n    let source_fingerprints = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let mut j = 0\\n    while j < Array::length(specs) {\\n      let (_, source_fingerprint) = Array::get(specs, j)\\n      Array::push(source_fingerprints, source_fingerprint)\\n      j = j + 1\\n    }\\n    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)\\n    let next = String::concat(acc, String::concat(\\\"|\\\", String::concat(group_name, String::concat(\\\"=\\\", fingerprint))))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport let build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint: (String, String) -> String = (source_groups_fingerprint, entry_name) -> {\\n  compact_string_fingerprint(String::concat(\\\"fs-compile|\\\", String::concat(source_groups_fingerprint, String::concat(\\\"|\\\", entry_name))))\\n}\\n\\nexport let build_fs_compile_wasi_artifact_fingerprint: (Array[(String, Array[(String, String)])], String) -> String = (source_groups, entry_name) -> {\\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name)\\n}\\n\\nexport let build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint: (String, String, String) -> String = (source_groups_fingerprint, entry_name, mode) -> {\\n  compact_string_fingerprint(String::concat(\\\"file-compile|\\\", String::concat(source_groups_fingerprint, String::concat(\\\"|\\\", String::concat(entry_name, String::concat(\\\"|\\\", mode))))))\\n}\\n\\nexport let build_file_compile_wasi_artifact_fingerprint: (Array[(String, Array[(String, String)])], String, String) -> String = (source_groups, entry_name, mode) -> {\\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name, mode)\\n}\\n\\nexport let build_fs_compile_module_artifact_fingerprint_from_group_fingerprint: (String) -> String = (source_groups_fingerprint) -> {\\n  compact_string_fingerprint(String::concat(\\\"fs-compile-module|\\\", source_groups_fingerprint))\\n}\\n\\nexport let build_fs_compile_module_artifact_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (source_groups) -> {\\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\\n}\\n\\nexport let build_file_compile_module_artifact_fingerprint_from_group_fingerprint: (String) -> String = (source_groups_fingerprint) -> {\\n  compact_string_fingerprint(String::concat(\\\"file-compile-module|\\\", source_groups_fingerprint))\\n}\\n\\nexport let build_file_compile_module_artifact_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (source_groups) -> {\\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\\n}\\n\")\n}\n\nlet cli_adapter_source_129 = () -> (String, String) {\n  (\"vibe/compiler/module_graph_path.vibe\",\n\"//# Functions\\n\\nexport let dir_of_path: (String) -> String = (file_path) -> {\\n  let idx = String::last_index_of(file_path, \\\"/\\\")\\n  if idx < 0 {\\n    \\\"\\\"\\n  } else if idx == 0 {\\n    \\\"/\\\"\\n  } else {\\n    file_path[0: idx]\\n  }\\n}\\n\\n// Linear membership scan used by `resolve_reexport_chain` to filter\\n// re-exported names. Bounded per-module, not whole-program: `items`\\n// (`wanted_names`) is a single re-export selection (typically 1-5 names)\\n// and it is scanned once per pub statement of one source file. The\\n// original O(N^2)-accumulator survey (#366) classified this as \\\"small N,\\n// refactor pointless\\\" and #533 re-confirms it. A `Map[String, Bool]`\\n// would NOT help: the selfhost runtime emits `Map::has_key` as a linear\\n// search (#395, closed not-planned). See\\n// bench/selfhost_perf/README.md (\\\"String-keyed lookup\\\" postmortem).\\nexport let contains_name: (Array[String], String) -> Bool = (items, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    if Array::get(items, i) == name {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// Linear membership scan used by `collect_direct_dep_paths` to dedup the\\n// direct dependency paths of one entry file. Bounded by that file's\\n// unique imports (≈5-30), so the dedup is O(D^2) with small D (≤ ~900\\n// ops, per #366's survey). Kept linear deliberately (#533):\\n//   - `Map[String, Bool]` is a no-op — the selfhost runtime emits\\n//     `Map::has_key`/`Map::get` as linear searches (#395 not-planned).\\n//   - A sort+merge dedup is UNSAFE: the resulting `dep_paths` order is\\n//     preserved into `linked_imports`, which the linked codegen turns\\n//     into wasm import-section indices (see\\n//     vibe/compiler/codegen/wasi/linked_compile.vibe). Reordering would\\n//     change the emitted binary, breaking reproducibility/parity.\\n// First-occurrence insertion order must therefore be preserved.\\nexport let contains_path: (Array[String], String) -> Bool = (visited, path) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(visited) && !found {\\n    if Array::get(visited, i) == path {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nexport let normalize_path: (String) -> String = (path) -> {\\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\\n  let mut parts = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let len = String::length(path)\\n  let mut start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_sep = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(path, i) == 47\\n    }\\n    if at_sep {\\n      let part = path[start: i]\\n      let skip_part = if String::length(part) == 0 {\\n        true\\n      } else {\\n        part == \\\".\\\"\\n      }\\n      if skip_part {\\n        ()\\n      } else if part == \\\"..\\\" {\\n        // O(1) truncate vs. previous O(N) copy of `parts[0:N-1]` into a\\n        // fresh Array.\\n        if Array::length(parts) > 0 {\\n          Array::truncate(parts, Array::length(parts) - 1)\\n        }\\n      } else {\\n        Array::push(parts, part)\\n      }\\n      start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  // Build the joined output via StringBuilder. The previous code did\\n  // `out = String::concat(out, ...)` in a loop, which is O(N²) over the\\n  // segment count because each concat allocates and copies the growing\\n  // string. Same shape as the StringBuilder migrations issue #366\\n  // tracks for the rest of selfhost.\\n  let buf = StringBuilder::new()\\n  if is_absolute {\\n    StringBuilder::push(buf, \\\"/\\\")\\n  }\\n  let mut pi = 0\\n  while pi < Array::length(parts) {\\n    if pi > 0 {\\n      StringBuilder::push(buf, \\\"/\\\")\\n    }\\n    StringBuilder::push(buf, Array::get(parts, pi))\\n    pi = pi + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nexport let get_export_name: (Array[(String, Option[String])], String) -> String = (items, name) -> {\\n  let mut result = name\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    let (iname, irename) = Array::get(items, i)\\n    if iname == name {\\n      match irename {\\n        Some(alias) => {\\n          result = alias\\n        },\\n        None => ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n  result\\n}\\n\\nlet join_relative_path: (String, String) -> String = (base_dir, raw_path) -> {\\n  if base_dir == \\\"\\\" || base_dir == \\\"/\\\" {\\n    String::concat(base_dir, raw_path)\\n  } else {\\n    String::concat(base_dir, String::concat(\\\"/\\\", raw_path))\\n  }\\n}\\n\\nexport let path_to_module_name: (String) -> String = (path) -> {\\n  let len = String::length(path)\\n  let mut last_slash = -1\\n  let mut i = 0\\n  while i < len {\\n    if String::char_code_at(path, i) == 47 {\\n      last_slash = i\\n    }\\n    i = i + 1\\n  }\\n  let base = if last_slash >= 0 {\\n    path[last_slash + 1: len]\\n  } else {\\n    path\\n  }\\n  let base_len = String::length(base)\\n  if String::ends_with(base, \\\".vibe\\\") {\\n    base[0: base_len - 5]\\n  } else {\\n    base\\n  }\\n}\\n\\nexport let path_has_relative_prefix: (String, Int) -> Bool = (raw_path, len) -> {\\n  if len >= 2 {\\n    if raw_path[0: 2] == \\\"./\\\" {\\n      true\\n    } else if len >= 3 {\\n      raw_path[0: 3] == \\\"../\\\"\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n}\\n\\nexport let resolve_import_path: (String, String) -> String = (base_dir, raw_path) -> {\\n  let len = String::length(raw_path)\\n  let joined = if path_has_relative_prefix(raw_path, len) {\\n    join_relative_path(base_dir, raw_path)\\n  } else {\\n    raw_path\\n  }\\n  let normalized = normalize_path(joined)\\n  if String::ends_with(normalized, \\\".vibe\\\") {\\n    normalized\\n  } else {\\n    String::concat(normalized, \\\".vibe\\\")\\n  }\\n}\\n\\nexport let resolve_import_path_candidates: (String, String) -> Array[String] = (base_dir, raw_path) -> {\\n  let len = String::length(raw_path)\\n  let joined = if path_has_relative_prefix(raw_path, len) {\\n    join_relative_path(base_dir, raw_path)\\n  } else {\\n    raw_path\\n  }\\n  let normalized = normalize_path(joined)\\n  if String::ends_with(normalized, \\\".vibe\\\") {\\n    [\\n      normalized\\n    ]\\n  } else {\\n    [\\n      String::concat(normalized, \\\".vibe\\\"),\\n      String::concat(normalized, \\\"/index.vibe\\\")\\n    ]\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_130 = () -> (String, String) {\n  (\"vibe/compiler/cache/persistent_module_header_codec.vibe\",\n\"//# Functions\\n\\nlet has_prefix: (String, String) -> Bool = (line, prefix) -> {\\n  let prefix_len = String::length(prefix)\\n  if String::length(line) < prefix_len {\\n    false\\n  } else {\\n    let mut ok = true\\n    let mut i = 0\\n    while ok && i < prefix_len {\\n      ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nlet strip_trailing_cr: (String) -> String = (line) -> {\\n  let len = String::length(line)\\n  if len > 0 {\\n    if String::char_code_at(line, len - 1) == 13 {\\n      line[0: len - 1]\\n    } else {\\n      line\\n    }\\n  } else {\\n    line\\n  }\\n}\\n\\nlet parse_persistent_module_header_line: (Array[String], Array[String], String, Bool) -> Bool with { Error } = (deps, exports, line, saw_version) -> {\\n  if String::length(line) == 0 {\\n    saw_version\\n  } else if has_prefix(line, \\\"version\\\\t\\\") {\\n    let value = line[8: String::length(line)]\\n    if !(value == \\\"1\\\") {\\n      throw(\\\"invalid persistent module header version\\\")\\n    }\\n    true\\n  } else if has_prefix(line, \\\"dep\\\\t\\\") {\\n    let value = line[4: String::length(line)]\\n    if String::length(value) == 0 {\\n      throw(\\\"invalid persistent module header dep row\\\")\\n    } else {\\n      Array::push(deps, value)\\n      saw_version\\n    }\\n  } else if has_prefix(line, \\\"export\\\\t\\\") {\\n    let value = line[7: String::length(line)]\\n    if String::length(value) == 0 {\\n      throw(\\\"invalid persistent module header export row\\\")\\n    } else {\\n      Array::push(exports, value)\\n      saw_version\\n    }\\n  } else {\\n    throw(String::concat(\\\"invalid persistent module header row: \\\", line))\\n  }\\n}\\n\\nexport let persistent_module_header_text: (Array[String], Array[String]) -> String = (deps, exports) -> {\\n  // O(N) via StringBuilder; previously `out = String::concat(out, ...)`\\n  // over both `deps` and `exports` was O((D+E)²).\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, \\\"version\\\\t1\\\\n\\\")\\n  let mut i = 0\\n  while i < Array::length(deps) {\\n    StringBuilder::push(buf, \\\"dep\\\\t\\\")\\n    StringBuilder::push(buf, Array::get(deps, i))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(exports) {\\n    StringBuilder::push(buf, \\\"export\\\\t\\\")\\n    StringBuilder::push(buf, Array::get(exports, j))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    j = j + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nexport let parse_persistent_module_header_text: (String) -> (Array[String], Array[String]) with { Error } = (raw) -> {\\n  let deps = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let exports = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut saw_version = false\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  while i < len {\\n    if String::char_code_at(raw, i) == 10 {\\n      let line = strip_trailing_cr(raw[line_start: i])\\n      saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  let line = strip_trailing_cr(raw[line_start: len])\\n  saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)\\n  if !saw_version {\\n    throw(\\\"missing persistent module header version\\\")\\n  } else {\\n    (deps, exports)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_131 = () -> (String, String) {\n  (\"vibe/compiler/loader/header_cache.vibe\",\n\"//# Imports\\n\\nimport .. / cache / persistent_module_header_codec.vibe {\\n  parse_persistent_module_header_text, persistent_module_header_text\\n}\\n\\nimport .. / cache / persistent_cache.vibe {\\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_module_header_cache_path\\n}\\n\\nimport .. / core / ast.vibe {\\n  Stmt\\n}\\n\\nimport .. / module_graph_path.vibe {\\n  dir_of_path, resolve_import_path_candidates\\n}\\n\\nimport .. / runtime / eval_loader {\\n  collect_exports\\n}\\n\\nimport .. / syntax / lexer.vibe {\\n  lex, lex_with_offsets\\n}\\n\\nimport .. / syntax / parser.vibe {\\n  parse_program, parse_program_located\\n}\\n\\n//# Functions\\n\\nlet resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut i = 0\\n  let mut found = \\\"\\\"\\n  while i < Array::length(candidates) {\\n    if found == \\\"\\\" {\\n      let candidate = Array::get(candidates, i)\\n      if Fs::exists(candidate) {\\n        found = candidate\\n      }\\n    }\\n    i = i + 1\\n  }\\n  if found == \\\"\\\" {\\n    Array::get(candidates, 0)\\n  } else {\\n    found\\n  }\\n}\\n\\nlet is_special_bundle_path: (String) -> Bool = (path) -> {\\n  String::ends_with(path, \\\"selfhost_sources_bundle.vibe\\\") || String::ends_with(path, \\\"selfhost_cli_adapter_bundle.vibe\\\") || String::ends_with(path, \\\"selfbuild_runtime_entry_bundle.vibe\\\")\\n}\\n\\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\\n  if String::ends_with(path, \\\"selfhost_sources_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfhost_sources\\\",\\n      \\\"selfhost_source_groups\\\"\\n    ]))\\n  } else if String::ends_with(path, \\\"selfhost_cli_adapter_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfhost_cli_adapter_sources\\\",\\n      \\\"selfhost_cli_adapter_source_groups\\\",\\n      \\\"selfhost_cli_adapter_ordered_sources\\\",\\n      \\\"selfhost_cli_adapter_merged_source\\\",\\n      \\\"selfhost_cli_adapter_module_source\\\"\\n    ]))\\n  } else if String::ends_with(path, \\\"selfbuild_runtime_entry_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfbuild_runtime_entry_source\\\"\\n    ]))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {\\n  let deps = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  deps\\n}\\n\\nexport let load_or_parse_module_header_fs_impl: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\\n  if Fs::exists(cache_path) {\\n    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))\\n    (parsed.0, parsed.1, parse_count)\\n  } else {\\n    // #708: dispatch on `is_special_bundle_path` (a plain Bool) rather than\\n    // matching `special_bundle_header(path)`'s Option result directly here,\\n    // and never nest the `Some((deps, exports))` tuple-in-option pattern in\\n    // the same match as the `None` arm's parse call. A compiler that is\\n    // itself self-hosted under RC traps (\\\"wasm unreachable\\\" in `tk_name`,\\n    // reached via `parse_stmt`) reading a corrupted Token tag when\\n    // `load_or_parse_module_header_fs_impl` is compiled with the call chain\\n    // that reaches `tk_name` (lex_with_offsets/parse_program_located, or\\n    // even the plain lex/parse_program pair) sitting inside ONE arm of a\\n    // `match` on `special_bundle_header(path)`'s `Option` result — even\\n    // though that arm is never taken for ordinary (non-bundle-file) input.\\n    // Splitting the dispatch into this Bool `if` (special_bundle_header is\\n    // then only ever called, and only ever `match`ed, inside the branch that\\n    // does NOT also reach the parser) reproducibly avoids the trap for the\\n    // simplest repro. NOT a full fix for #708: a structurally similar crash\\n    // still reproduces one level deeper (`parse_type_impl`, reached once the\\n    // input has a type annotation) -- root cause remains uncharacterized, and\\n    // this workaround likely needs to be repeated at that/other call sites.\\n    let header_result = if is_special_bundle_path(path) {\\n      match special_bundle_header(path) {\\n        Some(pair) => {\\n          let deps = pair.0\\n          let exports = pair.1\\n          (deps, exports, parse_count)\\n        },\\n        None => (Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), parse_count)\\n      }\\n    } else {\\n      let (tokens, starts, _ends) = lex_with_offsets(source)\\n      let stmts = handle {\\n        parse_program_located(tokens, starts, source)\\n      } with Error {\\n        Throw(msg) => throw(String::concat(path, String::concat(\\\": \\\", msg)))\\n      }\\n      (collect_import_deps_from_stmts(stmts, dir_of_path(path)), collect_exports(stmts), parse_count + 1)\\n    }\\n    let deps = header_result.0\\n    let exports = header_result.1\\n    let next_parse_count = header_result.2\\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports))\\n    (deps, exports, next_parse_count)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_132 = () -> (String, String) {\n  (\"vibe/compiler/loader/manifest_sources.vibe\",\n\"//# Imports\\n\\nimport . / header_cache.vibe {\\n  load_or_parse_module_header_fs_impl\\n}\\n\\nimport .. / cache / persistent_cache.vibe {\\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_manifest_header_cache_path\\n}\\n\\nimport .. / module_graph_path.vibe {\\n  contains_path, dir_of_path, resolve_import_path_candidates\\n}\\n\\nimport .. / syntax / lexer.vibe {\\n  lex\\n}\\n\\nimport .. / syntax / parser_base.vibe {\\n  collect_import_path, peek, skip_semi\\n}\\n\\nimport .. / syntax / token.vibe {\\n  Token\\n}\\n\\n//# Path helpers\\n\\nlet join_path: (String, String) -> String = (base_dir, rel_path) -> {\\n  if base_dir == \\\"\\\" {\\n    rel_path\\n  } else {\\n    String::concat(base_dir, String::concat(\\\"/\\\", rel_path))\\n  }\\n}\\n\\nlet resolve_manifest_dep_path: (String, String, Map[String, Bool]) -> String with { Error, Fs } = (base_dir, raw_path, manifest_path_index) -> {\\n  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {\\n    raw_path\\n  } else {\\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n    let mut i = 0\\n    let mut found = \\\"\\\"\\n    while i < Array::length(candidates) {\\n      if found == \\\"\\\" {\\n        let candidate = Array::get(candidates, i)\\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\\n          found = candidate\\n        }\\n      }\\n      i = i + 1\\n    }\\n    if found == \\\"\\\" {\\n      Array::get(candidates, 0)\\n    } else {\\n      found\\n    }\\n  }\\n}\\n\\nlet starts_with_reexport_path_token: (Token) -> Bool = (tok) -> {\\n  match tok {\\n    TDot => true,\\n    _ => false\\n  }\\n}\\n\\nlet is_ident_char: (Int) -> Bool = (c) -> {\\n  (c >= 'a' && c <= 'z') ||\\n    (c >= 'A' && c <= 'Z') ||\\n    (c >= '0' && c <= '9') ||\\n    c == '_'\\n}\\n\\nlet slice_eq_text: (String, Int, String) -> Bool = (s, start, text) -> {\\n  let text_len = String::length(text)\\n  if start + text_len > String::length(s) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while ok && i < text_len {\\n      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nlet starts_with_keyword_at: (String, Int, String) -> Bool = (s, pos, keyword) -> {\\n  let keyword_len = String::length(keyword)\\n  if !(slice_eq_text(s, pos, keyword)) {\\n    false\\n  } else {\\n    let before_ok = if pos == 0 {\\n      true\\n    } else {\\n      !(is_ident_char(String::char_code_at(s, pos - 1)))\\n    }\\n    let after_pos = pos + keyword_len\\n    let after_ok = if after_pos >= String::length(s) {\\n      true\\n    } else {\\n      !(is_ident_char(String::char_code_at(s, after_pos)))\\n    }\\n    before_ok && after_ok\\n  }\\n}\\n\\nlet skip_header_ws_and_comments: (String, Int, Int) -> Int = (s, len, start) -> {\\n  let mut pos = start\\n  let mut done = false\\n  while !done && pos < len {\\n    let c = String::char_code_at(s, pos)\\n    if c == ' ' || c == '\\\\n' || c == '\\\\t' || c == '\\\\r' || c == ';' {\\n      pos = pos + 1\\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\\n      pos = pos + 2\\n      while pos < len && String::char_code_at(s, pos) != '\\\\n' {\\n        pos = pos + 1\\n      }\\n    } else {\\n      done = true\\n    }\\n  }\\n  pos\\n}\\n\\nlet scan_header_stmt_end: (String, Int, Int) -> Int with { Error } = (s, len, start) -> {\\n  let mut pos = start\\n  let mut brace_depth = 0\\n  let mut in_string = false\\n  let mut string_quote = 0\\n  let mut escape = false\\n  let mut done = false\\n  while pos < len && !done {\\n    let c = String::char_code_at(s, pos)\\n    if in_string {\\n      if escape {\\n        escape = false\\n      } else if c == '\\\\\\\\' {\\n        escape = true\\n      } else if c == string_quote {\\n        in_string = false\\n      }\\n      pos = pos + 1\\n    } else if c == '\\\"' || c == '\\\\'' {\\n      in_string = true\\n      string_quote = c\\n      pos = pos + 1\\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\\n      while pos < len && String::char_code_at(s, pos) != '\\\\n' {\\n        pos = pos + 1\\n      }\\n    } else if c == '{' {\\n      brace_depth = brace_depth + 1\\n      pos = pos + 1\\n    } else if c == '}' {\\n      if brace_depth > 0 {\\n        brace_depth = brace_depth - 1\\n      }\\n      pos = pos + 1\\n    } else if brace_depth == 0 && (c == '\\\\n' || c == ';') {\\n      done = true\\n    } else {\\n      pos = pos + 1\\n    }\\n  }\\n  pos\\n}\\n\\nlet skip_brace_list: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let mut depth = 1\\n      let mut i = pos + 1\\n      while depth > 0 {\\n        match peek(tokens, i) {\\n          TLBrace => {\\n            depth = depth + 1\\n          },\\n          TRBrace => {\\n            depth = depth - 1\\n          },\\n          TEof => throw(\\\"unterminated brace list in manifest import scanner\\\"),\\n          _ => ()\\n        }\\n        i = i + 1\\n      }\\n      i\\n    }\\n    _ => throw(\\\"expected '{' in manifest import scanner\\\")\\n  }\\n}\\n\\nlet scan_header_import_dep: (Array[Token], Int, String, Map[String, Bool]) -> (String, Int) with { Error, Fs } = (tokens, pos, base_dir, manifest_path_index) -> {\\n  let (raw_path, next_pos) = match peek(tokens, pos) {\\n    TIdent(name) =>\\n      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {\\n        (name, pos + 1)\\n      } else {\\n        collect_import_path(tokens, pos, \\\"\\\")\\n      },\\n    _ => collect_import_path(tokens, pos, \\\"\\\")\\n  }\\n  let after_path = match peek(tokens, next_pos) {\\n    TIdent(alias_name) =>\\n      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {\\n        next_pos + 1\\n      } else {\\n        next_pos\\n      },\\n    _ => next_pos\\n  }\\n  let end_pos = match peek(tokens, after_path) {\\n    TLBrace => skip_brace_list(tokens, after_path),\\n    _ => after_path\\n  }\\n  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)\\n}\\n\\nlet collect_manifest_header_deps_from_source: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\\n  let deps = Array::slice([\\\"\\\"], 0, 0)\\n  let base_dir = dir_of_path(path)\\n  let len = String::length(source)\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    pos = skip_header_ws_and_comments(source, len, pos)\\n    if pos >= len {\\n      done = true\\n    } else {\\n      let is_import = starts_with_keyword_at(source, pos, \\\"import\\\")\\n      let is_export = starts_with_keyword_at(source, pos, \\\"export\\\")\\n      if !(is_import || is_export) {\\n        done = true\\n      } else {\\n        let stmt_end = scan_header_stmt_end(source, len, pos)\\n        let stmt_source = source[pos:stmt_end]\\n        let tokens = lex(stmt_source)\\n        let stmt_pos = skip_semi(tokens, 0)\\n        match peek(tokens, stmt_pos) {\\n          TImport => {\\n            let (dep_path, _) = scan_header_import_dep(\\n              tokens,\\n              stmt_pos + 1,\\n              base_dir,\\n              manifest_path_index\\n            )\\n            Array::push(deps, dep_path)\\n          },\\n          TExport => {\\n            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {\\n              let (dep_path, _) = scan_header_import_dep(\\n                tokens,\\n                stmt_pos + 1,\\n                base_dir,\\n                manifest_path_index\\n              )\\n              Array::push(deps, dep_path)\\n            }\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n        pos = stmt_end\\n      }\\n    }\\n  }\\n  deps\\n}\\n\\nlet collect_manifest_header_deps_from_source_with_context: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\\n  handle {\\n    collect_manifest_header_deps_from_source(path, source, manifest_path_index)\\n  } with Error {\\n    Throw(err) => throw(\\\"manifest header scan failed for \\\" + path + \\\": \\\" + err)\\n  }\\n}\\n\\nlet is_manifest_external_terminal_dep: (String) -> Bool = (path) -> {\\n  String::ends_with(path, \\\"selfhost_sources_bundle.vibe\\\")\\n}\\n\\nlet should_schedule_manifest_dep: (String, Map[String, Bool]) -> Bool = (dep_path, manifest_path_index) -> {\\n  if Map::has_key(manifest_path_index, dep_path) {\\n    true\\n  } else {\\n    !(is_manifest_external_terminal_dep(dep_path))\\n  }\\n}\\n\\nlet load_or_parse_module_header_deps_with_context: (String, String) -> Array[String] with { Error, Fs } = (path, source) -> {\\n  handle {\\n    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)\\n    deps\\n  } with Error {\\n    Throw(err) => throw(\\\"module header parse failed for \\\" + path + \\\": \\\" + err)\\n  }\\n}\\n\\nexport let build_manifest_source_index: (Array[(String, String)]) -> Map[String, String] = (sources) -> {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    MapBuilder::set(builder, path, source)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\n\\nlet source_lookup_in_index: (Map[String, String], String) -> Option[String] = (source_index, path_key) -> {\\n  if Map::has_key(source_index, path_key) {\\n    Some(Map::get(source_index, path_key))\\n  } else {\\n    None\\n  }\\n}\\n\\nexport let build_manifest_path_index: (Array[String]) -> Map[String, Bool] = (paths) -> {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(paths) {\\n    MapBuilder::set(builder, Array::get(paths, i), true)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\n\\nlet empty_path_index: () -> Map[String, Bool] = () -> {\\n  let builder = MapBuilder::new()\\n  MapBuilder::freeze(builder)\\n}\\n\\nlet build_manifest_path_index_from_rows: (String, Array[(String, String)]) -> Map[String, Bool] = (base_dir, rows) -> {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    MapBuilder::set(builder, join_path(base_dir, rel_path), true)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\n\\nlet find_manifest_base_dir: (String) -> Option[String] with { Fs } = (entry_path) -> {\\n  let mut base_dir = dir_of_path(entry_path)\\n  let mut found = None\\n  let mut done = false\\n  loop {\\n    if done {\\n      break\\n    }\\n    let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n    if Fs::exists(manifest_path) {\\n      found = Some(base_dir)\\n      done = true\\n    } else if base_dir == \\\"\\\" {\\n      done = true\\n    } else {\\n      let parent = dir_of_path(base_dir)\\n      if parent == base_dir {\\n        done = true\\n      } else {\\n        base_dir = parent\\n      }\\n    }\\n  }\\n  found\\n}\\n\\nlet strip_trailing_cr: (String) -> String = (line) -> {\\n  let len = String::length(line)\\n  if len > 0 {\\n    if String::char_code_at(line, len - 1) == 13 {\\n      line[0:len - 1]\\n    } else {\\n      line\\n    }\\n  } else {\\n    line\\n  }\\n}\\n\\nlet find_char: (String, Int) -> Int = (s, target) -> {\\n  let len = String::length(s)\\n  let mut i = 0\\n  let mut result = -1\\n  while i < len {\\n    if String::char_code_at(s, i) == target {\\n      result = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\\n  let fields = Array::slice([\\\"\\\"], 0, 0)\\n  let len = String::length(line)\\n  let mut start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_field_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(line, i) == 9\\n    }\\n    if at_field_end {\\n      Array::push(fields, line[start:i])\\n      start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  fields\\n}\\n\\nlet header_value_separator = String::from_char_code(31)\\n\\nlet join_header_values: (Array[String]) -> String = (values) -> {\\n  // O(N) join via StringBuilder; per-value String::concat was O(N²) (issue #366).\\n  let out = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(values) {\\n    if i > 0 {\\n      StringBuilder::push(out, header_value_separator)\\n    }\\n    StringBuilder::push(out, Array::get(values, i))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(out)\\n}\\n\\nlet split_header_values: (String) -> Array[String] = (text) -> {\\n  let values = Array::slice([\\\"\\\"], 0, 0)\\n  if String::length(text) == 0 {\\n    values\\n  } else {\\n    let sep = String::char_code_at(header_value_separator, 0)\\n    let len = String::length(text)\\n    let mut start = 0\\n    let mut i = 0\\n    while i <= len {\\n      let at_value_end = if i == len {\\n        true\\n      } else {\\n        String::char_code_at(text, i) == sep\\n      }\\n      if at_value_end {\\n        Array::push(values, text[start:i])\\n        start = i + 1\\n      }\\n      i = i + 1\\n    }\\n    values\\n  }\\n}\\n\\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\n\\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\\n  Array::slice([(\\\"\\\", Array::slice([(\\\"\\\", \\\"\\\")], 0, 0))], 0, 0)\\n}\\n\\nlet ensure_grouped_source_bucket: (Array[(String, Array[(String, String)])], String) -> Array[(String, String)] = (groups, group_name) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(groups) {\\n    let (name, sources) = Array::get(groups, i)\\n    if name == group_name {\\n      found = Some(sources)\\n      i = Array::length(groups)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  match found {\\n    Some(sources) => sources,\\n    None => {\\n      let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n      Array::push(groups, (group_name, sources))\\n      sources\\n    }\\n  }\\n}\\n\\nlet build_grouped_sources_from_manifest_rows_with_lookup: (String, Array[(String, String)], (String) -> Option[String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, on_path) -> {\\n  let groups = empty_grouped_sources()\\n  let mut last_group_name = \\\"\\\"\\n  let mut last_group_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut has_last_group = false\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (group_name, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    match on_path(path) {\\n      Some(source) => {\\n        let bucket = if has_last_group && last_group_name == group_name {\\n          last_group_sources\\n        } else {\\n          let ensured = ensure_grouped_source_bucket(groups, group_name)\\n          last_group_name = group_name\\n          last_group_sources = ensured\\n          has_last_group = true\\n          ensured\\n        }\\n        Array::push(bucket, (path, source))\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  groups\\n}\\n\\n//# Manifest parsing\\n\\nlet parse_source_manifest_rows: (String) -> Array[(String, String)] with { Error } = (manifest_source) -> {\\n  let rows = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let len = String::length(manifest_source)\\n  let mut line_start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(manifest_source, i) == 10\\n    }\\n    if at_line_end {\\n      let raw_line = strip_trailing_cr(manifest_source[line_start:i])\\n      let line_len = String::length(raw_line)\\n      let has_content = line_len > 0\\n      let is_comment = if has_content {\\n        String::char_code_at(raw_line, 0) == 35\\n      } else {\\n        false\\n      }\\n      if has_content {\\n        if is_comment {\\n          ()\\n        } else {\\n          let tab_idx = find_char(raw_line, 9)\\n          let invalid_row = if tab_idx < 0 {\\n            true\\n          } else {\\n            tab_idx + 1 >= line_len\\n          }\\n          if invalid_row {\\n            throw(String::concat(\\\"invalid source manifest row: \\\", raw_line))\\n          }\\n          let group = raw_line[0:tab_idx]\\n          let path = raw_line[tab_idx + 1:line_len]\\n          Array::push(rows, (group, path))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  rows\\n}\\n\\nexport let try_load_manifest_rows: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\\n  match find_manifest_base_dir(entry_path) {\\n    Some(base_dir) => {\\n      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\\n      let mut has_entry = false\\n      let mut i = 0\\n      while i < Array::length(rows) {\\n        let (_, rel_path) = Array::get(rows, i)\\n        let path = join_path(base_dir, rel_path)\\n        if path == entry_path {\\n          has_entry = true\\n        }\\n        i = i + 1\\n      }\\n      if has_entry {\\n        Some((base_dir, rows))\\n      } else {\\n        None\\n      }\\n    },\\n    None => None\\n  }\\n}\\n\\nexport let load_manifest_full_sources: (String, Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows) -> {\\n  let full_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    Array::push(full_sources, (path, Fs::read_file(path)))\\n    i = i + 1\\n  }\\n  full_sources\\n}\\n\\nlet load_manifest_sources_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\\n  let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    if Map::has_key(needed_path_index, path) {\\n      Array::push(sources, (path, Fs::read_file(path)))\\n    }\\n    i = i + 1\\n  }\\n  sources\\n}\\n\\nlet load_manifest_source_groups_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\\n  let groups = empty_grouped_sources()\\n  let mut last_group_name = \\\"\\\"\\n  let mut last_group_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut has_last_group = false\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (group_name, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    if Map::has_key(needed_path_index, path) {\\n      let bucket = if has_last_group && last_group_name == group_name {\\n        last_group_sources\\n      } else {\\n        let ensured = ensure_grouped_source_bucket(groups, group_name)\\n        last_group_name = group_name\\n        last_group_sources = ensured\\n        has_last_group = true\\n        ensured\\n      }\\n      Array::push(bucket, (path, Fs::read_file(path)))\\n    }\\n    i = i + 1\\n  }\\n  groups\\n}\\n\\nexport let build_grouped_sources_from_manifest_row_source_index: (String, Array[(String, String)], Map[String, String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, source_index) -> {\\n  build_grouped_sources_from_manifest_rows_with_lookup(\\n    base_dir,\\n    rows,\\n    (path: String) -> Option[String] {\\n      source_lookup_in_index(source_index, path)\\n    }\\n  )\\n}\\n\\nexport let build_grouped_sources_from_manifest_rows: (String, Array[(String, String)], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, sources) -> {\\n  let source_index = build_manifest_source_index(sources)\\n  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)\\n}\\n\\nexport let filter_manifest_sources_by_path_index: (Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] = (preloaded_sources, needed_path_index) -> {\\n  let filtered_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(preloaded_sources) {\\n    let (path, source) = Array::get(preloaded_sources, i)\\n    if Map::has_key(needed_path_index, path) {\\n      Array::push(filtered_sources, (path, source))\\n    }\\n    i = i + 1\\n  }\\n  filtered_sources\\n}\\n\\nexport let filter_manifest_sources_by_paths: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {\\n  let needed_path_index = build_manifest_path_index(needed_paths)\\n  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)\\n}\\n\\nexport let filter_manifest_sources_by_paths_linear: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {\\n  let filtered_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(preloaded_sources) {\\n    let (path, source) = Array::get(preloaded_sources, i)\\n    if contains_path(needed_paths, path) {\\n      Array::push(filtered_sources, (path, source))\\n    }\\n    i = i + 1\\n  }\\n  filtered_sources\\n}\\n\\nexport let filter_manifest_sources_by_source_index: (Array[String], Map[String, String]) -> Array[(String, String)] = (needed_paths, preloaded_source_index) -> {\\n  let filtered_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(needed_paths) {\\n    let path = Array::get(needed_paths, i)\\n    match source_lookup_in_index(preloaded_source_index, path) {\\n      Some(source) => Array::push(filtered_sources, (path, source)),\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  filtered_sources\\n}\\n\\n//# Manifest header cache\\n\\nlet parse_persistent_manifest_header_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  let mut version = 0\\n  let mut manifest = None\\n  let rows = empty_manifest_header_cache_rows()\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(raw, i) == 10\\n    }\\n    if at_line_end {\\n      let line = strip_trailing_cr(raw[line_start:i])\\n      if String::length(line) > 0 {\\n        let fields = split_tsv_fields(line)\\n        let tag = Array::get(fields, 0)\\n        if tag == \\\"version\\\" {\\n          if Array::length(fields) != 2 {\\n            throw(\\\"invalid persistent manifest header cache version\\\")\\n          }\\n          let version_text = Array::get(fields, 1)\\n          if version_text == \\\"1\\\" {\\n            version = 1\\n          } else if version_text == \\\"2\\\" {\\n            version = 2\\n          } else {\\n            throw(\\\"invalid persistent manifest header cache version\\\")\\n          }\\n        } else if tag == \\\"manifest\\\" {\\n          if Array::length(fields) != 4 {\\n            throw(\\\"invalid persistent manifest header cache manifest row\\\")\\n          }\\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n        } else if tag == \\\"header\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 6 {\\n              throw(\\\"invalid persistent manifest header cache header row\\\")\\n            }\\n            Array::push(\\n              rows,\\n              (\\n                Array::get(fields, 1),\\n                Array::get(fields, 2),\\n                Array::get(fields, 3),\\n                Array::get(fields, 4)\\n              )\\n            )\\n          } else {\\n            if Array::length(fields) != 5 {\\n              throw(\\\"invalid persistent manifest header cache header row\\\")\\n            }\\n            Array::push(\\n              rows,\\n              (\\n                Array::get(fields, 1),\\n                Array::get(fields, 2),\\n                Array::get(fields, 3),\\n                Array::get(fields, 4)\\n              )\\n            )\\n          }\\n        } else {\\n          throw(String::concat(\\\"invalid persistent manifest header cache row: \\\", line))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  (version, manifest, rows)\\n}\\n\\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\\n  if !(Fs::exists(path)) {\\n    false\\n  } else {\\n    let has_stat_token = String::length(stat_token_text) > 0\\n    if has_stat_token {\\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\\n        true\\n      } else if String::length(source_fingerprint) > 0 {\\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n      } else {\\n        false\\n      }\\n    } else if String::length(source_fingerprint) > 0 {\\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n    } else {\\n      false\\n    }\\n  }\\n}\\n\\nlet load_persistent_manifest_header_cache_if_valid: (String, String, Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    let manifest_ok = match manifest {\\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\\n        cached_path == manifest_path &&\\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\\n      None => false\\n    }\\n    if !manifest_ok {\\n      None\\n    } else {\\n      let mut valid = true\\n      let mut i = 0\\n      while i < Array::length(rows) {\\n        if valid {\\n          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)\\n          if !(Map::has_key(manifest_path_index, path)) {\\n            valid = false\\n          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\\n            valid = false\\n          }\\n        }\\n        i = i + 1\\n      }\\n      if valid {\\n        Some(rows)\\n      } else {\\n        None\\n      }\\n    }\\n  }\\n}\\n\\nlet build_persistent_manifest_header_cache_text: (String, Array[(String, String, String, String)]) -> String with { Error, Fs } = (manifest_path, rows) -> {\\n  let mut out = \\\"version\\\\t2\\\\n\\\"\\n  out = String::concat(\\n    out,\\n    String::concat(\\n      \\\"manifest\\\\t\\\",\\n      String::concat(\\n        manifest_path,\\n        String::concat(\\n          \\\"\\\\t\\\",\\n          String::concat(\\n            __to_string(Fs::stat_token(manifest_path)),\\n            String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \\\"\\\\n\\\"))\\n          )\\n        )\\n      )\\n    )\\n  )\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\\n    out = String::concat(\\n      out,\\n      String::concat(\\n        \\\"header\\\\t\\\",\\n        String::concat(\\n          path,\\n          String::concat(\\n            \\\"\\\\t\\\",\\n            String::concat(\\n              stat_token_text,\\n              String::concat(\\n                \\\"\\\\t\\\",\\n                String::concat(\\n                  source_fingerprint,\\n                  String::concat(\\\"\\\\t\\\", String::concat(deps_text, \\\"\\\\n\\\"))\\n                )\\n              )\\n            )\\n          )\\n        )\\n      )\\n    )\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet store_persistent_manifest_header_cache: (String, String, Array[(String, String, String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, rows) -> {\\n  Fs::write_file(\\n    persistent_manifest_header_cache_path(entry_path),\\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\\n  )\\n}\\n\\nlet manifest_header_deps_lookup: (Array[(String, String, String, String)], String) -> Option[Array[String]] = (rows, path) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(rows) {\\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\\n    if row_path == path {\\n      found = Some(split_header_values(deps_text))\\n      i = Array::length(rows)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet collect_needed_paths_from_manifest_headers: (String, Map[String, Bool], Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } = (path, manifest_path_index, rows) -> {\\n  let visited = Array::slice([\\\"\\\"], 0, 0)\\n  let worklist = Array::slice([\\\"\\\"], 0, 0)\\n  let mut scheduled_set = empty_path_index()\\n  Array::push(worklist, path)\\n  scheduled_set = Map::set(scheduled_set, path, true)\\n  let mut work_len = 1\\n  let mut work_i = 0\\n  loop {\\n    if work_i >= work_len {\\n      break\\n    }\\n    let current = Array::get(worklist, work_i)\\n    if !(contains_path(visited, current)) {\\n      Array::push(visited, current)\\n      let deps = match manifest_header_deps_lookup(rows, current) {\\n        Some(found) => found,\\n        None => {\\n          let source = Fs::read_file(current)\\n          if Map::has_key(manifest_path_index, current) {\\n            collect_manifest_header_deps_from_source_with_context(\\n              current,\\n              source,\\n              manifest_path_index\\n            )\\n          } else {\\n            load_or_parse_module_header_deps_with_context(current, source)\\n          }\\n        }\\n      }\\n      let mut dep_i = 0\\n      while dep_i < Array::length(deps) {\\n        let dep_path = Array::get(deps, dep_i)\\n        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\\n          !Map::has_key(scheduled_set, dep_path) {\\n          Array::push(worklist, dep_path)\\n          scheduled_set = Map::set(scheduled_set, dep_path, true)\\n          work_len = work_len + 1\\n        }\\n        dep_i = dep_i + 1\\n      }\\n    }\\n    work_i = work_i + 1\\n  }\\n  visited\\n}\\n\\nlet collect_needed_paths_and_manifest_headers: (String, Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } = (path, manifest_path_index) -> {\\n  let rows = empty_manifest_header_cache_rows()\\n  let visited = Array::slice([\\\"\\\"], 0, 0)\\n  let worklist = Array::slice([\\\"\\\"], 0, 0)\\n  let mut scheduled_set = empty_path_index()\\n  Array::push(worklist, path)\\n  scheduled_set = Map::set(scheduled_set, path, true)\\n  let mut work_len = 1\\n  let mut work_i = 0\\n  loop {\\n    if work_i >= work_len {\\n      break\\n    }\\n    let current = Array::get(worklist, work_i)\\n    if !(contains_path(visited, current)) {\\n      Array::push(visited, current)\\n      let source = Fs::read_file(current)\\n      let deps = match manifest_header_deps_lookup(rows, current) {\\n        Some(found) => found,\\n        None => {\\n          let parsed_deps = if Map::has_key(manifest_path_index, current) {\\n            collect_manifest_header_deps_from_source_with_context(\\n              current,\\n              source,\\n              manifest_path_index\\n            )\\n          } else {\\n            load_or_parse_module_header_deps_with_context(current, source)\\n          }\\n          Array::push(\\n            rows,\\n            (\\n              current,\\n              __to_string(Fs::stat_token(current)),\\n              compact_string_fingerprint(source),\\n              join_header_values(parsed_deps)\\n            )\\n          )\\n          parsed_deps\\n        }\\n      }\\n      let mut dep_i = 0\\n      while dep_i < Array::length(deps) {\\n        let dep_path = Array::get(deps, dep_i)\\n        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\\n          !Map::has_key(scheduled_set, dep_path) {\\n          Array::push(worklist, dep_path)\\n          scheduled_set = Map::set(scheduled_set, dep_path, true)\\n          work_len = work_len + 1\\n        }\\n        dep_i = dep_i + 1\\n      }\\n    }\\n    work_i = work_i + 1\\n  }\\n  (rows, visited)\\n}\\n\\nlet collect_needed_paths_from_manifest_scan: (String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, manifest_path_index) -> {\\n  let visited = Array::slice([\\\"\\\"], 0, 0)\\n  let worklist = Array::slice([\\\"\\\"], 0, 0)\\n  let mut scheduled_set = empty_path_index()\\n  Array::push(worklist, path)\\n  scheduled_set = Map::set(scheduled_set, path, true)\\n  let mut work_len = 1\\n  let mut work_i = 0\\n  loop {\\n    if work_i >= work_len {\\n      break\\n    }\\n    let current = Array::get(worklist, work_i)\\n    if !(contains_path(visited, current)) {\\n      Array::push(visited, current)\\n      let source = Fs::read_file(current)\\n      let deps = if Map::has_key(manifest_path_index, current) {\\n        collect_manifest_header_deps_from_source_with_context(\\n          current,\\n          source,\\n          manifest_path_index\\n        )\\n      } else {\\n        load_or_parse_module_header_deps_with_context(current, source)\\n      }\\n      let mut dep_i = 0\\n      while dep_i < Array::length(deps) {\\n        let dep_path = Array::get(deps, dep_i)\\n        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\\n          !Map::has_key(scheduled_set, dep_path) {\\n          Array::push(worklist, dep_path)\\n          scheduled_set = Map::set(scheduled_set, dep_path, true)\\n          work_len = work_len + 1\\n        }\\n        dep_i = dep_i + 1\\n      }\\n    }\\n    work_i = work_i + 1\\n  }\\n  visited\\n}\\n\\nlet load_or_collect_manifest_header_rows: (String, String, Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\\n  match load_persistent_manifest_header_cache_if_valid(\\n    entry_path,\\n    manifest_path,\\n    manifest_path_index\\n  ) {\\n    Some(cached_rows) => cached_rows,\\n    None => {\\n      let (built_rows, _) = collect_needed_paths_and_manifest_headers(\\n        entry_path,\\n        manifest_path_index\\n      )\\n      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\\n      built_rows\\n    }\\n  }\\n}\\n\\nexport let probe_manifest_header_rows_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      Array::length(header_rows)\\n    },\\n    None => throw(\\\"manifest rows unavailable\\\")\\n  }\\n}\\n\\nexport let probe_manifest_header_rows_uncached_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let (header_rows, _) = collect_needed_paths_and_manifest_headers(\\n        entry_path,\\n        manifest_path_index\\n      )\\n      Array::length(header_rows)\\n    },\\n    None => throw(\\\"manifest rows unavailable\\\")\\n  }\\n}\\n\\nexport let probe_manifest_needed_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      let needed_paths = collect_needed_paths_from_manifest_headers(\\n        entry_path,\\n        manifest_path_index,\\n        header_rows\\n      )\\n      Array::length(needed_paths)\\n    },\\n    None => throw(\\\"manifest rows unavailable\\\")\\n  }\\n}\\n\\nexport let probe_manifest_scan_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let needed_paths = collect_needed_paths_from_manifest_scan(\\n        entry_path,\\n        manifest_path_index\\n      )\\n      Array::length(needed_paths)\\n    },\\n    None => throw(\\\"manifest rows unavailable\\\")\\n  }\\n}\\n\\n//# Source collection\\n\\nexport let try_collect_manifest_sources_fs: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      let needed_paths = collect_needed_paths_from_manifest_headers(\\n        entry_path,\\n        manifest_path_index,\\n        header_rows\\n      )\\n      let needed_path_index = build_manifest_path_index(needed_paths)\\n      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)\\n      Some((manifest_path, sources))\\n    },\\n    None => None\\n  }\\n}\\n\\nexport let try_collect_manifest_source_groups_fs: (String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      let needed_paths = collect_needed_paths_from_manifest_headers(\\n        entry_path,\\n        manifest_path_index,\\n        header_rows\\n      )\\n      let needed_path_index = build_manifest_path_index(needed_paths)\\n      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)\\n      Some((manifest_path, groups))\\n    },\\n    None => None\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_133 = () -> (String, String) {\n  (\"vibe/compiler/loader/index.vibe\",\n\"//# Imports\\n\\nimport ../syntax/lexer.vibe {\\n  lex,\\n}\\n\\nimport ../syntax/parser.vibe {\\n  parse_program\\n}\\n\\nimport ../core/ast.vibe {\\n  Stmt,\\n}\\n\\nimport ../core/types.vibe {\\n  Subst,\\n  Type,\\n  TypeDef,\\n  TypeEnv,\\n  env_bind,\\n  env_lookup\\n}\\n\\nimport ../checker/checker_stmt.vibe {\\n  check_stmts\\n}\\n\\nimport ../runtime/eval_loader/index.vibe {\\n  collect_exports, load_and_parse\\n}\\n\\nimport ./header_cache.vibe {\\n  load_or_parse_module_header_fs_impl\\n}\\n\\nimport ./manifest_sources.vibe {\\n  build_grouped_sources_from_manifest_rows,\\n  load_manifest_full_sources,\\n  try_collect_manifest_source_groups_fs,\\n  try_collect_manifest_sources_fs,\\n  try_load_manifest_rows\\n}\\n\\nimport ../cache/persistent_cache.vibe {\\n  build_source_groups_fingerprint_from_compact_fingerprints,\\n  compact_string_fingerprint,\\n  normalize_persistent_cache_text,\\n  persistent_module_header_cache_path,\\n  persistent_source_group_cache_path,\\n  persistent_source_list_cache_path\\n}\\n\\nimport ../module_graph_path.vibe {\\n  dir_of_path,\\n  resolve_import_path,\\n  resolve_import_path_candidates,\\n  contains_path\\n}\\n\\n//# Path helpers\\n\\nlet source_lookup: (Array[(String, String)], String) -> Option[String] = (sources, path_key) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(sources) {\\n    match found {\\n      Some(_) => (),\\n      None => {\\n        let (p, src) = Array::get(sources, i)\\n        if p == path_key {\\n          found = Some(src)\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nlet resolve_path_in_sources: (String, String, Array[(String, String)]) -> Option[(String, String)] = (base_dir, raw_path, sources) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(candidates) {\\n    match found {\\n      Some(_) => (),\\n      None => {\\n        let candidate = Array::get(candidates, i)\\n        match source_lookup(sources, candidate) {\\n          Some(source) => {\\n            found = Some((candidate, source))\\n          }\\n          None => ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nlet resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut i = 0\\n  let mut found = \\\"\\\"\\n  while i < Array::length(candidates) {\\n    if found == \\\"\\\" {\\n      let candidate = Array::get(candidates, i)\\n      let candidate_exists = perform Fs::Exists(candidate)\\n      if candidate_exists {\\n        found = candidate\\n      }\\n    }\\n    i = i + 1\\n  }\\n  if found == \\\"\\\" {\\n    Array::get(candidates, 0)\\n  } else {\\n    found\\n  }\\n}\\n\\nlet join_path: (String, String) -> String = (base_dir, rel_path) -> {\\n  if base_dir == \\\"\\\" {\\n    rel_path\\n  } else {\\n    String::concat(base_dir, String::concat(\\\"/\\\", rel_path))\\n  }\\n}\\n\\nlet strip_trailing_cr: (String) -> String = (line) -> {\\n  let len = String::length(line)\\n  if len > 0 {\\n    if String::char_code_at(line, len - 1) == 13 {\\n      line[0:len - 1]\\n    } else {\\n      line\\n    }\\n  } else {\\n    line\\n  }\\n}\\n\\n\\nlet string_to_bytes: (String) -> Bytes = (s) -> {\\n  let out = Bytes::new()\\n  let len = String::length(s)\\n  let mut i = 0\\n  while i < len {\\n    Bytes::push(out, String::char_code_at(s, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\\n  if String::ends_with(path, \\\"selfhost_sources_bundle.vibe\\\") {\\n    Some((\\n      Array::slice([\\\"\\\"], 0, 0),\\n      [\\\"selfhost_sources\\\", \\\"selfhost_source_groups\\\"]\\n    ))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\\n  let fields = Array::slice([\\\"\\\"], 0, 0)\\n  let len = String::length(line)\\n  let mut start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_field_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(line, i) == 9\\n    }\\n    if at_field_end {\\n      Array::push(fields, line[start:i])\\n      start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  fields\\n}\\n\\nlet header_value_separator = String::from_char_code(31)\\n\\nlet join_header_values: (Array[String]) -> String = (values) -> {\\n  // O(N) via StringBuilder (previous accumulator was O(N^2)).\\n  let sb = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(values) {\\n    if i > 0 {\\n      StringBuilder::push(sb, header_value_separator)\\n    }\\n    StringBuilder::push(sb, Array::get(values, i))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(sb)\\n}\\n\\nlet split_header_values: (String) -> Array[String] = (text) -> {\\n  let values = Array::slice([\\\"\\\"], 0, 0)\\n  if String::length(text) == 0 {\\n    values\\n  } else {\\n    let sep = String::char_code_at(header_value_separator, 0)\\n    let len = String::length(text)\\n    let mut start = 0\\n    let mut i = 0\\n    while i <= len {\\n      let at_value_end = if i == len {\\n        true\\n      } else {\\n        String::char_code_at(text, i) == sep\\n      }\\n      if at_value_end {\\n        Array::push(values, text[start:i])\\n        start = i + 1\\n      }\\n      i = i + 1\\n    }\\n    values\\n  }\\n}\\n\\nlet empty_source_specs: () -> Array[(String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n}\\n\\nlet copy_source_specs: (Array[(String, String)]) -> Array[(String, String)] = (sources) -> {\\n  let out = empty_source_specs()\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    Array::push(out, Array::get(sources, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet empty_group_specs: () -> Array[(String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\n\\nlet empty_source_cache_specs: () -> Array[(String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\n\\nlet empty_group_cache_specs: () -> Array[(String, String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\n\\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\\n  Array::slice([(\\\"\\\", Array::slice([(\\\"\\\", \\\"\\\")], 0, 0))], 0, 0)\\n}\\n\\nlet push_grouped_source: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source) -> {\\n  let group_count = Array::length(groups)\\n  let handled_by_tail = if group_count > 0 {\\n    let (last_name, last_sources) = Array::get(groups, group_count - 1)\\n    if last_name == group_name {\\n      Array::push(last_sources, (path, source))\\n      true\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n  if !handled_by_tail {\\n    let mut i = 0\\n    let mut found_index = -1\\n    while i < group_count {\\n      if found_index == -1 {\\n        let (name, sources) = Array::get(groups, i)\\n        if name == group_name {\\n          Array::push(sources, (path, source))\\n          found_index = i\\n        }\\n      }\\n      i = i + 1\\n    }\\n    if found_index == -1 {\\n      let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n      Array::push(sources, (path, source))\\n      Array::push(groups, (group_name, sources))\\n    }\\n  }\\n}\\n\\nlet push_grouped_source_fingerprint: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source_fingerprint) -> {\\n  let group_count = Array::length(groups)\\n  let handled_by_tail = if group_count > 0 {\\n    let (last_name, last_specs) = Array::get(groups, group_count - 1)\\n    if last_name == group_name {\\n      Array::push(last_specs, (path, source_fingerprint))\\n      true\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n  if !handled_by_tail {\\n    let mut i = 0\\n    let mut found_index = -1\\n    while i < group_count {\\n      if found_index == -1 {\\n        let (name, specs) = Array::get(groups, i)\\n        if name == group_name {\\n          Array::push(specs, (path, source_fingerprint))\\n          found_index = i\\n        }\\n      }\\n      i = i + 1\\n    }\\n    if found_index == -1 {\\n      let specs = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n      Array::push(specs, (path, source_fingerprint))\\n      Array::push(groups, (group_name, specs))\\n    }\\n  }\\n}\\n\\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\n\\nlet parse_persistent_source_list_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } = (raw) -> {\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  let mut version = 0\\n  let mut manifest = None\\n  let sources = empty_source_cache_specs()\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(raw, i) == 10\\n    }\\n    if at_line_end {\\n      let line = strip_trailing_cr(raw[line_start:i])\\n      if String::length(line) > 0 {\\n        let fields = split_tsv_fields(line)\\n        let tag = Array::get(fields, 0)\\n        if tag == \\\"version\\\" {\\n          if Array::length(fields) != 2 {\\n            throw(\\\"invalid persistent source list cache version\\\")\\n          }\\n          let version_text = Array::get(fields, 1)\\n          if version_text == \\\"1\\\" {\\n            version = 1\\n          } else if version_text == \\\"2\\\" {\\n            version = 2\\n          } else {\\n            throw(\\\"invalid persistent source list cache version\\\")\\n          }\\n        } else if tag == \\\"manifest\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 3 {\\n              throw(\\\"invalid persistent source list cache manifest row\\\")\\n            }\\n            manifest = Some((Array::get(fields, 1), \\\"\\\", Array::get(fields, 2)))\\n          } else {\\n            if Array::length(fields) != 4 {\\n              throw(\\\"invalid persistent source list cache manifest row\\\")\\n            }\\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n          }\\n        } else if tag == \\\"source\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 3 {\\n              throw(\\\"invalid persistent source list cache source row\\\")\\n            }\\n            Array::push(sources, (Array::get(fields, 1), \\\"\\\", Array::get(fields, 2)))\\n          } else {\\n            if Array::length(fields) != 4 {\\n              throw(\\\"invalid persistent source list cache source row\\\")\\n            }\\n            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n          }\\n        } else {\\n          throw(String::concat(\\\"invalid persistent source list cache row: \\\", line))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  (version, manifest, sources)\\n}\\n\\nlet parse_persistent_source_group_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  let mut version = 0\\n  let mut manifest = None\\n  let rows = empty_group_cache_specs()\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(raw, i) == 10\\n    }\\n    if at_line_end {\\n      let line = strip_trailing_cr(raw[line_start:i])\\n      if String::length(line) > 0 {\\n        let fields = split_tsv_fields(line)\\n        let tag = Array::get(fields, 0)\\n        if tag == \\\"version\\\" {\\n          if Array::length(fields) != 2 {\\n            throw(\\\"invalid persistent source group cache version\\\")\\n          }\\n          let version_text = Array::get(fields, 1)\\n          if version_text == \\\"1\\\" {\\n            version = 1\\n          } else if version_text == \\\"2\\\" {\\n            version = 2\\n          } else {\\n            throw(\\\"invalid persistent source group cache version\\\")\\n          }\\n        } else if tag == \\\"manifest\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 3 {\\n              throw(\\\"invalid persistent source group cache manifest row\\\")\\n            }\\n            manifest = Some((Array::get(fields, 1), \\\"\\\", Array::get(fields, 2)))\\n          } else {\\n            if Array::length(fields) != 4 {\\n              throw(\\\"invalid persistent source group cache manifest row\\\")\\n            }\\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n          }\\n        } else if tag == \\\"group\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 4 {\\n              throw(\\\"invalid persistent source group cache group row\\\")\\n            }\\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), \\\"\\\", Array::get(fields, 3)))\\n          } else {\\n            if Array::length(fields) != 5 {\\n              throw(\\\"invalid persistent source group cache group row\\\")\\n            }\\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\\n          }\\n        } else {\\n          throw(String::concat(\\\"invalid persistent source group cache row: \\\", line))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  (version, manifest, rows)\\n}\\n\\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\\n  if !(Fs::exists(path)) {\\n    false\\n  } else {\\n    let has_stat_token = String::length(stat_token_text) > 0\\n    if has_stat_token {\\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\\n        true\\n      } else if String::length(source_fingerprint) > 0 {\\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n      } else {\\n        false\\n      }\\n    } else if String::length(source_fingerprint) > 0 {\\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n    } else {\\n      false\\n    }\\n  }\\n}\\n\\nlet load_source_if_cached_file_spec_matches: (String, String, String) -> Option[String] with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\\n  if !(Fs::exists(path)) {\\n    None\\n  } else {\\n    let has_stat_token = String::length(stat_token_text) > 0\\n    if has_stat_token {\\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\\n        Some(Fs::read_file(path))\\n      } else if String::length(source_fingerprint) > 0 {\\n        let source = Fs::read_file(path)\\n        if compact_string_fingerprint(source) == source_fingerprint {\\n          Some(source)\\n        } else {\\n          None\\n        }\\n      } else {\\n        None\\n      }\\n    } else if String::length(source_fingerprint) > 0 {\\n      let source = Fs::read_file(path)\\n      if compact_string_fingerprint(source) == source_fingerprint {\\n        Some(source)\\n      } else {\\n        None\\n      }\\n    } else {\\n      None\\n    }\\n  }\\n}\\n\\nlet rec load_cached_sources_rec: (Array[(String, String, String)], Int, Array[(String, String)]) -> Option[Array[(String, String)]] with { Error, Fs } = (specs, index, out) -> {\\n  if index >= Array::length(specs) {\\n    Some(out)\\n  } else {\\n    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)\\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\\n      Some(source) => {\\n        Array::push(out, (path, source))\\n        load_cached_sources_rec(specs, index + 1, out)\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\nlet rec load_cached_grouped_sources_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {\\n  if index >= Array::length(rows) {\\n    Some(out)\\n  } else {\\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\\n      Some(source) => {\\n        push_grouped_source(out, group_name, path, source)\\n        load_cached_grouped_sources_rec(rows, index + 1, out)\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\nlet rec load_cached_group_fingerprint_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {\\n  if index >= Array::length(rows) {\\n    Some(out)\\n  } else {\\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\\n    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\\n      None\\n    } else {\\n      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)\\n      load_cached_group_fingerprint_rec(rows, index + 1, out)\\n    }\\n  }\\n}\\n\\nlet manifest_cache_is_valid: (Option[(String, String, String)]) -> Bool with { Error, Fs } = (manifest) -> {\\n  match manifest {\\n    Some((path, stat_token_text, source_fingerprint)) =>\\n      matches_cached_file_spec(path, stat_token_text, source_fingerprint),\\n    None => true\\n  }\\n}\\n\\nlet load_persistent_sources_cache_if_valid: (String) -> Option[Array[(String, String)]] with { Error, Fs } = (entry_path) -> {\\n  let cache_path = persistent_source_list_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    if !(manifest_cache_is_valid(manifest)) {\\n      None\\n    } else {\\n      load_cached_sources_rec(specs, 0, empty_source_specs())\\n    }\\n  }\\n}\\n\\nlet load_persistent_source_groups_cache_if_valid: (String) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (entry_path) -> {\\n  let cache_path = persistent_source_group_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    if !(manifest_cache_is_valid(manifest)) {\\n      None\\n    } else {\\n      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())\\n    }\\n  }\\n}\\n\\nlet manifest_path_of: (Option[(String, String, String)]) -> Option[String] = (manifest) -> {\\n  match manifest {\\n    Some((path, _, _)) => Some(path),\\n    None => None\\n  }\\n}\\n\\nlet load_persistent_sources_from_group_cache_if_valid: (String) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\\n  let cache_path = persistent_source_group_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    if !(manifest_cache_is_valid(manifest)) {\\n      None\\n    } else {\\n      let specs = empty_source_cache_specs()\\n      let mut i = 0\\n      while i < Array::length(rows) {\\n        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\\n        Array::push(specs, (path, stat_token_text, source_fingerprint))\\n        i = i + 1\\n      }\\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\\n        Some(sources) => Some((manifest_path_of(manifest), sources)),\\n        None => None\\n      }\\n    }\\n  }\\n}\\n\\nlet load_persistent_source_groups_from_source_list_cache_if_valid: (String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\\n  let cache_path = persistent_source_list_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    if !(manifest_cache_is_valid(manifest)) {\\n      None\\n    } else {\\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\\n        Some(sources) =>\\n          match try_load_manifest_rows(entry_path) {\\n            Some((base_dir, rows)) => {\\n              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)\\n              Some((manifest_path_of(manifest), groups))\\n            },\\n            None => {\\n              let groups = empty_grouped_sources()\\n              Array::push(groups, (\\\"recursive\\\", sources))\\n              Some((None, groups))\\n            }\\n          },\\n        None => None\\n      }\\n    }\\n  }\\n}\\n\\nexport let load_persistent_source_group_fingerprint_if_valid: (String) -> Option[String] with { Error, Fs } = (entry_path) -> {\\n  let cache_path = persistent_source_group_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    if !(manifest_cache_is_valid(manifest)) {\\n      None\\n    } else {\\n      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {\\n        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),\\n        None => None\\n      }\\n    }\\n  }\\n}\\n\\nlet build_persistent_sources_cache_text: (Option[String], Array[(String, String)]) -> String with { Error, Fs } = (manifest_path, sources) -> {\\n  let mut out = \\\"version\\\\t2\\\\n\\\"\\n  match manifest_path {\\n    Some(path) => {\\n      out = String::concat(\\n        out,\\n        String::concat(\\n          \\\"manifest\\\\t\\\",\\n          String::concat(\\n            path,\\n            String::concat(\\n              \\\"\\\\t\\\",\\n              String::concat(\\n                __to_string(Fs::stat_token(path)),\\n                String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \\\"\\\\n\\\"))\\n              )\\n            )\\n          )\\n        )\\n      )\\n    },\\n    None => ()\\n  }\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    out = String::concat(\\n      out,\\n      String::concat(\\n        \\\"source\\\\t\\\",\\n        String::concat(\\n          path,\\n          String::concat(\\n            \\\"\\\\t\\\",\\n            String::concat(\\n              __to_string(Fs::stat_token(path)),\\n              String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(source), \\\"\\\\n\\\"))\\n            )\\n          )\\n        )\\n      )\\n    )\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet build_persistent_source_groups_cache_text: (Option[String], Array[(String, Array[(String, String)])]) -> String with { Error, Fs } = (manifest_path, groups) -> {\\n  let mut out = \\\"version\\\\t2\\\\n\\\"\\n  match manifest_path {\\n    Some(path) => {\\n      out = String::concat(\\n        out,\\n        String::concat(\\n          \\\"manifest\\\\t\\\",\\n          String::concat(\\n            path,\\n            String::concat(\\n              \\\"\\\\t\\\",\\n              String::concat(\\n                __to_string(Fs::stat_token(path)),\\n                String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \\\"\\\\n\\\"))\\n              )\\n            )\\n          )\\n        )\\n      )\\n    },\\n    None => ()\\n  }\\n  let mut gi = 0\\n  while gi < Array::length(groups) {\\n    let (group_name, sources) = Array::get(groups, gi)\\n    let mut si = 0\\n    while si < Array::length(sources) {\\n      let (path, source) = Array::get(sources, si)\\n      out = String::concat(\\n        out,\\n        String::concat(\\n          \\\"group\\\\t\\\",\\n          String::concat(\\n            group_name,\\n            String::concat(\\n              \\\"\\\\t\\\",\\n              String::concat(\\n                path,\\n                String::concat(\\n                  \\\"\\\\t\\\",\\n                  String::concat(\\n                    __to_string(Fs::stat_token(path)),\\n                    String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(source), \\\"\\\\n\\\"))\\n                  )\\n                )\\n              )\\n            )\\n          )\\n        )\\n      )\\n      si = si + 1\\n    }\\n    gi = gi + 1\\n  }\\n  out\\n}\\n\\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {\\n  let deps = Array::slice([\\\"\\\"], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  deps\\n}\\n\\nexport let load_or_parse_module_header_fs: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\\n  load_or_parse_module_header_fs_impl(path, source, parse_count)\\n}\\n\\nlet store_persistent_sources_cache: (String, Option[String], Array[(String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, sources) -> {\\n  Fs::write_file(\\n    persistent_source_list_cache_path(entry_path),\\n    build_persistent_sources_cache_text(manifest_path, sources)\\n  )\\n}\\n\\nlet store_persistent_source_groups_cache: (String, Option[String], Array[(String, Array[(String, String)])]) -> Unit with { Error, Fs } = (entry_path, manifest_path, groups) -> {\\n  Fs::write_file(\\n    persistent_source_group_cache_path(entry_path),\\n    build_persistent_source_groups_cache_text(manifest_path, groups)\\n  )\\n}\\n\\nlet copy_grouped_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] = (groups) -> {\\n  let out = empty_grouped_sources()\\n  let mut gi = 0\\n  while gi < Array::length(groups) {\\n    let (group_name, sources) = Array::get(groups, gi)\\n    let copied_sources = copy_source_specs(sources)\\n    Array::push(out, (group_name, copied_sources))\\n    gi = gi + 1\\n  }\\n  out\\n}\\n\\nlet flatten_group_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, String)] = (groups) -> {\\n  let out = empty_source_specs()\\n  let mut gi = 0\\n  while gi < Array::length(groups) {\\n    let (_, sources) = Array::get(groups, gi)\\n    let mut si = 0\\n    while si < Array::length(sources) {\\n      Array::push(out, Array::get(sources, si))\\n      si = si + 1\\n    }\\n    gi = gi + 1\\n  }\\n  out\\n}\\n\\nlet filter_group_sources: (Array[(String, Array[(String, String)])], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (groups, ordered_sources) -> {\\n  let filtered = empty_grouped_sources()\\n  let mut gi = 0\\n  while gi < Array::length(groups) {\\n    let (group_name, sources) = Array::get(groups, gi)\\n    let next_sources = empty_source_specs()\\n    let mut si = 0\\n    while si < Array::length(sources) {\\n      let pair = Array::get(sources, si)\\n      let (path, _) = pair\\n      match source_lookup(ordered_sources, path) {\\n        Some(_) => Array::push(next_sources, pair),\\n        None => ()\\n      }\\n      si = si + 1\\n    }\\n    if Array::length(next_sources) > 0 {\\n      Array::push(filtered, (group_name, next_sources))\\n    }\\n    gi = gi + 1\\n  }\\n  filtered\\n}\\n\\nlet special_bundle_source_groups: (String) -> Option[Array[(String, Array[(String, String)])]] = (entry_path) -> {\\n  let _ = entry_path\\n  None\\n}\\n\\nlet normalize_bundle_source_groups: (Array[(String, Array[(String, String)])], String, String) -> Array[(String, Array[(String, String)])] = (groups, main_path, main_source) -> {\\n  let normalized = empty_grouped_sources()\\n  let mut found = false\\n  let mut gi = 0\\n  while gi < Array::length(groups) {\\n    let (group_name, sources) = Array::get(groups, gi)\\n    let next_sources = empty_source_specs()\\n    let mut si = 0\\n    while si < Array::length(sources) {\\n      let (path, source) = Array::get(sources, si)\\n      if path == main_path {\\n        Array::push(next_sources, (path, main_source))\\n        found = true\\n      } else {\\n        Array::push(next_sources, (path, source))\\n      }\\n      si = si + 1\\n    }\\n    Array::push(normalized, (group_name, next_sources))\\n    gi = gi + 1\\n  }\\n  if !found {\\n    let entry_sources = empty_source_specs()\\n    Array::push(entry_sources, (main_path, main_source))\\n    Array::push(normalized, (\\\"entry\\\", entry_sources))\\n  }\\n  normalized\\n}\\n\\nlet special_manifest_sources: (String) -> Option[(String, Array[(String, String)])] = (entry_path) -> {\\n  let _ = entry_path\\n  None\\n}\\n\\nlet special_manifest_source_groups: (String) -> Option[(String, Array[(String, Array[(String, String)])])] = (entry_path) -> {\\n  let _ = entry_path\\n  None\\n}\\n\\n\\n//# Helper functions\\n\\n// Cache lookup helper\\nlet cache_lookup: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\\n  let len = Array::length(cache)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while i < len {\\n    if done {\\n      i = len\\n    } else {\\n      let (p, e) = Array::get(cache, i)\\n      if p == path {\\n        result = Some(e)\\n        done = true\\n      }\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet export_marker_name: (String) -> String = (name) -> {\\n  String::concat(\\\"__vibe_internal_export__:\\\", name)\\n}\\n\\nlet env_has_export_marker: (TypeEnv, String) -> Bool = (env, name) -> {\\n  match env_lookup(env, export_marker_name(name)) {\\n    Some(_) => true,\\n    None => false\\n  }\\n}\\n\\nlet bind_export_markers: (TypeEnv, Array[String]) -> TypeEnv = (env, exports) -> {\\n  let mut acc = env\\n  let mut i = 0\\n  while i < Array::length(exports) {\\n    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\n// Bind imported names from a checked module's env\\nlet rec bind_checked_imports: (Array[(String, Option[String])], Int, TypeEnv, TypeEnv) -> TypeEnv = (names, i, env, mod_env) -> {\\n  if i >= Array::length(names) {\\n    env\\n  } else {\\n    let (name, alias) = Array::get(names, i)\\n    let bound_name = match alias {\\n      Some(a) => a,\\n      None => name\\n    }\\n    let new_env = if env_has_export_marker(mod_env, name) {\\n      match env_lookup(mod_env, name) {\\n        Some(ty) => env_bind(env, bound_name, ty),\\n        None => env\\n      }\\n    } else {\\n      env\\n    }\\n    bind_checked_imports(names, i + 1, new_env, mod_env)\\n  }\\n}\\n\\n//# Module Loader\\n\\n// Check a module and return its TypeEnv, resolving imports recursively.\\n// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).\\nexport let rec check_module: (String, String, Array[(String, String)], Array[String], Array[(String, TypeEnv)]) -> TypeEnv with { Error } = (source, path, sources, loading, checked_cache) -> {\\n  // Check cache first\\n  let cached = cache_lookup(checked_cache, path)\\n  match cached {\\n    Some(env) => env,\\n    None => {\\n      // Cycle detection\\n      if contains_path(loading, path) {\\n        throw(String::concat(\\\"import cycle detected: \\\", path))\\n      }\\n      let tokens = lex(source)\\n      let stmts = parse_program(tokens)\\n      let base_dir = dir_of_path(path)\\n      // Cycle-detection stack: push self before recursing through this\\n      // module's imports, truncate back when done. O(1) per frame vs.\\n      // the previous `Array::concat(loading, [path])`, which copied the\\n      // entire ancestor stack on every recursion and made nested module\\n      // loads O(depth²) — same idiom as `runtime/typecheck_fs.vibe`\\n      // (#366 truncate cutover).\\n      let saved_loading_len = Array::length(loading)\\n      Array::push(loading, path)\\n\\n      // Resolve imports using while loop\\n      let mut import_env = EnvEmpty\\n      let mut ri = 0\\n      while ri < Array::length(stmts) {\\n        let stmt = Array::get(stmts, ri)\\n        import_env = match stmt {\\n          SImport(raw_path, names) => {\\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\\n              None => throw(String::concat(\\\"module not found: \\\", resolve_import_path(base_dir, raw_path))),\\n              Some((resolved, mod_source)) => {\\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\\n                bind_checked_imports(names, 0, import_env, mod_env)\\n              }\\n            }\\n          },\\n          SReExport(raw_path, names) => {\\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\\n              None => throw(String::concat(\\\"module not found: \\\", resolve_import_path(base_dir, raw_path))),\\n              Some((resolved, mod_source)) => {\\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\\n                bind_checked_imports(names, 0, import_env, mod_env)\\n              }\\n            }\\n          },\\n          _ => import_env\\n        }\\n        ri = ri + 1\\n      }\\n      Array::truncate(loading, saved_loading_len)\\n\\n      // Type-check with imported env\\n      let empty_defs = Array::slice([TDAlias(\\\"_dummy\\\", Array::slice([\\\"\\\"], 0, 0), CtUnit)], 0, 0)\\n      let check_errors = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors)\\n\\n      // Cache result\\n      let cached_env = bind_export_markers(env, collect_exports(stmts))\\n      Array::push(checked_cache, (path, cached_env))\\n      cached_env\\n    }\\n  }\\n}\\n\\n//# FS-based source collection\\n\\nlet rec collect_sources_rec: (String, Array[(String, String)], Array[String]) -> Unit with { Error, Fs } = (path, sources, visited) -> {\\n  if contains_path(visited, path) {\\n    ()\\n  }\\n  else {\\n    Array::push(visited, path)\\n    let source = Fs::read_file(path)\\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\\n    // First, recurse into dependencies (imports and re-exports)\\n    let mut i = 0\\n    while i < Array::length(deps) {\\n      collect_sources_rec(Array::get(deps, i), sources, visited)\\n      i = i + 1\\n    }\\n    // Then add this module (dependencies come first)\\n    Array::push(sources, (path, source))\\n  }\\n}\\n\\n// Recursively collect all source files from filesystem, following imports and re-exports.\\n// Returns Array[(path, source)] in dependency order (dependencies first).\\nexport let collect_all_sources_fs: (String) -> Array[(String, String)] with { Error, Fs } = (entry_path) -> {\\n  match special_manifest_sources(entry_path) {\\n    Some((manifest_path, sources)) => {\\n      let _ = manifest_path\\n      copy_source_specs(sources)\\n    },\\n    None =>\\n      match load_persistent_sources_cache_if_valid(entry_path) {\\n        Some(sources) => sources,\\n        None => {\\n          match try_collect_manifest_sources_fs(entry_path) {\\n            Some((manifest_path, sources)) => {\\n              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)\\n              sources\\n            },\\n            None => {\\n              match try_load_manifest_rows(entry_path) {\\n                Some((base_dir, rows)) => {\\n                  let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)\\n                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)\\n                  preloaded_sources\\n                },\\n                None => {\\n                  let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n                  let visited = Array::slice([\\\"\\\"], 0, 0)\\n                  collect_sources_rec(entry_path, sources, visited)\\n                  store_persistent_sources_cache(entry_path, None, sources)\\n                  sources\\n                }\\n              }\\n            }\\n          }\\n        }\\n      }\\n  }\\n}\\n\\nexport let collect_source_groups_fs: (String) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\\n  match special_manifest_source_groups(entry_path) {\\n    Some((manifest_path, groups)) => {\\n      let _ = manifest_path\\n      copy_grouped_sources(groups)\\n    },\\n    None =>\\n      match load_persistent_source_groups_cache_if_valid(entry_path) {\\n        Some(groups) => groups,\\n        None =>\\n          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {\\n            Some((manifest_path, groups)) => {\\n              store_persistent_source_groups_cache(entry_path, manifest_path, groups)\\n              groups\\n            },\\n            None =>\\n              match try_collect_manifest_source_groups_fs(entry_path) {\\n                Some((manifest_path, groups)) => {\\n                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\\n                  groups\\n                },\\n                None =>\\n                  match try_load_manifest_rows(entry_path) {\\n                    Some((base_dir, rows)) => {\\n                      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n                      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\\n                      let groups = empty_grouped_sources()\\n                      let mut j = 0\\n                      while j < Array::length(rows) {\\n                        let (group_name, rel_path) = Array::get(rows, j)\\n                        let path = join_path(base_dir, rel_path)\\n                        let mut found = \\\"\\\"\\n                        let mut k = 0\\n                        while k < Array::length(preloaded_sources) {\\n                          if found == \\\"\\\" {\\n                            let (source_path, source_text) = Array::get(preloaded_sources, k)\\n                            if source_path == path {\\n                              found = source_text\\n                            }\\n                          }\\n                          k = k + 1\\n                        }\\n                        if found == \\\"\\\" {\\n                          ()\\n                        } else {\\n                          push_grouped_source(groups, group_name, path, found)\\n                        }\\n                        j = j + 1\\n                      }\\n                      store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\\n                      groups\\n                    },\\n                    None => {\\n                      let groups = empty_grouped_sources()\\n                      let recursive_sources = collect_all_sources_fs(entry_path)\\n                      Array::push(groups, (\\\"recursive\\\", recursive_sources))\\n                      store_persistent_source_groups_cache(entry_path, None, groups)\\n                      groups\\n                    }\\n                  }\\n              }\\n          }\\n      }\\n  }\\n}\\n\\n//# Module bundling — merge stmts from all modules in dependency order\\n\\n// Given all sources (in dependency order), parse and merge their statements.\\n// Skips SImport, SReExport (already resolved). Keeps all definitions.\\nexport let collect_merged_stmts: (Array[(String, String)]) -> Array[Stmt] with { Error } = (sources) -> {\\n  let merged = Array::slice([SExport([\\\"_dummy\\\"])], 0, 0)\\n  let mut si = 0\\n  while si < Array::length(sources) {\\n    let (_, src) = Array::get(sources, si)\\n    // Use lex+parse_program directly (skip resolve_interp_stmt to reduce heap pressure)\\n    let stmts = parse_program(lex(src))\\n    let mut j = 0\\n    while j < Array::length(stmts) {\\n      let stmt = Array::get(stmts, j)\\n      match stmt {\\n        SImport(_, _) => (),\\n        SReExport(_, _) => (),\\n        SAliasDecl(_, _) => (),\\n        _ => Array::push(merged, stmt)\\n      }\\n      j = j + 1\\n    }\\n    si = si + 1\\n  }\\n  merged\\n}\\n\")\n}\n\nlet cli_adapter_source_134 = () -> (String, String) {\n  (\"vibe/compiler/module_loader.vibe\",\n\"//# Imports\\n\\nexport ./loader {\\n  check_module, collect_all_sources_fs, collect_merged_stmts, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\\n}\\n\\n//# Misc\\n\\nexport {\\n  check_module, collect_merged_stmts, collect_all_sources_fs, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\\n}\\n\")\n}\n\nlet cli_adapter_source_135 = () -> (String, String) {\n  (\"vibe/compiler/normalize/index.vibe\",\n\"//# `vibe normalize` engine (selfhost vertical slice, #594)\\n//#\\n//# A canonicalizing source transform built on the compiler's own AST. The first\\n//# slice implements the structural pipeline:\\n//#\\n//#   parse -> flatten modules (`module m { let f }` => `let m::f`)\\n//#         -> dead-code elimination from exported roots\\n//#         -> drop redundant aggregate `export { .. }` statements\\n//#         -> categorize into Imports / Types / Functions / Tests sections\\n//#         -> render via the AST printer with section headers + blank lines\\n//#\\n//# Deferred to follow-ups (the host engine is ~6.6k lines): inline/const fold,\\n//# inferred type annotations, decl-separator / labeled-arg quickfixes, and\\n//# semver dependency `latest` resolution.\\n\\n//# Imports\\n\\nimport ../core/ast.vibe {\\n  Stmt, TypeExpr, Expr, Pat\\n}\\n\\nimport ../core/polyfill.vibe {\\n  __to_string\\n}\\n\\nimport ../core/dce.vibe {\\n  dce_stmts\\n}\\n\\nimport ../syntax/index.vibe {\\n  Token, lex, parse_program, print_stmt\\n}\\n\\nimport ../syntax/import_alias_rewrite.vibe {\\n  rewrite_import_alias_expr\\n}\\n\\n//# Module flattening\\n\\nlet empty_stmts: () -> Array[Stmt] = () -> {\\n  Array::slice([\\n    SExport([])\\n  ], 0, 0)\\n}\\n\\nlet empty_strs: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\n// Prefix a binding name with the enclosing module path (`math` + `helper` =>\\n// `math::helper`). Empty prefix leaves the name unchanged.\\nlet join_module_name: (String, String) -> String = (prefix, name) -> {\\n  if prefix == \\\"\\\" {\\n    name\\n  } else {\\n    String::concat(prefix, String::concat(\\\"::\\\", name))\\n  }\\n}\\n\\n// Alias map (short name -> `prefix::name`) for the value members of a module\\n// body, so intra-module references can be qualified to match the renamed decls.\\nlet rec module_value_aliases: (Array[Stmt], String, Array[(String, String)]) -> Int = (body, prefix, out) -> {\\n  let mut i = 0\\n  while i < Array::length(body) {\\n    match Array::get(body, i) {\\n      SLet(_, _, name, _, _) => {\\n        Array::push(out, (name, join_module_name(prefix, name)))\\n        0\\n      },\\n      SLetMut(name, _, _) => {\\n        Array::push(out, (name, join_module_name(prefix, name)))\\n        0\\n      },\\n      SExternLet(name, _) => {\\n        Array::push(out, (name, join_module_name(prefix, name)))\\n        0\\n      },\\n      SModule(_, inner, inner_body) => {\\n        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)\\n        0\\n      },\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  0\\n}\\n\\n// Flatten a (DCE'd) module body to top-level decls: rename each value binding to\\n// `prefix::name` AND qualify intra-module value references in its body, so the\\n// flattened source typechecks without the enclosing module scope (a sibling call\\n// `helper()` becomes `m::helper()`, matching the renamed `let m::helper`).\\nlet rec flatten_module_body: (Array[Stmt], String, Array[(String, String)], Array[Stmt]) -> Int = (body, prefix, aliases, out) -> {\\n  let mut i = 0\\n  while i < Array::length(body) {\\n    match Array::get(body, i) {\\n      SLet(exp, is_rec, name, ty, b) => {\\n        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\\n        0\\n      },\\n      SLetMut(name, ty, b) => {\\n        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\\n        0\\n      },\\n      SExternLet(name, ty) => {\\n        Array::push(out, SExternLet(join_module_name(prefix, name), ty))\\n        0\\n      },\\n      SModule(_, inner, inner_body) => {\\n        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), aliases, out)\\n        0\\n      },\\n      other => {\\n        Array::push(out, other)\\n        0\\n      }\\n    }\\n    i = i + 1\\n  }\\n  0\\n}\\n\\nlet is_module_stmt: (Stmt) -> Bool = (stmt) -> {\\n  match stmt {\\n    SModule(_, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\n//# Exported roots for DCE\\n\\n// Roots for top-level DCE: exported value bindings, plus any already\\n// module-qualified binding (a `m::f` name). Flattening renames a kept module\\n// member to `m::f` while leaving its body referencing the short `f`, so a\\n// second normalize pass must not drop those by name — keeping all `::` names\\n// (module members are live by construction) makes normalize idempotent.\\nlet exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let roots = empty_strs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(exp, _, name, _, _) => if exp || String::contains(name, \\\"::\\\") {\\n        Array::push(roots, name)\\n      },\\n      SLetMut(name, _, _) => if String::contains(name, \\\"::\\\") {\\n        Array::push(roots, name)\\n      },\\n      // Aggregate `export { a, b }` also marks an exported API; without this a\\n      // file whose only export is `export { run }` would DCE everything away.\\n      SExport(names) => {\\n        let mut j = 0\\n        while j < Array::length(names) {\\n          Array::push(roots, Array::get(names, j))\\n          j = j + 1\\n        }\\n        0\\n      },\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  roots\\n}\\n\\n// Names that an aggregate `export { .. }` re-exports (the renderer drops the\\n// `SExport` statement, so the underlying bindings must be promoted to keep the\\n// public API).\\nlet aggregate_export_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let names = empty_strs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SExport(exported) => {\\n        let mut j = 0\\n        while j < Array::length(exported) {\\n          Array::push(names, Array::get(exported, j))\\n          j = j + 1\\n        }\\n        0\\n      },\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  names\\n}\\n\\nlet str_array_has: (Array[String], String) -> Bool = (arr, target) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) && !found {\\n    if Array::get(arr, i) == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet promote_aggregate_exports: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, agg) -> {\\n  let result = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    let promoted = match stmt {\\n      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {\\n        SLet(true, is_rec, name, ty, body)\\n      } else {\\n        stmt\\n      },\\n      _ => stmt\\n    }\\n    Array::push(result, promoted)\\n    i = i + 1\\n  }\\n  result\\n}\\n\\n//# Type-alias DCE: drop non-exported aliases whose name is never referenced.\\n\\nlet rec collect_type_names_into: (TypeExpr, Array[String]) -> Int = (ty, out) -> {\\n  match ty {\\n    TyName(n) => {\\n      Array::push(out, n)\\n      0\\n    },\\n    TyApp(n, args) => {\\n      Array::push(out, n)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        let _ = collect_type_names_into(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    TyFn(params, ret, _) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let _ = collect_type_names_into(Array::get(params, i), out)\\n        i = i + 1\\n      }\\n      let _ = collect_type_names_into(ret, out)\\n      0\\n    },\\n    TyTuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        let _ = collect_type_names_into(Array::get(items, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    TyUnit => 0\\n  }\\n}\\n\\nlet collect_opt_type_into: (Option[TypeExpr], Array[String]) -> Int = (ty_opt, out) -> {\\n  match ty_opt {\\n    Some(ty) => collect_type_names_into(ty, out),\\n    None => 0\\n  }\\n}\\n\\n// Collect every type-name referenced by a statement.\\nlet collect_stmt_type_refs_into: (Stmt, Array[String]) -> Int = (stmt, out) -> {\\n  match stmt {\\n    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),\\n    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),\\n    SExternLet(_, ty) => collect_type_names_into(ty, out),\\n    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),\\n    SStruct(_, _, fields, _, _) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fty) = Array::get(fields, i)\\n        let _ = collect_type_names_into(fty, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    SEnum(_, _, _, ctors, _) => {\\n      let mut i = 0\\n      while i < Array::length(ctors) {\\n        let (_, args) = Array::get(ctors, i)\\n        let mut j = 0\\n        while j < Array::length(args) {\\n          let _ = collect_type_names_into(Array::get(args, j), out)\\n          j = j + 1\\n        }\\n        i = i + 1\\n      }\\n      0\\n    },\\n    SImpl(_, _, _, type_name) => {\\n      Array::push(out, type_name)\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\n\\nlet drop_unused_type_aliases: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let referenced = empty_strs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)\\n    i = i + 1\\n  }\\n  let result = empty_stmts()\\n  let mut k = 0\\n  while k < Array::length(stmts) {\\n    let stmt = Array::get(stmts, k)\\n    let keep = match stmt {\\n      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),\\n      _ => true\\n    }\\n    if keep {\\n      Array::push(result, stmt)\\n    }\\n    k = k + 1\\n  }\\n  result\\n}\\n\\n//# Categorize + render\\n\\n// 0 = import, 1 = type/structural, 2 = function/value, 3 = test/bench,\\n// 9 = drop (aggregate export / bare expression).\\nlet stmt_section: (Stmt) -> Int = (stmt) -> {\\n  match stmt {\\n    SImport(_, _) => 0,\\n    SReExport(_, _) => 0,\\n    SAliasDecl(_, _) => 0,\\n    SEnum(_, _, _, _, _) => 1,\\n    SSuberror(_, _, _) => 1,\\n    SStruct(_, _, _, _, _) => 1,\\n    STypeAlias(_, _, _, _) => 1,\\n    STrait(_, _, _, _, _) => 1,\\n    SImpl(_, _, _, _) => 1,\\n    SEffectDef(_, _, _, _) => 1,\\n    SExternLet(_, _) => 1,\\n    SLet(_, _, _, _, _) => 2,\\n    SLetMut(_, _, _) => 2,\\n    SLetPat(_, _) => 2,\\n    STest(_, _) => 3,\\n    SBench(_, _) => 3,\\n    SExport(_) => 9,\\n    SExpr(_) => 9,\\n    _ => 9\\n  }\\n}\\n\\nlet section_header: (Int) -> String = (section) -> {\\n  if section == 0 {\\n    \\\"//# Imports\\\"\\n  } else if section == 1 {\\n    \\\"//# Types\\\"\\n  } else if section == 2 {\\n    \\\"//# Functions\\\"\\n  } else {\\n    \\\"//# Tests\\\"\\n  }\\n}\\n\\n// Render all statements in one section (already filtered) joined by blank lines,\\n// prefixed by the section header. Returns \\\"\\\" when the section is empty.\\nlet render_section: (Array[Stmt], Int) -> String = (stmts, section) -> {\\n  let parts = empty_strs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    if stmt_section(stmt) == section {\\n      Array::push(parts, print_stmt(stmt))\\n    }\\n    i = i + 1\\n  }\\n  if Array::length(parts) == 0 {\\n    \\\"\\\"\\n  } else {\\n    let body = String::join(parts, \\\"\\\\n\\\\n\\\")\\n    String::concat(section_header(section), String::concat(\\\"\\\\n\\\\n\\\", body))\\n  }\\n}\\n\\n//# Lambda-annotation hoisting\\n\\nlet normalize_empty_type_exprs: () -> Array[TypeExpr] = () -> {\\n  Array::slice([\\n    TyUnit\\n  ], 0, 0)\\n}\\n\\nlet all_params_typed: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {\\n  let mut i = 0\\n  let mut ok = true\\n  while i < Array::length(params) {\\n    let (_, ty_opt) = Array::get(params, i)\\n    match ty_opt {\\n      Some(_) => 0,\\n      None => {\\n        ok = false\\n        0\\n      }\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\nlet param_type_list: (Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] = (params) -> {\\n  let out = normalize_empty_type_exprs()\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (_, ty_opt) = Array::get(params, i)\\n    match ty_opt {\\n      Some(ty) => Array::push(out, ty),\\n      None => 0\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet strip_param_types: (Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (params) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (name, _) = Array::get(params, i)\\n    Array::push(out, (name, None))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Canonicalize an old-syntax lambda binding `let f = (x: T) -> R { body }` to\\n// the annotated form `let f: (T) -> R = (x) -> { body }`: move the parameter\\n// types + return type into a `TyFn` let-annotation and strip them from the\\n// lambda. Only when the let has no annotation yet, the value is a return-type\\n// annotated lambda, and every parameter carries a type (full type recoverable).\\nlet hoist_lambda_let: (Stmt) -> Stmt = (stmt) -> {\\n  match stmt {\\n    SLet(exp, is_rec, name, ty, value) => match ty {\\n      Some(_) => stmt,\\n      None => match value {\\n        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {\\n          None => stmt,\\n          // Skip generic lambdas: their `[T]` type params scope the lambda, not\\n          // the let annotation, so hoisting `[T](x: T) -> T` to `: (T) -> T =\\n          // [T](x) -> {...}` would leave `T` unbound in the annotation and the\\n          // normalized output would not compile.\\n          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {\\n            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))\\n          } else {\\n            stmt\\n          }\\n        },\\n        _ => stmt\\n      }\\n    },\\n    _ => stmt\\n  }\\n}\\n\\nlet hoist_lambda_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let out = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n//# Constant folding\\n\\n// Fold a binary op on two int literals. Only the closed arithmetic ops `+ - *`,\\n// which are total and wrap identically at compile time and runtime (both use\\n// 62-bit Int), so folding is semantics-preserving. `/` and `%` are skipped\\n// (a literal `x / 0` must keep trapping at runtime, not at fold time).\\nlet fold_int_binop: (String, Int, Int) -> Option[Int] = (op, a, b) -> {\\n  if op == \\\"+\\\" {\\n    Some(a + b)\\n  } else if op == \\\"-\\\" {\\n    Some(a - b)\\n  } else if op == \\\"*\\\" {\\n    Some(a * b)\\n  } else {\\n    None\\n  }\\n}\\n\\nlet rec fold_expr: (Expr) -> Expr = (expr) -> {\\n  match expr {\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EIdent(_, _) => expr,\\n    EUnit => expr,\\n    EStringInterp(_) => expr,\\n    ETuple(items) => ETuple(for it in items {\\n      fold_expr(it)\\n    }),\\n    EArray(items) => EArray(for it in items {\\n      fold_expr(it)\\n    }),\\n    ERecord(fields) => ERecord(for f in fields {\\n      let (n, v) = f\\n      (n, fold_expr(v))\\n    }),\\n    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),\\n    ELet(n, v, b) => ELet(n, fold_expr(v), fold_expr(b)),\\n    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),\\n    ELetMut(n, v, b) => ELetMut(n, fold_expr(v), fold_expr(b)),\\n    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),\\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, fold_expr(v), fold_expr(b)),\\n    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),\\n    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {\\n      let (p, e) = a\\n      (p, fold_expr(e))\\n    }),\\n    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {\\n      let (p, e) = a\\n      (p, fold_expr(e))\\n    }),\\n    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),\\n    ELoop(params, b) => ELoop(for pr in params {\\n      let (n, init) = pr\\n      (n, fold_expr(init))\\n    }, fold_expr(b)),\\n    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),\\n    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {\\n      fold_expr(a)\\n    }, off),\\n    EBinOp(op, l, r) => {\\n      let fl = fold_expr(l)\\n      let fr = fold_expr(r)\\n      match fl {\\n        EInt(a) => match fr {\\n          EInt(b) => match fold_int_binop(op, a, b) {\\n            Some(v) => EInt(v),\\n            None => EBinOp(op, fl, fr)\\n          },\\n          _ => EBinOp(op, fl, fr)\\n        },\\n        _ => EBinOp(op, fl, fr)\\n      }\\n    },\\n    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),\\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),\\n    EDot(e, field, off) => EDot(fold_expr(e), field, off),\\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),\\n    EThrow(e) => EThrow(fold_expr(e)),\\n    EReturn(e) => EReturn(fold_expr(e)),\\n    EBreak(opt) => match opt {\\n      Some(v) => EBreak(Some(fold_expr(v))),\\n      None => EBreak(None)\\n    },\\n    EContinue(args) => EContinue(for a in args {\\n      fold_expr(a)\\n    }),\\n    EMap(fields) => EMap(for f in fields {\\n      let (k, v) = f\\n      (k, fold_expr(v))\\n    }),\\n    ESpread(e) => ESpread(fold_expr(e))\\n  }\\n}\\n\\n// #703 follow-up: lift a temporary (non-variable) match scrutinee into a `let`\\n// so the Perceus RC pass — which attributes drops to NAMED bindings — gives it\\n// a scope-end drop. `match <e> { arms }` -> `let __m_scrut_N = <e> in match\\n// __m_scrut_N { arms }` when `<e>` is not already an identifier. Without a\\n// binding the fresh owned heap value the scrutinee produces (`match foo() {\\n// .. }`, `match Some(x) { .. }`) is never dropped and leaks under RC.\\n//\\n// #708: the lift name MUST be unique per lift site (the `_N` suffix, from a\\n// counter cell threaded through every recursive call). A single non-unique\\n// name shared by every lift in a function is not just an RC-drop-scheduling\\n// hazard (the original #708 fix) — when two lifts NEST (a match whose\\n// scrutinee is itself a non-identifier match, e.g. `let (a,b) = match\\n// <call> { .. }`, which the parser also desugars through a match-over-a-\\n// match), the OUTER lift's own body-compile resolves the identifier by\\n// searching local slots most-recent-first. Since the INNER lift (compiled\\n// while evaluating the outer lift's OWN value) pushes the identical name\\n// *after* the outer one, that search finds the inner (already out-of-scope)\\n// binding instead of the outer one it meant to reference — reading whatever\\n// unrelated heap object the inner scrutinee held (e.g. a `Token`) as if it\\n// were the outer's freshly-built tuple, and misinterpreting its raw memory\\n// as tuple fields. This produced garbage values (not a crash) for a `let\\n// (a,b,c,d) = match <call> {..}` pattern local's fields — confirmed via a\\n// minimal repro and fixed by this uniqueness change (see #708 follow-up\\n// investigation notes). Modeled on fold_expr's complete walk; only the\\n// EMatch case differs. EHandle is left as-is (effect handlers are not the\\n// same ownership shape). Pure rewrite (aside from the counter cell) —\\n// applied to each function body before build_perceus_plan so the plan and\\n// codegen agree; running it on the non-RC backend would be harmless but it is\\n// gated at the call site to keep that backend byte-identical.\\n// #712: RC codegen's per-function bookkeeping (CompileCtx's `heap_binding_names`,\\n// `rc_drop_names`, `rc_alias_dup_names`, `rc_dup_names`, `loop_borrowed_names`,\\n// etc., and the Perceus plan itself) all key on the bare identifier NAME, not\\n// binding identity. When an inner scope shadows an outer binding of the same\\n// name (`let x = ...; { let x = ...; f(x) }`, or a `while` loop body rebinding\\n// a name the loop already loop-borrows), those name-keyed lookups cannot tell\\n// the two `x`s apart -- an action meant for one binding can fire at the other's\\n// site instead (spurious/missing rc_dup, premature/missing rc_drop).\\n//\\n// Rather than retrofit every name-keyed consumer with binding identity (a\\n// larger, more invasive change -- see #712), this eliminates the ambiguity at\\n// the source: alpha-rename every binding that shadows an enclosing one to a\\n// fresh, globally-unique name before the Perceus plan is built, so no two live\\n// bindings in one function ever share a name. Modeled on lift_match_scrutinees\\n// (#708) -- same shared-counter-cell technique for uniqueness, same complete\\n// per-Expr-variant walk. Unshadowed bindings (the vast majority) are left with\\n// their original name (so debugging/argument-inspection output is unaffected\\n// outside the rare shadowing case). Pure rewrite; gated at the call site to\\n// keep the non-RC backend byte-identical.\\nlet fresh_shadow_name: (Array[Int], String) -> String = (counter, name) -> {\\n  let n = Array::get(counter, 0)\\n  Array::set(counter, 0, n + 1)\\n  String::concat(String::concat(\\\"__shadow_\\\", __to_string(n)), String::concat(\\\"_\\\", name))\\n}\\n\\n// Renamed reference for `name` under `env`, or `name` unchanged if it is not a\\n// tracked (shadowed-or-not) binding -- i.e. a free variable / global / builtin.\\nlet uq_lookup: (Map[String, String], String) -> String = (env, name) -> {\\n  if Map::has_key(env, name) {\\n    Map::get(env, name)\\n  } else {\\n    name\\n  }\\n}\\n\\n// #715: has `name` been bound ANYWHERE in this function already (including a\\n// sibling scope that has since closed)? `seen` is a shared mutable array, one\\n// per top-level function, appended by uq_bind_name's first-binder path.\\nlet uq_seen_contains: (Array[String], String) -> Bool = (seen, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(seen) {\\n    if Array::get(seen, i) == name {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// Introduce binding `name` into `env`. If `name` is already tracked (bound by\\n// an enclosing scope, shadowed or not), this occurrence shadows it: mint a\\n// fresh unique name and map `name` to it for the extent of the inner scope.\\n//\\n// #715: ALSO rename when `name` was bound anywhere EARLIER in this same\\n// function, even in an already-closed sibling scope (two match arms both\\n// declaring `let resolved = ...`). The Perceus plan's actions and codegen's\\n// bookkeeping (rc_drop_names / rc_dup_names / heap_binding_names) are flat,\\n// name-keyed, whole-function lists, so two same-named sibling bindings\\n// receive each other's planned dups/drops -- confirmed as the #715 checker\\n// crash: check_expr declares `let resolved` in four sibling scopes; a\\n// scope-end PaDrop planned for one fired at another whose reference had\\n// already been consumed through resolve_tparams_in, freeing the block a\\n// still-live tuple pointed at (use-after-free at the `pt` destructure dup).\\n//\\n// Otherwise this is the first binder for `name` in this function; keep it\\n// as-is but still record the identity mapping, so a DEEPER shadow of the same\\n// name is detected against this occurrence.\\nlet uq_bind_name: (String, Map[String, String], Array[Int], Array[String]) -> (String, Map[String, String]) = (name, env, counter, seen) -> {\\n  // A labeled/optional param (`a~`/`a?`) is declared with its suffix but its\\n  // body references use the STRIPPED name, so this env (keyed by the declared\\n  // name) never rewrites those references anyway -- renaming the declaration\\n  // alone would orphan them. Leave such params untouched (status quo).\\n  let nlen = String::length(name)\\n  let lastc = if nlen > 0 {\\n    String::char_code_at(name, nlen - 1)\\n  } else {\\n    0\\n  }\\n  if lastc == '~' || lastc == '?' {\\n    (name, env)\\n  } else if Map::has_key(env, name) || uq_seen_contains(seen, name) {\\n    let fresh = fresh_shadow_name(counter, name)\\n    (fresh, Map::set(env, name, fresh))\\n  } else {\\n    Array::push(seen, name)\\n    (name, Map::set(env, name, name))\\n  }\\n}\\n\\nlet rec uq_pat_names: (Pat, Array[String]) -> Unit = (pat, out) -> {\\n  match pat {\\n    PBind(name) => Array::push(out, name),\\n    PCtor(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        uq_pat_names(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        uq_pat_names(Array::get(pats, i), out)\\n        i = i + 1\\n      }\\n    },\\n    POr(l, _r) => uq_pat_names(l, out),\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        uq_pat_names(fp, out)\\n        i = i + 1\\n      }\\n    },\\n    PInt(_) => (),\\n    PString(_) => (),\\n    PBool(_) => (),\\n    PWild => ()\\n  }\\n}\\n\\nlet rec uq_pat_rewrite: (Pat, Map[String, String]) -> Pat = (pat, env) -> {\\n  match pat {\\n    PBind(name) => PBind(uq_lookup(env, name)),\\n    PCtor(name, args) => PCtor(name, for a in args {\\n      uq_pat_rewrite(a, env)\\n    }),\\n    PTuple(pats) => PTuple(for a in pats {\\n      uq_pat_rewrite(a, env)\\n    }),\\n    POr(l, r) => POr(uq_pat_rewrite(l, env), uq_pat_rewrite(r, env)),\\n    PStruct(name, fields) => PStruct(name, for f in fields {\\n      let (fname, fp) = f\\n      (fname, uq_pat_rewrite(fp, env))\\n    }),\\n    _ => pat\\n  }\\n}\\n\\n// Binds every name in `pat` (shadow-checked against `env`) and returns the\\n// rewritten pattern together with the extended env for the pattern's own\\n// scope (the arm body).\\nlet uq_bind_pat: (Pat, Map[String, String], Array[Int], Array[String]) -> (Pat, Map[String, String]) = (pat, env, counter, seen) -> {\\n  let names: Array[String] = [\\n  ]\\n  uq_pat_names(pat, names)\\n  let mut env2 = env\\n  let mut i = 0\\n  while i < Array::length(names) {\\n    let (_, env3) = uq_bind_name(Array::get(names, i), env2, counter, seen)\\n    env2 = env3\\n    i = i + 1\\n  }\\n  (uq_pat_rewrite(pat, env2), env2)\\n}\\n\\nexport let rec uniquify_shadowed_bindings: (Expr, Map[String, String], Array[Int], Array[String]) -> Expr = (expr, env, counter, seen) -> {\\n  match expr {\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EIdent(name, off) => EIdent(uq_lookup(env, name), off),\\n    EUnit => expr,\\n    EStringInterp(_) => expr,\\n    ETuple(items) => ETuple(for it in items {\\n      uniquify_shadowed_bindings(it, env, counter, seen)\\n    }),\\n    EArray(items) => EArray(for it in items {\\n      uniquify_shadowed_bindings(it, env, counter, seen)\\n    }),\\n    ERecord(fields) => ERecord(for f in fields {\\n      let (n, v) = f\\n      (n, uniquify_shadowed_bindings(v, env, counter, seen))\\n    }),\\n    EIf(c, t, e) => EIf(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(t, env, counter, seen), uniquify_shadowed_bindings(e, env, counter, seen)),\\n    ELet(n, v, b) => {\\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\\n      ELet(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\\n    },\\n    ELetRec(n, v, b) => {\\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\\n      let v2 = uniquify_shadowed_bindings(v, env2, counter, seen)\\n      ELetRec(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\\n    },\\n    ELetMut(n, v, b) => {\\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\\n      ELetMut(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\\n    },\\n    EAssign(n, v, b) => EAssign(uq_lookup(env, n), uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\\n    EAssignOp(n, op, v, b) => EAssignOp(uq_lookup(env, n), op, uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\\n    ESeq(a, b) => ESeq(uniquify_shadowed_bindings(a, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\\n    EMatch(s, arms) => EMatch(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\\n      let (p, e) = a\\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\\n    }),\\n    EHandle(s, arms) => EHandle(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\\n      let (p, e) = a\\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\\n    }),\\n    EWhile(c, b) => EWhile(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\\n    ELoop(params, b) => {\\n      let mut env2 = env\\n      let zipped: Array[(String, Expr)] = [\\n      ]\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pn, init) = Array::get(params, pi)\\n        let init2 = uniquify_shadowed_bindings(init, env, counter, seen)\\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\\n        env2 = envN\\n        Array::push(zipped, (pn2, init2))\\n        pi = pi + 1\\n      }\\n      ELoop(zipped, uniquify_shadowed_bindings(b, env2, counter, seen))\\n    },\\n    EForIn(n, idx, it, b) => {\\n      let it2 = uniquify_shadowed_bindings(it, env, counter, seen)\\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\\n      let (idx2, env3) = match idx {\\n        Some(iname) => {\\n          let (iname2, envI) = uq_bind_name(iname, env2, counter, seen)\\n          (Some(iname2), envI)\\n        },\\n        None => (None, env2)\\n      }\\n      EForIn(n2, idx2, it2, uniquify_shadowed_bindings(b, env3, counter, seen))\\n    },\\n    ECall(callee, args, off) => ECall(uniquify_shadowed_bindings(callee, env, counter, seen), for a in args {\\n      uniquify_shadowed_bindings(a, env, counter, seen)\\n    }, off),\\n    EBinOp(op, l, r) => EBinOp(op, uniquify_shadowed_bindings(l, env, counter, seen), uniquify_shadowed_bindings(r, env, counter, seen)),\\n    EUnaryOp(op, e) => EUnaryOp(op, uniquify_shadowed_bindings(e, env, counter, seen)),\\n    EFn(tp, bounds, params, ret, eff, body) => {\\n      let mut env2 = env\\n      let params2: Array[(String, Option[TypeExpr])] = [\\n      ]\\n      let mut fi = 0\\n      while fi < Array::length(params) {\\n        let (pn, pty) = Array::get(params, fi)\\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\\n        env2 = envN\\n        Array::push(params2, (pn2, pty))\\n        fi = fi + 1\\n      }\\n      EFn(tp, bounds, params2, ret, eff, uniquify_shadowed_bindings(body, env2, counter, seen))\\n    },\\n    EDot(e, field, off) => EDot(uniquify_shadowed_bindings(e, env, counter, seen), field, off),\\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, uniquify_shadowed_bindings(v, env, counter, seen)),\\n    EThrow(e) => EThrow(uniquify_shadowed_bindings(e, env, counter, seen)),\\n    EReturn(e) => EReturn(uniquify_shadowed_bindings(e, env, counter, seen)),\\n    EBreak(opt) => match opt {\\n      Some(v) => EBreak(Some(uniquify_shadowed_bindings(v, env, counter, seen))),\\n      None => EBreak(None)\\n    },\\n    EContinue(args) => EContinue(for a in args {\\n      uniquify_shadowed_bindings(a, env, counter, seen)\\n    }),\\n    EMap(fields) => EMap(for f in fields {\\n      let (k, v) = f\\n      (k, uniquify_shadowed_bindings(v, env, counter, seen))\\n    }),\\n    ESpread(e) => ESpread(uniquify_shadowed_bindings(e, env, counter, seen))\\n  }\\n}\\n\\nlet fresh_m_scrut_name: (Array[Int]) -> String = (counter) -> {\\n  let n = Array::get(counter, 0)\\n  Array::set(counter, 0, n + 1)\\n  String::concat(\\\"__m_scrut_\\\", __to_string(n))\\n}\\n\\nexport let rec lift_match_scrutinees: (Expr, Array[Int]) -> Expr = (expr, counter) -> {\\n  match expr {\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EIdent(_, _) => expr,\\n    EUnit => expr,\\n    EStringInterp(_) => expr,\\n    ETuple(items) => ETuple(for it in items {\\n      lift_match_scrutinees(it, counter)\\n    }),\\n    EArray(items) => EArray(for it in items {\\n      lift_match_scrutinees(it, counter)\\n    }),\\n    ERecord(fields) => ERecord(for f in fields {\\n      let (n, v) = f\\n      (n, lift_match_scrutinees(v, counter))\\n    }),\\n    EIf(c, t, e) => EIf(lift_match_scrutinees(c, counter), lift_match_scrutinees(t, counter), lift_match_scrutinees(e, counter)),\\n    ELet(n, v, b) => ELet(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    ELetMut(n, v, b) => ELetMut(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    EAssign(n, v, b) => EAssign(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    ESeq(a, b) => ESeq(lift_match_scrutinees(a, counter), lift_match_scrutinees(b, counter)),\\n    EMatch(s, arms) => {\\n      let lifted_arms = for a in arms {\\n        let (p, e) = a\\n        (p, lift_match_scrutinees(e, counter))\\n      }\\n      let ls = lift_match_scrutinees(s, counter)\\n      match ls {\\n        EIdent(_, _) => EMatch(ls, lifted_arms),\\n        _ => {\\n          let fresh = fresh_m_scrut_name(counter)\\n          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms))\\n        }\\n      }\\n    },\\n    EHandle(s, arms) => EHandle(lift_match_scrutinees(s, counter), for a in arms {\\n      let (p, e) = a\\n      (p, lift_match_scrutinees(e, counter))\\n    }),\\n    EWhile(c, b) => EWhile(lift_match_scrutinees(c, counter), lift_match_scrutinees(b, counter)),\\n    ELoop(params, b) => ELoop(for pr in params {\\n      let (n, init) = pr\\n      (n, lift_match_scrutinees(init, counter))\\n    }, lift_match_scrutinees(b, counter)),\\n    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees(it, counter), lift_match_scrutinees(b, counter)),\\n    ECall(callee, args, off) => ECall(lift_match_scrutinees(callee, counter), for a in args {\\n      lift_match_scrutinees(a, counter)\\n    }, off),\\n    EBinOp(op, l, r) => EBinOp(op, lift_match_scrutinees(l, counter), lift_match_scrutinees(r, counter)),\\n    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees(e, counter)),\\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees(body, counter)),\\n    EDot(e, field, off) => EDot(lift_match_scrutinees(e, counter), field, off),\\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees(v, counter)),\\n    EThrow(e) => EThrow(lift_match_scrutinees(e, counter)),\\n    EReturn(e) => EReturn(lift_match_scrutinees(e, counter)),\\n    EBreak(opt) => match opt {\\n      Some(v) => EBreak(Some(lift_match_scrutinees(v, counter))),\\n      None => EBreak(None)\\n    },\\n    EContinue(args) => EContinue(for a in args {\\n      lift_match_scrutinees(a, counter)\\n    }),\\n    EMap(fields) => EMap(for f in fields {\\n      let (k, v) = f\\n      (k, lift_match_scrutinees(v, counter))\\n    }),\\n    ESpread(e) => ESpread(lift_match_scrutinees(e, counter))\\n  }\\n}\\n\\nlet fold_stmt: (Stmt) -> Stmt = (stmt) -> {\\n  match stmt {\\n    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),\\n    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),\\n    STest(n, body) => STest(n, fold_expr(body)),\\n    SBench(n, body) => SBench(n, fold_expr(body)),\\n    SExpr(e) => SExpr(fold_expr(e)),\\n    SLetPat(p, body) => SLetPat(p, fold_expr(body)),\\n    _ => stmt\\n  }\\n}\\n\\nlet fold_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let out = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::push(out, fold_stmt(Array::get(stmts, i)))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n//# Literal type annotation\\n\\n// The type of a value binding whose initializer is a literal of an obvious\\n// type. Only these self-evident cases are annotated; anything needing real\\n// inference (a call result, an identifier, arithmetic over non-literals) is\\n// left unannotated so normalize never asserts a type it cannot prove.\\nlet literal_type: (Expr) -> Option[TypeExpr] = (e) -> {\\n  match e {\\n    EInt(_) => Some(TyName(\\\"Int\\\")),\\n    EBool(_) => Some(TyName(\\\"Bool\\\")),\\n    EString(_) => Some(TyName(\\\"String\\\")),\\n    EFloat(_) => Some(TyName(\\\"Double\\\")),\\n    _ => None\\n  }\\n}\\n\\n// Add `: T` to an un-annotated `let x = <literal>` (runs after folding, so e.g.\\n// `let answer = 40 + 2` -> `let answer = 42` -> `let answer: Int = 42`). Lambda\\n// values are handled by hoisting, not here (a literal is never an `EFn`).\\nlet annotate_literal_let: (Stmt) -> Stmt = (stmt) -> {\\n  match stmt {\\n    SLet(exp, is_rec, name, ty, body) => match ty {\\n      Some(_) => stmt,\\n      None => match literal_type(body) {\\n        Some(t) => SLet(exp, is_rec, name, Some(t), body),\\n        None => stmt\\n      }\\n    },\\n    _ => stmt\\n  }\\n}\\n\\nlet annotate_literal_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let out = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::push(out, annotate_literal_let(Array::get(stmts, i)))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// DCE is name-based, so it must run while module members still carry their\\n// short names (a body says `helper()`, not `math::helper()`). We therefore DCE\\n// each scope before flattening renames its bindings:\\n//   - top-level non-module decls are DCE'd against the exported top-level roots;\\n//   - each module body is DCE'd against its own exported members, then renamed.\\nexport let normalize_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let nonmods = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    if !is_module_stmt(stmt) {\\n      Array::push(nonmods, stmt)\\n    }\\n    i = i + 1\\n  }\\n  let result = empty_stmts()\\n  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))\\n  Array::push_all(result, live_top)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    match Array::get(stmts, m) {\\n      SModule(_, name, body) => {\\n        let live_body = dce_stmts(body, exported_value_names(body))\\n        let aliases = Array::slice([\\n          (\\\"\\\", \\\"\\\")\\n        ], 0, 0)\\n        let _ = module_value_aliases(live_body, name, aliases)\\n        let _ = flatten_module_body(live_body, name, aliases, result)\\n        0\\n      },\\n      _ => 0\\n    }\\n    m = m + 1\\n  }\\n  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))\\n  hoist_lambda_lets(annotate_literal_lets(fold_stmts(drop_unused_type_aliases(promoted))))\\n}\\n\\nexport let normalize_source: (String) -> String with { Error } = (src) -> {\\n  // #cfg guard: parse_program DROPS inactive #cfg statements, so formatting\\n  // a #cfg-bearing source would silently delete the disabled code from the\\n  // re-printed output. Refuse instead.\\n  let toks_cfg = lex(src)\\n  let mut ci = 0\\n  while ci < Array::length(toks_cfg) {\\n    match Array::get(toks_cfg, ci) {\\n      THash => throw(\\\"cannot normalize a source containing #cfg directives\\\"),\\n      _ => ()\\n    }\\n    ci = ci + 1\\n  }\\n  let stmts = parse_program(toks_cfg)\\n  let kept = normalize_stmts(stmts)\\n  let sections = empty_strs()\\n  let mut s = 0\\n  while s <= 3 {\\n    let rendered = render_section(kept, s)\\n    if rendered != \\\"\\\" {\\n      Array::push(sections, rendered)\\n    }\\n    s = s + 1\\n  }\\n  String::concat(String::join(sections, \\\"\\\\n\\\\n\\\"), \\\"\\\\n\\\")\\n}\\n\")\n}\n\nlet cli_adapter_source_136 = () -> (String, String) {\n  (\"vibe/compiler/desugar_trait_dict.vibe\",\n\"//# Imports\\n\\nimport ./ast.vibe {\\n  Expr, Stmt, TypeExpr\\n}\\n\\n//# Functions\\n\\n// Dictionary-passing desugaring for method-bearing traits (#641 PR-3\\n// components 3+4). Runs pre-check, after string-interpolation expansion. It is\\n// INERT unless the program declares a trait with method signatures, so all\\n// existing code (and the compiler's own selfbuild) is untouched.\\n//\\n// For a method-bearing `trait Tr { m(Self) -> R; ... }` it:\\n//   1. synthesizes a witness struct `TrDict { m: (Self) -> R; ... }`,\\n//   2. for each top-level generic `f = [T: Tr](.. x: T ..) -> Ret { body }`\\n//      that is bounded by `Tr`, prepends a hidden dict parameter\\n//      `__dict_Tr_T: TrDict[T]` and rewrites `T::m(args)` in the body to\\n//      `(__dict_Tr_T.m)(args)`,\\n//   3. at every call site `f(.. recv ..)` synthesizes the witness\\n//      `TrDict::{ m: C::m, ... }` from the concrete receiver type C (the impl's\\n//      `C::m` free functions from PR-1) and threads it in.\\n//\\n// First slice (see docs/method-bearing-traits-plan.md): single type parameter\\n// per bound that appears directly as a parameter type (`x: T`), concrete call\\n// sites whose receiver type is syntactically determinable (primitive literals\\n// and struct literals). Anything outside this leaves the call unrewritten, so a\\n// missing dictionary surfaces as a loud arity error rather than a miscompile.\\n\\nlet empty_expr_array: () -> Array[Expr] = () -> {\\n  Array::slice([\\n    EUnit\\n  ], 0, 0)\\n}\\n\\nlet empty_str_array: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet empty_type_exprs: () -> Array[TypeExpr] = () -> {\\n  Array::slice([\\n    TyUnit\\n  ], 0, 0)\\n}\\n\\n// Method names declared by a trait, in declaration order.\\nlet method_names_of_sigs: (Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] = (methods) -> {\\n  let out = empty_str_array()\\n  let mut i = 0\\n  while i < Array::length(methods) {\\n    let (mname, _, _) = Array::get(methods, i)\\n    Array::push(out, mname)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet str_array_contains: (Array[String], String) -> Bool = (arr, val) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) {\\n    if Array::get(arr, i) == val {\\n      found = true\\n      i = Array::length(arr)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// Split a qualified `Head::member` into Some((head, member)) on the FIRST `::`.\\nlet split_qualified: (String) -> Option[(String, String)] = (name) -> {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    let member = String::substring(name, idx + 2, String::length(name))\\n    Some((head, member))\\n  }\\n}\\n\\n// The dict struct name for a trait, e.g. `Measurable` -> `MeasurableDict`.\\nlet dict_struct_name: (String) -> String = (trait_name) -> {\\n  String::concat(trait_name, \\\"Dict\\\")\\n}\\n\\n// The hidden dict parameter name for `[T: Tr]`, e.g. `__dict_Measurable_T`.\\nlet dict_param_name: (String, String) -> String = (trait_name, tparam) -> {\\n  String::concat(\\\"__dict_\\\", String::concat(trait_name, String::concat(\\\"_\\\", tparam)))\\n}\\n\\n// Collect method-bearing traits (name -> signatures). Marker-only traits\\n// (no method signatures) are skipped, which is what keeps this pass inert on\\n// existing code.\\nlet collect_method_traits: (Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      (\\\"\\\", empty_type_exprs(), TyUnit)\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STrait(_, tname, _, methods, _) => if Array::length(methods) > 0 {\\n        Array::push(out, (tname, methods))\\n      } else {\\n        ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// ---- rank-1 method generics (#684) ----\\n//\\n// A trait method may declare its own type parameters, `m: [X: Show](Self, X) ->\\n// R`. The binder lives on the TRAIT method only (STrait's 5th field); the impl\\n// `impl Tr for C { m = (self, x) -> {..} }` does NOT repeat it and parses to a\\n// top-level `SLet(_, _, \\\"C::m\\\", _, EFn([], [], [(self,None),(x,None)], ..))`.\\n// `inject_method_generics` re-attaches the trait method's `[X: Show]` binder to\\n// the impl's free function and annotates the unannotated params with the trait\\n// method's declared param types. After injection `build_gens` sees `x: X`,\\n// registers `C::m` as a Show-bounded generic, and the existing dict-passing\\n// machinery threads/synthesizes the `Show` witness at qualified call sites.\\n\\nlet empty_method_gens: () -> Array[(String, Array[String], Array[(String, Array[String])])] = () -> {\\n  Array::slice([\\n    (\\\"\\\", empty_str_array(), Array::slice([\\n      (\\\"\\\", empty_str_array())\\n    ], 0, 0))\\n  ], 0, 0)\\n}\\n\\n// Collect every trait's per-method generic binders (name -> [(method,\\n// type_params, bounds)]) from STrait's 5th field. Only traits that declare a\\n// non-empty binder on at least one method are kept, so this stays inert.\\nlet collect_trait_method_gens: (Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", empty_method_gens())\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STrait(_, tname, _, _, method_gens) => {\\n        let mut any = false\\n        let mut j = 0\\n        while j < Array::length(method_gens) {\\n          let (_, tps, _) = Array::get(method_gens, j)\\n          if Array::length(tps) > 0 {\\n            any = true\\n          } else {\\n            ()\\n          }\\n          j = j + 1\\n        }\\n        if any {\\n          Array::push(out, (tname, method_gens))\\n        } else {\\n          ()\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Look up a method's `(type_params, bounds)` in a trait's method-gen table.\\n// Returns None when the method has no binder (empty type_params).\\nlet lookup_method_gen: (Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], String, String) -> Option[(Array[String], Array[(String, Array[String])])] = (table, trait_name, method) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(table) {\\n    let (tn, gens) = Array::get(table, i)\\n    if tn == trait_name {\\n      let mut j = 0\\n      while j < Array::length(gens) {\\n        let (mname, tps, bounds) = Array::get(gens, j)\\n        if mname == method && Array::length(tps) > 0 {\\n          result = Some((tps, bounds))\\n          j = Array::length(gens)\\n        } else {\\n          j = j + 1\\n        }\\n      }\\n      i = Array::length(table)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// Map each impl's target type to the trait it implements\\n// (`impl Tr for C` -> (C, Tr)). A type may implement several traits; the first\\n// matching trait that declares the method is used at lookup time.\\nlet collect_impl_trait_map: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImpl(_, _, trait_name, type_name) => Array::push(out, (type_name, trait_name)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// The declared parameter types of method `m` in trait `trait_name` (its 3-tuple\\n// signature). Used to annotate the impl method's unannotated params so the\\n// per-method type parameter `X` appears as `x: X`.\\nlet lookup_trait_method_param_types: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String, String) -> Option[Array[TypeExpr]] = (traits, trait_name, method) -> {\\n  match lookup_trait_sigs(traits, trait_name) {\\n    Some(sigs) => {\\n      let mut j = 0\\n      let mut result = None\\n      while j < Array::length(sigs) {\\n        let (mname, ptypes, _) = Array::get(sigs, j)\\n        if mname == method {\\n          result = Some(ptypes)\\n          j = Array::length(sigs)\\n        } else {\\n          j = j + 1\\n        }\\n      }\\n      result\\n    },\\n    None => None\\n  }\\n}\\n\\n// Find the trait, among those `type_name` implements, that declares a\\n// method-level binder for `method`. Returns its (type_params, bounds, param\\n// types) so the impl method can be re-typed.\\nlet find_method_generic_for_impl: (Array[(String, String)], Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String, String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] = (impl_map, gen_table, traits, type_name, method) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(impl_map) {\\n    let (tn, trait_name) = Array::get(impl_map, i)\\n    if tn == type_name {\\n      match lookup_method_gen(gen_table, trait_name, method) {\\n        Some(g) => {\\n          let (tps, bounds) = g\\n          match lookup_trait_method_param_types(traits, trait_name, method) {\\n            Some(ptypes) => {\\n              result = Some((tps, bounds, ptypes))\\n              i = Array::length(impl_map)\\n            },\\n            None => {\\n              i = i + 1\\n            }\\n          }\\n        },\\n        None => {\\n          i = i + 1\\n        }\\n      }\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// Annotate each parameter whose annotation is None with the trait method's\\n// declared param type (when one exists at that index). Already-annotated params\\n// keep their annotation.\\nlet annotate_params_from_sig: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, ptypes) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, ann) = Array::get(params, i)\\n    let new_ann = match ann {\\n      Some(_) => ann,\\n      None => if i < Array::length(ptypes) {\\n        Some(Array::get(ptypes, i))\\n      } else {\\n        None\\n      }\\n    }\\n    Array::push(out, (pname, new_ann))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// In-place: for each impl method `C::m` whose trait declares a method-level\\n// `[X: Bound]` binder, re-attach the binder to the EFn and annotate its params\\n// with the trait method's declared types. Idempotent: an EFn that already\\n// carries type_params was injected on a prior run and is skipped.\\nlet inject_method_generics: (Array[Stmt], Array[(String, String)], Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit = (stmts, impl_map, gen_table, traits) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(exp, isrec, qname, ann, body) => match body {\\n        EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {\\n          match split_qualified(qname) {\\n            Some(parts) => {\\n              let (cname, method) = parts\\n              match find_method_generic_for_impl(impl_map, gen_table, traits, cname, method) {\\n                Some(g) => {\\n                  let (mtparams, mtbounds, ptypes) = g\\n                  let new_params = annotate_params_from_sig(params, ptypes)\\n                  let new_efn = EFn(mtparams, mtbounds, new_params, ret, eff, fbody)\\n                  Array::set(stmts, i, SLet(exp, isrec, qname, ann, new_efn))\\n                },\\n                None => ()\\n              }\\n            },\\n            None => ()\\n          }\\n        } else {\\n          ()\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n// Re-attach trait-method `[X: Bound]` binders to impl free functions, given a\\n// (possibly flattened) method-trait table for param-type lookup. Inert and\\n// idempotent. Shared by `desugar_trait_dicts` (pre-codegen) and `check_program`\\n// (so the FS-compile path, which type-checks before the desugar runs, also sees\\n// the binder and can resolve `X::method`).\\nlet inject_trait_method_generics_with: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit = (stmts, traits) -> {\\n  let method_gen_table = collect_trait_method_gens(stmts)\\n  if Array::length(method_gen_table) > 0 {\\n    let impl_map = collect_impl_trait_map(stmts)\\n    inject_method_generics(stmts, impl_map, method_gen_table, traits)\\n  } else {\\n    ()\\n  }\\n}\\n\\n// Self-contained entry for callers that have not flattened the trait table\\n// (the checker). Builds its own (flattened) method-trait table from `stmts`.\\nexport let inject_trait_method_generics: (Array[Stmt]) -> Unit = (stmts) -> {\\n  let traits_raw = collect_method_traits(stmts)\\n  let supers_map = collect_trait_supers(stmts)\\n  let traits = flatten_traits(traits_raw, supers_map)\\n  inject_trait_method_generics_with(stmts, traits)\\n}\\n\\n// Collect each trait's declared supertraits (`trait B: A + ...`), for all\\n// traits (method-bearing or not), so a method-bearing trait can inherit its\\n// supertraits' methods.\\nlet collect_trait_supers: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", empty_str_array())\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STrait(_, tname, supers, _, _) => Array::push(out, (tname, supers)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_supers: (Array[(String, Array[String])], String) -> Array[String] = (supers_map, name) -> {\\n  let mut i = 0\\n  let mut result = empty_str_array()\\n  while i < Array::length(supers_map) {\\n    let (tname, supers) = Array::get(supers_map, i)\\n    if tname == name {\\n      result = supers\\n      i = Array::length(supers_map)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// Flatten a trait's method signatures with those of its (transitive) method-\\n// bearing supertraits, deduplicating by method name, so `[T: B]` for\\n// `trait B: A` can dispatch both B's and A's methods through one flat witness\\n// dictionary. `acc_names` / `out` accumulate across the recursion.\\n//\\n// Supertrait methods are emitted BEFORE the trait's own, so an inherited method\\n// keeps the same field index in every dict that contains it (e.g. `measure`\\n// is index 0 in both `MeasurableDict` and `SizedDict`). This matters because\\n// codegen resolves `dict.field` by a global first-match field-name search\\n// (compile_expr_tail4.vibe), not by the object's static type — so a shared\\n// field name must sit at a consistent index across structs. (Single supertrait\\n// chains only; multiple-supertrait ordering is a deferred slice.)\\nlet rec flatten_trait_sigs_into: (String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[String], Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit = (tname, traits_raw, supers_map, acc_names, out) -> {\\n  let supers = lookup_supers(supers_map, tname)\\n  let mut s = 0\\n  while s < Array::length(supers) {\\n    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out)\\n    s = s + 1\\n  }\\n  match lookup_trait_sigs(traits_raw, tname) {\\n    Some(sigs) => {\\n      let mut i = 0\\n      while i < Array::length(sigs) {\\n        let (mname, params, ret) = Array::get(sigs, i)\\n        if str_array_contains(acc_names, mname) {\\n          ()\\n        } else {\\n          Array::push(acc_names, mname)\\n          Array::push(out, (mname, params, ret))\\n        }\\n        i = i + 1\\n      }\\n    },\\n    None => ()\\n  }\\n}\\n\\n// Produce a method-trait table whose signatures are flattened across\\n// supertraits, so all downstream code (dict struct, dispatch names, witness\\n// materialization) sees one flat method set per trait.\\nlet flatten_traits: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (traits_raw, supers_map) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      (\\\"\\\", empty_type_exprs(), TyUnit)\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(traits_raw) {\\n    let (tname, _) = Array::get(traits_raw, i)\\n    let acc_names = empty_str_array()\\n    let flat = Array::slice([\\n      (\\\"\\\", empty_type_exprs(), TyUnit)\\n    ], 0, 0)\\n    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat)\\n    Array::push(out, (tname, flat))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_trait_sigs: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] = (traits, name) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(traits) {\\n    let (tname, sigs) = Array::get(traits, i)\\n    if tname == name {\\n      result = Some(sigs)\\n      i = Array::length(traits)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// Collect user struct field-name sets, for inferring a struct-literal's type\\n// (the parser discards the `Name::` prefix of `Name::{ ... }`).\\nlet collect_struct_field_sets: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", empty_str_array())\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, sname, fields, _, _) => {\\n        let names = empty_str_array()\\n        let mut j = 0\\n        while j < Array::length(fields) {\\n          let (fname, _) = Array::get(fields, j)\\n          Array::push(names, fname)\\n          j = j + 1\\n        }\\n        Array::push(out, (sname, names))\\n      },\\n      // #672: also record enum names (with an EMPTY field set, so the ERecord\\n      // field-set match never confuses an enum with a struct literal) so the\\n      // `==` dispatch's `struct_set_has` gate accepts enum operands too.\\n      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Build the witness struct `TrDict { m: (Self) -> R; ... }` for a trait. The\\n// `Self` placeholder in the signatures stays verbatim — struct type params are\\n// erased, so the field-access typing is structural (proven in spike G-3).\\nlet make_dict_struct_stmt: (String, Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt = (trait_name, sigs) -> {\\n  let fields = Array::slice([\\n    (\\\"\\\", TyUnit)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(sigs) {\\n    let (mname, params, ret) = Array::get(sigs, i)\\n    Array::push(fields, (mname, TyFn(params, ret, None)))\\n    i = i + 1\\n  }\\n  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array())\\n}\\n\\n// Two field-name sets describe the same struct shape when they have equal\\n// length and every name in one appears in the other.\\nlet field_sets_match: (Array[String], Array[String]) -> Bool = (a, b) -> {\\n  if Array::length(a) != Array::length(b) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while i < Array::length(a) {\\n      if str_array_contains(b, Array::get(a, i)) {\\n        i = i + 1\\n      } else {\\n        ok = false\\n        i = Array::length(a)\\n      }\\n    }\\n    ok\\n  }\\n}\\n\\n// Is `name` a known struct (a key in struct_sets)? Gates the #672 `==` dispatch.\\nlet struct_set_has: (Array[(String, Array[String])], String) -> Bool = (struct_sets, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(struct_sets) {\\n    let (sname, _) = Array::get(struct_sets, i)\\n    if sname == name {\\n      found = true\\n      i = Array::length(struct_sets)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet lookup_var_type: (Array[(String, String)], String) -> Option[String] = (var_types, name) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(var_types) {\\n    let (vn, vt) = Array::get(var_types, i)\\n    if vn == name {\\n      result = Some(vt)\\n      i = Array::length(var_types)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// Best-effort syntactic inference of a call argument's concrete type, enough to\\n// pick the trait impl at a concrete call site. Consults `var_types` (locals\\n// bound to inferable values and parameters with concrete annotations). Returns\\n// None when the type is not determinable (the call is then left unrewritten).\\n// Resolve a (possibly qualified) constructor name to its enum/return type.\\n// Bare `Green` -> `Color` via fn_returns; qualified `Color::Green` first tries\\n// the whole name (no match) then the member `Green` confirming its enum equals\\n// the head — so `let a = Color::Green` seeds `a -> Color` for `==` dispatch.\\nlet ctor_enum_of_name: (Array[(String, String)], String) -> Option[String] = (fn_returns, name) -> {\\n  match fn_return_type(fn_returns, name) {\\n    Some(t) => Some(t),\\n    None => match split_qualified(name) {\\n      Some(parts) => {\\n        let (head, member) = parts\\n        match fn_return_type(fn_returns, member) {\\n          Some(en) => if en == head {\\n            Some(en)\\n          } else {\\n            None\\n          },\\n          None => None\\n        }\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\nlet infer_arg_type_name: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Option[String] = (arg, struct_sets, var_types, fn_returns) -> {\\n  match arg {\\n    EInt(_) => Some(\\\"Int\\\"),\\n    EBool(_) => Some(\\\"Bool\\\"),\\n    EString(_) => Some(\\\"String\\\"),\\n    EFloat(_) => Some(\\\"Double\\\"),\\n    // An array literal dispatches to an `impl [T] Trait for Array` witness\\n    // (#5 generic impls): its constructor is \\\"Array\\\" regardless of element type.\\n    EArray(_) => Some(\\\"Array\\\"),\\n    // A variable's recorded type, else a (possibly qualified) nullary\\n    // constructor's enum name (`Green`/`Color::Green` -> `Color`) so that a\\n    // `let a = Green` / `let a = Color::Green` binding resolves for `==`. The\\n    // builtin nullary `None` resolves to the structural shape \\\"Option\\\" so a\\n    // `let a = None; ... a == b` dispatches structurally (#695).\\n    EIdent(name, _) => if name == \\\"None\\\" {\\n      Some(\\\"Option\\\")\\n    } else {\\n      match lookup_var_type(var_types, name) {\\n        Some(t) => Some(t),\\n        None => ctor_enum_of_name(fn_returns, name)\\n      }\\n    },\\n    // A call-valued iterable (`for x in lazy_iter_arr([..])`) or data ctor\\n    // (`Sh::Circle(5)`): its type is the head of the callee's return type. The\\n    // builtin `Some`/`Ok`/`Err` constructors resolve to \\\"Option\\\"/\\\"Result\\\" so a\\n    // bare `==` on them dispatches structurally (#695).\\n    ECall(callee, _, _) => match callee {\\n      EIdent(\\\"Some\\\", _) => Some(\\\"Option\\\"),\\n      EIdent(\\\"Ok\\\", _) => Some(\\\"Result\\\"),\\n      EIdent(\\\"Err\\\", _) => Some(\\\"Result\\\"),\\n      EIdent(fname, _) => ctor_enum_of_name(fn_returns, fname),\\n      // `let x: T = e` is desugared to `((__asc: T) -> __asc)(e)` (ascribe_wrap);\\n      // recover the operand's type head from the annotation so an annotated\\n      // `let a: Option[Int] = None` records `a -> \\\"Option\\\"` for `==` dispatch.\\n      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {\\n        let (_, ann) = Array::get(params, 0)\\n        match ann {\\n          Some(TyName(n)) => Some(n),\\n          Some(TyApp(n, _)) => Some(n),\\n          _ => None\\n        }\\n      } else {\\n        None\\n      },\\n      _ => None\\n    },\\n    ERecord(fields) => {\\n      let names = empty_str_array()\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (fname, _) = Array::get(fields, i)\\n        Array::push(names, fname)\\n        i = i + 1\\n      }\\n      let mut j = 0\\n      let mut result = None\\n      while j < Array::length(struct_sets) {\\n        let (sname, sfields) = Array::get(struct_sets, j)\\n        if field_sets_match(names, sfields) {\\n          result = Some(sname)\\n          j = Array::length(struct_sets)\\n        } else {\\n          j = j + 1\\n        }\\n      }\\n      result\\n    },\\n    _ => None\\n  }\\n}\\n\\n// The hidden bounds threaded into a generic: (type-param, trait, receiver\\n// parameter index). Empty registry sentinel for arrays of these.\\nlet empty_threaded: () -> Array[(String, String, Int)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\", 0)\\n  ], 0, 0)\\n}\\n\\nlet empty_dict_binds: () -> Array[(String, String, String, Array[String])] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\", \\\"\\\", empty_str_array())\\n  ], 0, 0)\\n}\\n\\n// A function already carries a threaded dict parameter (idempotency guard\\n// against desugaring the same stmts twice while bounds are still present).\\nlet already_threaded: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {\\n  if Array::length(params) == 0 {\\n    false\\n  } else {\\n    let (pname, _) = Array::get(params, 0)\\n    String::starts_with(pname, \\\"__dict_\\\")\\n  }\\n}\\n\\n// Index of the first parameter whose annotation is exactly the type parameter\\n// `tp` (`x: T`). -1 when `T` does not appear directly as a parameter type.\\nlet find_recv_index: (Array[(String, Option[TypeExpr])], String) -> Int = (params, tp) -> {\\n  let mut i = 0\\n  let mut idx = -1\\n  while i < Array::length(params) {\\n    let (_, ann) = Array::get(params, i)\\n    match ann {\\n      Some(TyName(n)) => if n == tp {\\n        idx = i\\n        i = Array::length(params)\\n      } else {\\n        i = i + 1\\n      },\\n      _ => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  idx\\n}\\n\\n// Build the registry of top-level generics that need dictionary threading:\\n// each is a (function name, threaded-bounds) pair. A bound is threaded only\\n// when its trait is method-bearing and the type parameter appears directly as\\n// a parameter type.\\n// The type-constructor head of a qualified name (`Array::show2` -> \\\"Array\\\"),\\n// or \\\"\\\" if unqualified.\\nlet qualified_head: (String) -> String = (name) -> {\\n  match split_qualified(name) {\\n    Some(parts) => {\\n      let (head, _) = parts\\n      head\\n    },\\n    None => \\\"\\\"\\n  }\\n}\\n\\n// Type names of bounded generic impls (`impl [T: Bound] Trait for C`). Their\\n// methods (`C::m`) carry the bound `T` even though it appears nested in the\\n// receiver (`self: C[T]`), so they must be threaded a witness dict (the normal\\n// \\\"type param is a direct parameter\\\" rule misses them).\\nlet collect_generic_impl_types: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out = empty_str_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImpl(tparams, tbounds, _, type_name) => if Array::length(tparams) > 0 {\\n        let mut has_bound = false\\n        let mut bi = 0\\n        while bi < Array::length(tbounds) {\\n          let (_, bs) = Array::get(tbounds, bi)\\n          let mut bj = 0\\n          while bj < Array::length(bs) {\\n            if Array::get(bs, bj) != \\\"\\\" {\\n              has_bound = true\\n            } else {\\n              ()\\n            }\\n            bj = bj + 1\\n          }\\n          bi = bi + 1\\n        }\\n        if has_bound {\\n          Array::push(out, type_name)\\n        } else {\\n          ()\\n        }\\n      } else (),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet build_gens: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[String]) -> Array[(String, Array[(String, String, Int)])] = (stmts, traits, gimpl_types) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", empty_threaded())\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, fname, _, body) => match body {\\n        EFn(_, bounds, params, _, _, _) => if already_threaded(params) {\\n          ()\\n        } else {\\n          let threaded = empty_threaded()\\n          let mut bi = 0\\n          while bi < Array::length(bounds) {\\n            let (tp, trait_list) = Array::get(bounds, bi)\\n            let mut ti = 0\\n            while ti < Array::length(trait_list) {\\n              let tr = Array::get(trait_list, ti)\\n              match lookup_trait_sigs(traits, tr) {\\n                Some(_) => {\\n                  let ridx = find_recv_index(params, tp)\\n                  if ridx >= 0 {\\n                    Array::push(threaded, (tp, tr, ridx))\\n                  } else if str_array_contains(gimpl_types, qualified_head(fname)) {\\n                    // bounded generic-impl method: T is nested in `self: C[T]`,\\n                    // so there is no inferable receiver argument — the witness\\n                    // dict is supplied when C's witness is built. Thread with -1.\\n                    Array::push(threaded, (tp, tr, 0 - 1))\\n                  } else {\\n                    ()\\n                  }\\n                },\\n                None => ()\\n              }\\n              ti = ti + 1\\n            }\\n            bi = bi + 1\\n          }\\n          if Array::length(threaded) > 0 {\\n            Array::push(out, (fname, threaded))\\n          } else {\\n            ()\\n          }\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_gen: (Array[(String, Array[(String, String, Int)])], String) -> Option[Array[(String, String, Int)]] = (gens, name) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(gens) {\\n    let (gname, threaded) = Array::get(gens, i)\\n    if gname == name {\\n      result = Some(threaded)\\n      i = Array::length(gens)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// Find the dict parameter to dispatch a `head::member` call against, given the\\n// dict bindings in scope: the binding whose type-param is `head` and whose\\n// trait declares `member`.\\nlet find_dict_for_method: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, head, member) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(dict_binds) {\\n    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)\\n    if tp == head && str_array_contains(methods, member) {\\n      result = Some(dict_pname)\\n      i = Array::length(dict_binds)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// Find the in-scope dict parameter bound to type-param `tparam` for `trait_name`\\n// (used to forward a caller's own witness into a generic->generic call).\\nlet find_dict_for_trait: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, tparam, trait_name) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(dict_binds) {\\n    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)\\n    if tp == tparam && tr == trait_name {\\n      result = Some(dict_pname)\\n      i = Array::length(dict_binds)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// The first element of an array-literal receiver (for a bounded generic impl\\n// `impl [T: Bound] Trait for Array`, the element determines T's witness).\\nlet first_array_elem: (Expr) -> Option[Expr] = (e) -> {\\n  match e {\\n    EArray(elems) => if Array::length(elems) > 0 {\\n      Some(Array::get(elems, 0))\\n    } else None,\\n    _ => None\\n  }\\n}\\n\\n// Build the witness `ERecord` for a concrete type `cname` implementing\\n// `trait_name`. Codegen resolves it to the dict struct structurally by field\\n// names.\\n//\\n// For a plain impl each method field is the free function `C::method`. For a\\n// BOUNDED generic impl (`impl [T: Bound] Trait for C`) the method\\n// `C::method` was threaded to take its own `Bound` dictionary for the element\\n// type, so the field is instead a closure that supplies that nested dictionary:\\n//   { method: (__w) -> C::method(<element Bound dict>, __w) }\\n// The element dict is built recursively from the array literal's first element\\n// (`arg_expr`) — a dictionary-of-dictionaries (#5 Increment B). If the element\\n// type / dict cannot be determined the whole witness fails to build (returns\\n// None), so the call is left unrewritten (a loud arity error, never a silent\\n// miscompile).\\nlet rec build_concrete_dict: (String, String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[(String, String, Int)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String)], Expr) -> Option[Expr] = (cname, trait_name, traits, gens, struct_sets, var_types, fn_returns, arg_expr) -> {\\n  match lookup_trait_sigs(traits, trait_name) {\\n    Some(sigs) => {\\n      let mnames = method_names_of_sigs(sigs)\\n      let recfields = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut mi = 0\\n      let mut failed = false\\n      while mi < Array::length(mnames) {\\n        let m = Array::get(mnames, mi)\\n        let qm = String::concat(cname, String::concat(\\\"::\\\", m))\\n        if not(fn_exists(fn_returns, qm)) {\\n          // No `cname::m` free function exists — `cname` does not actually\\n          // implement `trait_name`. Refuse to fabricate a witness (which would\\n          // otherwise silently dispatch to a same-shaped function), so the call\\n          // is left unrewritten and fails loudly instead of miscompiling.\\n          failed = true\\n        } else {\\n        match lookup_gen(gens, qm) {\\n          Some(threaded) => {\\n            // `qm` is a bounded generic-impl method: supply its element dict(s).\\n            match first_array_elem(arg_expr) {\\n              Some(elem) => match infer_arg_type_name(elem, struct_sets, var_types, fn_returns) {\\n                Some(en) => {\\n                  let callargs = empty_expr_array()\\n                  let mut bi = 0\\n                  let mut subok = true\\n                  while bi < Array::length(threaded) {\\n                    let (_, btrait, _) = Array::get(threaded, bi)\\n                    match build_concrete_dict(en, btrait, traits, gens, struct_sets, var_types, fn_returns, elem) {\\n                      Some(sd) => Array::push(callargs, sd),\\n                      None => {\\n                        subok = false\\n                      }\\n                    }\\n                    bi = bi + 1\\n                  }\\n                  if subok {\\n                    Array::push(callargs, EIdent(\\\"__w\\\", -1))\\n                    let closure = EFn(empty_str_array(), Array::slice([\\n                      (\\\"\\\", empty_str_array())\\n                    ], 0, 0), Array::slice([\\n                      (\\\"__w\\\", None)\\n                    ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))\\n                    Array::push(recfields, (m, closure))\\n                  } else {\\n                    failed = true\\n                  }\\n                },\\n                None => {\\n                  failed = true\\n                }\\n              },\\n              None => {\\n                failed = true\\n              }\\n            }\\n          },\\n          None => Array::push(recfields, (m, EIdent(qm, -1)))\\n        }\\n        }\\n        mi = mi + 1\\n      }\\n      if failed {\\n        None\\n      } else {\\n        Some(ERecord(recfields))\\n      }\\n    },\\n    None => None\\n  }\\n}\\n\\n// Synthesize the witness dictionaries for a call to a transformed generic, or\\n// None when any receiver's witness cannot be determined (the call is then left\\n// unrewritten). Each bound is satisfied either by a concrete dict literal (the\\n// receiver type is syntactically known) or by forwarding the caller's own dict\\n// parameter (the receiver is a type parameter bound by the same trait in the\\n// enclosing generic — the generic->generic case).\\nlet synth_dicts: (Array[(String, String, Int)], Array[Expr], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, Array[(String, String, Int)])]) -> Option[Array[Expr]] = (threaded, orig_args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) -> {\\n  let dicts = empty_expr_array()\\n  let mut ok = true\\n  let mut bi = 0\\n  while bi < Array::length(threaded) {\\n    let (_, trait_name, recv_idx) = Array::get(threaded, bi)\\n    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {\\n      let recv_arg = Array::get(orig_args, recv_idx)\\n      match infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns) {\\n        Some(nm) => match find_dict_for_trait(dict_binds, nm, trait_name) {\\n          Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),\\n          None => match build_concrete_dict(nm, trait_name, traits, gens, struct_sets, var_types, fn_returns, recv_arg) {\\n            Some(dict) => Array::push(dicts, dict),\\n            None => {\\n              ok = false\\n            }\\n          }\\n        },\\n        None => {\\n          ok = false\\n        }\\n      }\\n    } else {\\n      ok = false\\n    }\\n    bi = bi + 1\\n  }\\n  if ok {\\n    Some(dicts)\\n  } else {\\n    None\\n  }\\n}\\n\\nlet concat_expr_arrays: (Array[Expr], Array[Expr]) -> Array[Expr] = (a, b) -> {\\n  let out = empty_expr_array()\\n  let mut i = 0\\n  while i < Array::length(a) {\\n    Array::push(out, Array::get(a, i))\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(b) {\\n    Array::push(out, Array::get(b, j))\\n    j = j + 1\\n  }\\n  out\\n}\\n\\n// Seed a var-type environment from a function's parameters whose annotation is\\n// a bare type name `T` — concrete (`Point`) for call-site dict synthesis, or a\\n// type parameter (`T`) for generic->generic dict forwarding. The distinction is\\n// made at use time against the in-scope dict bindings. `tparams` is retained for\\n// signature compatibility but no longer filters (both kinds are tracked).\\nlet seed_var_types: (Array[(String, Option[TypeExpr])], Array[String], Array[(String, String)]) -> Array[(String, String)] = (params, tparams, base) -> {\\n  let _ = tparams\\n  let out = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  let mut b = 0\\n  while b < Array::length(base) {\\n    Array::push(out, Array::get(base, b))\\n    b = b + 1\\n  }\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, ann) = Array::get(params, i)\\n    match ann {\\n      Some(TyName(tn)) => Array::push(out, (pname, tn)),\\n      // A generic struct annotation `x: LazyIter[T]` -> track the head name so\\n      // `for x in <param>` over a generic iterator type resolves (#636).\\n      Some(TyApp(tn, _)) => Array::push(out, (pname, tn)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Collect the return-type name of every top-level `let f = (..) -> R { .. }`\\n// (R only when it is a bare type name), so the `for` desugar can tell an\\n// iterator (`C::next` exists) from an iterable (`C::iter` returns an iterator).\\nlet collect_fn_returns: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, fname, _, body) => match body {\\n        EFn(_, _, _, ret, _, _) => {\\n          // Record the head name of the return type: `TyName(n)` -> n,\\n          // `TyApp(n, _)` -> n (so a generic `iter() -> LazyIter[T]` resolves to\\n          // `LazyIter`, and an async `next() -> Future[Option[..]]` resolves to\\n          // `Future` so the `for await` desugar can tell async from sync).\\n          let rn = match ret {\\n            Some(te) => match te {\\n              TyName(n) => n,\\n              TyApp(n, _) => n,\\n              _ => \\\"\\\"\\n            },\\n            None => \\\"\\\"\\n          }\\n          Array::push(out, (fname, rn))\\n        },\\n        _ => ()\\n      },\\n      // #672: map each enum variant constructor to its enum name, so a\\n      // `let t = Node(...)` binding resolves `t`'s type for the `==` dispatch\\n      // (infer_arg_type_name reads ctor calls through fn_returns).\\n      SEnum(_, ename, _, variants, _) => {\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, _) = Array::get(variants, vi)\\n          Array::push(out, (vname, ename))\\n          vi = vi + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet fn_exists: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(fn_returns) {\\n    let (n, _) = Array::get(fn_returns, i)\\n    if n == fname {\\n      found = true\\n      i = Array::length(fn_returns)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet fn_return_type: (Array[(String, String)], String) -> Option[String] = (fn_returns, fname) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(fn_returns) {\\n    let (n, rt) = Array::get(fn_returns, i)\\n    if n == fname {\\n      result = if String::length(rt) == 0 {\\n        None\\n      } else Some(rt)\\n      i = Array::length(fn_returns)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\n// Desugar `for x in it { body }` over a struct iterator type `C` into a loop\\n// driven by the functional `C::next(self) -> Option[(T, Self)]`:\\n//\\n//   let mut __iter_cur = it\\n//   let mut __iter_go = true\\n//   while __iter_go {\\n//     match C::next(__iter_cur) {\\n//       Some((x, __iter_rest)) => { __iter_cur = __iter_rest; body },\\n//       None => { __iter_go = false }\\n//     }\\n//   }\\n//\\n// Nested loops shadow the `__iter_*` names correctly (ELetMut scoping). The\\n// optional index binding is not supported for iterators (first slice).\\n//\\n// `nextcall` is the expression yielding `Option[(T, Self)]` for the current\\n// cursor `__iter_cur`: a bare `C::next(__iter_cur)` for a sync iterator, or\\n// `await(C::next(__iter_cur))` (a `Future[Option[(T, Self)]]` unwrapped) for an\\n// async iterator under `for await`.\\nlet build_iter_for_with: (String, Expr, Expr, Expr) -> Expr = (name, nextcall, iter, body) -> {\\n  let some_arm = (PCtor(\\\"Some\\\", [\\n    PTuple([\\n      PBind(name),\\n      PBind(\\\"__iter_rest\\\")\\n    ])\\n  ]), EAssign(\\\"__iter_cur\\\", EIdent(\\\"__iter_rest\\\", -1), body))\\n  let none_arm = (PCtor(\\\"None\\\", Array::slice([\\n    PWild\\n  ], 0, 0)), EAssign(\\\"__iter_go\\\", EBool(false), EUnit))\\n  let loop_body = EMatch(nextcall, [\\n    some_arm,\\n    none_arm\\n  ])\\n  // Bind the iterand through an immutable `__iter_src` and initialize the\\n  // mutable cursor from that ident, rather than from `iter` directly. The\\n  // cursor is consumed by `C::next(__iter_cur)` and then reassigned each\\n  // iteration; initializing it from a fresh heap value (e.g. a struct literal\\n  // `for x in Range::{..}`) made that consume-then-reassign double-free the\\n  // initial value under RC. Seeding from a stable binding mirrors the working\\n  // `let r = ..; for x in r` shape so the ownership accounting balances (#704).\\n  ELet(\\\"__iter_src\\\", iter, ELetMut(\\\"__iter_cur\\\", EIdent(\\\"__iter_src\\\", -1), ELetMut(\\\"__iter_go\\\", EBool(true), EWhile(EIdent(\\\"__iter_go\\\", -1), loop_body))))\\n}\\n\\nlet next_call_for: (String) -> Expr = (ctype) -> {\\n  ECall(EIdent(String::concat(ctype, \\\"::next\\\"), -1), [\\n    EIdent(\\\"__iter_cur\\\", -1)\\n  ], -1)\\n}\\n\\nlet build_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {\\n  build_iter_for_with(name, next_call_for(ctype), iter, body)\\n}\\n\\n// `for await` over an async iterator type `C` whose\\n// `C::next(self) -> Future[Option[(T, Self)]] with { Async }`: identical to the\\n// sync loop but each step `await`s the next-future. `await` is the M1a builtin\\n// (`await(Future[T]) -> T`); on the synchronous ready-future codegen it unwraps\\n// in place, so this also runs on the linear backend today.\\nlet build_await_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {\\n  let awaited = ECall(EIdent(\\\"await\\\", -1), [\\n    next_call_for(ctype)\\n  ], -1)\\n  build_iter_for_with(name, awaited, iter, body)\\n}\\n\\n// `for await x in pull { body }` over a pull closure `pull : () -> Option[T]`\\n// (host-state async iterator, e.g. `stdin_stream`): drive `pull()` to `None`.\\n// This is the M2c-3 pull model, moved here from the parser so `for await` shares\\n// one type-directed desugar with the trait iterators (a struct `C` with a\\n// `C::next` drives the iterator loop above; anything else — a pull closure or a\\n// call whose return type is unknown — falls back to this).\\nlet build_pull_for_in: (String, Option[String], Expr, Expr) -> Expr = (value_name, index_name, iterable, body) -> {\\n  let some_arm = match index_name {\\n    Some(ix) => ESeq(body, EAssign(ix, EBinOp(\\\"+\\\", EIdent(ix, -1), EInt(1)), EUnit)),\\n    None => ESeq(body, EUnit)\\n  }\\n  let loop_body = EMatch(ECall(EIdent(\\\"__pull_next\\\", -1), Array::slice([\\n    EUnit\\n  ], 0, 0), -1), [\\n    (PCtor(\\\"Some\\\", [\\n      PBind(value_name)\\n    ]), some_arm),\\n    (PCtor(\\\"None\\\", Array::slice([\\n      PWild\\n    ], 0, 0)), EAssign(\\\"__pull_continue\\\", EBool(false), EUnit))\\n  ])\\n  let core_loop = ELetMut(\\\"__pull_continue\\\", EBool(true), EWhile(EIdent(\\\"__pull_continue\\\", -1), loop_body))\\n  let with_index = match index_name {\\n    Some(ix) => ELetMut(ix, EInt(0), core_loop),\\n    None => core_loop\\n  }\\n  ELet(\\\"__pull_next\\\", iterable, with_index)\\n}\\n\\n// Unwrap a `for await` marker: the parser wraps the iterable of a `for await`\\n// loop in `__await_iter(<iterable>)` (a non-builtin sentinel call) so this pass\\n// — which has type information the parser lacks — picks the iterator vs pull\\n// desugar. Returns the inner iterable when `iter` is the marker.\\nlet for_await_inner: (Expr) -> Option[Expr] = (iter) -> {\\n  match iter {\\n    ECall(callee, args, _) => match callee {\\n      EIdent(nm, _) => if nm == \\\"__await_iter\\\" && Array::length(args) == 1 {\\n        Some(Array::get(args, 0))\\n      } else {\\n        None\\n      },\\n      _ => None\\n    },\\n    _ => None\\n  }\\n}\\n\\n// Does `fname`'s recorded return-type head indicate an async iterator\\n// (`next() -> Future[Option[..]]`)? Drives the `await`-wrapped loop choice.\\nlet fn_return_is_future: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {\\n  match fn_return_type(fn_returns, fname) {\\n    Some(head) => head == \\\"Future\\\",\\n    None => false\\n  }\\n}\\n\\n// `for await x in inner { body }`: classify `inner` and build the loop.\\n// `rinner` / `rbody` are the already-rewritten iterable / body. A struct type\\n// with a `::next` drives the iterator loop (`await`-wrapped when async);\\n// anything else drives the pull-closure loop.\\nlet classify_for_await_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns) -> {\\n  match infer_arg_type_name(inner, struct_sets, var_types, fn_returns) {\\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \\\"::next\\\")) {\\n      if fn_return_is_future(fn_returns, String::concat(tn, \\\"::next\\\")) {\\n        build_await_iter_for(name, tn, rinner, rbody)\\n      } else {\\n        build_iter_for(name, tn, rinner, rbody)\\n      }\\n    } else {\\n      build_pull_for_in(name, idx, rinner, rbody)\\n    },\\n    None => build_pull_for_in(name, idx, rinner, rbody)\\n  }\\n}\\n\\n// `for x in iter { body }`: iterator (`::next`) / iterable (`::iter`) / array\\n// classification. `riter` / `rbody` are already rewritten.\\nlet classify_sync_for_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns) -> {\\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \\\"::next\\\")) {\\n      build_iter_for(name, tn, riter, rbody)\\n    } else {\\n      match fn_return_type(fn_returns, String::concat(tn, \\\"::iter\\\")) {\\n        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, \\\"::iter\\\"), -1), [\\n          riter\\n        ], -1), rbody),\\n        None => EForIn(name, idx, riter, rbody)\\n      }\\n    },\\n    None => EForIn(name, idx, riter, rbody)\\n  }\\n}\\n\\n// Extend the local var-type environment with `name` when its bound value's\\n// type was inferable. A fresh array (copy) is returned so sibling scopes do not\\n// see the binding.\\nlet extend_var_types: (Array[(String, String)], String, Option[String]) -> Array[(String, String)] = (var_types, name, inferred) -> {\\n  match inferred {\\n    Some(tname) => {\\n      let out = Array::slice([\\n        (\\\"\\\", \\\"\\\")\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(var_types) {\\n        Array::push(out, Array::get(var_types, i))\\n        i = i + 1\\n      }\\n      Array::push(out, (name, tname))\\n      out\\n    },\\n    None => var_types\\n  }\\n}\\n\\n// #672: a qualified constructor `Enum::Variant` -> the unqualified variant\\n// `Variant`, when `member` is a constructor of enum `head` (variants are bound\\n// unqualified, and codegen's ctor table is keyed unqualified). `head` MUST be a\\n// known user enum/struct (`struct_sets` includes enum names) — this is the gate\\n// that keeps builtin qualified calls like `String::join` / `Array::map` alone\\n// even when a same-named function (`join`/`map`) happens to return that type.\\nlet qual_ctor_member: (String, String, Array[(String, Array[String])], Array[(String, String)]) -> Option[String] = (head, member, struct_sets, fn_returns) -> {\\n  if struct_set_has(struct_sets, head) {\\n    match fn_return_type(fn_returns, member) {\\n      Some(en) => if en == head {\\n        Some(member)\\n      } else {\\n        None\\n      },\\n      None => None\\n    }\\n  } else {\\n    None\\n  }\\n}\\n\\n// #635: classify a call as a railway-bind/op sentinel. Returns\\n//   0 = `__try_bind(val, (name) -> rest)` (callee `__try_bind`, 2 args, arg1\\n//       a 1-param closure),\\n//   1 = `__try_op(val)` (callee `__try_op`, exactly 1 arg),\\n//   2 = not a sentinel (ordinary call; e.g. a user fn that happens to share the\\n//       name but with a different arity/shape).\\nlet try_sentinel: (Expr, Array[Expr]) -> Int = (callee, args) -> {\\n  match callee {\\n    EIdent(n, _) => if n == \\\"__try_bind\\\" {\\n      if Array::length(args) == 2 {\\n        match Array::get(args, 1) {\\n          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {\\n            0\\n          } else {\\n            2\\n          },\\n          _ => 2\\n        }\\n      } else {\\n        2\\n      }\\n    } else if n == \\\"__try_op\\\" {\\n      if Array::length(args) == 1 {\\n        1\\n      } else {\\n        2\\n      }\\n    } else {\\n      2\\n    },\\n    _ => 2\\n  }\\n}\\n\\n// #635: lower the `let* name = val <rest>` sentinel by `val`'s head type.\\n// Option -> `match val { Some(name) => rest, None => None }`; else (Result, or\\n// undeterminable -> default Result, today's behavior) the railway Result match\\n// `match val { Ok(name) => rest, Err(__bind_err) => Err(__bind_err) }`.\\nlet lower_try_bind: (Expr, String, Expr, Option[String]) -> Expr = (val, name, rest, inferred) -> {\\n  match inferred {\\n    Some(tn) => if tn == \\\"Option\\\" {\\n      EMatch(val, [\\n        (PCtor(\\\"Some\\\", [\\n          PBind(name)\\n        ]), rest),\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), EIdent(\\\"None\\\", -1))\\n      ])\\n    } else {\\n      EMatch(val, [\\n        (PCtor(\\\"Ok\\\", [\\n          PBind(name)\\n        ]), rest),\\n        (PCtor(\\\"Err\\\", [\\n          PBind(\\\"__bind_err\\\")\\n        ]), ECall(EIdent(\\\"Err\\\", -1), [\\n          EIdent(\\\"__bind_err\\\", -1)\\n        ], -1))\\n      ])\\n    },\\n    None => EMatch(val, [\\n      (PCtor(\\\"Ok\\\", [\\n        PBind(name)\\n      ]), rest),\\n      (PCtor(\\\"Err\\\", [\\n        PBind(\\\"__bind_err\\\")\\n      ]), ECall(EIdent(\\\"Err\\\", -1), [\\n        EIdent(\\\"__bind_err\\\", -1)\\n      ], -1))\\n    ])\\n  }\\n}\\n\\n// #635: lower the `val?` sentinel by `val`'s head type. Option -> yield the\\n// inner value on `Some`, early-`return None` on `None`. Else (Result, or\\n// undeterminable -> default Result) -> yield on `Ok`, early-`return Err(e)` on\\n// `Err`. Uses `EReturn`, so the enclosing function short-circuits.\\nlet lower_try_op: (Expr, Option[String]) -> Expr = (val, inferred) -> {\\n  match inferred {\\n    Some(tn) => if tn == \\\"Option\\\" {\\n      EMatch(val, [\\n        (PCtor(\\\"Some\\\", [\\n          PBind(\\\"__try_v\\\")\\n        ]), EIdent(\\\"__try_v\\\", -1)),\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), EReturn(EIdent(\\\"None\\\", -1)))\\n      ])\\n    } else {\\n      EMatch(val, [\\n        (PCtor(\\\"Ok\\\", [\\n          PBind(\\\"__try_v\\\")\\n        ]), EIdent(\\\"__try_v\\\", -1)),\\n        (PCtor(\\\"Err\\\", [\\n          PBind(\\\"__try_e\\\")\\n        ]), EReturn(ECall(EIdent(\\\"Err\\\", -1), [\\n          EIdent(\\\"__try_e\\\", -1)\\n        ], -1)))\\n      ])\\n    },\\n    None => EMatch(val, [\\n      (PCtor(\\\"Ok\\\", [\\n        PBind(\\\"__try_v\\\")\\n      ]), EIdent(\\\"__try_v\\\", -1)),\\n      (PCtor(\\\"Err\\\", [\\n        PBind(\\\"__try_e\\\")\\n      ]), EReturn(ECall(EIdent(\\\"Err\\\", -1), [\\n        EIdent(\\\"__try_e\\\", -1)\\n      ], -1)))\\n    ])\\n  }\\n}\\n\\n// #635: standalone railway-sentinel lowering. Walks an expr and rewrites only\\n// the `__try_bind`/`__try_op` sentinels (everything else is recursed\\n// structurally unchanged), type-directing each by `infer_arg_type_name`. Runs\\n// from BOTH the checker (`check_program`, where the heavy dict-passing pass does\\n// NOT run) and — idempotently — the codegen `desugar_trait_dicts`. It is inert\\n// for programs that use no `let*`/`?` (no sentinels present). `var_types` tracks\\n// locals so `let* x = some_opt` then `let* y = uses(x)` resolves x's type.\\nlet rec railway_rw: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, struct_sets, var_types, fn_returns) -> {\\n  match expr {\\n    ECall(callee, args, off) => {\\n      let k = try_sentinel(callee, args)\\n      if k == 0 {\\n        let val = Array::get(args, 0)\\n        match Array::get(args, 1) {\\n          EFn(_, _, ps, _, _, rest) => {\\n            let (name, _) = Array::get(ps, 0)\\n            let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\\n            let body_vars = extend_var_types(var_types, name, inferred)\\n            let rwrest = railway_rw(rest, struct_sets, body_vars, fn_returns)\\n            lower_try_bind(rwval, name, rwrest, inferred)\\n          },\\n          _ => EUnit\\n        }\\n      } else if k == 1 {\\n        let val = Array::get(args, 0)\\n        let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      } else {\\n        ECall(railway_rw(callee, struct_sets, var_types, fn_returns), for a in args {\\n          railway_rw(a, struct_sets, var_types, fn_returns)\\n        }, off)\\n      }\\n    },\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EUnit => expr,\\n    ESpread(e) => ESpread(railway_rw(e, struct_sets, var_types, fn_returns)),\\n    EStringInterp(_) => expr,\\n    EIdent(_, _) => expr,\\n    ETuple(elems) => ETuple(for e in elems {\\n      railway_rw(e, struct_sets, var_types, fn_returns)\\n    }),\\n    EArray(elems) => EArray(for e in elems {\\n      railway_rw(e, struct_sets, var_types, fn_returns)\\n    }),\\n    ERecord(fields) => {\\n      let out = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (fname, fval) = Array::get(fields, i)\\n        Array::push(out, (fname, railway_rw(fval, struct_sets, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      ERecord(out)\\n    },\\n    EMap(fields) => {\\n      let out = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (k, v) = Array::get(fields, i)\\n        Array::push(out, (k, railway_rw(v, struct_sets, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EMap(out)\\n    },\\n    EIf(c, t, e) => EIf(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(t, struct_sets, var_types, fn_returns), railway_rw(e, struct_sets, var_types, fn_returns)),\\n    ELet(name, val, body) => {\\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      ELet(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns))\\n    },\\n    ELetRec(name, val, body) => ELetRec(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\\n    ELetMut(name, val, body) => {\\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      ELetMut(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns))\\n    },\\n    EAssign(name, val, cont) => EAssign(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\\n    ESeq(a, b) => ESeq(railway_rw(a, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\\n    EMatch(scrut, arms) => {\\n      let out = Array::slice([\\n        (PWild, EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, b) = Array::get(arms, i)\\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EMatch(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\\n    },\\n    EHandle(scrut, arms) => {\\n      let out = Array::slice([\\n        (PWild, EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, b) = Array::get(arms, i)\\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EHandle(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\\n    },\\n    EWhile(c, b) => EWhile(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\\n    ELoop(params, body) => ELoop(for param in params {\\n      let (name, init) = param\\n      (name, railway_rw(init, struct_sets, var_types, fn_returns))\\n    }, railway_rw(body, struct_sets, var_types, fn_returns)),\\n    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(iter, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\\n    EBinOp(op, l, r) => EBinOp(op, railway_rw(l, struct_sets, var_types, fn_returns), railway_rw(r, struct_sets, var_types, fn_returns)),\\n    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(e, struct_sets, var_types, fn_returns)),\\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(body, struct_sets, seed_var_types(ps, tp, var_types), fn_returns)),\\n    EDot(obj, field, off) => EDot(railway_rw(obj, struct_sets, var_types, fn_returns), field, off),\\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(body, struct_sets, var_types, fn_returns)),\\n    EThrow(e) => EThrow(railway_rw(e, struct_sets, var_types, fn_returns)),\\n    EReturn(e) => EReturn(railway_rw(e, struct_sets, var_types, fn_returns)),\\n    EBreak(opt) => match opt {\\n      Some(e) => EBreak(Some(railway_rw(e, struct_sets, var_types, fn_returns))),\\n      None => expr\\n    },\\n    EContinue(exprs) => EContinue(for e in exprs {\\n      railway_rw(e, struct_sets, var_types, fn_returns)\\n    })\\n  }\\n}\\n\\n// #635: lower the `let*`/`?` sentinels across a whole program. In-place,\\n// idempotent (a second run finds no sentinels), and inert for programs that use\\n// neither. Exported so the checker path can lower before type-checking.\\nlet rec railway_rw_stmt: (Stmt, Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (s, struct_sets, fn_returns) -> {\\n  let no_vars = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  match s {\\n    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(body, struct_sets, no_vars, fn_returns)),\\n    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(e, struct_sets, no_vars, fn_returns)),\\n    STest(name, body) => STest(name, railway_rw(body, struct_sets, no_vars, fn_returns)),\\n    SBench(name, body) => SBench(name, railway_rw(body, struct_sets, no_vars, fn_returns)),\\n    SExpr(e) => SExpr(railway_rw(e, struct_sets, no_vars, fn_returns)),\\n    SModule(exp, name, body) => SModule(exp, name, for inner in body {\\n      railway_rw_stmt(inner, struct_sets, fn_returns)\\n    }),\\n    _ => s\\n  }\\n}\\n\\nexport let desugar_railway_binds: (Array[Stmt]) -> Unit = (stmts) -> {\\n  let struct_sets = collect_struct_field_sets(stmts)\\n  let fn_returns = collect_fn_returns(stmts)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::set(stmts, i, railway_rw_stmt(Array::get(stmts, i), struct_sets, fn_returns))\\n    i = i + 1\\n  }\\n}\\n\\n// The core rewriter. `dict_binds` is non-empty only inside a transformed\\n// generic's body (so `T::method` resolves to a dict field); call-site dict\\n// threading applies everywhere a transformed generic is called. `var_types`\\n// tracks locals/params whose concrete type is known, for call-site dict\\n// synthesis when the receiver is a variable.\\nlet rec rewrite_expr: (Expr, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, gens, traits, struct_sets, dict_binds, var_types, fn_returns) -> {\\n  match expr {\\n    EIdent(name, off) => match split_qualified(name) {\\n      Some(parts) => {\\n        let (head, member) = parts\\n        match find_dict_for_method(dict_binds, head, member) {\\n          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1),\\n          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {\\n            Some(m) => EIdent(m, off),\\n            None => expr\\n          }\\n        }\\n      },\\n      None => expr\\n    },\\n    ECall(callee, args, off) => {\\n      // #635: type-directed lowering of the railway sentinels emitted by the\\n      // parser. `__try_bind(val, (x) -> rest)` and `__try_op(val)` carry no type\\n      // info from the parser; here `infer_arg_type_name(val)` picks Option vs\\n      // Result (default Result when undeterminable — today's behavior). A user\\n      // function literally named `__try_bind`/`__try_op` with the wrong shape\\n      // (handled by `try_sentinel` returning None) takes the generic path.\\n      let try_kind = try_sentinel(callee, args)\\n      if try_kind == 0 {\\n        // __try_bind(val, (name) -> rest)\\n        let val = Array::get(args, 0)\\n        match Array::get(args, 1) {\\n          EFn(_, _, ps, _, _, rest) => {\\n            let (name, _) = Array::get(ps, 0)\\n            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\\n            let body_vars = extend_var_types(var_types, name, inferred)\\n            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)\\n            lower_try_bind(rwval, name, rwrest, inferred)\\n          },\\n          _ => EUnit\\n        }\\n      } else if try_kind == 1 {\\n        // __try_op(val)\\n        let val = Array::get(args, 0)\\n        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      } else {\\n      let rwargs = for a in args {\\n        rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      }\\n      match callee {\\n        EIdent(name0, coff) => {\\n          // #672: unqualify a qualified constructor call `Enum::Variant(..)` ->\\n          // `Variant(..)` so codegen's (unqualified) ctor table recognizes it.\\n          let name = match split_qualified(name0) {\\n            Some(parts0) => {\\n              let (h0, m0) = parts0\\n              match qual_ctor_member(h0, m0, struct_sets, fn_returns) {\\n                Some(mm) => mm,\\n                None => name0\\n              }\\n            },\\n            None => name0\\n          }\\n          // `T::method(args)` inside a transformed body -> `(dict.method)(args)`.\\n          let as_method = match split_qualified(name) {\\n            Some(parts) => {\\n              let (head, member) = parts\\n              find_dict_for_method(dict_binds, head, member)\\n            },\\n            None => None\\n          }\\n          match as_method {\\n            Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1), rwargs, off),\\n            None => match lookup_gen(gens, name) {\\n              Some(threaded) => match synth_dicts(threaded, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {\\n                Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),\\n                None => ECall(EIdent(name, coff), rwargs, off)\\n              },\\n              None => ECall(EIdent(name, coff), rwargs, off)\\n            }\\n          }\\n        },\\n        EDot(obj, m, doff) => ECall(EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), m, doff), rwargs, off),\\n        _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)\\n      }\\n      }\\n    },\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EUnit => expr,\\n    ESpread(_) => expr,\\n    EStringInterp(_) => expr,\\n    ETuple(elems) => ETuple(for e in elems {\\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n    }),\\n    EArray(elems) => EArray(for e in elems {\\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n    }),\\n    ERecord(fields) => {\\n      let out = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (fname, fval) = Array::get(fields, i)\\n        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      ERecord(out)\\n    },\\n    EMap(fields) => {\\n      let out = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (k, v) = Array::get(fields, i)\\n        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EMap(out)\\n    },\\n    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    ELet(name, val, body) => {\\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))\\n    },\\n    ELetRec(name, val, body) => ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    ELetMut(name, val, body) => {\\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))\\n    },\\n    EAssign(name, val, cont) => EAssign(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EMatch(scrut, arms) => {\\n      let out = Array::slice([\\n        (PWild, EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, b) = Array::get(arms, i)\\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\\n    },\\n    EHandle(scrut, arms) => {\\n      let out = Array::slice([\\n        (PWild, EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, b) = Array::get(arms, i)\\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\\n    },\\n    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    ELoop(params, body) => ELoop(for param in params {\\n      let (name, init) = param\\n      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))\\n    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EForIn(name, idx, iter, body) => {\\n      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      // `for await x in s` (#636 unification): the parser wraps `s` in an\\n      // `__await_iter` marker; classify_for_await_loop picks iterator vs pull\\n      // loop by type. It runs regardless of whether a trait is declared, since\\n      // `for await` predates the trait machinery. A plain `for x in e` is\\n      // iterator/iterable/array-classified only when a method-bearing trait is\\n      // present (without one there are no `impl ::next` methods to dispatch), so\\n      // trait-free programs' `for` loops are untouched.\\n      match for_await_inner(iter) {\\n        Some(inner) => {\\n          let rinner = rewrite_expr(inner, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n          classify_for_await_loop(name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns)\\n        },\\n        None => {\\n          let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n          if Array::length(traits) == 0 {\\n            EForIn(name, idx, riter, rbody)\\n          } else {\\n            classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\\n          }\\n        }\\n      }\\n    },\\n    EBinOp(op, l, r) => {\\n      let rl = rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      let rr = rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      // #672: dispatch `a == b` / `a != b` on a struct type to the generated\\n      // structural `T::equals`. The operand's type is resolved best-effort via\\n      // `infer_arg_type_name` (var_types for variables, field-set match for\\n      // struct literals); a struct type whose `equals` we generated is rewritten\\n      // to a call. Non-struct / unresolved operands keep the scalar binop.\\n      if op == \\\"==\\\" || op == \\\"!=\\\" {\\n        // #695: an empty array LITERAL on either side reduces `==` to a length\\n        // check on the other operand (an array equals `[]` iff its length is 0),\\n        // which is exact and needs no element type. This also covers `[] == []`,\\n        // whose element type is otherwise undeterminable.\\n        let empty_l = is_empty_array_lit(l)\\n        let empty_r = is_empty_array_lit(r)\\n        // #695: a bare array `==` (operand is an array literal whose element type\\n        // is statically determinable) dispatches to the monomorphic\\n        // `__arr_equals__<key>` helper (emitted by desugar_derives), since the\\n        // runtime `eq` would identity-compare the array. Opaque array-typed\\n        // operands (no literal in scope) are left as `==` (documented residual).\\n        let arr_elem = match infer_earray_elem_type(l) {\\n          Some(t) => Some(t),\\n          None => infer_earray_elem_type(r)\\n        }\\n        if empty_l || empty_r {\\n          let other = if empty_l {\\n            rr\\n          } else {\\n            rl\\n          }\\n          let lencmp = EBinOp(\\\"==\\\", ECall(EIdent(\\\"Array::length\\\", -1), [\\n            other\\n          ], -1), EInt(0))\\n          if op == \\\"==\\\" {\\n            lencmp\\n          } else {\\n            ECall(EIdent(\\\"not\\\", -1), [\\n              lencmp\\n            ], -1)\\n          }\\n        } else {\\n        match arr_elem {\\n          Some(elem) => {\\n            let call = ECall(EIdent(arr_equals_name(elem), -1), [\\n              rl,\\n              rr\\n            ], -1)\\n            if op == \\\"==\\\" {\\n              call\\n            } else {\\n              ECall(EIdent(\\\"not\\\", -1), [\\n                call\\n              ], -1)\\n            }\\n          },\\n          None => {\\n            let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\\n              Some(t) => Some(t),\\n              None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)\\n            }\\n            match ty {\\n              Some(t) => if struct_set_has(struct_sets, t) {\\n                let call = ECall(EIdent(String::concat(t, \\\"::equals\\\"), -1), [\\n                  rl,\\n                  rr\\n                ], -1)\\n                if op == \\\"==\\\" {\\n                  call\\n                } else {\\n                  ECall(EIdent(\\\"not\\\", -1), [\\n                    call\\n                  ], -1)\\n                }\\n              } else if t == \\\"Option\\\" {\\n                // Bare `==` on Option-typed operands (e.g. `let a = None; a == b`)\\n                // dispatches to a structural match; the runtime would otherwise\\n                // identity-compare the heap-allocated nullary `None`. Payloads\\n                // compare with `==` — correct for scalar payloads (the common\\n                // case); an aggregate-payload bare-Option variable is a #695\\n                // residual (route it through a struct field for full recursion).\\n                let eqm = opt_eq_match(rl, rr)\\n                if op == \\\"==\\\" {\\n                  eqm\\n                } else {\\n                  ECall(EIdent(\\\"not\\\", -1), [\\n                    eqm\\n                  ], -1)\\n                }\\n              } else if t == \\\"Result\\\" {\\n                let eqm = result_eq_match(rl, rr)\\n                if op == \\\"==\\\" {\\n                  eqm\\n                } else {\\n                  ECall(EIdent(\\\"not\\\", -1), [\\n                    eqm\\n                  ], -1)\\n                }\\n              } else {\\n                EBinOp(op, rl, rr)\\n              },\\n              None => EBinOp(op, rl, rr)\\n            }\\n          }\\n        }\\n        }\\n      } else {\\n        EBinOp(op, rl, rr)\\n      }\\n    },\\n    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)),\\n    EDot(obj, field, off) => EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), field, off),\\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EThrow(e) => EThrow(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EBreak(opt) => match opt {\\n      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),\\n      None => expr\\n    },\\n    EContinue(exprs) => EContinue(for e in exprs {\\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n    })\\n  }\\n}\\n\\n// Extract the member of a qualified `Head::member` name (the part after `::`).\\nlet member_of: (String) -> String = (name) -> {\\n  match split_qualified(name) {\\n    Some(parts) => {\\n      let (_, member) = parts\\n      member\\n    },\\n    None => name\\n  }\\n}\\n\\n// Build the dict bindings in scope for a transformed generic's body.\\nlet dict_binds_of: (Array[(String, String, Int)], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] = (threaded, traits) -> {\\n  let out = empty_dict_binds()\\n  let mut i = 0\\n  while i < Array::length(threaded) {\\n    let (tp, trait_name, _) = Array::get(threaded, i)\\n    let methods = match lookup_trait_sigs(traits, trait_name) {\\n      Some(sigs) => method_names_of_sigs(sigs),\\n      None => empty_str_array()\\n    }\\n    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Prepend the hidden dict parameters to a transformed generic's parameter list.\\nlet thread_dict_params: (Array[(String, String, Int)], Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (threaded, params) -> {\\n  let result = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(threaded) {\\n    let (tp, trait_name, _) = Array::get(threaded, i)\\n    let dty = TyApp(dict_struct_name(trait_name), [\\n      TyName(tp)\\n    ])\\n    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(params) {\\n    Array::push(result, Array::get(params, j))\\n    j = j + 1\\n  }\\n  result\\n}\\n\\nlet rewrite_stmt: (Stmt, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (stmt, gens, traits, struct_sets, fn_returns) -> {\\n  let no_binds = empty_dict_binds()\\n  let no_vars = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  match stmt {\\n    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {\\n      Some(threaded) => match body {\\n        EFn(tparams, bounds, params, ret, eff, fbody) => {\\n          let binds = dict_binds_of(threaded, traits)\\n          let new_params = thread_dict_params(threaded, params)\\n          let seeded = seed_var_types(params, tparams, no_vars)\\n          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)\\n          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))\\n        },\\n        _ => stmt\\n      },\\n      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns))\\n    },\\n    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\\n    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\\n    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\\n    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\\n    SModule(exp, name, body) => SModule(exp, name, for s in body {\\n      rewrite_stmt(s, gens, traits, struct_sets, fn_returns)\\n    }),\\n    _ => stmt\\n  }\\n}\\n\\n// ---- derive(...) structural function generation (#638) ----\\n//\\n// For a `struct P { x; y } derive(Show, Ord)` this generates the structural\\n// free functions `P::to_string` and `P::compare` (concrete `Type::method`,\\n// resolved by the PR-1 dispatch path). `Eq` stays a no-op marker (structural\\n// `==` is a runtime builtin). Hash / Default and enums are deferred slices.\\n\\nlet qualified_name: (String, String) -> String = (tname, method) -> {\\n  String::concat(tname, String::concat(\\\"::\\\", method))\\n}\\n\\nlet top_level_fn_exists: (Array[Stmt], String) -> Bool = (stmts, fname) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, _, _) => if name == fname {\\n        found = true\\n        i = Array::length(stmts)\\n      } else {\\n        i = i + 1\\n      },\\n      _ => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  found\\n}\\n\\nlet concat2: (Expr, Expr) -> Expr = (a, b) -> {\\n  ECall(EIdent(\\\"String::concat\\\", -1), [\\n    a,\\n    b\\n  ], -1)\\n}\\n\\n// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array\\n// to-string helper `__arr_to_string__<key>` so distinct element types get\\n// distinct helpers. `Int` -> \\\"Int\\\", `Array[Int]` -> \\\"Array_Int\\\",\\n// `Option[Int]` -> \\\"Option_Int\\\", `(Int,Bool)` -> \\\"Tup_Int_Bool\\\", else \\\"Any\\\".\\n// (#694: mirrors #672/#695-era helper-naming so Layer-2 recursion into\\n// `Array[t]` fields produces a structural — not pointer-heuristic — string.)\\nlet rec ts_type_key: (TypeExpr) -> String = (ty) -> {\\n  match ty {\\n    TyName(n) => n,\\n    TyApp(n, args) => {\\n      let mut s = n\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        s = String::concat(s, String::concat(\\\"_\\\", ts_type_key(Array::get(args, i))))\\n        i = i + 1\\n      }\\n      s\\n    },\\n    TyTuple(ts) => {\\n      let mut s = \\\"Tup\\\"\\n      let mut i = 0\\n      while i < Array::length(ts) {\\n        s = String::concat(s, String::concat(\\\"_\\\", ts_type_key(Array::get(ts, i))))\\n        i = i + 1\\n      }\\n      s\\n    },\\n    TyUnit => \\\"Unit\\\",\\n    _ => \\\"Any\\\"\\n  }\\n}\\n\\n// The generated monomorphic array-to-string helper name for element type `t`.\\nlet arr_to_string_name: (TypeExpr) -> String = (t) -> {\\n  String::concat(\\\"__arr_to_string__\\\", ts_type_key(t))\\n}\\n\\n// Produce a String expression for a value `val` whose declared type is `fty`.\\n// Fully type-directed and recursive (#694 Layer 2):\\n//   - `String` -> verbatim\\n//   - scalar `TyName` -> `__to_string(val)`\\n//   - declared struct/enum `TyName(n)` (`known_types`) -> `n::to_string(val)`\\n//   - `Option[t]` -> `match val { Some(x) => \\\"Some(\\\" ++ show(x) ++ \\\")\\\", None => \\\"None\\\" }`\\n//   - `Result[t,e]` -> `Ok(..)` / `Err(..)` structural match\\n//   - tuple `(t0,..,tn)` -> `\\\"(\\\" ++ show(t0) ++ \\\", \\\" ++ .. ++ \\\")\\\"`\\n//   - `Array[t]` -> a call to the monomorphic `__arr_to_string__<key>` helper\\n//   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::to_string(val)`\\n//   - anything else -> `__to_string(val)` (status-quo pointer/scalar heuristic)\\n// The structural `Type::to_string` (and the derived `Type::hash_key` that\\n// delegates to it) is therefore stable for two distinct-but-equal aggregates,\\n// no matter how deeply nested.\\nlet rec show_for_typed: (TypeExpr, Expr, Array[String]) -> Expr = (fty, val, known_types) -> {\\n  match fty {\\n    TyName(\\\"String\\\") => val,\\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"to_string\\\"), -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    TyApp(\\\"Option\\\", args) => if Array::length(args) == 1 {\\n      let t = Array::get(args, 0)\\n      let inner = show_for_typed(t, EIdent(\\\"__os_v\\\", -1), known_types)\\n      let some_body = concat2(EString(\\\"Some(\\\"), concat2(inner, EString(\\\")\\\")))\\n      EMatch(val, Array::slice([\\n        (PCtor(\\\"Some\\\", Array::slice([\\n          PBind(\\\"__os_v\\\")\\n        ], 0, 1)), some_body),\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), EString(\\\"None\\\"))\\n      ], 0, 2))\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    TyApp(\\\"Result\\\", args) => if Array::length(args) == 2 {\\n      let t = Array::get(args, 0)\\n      let e = Array::get(args, 1)\\n      let ok_inner = show_for_typed(t, EIdent(\\\"__rs_v\\\", -1), known_types)\\n      let err_inner = show_for_typed(e, EIdent(\\\"__rs_v\\\", -1), known_types)\\n      let ok_body = concat2(EString(\\\"Ok(\\\"), concat2(ok_inner, EString(\\\")\\\")))\\n      let err_body = concat2(EString(\\\"Err(\\\"), concat2(err_inner, EString(\\\")\\\")))\\n      EMatch(val, Array::slice([\\n        (PCtor(\\\"Ok\\\", Array::slice([\\n          PBind(\\\"__rs_v\\\")\\n        ], 0, 1)), ok_body),\\n        (PCtor(\\\"Err\\\", Array::slice([\\n          PBind(\\\"__rs_v\\\")\\n        ], 0, 1)), err_body)\\n      ], 0, 2))\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    TyTuple(ts) => {\\n      let n = Array::length(ts)\\n      let pats = Array::slice([\\n        PWild\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < n {\\n        Array::push(pats, PBind(String::concat(\\\"__ts_t\\\", idx_str(i))))\\n        i = i + 1\\n      }\\n      let segs = empty_expr_array()\\n      Array::push(segs, EString(\\\"(\\\"))\\n      let mut k = 0\\n      while k < n {\\n        if k > 0 {\\n          Array::push(segs, EString(\\\", \\\"))\\n        } else {\\n          ()\\n        }\\n        Array::push(segs, show_for_typed(Array::get(ts, k), EIdent(String::concat(\\\"__ts_t\\\", idx_str(k)), -1), known_types))\\n        k = k + 1\\n      }\\n      Array::push(segs, EString(\\\")\\\"))\\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\\n      let mut j = Array::length(segs) - 2\\n      while j >= 0 {\\n        acc = concat2(Array::get(segs, j), acc)\\n        j = j - 1\\n      }\\n      EMatch(val, Array::slice([\\n        (PTuple(pats), acc)\\n      ], 0, 1))\\n    },\\n    TyApp(\\\"Array\\\", args) => if Array::length(args) == 1 {\\n      ECall(EIdent(arr_to_string_name(Array::get(args, 0)), -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    TyApp(n, _) => if str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"to_string\\\"), -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    _ => ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n      val\\n    ], 0, 1), -1)\\n  }\\n}\\n\\n// Show a single struct field value as a String expression, by its declared type\\n// (#694: type-directed and recursive — aggregate fields recurse structurally\\n// instead of falling into the `__to_string` pointer heuristic).\\nlet field_show_expr: (String, TypeExpr, Array[String]) -> Expr = (fname, fty, known_types) -> {\\n  show_for_typed(fty, EDot(EIdent(\\\"self\\\", -1), fname, -1), known_types)\\n}\\n\\n// `let __arr_to_string__<key> = (a: Array[t]) -> String {\\n//    \\\"[\\\" ++ join(show(a[0]), \\\", \\\", show(a[1]), ...) ++ \\\"]\\\" }` — a monomorphic,\\n// fully-recursive array to-string. Element rendering goes through\\n// `show_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse structurally\\n// instead of pointer-stringifying aggregate elements. (#694 Layer 2.)\\nlet gen_arr_to_string_fn: (TypeExpr, Array[String]) -> Stmt = (elem_ty, known_types) -> {\\n  let elem_get = ECall(EIdent(\\\"Array::get\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1),\\n    EIdent(\\\"__as_i\\\", -1)\\n  ], 0, 2), -1)\\n  let elem_show = show_for_typed(elem_ty, elem_get, known_types)\\n  // `__as_acc = __as_acc ++ (if i == 0 { \\\"\\\" } else { \\\", \\\" }) ++ show(a[i])`\\n  let sep = EIf(EBinOp(\\\"==\\\", EIdent(\\\"__as_i\\\", -1), EInt(0)), EString(\\\"\\\"), EString(\\\", \\\"))\\n  let append = concat2(concat2(EIdent(\\\"__as_acc\\\", -1), sep), elem_show)\\n  let set_acc = EAssign(\\\"__as_acc\\\", append, EUnit)\\n  let incr = EAssign(\\\"__as_i\\\", EBinOp(\\\"+\\\", EIdent(\\\"__as_i\\\", -1), EInt(1)), EUnit)\\n  let loop_body = ESeq(set_acc, incr)\\n  let while_loop = EWhile(EBinOp(\\\"<\\\", EIdent(\\\"__as_i\\\", -1), ECall(EIdent(\\\"Array::length\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1)\\n  ], 0, 1), -1)), loop_body)\\n  let closed = concat2(EIdent(\\\"__as_acc\\\", -1), EString(\\\"]\\\"))\\n  let body = ELetMut(\\\"__as_i\\\", EInt(0), ELetMut(\\\"__as_acc\\\", EString(\\\"[\\\"), ESeq(while_loop, closed)))\\n  let arr_ty = TyApp(\\\"Array\\\", Array::slice([\\n    elem_ty\\n  ], 0, 1))\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(arr_ty))\\n  ], 0, 1)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, arr_to_string_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"String\\\")), None, body))\\n}\\n\\n// `let P::to_string = (self: P) -> String { \\\"P { x: \\\" ++ show(x) ++ \\\", ... }\\\" }`\\nlet gen_show_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\\n  let segs = empty_expr_array()\\n  Array::push(segs, EString(String::concat(tname, \\\" { \\\")))\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (fname, fty) = Array::get(fields, i)\\n    let sep = if i == 0 {\\n      \\\"\\\"\\n    } else \\\", \\\"\\n    Array::push(segs, EString(String::concat(sep, String::concat(fname, \\\": \\\"))))\\n    Array::push(segs, field_show_expr(fname, fty, known_types))\\n    i = i + 1\\n  }\\n  Array::push(segs, EString(\\\" }\\\"))\\n  // fold right: concat(seg0, concat(seg1, ... segN))\\n  let mut body = Array::get(segs, Array::length(segs) - 1)\\n  let mut j = Array::length(segs) - 2\\n  while j >= 0 {\\n    body = concat2(Array::get(segs, j), body)\\n    j = j - 1\\n  }\\n  let params = Array::slice([\\n    (\\\"self\\\", Some(TyName(tname)))\\n  ], 0, 1)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"to_string\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"String\\\")), None, body))\\n}\\n\\n// A type name that the runtime compares as a flat scalar (no structural\\n// `equals` needed). Everything else named is a user struct/enum and recurses\\n// through its generated `T::equals`.\\nlet is_scalar_type_name: (String) -> Bool = (n) -> {\\n  n == \\\"Int\\\" || n == \\\"Double\\\" || n == \\\"Bool\\\" || n == \\\"String\\\" || n == \\\"Char\\\" || n == \\\"Unit\\\" || n == \\\"Bytes\\\"\\n}\\n\\n// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array\\n// helper `__arr_equals__<key>` so distinct element types get distinct helpers.\\n// `Int` -> \\\"Int\\\", `Array[Int]` -> \\\"Array_Int\\\", `Option[Int]` -> \\\"Option_Int\\\",\\n// `(Int,Bool)` -> \\\"Tup_Int_Bool\\\", unknown shapes -> \\\"Any\\\".\\nlet rec type_key: (TypeExpr) -> String = (ty) -> {\\n  match ty {\\n    TyName(n) => n,\\n    TyApp(n, args) => {\\n      let mut s = n\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        s = String::concat(s, String::concat(\\\"_\\\", type_key(Array::get(args, i))))\\n        i = i + 1\\n      }\\n      s\\n    },\\n    TyTuple(ts) => {\\n      let mut s = \\\"Tup\\\"\\n      let mut i = 0\\n      while i < Array::length(ts) {\\n        s = String::concat(s, String::concat(\\\"_\\\", type_key(Array::get(ts, i))))\\n        i = i + 1\\n      }\\n      s\\n    },\\n    TyUnit => \\\"Unit\\\",\\n    _ => \\\"Any\\\"\\n  }\\n}\\n\\n// The generated monomorphic array-equality helper name for element type `t`.\\nlet arr_equals_name: (TypeExpr) -> String = (t) -> {\\n  String::concat(\\\"__arr_equals__\\\", type_key(t))\\n}\\n\\n// Structural equality match for two Option operands whose element type is NOT\\n// statically known here (bare `==` dispatch on Option-typed variables). Some\\n// payloads compare with `==` (correct for scalars); a None matches a None.\\n// (#695.)\\nlet opt_eq_match: (Expr, Expr) -> Expr = (lhs, rhs) -> {\\n  let some_inner = EMatch(rhs, Array::slice([\\n    (PCtor(\\\"Some\\\", Array::slice([\\n      PBind(\\\"__oeq_r\\\")\\n    ], 0, 1)), EBinOp(\\\"==\\\", EIdent(\\\"__oeq_l\\\", -1), EIdent(\\\"__oeq_r\\\", -1))),\\n    (PWild, EBool(false))\\n  ], 0, 2))\\n  let none_inner = EMatch(rhs, Array::slice([\\n    (PCtor(\\\"None\\\", Array::slice([\\n      PWild\\n    ], 0, 0)), EBool(true)),\\n    (PWild, EBool(false))\\n  ], 0, 2))\\n  EMatch(lhs, Array::slice([\\n    (PCtor(\\\"Some\\\", Array::slice([\\n      PBind(\\\"__oeq_l\\\")\\n    ], 0, 1)), some_inner),\\n    (PCtor(\\\"None\\\", Array::slice([\\n      PWild\\n    ], 0, 0)), none_inner)\\n  ], 0, 2))\\n}\\n\\n// Structural equality match for two Result operands of statically-unknown\\n// element types (bare `==` dispatch). (#695.)\\nlet result_eq_match: (Expr, Expr) -> Expr = (lhs, rhs) -> {\\n  let ok_inner = EMatch(rhs, Array::slice([\\n    (PCtor(\\\"Ok\\\", Array::slice([\\n      PBind(\\\"__req_r\\\")\\n    ], 0, 1)), EBinOp(\\\"==\\\", EIdent(\\\"__req_l\\\", -1), EIdent(\\\"__req_r\\\", -1))),\\n    (PWild, EBool(false))\\n  ], 0, 2))\\n  let err_inner = EMatch(rhs, Array::slice([\\n    (PCtor(\\\"Err\\\", Array::slice([\\n      PBind(\\\"__req_r\\\")\\n    ], 0, 1)), EBinOp(\\\"==\\\", EIdent(\\\"__req_l\\\", -1), EIdent(\\\"__req_r\\\", -1))),\\n    (PWild, EBool(false))\\n  ], 0, 2))\\n  EMatch(lhs, Array::slice([\\n    (PCtor(\\\"Ok\\\", Array::slice([\\n      PBind(\\\"__req_l\\\")\\n    ], 0, 1)), ok_inner),\\n    (PCtor(\\\"Err\\\", Array::slice([\\n      PBind(\\\"__req_l\\\")\\n    ], 0, 1)), err_inner)\\n  ], 0, 2))\\n}\\n\\n// Equality of two operands whose declared type is `fty`. Fully type-directed:\\n//   - scalar `TyName` -> raw `==`\\n//   - declared struct/enum `TyName(n)` -> `n::equals(lhs, rhs)`\\n//   - `Option[t]` / `Result[t,e]` -> inline `match` recursing on payloads\\n//   - `(t0,..,tn)` tuple -> inline `match` over `PTuple`, conjoining element eqs\\n//   - `Array[t]` -> a call to the monomorphic `__arr_equals__<key>` helper\\n//   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::equals(lhs, rhs)`\\n//   - anything else -> raw `==` (status quo fallback)\\n// The runtime `eq` builtin is type-blind (it identity-compares aggregates), so\\n// structural equality MUST be resolved here at the AST level where the static\\n// type is known. (#695.)\\nlet rec eq_for_typed: (TypeExpr, Expr, Expr, Array[String]) -> Expr = (fty, lhs, rhs, known_types) -> {\\n  match fty {\\n    TyName(n) => if n == \\\"Double\\\" || n == \\\"Float\\\" {\\n      // Under RC a Double is a BOXED heap value, so a raw `==` between two\\n      // Double fields compares box identity (always false) instead of the f64\\n      // payload. Wrap each operand in the identity `Double::to_float` so the\\n      // `==` codegen recognizes the operands as floatish (expr_is_floatish) and\\n      // takes the unbox-then-f64.eq path. Harmless on the non-RC backend, where\\n      // the wrapper is identity and the float branch compares raw bits (#704).\\n      EBinOp(\\\"==\\\", ECall(EIdent(\\\"Double::to_float\\\", -1), Array::slice([\\n        lhs\\n      ], 0, 1), -1), ECall(EIdent(\\\"Double::to_float\\\", -1), Array::slice([\\n        rhs\\n      ], 0, 1), -1))\\n    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"equals\\\"), -1), Array::slice([\\n        lhs,\\n        rhs\\n      ], 0, 2), -1)\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    TyApp(\\\"Option\\\", args) => if Array::length(args) == 1 {\\n      let t = Array::get(args, 0)\\n      let inner_eq = eq_for_typed(t, EIdent(\\\"__oeq_l\\\", -1), EIdent(\\\"__oeq_r\\\", -1), known_types)\\n      let some_inner = EMatch(rhs, Array::slice([\\n        (PCtor(\\\"Some\\\", Array::slice([\\n          PBind(\\\"__oeq_r\\\")\\n        ], 0, 1)), inner_eq),\\n        (PWild, EBool(false))\\n      ], 0, 2))\\n      let none_inner = EMatch(rhs, Array::slice([\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), EBool(true)),\\n        (PWild, EBool(false))\\n      ], 0, 2))\\n      EMatch(lhs, Array::slice([\\n        (PCtor(\\\"Some\\\", Array::slice([\\n          PBind(\\\"__oeq_l\\\")\\n        ], 0, 1)), some_inner),\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), none_inner)\\n      ], 0, 2))\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    TyApp(\\\"Result\\\", args) => if Array::length(args) == 2 {\\n      let t = Array::get(args, 0)\\n      let e = Array::get(args, 1)\\n      let ok_eq = eq_for_typed(t, EIdent(\\\"__req_l\\\", -1), EIdent(\\\"__req_r\\\", -1), known_types)\\n      let err_eq = eq_for_typed(e, EIdent(\\\"__req_l\\\", -1), EIdent(\\\"__req_r\\\", -1), known_types)\\n      let ok_inner = EMatch(rhs, Array::slice([\\n        (PCtor(\\\"Ok\\\", Array::slice([\\n          PBind(\\\"__req_r\\\")\\n        ], 0, 1)), ok_eq),\\n        (PWild, EBool(false))\\n      ], 0, 2))\\n      let err_inner = EMatch(rhs, Array::slice([\\n        (PCtor(\\\"Err\\\", Array::slice([\\n          PBind(\\\"__req_r\\\")\\n        ], 0, 1)), err_eq),\\n        (PWild, EBool(false))\\n      ], 0, 2))\\n      EMatch(lhs, Array::slice([\\n        (PCtor(\\\"Ok\\\", Array::slice([\\n          PBind(\\\"__req_l\\\")\\n        ], 0, 1)), ok_inner),\\n        (PCtor(\\\"Err\\\", Array::slice([\\n          PBind(\\\"__req_l\\\")\\n        ], 0, 1)), err_inner)\\n      ], 0, 2))\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    TyTuple(ts) => {\\n      let n = Array::length(ts)\\n      let lpats = Array::slice([\\n        PWild\\n      ], 0, 0)\\n      let rpats = Array::slice([\\n        PWild\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < n {\\n        Array::push(lpats, PBind(String::concat(\\\"__teq_l\\\", idx_str(i))))\\n        Array::push(rpats, PBind(String::concat(\\\"__teq_r\\\", idx_str(i))))\\n        i = i + 1\\n      }\\n      let mut conj = EBool(true)\\n      let mut j = n - 1\\n      while j >= 0 {\\n        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat(\\\"__teq_l\\\", idx_str(j)), -1), EIdent(String::concat(\\\"__teq_r\\\", idx_str(j)), -1), known_types)\\n        conj = EBinOp(\\\"&&\\\", cmp, conj)\\n        j = j - 1\\n      }\\n      let inner = EMatch(rhs, Array::slice([\\n        (PTuple(rpats), conj)\\n      ], 0, 1))\\n      EMatch(lhs, Array::slice([\\n        (PTuple(lpats), inner)\\n      ], 0, 1))\\n    },\\n    TyApp(\\\"Array\\\", args) => if Array::length(args) == 1 {\\n      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([\\n        lhs,\\n        rhs\\n      ], 0, 2), -1)\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    TyApp(n, _) => if str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"equals\\\"), -1), Array::slice([\\n        lhs,\\n        rhs\\n      ], 0, 2), -1)\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    _ => EBinOp(\\\"==\\\", lhs, rhs)\\n  }\\n}\\n\\n// `let __arr_equals__<key> = (a: Array[t], b: Array[t]) -> Bool { ... }` — a\\n// monomorphic, fully-recursive array structural equality. Element compare goes\\n// through `eq_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse\\n// correctly instead of identity-comparing aggregate elements. (#695.)\\nlet gen_arr_equals_fn: (TypeExpr, Array[String]) -> Stmt = (elem_ty, known_types) -> {\\n  let len_a = ECall(EIdent(\\\"Array::length\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1)\\n  ], 0, 1), -1)\\n  let len_b = ECall(EIdent(\\\"Array::length\\\", -1), Array::slice([\\n    EIdent(\\\"b\\\", -1)\\n  ], 0, 1), -1)\\n  let elem_a = ECall(EIdent(\\\"Array::get\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1),\\n    EIdent(\\\"__ae_i\\\", -1)\\n  ], 0, 2), -1)\\n  let elem_b = ECall(EIdent(\\\"Array::get\\\", -1), Array::slice([\\n    EIdent(\\\"b\\\", -1),\\n    EIdent(\\\"__ae_i\\\", -1)\\n  ], 0, 2), -1)\\n  let elem_eq = eq_for_typed(elem_ty, elem_a, elem_b, known_types)\\n  let not_eq = ECall(EIdent(\\\"not\\\", -1), Array::slice([\\n    elem_eq\\n  ], 0, 1), -1)\\n  let set_false = EIf(not_eq, EAssign(\\\"__ae_ok\\\", EBool(false), EUnit), EUnit)\\n  let incr = EAssign(\\\"__ae_i\\\", EBinOp(\\\"+\\\", EIdent(\\\"__ae_i\\\", -1), EInt(1)), EUnit)\\n  let loop_body = ESeq(set_false, incr)\\n  let while_loop = EWhile(EBinOp(\\\"<\\\", EIdent(\\\"__ae_i\\\", -1), ECall(EIdent(\\\"Array::length\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1)\\n  ], 0, 1), -1)), loop_body)\\n  let body_eq = ELetMut(\\\"__ae_i\\\", EInt(0), ELetMut(\\\"__ae_ok\\\", EBool(true), ESeq(while_loop, EIdent(\\\"__ae_ok\\\", -1))))\\n  let body = EIf(EBinOp(\\\"!=\\\", len_a, len_b), EBool(false), body_eq)\\n  let arr_ty = TyApp(\\\"Array\\\", Array::slice([\\n    elem_ty\\n  ], 0, 1))\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(arr_ty)),\\n    (\\\"b\\\", Some(arr_ty))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, arr_equals_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Bool\\\")), None, body))\\n}\\n\\n// One field's equality expression: `a.f == b.f` for scalar/param fields, or a\\n// direct `FieldType::equals(a.f, b.f)` for aggregate (declared struct/enum)\\n// fields so nested/recursive structs compare structurally. (#672 recursion.)\\nlet field_eq_expr: (String, TypeExpr, Array[String]) -> Expr = (fname, fty, known_types) -> {\\n  eq_for_typed(fty, EDot(EIdent(\\\"a\\\", -1), fname, -1), EDot(EIdent(\\\"b\\\", -1), fname, -1), known_types)\\n}\\n\\n// `let P::equals = (a: P, b: P) -> Bool { a.x == b.x && a.y == b.y && ... }`\\n// Mirrors gen_compare_fn. Primitive fields compare with `==`; aggregate fields\\n// recurse through the field type's generated `equals`. An empty struct is `true`.\\nlet gen_eq_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\\n  let mut body = EBool(true)\\n  let mut i = Array::length(fields) - 1\\n  while i >= 0 {\\n    let (fname, fty) = Array::get(fields, i)\\n    body = EBinOp(\\\"&&\\\", field_eq_expr(fname, fty, known_types), body)\\n    i = i - 1\\n  }\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(TyName(tname))),\\n    (\\\"b\\\", Some(TyName(tname)))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"equals\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Bool\\\")), None, body))\\n}\\n\\n// Small non-negative Int -> decimal String (Int::to_string is not in scope in\\n// this module). Used only to make unique enum-field binder names.\\nlet digit_str: (Int) -> String = (d) -> {\\n  if d == 0 {\\n    \\\"0\\\"\\n  } else if d == 1 {\\n    \\\"1\\\"\\n  } else if d == 2 {\\n    \\\"2\\\"\\n  } else if d == 3 {\\n    \\\"3\\\"\\n  } else if d == 4 {\\n    \\\"4\\\"\\n  } else if d == 5 {\\n    \\\"5\\\"\\n  } else if d == 6 {\\n    \\\"6\\\"\\n  } else if d == 7 {\\n    \\\"7\\\"\\n  } else if d == 8 {\\n    \\\"8\\\"\\n  } else {\\n    \\\"9\\\"\\n  }\\n}\\n\\nlet rec idx_str: (Int) -> String = (n) -> {\\n  if n < 10 {\\n    digit_str(n)\\n  } else {\\n    String::concat(idx_str(n / 10), digit_str(n % 10))\\n  }\\n}\\n\\n// `let E::equals = (a: E, b: E) -> Bool {\\n//    match a {\\n//      V1(_a0, _a1) => match b { V1(_b0, _b1) => _a0 == _b0 && _a1 == _b1, _ => false },\\n//      V2          => match b { V2 => true, _ => false }, ... } }`\\n// Tag mismatch falls to the inner `_ => false`; payload `==` is itself\\n// dispatched, so aggregate payloads recurse into their own `equals`.\\nlet gen_enum_eq_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\\n  let outer_arms = Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n  let mut vi = 0\\n  while vi < Array::length(variants) {\\n    let (vname, ftypes) = Array::get(variants, vi)\\n    let nf = Array::length(ftypes)\\n    let abinds = Array::slice([\\n      PWild\\n    ], 0, 0)\\n    let bbinds = Array::slice([\\n      PWild\\n    ], 0, 0)\\n    let mut fi = 0\\n    while fi < nf {\\n      Array::push(abinds, PBind(String::concat(\\\"__a\\\", idx_str(fi))))\\n      Array::push(bbinds, PBind(String::concat(\\\"__b\\\", idx_str(fi))))\\n      fi = fi + 1\\n    }\\n    let mut body = EBool(true)\\n    let mut bi = nf - 1\\n    while bi >= 0 {\\n      let cmp = eq_for_typed(Array::get(ftypes, bi), EIdent(String::concat(\\\"__a\\\", idx_str(bi)), -1), EIdent(String::concat(\\\"__b\\\", idx_str(bi)), -1), known_types)\\n      body = EBinOp(\\\"&&\\\", cmp, body)\\n      bi = bi - 1\\n    }\\n    let inner_arms = Array::slice([\\n      (PCtor(vname, bbinds), body),\\n      (PWild, EBool(false))\\n    ], 0, 2)\\n    let inner = EMatch(EIdent(\\\"b\\\", -1), inner_arms)\\n    Array::push(outer_arms, (PCtor(vname, abinds), inner))\\n    vi = vi + 1\\n  }\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(TyName(ename))),\\n    (\\\"b\\\", Some(TyName(ename)))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(ename, \\\"equals\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Bool\\\")), None, EMatch(EIdent(\\\"a\\\", -1), outer_arms)))\\n}\\n\\n// `let P::compare = (a: P, b: P) -> Int { lexicographic over fields -> -1/0/1 }`\\nlet gen_compare_fn: (String, Array[(String, TypeExpr)]) -> Stmt = (tname, fields) -> {\\n  let neg_one = 0 - 1\\n  let mut body = EInt(0)\\n  let mut i = Array::length(fields) - 1\\n  while i >= 0 {\\n    let (fname, _) = Array::get(fields, i)\\n    let af = EDot(EIdent(\\\"a\\\", -1), fname, -1)\\n    let bf = EDot(EIdent(\\\"b\\\", -1), fname, -1)\\n    body = EIf(EBinOp(\\\"<\\\", af, bf), EInt(neg_one), EIf(EBinOp(\\\">\\\", af, bf), EInt(1), body))\\n    i = i - 1\\n  }\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(TyName(tname))),\\n    (\\\"b\\\", Some(TyName(tname)))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"compare\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Int\\\")), None, body))\\n}\\n\\n// Show an arbitrary value expression by its declared type (#694: type-directed\\n// and recursive via `show_for_typed`, so aggregate enum payloads — nested\\n// struct/enum, Option, Result, tuple, Array — render structurally instead of\\n// through the `__to_string` pointer heuristic).\\nlet show_expr_typed: (Expr, TypeExpr, Array[String]) -> Expr = (val, fty, known_types) -> {\\n  show_for_typed(fty, val, known_types)\\n}\\n\\n// `let E::to_string = (self: E) -> String {\\n//    match self { V0(_a0, _a1) => \\\"V0(\\\" ++ show(_a0) ++ \\\", \\\" ++ show(_a1) ++ \\\")\\\",\\n//                 V1 => \\\"V1\\\", ... } }`\\n// A nullary variant shows as its bare name; a payload variant shows as\\n// `Name(p0, p1, ...)` with each payload shown structurally.\\nlet gen_enum_show_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\\n  let arms = Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n  let mut vi = 0\\n  while vi < Array::length(variants) {\\n    let (vname, ftypes) = Array::get(variants, vi)\\n    let nf = Array::length(ftypes)\\n    let binds = Array::slice([\\n      PWild\\n    ], 0, 0)\\n    let mut fi = 0\\n    while fi < nf {\\n      Array::push(binds, PBind(String::concat(\\\"__s\\\", idx_str(fi))))\\n      fi = fi + 1\\n    }\\n    let body = if nf == 0 {\\n      EString(vname)\\n    } else {\\n      let segs = empty_expr_array()\\n      Array::push(segs, EString(String::concat(vname, \\\"(\\\")))\\n      let mut si = 0\\n      while si < nf {\\n        let sep = if si == 0 {\\n          \\\"\\\"\\n        } else \\\", \\\"\\n        if sep != \\\"\\\" {\\n          Array::push(segs, EString(sep))\\n        } else {\\n          ()\\n        }\\n        Array::push(segs, show_expr_typed(EIdent(String::concat(\\\"__s\\\", idx_str(si)), -1), Array::get(ftypes, si), known_types))\\n        si = si + 1\\n      }\\n      Array::push(segs, EString(\\\")\\\"))\\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\\n      let mut j = Array::length(segs) - 2\\n      while j >= 0 {\\n        acc = concat2(Array::get(segs, j), acc)\\n        j = j - 1\\n      }\\n      acc\\n    }\\n    Array::push(arms, (PCtor(vname, binds), body))\\n    vi = vi + 1\\n  }\\n  let params = Array::slice([\\n    (\\\"self\\\", Some(TyName(ename)))\\n  ], 0, 1)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(ename, \\\"to_string\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"String\\\")), None, EMatch(EIdent(\\\"self\\\", -1), arms)))\\n}\\n\\n// `let T::hash_key = (self: T) -> String { T::to_string(self) }` (#694 Layer 1).\\n// `derive(Hash)` makes a type usable as a Map key via the method-bearing `Hash`\\n// trait (`hash_key(Self) -> String`): `map_key_to_string = [K: Hash](key) ->\\n// K::hash_key(key)` threads the witness (#684), and at a concrete call site\\n// `get_by(m, T::{..})` the synthesized `HashDict::{ hash_key: T::hash_key }`\\n// resolves here. The key is the structural `to_string` (now fully recursive via\\n// `show_for_typed`), so two distinct-but-field-equal values hash to one entry.\\nlet gen_hash_key_fn: (String) -> Stmt = (tname) -> {\\n  let body = ECall(EIdent(qualified_name(tname, \\\"to_string\\\"), -1), Array::slice([\\n    EIdent(\\\"self\\\", -1)\\n  ], 0, 1), -1)\\n  let params = Array::slice([\\n    (\\\"self\\\", Some(TyName(tname)))\\n  ], 0, 1)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"hash_key\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"String\\\")), None, body))\\n}\\n\\n// Append any `Array[e]` element types referenced by a TypeExpr to `acc`\\n// (dedup by type-key), so a Show/Hash-deriving type with an `Array[t]` field or\\n// payload gets a generated `__arr_to_string__<key>` helper. (#694 Layer 2.)\\nlet collect_show_array_elems: (TypeExpr, Array[TypeExpr], Array[String]) -> Unit = (ty, acc, keys) -> {\\n  match ty {\\n    TyApp(\\\"Array\\\", args) => if Array::length(args) == 1 {\\n      let et = Array::get(args, 0)\\n      let k = ts_type_key(et)\\n      if str_array_contains(keys, k) {\\n        ()\\n      } else {\\n        Array::push(keys, k)\\n        Array::push(acc, et)\\n      }\\n    } else {\\n      ()\\n    },\\n    _ => ()\\n  }\\n}\\n\\n// Compare two operands of declared type `fty`, returning -1/0/1. Aggregate\\n// (declared struct/enum) operands recurse through `T::compare`; scalars and type\\n// parameters use the runtime structural `<` / `>` (codegen handles them).\\nlet compare_for_typed: (TypeExpr, Expr, Expr, Array[String]) -> Expr = (fty, lhs, rhs, known_types) -> {\\n  let neg_one = 0 - 1\\n  match fty {\\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"compare\\\"), -1), Array::slice([\\n        lhs,\\n        rhs\\n      ], 0, 2), -1)\\n    } else {\\n      EIf(EBinOp(\\\"<\\\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\\\">\\\", lhs, rhs), EInt(1), EInt(0)))\\n    },\\n    _ => EIf(EBinOp(\\\"<\\\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\\\">\\\", lhs, rhs), EInt(1), EInt(0)))\\n  }\\n}\\n\\n// `let E::compare = (a: E, b: E) -> Int { ... }`\\n// Lexicographic: first by variant order (a's tag index vs b's tag index), then\\n// (same variant) by payload, recursively. The variant index of `a` is computed\\n// by matching `a`; for each `a` variant the inner match on `b` either compares\\n// payloads (same variant) or returns the sign of (a_index - b_index).\\nlet gen_enum_compare_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\\n  let neg_one = 0 - 1\\n  let outer_arms = Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n  let mut ai = 0\\n  while ai < Array::length(variants) {\\n    let (avname, aftypes) = Array::get(variants, ai)\\n    let anf = Array::length(aftypes)\\n    let abinds = Array::slice([\\n      PWild\\n    ], 0, 0)\\n    let mut afi = 0\\n    while afi < anf {\\n      Array::push(abinds, PBind(String::concat(\\\"__a\\\", idx_str(afi))))\\n      afi = afi + 1\\n    }\\n    // inner match over b: for the same variant compare payloads; otherwise the\\n    // sign comes from the variant order (a before b -> -1, after -> 1).\\n    let inner_arms = Array::slice([\\n      (PWild, EUnit)\\n    ], 0, 0)\\n    let mut bi = 0\\n    while bi < Array::length(variants) {\\n      let (bvname, bftypes) = Array::get(variants, bi)\\n      let bnf = Array::length(bftypes)\\n      let bbinds = Array::slice([\\n        PWild\\n      ], 0, 0)\\n      let mut bfi = 0\\n      while bfi < bnf {\\n        Array::push(bbinds, PBind(String::concat(\\\"__b\\\", idx_str(bfi))))\\n        bfi = bfi + 1\\n      }\\n      let arm_body = if ai == bi {\\n        // same variant: lexicographic over payloads, 0 if no payload.\\n        let mut body = EInt(0)\\n        let mut pi = anf - 1\\n        while pi >= 0 {\\n          let cmp = compare_for_typed(Array::get(aftypes, pi), EIdent(String::concat(\\\"__a\\\", idx_str(pi)), -1), EIdent(String::concat(\\\"__b\\\", idx_str(pi)), -1), known_types)\\n          let prev = body\\n          body = EIf(EBinOp(\\\"<\\\", cmp, EInt(0)), EInt(neg_one), EIf(EBinOp(\\\">\\\", cmp, EInt(0)), EInt(1), prev))\\n          pi = pi - 1\\n        }\\n        body\\n      } else if ai < bi {\\n        EInt(neg_one)\\n      } else {\\n        EInt(1)\\n      }\\n      Array::push(inner_arms, (PCtor(bvname, bbinds), arm_body))\\n      bi = bi + 1\\n    }\\n    Array::push(outer_arms, (PCtor(avname, abinds), EMatch(EIdent(\\\"b\\\", -1), inner_arms)))\\n    ai = ai + 1\\n  }\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(TyName(ename))),\\n    (\\\"b\\\", Some(TyName(ename)))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(ename, \\\"compare\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Int\\\")), None, EMatch(EIdent(\\\"a\\\", -1), outer_arms)))\\n}\\n\\n// The default value expression for a declared field type. Per-type rules:\\n//   Int -> 0, Double/Float -> 0.0, Bool -> false, String -> \\\"\\\", Unit -> (),\\n//   Option[_] -> None, Array[_] -> empty array, and a declared struct/enum\\n//   (in `known_types`) -> `T::default()`. A type with no sensible default (a\\n//   bare type parameter, a function/tuple type, an unknown name) falls back to\\n//   `()` — codegen will then flag the literal against the field's real type, so\\n//   the limitation surfaces as a type error rather than silently wrong data.\\nlet default_for_type: (TypeExpr, Array[String]) -> Expr = (fty, known_types) -> {\\n  match fty {\\n    TyName(\\\"Int\\\") => EInt(0),\\n    TyName(\\\"Double\\\") => EFloat(0.0),\\n    TyName(\\\"Float\\\") => EFloat(0.0),\\n    TyName(\\\"Bool\\\") => EBool(false),\\n    TyName(\\\"String\\\") => EString(\\\"\\\"),\\n    TyName(\\\"Unit\\\") => EUnit,\\n    TyName(n) => if str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"default\\\"), -1), empty_expr_array(), -1)\\n    } else {\\n      EUnit\\n    },\\n    TyApp(\\\"Option\\\", _) => EIdent(\\\"None\\\", -1),\\n    TyApp(\\\"Array\\\", _) => EArray(empty_expr_array()),\\n    TyApp(n, _) => if str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"default\\\"), -1), empty_expr_array(), -1)\\n    } else {\\n      EUnit\\n    },\\n    TyUnit => EUnit,\\n    _ => EUnit\\n  }\\n}\\n\\n// `let P::default = () -> P { P::{ f1: <default>, ... } }` — a struct literal\\n// (ERecord; the struct type is recovered from the field set) with each field at\\n// its type's default.\\nlet gen_default_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\\n  let rec_fields = Array::slice([\\n    (\\\"\\\", EUnit)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (fname, fty) = Array::get(fields, i)\\n    Array::push(rec_fields, (fname, default_for_type(fty, known_types)))\\n    i = i + 1\\n  }\\n  let no_params = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"default\\\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord(rec_fields)))\\n}\\n\\n// `let E::default = () -> E { V0(<default>, ...) }` — the FIRST variant, with\\n// each payload slot at its type's default (nullary -> bare constructor name).\\nlet gen_enum_default_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\\n  let (vname, ftypes) = Array::get(variants, 0)\\n  let body = if Array::length(ftypes) == 0 {\\n    EIdent(vname, -1)\\n  } else {\\n    let args = empty_expr_array()\\n    let mut i = 0\\n    while i < Array::length(ftypes) {\\n      Array::push(args, default_for_type(Array::get(ftypes, i), known_types))\\n      i = i + 1\\n    }\\n    ECall(EIdent(vname, -1), args, -1)\\n  }\\n  let no_params = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(ename, \\\"default\\\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))\\n}\\n\\n// Scan `ty` and, for every `Array[e]` shape found anywhere inside it, append the\\n// element type `e` to `acc` (deduped by `type_key`). Only the immediate element\\n// types are added here; transitive nesting (`Array[Array[Int]]` needs the\\n// `Array[Int]` helper too) is closed by the worklist loop in the caller, which\\n// re-scans every element type it collects. (#695.)\\nlet rec collect_array_elem_types: (TypeExpr, Array[TypeExpr], Array[String]) -> Unit = (ty, acc, acc_keys) -> {\\n  match ty {\\n    TyApp(\\\"Array\\\", args) => if Array::length(args) == 1 {\\n      let e = Array::get(args, 0)\\n      let k = type_key(e)\\n      if !str_array_contains(acc_keys, k) {\\n        Array::push(acc, e)\\n        Array::push(acc_keys, k)\\n      } else {\\n        ()\\n      }\\n      collect_array_elem_types(e, acc, acc_keys)\\n    } else {\\n      ()\\n    },\\n    TyApp(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_array_elem_types(Array::get(args, i), acc, acc_keys)\\n        i = i + 1\\n      }\\n    },\\n    TyTuple(ts) => {\\n      let mut i = 0\\n      while i < Array::length(ts) {\\n        collect_array_elem_types(Array::get(ts, i), acc, acc_keys)\\n        i = i + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\n// Best-effort element TypeExpr of an array LITERAL, inferred from its first\\n// element: scalars and nested array literals only. An empty array, or a first\\n// element whose type is not statically obvious here (variables, struct records,\\n// calls), yields `None` — the caller then leaves a bare-array `==` as the\\n// status-quo scalar binop (documented #695 residual) rather than guessing.\\n// Is `e` an empty array literal `[]`? Used to reduce `[] == x` to a length check.\\nlet is_empty_array_lit: (Expr) -> Bool = (e) -> {\\n  match e {\\n    EArray(elems) => Array::length(elems) == 0,\\n    _ => false\\n  }\\n}\\n\\nlet rec infer_earray_elem_type: (Expr) -> Option[TypeExpr] = (arr) -> {\\n  match arr {\\n    EArray(elems) => if Array::length(elems) == 0 {\\n      None\\n    } else {\\n      match Array::get(elems, 0) {\\n        EInt(_) => Some(TyName(\\\"Int\\\")),\\n        EBool(_) => Some(TyName(\\\"Bool\\\")),\\n        EString(_) => Some(TyName(\\\"String\\\")),\\n        EFloat(_) => Some(TyName(\\\"Double\\\")),\\n        EArray(_) => match infer_earray_elem_type(Array::get(elems, 0)) {\\n          Some(inner) => Some(TyApp(\\\"Array\\\", Array::slice([\\n            inner\\n          ], 0, 1))),\\n          None => None\\n        },\\n        _ => None\\n      }\\n    },\\n    _ => None\\n  }\\n}\\n\\n// Walk an expression and, for every `a == b` / `a != b` whose operand is an\\n// array LITERAL with a determinable element type, collect that element type so a\\n// `__arr_equals__<key>` helper is generated for the dispatch rewrite to call.\\nlet rec collect_bare_array_eq_keys: (Expr, Array[TypeExpr], Array[String]) -> Unit = (e, acc, acc_keys) -> {\\n  match e {\\n    EBinOp(op, l, r) => {\\n      if op == \\\"==\\\" || op == \\\"!=\\\" {\\n        let et = match infer_earray_elem_type(l) {\\n          Some(t) => Some(t),\\n          None => infer_earray_elem_type(r)\\n        }\\n        match et {\\n          Some(t) => {\\n            let k = type_key(t)\\n            if !str_array_contains(acc_keys, k) {\\n              Array::push(acc, t)\\n              Array::push(acc_keys, k)\\n            } else {\\n              ()\\n            }\\n            collect_array_elem_types(t, acc, acc_keys)\\n          },\\n          None => ()\\n        }\\n      } else {\\n        ()\\n      }\\n      collect_bare_array_eq_keys(l, acc, acc_keys)\\n      collect_bare_array_eq_keys(r, acc, acc_keys)\\n    },\\n    EInt(_) => (),\\n    EFloat(_) => (),\\n    EString(_) => (),\\n    EBool(_) => (),\\n    EIdent(_, _) => (),\\n    EUnit => (),\\n    ETuple(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\\n    EArray(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\\n    ERecord(fs) => {\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (_, fe) = Array::get(fs, i)\\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\\n        i = i + 1\\n      }\\n    },\\n    EMap(fs) => {\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (_, fe) = Array::get(fs, i)\\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\\n        i = i + 1\\n      }\\n    },\\n    EIf(c, t, el) => {\\n      collect_bare_array_eq_keys(c, acc, acc_keys)\\n      collect_bare_array_eq_keys(t, acc, acc_keys)\\n      collect_bare_array_eq_keys(el, acc, acc_keys)\\n    },\\n    ELet(_, v, b) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    ELetRec(_, v, b) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    ELetMut(_, v, b) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    EAssign(_, v, c) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(c, acc, acc_keys)\\n    },\\n    EAssignOp(_, _, v, c) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(c, acc, acc_keys)\\n    },\\n    ESeq(a, b) => {\\n      collect_bare_array_eq_keys(a, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    EMatch(s, arms) => {\\n      collect_bare_array_eq_keys(s, acc, acc_keys)\\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\\n    },\\n    EHandle(s, arms) => {\\n      collect_bare_array_eq_keys(s, acc, acc_keys)\\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\\n    },\\n    EWhile(c, b) => {\\n      collect_bare_array_eq_keys(c, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    ELoop(params, b) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        collect_bare_array_eq_keys(init, acc, acc_keys)\\n        i = i + 1\\n      }\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    EForIn(_, _, it, b) => {\\n      collect_bare_array_eq_keys(it, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    ECall(callee, args, _) => {\\n      collect_bare_array_eq_keys(callee, acc, acc_keys)\\n      collect_bare_array_eq_keys_list(args, acc, acc_keys)\\n    },\\n    EUnaryOp(_, x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n    EFn(_, _, _, _, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\\n    EDot(o, _, _) => collect_bare_array_eq_keys(o, acc, acc_keys),\\n    ELabeledArg(_, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\\n    EThrow(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n    EReturn(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n    EBreak(opt) => match opt {\\n      Some(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n      None => ()\\n    },\\n    EContinue(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\\n    ESpread(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n    _ => ()\\n  }\\n}\\n\\nlet collect_bare_array_eq_keys_list: (Array[Expr], Array[TypeExpr], Array[String]) -> Unit = (es, acc, acc_keys) -> {\\n  let mut i = 0\\n  while i < Array::length(es) {\\n    collect_bare_array_eq_keys(Array::get(es, i), acc, acc_keys)\\n    i = i + 1\\n  }\\n}\\n\\nlet collect_bare_array_eq_keys_arms: (Array[(Pat, Expr)], Array[TypeExpr], Array[String]) -> Unit = (arms, acc, acc_keys) -> {\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (_, b) = Array::get(arms, i)\\n    collect_bare_array_eq_keys(b, acc, acc_keys)\\n    i = i + 1\\n  }\\n}\\n\\n// In-place: for each struct with `derive(Show/Ord)`, append the structural\\n// function if not already present (idempotent across the double-run pipeline).\\n// The set of concrete struct/enum names declared in the program — the gate for\\n// emitting DIRECT `T::equals` calls in generated comparators (a field/arg whose\\n// type name is NOT here, e.g. a type parameter `T` of `Box[T]`, falls back to\\n// scalar `==`, since there is no `T::equals` to call).\\nlet collect_decl_type_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out = empty_str_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, name, _, _, _) => Array::push(out, name),\\n      SEnum(_, ename, _, _, _) => Array::push(out, ename),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let desugar_derives: (Array[Stmt]) -> Unit = (stmts) -> {\\n  let gen = empty_stmt_list()\\n  let known_types = collect_decl_type_names(stmts)\\n  // #694 Layer 2: collect `Array[e]` element types referenced by Show/Hash-\\n  // deriving types' fields/payloads, so each gets a `__arr_to_string__<key>`\\n  // helper. A worklist closes nesting (`Array[Array[Int]]` -> `Array[Int]`).\\n  let arr_elems = empty_type_exprs()\\n  let arr_keys = empty_str_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, name, fields, derives, _) => {\\n        // `derive(Hash)` also needs the structural `to_string`: a Hash type's\\n        // stable Map-key string is its structural representation (#638), so\\n        // generate `to_string` for Show OR Hash.\\n        if (str_array_contains(derives, \\\"Show\\\") || str_array_contains(derives, \\\"Hash\\\")) && !top_level_fn_exists(stmts, qualified_name(name, \\\"to_string\\\")) {\\n          Array::push(gen, gen_show_fn(name, fields, known_types))\\n        } else {\\n          ()\\n        }\\n        // #694 Layer 1: `derive(Hash)` -> structural `T::hash_key` (delegates to\\n        // the recursive `to_string`), so the method-bearing `Hash` witness at a\\n        // `get_by(m, T::{..})` call site resolves to a stable structural key.\\n        if str_array_contains(derives, \\\"Hash\\\") && !top_level_fn_exists(stmts, qualified_name(name, \\\"hash_key\\\")) {\\n          Array::push(gen, gen_hash_key_fn(name))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Show\\\") || str_array_contains(derives, \\\"Hash\\\") {\\n          let mut fi = 0\\n          while fi < Array::length(fields) {\\n            let (_, fty) = Array::get(fields, fi)\\n            collect_show_array_elems(fty, arr_elems, arr_keys)\\n            fi = fi + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Ord\\\") && !top_level_fn_exists(stmts, qualified_name(name, \\\"compare\\\")) {\\n          Array::push(gen, gen_compare_fn(name, fields))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Default\\\") && !top_level_fn_exists(stmts, qualified_name(name, \\\"default\\\")) {\\n          Array::push(gen, gen_default_fn(name, fields, known_types))\\n        } else {\\n          ()\\n        }\\n        // Generate `T::equals` for every struct (not just derive(Eq)) so the\\n        // `==` dispatch below always resolves; structural equality is the\\n        // sensible default for any struct, and a struct never relied on the old\\n        // pointer-identity `==` (which was silently always-false).\\n        if !top_level_fn_exists(stmts, qualified_name(name, \\\"equals\\\")) {\\n          Array::push(gen, gen_eq_fn(name, fields, known_types))\\n        } else {\\n          ()\\n        }\\n      },\\n      SEnum(_, ename, _, variants, derives) => {\\n        if (str_array_contains(derives, \\\"Show\\\") || str_array_contains(derives, \\\"Hash\\\")) && !top_level_fn_exists(stmts, qualified_name(ename, \\\"to_string\\\")) {\\n          Array::push(gen, gen_enum_show_fn(ename, variants, known_types))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Hash\\\") && !top_level_fn_exists(stmts, qualified_name(ename, \\\"hash_key\\\")) {\\n          Array::push(gen, gen_hash_key_fn(ename))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Show\\\") || str_array_contains(derives, \\\"Hash\\\") {\\n          let mut vi = 0\\n          while vi < Array::length(variants) {\\n            let (_, ftypes) = Array::get(variants, vi)\\n            let mut ti = 0\\n            while ti < Array::length(ftypes) {\\n              collect_show_array_elems(Array::get(ftypes, ti), arr_elems, arr_keys)\\n              ti = ti + 1\\n            }\\n            vi = vi + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Ord\\\") && !top_level_fn_exists(stmts, qualified_name(ename, \\\"compare\\\")) {\\n          Array::push(gen, gen_enum_compare_fn(ename, variants, known_types))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Default\\\") && !top_level_fn_exists(stmts, qualified_name(ename, \\\"default\\\")) {\\n          Array::push(gen, gen_enum_default_fn(ename, variants, known_types))\\n        } else {\\n          ()\\n        }\\n        // Generate `E::equals` for every enum (same rationale as structs), so\\n        // the `==` dispatch resolves enum operands too.\\n        if !top_level_fn_exists(stmts, qualified_name(ename, \\\"equals\\\")) {\\n          Array::push(gen, gen_enum_eq_fn(ename, variants, known_types))\\n        } else {\\n          ()\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  // #695: collect every `Array[e]` element type referenced by struct fields /\\n  // enum payloads (transitively) plus those surfaced by bare-array `==` sites in\\n  // user code, then emit one monomorphic `__arr_equals__<key>` helper per\\n  // distinct key. The worklist closes nesting: scanning element type `e` may\\n  // surface a further `Array[u]` whose helper is also required. Idempotent:\\n  // guarded by `top_level_fn_exists` so re-running the pass is inert.\\n  let elem_types = empty_type_exprs()\\n  let elem_keys = empty_str_array()\\n  let mut si = 0\\n  while si < Array::length(stmts) {\\n    match Array::get(stmts, si) {\\n      SStruct(_, _, fields, _, _) => {\\n        let mut fi = 0\\n        while fi < Array::length(fields) {\\n          let (_, fty) = Array::get(fields, fi)\\n          collect_array_elem_types(fty, elem_types, elem_keys)\\n          fi = fi + 1\\n        }\\n      },\\n      SEnum(_, _, _, variants, _) => {\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (_, ftypes) = Array::get(variants, vi)\\n          let mut ti = 0\\n          while ti < Array::length(ftypes) {\\n            collect_array_elem_types(Array::get(ftypes, ti), elem_types, elem_keys)\\n            ti = ti + 1\\n          }\\n          vi = vi + 1\\n        }\\n      },\\n      SLet(_, _, _, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      SLetMut(_, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      SExpr(e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      STest(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      SBench(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      _ => ()\\n    }\\n    si = si + 1\\n  }\\n  // Worklist closure: scanning each collected element type can surface further\\n  // nested array element types (e.g. `Array[Array[Int]]` -> `Array[Int]`).\\n  let mut wi = 0\\n  while wi < Array::length(elem_types) {\\n    collect_array_elem_types(Array::get(elem_types, wi), elem_types, elem_keys)\\n    wi = wi + 1\\n  }\\n  let mut ei = 0\\n  while ei < Array::length(elem_types) {\\n    let et = Array::get(elem_types, ei)\\n    if !top_level_fn_exists(stmts, arr_equals_name(et)) {\\n      Array::push(gen, gen_arr_equals_fn(et, known_types))\\n    } else {\\n      ()\\n    }\\n    ei = ei + 1\\n  }\\n  // #694: emit `__arr_to_string__<key>` helpers for Array element types\\n  // referenced by Show/Hash-deriving fields/payloads (`arr_elems` populated in\\n  // the struct/enum arms above). Independent of the #695 `__arr_equals__` set.\\n  let mut wi2 = 0\\n  while wi2 < Array::length(arr_elems) {\\n    collect_show_array_elems(Array::get(arr_elems, wi2), arr_elems, arr_keys)\\n    wi2 = wi2 + 1\\n  }\\n  let mut ei2 = 0\\n  while ei2 < Array::length(arr_elems) {\\n    let et2 = Array::get(arr_elems, ei2)\\n    if !top_level_fn_exists(stmts, arr_to_string_name(et2)) {\\n      Array::push(gen, gen_arr_to_string_fn(et2, known_types))\\n    } else {\\n      ()\\n    }\\n    ei2 = ei2 + 1\\n  }\\n  let mut g = 0\\n  while g < Array::length(gen) {\\n    Array::push(stmts, Array::get(gen, g))\\n    g = g + 1\\n  }\\n}\\n\\nlet empty_stmt_list: () -> Array[Stmt] = () -> {\\n  Array::slice([\\n    SExport([\\n      \\\"\\\"\\n    ])\\n  ], 0, 0)\\n}\\n\\nlet struct_decl_exists: (Array[Stmt], String) -> Bool = (stmts, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, sname, _, _, _) => if sname == name {\\n        found = true\\n        i = Array::length(stmts)\\n      } else {\\n        i = i + 1\\n      },\\n      _ => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  found\\n}\\n\\n// Entry point: in-place dictionary-passing desugaring. No-op unless the program\\n// declares at least one method-bearing trait. Idempotent: re-running (the\\n// single-file pipeline desugars before generic-stripping and codegen re-runs on\\n// the same stmts after) finds the bounds already stripped (so no function is\\n// re-threaded) and skips dict structs that already exist.\\nexport let desugar_trait_dicts: (Array[Stmt]) -> Unit = (stmts) -> {\\n  // derive(...) structural function generation (#638) — independent of traits,\\n  // idempotent, so it runs unconditionally here at the shared pre-check points.\\n  desugar_derives(stmts)\\n  // Flatten supertrait methods into each trait so `[T: B]` (for `trait B: A`)\\n  // dispatches both B's and A's methods through one witness dictionary. When the\\n  // program declares no method-bearing trait `traits` is empty, the dict-passing\\n  // rewrites are all no-ops (`gens` empty, sync-`for` classification gated off),\\n  // and the rewrite pass only strips `for await` markers — so it must still run\\n  // unconditionally (`for await` predates the trait machinery).\\n  let traits_raw = collect_method_traits(stmts)\\n  let supers_map = collect_trait_supers(stmts)\\n  let traits = flatten_traits(traits_raw, supers_map)\\n  // Rank-1 method generics (#684): re-attach each trait method's `[X: Bound]`\\n  // binder to its impl free functions (and annotate their params) BEFORE\\n  // build_gens, so `C::m` is registered as a bounded generic and the existing\\n  // dict-passing threads the witness at qualified call sites. Inert (and\\n  // idempotent) when no trait declares a method-level binder. Also run from\\n  // `check_program` so the FS-compile path (which type-checks before this pass)\\n  // sees the `X` binding and can resolve `X::method` in the impl body.\\n  inject_trait_method_generics_with(stmts, traits)\\n  let struct_sets = collect_struct_field_sets(stmts)\\n  let fn_returns = collect_fn_returns(stmts)\\n  let gimpl_types = collect_generic_impl_types(stmts)\\n  let gens = build_gens(stmts, traits, gimpl_types)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::set(stmts, i, rewrite_stmt(Array::get(stmts, i), gens, traits, struct_sets, fn_returns))\\n    i = i + 1\\n  }\\n  // Witness dict structs are only needed when method-bearing traits exist.\\n  if Array::length(traits_raw) == 0 {\\n    ()\\n  } else {\\n    let mut ti = 0\\n    while ti < Array::length(traits) {\\n      let (trait_name, sigs) = Array::get(traits, ti)\\n      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {\\n        ()\\n      } else {\\n        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs))\\n      }\\n      ti = ti + 1\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_137 = () -> (String, String) {\n  (\"vibe/compiler/entry/source_compile/gc_only/index.vibe\",\n\"//# Imports\\n\\nimport ../../../syntax/lexer.vibe {\\n  lex,\\n}\\n\\nimport ../../../syntax/parser.vibe {\\n  parse_program\\n}\\n\\nimport ../../../checker/checker_stmt.vibe {\\n  check_program\\n}\\n\\nimport ../../../codegen/gc/backend_body.vibe {\\n  compile_wasi_module_gc\\n}\\n\\n//# Functions\\n\\nexport let compile_source_gc_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\\n  let tokens = lex(source)\\n  let stmts = parse_program(tokens)\\n  let _ = check_program(stmts)\\n  compile_wasi_module_gc(stmts, entry_name)\\n}\\n\")\n}\n\nlet cli_adapter_source_138 = () -> (String, String) {\n  (\"vibe/compiler/entry/source_compile/wasi_only/preprocess.vibe\",\n\"//# Imports\\n\\nexport ./preprocess_compile.vibe {\\n  compile_source_wasi_only, compile_source_wasi_only_coverage, compile_source_wasi_only_rc, compile_source_wasi_only_rc_shadow\\n}\\n\\nexport ./preprocess_interp.vibe {\\n  expand_interp_stmts\\n}\\n\\nexport ./preprocess_strip.vibe {\\n  strip_generic_type_params\\n}\\n\\n//# Misc\\n\\nexport {\\n  expand_interp_stmts, compile_source_wasi_only, compile_source_wasi_only_coverage, compile_source_wasi_only_rc, compile_source_wasi_only_rc_shadow, strip_generic_type_params\\n}\\n\")\n}\n\nlet cli_adapter_source_139 = () -> (String, String) {\n  (\"vibe/compiler/entry/source_compile/wasi_only/preproce