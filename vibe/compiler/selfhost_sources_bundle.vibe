)  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 1)\n  emit_i64_store(b, 3, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\nlet gen_arr_set_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 2)\n  emit_i64_store(b, 3, 0)\n  b\n}\n\n// Generate __str_char_code_at body: (s: i64, idx: i64) -> i64\n// locals: 0=s(i64), 1=idx(i64), 2=offset(i32)\nlet gen_str_char_code_at_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// Generate __str_from_char_code body: (code: i64) -> i64\n// locals: 0=code(i64), 1=ptr(i32)\nlet gen_str_from_char_code_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 1)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 1)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_i64_const(b, 1)\n  emit_i64_or(b)\n  b\n}\n\n// Generate __str_substring body: (s: i64, start: i64, end: i64) -> i64\n// locals: 0=s(i64), 1=start(i64), 2=end(i64), 3=old_offset(i32), 4=new_len(i32)\nlet gen_str_substring_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_sub(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_i64_or(b)\n  b\n}\n\nlet gen_double_to_int_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_i64_trunc_f64_s(b)\n  b\n}\n\nlet gen_int_to_double_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_convert_i64_s(b)\n  emit_i64_reinterpret_f64(b)\n  b\n}\n\n// Generate __identity body (func 16): (val: i64) -> i64\nlet gen_identity_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  b\n}\n\n// === WASI Module compiler (GC backend) ===\n\nexport let compile_wasi_module_gc = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  // Collect user functions\n  let fn_names_list = array_slice([\"\"], 0, 0)\n  let fn_param_counts = array_slice([0], 0, 0)\n\n  let mut i = 0\n  while i < array_length(stmts) {\n    let stmt = array_get(stmts, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => {\n        match expr {\n          EFn(_, _, params, _, _, _) => {\n            array_push(fn_names_list, name)\n            array_push(fn_param_counts, array_length(params))\n            0\n          },\n          _ => 0\n        }\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n\n  // Collect enum variant constructors with stable type-scoped tags\n  // Tag scheme: (type_index << 16) | variant_index\n  let ctor_names_list = array_slice([\"None\", \"Some\"], 0, 2)\n  let ctor_tags_list = array_slice([0, 1], 0, 2)\n  let ctor_field_counts_list = array_slice([0, 1], 0, 2)\n  let ctor_type_names_list = array_slice([\"Option\", \"Option\"], 0, 2)\n  let mut type_index = 1  // type 0 = Option\n  let mut ei2 = 0\n  while ei2 < array_length(stmts) {\n    match array_get(stmts, ei2) {\n      SEnum(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < array_length(variants) {\n          let (vname, vfields) = array_get(variants, vi)\n          array_push(ctor_names_list, vname)\n          array_push(ctor_tags_list, (type_index << 16) | vi)\n          array_push(ctor_field_counts_list, array_length(vfields))\n          array_push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields) => {\n        type_index = type_index + 1\n        array_push(ctor_names_list, sname)\n        array_push(ctor_tags_list, type_index << 16)\n        array_push(ctor_field_counts_list, array_length(sfields))\n        array_push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n\n  // Build struct field name index tables\n  let struct_names = array_slice([\"\"], 0, 0)\n  let struct_field_names = array_slice([array_slice([\"\"], 0, 0)], 0, 0)\n  let mut si = 0\n  while si < array_length(stmts) {\n    match array_get(stmts, si) {\n      SStruct(_, sname, sfields) => {\n        array_push(struct_names, sname)\n        let fnames = array_slice([\"\"], 0, 0)\n        let mut sfi = 0\n        while sfi < array_length(sfields) {\n          let (fname, _) = array_get(sfields, sfi)\n          array_push(fnames, fname)\n          sfi = sfi + 1\n        }\n        array_push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n\n  let num_user_funcs = array_length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n\n  // Find entry function\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if string_equals(array_get(fn_names_list, ei), entry_name) {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 {\n    throw(string_concat(\"entry function not found: \", entry_name))\n  }\n\n  // String table\n  let str_strs = collect_strings_stmts(stmts)\n  let num_strings = array_length(str_strs)\n  let data_base = 64\n  let str_offsets = array_slice([0], 0, 0)\n  let str_lengths = array_slice([0], 0, 0)\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = array_get(str_strs, si)\n    let slen = string_length(s)\n    array_push(str_offsets, str_pos)\n    array_push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n\n  // Function layout:\n  // func 0: fd_write (import)\n  // func 1-16: generated builtins (16 funcs)\n  // func 17..17+N-1: user functions\n  // func 17+N: _start\n  let num_generated = 16\n  let func_offset = 1 + num_generated  // = 17\n\n  // Builtin table: (name, param_count, wasm_func_idx, has_return)\n  let builtin_defs = [\n    (\"print_int\",           1, 1,  0),\n    (\"print_str\",           1, 2,  0),\n    (\"string_length\",       1, 3,  1),\n    (\"string_equals\",       2, 4,  1),\n    (\"string_concat\",       2, 5,  1),\n    (\"array_new\",           0, 6,  1),\n    (\"array_length\",        1, 7,  1),\n    (\"array_get\",           2, 8,  1),\n    (\"array_push\",          2, 9,  0),\n    (\"array_set\",           3, 10, 0),\n    (\"double_to_int\",       1, 11, 1),\n    (\"int_to_double\",       1, 12, 1),\n    (\"string_char_code_at\", 2, 13, 1),\n    (\"string_from_char_code\", 1, 14, 1),\n    (\"string_substring\",    3, 15, 1),\n    // Aliases\n    (\"array_builder\",       0, 6,  1),\n    (\"array_builder_push\",  2, 9,  0),\n    (\"array_builder_freeze\", 1, 16, 1)\n  ]\n  let mut __bi = 0\n  while __bi < array_length(builtin_defs) {\n    let (bname, bparams, _, _) = array_get(builtin_defs, __bi)\n    array_push(fn_names_list, bname)\n    array_push(fn_param_counts, bparams)\n    __bi = __bi + 1\n  }\n\n  // Build fn_indices and fn_returns\n  let fn_indices_list = array_slice([0], 0, 0)\n  let fn_returns_list = array_slice([0], 0, 0)\n  let mut fi = 0\n  while fi < num_user_funcs {\n    array_push(fn_indices_list, fi + func_offset)\n    array_push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  // Builtin indices and returns (from builtin_defs table)\n  let mut __bi2 = 0\n  while __bi2 < array_length(builtin_defs) {\n    let (_, _, bwasm_idx, breturns) = array_get(builtin_defs, __bi2)\n    array_push(fn_indices_list, bwasm_idx)\n    array_push(fn_returns_list, breturns)\n    __bi2 = __bi2 + 1\n  }\n\n  // === Type section ===\n  // type 0-8: base func types\n  // type 9: struct { mut i64 } -- RefCell GC type\n  // type 10+: closure call types (i64^(N+1)) -> i64\n  let refcell_type_idx = 9\n  let closure_type_base = 10\n\n  // Lambda accumulators (populated during compilation)\n  let lt_w = LambdaTable::{\n    bodies: array_slice([array_slice([0], 0, 0)], 0, 0),\n    param_counts: array_slice([0], 0, 0),\n    captures: array_slice([array_slice([\"\"], 0, 0)], 0, 0),\n    meta_i32: array_slice([0], 0, 0),\n    meta_i64: array_slice([0], 0, 0)\n  }\n\n  // === Code section bodies ===\n  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)\n  let meta_i32 = array_slice([0], 0, 0)\n  let meta_i64 = array_slice([0], 0, 0)\n  // Track which user func bodies have ref locals (for mixed local declarations)\n  let user_ref_local_indices_all = array_slice([array_slice([0], 0, 0)], 0, 0)\n\n  // Builtin bodies\n  array_push(bodies, gen_print_i64_body())\n  array_push(meta_i32, 3)\n  array_push(meta_i64, 1)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_print_str_body())\n  array_push(meta_i32, 2)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_str_len_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_str_eq_body())\n  array_push(meta_i32, 5)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_str_concat_body())\n  array_push(meta_i32, 6)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_arr_new_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_arr_len_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_arr_get_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_arr_push_body())\n  array_push(meta_i32, 6)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_arr_set_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_double_to_int_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_int_to_double_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_str_char_code_at_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_str_from_char_code_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_str_substring_body())\n  array_push(meta_i32, 2)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  array_push(bodies, gen_identity_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  // Compile user function bodies (with __env param for table compatibility)\n  let mut bi = 0\n  while bi < num_user_funcs {\n    let stmt = find_func_stmt(stmts, array_get(fn_names_list, bi))\n    match stmt {\n      SLet(_, _, _, _, expr) => {\n        match expr {\n          EFn(_, _, params, _, _, body) => {\n            let body_buf = bytebuf_new()\n            let local_names = array_slice([\"\"], 0, 0)\n            let mut ppi = 0\n            while ppi < array_length(params) {\n              let (pname, _) = array_get(params, ppi)\n              array_push(local_names, pname)\n              ppi = ppi + 1\n            }\n            array_push(local_names, \"__env\")\n            let param_count = array_length(params) + 1  // includes __env\n            let ref_cell_names_f = array_slice([\"\"], 0, 0)\n            let ref_local_indices_f = array_slice([0], 0, 0)\n            let ft = FuncTable::{ names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list }\n            let st = StrTable::{ strs: str_strs, offsets: str_offsets, lengths: str_lengths }\n            let ct = CtorTable::{ names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names }\n            let func_ctx = CompileCtxGc::{\n              func_table: ft, str_table: st, lambda_table: lt_w,\n              num_user_funcs: num_user_funcs, func_offset: func_offset,\n              ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,\n              refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\n              ctor_table: ct\n            }\n            let final_nl = compile_expr_gc(\n              body_buf, body, local_names,\n              param_count,\n              func_ctx, -1\n            )\n            array_push(bodies, body_buf)\n            let extra = if final_nl > param_count { final_nl - param_count } else { 0 }\n            array_push(meta_i32, 0)\n            array_push(meta_i64, extra)\n            array_push(user_ref_local_indices_all, ref_local_indices_f)\n          },\n          _ => throw(\"expected function\")\n        }\n      },\n      _ => throw(\"expected let statement\")\n    }\n    bi = bi + 1\n  }\n\n  let num_lambdas = array_length(lt_w.bodies)\n\n  // _start body\n  let start_body = bytebuf_new()\n  let entry_func_idx = entry_user_idx + func_offset\n  let entry_params = array_get(fn_param_counts, entry_user_idx)\n  if entry_params != 0 {\n    throw(\"WASI entry function must take 0 parameters\")\n  }\n  emit_i64_const(start_body, 0)  // env=0 for user func\n  emit_call(start_body, entry_func_idx)\n  emit_call(start_body, 1)  // __print_i64\n  array_push(bodies, start_body)\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n\n  // Append lambda bodies after _start\n  let mut li = 0\n  while li < num_lambdas {\n    array_push(bodies, array_get(lt_w.bodies, li))\n    array_push(meta_i32, array_get(lt_w.meta_i32, li))\n    array_push(meta_i64, array_get(lt_w.meta_i64, li))\n    array_push(user_ref_local_indices_all, array_slice([0], 0, 0))\n    li = li + 1\n  }\n\n  // Determine max closure call arity\n  let mut max_closure_arity = -1\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = array_get(lt_w.param_counts, lai) - 1\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  let mut uai2 = 0\n  while uai2 < num_user_funcs {\n    let upc = array_get(fn_param_counts, uai2)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai2 = uai2 + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 { max_closure_arity + 1 } else { 0 }\n\n  // === Type section ===\n  let num_base_types = 10  // 0-8 func types + 9 struct\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\n\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])  // type 0: fd_write\n  emit_func_type_raw(type_content, [126], array_slice([0], 0, 0))  // type 1: (i64)->()\n  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))  // type 2: ()->()\n  emit_func_type_raw(type_content, [126], [126])  // type 3: (i64)->(i64)\n  emit_func_type_raw(type_content, [126, 126], [126])  // type 4: (i64,i64)->(i64)\n  emit_func_type_raw(type_content, array_slice([0], 0, 0), [126])  // type 5: ()->(i64)\n  emit_func_type_raw(type_content, [126, 126], array_slice([0], 0, 0))  // type 6: (i64,i64)->()\n  emit_func_type_raw(type_content, [126, 126, 126], array_slice([0], 0, 0))  // type 7: (i64,i64,i64)->()\n  emit_func_type_raw(type_content, [126, 126, 126], [126])  // type 8: (i64,i64,i64)->(i64)\n\n  // type 9: struct { mut i64 }\n  emit_struct_type_raw(type_content, [126], [1])\n\n  // Closure call types: (i64^(N+1)) -> i64 for N = 0..max_closure_arity\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1  // N user params + 1 env\n    let ct_params = array_slice([0], 0, 0)\n    let mut cpti = 0\n    while cpti < num_params {\n      array_push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [126])\n    cti = cti + 1\n  }\n\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n\n  // === Import section ===\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n\n  // === Function section ===\n  let func_type_indices = array_slice([0], 0, 0)\n  array_push(func_type_indices, 1)  // __print_i64\n  array_push(func_type_indices, 1)  // __print_str\n  array_push(func_type_indices, 3)  // __str_len\n  array_push(func_type_indices, 4)  // __str_eq\n  array_push(func_type_indices, 4)  // __str_concat\n  array_push(func_type_indices, 5)  // __arr_new\n  array_push(func_type_indices, 3)  // __arr_len\n  array_push(func_type_indices, 4)  // __arr_get\n  array_push(func_type_indices, 6)  // __arr_push\n  array_push(func_type_indices, 7)  // __arr_set\n  array_push(func_type_indices, 3)  // __double_to_int\n  array_push(func_type_indices, 3)  // __int_to_double\n  array_push(func_type_indices, 4)  // __str_char_code_at\n  array_push(func_type_indices, 3)  // __str_from_char_code\n  array_push(func_type_indices, 8)  // __str_substring\n  array_push(func_type_indices, 3)  // __identity (array_builder_freeze)\n  // User funcs: type = closure call type for their arity (includes env)\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = array_get(fn_param_counts, fti)\n    array_push(func_type_indices, closure_type_base + upc)\n    fti = fti + 1\n  }\n  array_push(func_type_indices, 2)  // _start\n  // Lambda function type indices\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = array_get(lt_w.param_counts, lfi) - 1\n    array_push(func_type_indices, closure_type_base + lam_user_params)\n    lfi = lfi + 1\n  }\n  emit_function_section(out, func_type_indices)\n\n  // === Table section ===\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n\n  // === Memory section ===\n  emit_memory_section(out, 1)\n\n  // === Global section: heap_ptr ===\n  emit_global_section_i32_mut(out, heap_start)\n\n  // === Export section ===\n  let start_func_idx = func_offset + num_user_funcs\n  emit_exports_with_memory(out, [\"_start\"], [start_func_idx], \"memory\", 0)\n\n  // === Element section ===\n  if total_table_entries > 0 {\n    let table_func_indices = array_slice([0], 0, 0)\n    let mut tei = 0\n    while tei < num_user_funcs {\n      array_push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      array_push(table_func_indices, start_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n\n  // === Encode code section with mixed locals (i64 and ref types) ===\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, array_length(bodies))\n\n  let mut ci = 0\n  while ci < array_length(bodies) {\n    let body = array_get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = array_get(meta_i32, ci)\n    let ni64 = array_get(meta_i64, ci)\n    let ref_indices = array_get(user_ref_local_indices_all, ci)\n    let num_ref_locals = array_length(ref_indices)\n\n    if num_ref_locals == 0 {\n      if ni32 == 0 {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 0)\n        } else {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)  // i64\n        }\n      } else {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)  // i32\n        } else {\n          leb128_encode_u32(func_buf, 2)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)  // i32\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)  // i64\n        }\n      }\n    } else {\n      // Has ref locals — emit individual local declarations\n      let body_idx_in_user = ci - num_generated\n      let param_count_for_body = array_get(fn_param_counts, body_idx_in_user) + 1  // +1 for __env\n      let num_extra = ni64\n      leb128_encode_u32(func_buf, num_extra)\n      let mut rli = 0\n      while rli < num_extra {\n        let actual_local_idx = param_count_for_body + rli\n        let mut is_ref = false\n        let mut ri = 0\n        while ri < num_ref_locals {\n          if array_get(ref_indices, ri) == actual_local_idx {\n            is_ref = true\n          }\n          ri = ri + 1\n        }\n        leb128_encode_u32(func_buf, 1)\n        if is_ref {\n          bytebuf_push(func_buf, 100)  // 0x64 = ref\n          leb128_encode_u32(func_buf, refcell_type_idx)\n        } else {\n          bytebuf_push(func_buf, 126)  // i64\n        }\n        rli = rli + 1\n      }\n    }\n\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_array(code_content, func_buf)\n    ci = ci + 1\n  }\n\n  bytebuf_push_section(out, 10, code_content)\n\n  // === Data section ===\n  if num_strings > 0 {\n    let data_offsets = array_slice([0], 0, 0)\n    let data_bufs = array_slice([array_slice([0], 0, 0)], 0, 0)\n    let mut di = 0\n    while di < num_strings {\n      array_push(data_offsets, array_get(str_offsets, di))\n      array_push(data_bufs, string_to_data(array_get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n\n  bytebuf_to_bytes(out)\n}\n")
    ,
    ("vibe/compiler/eval_loader.vibe",
"//# Imports\n\nimport ./lexer.vibe {\n  lex\n}\n\nimport ./parser.vibe {\n  Expr, Pat, Stmt, TypeExpr, parse_program\n}\n\n//# Functions\n\nexport let contains_str = (arr: Array[String], target: String) -> Bool {\n  let rec go = (i: Int) -> Bool {\n    if i >= array_length(arr) {\n      false\n    }\n    else {\n      if string_equals(array_get(arr, i), target) {\n        true\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let source_lookup = (sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let rec go = (i: Int) -> Option[String] {\n    if i >= array_length(sources) {\n      None\n    }\n    else {\n      let (p, src) = array_get(sources, i)\n      if string_equals(p, path_key) {\n        Some(src)\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let load_and_parse = (source: String) -> Array[Stmt] with { Error } {\n  let tokens = lex(source)\n  parse_program(tokens)\n}\n\nexport let collect_exports = (stmts: Array[Stmt]) -> Array[String] {\n  let rec go = (i: Int, acc: Array[String]) -> Array[String] {\n    if i >= array_length(stmts) {\n      acc\n    }\n    else {\n      let stmt = array_get(stmts, i)\n      let new_acc = match stmt {\n        SLet(true, _, name, _, _) => array_concat(acc, [\n          name\n        ]),\n        SEnum(true, _, variants) => {\n          let rec add_ctors = (j: Int, a: Array[String]) -> Array[String] {\n            if j >= array_length(variants) {\n              a\n            }\n            else {\n              let (cname, _) = array_get(variants, j)\n              add_ctors(j + 1, array_concat(a, [\n                cname\n              ]))\n            }\n          }\n          add_ctors(0, acc)\n        },\n        SExport(names) => {\n          let rec add_names = (j: Int, a: Array[String]) -> Array[String] {\n            if j >= array_length(names) {\n              a\n            }\n            else {\n              add_names(j + 1, array_concat(a, [\n                array_get(names, j)\n              ]))\n            }\n          }\n          add_names(0, acc)\n        },\n        _ => acc\n      }\n      go(i + 1, new_acc)\n    }\n  }\n  go(0, array_slice([\n    \"\"\n  ], 0, 0))\n}\n\nexport let exports_contains = (exports: Array[String], name: String) -> Bool {\n  contains_str(exports, name)\n}\n")
    ,
    ("vibe/compiler/module_loader.vibe",
"//# Imports\n\nimport ./lexer.vibe {\n  lex\n}\n\nimport ./ast.vibe {\n  Stmt\n}\n\nimport ./parser.vibe {\n  parse_program\n}\n\nimport ./checker_stmt.vibe {\n  check_stmts\n}\n\nimport ./eval_loader.vibe {\n  collect_exports, contains_str, source_lookup, load_and_parse\n}\n\nimport ./types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup\n}\n\n//# Path helpers (inline to avoid cross-module import issues)\n\nlet dir_of = (file_path: String) -> String {\n  let idx = string_last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  }\n  else {\n    string_substring(file_path, 0, idx)\n  }\n}\n\nlet resolve_path = (base_dir: String, raw_path: String) -> String {\n  let len = string_length(raw_path)\n  if len >= 3 {\n    if string_equals(string_substring(raw_path, 0, 3), \"../\") {\n      let rest = string_substring(raw_path, 3, len)\n      let parent = dir_of(base_dir)\n      let resolved = if string_ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        string_concat(rest, \".vibe\")\n      }\n      if string_equals(parent, \"\") {\n        resolved\n      } else {\n        string_concat(parent, string_concat(\"/\", resolved))\n      }\n    }\n    else if string_equals(string_substring(raw_path, 0, 2), \"./\") {\n      let rest = string_substring(raw_path, 2, len)\n      let resolved = if string_ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        string_concat(rest, \".vibe\")\n      }\n      if string_equals(base_dir, \"\") {\n        resolved\n      } else {\n        string_concat(base_dir, string_concat(\"/\", resolved))\n      }\n    }\n    else {\n      raw_path\n    }\n  }\n  else if len >= 2 {\n    if string_equals(string_substring(raw_path, 0, 2), \"./\") {\n      let rest = string_substring(raw_path, 2, len)\n      let resolved = if string_ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        string_concat(rest, \".vibe\")\n      }\n      if string_equals(base_dir, \"\") {\n        resolved\n      } else {\n        string_concat(base_dir, string_concat(\"/\", resolved))\n      }\n    }\n    else {\n      raw_path\n    }\n  }\n  else {\n    raw_path\n  }\n}\n\n//# Helper functions\n\n// Cache lookup helper\nlet cache_lookup = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = array_length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while i < len {\n    if done {\n      i = len\n    } else {\n      let (p, e) = array_get(cache, i)\n      if string_equals(p, path) {\n        result = Some(e)\n        done = true\n      }\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Bind imported names from a checked module's env\nlet rec bind_checked_imports = (\n  names: Array[(String, Option[String])],\n  i: Int,\n  env: TypeEnv,\n  mod_env: TypeEnv,\n  exports: Array[String]\n) -> TypeEnv {\n  if i >= array_length(names) {\n    env\n  } else {\n    let (name, alias) = array_get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let new_env = if contains_str(exports, name) {\n      match env_lookup(mod_env, name) {\n        Some(ty) => env_bind(env, bound_name, ty),\n        None => env\n      }\n    } else {\n      env\n    }\n    bind_checked_imports(names, i + 1, new_env, mod_env, exports)\n  }\n}\n\n//# Module Loader\n\n// Check a module and return its TypeEnv, resolving imports recursively.\n// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).\nexport let rec check_module = (\n  source: String,\n  path: String,\n  sources: Array[(String, String)],\n  loading: Array[String],\n  checked_cache: Array[(String, TypeEnv)]\n) -> TypeEnv with { Error } {\n  // Check cache first\n  let cached = cache_lookup(checked_cache, path)\n  match cached {\n    Some(env) => env,\n    None => {\n      // Cycle detection\n      if contains_str(loading, path) {\n        throw(string_concat(\"import cycle detected: \", path))\n      }\n      let tokens = lex(source)\n      let stmts = parse_program(tokens)\n      let base_dir = dir_of(path)\n      let new_loading = array_concat(loading, [path])\n\n      // Resolve imports using while loop\n      let mut import_env = EnvEmpty\n      let mut ri = 0\n      while ri < array_length(stmts) {\n        let stmt = array_get(stmts, ri)\n        import_env = match stmt {\n          SImport(raw_path, names) => {\n            let resolved = resolve_path(base_dir, raw_path)\n            match source_lookup(sources, resolved) {\n              None => throw(string_concat(\"module not found: \", resolved)),\n              Some(mod_source) => {\n                // Recursively check the imported module\n                let mod_env = check_module(mod_source, resolved, sources, new_loading, checked_cache)\n                let exports = {\n                  let mod_tokens = lex(mod_source)\n                  let mod_stmts = parse_program(mod_tokens)\n                  collect_exports(mod_stmts)\n                }\n                // Bind exported names into current env\n                bind_checked_imports(names, 0, import_env, mod_env, exports)\n              }\n            }\n          },\n          _ => import_env\n        }\n        ri = ri + 1\n      }\n\n      // Type-check with imported env\n      let empty_defs = array_slice([TDAlias(\"_dummy\", CtUnit)], 0, 0)\n      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0)\n\n      // Cache result\n      array_push(checked_cache, (path, env))\n      env\n    }\n  }\n}\n\n//# FS-based source collection\n\nlet rec collect_sources_rec = (\n  path: String,\n  sources: Array[(String, String)],\n  visited: Array[String]\n) -> Unit with { Error, Fs } {\n  if contains_str(visited, path) {\n    ()\n  }\n  else {\n    array_push(visited, path)\n    let source = fs_read_file(path)\n    let tokens = lex(source)\n    let stmts = parse_program(tokens)\n    let base_dir = dir_of(path)\n    // First, recurse into dependencies (imports and re-exports)\n    let mut i = 0\n    while i < array_length(stmts) {\n      match array_get(stmts, i) {\n        SImport(raw_path, _) => {\n          let resolved = resolve_path(base_dir, raw_path)\n          collect_sources_rec(resolved, sources, visited)\n        },\n        SReExport(raw_path, _) => {\n          let resolved = resolve_path(base_dir, raw_path)\n          collect_sources_rec(resolved, sources, visited)\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    // Then add this module (dependencies come first)\n    array_push(sources, (path, source))\n  }\n}\n\n// Recursively collect all source files from filesystem, following imports and re-exports.\n// Returns Array[(path, source)] in dependency order (dependencies first).\nexport let collect_all_sources_fs = (entry_path: String) -> Array[(String, String)] with { Error, Fs } {\n  let sources = array_slice([(\"\", \"\")], 0, 0)\n  let visited = array_slice([\"\"], 0, 0)\n  collect_sources_rec(entry_path, sources, visited)\n  sources\n}\n\n//# Module bundling — merge stmts from all modules in dependency order\n\n// Given all sources (in dependency order), parse and merge their statements.\n// Skips SImport, SReExport (already resolved). Keeps all definitions.\nexport let collect_merged_stmts = (sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = array_slice([SExport([\"_dummy\"])], 0, 0)\n  let mut si = 0\n  while si < array_length(sources) {\n    let (_, src) = array_get(sources, si)\n    let stmts = load_and_parse(src)\n    let mut j = 0\n    while j < array_length(stmts) {\n      let stmt = array_get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        _ => array_push(merged, stmt)\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n")
    ,
    ("vibe/compiler/compiler.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./lexer.vibe {\n  lex\n}\n\nimport ./parser.vibe {\n  parse_program\n}\n\nimport ./checker_stmt.vibe {\n  check_program\n}\n\nimport ./codegen.vibe {\n  compile_module, compile_wasi_module\n}\n\nimport ./module_loader.vibe {\n  check_module, collect_all_sources_fs, collect_merged_stmts\n}\n\nimport ./types.vibe {\n  Type, TypeEnv\n}\n\n//# Functions\n\n// Unified compile pipeline: source string -> WASM bytes\n// Performs: lex -> parse -> check -> codegen\nexport let compile_source = (source: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  compile_module(stmts)\n}\n\n// Unified compile pipeline for WASI: source string -> WASM bytes with WASI entry\nexport let compile_source_wasi = (source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  compile_wasi_module(stmts, entry_name)\n}\n\n// Multi-module compile pipeline: resolve imports, type-check, codegen\n// sources: Array of (path, source_code) pairs for all available modules\n// main_path: path of the entry module\nexport let compile_with_modules = (main_source: String, main_path: String, sources: Array[(String, String)]) -> Bytes with { Error } {\n  let checked_cache = array_slice([(\"\", EnvEmpty)], 0, 0)\n  let empty_loading = array_slice([\"\"], 0, 0)\n  let _ = check_module(main_source, main_path, sources, empty_loading, checked_cache)\n  let tokens = lex(main_source)\n  let stmts = parse_program(tokens)\n  compile_module(stmts)\n}\n\n// Multi-module compile for WASI with entry\nexport let compile_with_modules_wasi = (main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Bytes with { Error } {\n  let checked_cache = array_slice([(\"\", EnvEmpty)], 0, 0)\n  let empty_loading = array_slice([\"\"], 0, 0)\n  let _ = check_module(main_source, main_path, sources, empty_loading, checked_cache)\n  let tokens = lex(main_source)\n  let stmts = parse_program(tokens)\n  compile_wasi_module(stmts, entry_name)\n}\n\n// FS-based multi-module compile pipeline: read files from filesystem, bundle, codegen\n// entry_path: path to the main .vibe file (e.g. \"vibe/compiler/index.vibe\")\n// entry_name: WASI entry function name (e.g. \"run\")\nexport let compile_file_fs = (entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  // 1. Collect all source files by following imports recursively\n  let sources = collect_all_sources_fs(entry_path)\n  // 2. Type-check all modules (validates cross-module types)\n  let main_source = fs_read_file(entry_path)\n  let checked_cache = array_slice([(\"\", EnvEmpty)], 0, 0)\n  let empty_loading = array_slice([\"\"], 0, 0)\n  let _ = check_module(main_source, entry_path, sources, empty_loading, checked_cache)\n  // 3. Bundle: merge all module stmts in dependency order\n  let merged_stmts = collect_merged_stmts(sources)\n  // 4. Codegen on merged stmts\n  compile_wasi_module(merged_stmts, entry_name)\n}\n\n// FS-based compile for non-WASI (--invoke style, no _start entry)\nexport let compile_file_fs_module = (entry_path: String) -> Bytes with { Error, Fs } {\n  let sources = collect_all_sources_fs(entry_path)\n  let main_source = fs_read_file(entry_path)\n  let checked_cache = array_slice([(\"\", EnvEmpty)], 0, 0)\n  let empty_loading = array_slice([\"\"], 0, 0)\n  let _ = check_module(main_source, entry_path, sources, empty_loading, checked_cache)\n  let merged_stmts = collect_merged_stmts(sources)\n  compile_module(merged_stmts)\n}\n")
    ,
    ("vibe/compiler/index.vibe",
"//# Imports\n\nexport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nexport ./lexer.vibe {\n  lex\n}\n\nexport ./parser.vibe {\n  parse, parse_expr, parse_ok, parse_program, parse_stmt, parse_type\n}\n\nexport ./printer.vibe {\n  print_expr, print_pat, print_program, print_stmt, print_type_expr\n}\n\nexport ./token.vibe {\n  Token, token_to_string\n}\n\nexport ./types.vibe {\n  Subst, Type, TypeDef, TypeEnv\n}\n\nexport ./checker_stmt.vibe {\n  check_program, check_program_with_env, check_stmts\n}\n\nexport ./codegen.vibe {\n  compile_module, compile_wasi_module, compile_wasi_module_with_sources\n}\n\nexport ./codegen_gc.vibe {\n  compile_wasi_module_gc\n}\n\nexport ./compiler.vibe {\n  compile_source, compile_source_wasi, compile_file_fs, compile_file_fs_module\n}\n\nimport ./module_loader.vibe {\n  collect_all_sources_fs, collect_merged_stmts\n}\n\nimport ./selfhost_sources_bundle.vibe {\n  selfhost_sources\n}\n\nimport ./codegen_common.vibe {\n  collect_free_vars, is_slet, is_efn, get_slet_name, get_slet_expr, get_efn_params, get_efn_body, array_contains_str\n}\n\n//# Functions\n\nexport let version = \"0.1.0\"\n\nexport let compiler_lex = lex\n\nexport let compiler_parse = parse\n\nexport let compiler_parse_ok = parse_ok\n\nexport let compiler_print_pat = print_pat\n\nexport let compiler_parse_expr = parse_expr\n\nexport let compiler_parse_stmt = parse_stmt\n\nexport let compiler_parse_type = parse_type\n\nexport let compiler_print_expr = print_expr\n\nexport let compiler_print_stmt = print_stmt\n\nexport let compiler_parse_program = parse_program\n\nexport let compiler_print_program = print_program\n\nexport let compiler_print_type_expr = print_type_expr\n\n// Lightweight entry for WASI _start/run wrapper.\nexport let selfbuild_entry = () -> Int { 0 }\n\n// selfbuild helper: use the selfhost compiler's own compile pipeline to compile stage2.\nexport let selfbuild_compile_stage2 = () -> Bytes with { Error } {\n  let sources = selfhost_sources()\n  // Guard: if selfhost_sources() returns empty (stub in selfhost codegen),\n  // fail early so the selfbuild gate falls back to the seed compiler.\n  if array_length(sources) == 0 { throw(\"selfhost_sources is empty (stub)\") }\n  let merged_stmts = collect_merged_stmts(sources)\n  compile_wasi_module(merged_stmts, \"selfbuild_entry\")\n}\n\n// Debug probe: lex only\nexport let selfbuild_probe_lex = () -> Int with { Error } {\n  let tokens = lex(\"let add = (a: Int, b: Int) -> Int { a + b }\")\n  array_length(tokens)\n}\n\n// Debug probe: parse only\nexport let selfbuild_probe_parse = () -> Int with { Error } {\n  let tokens = lex(\"let add = (a: Int, b: Int) -> Int { a + b }\")\n  let stmts = parse_program(tokens)\n  array_length(stmts)\n}\n\n// Debug probe: check only\nexport let selfbuild_probe_check = () -> Int with { Error } {\n  let tokens = lex(\"let add = (a: Int, b: Int) -> Int { a + b }\")\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  1\n}\n\n// Debug probe: compile\nexport let selfbuild_probe_compile = () -> Int with { Error } {\n  let bytes = compile_source(\"let add = (a: Int, b: Int) -> Int { a + b }\")\n  bytes_length(bytes)\n}\n\n// Debug probe: parse_count\nexport let selfbuild_probe_parse_count = () -> Int with { Error } {\n  let tokens = lex(\"let x = 42\")\n  let num_tokens = array_length(tokens)\n  let stmts = parse_program(tokens)\n  let num_stmts = array_length(stmts)\n  num_tokens * 1000 + num_stmts\n}\n\n// Debug probe: token tag\nexport let selfbuild_probe_token_tag = () -> Int with { Error } {\n  let tokens = lex(\"let x = 42\")\n  let first = array_get(tokens, 0)\n  let tag = match first {\n    TLet => 1,\n    TEof => 2,\n    _ => 0\n  }\n  array_length(tokens) * 100 + tag\n}\n\n// Debug probe: deep if-else chain\nexport let selfbuild_probe_deep_if = () -> Int with { Error } {\n  let c = 40\n  let result = if c == 43 { 1 }\n    else if c == 45 { 2 }\n    else if c == 42 { 3 }\n    else if c == 47 { 4 }\n    else if c == 37 { 5 }\n    else if c == 61 { 6 }\n    else if c == 33 { 7 }\n    else if c == 60 { 8 }\n    else if c == 62 { 9 }\n    else if c == 38 { 10 }\n    else if c == 124 { 11 }\n    else if c == 94 { 12 }\n    else if c == 40 { 13 }\n    else if c == 41 { 14 }\n    else if c == 123 { 15 }\n    else 0\n  result\n}\n\n// Debug probe: char code at position 10\nexport let selfbuild_probe_char_at = () -> Int with { Error } {\n  let s = \"let add = (a: Int, b: Int) -> Int { a + b }\"\n  string_char_code_at(s, 10)\n}\n\n// Debug probe: fn_count in merged stmts\nexport let selfbuild_probe_fn_count = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  let merged = collect_merged_stmts(sources)\n  let mut count = 0\n  let mut i = 0\n  while i < array_length(merged) {\n    let stmt = array_get(merged, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => {\n        match expr {\n          EFn(_, _, _, _, _, _) => { count = count + 1 },\n          _ => ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  count\n}\n\n// Debug probe: selfhost_sources length\nexport let selfbuild_probe_sources_len = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  array_length(sources)\n}\n\n// Debug probe: merged stmts length\nexport let selfbuild_probe_merged_len = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  let merged = collect_merged_stmts(sources)\n  array_length(merged)\n}\n\n// Binary search: compile first N source files\nexport let selfbuild_probe_compile_first_5 = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  let first = array_slice(sources, 0, 5)\n  let merged = collect_merged_stmts(first)\n  let entry_tokens = lex(\"export let __probe_entry = () -> Int { 0 }\")\n  let entry_stmts = parse_program(entry_tokens)\n  let mut j = 0\n  while j < array_length(entry_stmts) { array_push(merged, array_get(entry_stmts, j)); j = j + 1 }\n  let bytes = compile_wasi_module(merged, \"__probe_entry\")\n  bytes_length(bytes)\n}\n\nexport let selfbuild_probe_compile_first_8 = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  let first = array_slice(sources, 0, 8)\n  let merged = collect_merged_stmts(first)\n  let entry_tokens = lex(\"export let __probe_entry = () -> Int { 0 }\")\n  let entry_stmts = parse_program(entry_tokens)\n  let mut j = 0\n  while j < array_length(entry_stmts) { array_push(merged, array_get(entry_stmts, j)); j = j + 1 }\n  let bytes = compile_wasi_module(merged, \"__probe_entry\")\n  bytes_length(bytes)\n}\n\nexport let selfbuild_probe_compile_first_10 = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  let first = array_slice(sources, 0, 10)\n  let merged = collect_merged_stmts(first)\n  let entry_tokens = lex(\"export let __probe_entry = () -> Int { 0 }\")\n  let entry_stmts = parse_program(entry_tokens)\n  let mut j = 0\n  while j < array_length(entry_stmts) { array_push(merged, array_get(entry_stmts, j)); j = j + 1 }\n  let bytes = compile_wasi_module(merged, \"__probe_entry\")\n  bytes_length(bytes)\n}\n\nexport let selfbuild_probe_compile_first_15 = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  let first = array_slice(sources, 0, 15)\n  let merged = collect_merged_stmts(first)\n  let entry_tokens = lex(\"export let __probe_entry = () -> Int { 0 }\")\n  let entry_stmts = parse_program(entry_tokens)\n  let mut j = 0\n  while j < array_length(entry_stmts) { array_push(merged, array_get(entry_stmts, j)); j = j + 1 }\n  let bytes = compile_wasi_module(merged, \"__probe_entry\")\n  bytes_length(bytes)\n}\n\n//# Misc\n\nexport {\n  Token, token_to_string, lex, Pat, Expr, TypeExpr, Stmt, Type, TypeEnv, Subst, TypeDef, parse, parse_ok, parse_expr, parse_type, parse_stmt, parse_program, print_expr, print_pat, print_type_expr, print_stmt, print_program, check_program, check_program_with_env, check_stmts, compile_module, compile_wasi_module, compile_wasi_module_with_sources, compile_wasi_module_gc, compile_source, compile_source_wasi, compile_file_fs, compile_file_fs_module, selfbuild_compile_stage2, selfbuild_entry, selfbuild_probe_lex, selfbuild_probe_parse, selfbuild_probe_check, selfbuild_probe_compile, selfbuild_probe_parse_count, selfbuild_probe_token_tag, selfbuild_probe_deep_if, selfbuild_probe_char_at, selfbuild_probe_fn_count, selfbuild_probe_sources_len, selfbuild_probe_merged_len, selfbuild_probe_compile_first_5, selfbuild_probe_compile_first_8, selfbuild_probe_compile_first_10, selfbuild_probe_compile_first_15\n}\n\nexport {\n  Pat, lex, Expr, Stmt, Token, Type, TypeEnv, Subst, TypeDef, parse, version, TypeExpr, parse_ok, print_pat, parse_expr, parse_stmt, parse_type, print_expr, print_stmt, compiler_lex, parse_program, print_program, compiler_parse, print_type_expr, token_to_string, compiler_parse_ok, compiler_print_pat, compiler_parse_expr, compiler_parse_stmt, compiler_parse_type, compiler_print_expr, compiler_print_stmt, compiler_parse_program, compiler_print_program, compiler_print_type_expr, check_program, check_program_with_env, check_stmts, compile_module, compile_wasi_module, compile_wasi_module_with_sources, compile_wasi_module_gc, compile_source, compile_source_wasi, compile_file_fs, compile_file_fs_module, selfbuild_compile_stage2, selfbuild_entry, selfbuild_probe_lex, selfbuild_probe_parse, selfbuild_probe_check, selfbuild_probe_compile, selfbuild_probe_parse_count, selfbuild_probe_token_tag, selfbuild_probe_deep_if, selfbuild_probe_char_at, selfbuild_probe_fn_count, selfbuild_probe_sources_len, selfbuild_probe_merged_len, selfbuild_probe_compile_first_5, selfbuild_probe_compile_first_8, selfbuild_probe_compile_first_10, selfbuild_probe_compile_first_15\n}\n")
  ]
}
