e(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtBool, None))\n  }\n  else None\n}\n\nlet lookup_array_join: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::join\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtString), CtString, None))\n  }\n  else None\n}\n\nlet lookup_array_length: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::length\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_array_group_a: (String) -> Option[Type] = (name) -> {\n  match lookup_array_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_length(name) {\n      Some(t) => Some(t),\n      None => match lookup_array_get(name) {\n        Some(t) => Some(t),\n        None => lookup_array_set(name)\n      }\n    }\n  }\n}\n\nlet lookup_array_push_all: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::push_all\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_array_truncate: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::truncate\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_array_group_b: (String) -> Option[Type] = (name) -> {\n  match lookup_array_push(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_slice(name) {\n      Some(t) => Some(t),\n      None => match lookup_array_push_all(name) {\n        Some(t) => Some(t),\n        None => match lookup_array_truncate(name) {\n          Some(t) => Some(t),\n          None => match lookup_array_concat(name) {\n            Some(t) => Some(t),\n            None => match lookup_array_map(name) {\n              Some(t) => Some(t),\n              None => match lookup_array_fold(name) {\n                Some(t) => Some(t),\n                None => match lookup_array_filter(name) {\n                  Some(t) => Some(t),\n                  None => match lookup