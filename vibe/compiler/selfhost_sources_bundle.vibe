let push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {
  let (path, source) = pair
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if String::equals(name, group_name) {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = Array::slice([("", "")], 0, 0)
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

  let source_0 = ("vibe/compiler/core/polyfill.vibe",
"//# Functions\n\nexport let __to_string = (n: Int) -> String {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n")

  let source_1 = ("vibe/compiler/core/bytebuf.vibe",
"//# Functions\n\nexport let bytebuf_new = () -> Array[Int] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nexport let bytebuf_push = (buf: Array[Int], byte: Int) -> Unit {\n  Array::push(buf, byte)\n}\n\nexport let bytebuf_length = (buf: Array[Int]) -> Int {\n  Array::length(buf)\n}\n\nexport let bytebuf_to_bytes = (buf: Array[Int]) -> Bytes {\n  Bytes::from_array(buf)\n}\n\nexport let leb128_encode_s32 = (buf: Array[Int], value: Int) -> Unit {\n  let mut v = value\n  let mut more = true\n  while more {\n    let byte = v&127\n    v = v>>7\n    if (v == 0) && ((byte&64) == 0) {\n      Array::push(buf, byte)\n      more = false\n    } else {\n      if (v == 0 - 1) && ((byte&64) != 0) {\n        Array::push(buf, byte)\n        more = false\n      } else {\n        Array::push(buf, byte|128)\n      }\n    }\n  }\n}\n\nexport let leb128_encode_s64 = (buf: Array[Int], value: Int) -> Unit {\n  leb128_encode_s32(buf, value)\n}\n\nexport let leb128_encode_u32 = (buf: Array[Int], value: Int) -> Unit {\n  let mut v = value\n  let mut more = true\n  while more {\n    let byte = v&127\n    v = (v>>7)&((1<<25) - 1)\n    if v == 0 {\n      Array::push(buf, byte)\n      more = false\n    } else {\n      Array::push(buf, byte|128)\n    }\n  }\n}\n\nexport let bytebuf_push_array = (dst: Array[Int], src: Array[Int]) -> Unit {\n  Array::push_all(dst, src)\n}\n\nexport let bytebuf_push_bytes = (buf: Array[Int], bytes: Bytes) -> Unit {\n  let blen = Bytes::length(bytes)\n  let mut i = 0\n  while i < blen {\n    bytebuf_push(buf, bytes[i])\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push_section = (out: Array[Int], section_id: Int, content: Array[Int]) -> Unit {\n  bytebuf_push(out, section_id)\n  leb128_encode_u32(out, bytebuf_length(content))\n  bytebuf_push_buf(out, content)\n}\n\nexport let bytebuf_push_vec_header = (buf: Array[Int], count: Int) -> Unit {\n  leb128_encode_u32(buf, count)\n}\n\nexport let bytebuf_push_buf = (dst: Array[Int], src: Array[Int]) -> Unit {\n  Array::push_all(dst, src)\n}\n\nexport let bytebuf_push2 = (buf: Array[Int], b1: Int, b2: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n}\n\nexport let bytebuf_push3 = (buf: Array[Int], b1: Int, b2: Int, b3: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n}\n\nexport let bytebuf_push_opcode_u32 = (buf: Array[Int], opcode: Int, value: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_u32(buf, value)\n}\n\nexport let bytebuf_push_opcode_s64 = (buf: Array[Int], opcode: Int, value: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_s32(buf, value)\n}\n\nexport let bytebuf_push_opcode_u32_u32 = (buf: Array[Int], opcode: Int, a: Int, b: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_u32(buf, a)\n  leb128_encode_u32(buf, b)\n}\n\nexport let bytebuf_push_string = (buf: Array[Int], s: String) -> Unit {\n  let slen = String::length(s)\n  leb128_encode_u32(buf, slen)\n  let mut i = 0\n  while i < slen {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push9 = (buf: Array[Int], b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int, b8: Int, b9: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n  bytebuf_push(buf, b4)\n  bytebuf_push(buf, b5)\n  bytebuf_push(buf, b6)\n  bytebuf_push(buf, b7)\n  bytebuf_push(buf, b8)\n  bytebuf_push(buf, b9)\n}\n")

  let source_2 = ("vibe/compiler/core/ast.vibe",
"//# Types\n\nexport enum Pat {\n  PWild;\n  PBind(String);\n  PInt(Int);\n  PString(String);\n  PBool(Bool);\n  PCtor(String, Array[Pat]);\n  PTuple(Array[Pat]);\n  POr(Pat, Pat)\n}\n\nexport enum TypeExpr {\n  TyName(String);\n  TyApp(String, Array[TypeExpr]);\n  TyFn(Array[TypeExpr], TypeExpr);\n  TyTuple(Array[TypeExpr]);\n  TyUnit\n}\n\nexport enum Expr {\n  EInt(Int);\n  EFloat(Double);\n  EString(String);\n  EBool(Bool);\n  EIdent(String);\n  ETuple(Array[Expr]);\n  EArray(Array[Expr]);\n  ERecord(Array[(String, Expr)]);\n  EIf(Expr, Expr, Expr);\n  ELet(String, Expr, Expr);\n  ELetRec(String, Expr, Expr);\n  ELetMut(String, Expr, Expr);\n  EAssign(String, Expr, Expr);\n  EAssignOp(String, String, Expr, Expr);\n  ESeq(Expr, Expr);\n  EMatch(Expr, Array[(Pat, Expr)]);\n  EHandle(Expr, Array[(Pat, Expr)]);\n  EWhile(Expr, Expr);\n  ELoop(Array[(String, Expr)], Expr);\n  EForIn(String, Option[String], Expr, Expr);\n  ECall(Expr, Array[Expr]);\n  EBinOp(String, Expr, Expr);\n  EUnaryOp(String, Expr);\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\n  EDot(Expr, String);\n  ELabeledArg(String, String, Expr);\n  EThrow(Expr);\n  EBreak(Option[Expr]);\n  EContinue(Array[Expr]);\n  EMap(Array[(String, Expr)]);\n  ESpread(Expr);\n  EStringInterp(Array[String]);\n  EUnit\n}\n\nexport enum Stmt {\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\n  SLetMut(String, Option[TypeExpr], Expr);\n  SEnum(Bool, String, Array[(String, Array[TypeExpr])]);\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\n  SStruct(Bool, String, Array[(String, TypeExpr)]);\n  STypeAlias(Bool, String, TypeExpr);\n  STrait(Bool, String, Array[String]);\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\n  SExternLet(String, TypeExpr);\n  SImport(String, Array[(String, Option[String])]);\n  STest(String, Expr);\n  SBench(String, Expr);\n  SExpr(Expr);\n  SExport(Array[String]);\n  SReExport(String, Array[(String, Option[String])]);\n  SModule(Bool, String, Array[Stmt])\n}\n")

  let source_3 = ("vibe/compiler/core/types.vibe",
"//# Types\n\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Bool);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)]);\n  TDAlias(String, Type)\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst)\n}\n\n//# Functions\n\nexport let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {\n  EnvBind(name, ty, env)\n}\n\nexport let fresh_var = (c: Int) -> (Type, Int) {\n  (CtVar(c), c + 1)\n}\n\nexport let rec occurs_in = (id: Int, ty: Type) -> Bool {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        if occurs_in(id, Array::get(params, i)) {\n          found = true\n          i = Array::length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if occurs_in(id, Array::get(elems, i)) {\n          found = true\n          i = Array::length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport let rec env_lookup = (env: TypeEnv, name: String) -> Option[Type] {\n  match env {\n    EnvEmpty => None,\n    EnvBind(n, ty, rest) => if n == name {\n      Some(ty)\n    } else env_lookup(rest, name),\n    EnvTraitDef(_, _, _, rest) => env_lookup(rest, name),\n    EnvTraitImpl(_, _, rest) => env_lookup(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => env_lookup(rest, name)\n  }\n}\n\nlet empty_env_bindings = () -> Array[(String, Type)] {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let env_flat_bindings = (env: TypeEnv) -> Array[(String, Type)] {\n  let out = empty_env_bindings()\n  let mut cur = env\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(name, ty, rest) => {\n        Array::push(out, (name, ty))\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let env_lookup_flat = (bindings: Array[(String, Type)], name: String) -> Option[Type] {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = Array::get(bindings, i)\n      if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet join_types = (arr: Array[String], sep: String) -> String {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut acc = \"\"\n  while (!(i >= len)) {\n    let s = if i > 0 {\n      \"\\{acc}\\{sep}\\{Array::get(arr, i)}\"\n    } else Array::get(arr, i)\n    acc = s\n    i = i + 1\n  }\n  acc\n}\n\nlet string_array_equal = (left: Array[String], right: Array[String]) -> Bool {\n  let len = Array::length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else if (!(Array::get(left, i) == Array::get(right, i))) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport let rec types_equal = (a: Type, b: Type) -> Bool {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => aname == bname,\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => aname == bname,\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtNamed(bname, bargs) =>\n      if (!(aname == bname)) {\n        false\n      } else if (Array::length(aargs) != Array::length(bargs)) {\n        false\n      } else {\n        let tae_len = Array::length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while (!(tae_done)) {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else if (!(types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)))) {\n            tae_result = false\n            tae_done = true\n          } else {\n            tae_i = tae_i + 1\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if (Array::length(aelems) != Array::length(belems)) {\n        false\n      } else {\n        let tae_len2 = Array::length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while (!(tae_done2)) {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else if (!(types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)))) {\n            tae_result2 = false\n            tae_done2 = true\n          } else {\n            tae_i2 = tae_i2 + 1\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, ahas_error) => match b {\n      CtFn(bparams, bret, bhas_error) =>\n      if (Array::length(aparams) != Array::length(bparams)) {\n        false\n      } else if ahas_error {\n        if (!(bhas_error)) {\n          false\n        } else {\n          let tae_len3 = Array::length(aparams)\n          let mut tae_i3 = 0\n          let mut tae_result3 = true\n          let mut tae_done3 = false\n          while (!(tae_done3)) {\n            if tae_i3 >= tae_len3 {\n              tae_done3 = true\n            } else if (!(types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)))) {\n              tae_result3 = false\n              tae_done3 = true\n            } else {\n              tae_i3 = tae_i3 + 1\n            }\n          }\n          if (!(tae_result3)) {\n            false\n          } else {\n            types_equal(aret, bret)\n          }\n        }\n      } else if bhas_error {\n        false\n      } else {\n        let tae_len4 = Array::length(aparams)\n        let mut tae_i4 = 0\n        let mut tae_result4 = true\n        let mut tae_done4 = false\n        while (!(tae_done4)) {\n          if tae_i4 >= tae_len4 {\n            tae_done4 = true\n          } else if (!(types_equal(Array::get(aparams, tae_i4), Array::get(bparams, tae_i4)))) {\n            tae_result4 = false\n            tae_done4 = true\n          } else {\n            tae_i4 = tae_i4 + 1\n          }\n        }\n        if (!(tae_result4)) {\n          false\n        } else {\n          types_equal(aret, bret)\n        }\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => {\n        if (Array::length(avars) != Array::length(bvars)) {\n          false\n        } else if (Array::length(abounds) != Array::length(bbounds)) {\n          false\n        } else {\n          // inline var_list_equal\n          let vlen = Array::length(avars)\n          let mut vi = 0\n          let mut vresult = true\n          let mut vdone = false\n          while (!(vdone)) {\n            if vi >= vlen {\n              vdone = true\n            } else if (Array::get(avars, vi) != Array::get(bvars, vi)) {\n              vresult = false\n              vdone = true\n            } else {\n              vi = vi + 1\n            }\n          }\n          if (!(vresult)) {\n            false\n          } else {\n            // inline forall_bounds_equal\n            let fbe_len = Array::length(abounds)\n            let mut fbe_i = 0\n            let mut fbe_result = true\n            let mut fbe_done = false\n            while (!(fbe_done)) {\n              if fbe_i >= fbe_len {\n                fbe_done = true\n              } else {\n                let (lvar, lbounds) = Array::get(abounds, fbe_i)\n                let (rvar, rbounds) = Array::get(bbounds, fbe_i)\n                if (lvar != rvar) {\n                  fbe_result = false\n                  fbe_done = true\n                } else if (Array::length(lbounds) != Array::length(rbounds)) {\n                  fbe_result = false\n                  fbe_done = true\n                } else if (!(string_array_equal(lbounds, rbounds))) {\n                  fbe_result = false\n                  fbe_done = true\n                } else {\n                  fbe_i = fbe_i + 1\n                }\n              }\n            }\n            if (!(fbe_result)) {\n              false\n            } else {\n              types_equal(abody, bbody)\n            }\n          }\n        }\n      },\n      _ => false\n    }\n  }\n}\n\nexport let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while (!(i >= len)) {\n    let (name, ty) = Array::get(bindings, i)\n    acc = EnvBind(name, ty, acc)\n    i = i + 1\n  }\n  acc\n}\n\nexport let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {\n  let len = Array::length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else {\n      let d = Array::get(defs, i)\n      let dname = match d {\n        TDEnum(n, _) => n,\n        TDStruct(n, _) => n,\n        TDAlias(n, _) => n\n      }\n      if dname == name {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet subst_bounds = (s: Subst, id: Int) -> Array[String] {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut cur = s\n  let mut out = empty\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(bid, bounds, rest) => {\n        if (bid == id) {\n          out = bounds\n          done = true\n        } else {\n          cur = rest\n        }\n      }\n    }\n  }\n  out\n}\n\nlet rec int_bounds_has_id = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {\n  if i >= Array::length(pairs) {\n    false\n  } else {\n    let (pid, _) = Array::get(pairs, i)\n    if (pid == id) {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_bounds_lookup = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {\n  if i >= Array::length(pairs) {\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    let (pid, bounds) = Array::get(pairs, i)\n    if (pid == id) {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nlet collect_subst_bounds_pairs = (s: Subst) -> Array[(Int, Array[String])] {\n  let out = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut cur = s\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if (!(int_bounds_has_id(out, id, 0))) {\n          Array::push(out, (id, bounds))\n        }\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nlet rec int_int_lookup_or = (pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {\n  if i >= Array::length(pairs) {\n    fallback\n  } else {\n    let (k, v) = Array::get(pairs, i)\n    if (k == key) {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\nexport let subst_lookup = (s: Subst, id: Int) -> Option[Type] {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => {\n        if (i == id) {\n          out = Some(ty)\n          done = true\n        } else {\n          cur = rest\n        }\n      },\n      SubstBound(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nlet int_array_has = (arr: Array[Int], v: Int) -> Bool {\n  let slen = Array::length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while (!(sdone)) {\n    if si >= slen {\n      sdone = true\n    } else if (Array::get(arr, si) == v) {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nexport let rec subst_apply = (s: Subst, ty: Type) -> Type {\n  match ty {\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = Array::slice([\n        0\n      ], 0, 0)\n      while (!(done)) {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            Array::push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          }\n          ,\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, he) => {\n      let rp = for p in params {\n        subst_apply(s, p)\n      }\n      CtFn(rp, subst_apply(s, ret), he)\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => match ta {\n                CtArray(ea) => match tb {\n                  CtArray(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtOption(ea) => match tb {\n                  CtOption(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtFn(pa, ra, _) => match tb {\n                  CtFn(pb, rb, _) => if (Array::length(pa) != Array::length(pb)) {\n                    None\n                  }\n                  else {\n                    let ul_len = Array::length(pa)\n                    let mut ul_i = 0\n                    let mut ul_acc = s\n                    let mut ul_result = Some(s)\n                    let mut ul_done = false\n                    while (!(ul_done)) {\n                      if ul_i >= ul_len {\n                        ul_result = Some(ul_acc)\n                        ul_done = true\n                      } else {\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\n                          Some(s2) => {\n                            ul_acc = s2\n                            ul_i = ul_i + 1\n                          },\n                          None => {\n                            ul_result = None\n                            ul_done = true\n                          }\n                        }\n                      }\n                    }\n                    match ul_result {\n                      Some(s2) => unify(ra, rb, s2),\n                      None => None\n                    }\n                  }\n                  ,\n                  _ => None\n                },\n                CtTuple(ea) => match tb {\n                  CtTuple(eb) => if (Array::length(ea) != Array::length(eb)) {\n                    None\n                  }\n                  else {\n                    let ul_len2 = Array::length(ea)\n                    let mut ul_i2 = 0\n                    let mut ul_acc2 = s\n                    let mut ul_result2 = Some(s)\n                    let mut ul_done2 = false\n                    while (!(ul_done2)) {\n                      if ul_i2 >= ul_len2 {\n                        ul_result2 = Some(ul_acc2)\n                        ul_done2 = true\n                      } else {\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\n                          Some(s2) => {\n                            ul_acc2 = s2\n                            ul_i2 = ul_i2 + 1\n                          },\n                          None => {\n                            ul_result2 = None\n                            ul_done2 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result2\n                  }\n                  ,\n                  _ => None\n                },\n                CtEnum(a_name) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtStruct(a_name) => match tb {\n                  CtStruct(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtNamed(a_name, a_args) => match tb {\n                  CtNamed(b_name, b_args) => if (!(a_name == b_name)) {\n                    None\n                  }\n                  else if (Array::length(a_args) != Array::length(b_args)) {\n                    None\n                  }\n                  else {\n                    let ul_len3 = Array::length(a_args)\n                    let mut ul_i3 = 0\n                    let mut ul_acc3 = s\n                    let mut ul_result3 = Some(s)\n                    let mut ul_done3 = false\n                    while (!(ul_done3)) {\n                      if ul_i3 >= ul_len3 {\n                        ul_result3 = Some(ul_acc3)\n                        ul_done3 = true\n                      } else {\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\n                          Some(s2) => {\n                            ul_acc3 = s2\n                            ul_i3 = ul_i3 + 1\n                          },\n                          None => {\n                            ul_result3 = None\n                            ul_done3 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result3\n                  }\n                  ,\n                  _ => None\n                },\n                _ => None\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let rec trait_supers = (env: TypeEnv, name: String) -> Array[String] {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, rest) => if tname == name {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name)\n  }\n}\n\nlet rec array_has_int = (arr: Array[Int], val: Int, i: Int) -> Bool {\n  if i >= Array::length(arr) {\n    false\n  }\n  else if (Array::get(arr, i) == val) {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nlet rec collect_tvars_walk = (t: Type, out: Array[Int]) -> Int {\n  match t {\n    CtVar(id) => {\n      if (!(array_has_int(out, id, 0))) {\n        Array::push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport let collect_tvars = (ty: Type) -> Array[Int] {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nexport let generalize = (s: Subst, ty: Type) -> Type {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if (Array::length(tvars) == 0) {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = Array::slice([\n      (0, Array::slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0)\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if (Array::length(bounds) != 0) {\n        Array::push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nexport let rec trait_defined = (env: TypeEnv, name: String) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, rest) => if tname == name {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name)\n  }\n}\n\nexport let rec type_to_string = (ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => \"?t\\{id}\",\n    CtForAll(vars, _, body) => {\n      let vlen = Array::length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while (!(vi >= vlen)) {\n        let v = \"?t\\{Array::get(vars, vi)}\"\n        let next = if vi > 0 {\n          \"\\{vacc} \\{v}\"\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      \"forall \\{vacc}. \\{type_to_string(body)}\"\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => \"Array[\\{type_to_string(elem)}]\",\n    CtOption(elem) => \"Option[\\{type_to_string(elem)}]\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if (Array::length(args) == 0) {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      \"\\{name}[\\{join_types(parts, \", \")}]\"\n    }\n    ,\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      \"(\\{join_types(parts, \", \")})\"\n    },\n    CtFn(params, ret, has_error) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let base = \"(\\{join_types(parts, \", \")}) -> \\{type_to_string(ret)}\"\n      if has_error {\n        \"\\{base} with {Error}\"\n      } else base\n    }\n  }\n}\n\nexport let resolve_builtin = (name: String) -> Option[Type] {\n  if name == \"Int\" {\n    Some(CtInt)\n  }\n  else if name == \"Double\" {\n    Some(CtDouble)\n  }\n  else if name == \"Bool\" {\n    Some(CtBool)\n  }\n  else if name == \"String\" {\n    Some(CtString)\n  }\n  else if name == \"Char\" {\n    Some(CtChar)\n  }\n  else if name == \"Unit\" {\n    Some(CtUnit)\n  }\n  else if name == \"Bytes\" {\n    Some(CtBytes)\n  }\n  else None\n}\n\nexport let subst_add_bound = (s: Subst, id: Int, bounds: Array[String]) -> Subst {\n  SubstBound(id, bounds, s)\n}\n\nlet empty_var_bounds = () -> Array[(Int, Array[String])] {\n  Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n}\n\nexport let instantiate = (ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = Array::length(bound_vars)\n      let id_map = Array::slice([\n        (0, 0)\n      ], 0, 0)\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      let mut bnc = c\n      while (!(bi >= blen)) {\n        let old_id = Array::get(bound_vars, bi)\n        Array::push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      // Remap var_bounds: old_id -> new_id\n      let new_bounds = Array::slice([\n        (0, Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        Array::push(new_bounds, (new_id, bounds))\n      };\n      (subst_apply(inst_s, body), c1, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport let types_compatible = (expected: Type, actual: Type) -> Bool {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport let rec impls_overlap_for = (env: TypeEnv, trait_name: String, new_target: Type) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nexport let rec trait_is_subtrait = (env: TypeEnv, sub: String, super_name: String) -> Bool {\n  // DFS: sub's supers include super_name, or any of sub's supers is a subtrait of super_name\n  if sub == super_name {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = Array::length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while (!(sdone)) {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = Array::get(supers, si)\n        if s == super_name {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nlet rec type_implements_check_super = (e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\nlet rec type_implements_check_env = (e: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nexport let rec type_implements_trait = (env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else {\n    // Check supertrait: if trait_name has subtrait impls\n    let supers = trait_supers(env, trait_name)\n    let slen = Array::length(supers)\n    if (slen == 0) {\n      false\n    }\n    else {\n      // Type implements trait_name if it implements all supers? No — reversed:\n      // If T implements sub-trait B where B: A, then T also implements A\n      // So check all traits that the type implements and see if any is a subtrait of trait_name\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n")

  let source_4 = ("vibe/compiler/core/dce.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nlet clone_arr = (arr: Array[String]) -> Array[String] {\n  Array::slice(arr, 0, Array::length(arr))\n}\n\nlet stmt_name = (stmt: Stmt) -> Option[String] {\n  match stmt {\n    SLet(_, _, name, _, _) => Some(name),\n    SLetMut(name, _, _) => Some(name),\n    _ => None\n  }\n}\n\nlet array_contains_str = (arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let rec search = (i: Int) -> Bool {\n    if i >= len {\n      false\n    }\n    else if Array::get(arr, i) == s {\n      true\n    }\n    else search(i + 1)\n  }\n  search(0)\n}\n\nlet add_ref = (out: Array[String], bound: Array[String], name: String) -> Int {\n  if not(array_contains_str(bound, name)) {\n    if not(array_contains_str(out, name)) {\n      Array::push(out, name)\n    }\n  }\n  0\n}\n\nlet rec collect_pat_bindings = (pat: Pat, bound: Array[String]) -> Int {\n  match pat {\n    PWild => 0,\n    PBind(name) => {\n      Array::push(bound, name)\n      0\n    },\n    PInt(_) => 0,\n    PString(_) => 0,\n    PBool(_) => 0,\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    POr(p1, p2) => {\n      collect_pat_bindings(p1, bound)\n      collect_pat_bindings(p2, bound)\n      0\n    }\n  }\n}\n\nlet rec collect_refs_into = (expr: Expr, bound: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name) => add_ref(out, bound, name)\n    ,\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(e) => collect_refs_into(e, bound, out)\n    ,\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out)\n    ,\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    ECall(callee, args) => {\n      collect_refs_into(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_refs_into(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(then_e, bound, out)\n      collect_refs_into(else_e, bound, out)\n      0\n    },\n    ELet(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetRec(name, val, body) => {\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(val, bound2, out)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetMut(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EAssign(_, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ESeq(l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    EMatch(scr, arms) => {\n      collect_refs_into(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(body_expr, arms) => {\n      collect_refs_into(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(arm_body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ELoop(params, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        collect_refs_into(init, bound2, out)\n        Array::push(bound2, name)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EForIn(name, index_name, iter, body) => {\n      collect_refs_into(iter, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      match index_name {\n        Some(index_name) => Array::push(bound2, index_name),\n        None => ()\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(bound2, pname)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EDot(obj, _) => {\n      collect_refs_into(obj, bound, out)\n      0\n    },\n    ELabeledArg(_, _, e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EStringInterp(_) => 0\n  }\n}\n\nlet collect_refs = (expr: Expr, bound: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_refs_into(expr, bound, out)\n  out\n}\n\nlet is_type_or_structural = (stmt: Stmt) -> Bool {\n  match stmt {\n    SEnum(_, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SStruct(_, _, _) => true,\n    STypeAlias(_, _, _) => true,\n    STrait(_, _, _) => true,\n    SImpl(_, _, _, _) => true,\n    SExternLet(_, _) => true,\n    SImport(_, _) => true,\n    STest(_, _) => true,\n    SBench(_, _) => true,\n    SExpr(_) => true,\n    SExport(_) => true,\n    SReExport(_, _) => true,\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport let dce_stmts = (stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    if not(array_contains_str(reachable, name)) {\n      Array::push(reachable, name)\n      Array::push(queue, name)\n    }\n    j = j + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  let result = Array::slice([\n    Array::get(stmts, 0)\n  ], 0, 0)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    let stmt = Array::get(stmts, m)\n    if is_type_or_structural(stmt) {\n      Array::push(result, stmt)\n    } else {\n      match stmt_name(stmt) {\n        Some(name) => if array_contains_str(reachable, name) {\n          Array::push(result, stmt)\n        }\n        ,\n        None => Array::push(result, stmt)\n      }\n    }\n    m = m + 1\n  }\n  result\n}\n")

  let source_5 = ("vibe/compiler/core/index.vibe",
"export let version = \"0.1.0\"\n\nexport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nexport ./polyfill.vibe {\n  __to_string\n}\n\nexport ./bytebuf.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_array, bytebuf_push_bytes, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_push_buf, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32, bytebuf_push_string\n}\n\nexport ./dce.vibe {\n  dce_stmts\n}\n\nexport ./types.vibe {\n  Type, TypeDef, TypeEnv, Subst, env_bind, fresh_var, occurs_in, env_lookup, env_flat_bindings, env_lookup_flat, types_equal, env_bind_all, find_typedef, subst_lookup, subst_apply, unify, trait_supers, collect_tvars, generalize, trait_defined, type_to_string, resolve_builtin, subst_add_bound, instantiate, types_compatible, impls_overlap_for, trait_is_subtrait, type_implements_trait\n}\n")

  let source_6 = ("vibe/compiler/codegen/wasm_emit/index.vibe",
"// WASM binary emitter — generates minimal valid .wasm modules\n// Uses bytebuf.vibe for byte-level binary construction\n\nimport ../../core/index.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes,\n  bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header,\n  leb128_encode_u32, leb128_encode_s64,\n  bytebuf_push2, bytebuf_push3, bytebuf_push9,\n  bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32,\n  bytebuf_push_string\n}\n\n// === Emit helpers ===\n\n// Emit WASM magic number and version\nexport let emit_header = (buf: Array[Int]) -> Unit {\n  // \\0asm + version 1 (8 bytes via two push3 + push2)\n  bytebuf_push3(buf, 0, 97, 115)\n  bytebuf_push3(buf, 109, 1, 0)\n  bytebuf_push2(buf, 0, 0)\n}\n\n// Encode a function type: (i64 x param_count) -> (i64 x result_count)\nexport let emit_func_type = (buf: Array[Int], param_count: Int, result_count: Int) -> Unit {\n  bytebuf_push(buf, 96)  // 0x60 = func type marker\n  leb128_encode_u32(buf, param_count)\n  let mut i = 0\n  while i < param_count {\n    bytebuf_push(buf, 126)  // i64\n    i = i + 1\n  }\n  leb128_encode_u32(buf, result_count)\n  let mut j = 0\n  while j < result_count {\n    bytebuf_push(buf, 126)  // i64\n    j = j + 1\n  }\n}\n\n// Emit type section with multiple function types\n// type_defs: flat array of [param_count, result_count, param_count, result_count, :.]\nexport let emit_type_section_multi = (out: Array[Int], type_defs: Array[Int]) -> Unit {\n  let count = Array::length(type_defs) / 2\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 1, content)\n}\n\n// Emit type section with a single function type (convenience)\nexport let emit_type_section = (out: Array[Int], param_count: Int, result_count: Int) -> Unit {\n  emit_type_section_multi(out, [param_count, result_count])\n}\n\n// Emit function section — maps function indices to type indices\nexport let emit_function_section = (out: Array[Int], type_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(type_indices))\n  let mut i = 0\n  while i < Array::length(type_indices) {\n    leb128_encode_u32(content, Array::get(type_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 3, content)\n}\n\n// Helper: emit a name string (length-prefixed ASCII)\nexport let emit_name = (buf: Array[Int], name: String) -> Unit {\n  bytebuf_push_string(buf, name)\n}\n\n// Emit export section with multiple exports\n// names: array of export names, func_indices: matching array of function indices\nexport let emit_export_section_multi = (out: Array[Int], names: Array[String], func_indices: Array[Int]) -> Unit {\n  let count = Array::length(names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_name(content, Array::get(names, i))\n    bytebuf_push(content, 0)  // export kind: function\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit export section — single export (convenience)\nexport let emit_export_section = (out: Array[Int], name: String, func_idx: Int) -> Unit {\n  emit_export_section_multi(out, [name], [func_idx])\n}\n\n// Emit memory section: 1 memory with min pages, no max\nexport let emit_memory_section = (out: Array[Int], min_pages: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 memory\n  bytebuf_push(content, 0)  // limits: no max\n  leb128_encode_u32(content, min_pages)\n  bytebuf_push_section(out, 5, content)\n}\n\n// Emit a code section with function bodies\n// Each body is pre-encoded instructions (without end opcode)\nexport let emit_code_section = (out: Array[Int], bodies: Array[Array[Int]]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let func_buf = bytebuf_new()\n    leb128_encode_u32(func_buf, 0)  // 0 local declarations\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end opcode\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_array(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\n// Emit code section with local declarations\n// local_decls: array of [count, valtype] pairs per function (flat)\n// For now: emit one block of count locals of type i64\nexport let emit_code_section_with_locals = (out: Array[Int], bodies: Array[Array[Int]], local_counts: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let num_locals = Array::get(local_counts, i)\n    let func_buf = bytebuf_new()\n    if num_locals == 0 {\n      leb128_encode_u32(func_buf, 0)  // 0 local decl blocks\n    } else {\n      leb128_encode_u32(func_buf, 1)  // 1 local decl block\n      leb128_encode_u32(func_buf, num_locals)\n      bytebuf_push(func_buf, 126)  // i64\n    }\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_array(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\n// === Instruction emitters ===\n\nexport let emit_local_get = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 32, idx)\n}\n\nexport let emit_local_set = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 33, idx)\n}\n\nexport let emit_local_tee = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 34, idx)\n}\n\nexport let emit_i64_const = (buf: Array[Int], value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, 66, value)\n}\n\nexport let emit_i64_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 124)\n}\n\nexport let emit_i64_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 125)\n}\n\nexport let emit_i64_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 126)\n}\n\nexport let emit_i64_div_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 127)\n}\n\nexport let emit_i64_rem_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 129)  // 0x81\n}\n\nexport let emit_i64_and = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 131)  // 0x83\n}\n\nexport let emit_i64_or = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 132)  // 0x84\n}\n\nexport let emit_i64_xor = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 133)  // 0x85\n}\n\nexport let emit_i64_shl = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 134)  // 0x86\n}\n\nexport let emit_i64_shr_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 135)  // 0x87\n}\n\nexport let emit_i64_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 81)  // 0x51\n}\n\nexport let emit_i64_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 82)  // 0x52\n}\n\nexport let emit_i64_lt_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 83)  // 0x53\n}\n\nexport let emit_i64_gt_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 85)  // 0x55\n}\n\nexport let emit_i64_le_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 87)  // 0x57\n}\n\nexport let emit_i64_ge_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 89)  // 0x59\n}\n\nexport let emit_i64_eqz = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 80)  // 0x50\n}\n\nexport let emit_call = (buf: Array[Int], func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 16, func_idx)\n}\n\nexport let emit_drop = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 26)  // drop\n}\n\nexport let emit_return = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 15)  // return\n}\n\n// Control flow: block types\n// 0x40 = void block, 0x7E = i64 block\nexport let emit_block_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, 2, 64)\n}\n\nexport let emit_block_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, 2, 126)\n}\n\nexport let emit_loop_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, 3, 64)\n}\n\nexport let emit_if_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, 4, 64)\n}\n\nexport let emit_if_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, 4, 126)\n}\n\nexport let emit_else = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 5)   // else\n}\n\nexport let emit_end = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 11)  // end\n}\n\nexport let emit_br = (buf: Array[Int], label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 12, label)\n}\n\nexport let emit_br_if = (buf: Array[Int], label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 13, label)\n}\n\n// i64.extend_i32_s — extend i32 comparison result to i64\nexport let emit_i64_extend_i32_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 172)  // 0xAC\n}\n\n// i32.wrap_i64 — truncate i64 to i32\nexport let emit_i32_wrap_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 167)  // 0xA7\n}\n\n// === i32 instructions (needed for WASI APIs) ===\n\nexport let emit_i32_const = (buf: Array[Int], value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, 65, value)\n}\n\nexport let emit_i32_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 106)  // 0x6A\n}\n\nexport let emit_i32_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 54, align, offset)\n}\n\nexport let emit_i32_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 40, align, offset)\n}\n\nexport let emit_i32_store8 = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 58, align, offset)\n}\n\nexport let emit_i32_load8_u = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 45, align, offset)\n}\n\n// === Section emitters: Import, Data, Global ===\n\n// Emit raw func type with explicit valtype arrays\n// param_types/result_types: arrays of valtype ints (126=i64, 127=i32)\nexport let emit_func_type_raw = (buf: Array[Int], param_types: Array[Int], result_types: Array[Int]) -> Unit {\n  bytebuf_push(buf, 96)  // 0x60\n  leb128_encode_u32(buf, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    bytebuf_push(buf, Array::get(param_types, i))\n    i = i + 1\n  }\n  leb128_encode_u32(buf, Array::length(result_types))\n  let mut j = 0\n  while j < Array::length(result_types) {\n    bytebuf_push(buf, Array::get(result_types, j))\n    j = j + 1\n  }\n}\n\n// Emit import section: import a function\n// module_name, field_name: import path, type_idx: type index\nexport let emit_import_section_func = (out: Array[Int], module_name: String, field_name: String, type_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 import\n  emit_name(content, module_name)\n  emit_name(content, field_name)\n  bytebuf_push(content, 0)  // import kind: function\n  leb128_encode_u32(content, type_idx)\n  bytebuf_push_section(out, 2, content)  // section id 2 = import\n}\n\n// Emit data section: place byte data at a memory offset\n// segments: array of [offset, data_buf] pairs\nexport let emit_data_section = (out: Array[Int], offset: Int, data: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 data segment\n  // Active data segment: memory index 0\n  bytebuf_push(content, 0)  // flags: active, memory 0\n  // Offset expression: i32.const <offset>, end\n  emit_i32_const(content, offset)\n  emit_end(content)\n  // Data bytes\n  leb128_encode_u32(content, Array::length(data))\n  bytebuf_push_array(content, data)\n  bytebuf_push_section(out, 11, content)  // section id 11 = data\n}\n\n// Emit global section: one mutable i32 global with initial value\nexport let emit_global_section_i32_mut = (out: Array[Int], init_value: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 global\n  bytebuf_push2(content, 127, 1)  // i32, mutable\n  emit_i32_const(content, init_value)\n  emit_end(content)\n  bytebuf_push_section(out, 6, content)  // section id 6 = global\n}\n\nexport let emit_global_get = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 35, idx)\n}\n\nexport let emit_global_set = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 36, idx)\n}\n\n// Emit export for memory\nexport let emit_export_memory = (out: Array[Int], name: String, mem_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, name)\n  bytebuf_push(content, 2)  // export kind: memory\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit combined export section: functions + optional memory\nexport let emit_exports_with_memory = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {\n  let count = Array::length(fn_names) + 1\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  // Function exports\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, 0)  // function\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  // Memory export\n  emit_name(content, mem_name)\n  bytebuf_push(content, 2)  // memory\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit export section with functions, memory, and globals\n// Export kinds: 0=func, 1=table, 2=memory, 3=global\nexport let emit_exports_full = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  // Function exports\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, 0)  // function\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  // Memory export\n  emit_name(content, mem_name)\n  bytebuf_push(content, 2)  // memory\n  leb128_encode_u32(content, mem_idx)\n  // Global exports\n  let mut gi = 0\n  while gi < Array::length(global_names) {\n    emit_name(content, Array::get(global_names, gi))\n    bytebuf_push(content, 3)  // global\n    leb128_encode_u32(content, Array::get(global_indices, gi))\n    gi = gi + 1\n  }\n  bytebuf_push_section(out, 7, content)\n}\n\n// === High-level: build a complete module ===\n\n// Build a minimal WASM module with one exported function: add(i64, i64) -> i64\nexport let build_add_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, [body])\n  bytebuf_to_bytes(out)\n}\n\n// Build a module with internal call: square(x) = x*x, sum_sq(a,b) = square(a) + square(b)\nexport let build_call_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // 2 types: type0 = (i64) -> (i64), type1 = (i64, i64) -> (i64)\n  emit_type_section_multi(out, [1, 1, 2, 1])\n\n  // 2 functions: func0=square(type0), func1=sum_sq(type1)\n  emit_function_section(out, [0, 1])\n\n  // export both\n  emit_export_section_multi(out, [\"square\", \"sum_sq\"], [0, 1])\n\n  // square: x * x\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n\n  // sum_sq: square(a) + square(b)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)  // call square\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)  // call square\n  emit_i64_add(ss_body)\n\n  emit_code_section(out, [sq_body, ss_body])\n  bytebuf_to_bytes(out)\n}\n\n// Build a module with add, sub, mul exported (all using same type: (i64, i64) -> i64)\nexport let build_arithmetic_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // 1 type: (i64, i64) -> (i64)\n  emit_type_section(out, 2, 1)\n\n  // 3 functions, all type 0\n  emit_function_section(out, [0, 0, 0])\n\n  // 3 exports\n  emit_export_section_multi(out, [\"add\", \"sub\", \"mul\"], [0, 1, 2])\n\n  // 3 function bodies\n  let add_body = bytebuf_new()\n  emit_local_get(add_body, 0)\n  emit_local_get(add_body, 1)\n  emit_i64_add(add_body)\n\n  let sub_body = bytebuf_new()\n  emit_local_get(sub_body, 0)\n  emit_local_get(sub_body, 1)\n  emit_i64_sub(sub_body)\n\n  let mul_body = bytebuf_new()\n  emit_local_get(mul_body, 0)\n  emit_local_get(mul_body, 1)\n  emit_i64_mul(mul_body)\n\n  emit_code_section(out, [add_body, sub_body, mul_body])\n  bytebuf_to_bytes(out)\n}\n\n// Build fibonacci module: fib(n) iterative\n// params: n (local 0)\n// locals: a (local 1), b (local 2), tmp (local 3)\n// Algorithm: a=0, b=1, while(n>0) { tmp=a+b; a=b; b=tmp; n=n-1 }; return a\nexport let build_fibonacci_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // type0: (i64) -> (i64)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"fib\", 0)\n\n  let b = bytebuf_new()\n  // local 0 = n (param), locals 1=a, 2=b, 3=tmp\n\n  // a = 0\n  emit_i64_const(b, 0)\n  emit_local_set(b, 1)\n  // b = 1\n  emit_i64_const(b, 1)\n  emit_local_set(b, 2)\n\n  // block $break\n  emit_block_void(b)\n    // loop $continue\n    emit_loop_void(b)\n      // if n <= 0, break\n      emit_local_get(b, 0)\n      emit_i64_const(b, 0)\n      emit_i64_le_s(b)\n      emit_br_if(b, 1)  // br $break (label 1 = outer block)\n\n      // tmp = a + b\n      emit_local_get(b, 1)\n      emit_local_get(b, 2)\n      emit_i64_add(b)\n      emit_local_set(b, 3)\n      // a = b\n      emit_local_get(b, 2)\n      emit_local_set(b, 1)\n      // b = tmp\n      emit_local_get(b, 3)\n      emit_local_set(b, 2)\n      // n = n - 1\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_sub(b)\n      emit_local_set(b, 0)\n\n      // br $continue (label 0 = loop)\n      emit_br(b, 0)\n    emit_end(b)  // end loop\n  emit_end(b)    // end block\n\n  // return a\n  emit_local_get(b, 1)\n\n  emit_code_section_with_locals(out, [b], [3])\n  bytebuf_to_bytes(out)\n}\n\n// Build factorial module: fact(n) iterative\n// params: n (local 0), locals: result (local 1)\n// Algorithm: result=1, while(n>1) { result=result*n; n=n-1 }; return result\nexport let build_factorial_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"fact\", 0)\n\n  let b = bytebuf_new()\n  // result = 1\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n\n  // block $break\n  emit_block_void(b)\n    // loop $continue\n    emit_loop_void(b)\n      // if n <= 1, break\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_le_s(b)\n      emit_br_if(b, 1)\n\n      // result = result * n\n      emit_local_get(b, 1)\n      emit_local_get(b, 0)\n      emit_i64_mul(b)\n      emit_local_set(b, 1)\n\n      // n = n - 1\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_sub(b)\n      emit_local_set(b, 0)\n\n      emit_br(b, 0)\n    emit_end(b)\n  emit_end(b)\n\n  // return result\n  emit_local_get(b, 1)\n\n  emit_code_section_with_locals(out, [b], [1])\n  bytebuf_to_bytes(out)\n}\n\n// Build a WASI hello world module\n// Imports fd_write from wasi_snapshot_preview1, writes \"hello world\\n\" to stdout\nexport let build_hello_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // Type section:\n  //   type0: fd_write(i32, i32, i32, i32) -> i32\n  //   type1: _start() -> void\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])\n  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))\n  bytebuf_push_section(out, 1, type_content)\n\n  // Import section: fd_write from wasi_snapshot_preview1 (func index 0)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n\n  // Function section: _start is func index 1 (after 1 import), type 1\n  emit_function_section(out, [1])\n\n  // Memory section: 1 page\n  emit_memory_section(out, 1)\n\n  // Export section: _start + memory\n  emit_exports_with_memory(out, [\"_start\"], [1], \"memory\", 0)\n\n  // Code section: _start body (must come before data section)\n  // Setup iovec at memory[0]: {ptr=8, len=12}\n  // Then call fd_write(1, 0, 1, 100)\n  //   fd=1 (stdout), iovs_ptr=0, iovs_count=1, nwritten_ptr=100\n  let b = bytebuf_new()\n\n  // mem[0] = 8 (iovec.buf pointer)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n\n  // mem[4] = 12 (iovec.buf_len)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 12)\n  emit_i32_store(b, 2, 0)\n\n  // call fd_write(1, 0, 1, 100)\n  emit_i32_const(b, 1)    // fd = stdout\n  emit_i32_const(b, 0)    // iovs ptr\n  emit_i32_const(b, 1)    // iovs count\n  emit_i32_const(b, 100)  // nwritten ptr\n  emit_call(b, 0)         // call fd_write (import index 0)\n  emit_drop(b)            // discard return value\n\n  emit_code_section(out, [b])\n\n  // Data section: \"hello world\\n\" at offset 8\n  let hello_data = bytebuf_new()\n  bytebuf_push(hello_data, 104)  // h\n  bytebuf_push(hello_data, 101)  // e\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 111)  // o\n  bytebuf_push(hello_data, 32)   // ' '\n  bytebuf_push(hello_data, 119)  // w\n  bytebuf_push(hello_data, 111)  // o\n  bytebuf_push(hello_data, 114)  // r\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 100)  // d\n  bytebuf_push(hello_data, 10)   // \\n\n  emit_data_section(out, 8, hello_data)\n\n  bytebuf_to_bytes(out)\n}\n\n// === String data helpers ===\n\n// Convert a string to a byte array (ASCII only)\nexport let string_to_data = (s: String) -> Array[Int] {\n  let buf = bytebuf_new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\n// Emit data section with multiple segments\nexport let emit_data_section_multi = (out: Array[Int], offsets: Array[Int], datas: Array[Array[Int]]) -> Unit {\n  let count = Array::length(offsets)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    bytebuf_push(content, 0)  // active, memory 0\n    emit_i32_const(content, Array::get(offsets, i))\n    emit_end(content)\n    let data = Array::get(datas, i)\n    leb128_encode_u32(content, Array::length(data))\n    bytebuf_push_array(content, data)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 11, content)\n}\n\n// Build a WASI module that prints a custom string\nexport let build_print_string_module = (msg: String) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // Types: fd_write(i32,i32,i32,i32)->i32, _start()->void\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])\n  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))\n  bytebuf_push_section(out, 1, type_content)\n\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, [1])\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, [\"_start\"], [1], \"memory\", 0)\n\n  // String data at offset 16 (leave 0-15 for iovec + nwritten)\n  let str_data = string_to_data(msg)\n  let str_len = Array::length(str_data)\n\n  // Code: setup iovec and call fd_write\n  let b = bytebuf_new()\n  // iovec[0].buf = 16\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 16)\n  emit_i32_store(b, 2, 0)\n  // iovec[0].len = str_len\n  emit_i32_const(b, 4)\n  emit_i32_const(b, str_len)\n  emit_i32_store(b, 2, 0)\n  // fd_write(stdout=1, iovs=0, count=1, nwritten=8)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n\n  emit_code_section(out, [b])\n  emit_data_section(out, 16, str_data)\n  bytebuf_to_bytes(out)\n}\n\n// === f64 instructions ===\n\n// f64.const — emit raw i64 bits as f64 constant\n// Caller provides the raw i64 bits (from Double::to_i64_bits builtin)\nexport let emit_f64_const_bits = (buf: Array[Int], bits: Int) -> Unit {\n  bytebuf_push9(buf, 68,\n    bits & 255, (bits >> 8) & 255, (bits >> 16) & 255, (bits >> 24) & 255,\n    (bits >> 32) & 255, (bits >> 40) & 255, (bits >> 48) & 255, (bits >> 56) & 255)\n}\n\nexport let emit_f64_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 160)  // 0xA0\n}\n\nexport let emit_f64_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 161)  // 0xA1\n}\n\nexport let emit_f64_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 162)  // 0xA2\n}\n\nexport let emit_f64_div = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 163)  // 0xA3\n}\n\nexport let emit_f64_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 97)  // 0x61\n}\n\nexport let emit_f64_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 98)  // 0x62\n}\n\nexport let emit_f64_lt = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 99)  // 0x63\n}\n\nexport let emit_f64_gt = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 100)  // 0x64\n}\n\nexport let emit_f64_le = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 101)  // 0x65\n}\n\nexport let emit_f64_ge = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 102)  // 0x66\n}\n\nexport let emit_f64_neg = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 154)  // 0x9A\n}\n\n// i64.reinterpret_f64 — reinterpret f64 bits as i64\nexport let emit_i64_reinterpret_f64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 189)  // 0xBD\n}\n\n// f64.reinterpret_i64 — reinterpret i64 bits as f64\nexport let emit_f64_reinterpret_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 191)  // 0xBF\n}\n\n// i64.trunc_f64_s — truncate f64 to signed i64\nexport let emit_i64_trunc_f64_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 176)  // 0xB0\n}\n\n// f64.convert_i64_s — convert signed i64 to f64\nexport let emit_f64_convert_i64_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 185)  // 0xB9\n}\n\n// === Table and indirect call support ===\n\n// call_indirect: opcode 0x11 + type_idx (LEB128) + table 0x00\nexport let emit_call_indirect = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 17, type_idx)\n  bytebuf_push(buf, 0)   // table index 0\n}\n\n// Emit table section (section 4): 1 funcref table with min=num_entries, no max\nexport let emit_table_section_funcref = (out: Array[Int], num_entries: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 table\n  bytebuf_push2(content, 112, 0)  // 0x70 = funcref, limits: no max\n  leb128_encode_u32(content, num_entries)\n  bytebuf_push_section(out, 4, content)\n}\n\n// Emit element section (section 9): active segment for table 0 at offset 0\n// func_indices: array of function indices to place in table\nexport let emit_element_section_active = (out: Array[Int], func_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 segment\n  bytebuf_push(content, 0)  // flags: active, table 0\n  // Offset expression: i32.const 0, end\n  emit_i32_const(content, 0)\n  emit_end(content)\n  // Function indices\n  leb128_encode_u32(content, Array::length(func_indices))\n  let mut i = 0\n  while i < Array::length(func_indices) {\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 9, content)\n}\n\n// === GC instructions ===\n\n// Emit a struct type definition: struct { field_types[i] with field_muts[i] }\n// field_types: valtype bytes (0x7E=i64, 0x7F=i32, etc.)\n// field_muts: 0x00=const, 0x01=mut\nexport let emit_struct_type_raw = (buf: Array[Int], field_types: Array[Int], field_muts: Array[Int]) -> Unit {\n  bytebuf_push_opcode_u32(buf, 95, Array::length(field_types))\n  let mut i = 0\n  while i < Array::length(field_types) {\n    bytebuf_push2(buf, Array::get(field_types, i), Array::get(field_muts, i))\n    i = i + 1\n  }\n}\n\n// struct.new $type — create a new struct (values on stack)\nexport let emit_struct_new = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 0, type_idx)\n}\n\n// struct.get $type $field — read a struct field\nexport let emit_struct_get = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 2, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\n// struct.set $type $field — write a struct field\nexport let emit_struct_set = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 5, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\n// ref.func $func — get a typed function reference\nexport let emit_ref_func = (buf: Array[Int], func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 210, func_idx)\n}\n\n// call_ref $type — call a function reference\nexport let emit_call_ref = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 20, type_idx)\n}\n\n// ref.null $heaptype — push a null reference\nexport let emit_ref_null = (buf: Array[Int], heap_type_byte: Int) -> Unit {\n  bytebuf_push2(buf, 208, heap_type_byte)\n}\n")

  let source_7 = ("vibe/compiler/codegen/common_base/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_xor, emit_if_void, emit_local_get, emit_local_set\n}\n\n//# Types\n\n// Function registry: groups parallel arrays for function metadata\nexport struct FuncTable {\n  names: Array[String];\n  indices: Array[Int];\n  params: Array[Int];\n  returns: Array[Int]\n}\n\n// String table: groups string data with their WASM data segment offsets/lengths\nexport struct StrTable {\n  strs: Array[String];\n  offsets: Array[Int];\n  lengths: Array[Int]\n}\n\n// Lambda accumulator: collects compiled lambda bodies and metadata\nexport struct LambdaTable {\n  bodies: Array[Array[Int]];\n  param_counts: Array[Int];\n  captures: Array[Array[String]];\n  meta_i32: Array[Int];\n  meta_i64: Array[Int]\n}\n\n// Constructor/struct registry: enum variant + struct constructors\nexport struct CtorTable {\n  names: Array[String];\n  tags: Array[Int];\n  field_counts: Array[Int];\n  type_names: Array[String];\n  struct_names: Array[String];\n  struct_field_names: Array[Array[String]]\n}\n\n// Compilation context: all shared state for compile_expr\nexport struct CompileCtx {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ctor_table: CtorTable;\n  thunk_names: Array[String]\n}\n\n// GC backend compilation context (extends CompileCtx with GC-specific fields)\nexport struct CompileCtxGc {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ref_local_indices: Array[Int];\n  refcell_type_idx: Int;\n  closure_type_base: Int;\n  ctor_table: CtorTable\n}\n\n//# Functions\n\nexport let is_efn = (expr: Expr) -> Bool {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pint = (p: Pat) -> Bool {\n  match p {\n    PInt(_) => true,\n    _ => false\n  }\n}\n\n// === Stmt extractors ===\nexport let is_slet = (stmt: Stmt) -> Bool {\n  match stmt {\n    SLet(_, _, _, _, _) => true,\n    _ => false\n  }\n}\n\n// Expr tag: returns a numeric tag for dispatch without match in let rec\n// 0=EInt, 1=EBool, 2=EFloat, 3=EString, 4=EIdent, 5=EBinOp, 6=EUnaryOp,\n// 7=EIf, 8=ECall, 9=ELet, 10=ELetRec, 11=ELetMut, 12=EAssign, 13=EAssignOp,\n// 14=ESeq, 15=ETuple, 16=EMatch, 17=EArray, 18=EForIn, 19=EWhile,\n// 20=EBreak, 21=EContinue, 22=EUnit, 23=EThrow, 24=EFn, -1=unknown\nexport let expr_tag = (expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EBool(_) => 1,\n    EFloat(_) => 2,\n    EString(_) => 3,\n    EIdent(_) => 4,\n    EBinOp(_, _, _) => 5,\n    EUnaryOp(_, _) => 6,\n    EIf(_, _, _) => 7,\n    ECall(_, _) => 8,\n    ELet(_, _, _) => 9,\n    ELetRec(_, _, _) => 10,\n    ELetMut(_, _, _) => 11,\n    EAssign(_, _, _) => 12,\n    EAssignOp(_, _, _, _) => 13,\n    ESeq(_, _) => 14,\n    ETuple(_) => 15,\n    EMatch(_, _) => 16,\n    EArray(_) => 17,\n    EForIn(_, _, _, _) => 18,\n    EWhile(_, _) => 19,\n    EBreak(_) => 20,\n    EContinue(_) => 21,\n    EUnit => 22,\n    EThrow(_) => 23,\n    EFn(_, _, _, _, _, _) => 24,\n    _ => -1\n  }\n}\n\nexport let is_pbind = (p: Pat) -> Bool {\n  match p {\n    PBind(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pbool = (p: Pat) -> Bool {\n  match p {\n    PBool(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pctor = (p: Pat) -> Bool {\n  match p {\n    PCtor(_, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pwild = (p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    _ => false\n  }\n}\n\n// Expr type checks (only those needed inside match arms)\nexport let is_eident = (expr: Expr) -> Bool {\n  match expr {\n    EIdent(_) => true,\n    _ => false\n  }\n}\n\n// Check if expr is an ETuple\nexport let is_etuple = (expr: Expr) -> Bool {\n  match expr {\n    ETuple(_) => true,\n    _ => false\n  }\n}\n\n// Check pattern type\nexport let is_ptuple = (p: Pat) -> Bool {\n  match p {\n    PTuple(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pstring = (p: Pat) -> Bool {\n  match p {\n    PString(_) => true,\n    _ => false\n  }\n}\n\nexport let emit_i32_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 70)\n  // 0x46\n}\n\nexport let emit_i32_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 71)\n  // 0x47\n}\n\n// Extract pattern from match arm pair\nexport let get_arm_pat = (arm: (Pat, Expr)) -> Pat {\n  let (p, _) = arm\n  p\n}\n\n// Returns index into ctor_names array, or -1 if not found\nexport let rec lookup_ctor = (ctor_names: Array[String], name: String, i: Int) -> Int {\n  if i >= Array::length(ctor_names) {\n    -1\n  }\n  else if Array::get(ctor_names, i) == name {\n    i\n  }\n  else lookup_ctor(ctor_names, name, i + 1)\n}\n\nexport let emit_i32_eqz = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 69)\n  // 0x45\n}\n\nexport let emit_i32_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 108)\n  // 0x6C\n}\n\nexport let emit_i32_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 107)\n  // 0x6B\n}\n\nexport let emit_str_ref = (buf: Array[Int], offset: Int, length: Int) -> Unit {\n  emit_i64_const(buf, offset)\n  emit_i64_const(buf, 32)\n  emit_i64_shl(buf)\n  emit_i64_const(buf, length)\n  emit_i64_or(buf)\n}\n\n// Extract body from match arm pair\nexport let get_arm_body = (arm: (Pat, Expr)) -> Expr {\n  let (_, b) = arm\n  b\n}\n\nexport let get_efn_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EFn(_, _, _, _, _, body) => body,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eif_cond = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(c, _, _) => c,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_else = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, _, e) => e,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_then = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, t, _) => t,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_elet_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, val, _) => val,\n    _ => throw(\"not ELet\")\n  }\n}\n\n// Resolve function: returns (func_index, param_count, has_return)\nexport let resolve_func = (ft: FuncTable, name: String) -> (Int, Int, Int)with { Error } {\n  let len = Array::length(ft.names)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(ft.names, i) == name {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"undefined function: \", name))\n  };\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\n}\n\n// Emit WASM instruction for a binary operator\nexport let emit_binop_op = (buf: Array[Int], op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else if op == \"&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"|\" {\n    emit_i64_or(buf)\n  }\n  else if op == \"^\" {\n    emit_i64_xor(buf)\n  }\n  else if op == \"<<\" {\n    emit_i64_shl(buf)\n  }\n  else if op == \">>\" {\n    emit_i64_shr_s(buf)\n  }\n  else if op == \"==\" {\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"!=\" {\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<\" {\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">\" {\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<=\" {\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">=\" {\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"&&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"||\" {\n    emit_i64_or(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported binop: \", op))\n  }\n}\n\nexport let emit_i32_ge_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 79)\n  // 0x4F\n}\n\nexport let emit_i32_gt_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 75)\n  // 0x4B\n}\n\nexport let emit_i64_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 41)\n  // 0x29\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let get_ebinop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EBinOp(op, _, _) => op,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_elet_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, _, body) => body,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let get_elet_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELet(name, _, _) => name,\n    _ => throw(\"not ELet\")\n  }\n}\n\n// Extract function body from SLet(_, _, _, _, EFn(_, _, _, _, _, body))\nexport let get_func_body = (stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, _, _, _, body) => body,\n      _ => throw(\"get_func_body: not a function\")\n    },\n    _ => throw(\"get_func_body: not a let statement\")\n  }\n}\n\nexport let get_slet_expr = (stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => expr,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let get_slet_name = (stmt: Stmt) -> String with { Error } {\n  match stmt {\n    SLet(_, _, name, _, _) => name,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let resolve_local = (names: Array[String], name: String, tag: String) -> Int with { Error } {\n  let mut i = Array::length(names) - 1\n  let mut result = -1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  if result < 0 {\n    let mut dbg = String::concat(\"undefined variable (local): \", name)\n    dbg = String::concat(dbg, \" [locals: \")\n    let mut di = 0\n    let dlen = Array::length(names)\n    while di < dlen {\n      if di > 0 {\n        dbg = String::concat(dbg, \", \")\n      }\n      dbg = String::concat(dbg, Array::get(names, di))\n      di = di + 1\n    }\n    dbg = String::concat(dbg, \"]\")\n    dbg = String::concat(dbg, \" @\")\n    dbg = String::concat(dbg, tag)\n    throw(dbg)\n  }\n  result\n}\n\nexport let emit_i64_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 55)\n  // 0x37\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n// Find the SLet statement for a given function name\nexport let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {\n  let len = Array::length(stmts)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, sname, _, _) => if sname == name {\n        found = i\n        i = len\n      }\n      ,\n      _ => ()\n    }\n    if found < 0 {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"function not found: \", name))\n  }\n  Array::get(stmts, found)\n}\n")

  let source_8 = ("vibe/compiler/codegen/common_extractors/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub\n}\n\n//# Functions\n\nexport let get_ebinop_lhs = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, lhs, _) => lhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ebinop_rhs = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, _, rhs) => rhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ecall_args = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ECall(_, args) => args,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efn_params = (expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\n  match expr {\n    EFn(_, _, params, _, _, _) => params,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eint_value = (expr: Expr) -> Int with { Error } {\n  match expr {\n    EInt(n) => n,\n    _ => throw(\"not EInt\")\n  }\n}\n\nexport let get_eseq_first = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(first, _) => first,\n    _ => throw(\"not ESeq\")\n  }\n}\n\n// Extract arms from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_arms = (expr: Expr) -> Array[(Pat, Expr)] with { Error } {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\n// Extract name from PBind\nexport let get_pbind_name = (p: Pat) -> String with { Error } {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\nexport let get_pctor_args = (p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\n// Extract PCtor name and args\nexport let get_pctor_name = (p: Pat) -> String with { Error } {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\n// Extract PInt value\nexport let get_pint_value = (p: Pat) -> Int with { Error } {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\nexport let get_eassign_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, val, _) => val,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_ebool_value = (expr: Expr) -> Bool with { Error } {\n  match expr {\n    EBool(b) => b,\n    _ => throw(\"not EBool\")\n  }\n}\n\nexport let get_eforin_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, _, body) => body,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_iter = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, iter, _) => iter,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EForIn(name, _, _, _) => name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eident_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EIdent(name) => name,\n    _ => throw(\"not EIdent\")\n  }\n}\n\nexport let get_eletmut_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, val, _) => val,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, val, _) => val,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eseq_second = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(_, second) => second,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport let get_ethrow_expr = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EThrow(e) => e,\n    _ => throw(\"not EThrow\")\n  }\n}\n\nexport let get_eunaryop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EUnaryOp(op, _) => op,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport let get_ewhile_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(_, body) => body,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport let get_ewhile_cond = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(cond, _) => cond,\n    _ => throw(\"not EWhile\")\n  }\n}\n\n// Extract PBool value\nexport let get_pbool_value = (p: Pat) -> Bool with { Error } {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\n// Extract sub-patterns from PTuple\nexport let get_ptuple_pats = (p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\nexport let get_slet_export = (stmt: Stmt) -> Bool with { Error } {\n  match stmt {\n    SLet(is_export, _, _, _, _) => is_export,\n    _ => throw(\"not SLet\")\n  }\n}\n\n// Check if a pattern is unconditionally matching (catch-all)\nexport let rec is_catchall_pat = (p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      // PTuple is catch-all only if ALL sub-patterns are catch-all\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(pats) {\n        if !is_catchall_pat(Array::get(pats, i)) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\n// Emit WASM instruction for an assign operator (+=, -=, etc.)\nexport let emit_assignop_op = (buf: Array[Int], op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported assign op: \", op))\n  }\n}\n\nexport let emit_memory_copy = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 252)\n  // 0xFC prefix\n  leb128_encode_u32(buf, 10)\n  // memory.copy\n  bytebuf_push(buf, 0)\n  // src memory\n  bytebuf_push(buf, 0)\n  // dst memory\n}\n\nexport let get_earray_elems = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    EArray(elems) => elems,\n    _ => throw(\"not EArray\")\n  }\n}\n\nexport let get_eassign_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, _, body) => body,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassign_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssign(name, _, _) => name,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassignop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(_, op, _, _) => op,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_ecall_callee = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ECall(callee, _) => callee,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efloat_value = (expr: Expr) -> Double with { Error } {\n  match expr {\n    EFloat(v) => v,\n    _ => throw(\"not EFloat\")\n  }\n}\n\nexport let get_eletmut_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, _, body) => body,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletmut_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELetMut(name, _, _) => name,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, _, body) => body,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eletrec_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELetRec(name, _, _) => name,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\n// Extract elements from ETuple\nexport let get_etuple_elems = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\nexport let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {\n  let len = Array::length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(strs, i) == s {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"string not in table: \", s))\n  }\n  found\n}\n\n// Find the index of the first catch-all pattern in match arms\n// Returns num_arms if no catch-all found\nexport let find_catchall_idx = (arms: Array[(Pat, Expr)]) -> Int {\n  let num = Array::length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = Array::get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\nexport let get_eassignop_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, val, _) => val,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_estring_value = (expr: Expr) -> String with { Error } {\n  match expr {\n    EString(s) => s,\n    _ => throw(\"not EString\")\n  }\n}\n\nexport let get_eunaryop_expr = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EUnaryOp(_, e) => e,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\n// Extract PString value\nexport let get_pstring_value = (p: Pat) -> String with { Error } {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\nexport let array_contains_str = (arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let get_eassignop_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, _, body) => body,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_eassignop_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(name, _, _, _) => name,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\n// Extract scrutinee from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_scrutinee = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n")

  let source_9 = ("vibe/compiler/codegen/common_analysis/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_and, emit_i64_const, emit_i64_eq, emit_i64_or, emit_i64_shl, emit_i64_shr_s, emit_if_void, emit_local_get, emit_local_set\n}\n\n//# Functions\n\n\nexport let rec collect_strings_expr = (expr: Expr, out: Array[String]) -> Int {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(out) {\n        if Array::get(out, i) == s {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found {\n        Array::push(out, s)\n      }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args) => {\n      collect_strings_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_strings_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, _, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_expr) = Array::get(arms, i)\n        match pat {\n          PString(s) => {\n            let mut pf = false\n            let mut pi = 0\n            while pi < Array::length(out) {\n              if Array::get(out, pi) == s {\n                pf = true\n              }\n              pi = pi + 1\n            }\n            if !pf {\n              Array::push(out, s)\n            }\n            0\n          },\n          _ => 0\n        }\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EThrow(msg) => collect_strings_expr(msg, out),\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\n// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))\nexport let get_func_param_names = (stmt: Stmt) -> Array[String] with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, _) = Array::get(params, i)\n          Array::push(names, pname)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\nexport let collect_strings_stmts = (stmts: Array[Stmt]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let emit_i64_extend_i32_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 173)\n  // 0xAD\n}\n\n// Resolve closure/fn value tag and fill slot_local/env_local\n// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)\nexport let emit_closure_resolve = (buf: Array[Int], fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n  // Bare fn: table_slot = fn_val >> 2, env = 0\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 2)\n  emit_i64_shr_s(buf)\n  emit_local_set(buf, slot_local)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, env_local)\n  emit_else(buf)\n  // Closure: env = fn_val & ~3, slot = i32.load(env, 0)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, -4)\n  emit_i64_and(buf)\n  emit_local_set(buf, env_local)\n  emit_local_get(buf, env_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i64_extend_i32_u(buf)\n  emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\n// Emit the tail of an indirect closure call (push env, push slot, call_indirect)\nexport let emit_closure_call_tail = (buf: Array[Int], env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\nlet rec collect_pattern_bindings = (pat: Pat, bindings: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(bindings, name); 0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pattern_bindings(Array::get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_pattern_bindings(Array::get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\n    },\n    _ => 0\n  }\n}\n\n// Stack-based free variable analysis: uses in-place push/truncate on bound array\n// to avoid O(n) array copies at every scope boundary. This dramatically reduces\n// heap allocation during meta-circular self-compilation.\nexport let rec collect_free_vars_expr = (expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name) => if array_contains_str(bound, name) {\n      0\n    }\n    else if array_contains_str(fn_names, name) {\n      0\n    }\n    else if array_contains_str(out, name) {\n      0\n    }\n    else {\n      Array::push(out, name)\n      0\n    }\n    ,\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => {\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\n    },\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\n    EIf(cond, then_e, else_e) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\n    },\n    ECall(callee, args) => {\n      collect_free_vars_expr(callee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(value, bound, fn_names, out)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EAssign(_, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    ESeq(first, second) => {\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\n    },\n    EWhile(cond, body) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EForIn(var_name, index_name, iter_e, body) => {\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, var_name)\n      match index_name {\n        Some(index_name) => Array::push(bound, index_name),\n        None => ()\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (arm_pat, arm_expr) = Array::get(arms, i)\n        let saved = Array::length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        Array::truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = Array::length(bound)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        Array::push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr(body, bound, fn_names, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _) => collect_free_vars_expr(obj, bound, fn_names, out),\n    ERecord(fields) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_free_vars_expr(fval, bound, fn_names, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\n    _ => 0\n  }\n}\n\nexport let collect_free_vars = (body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  // Make a mutable copy of param_names for stack-based push/truncate\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\n  collect_free_vars_expr(body, bound, fn_names, out)\n  out\n}\n\n// Check if a mutable variable is captured by any nested EFn in the given expression\nexport let rec is_mut_captured_in = (expr: Expr, name: String) -> Bool {\n  match expr {\n    EIdent(_) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args) => if is_mut_captured_in(callee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if is_mut_captured_in(Array::get(args, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    }\n    ,\n    ELet(n, value, body) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    ELetRec(n, value, body) => if n == name {\n      false\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    ELetMut(n, value, body) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    }\n    ,\n    EFn(_, _, params, _, _, fn_body) => {\n      // Check if name is shadowed by params\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        if pname == name {\n          shadowed = true\n        }\n        pi = pi + 1\n      }\n      if shadowed {\n        false\n      }\n      else {\n        // Check if name is free in this EFn\n        let param_names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut pi2 = 0\n        while pi2 < Array::length(params) {\n          let (pname2, _) = Array::get(params, pi2)\n          Array::push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\n          \"\"\n        ], 0, 0))\n        if array_contains_str(fv, name) {\n          true\n        }\n        else {\n          // Also check recursively for deeper nesting\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EThrow(msg) => is_mut_captured_in(msg, name),\n    _ => false\n  }\n}\n")

  let source_10 = ("vibe/compiler/codegen/gc/index.vibe",
"// AST-to-WASM codegen (wasm-gc backend)\n// Uses GC struct types for ref cells instead of linear memory bump allocation.\n// Closures use table-based call_indirect (same as linear memory backend).\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,\n  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,\n  leb128_encode_u32, leb128_encode_s64\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_header,\n  emit_type_section, emit_type_section_multi,\n  emit_function_section, emit_export_section, emit_export_section_multi,\n  emit_code_section, emit_code_section_with_locals,\n  emit_name, emit_func_type_raw,\n  emit_import_section_func, emit_memory_section,\n  emit_exports_with_memory, emit_data_section, emit_data_section_multi,\n  emit_local_get, emit_local_set, emit_local_tee,\n  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,\n  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,\n  emit_i64_shl, emit_i64_shr_s,\n  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,\n  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,\n  emit_i64_extend_i32_s, emit_i32_wrap_i64,\n  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,\n  emit_i32_store8, emit_i32_load8_u,\n  emit_call, emit_drop, emit_return,\n  emit_block_void, emit_block_i64, emit_loop_void,\n  emit_if_void, emit_if_i64, emit_else, emit_end,\n  emit_br, emit_br_if,\n  emit_global_section_i32_mut, emit_global_get, emit_global_set,\n  string_to_data,\n  emit_f64_const_bits, emit_f64_add, emit_f64_sub, emit_f64_mul, emit_f64_div,\n  emit_f64_eq, emit_f64_ne, emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge,\n  emit_f64_neg, emit_i64_reinterpret_f64, emit_f64_reinterpret_i64,\n  emit_i64_trunc_f64_s, emit_f64_convert_i64_s,\n  emit_call_indirect, emit_table_section_funcref, emit_element_section_active,\n  emit_struct_type_raw, emit_struct_new, emit_struct_get, emit_struct_set\n}\n\nimport ../common_base/index.vibe {\n  emit_i32_sub, emit_i32_mul, emit_i32_ne, emit_i32_eq, emit_i32_ge_u, emit_i32_eqz, emit_i64_store, emit_i64_load, resolve_local, resolve_func, FuncTable, StrTable, LambdaTable, CtorTable, CompileCtxGc, emit_str_ref, find_func_stmt, lookup_ctor, emit_binop_op\n}\n\nimport ../common_extractors/index.vibe {\n  emit_memory_copy, array_contains_str, str_table_lookup, find_catchall_idx, emit_assignop_op\n}\n\nimport ../common_analysis/index.vibe {\n  emit_i64_extend_i32_u, collect_strings_stmts, collect_free_vars, is_mut_captured_in, emit_closure_resolve, emit_closure_call_tail\n}\n\n// === Sub-compilers (GC backend) ===\n\nlet compile_call_gc = (\n  buf: Array[Int], callee: Expr, args: Array[Expr],\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  ce: (Array[Int], Expr, Array[String], Int, Int) -> Int with { Error }\n) -> Int with { Error } {\n  match callee {\n    EIdent(fname) => {\n      // Check if this is an enum constructor call\n      let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n      if ctor_lookup_idx >= 0 {\n        let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n        let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        // For structs, unwrap ERecord and reorder fields\n        let actual_args = if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ERecord(rec_fields) => {\n              let rec find_sn = (sni: Int) -> Int {\n                if sni >= Array::length(ctx.ctor_table.struct_names) { -1 }\n                else if Array::get(ctx.ctor_table.struct_names, sni) == fname { sni }\n                else find_sn(sni + 1)\n              }\n              let sn_idx = find_sn(0)\n              if sn_idx >= 0 {\n                let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n                let ordered = Array::slice([EUnit], 0, 0)\n                let mut oi = 0\n                while oi < Array::length(def_fnames) {\n                  let target_name = Array::get(def_fnames, oi)\n                  let rec find_rf = (ri: Int) -> Expr {\n                    if ri >= Array::length(rec_fields) { EUnit }\n                    else {\n                      let (rfn, rfv) = Array::get(rec_fields, ri)\n                      if rfn == target_name { rfv }\n                      else find_rf(ri + 1)\n                    }\n                  }\n                  Array::push(ordered, find_rf(0))\n                  oi = oi + 1\n                }\n                ordered\n              } else { args }\n            },\n            _ => args\n          }\n        } else { args }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n      else if fname == \"__slice\" {\n        // __slice → String::substring fallback\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        let (ss_idx, _, _) = resolve_func(ctx.func_table, \"String::substring\")\n        emit_call(buf, ss_idx)\n        nl\n      }\n      else if fname == \"__index\" {\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_call(buf, ag_idx)\n        nl\n      }\n      else if fname == \"Array::slice\" {\n        // Array::slice(arr, start, end) → new array with elements [start..end)\n        let (an_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n        let (ap_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let arr_local = next_local\n        let start_local = next_local + 1\n        let end_local = next_local + 2\n        let new_arr_local = next_local + 3\n        let i_local = next_local + 4\n        Array::push(local_names, \"__slice_arr\")\n        Array::push(local_names, \"__slice_start\")\n        Array::push(local_names, \"__slice_end\")\n        Array::push(local_names, \"__slice_new\")\n        Array::push(local_names, \"__slice_i\")\n        let mut nl = next_local + 5\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, arr_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, start_local)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        emit_local_set(buf, end_local)\n        emit_call(buf, an_idx)\n        emit_local_set(buf, new_arr_local)\n        emit_local_get(buf, sta