  let source_92 = ("vibe/compiler/codegen/gc/backend_expr.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nlet rec compile_expr_gc = (buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int) -> Int with { Error } {\n  let ce = (b: Bytes, e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {\n    compile_expr_gc(b, e, ln, nl, ctx, d)\n  }\n  match expr {\n    EInt(n) => {\n      emit_i64_const(buf, n)\n      next_local\n    },\n    EBool(b_val) => {\n      emit_i64_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    },\n    EFloat(v) => {\n      let bits = Double::to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n    },\n    EString(s) => {\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n      next_local\n    },\n    EIdent(name) => {\n      let len = Array::length(local_names)\n      let rec try_local = (i: Int) -> Int {\n        if i < 0 {\n          -1\n        }\n        else if Array::get(local_names, i) == name {\n          i\n        }\n        else try_local(i - 1)\n      }\n      let local_idx = try_local(len - 1)\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          emit_local_get(buf, local_idx)\n          emit_struct_get(buf, ctx.refcell_type_idx, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n          let fn_len = Array::length(ctx.func_table.names)\n          let mut fni = -1\n          let mut __fj = 0\n          while __fj < fn_len {\n            if Array::get(ctx.func_table.names, __fj) == name {\n              fni = __fj\n              __fj = fn_len\n            } else {\n              __fj = __fj + 1\n            }\n          }\n          if fni < 0 {\n            throw(String::concat(\"undefined variable: \", name))\n          }\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          let table_slot = fidx - ctx.func_offset\n          emit_i64_const(buf, (table_slot<<2)|2)\n          next_local\n        }\n      }\n    },\n    EBinOp(op, lhs, rhs) => {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_binop_op(buf, op)\n      nl2\n    },\n    EUnaryOp(op, operand) => if op == \"-\" {\n      emit_i64_const(buf, 0)\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_sub(buf)\n      nl\n    } else if op == \"!\" {\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n    ,\n    EIf(cond, then_e, else_e) => {\n      let nl1 = match cond {\n        EBinOp(cop, clhs, crhs) => if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          if cop == \"==\" {\n            emit_i64_eq(buf)\n          }\n          else if cop == \"!=\" {\n            emit_i64_ne(buf)\n          }\n          else if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        } else {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        },\n        EBool(b_val) => {\n          emit_i32_const(buf, if b_val {\n            1\n          } else {\n            0\n          })\n          next_local\n        },\n        _ => {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      }\n      emit_if_i64(buf)\n      let ld_inner = if ld >= 0 {\n        ld + 1\n      } else {\n        -1\n      }\n      let names_len_before = Array::length(local_names)\n      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)\n      emit_else(buf)\n      Array::truncate(local_names, names_len_before)\n      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)\n      emit_end(buf)\n      Array::truncate(local_names, names_len_before)\n      let max_nl = if nl_then > nl_else {\n        nl_then\n      } else {\n        nl_else\n      }\n      while Array::length(local_names) < max_nl {\n        Array::push(local_names, \"\")\n      }\n      max_nl\n    },\n    ECall(callee, args) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\n    ELet(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      ce(buf, body, local_names, nl, ld)\n    },\n    ELetRec(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      match value {\n        EFn(_, _, params, _, _, fn_body) => {\n          let param_names_bp = Array::slice([\n            \"\"\n          ], 0, 0)\n          let mut bpi = 0\n          while bpi < Array::length(params) {\n            let (pn, _) = Array::get(params, bpi)\n            Array::push(param_names_bp, pn)\n            bpi = bpi + 1\n          }\n          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n          let mut self_cap_idx = -1\n          let mut bci = 0\n          while bci < Array::length(caps) {\n            if Array::get(caps, bci) == name {\n              self_cap_idx = bci\n            }\n            bci = bci + 1\n          }\n          if self_cap_idx >= 0 {\n            emit_local_get(buf, local_idx)\n            emit_i64_const(buf, -4)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, local_idx)\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n          }\n          0\n        },\n        _ => 0\n      }\n      ce(buf, body, local_names, nl, ld)\n    },\n    ELetMut(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if is_mut_captured_in(body, name) {\n        Array::push(ctx.ref_cell_names, name)\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_struct_new(buf, ctx.refcell_type_idx)\n        emit_local_set(buf, local_idx)\n        Array::push(ctx.ref_local_indices, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      } else {\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_local_set(buf, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      }\n    },\n    EAssign(name, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    EAssignOp(name, op, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_local_get(buf, idx)\n        emit_struct_get(buf, ctx.refcell_type_idx, 0)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    ESeq(first, second) => {\n      let nl_s = ce(buf, first, local_names, next_local, ld)\n      emit_drop(buf)\n      ce(buf, second, local_names, nl_s, ld)\n    },\n    ETuple(elems) => {\n      let num_elems = Array::length(elems)\n      let alloc_size = num_elems * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__tuple_ptr\")\n      let mut nl = next_local + 1\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    },\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\n    EArray(elems) => {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    },\n    EForIn(var_name, index_name, iter_expr, body) => {\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let arr_local = next_local\n      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__for_arr\")\n      let i_local = nl1\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_local)\n      Array::push(local_names, \"__for_i\")\n      let nl2 = nl1 + 1\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, i_local)\n      emit_local_get(buf, arr_local)\n      emit_call(buf, arr_len_idx)\n      emit_i64_ge_s(buf)\n      emit_br_if(buf, 1)\n      let var_local = match index_name {\n        Some(_) => nl2 + 1,\n        None => nl2\n      }\n      match index_name {\n        Some(index_name) => {\n          emit_local_get(buf, i_local)\n          emit_local_set(buf, nl2)\n          Array::push(local_names, index_name)\n        },\n        None => ()\n      }\n      emit_local_get(buf, arr_local)\n      emit_local_get(buf, i_local)\n      emit_call(buf, arr_get_idx)\n      emit_local_set(buf, var_local)\n      Array::push(local_names, var_name)\n      let nl3 = var_local + 1\n      let nl4 = ce(buf, body, local_names, nl3, ld + 1)\n      emit_drop(buf)\n      emit_local_get(buf, i_local)\n      emit_i64_const(buf, 1)\n      emit_i64_add(buf)\n      emit_local_set(buf, i_local)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl4\n    },\n    EWhile(cond, body) => {\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      let nl1 = match cond {\n        EBinOp(wcop, wlhs, wrhs) => if wcop == \"==\" || wcop == \"!=\" || wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n          let wnl1 = ce(buf, wlhs, local_names, next_local, ld + 1)\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, ld + 1)\n          if wcop == \"==\" {\n            emit_i64_eq(buf)\n          }\n          else if wcop == \"!=\" {\n            emit_i64_ne(buf)\n          }\n          else if wcop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if wcop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if wcop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          emit_i32_eqz(buf)\n          wnl2\n        } else {\n          let wnl = ce(buf, cond, local_names, next_local, ld + 1)\n          emit_i64_eqz(buf)\n          wnl\n        },\n        _ => {\n          let wnl = ce(buf, cond, local_names, next_local, ld + 1)\n          emit_i64_eqz(buf)\n          wnl\n        }\n      }\n      emit_br_if(buf, 1)\n      let nl2 = ce(buf, body, local_names, nl1, ld + 1)\n      emit_drop(buf)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl2\n    },\n    EBreak(_) => {\n      emit_br(buf, ld + 1)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EContinue(_) => {\n      emit_br(buf, ld)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EUnit => {\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EThrow(msg_expr) => {\n      let nl = ce(buf, msg_expr, local_names, next_local, ld)\n      emit_drop(buf)\n      bytebuf_push(buf, 0)\n      nl\n    },\n    EFn(_, _, params, _, _, fn_body) =>\n    compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),\n    EDot(obj, field) => {\n      let rec find_struct_field_idx = (si2: Int) -> Int {\n        if si2 >= Array::length(ctx.ctor_table.struct_names) {\n          -1\n        }\n        else {\n          let fnames = Array::get(ctx.ctor_table.struct_field_names, si2)\n          let rec find_f = (fi: Int) -> Int {\n            if fi >= Array::length(fnames) {\n              -1\n            }\n            else if Array::get(fnames, fi) == field {\n              fi\n            }\n            else find_f(fi + 1)\n          }\n          let idx = find_f(0)\n          if idx >= 0 {\n            idx\n          }\n          else find_struct_field_idx(si2 + 1)\n        }\n      }\n      let field_idx = find_struct_field_idx(0)\n      if field_idx < 0 {\n        throw(String::concat(\"unknown struct field: \", field))\n      }\n      let nl1 = ce(buf, obj, local_names, next_local, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + field_idx * 8)\n      nl1\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      let obj_size = 8 + flen * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 0)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 4)\n      let mut nl_r = next_local + 1\n      let mut ri = 0\n      while ri < flen {\n        let (_, fexpr) = Array::get(fields, ri)\n        nl_r = ce(buf, fexpr, local_names, nl_r, ld)\n        let val_local = nl_r\n        Array::push(local_names, \"__rec_val\")\n        emit_local_set(buf, val_local)\n        nl_r = nl_r + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + ri * 8)\n        ri = ri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_r\n    },\n    EHandle(body, _) => ce(buf, body, local_names, next_local, ld),\n    EStringInterp(_) => throw(\"GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)\"),\n    _ => throw(\"unsupported expression in gc codegen\")\n  }\n}\n\n\nexport {\n  compile_expr_gc\n}\n")

  let source_93 = ("vibe/compiler/codegen/gc/backend_call.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nlet compile_call_gc = (buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\n  match callee {\n    EIdent(fname) => {\n      let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n      if ctor_lookup_idx >= 0 {\n        let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n        let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let actual_args = if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ERecord(rec_fields) => {\n              let rec find_sn = (sni: Int) -> Int {\n                if sni >= Array::length(ctx.ctor_table.struct_names) {\n                  -1\n                }\n                else if Array::get(ctx.ctor_table.struct_names, sni) == fname {\n                  sni\n                }\n                else find_sn(sni + 1)\n              }\n              let sn_idx = find_sn(0)\n              if sn_idx >= 0 {\n                let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n                let ordered = Array::slice([\n                  EUnit\n                ], 0, 0)\n                let mut oi = 0\n                while oi < Array::length(def_fnames) {\n                  let target_name = Array::get(def_fnames, oi)\n                  let rec find_rf = (ri: Int) -> Expr {\n                    if ri >= Array::length(rec_fields) {\n                      EUnit\n                    }\n                    else {\n                      let (rfn, rfv) = Array::get(rec_fields, ri)\n                      if rfn == target_name {\n                        rfv\n                      }\n                      else find_rf(ri + 1)\n                    }\n                  }\n                  Array::push(ordered, find_rf(0))\n                  oi = oi + 1\n                }\n                ordered\n              } else {\n                args\n              }\n            },\n            _ => args\n          }\n        } else {\n          args\n        }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n      else if fname == \"__slice\" {\n        let (ss_idx, _, _) = resolve_func(ctx.func_table, \"String::substring\")\n        let (bs_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::slice\")\n        let (as_idx, _, _) = resolve_func(ctx.func_table, \"Array::slice\")\n        let obj_local = next_local\n        let start_local = next_local + 1\n        let end_local = next_local + 2\n        let ptr_local = next_local + 3\n        let cap_local = next_local + 4\n        Array::push(local_names, \"__slice_obj\")\n        Array::push(local_names, \"__slice_start\")\n        Array::push(local_names, \"__slice_end\")\n        Array::push(local_names, \"__slice_ptr\")\n        Array::push(local_names, \"__slice_cap\")\n        let mut nl = next_local + 5\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, obj_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, start_local)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        emit_local_set(buf, end_local)\n        emit_local_get(buf, obj_local)\n        emit_i64_const(buf, 32)\n        emit_i64_shr_s(buf)\n        emit_i64_eqz(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_load(buf, 2, 0)\n        emit_local_set(buf, cap_local)\n        emit_local_get(buf, cap_local)\n        emit_i32_const(buf, 2147483647)\n        emit_i32_gt_u(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call(buf, bs_idx)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call(buf, as_idx)\n        emit_end(buf)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call(buf, ss_idx)\n        emit_end(buf)\n        nl\n      }\n      else if fname == \"__index\" {\n        let (sg_idx, _, _) = resolve_func(ctx.func_table, \"String::char_code_at\")\n        let (bg_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::get\")\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let obj_local = next_local\n        let idx_local 