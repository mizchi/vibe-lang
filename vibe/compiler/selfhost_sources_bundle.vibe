egistered in fn_names to prevent free-var capture errors.\n        throw(String::concat(\"GC codegen: unimplemented builtin: \", fname))\n      }\n      else {\n      let fn_len2 = Array::length(ctx.func_table.names)\n      let mut fn_idx_in_list = -1\n      let mut __fi = 0\n      while __fi < fn_len2 {\n        if Array::get(ctx.func_table.names, __fi) == fname {\n          fn_idx_in_list = __fi\n          __fi = fn_len2\n        } else {\n          __fi = __fi + 1\n        }\n      }\n      if fn_idx_in_list >= 0 {\n        // Direct call to known function\n        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\n        let mut nl = next_local\n        let mut ci = 0\n        while ci < Array::length(args) {\n          nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n          ci = ci + 1\n        }\n        // User funcs in GC backend have __env param for table compatibility\n        if ctx.func_offset > 0 {\n          if fidx >= ctx.func_offset {\n            emit_i64_const(buf, 0)\n          }\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        // Indirect call: fname is a local holding a closure/fn value\n        let local_idx2 = resolve_local(local_names, fname, \"gc_call\")\n        let num_args = Array::length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        Array::push(local_names, \"__fn_val\")\n        Array::push(local_names, \"__slot\")\n        Array::push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)\n        nl\n      }\n      } // close ctor_lookup else\n    },\n    _ => {\n      // Callee is an arbitrary expression\n      let num_args = Array::length(args)\n      let fn_val_local = next_local\n      let slot_local = next_local + 1\n      let env_local = next_local + 2\n      let mut nl = next_local + 3\n      Array::push(local_names, \"__fn_val\")\n      Array::push(local_names, \"__slot\")\n      Array::push(local_names, \"__env\")\n      nl = ce(buf, callee, local_names, nl, ld)\n      emit_local_set(buf, fn_val_local)\n      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n      let mut ci = 0\n      while ci < num_args {\n        nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n        ci = ci + 1\n      }\n      emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)\n      nl\n    }\n  }\n}\n\nlet compile_match_gc = (\n  buf: Array[Int], scrutinee: Expr, arms: Array[(Pat, Expr)],\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  ce: (Array[Int], Expr, Array[String], Int, Int) -> Int with { Error }\n) -> Int with { Error } {\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(arms)\n  let catchall_idx = find_catchall_idx(arms)\n  let num_cond_arms = catchall_idx\n  let mut max_nl = nl1\n  let mut ai = 0\n  while ai < num_cond_arms {\n    let (p, _) = Array::get(arms, ai)\n    match p {\n      PInt(n) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, n)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PBool(bv) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if bv { 1 } else { 0 })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PCtor(cname_cond, _) => {\n        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n        let expected_tag = if ctor_ci >= 0 { Array::get(ctx.ctor_table.tags, ctor_ci) } else { -1 }\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i32_const(buf, expected_tag)\n        emit_i32_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PString(sval) => {\n        let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n        if str_idx >= 0 {\n          emit_local_get(buf, scrut_local)\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n          emit_call(buf, 4)\n          emit_i64_const(buf, 1)\n          emit_i64_eq(buf)\n          emit_if_i64(buf)\n        }\n        0\n      },\n      _ => 0\n    }\n    let names_len_at_arm = Array::length(local_names)\n    let (p2, arm_body) = Array::get(arms, ai)\n    let ld_arm = if ld >= 0 { ld + ai + 1 } else { -1 }\n    match p2 {\n      PCtor(_, cargs_bind) => {\n        let mut cbi = 0\n        while cbi < Array::length(cargs_bind) {\n          match Array::get(cargs_bind, cbi) {\n            PBind(pname) => {\n              let fl = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi * 8)\n              emit_local_set(buf, fl)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi = cbi + 1\n        }\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n        if arm_nl > max_nl { max_nl = arm_nl }\n        0\n      },\n      PTuple(tpats) => {\n        // Destructure tuple: scrutinee is a heap-allocated tuple (ptr | 1)\n        // Fields at offset 8 + i * 8\n        let mut tbi = 0\n        while tbi < Array::length(tpats) {\n          match Array::get(tpats, tbi) {\n            PBind(tname) => {\n              let tl = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + tbi * 8)\n              emit_local_set(buf, tl)\n              Array::push(local_names, tname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          tbi = tbi + 1\n        }\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n        if arm_nl > max_nl { max_nl = arm_nl }\n        0\n      },\n      PBind(bname_arm) => {\n        // Bind whole scrutinee to a name\n        let bl = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, bl)\n        Array::push(local_names, bname_arm)\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n        if arm_nl > max_nl { max_nl = arm_nl }\n        0\n      },\n      _ => {\n        let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)\n        if arm_nl > max_nl { max_nl = arm_nl }\n        0\n      }\n    }\n    emit_else(buf)\n    Array::truncate(local_names, names_len_at_arm)\n    ai = ai + 1\n  }\n  let ld_catch = if ld >= 0 { ld + num_cond_arms } else { -1 }\n  let _names_len_at_catch = Array::length(local_names)\n  if catchall_idx < num_arms {\n    let (cp, cbody) = Array::get(arms, catchall_idx)\n    let catch_nl = match cp {\n      PBind(bname) => {\n        let bind_local = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, bind_local)\n        Array::push(local_names, bname)\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PCtor(_cname, cargs) => {\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          match Array::get(cargs, cbi2) {\n            PBind(pname) => {\n              let fl2 = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi2 * 8)\n              emit_local_set(buf, fl2)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PTuple(pats) => {\n        let ptr_local2 = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, ptr_local2)\n        Array::push(local_names, \"__tup_ptr2\")\n        let mut pi2 = 0\n        while pi2 < Array::length(pats) {\n          let tp = Array::get(pats, pi2)\n          match tp {\n            PBind(pname) => {\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => throw(\"unsupported pattern in tuple destructure\")\n          }\n          pi2 = pi2 + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      _ => {\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      }\n    }\n    if catch_nl > max_nl { max_nl = catch_nl }\n    0\n  } else {\n    bytebuf_push(buf, 0)  // unreachable\n    0\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  // Pad local_names to stay in sync with max_nl\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n\nlet compile_lambda_gc = (\n  buf: Array[Int], params: Array[(String, Option[TypeExpr])], fn_body: Expr,\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  compile_fn: (Array[Int], Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }\n) -> Int with { Error } {\n  let param_names_arr = Array::slice([\"\"], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n\n  // Compile lambda body into a separate buffer\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\"\"], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n\n  // Prologue: extract captures from env\n  let lam_ref_cells = Array::slice([\"\"], 0, 0)\n  let lam_ref_local_indices = Array::slice([0], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n\n  // Compile lambda body\n  let lam_ctx = CompileCtxGc::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ref_local_indices: lam_ref_local_indices,\n    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,\n    ctor_table: ctx.ctor_table\n  }\n  let final_lam_nl = compile_fn(\n    lam_buf, fn_body, lam_locals, lam_nl,\n    lam_ctx, ld\n  )\n\n  // Record lambda AFTER body compilation (nested lambdas already added)\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let extra_lam = if final_lam_nl > (user_params + 1) { final_lam_nl - (user_params + 1) } else { 0 }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n\n  // Emit closure creation code\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot << 2) | 2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let cap_idx = resolve_local(local_names, cap_name, \"gc_cap\")\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, cap_idx)\n      emit_i64_store(buf, 3, 8 + csi * 8)\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\n// === Expression compiler (GC backend) ===\n\nlet rec compile_expr_gc = (\n  buf: Array[Int],\n  expr: Expr,\n  local_names: Array[String],\n  next_local: Int,\n  ctx: CompileCtxGc,\n  ld: Int\n) -> Int with { Error } {\n  // shorthand for recursive call\n  let ce = (b: Array[Int], e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {\n    compile_expr_gc(b, e, ln, nl, ctx, d)\n  }\n  match expr {\n    EInt(n) => {\n      emit_i64_const(buf, n)\n      next_local\n    },\n    EBool(b_val) => {\n      emit_i64_const(buf, if b_val { 1 } else { 0 })\n      next_local\n    },\n    EFloat(v) => {\n      let bits = Double::to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n    },\n    EString(s) => {\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n      next_local\n    },\n    EIdent(name) => {\n      // Try local first\n      let len = Array::length(local_names)\n      let rec try_local = (i: Int) -> Int {\n        if i < 0 { -1 }\n        else if Array::get(local_names, i) == name { i }\n        else try_local(i - 1)\n      }\n      let local_idx = try_local(len - 1)\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          // Ref cell: local holds (ref $RefCell), read via struct.get\n          emit_local_get(buf, local_idx)\n          emit_struct_get(buf, ctx.refcell_type_idx, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        // Check if it's a 0-arg enum constructor\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n        // Check if it's a top-level function — emit as bare fn value\n        let fn_len = Array::length(ctx.func_table.names)\n        let mut fni = -1\n        let mut __fj = 0\n        while __fj < fn_len {\n          if Array::get(ctx.func_table.names, __fj) == name {\n            fni = __fj\n            __fj = fn_len\n          } else {\n            __fj = __fj + 1\n          }\n        }\n        if fni < 0 { throw(String::concat(\"undefined variable: \", name)) }\n        let fidx = Array::get(ctx.func_table.indices, fni)\n        let table_slot = fidx - ctx.func_offset\n        emit_i64_const(buf, (table_slot << 2) | 2)\n        next_local\n        }\n      }\n    },\n    EBinOp(op, lhs, rhs) => {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_binop_op(buf, op)\n      nl2\n    },\n    EUnaryOp(op, operand) => {\n      if op == \"-\" {\n        emit_i64_const(buf, 0)\n        let nl = ce(buf, operand, local_names, next_local, ld)\n        emit_i64_sub(buf)\n        nl\n      } else if op == \"!\" {\n        let nl = ce(buf, operand, local_names, next_local, ld)\n        // Bool: true=1, false=0. Use eqz to negate.\n        emit_i64_eqz(buf)\n        emit_i64_extend_i32_s(buf)\n        nl\n      } else {\n        throw(String::concat(\"unsupported unary op: \", op))\n      }\n    },\n    EIf(cond, then_e, else_e) => {\n      // Flatten if/else-if chains iteratively to reduce recursion depth\n      let mut cur_cond = cond\n      let mut cur_then = then_e\n      let mut cur_else = else_e\n      let mut if_depth = 0\n      let mut max_nl_chain = next_local\n      let mut cont_if = true\n      while cont_if {\n        let nl1 = match cur_cond {\n          EBinOp(cop, clhs, crhs) => if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n            let cnl1 = ce(buf, clhs, local_names, max_nl_chain, ld)\n            let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n            if cop == \"==\" { emit_i64_eq(buf) }\n            else if cop == \"!=\" { emit_i64_ne(buf) }\n            else if cop == \"<\" { emit_i64_lt_s(buf) }\n            else if cop == \">\" { emit_i64_gt_s(buf) }\n            else if cop == \"<=\" { emit_i64_le_s(buf) }\n            else { emit_i64_ge_s(buf) }\n            cnl2\n          } else {\n            let cnl = ce(buf, cur_cond, local_names, max_nl_chain, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          },\n          EBool(b_val) => {\n            emit_i32_const(buf, if b_val { 1 } else { 0 })\n            max_nl_chain\n          },\n          _ => {\n            let cnl = ce(buf, cur_cond, local_names, max_nl_chain, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        }\n        emit_if_i64(buf)\n        if_depth = if_depth + 1\n        let ld_inner = if ld >= 0 { ld + if_depth } else { -1 }\n        let names_len_before = Array::length(local_names)\n        let nl_then = ce(buf, cur_then, local_names, nl1, ld_inner)\n        if nl_then > max_nl_chain { max_nl_chain = nl_then }\n        emit_else(buf)\n        Array::truncate(local_names, names_len_before)\n        match cur_else {\n          EIf(next_cond, next_then, next_else) => {\n            cur_cond = next_cond\n            cur_then = next_then\n            cur_else = next_else\n          },\n          _ => {\n            let nl_else = ce(buf, cur_else, local_names, nl1, ld_inner)\n            if nl_else > max_nl_chain { max_nl_chain = nl_else }\n            cont_if = false\n          }\n        }\n      }\n      // Close all if/else blocks\n      let mut ci = 0\n      while ci < if_depth {\n        emit_end(buf)\n        ci = ci + 1\n      }\n      while Array::length(local_names) < max_nl_chain {\n        Array::push(local_names, \"\")\n      }\n      max_nl_chain\n    },\n    ECall(callee, args) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\n    ELet(name, value, body) => {\n      // Flatten ELet chains iteratively\n      let mut cur_name = name\n      let mut cur_value = value\n      let mut cur_body = body\n      let mut nl_let = next_local\n      let mut cont_let = true\n      while cont_let {\n        let local_idx = nl_let\n        Array::push(local_names, cur_name)\n        nl_let = ce(buf, cur_value, local_names, nl_let + 1, ld)\n        emit_local_set(buf, local_idx)\n        match cur_body {\n          ELet(next_name, next_value, next_body) => {\n            cur_name = next_name\n            cur_value = next_value\n            cur_body = next_body\n          },\n          _ => {\n            nl_let = ce(buf, cur_body, local_names, nl_let, ld)\n            cont_let = false\n          }\n        }\n      }\n      nl_let\n    },\n    ELetRec(name, value, body) => {\n      // Flatten ELetRec chains iteratively\n      let mut cur_name = name\n      let mut cur_value = value\n      let mut cur_body = body\n      let mut nl_rec = next_local\n      let mut cont_rec = true\n      while cont_rec {\n        let local_idx = nl_rec\n        Array::push(local_names, cur_name)\n        nl_rec = ce(buf, cur_value, local_names, nl_rec + 1, ld)\n        emit_local_set(buf, local_idx)\n        // Backpatch self-reference in closure for recursive let rec\n        match cur_value {\n          EFn(_, _, params, _, _, fn_body) => {\n            let param_names_bp = Array::slice([\"\"], 0, 0)\n            let mut bpi = 0\n            while bpi < Array::length(params) {\n              let (pn, _) = Array::get(params, bpi)\n              Array::push(param_names_bp, pn)\n              bpi = bpi + 1\n            }\n            let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n            let mut self_cap_idx = -1\n            let mut bci = 0\n            while bci < Array::length(caps) {\n              if Array::get(caps, bci) == cur_name {\n                self_cap_idx = bci\n              }\n              bci = bci + 1\n            }\n            if self_cap_idx >= 0 {\n              emit_local_get(buf, local_idx)\n              emit_i64_const(buf, -4)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_local_get(buf, local_idx)\n              emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n            }\n            0\n          },\n          _ => 0\n        }\n        match cur_body {\n          ELetRec(next_name, next_value, next_body) => {\n            cur_name = next_name\n            cur_value = next_value\n            cur_body = next_body\n          },\n          _ => {\n            nl_rec = ce(buf, cur_body, local_names, nl_rec, ld)\n            cont_rec = false\n          }\n        }\n      }\n      nl_rec\n    },\n    ELetMut(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if is_mut_captured_in(body, name) {\n        // Mutable captured: allocate GC ref cell via struct.new\n        Array::push(ctx.ref_cell_names, name)\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_struct_new(buf, ctx.refcell_type_idx)\n        emit_local_set(buf, local_idx)\n        Array::push(ctx.ref_local_indices, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      } else {\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_local_set(buf, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      }\n    },\n    EAssign(name, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        // Ref cell: struct.set\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    EAssignOp(name, op, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        // Ref cell: read via struct.get, compute, write via struct.set\n        emit_local_get(buf, idx)   // ref on stack (for struct.set later)\n        emit_local_get(buf, idx)   // ref on stack (for struct.get)\n        emit_struct_get(buf, ctx.refcell_type_idx, 0)  // current value\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    ESeq(first, second) => {\n      // Flatten ESeq chain iteratively to avoid deep recursion\n      let mut nl_s = ce(buf, first, local_names, next_local, ld)\n      emit_drop(buf)\n      let mut cur = second\n      let mut cont = true\n      while cont {\n        match cur {\n          ESeq(a, b) => {\n            nl_s = ce(buf, a, local_names, nl_s, ld)\n            emit_drop(buf)\n            cur = b\n          },\n          _ => {\n            nl_s = ce(buf, cur, local_names, nl_s, ld)\n            cont = false\n          }\n        }\n      }\n      nl_s\n    },\n    ETuple(elems) => {\n      // Allocate N*8 bytes on heap, store each element as i64\n      let num_elems = Array::length(elems)\n      let alloc_size = num_elems * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__tuple_ptr\")\n      let mut nl = next_local + 1\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    },\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\n    EArray(elems) => {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    },\n    EForIn(var_name, index_name, iter_expr, body) => {\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let arr_local = next_local\n      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__for_arr\")\n      let i_local = nl1\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_local)\n      Array::push(local_names, \"__for_i\")\n      let nl2 = nl1 + 1\n      emit_block_void(buf)\n        emit_loop_void(buf)\n          emit_local_get(buf, i_local)\n          emit_local_get(buf, arr_local)\n          emit_call(buf, arr_len_idx)\n          emit_i64_ge_s(buf)\n          // S1b: i64_ge_s already leaves i32, skip extend+wrap\n          emit_br_if(buf, 1)\n          let var_local = match index_name {\n            Some(_) => nl2 + 1,\n            None => nl2\n          }\n          match index_name {\n            Some(index_name) => {\n              emit_local_get(buf, i_local)\n              emit_local_set(buf, nl2)\n              Array::push(local_names, index_name)\n            },\n            None => ()\n          }\n          emit_local_get(buf, arr_local)\n          emit_local_get(buf, i_local)\n          emit_call(buf, arr_get_idx)\n          emit_local_set(buf, var_local)\n          Array::push(local_names, var_name)\n          let nl3 = var_local + 1\n          let nl4 = ce(buf, body, local_names, nl3, ld + 1)\n          emit_drop(buf)\n          emit_local_get(buf, i_local)\n          emit_i64_const(buf, 1)\n          emit_i64_add(buf)\n          emit_local_set(buf, i_local)\n          emit_br(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl4\n    },\n    EWhile(cond, body) => {\n      emit_block_void(buf)\n        emit_loop_void(buf)\n          // S1b: skip extend+wrap for comparison conditions in while\n          let nl1 = match cond {\n            EBinOp(wcop, wlhs, wrhs) => if wcop == \"==\" || wcop == \"!=\" || wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n              let wnl1 = ce(buf, wlhs, local_names, next_local, ld + 1)\n              let wnl2 = ce(buf, wrhs, local_names, wnl1, ld + 1)\n              if wcop == \"==\" { emit_i64_eq(buf) }\n              else if wcop == \"!=\" { emit_i64_ne(buf) }\n              else if wcop == \"<\" { emit_i64_lt_s(buf) }\n              else if wcop == \">\" { emit_i64_gt_s(buf) }\n              else if wcop == \"<=\" { emit_i64_le_s(buf) }\n              else { emit_i64_ge_s(buf) }\n              emit_i32_eqz(buf)\n              wnl2\n            } else {\n              let wnl = ce(buf, cond, local_names, next_local, ld + 1)\n              emit_i64_eqz(buf)\n              wnl\n            },\n            _ => {\n              let wnl = ce(buf, cond, local_names, next_local, ld + 1)\n              emit_i64_eqz(buf)\n              wnl\n            }\n          }\n          emit_br_if(buf, 1)\n          let nl2 = ce(buf, body, local_names, nl1, ld + 1)\n          emit_drop(buf)\n          emit_br(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl2\n    },\n    EBreak(_) => {\n      emit_br(buf, ld + 1)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EContinue(_) => {\n      emit_br(buf, ld)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EUnit => {\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EThrow(msg_expr) => {\n      let nl = ce(buf, msg_expr, local_names, next_local, ld)\n      emit_drop(buf)\n      bytebuf_push(buf, 0)  // unreachable\n      nl\n    },\n    EFn(_, _, params, _, _, fn_body) =>\n      compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),\n    EDot(obj, field) => {\n      // Struct field access: find field index from ctx.ctor_table.struct_field_names\n      let rec find_struct_field_idx = (si2: Int) -> Int {\n        if si2 >= Array::length(ctx.ctor_table.struct_names) { -1 }\n        else {\n          let fnames = Array::get(ctx.ctor_table.struct_field_names, si2)\n          let rec find_f = (fi: Int) -> Int {\n            if fi >= Array::length(fnames) { -1 }\n            else if Array::get(fnames, fi) == field { fi }\n            else find_f(fi + 1)\n          }\n          let idx = find_f(0)\n          if idx >= 0 { idx }\n          else find_struct_field_idx(si2 + 1)\n        }\n      }\n      let field_idx = find_struct_field_idx(0)\n      if field_idx < 0 {\n        throw(String::concat(\"unknown struct field: \", field))\n      }\n      let nl1 = ce(buf, obj, local_names, next_local, ld)\n      // Untag: ptr & ~1\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      // Load field at offset 8 + field_idx * 8\n      emit_i64_load(buf, 3, 8 + field_idx * 8)\n      nl1\n    },\n    ERecord(fields) => {\n      // Record literal: heap alloc [tag_i32 | field_count_i32 | fields:.]\n      let flen = Array::length(fields)\n      let obj_size = 8 + flen * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 0)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 4)\n      let mut nl_r = next_local + 1\n      let mut ri = 0\n      while ri < flen {\n        let (_, fexpr) = Array::get(fields, ri)\n        nl_r = ce(buf, fexpr, local_names, nl_r, ld)\n        let val_local = nl_r\n        Array::push(local_names, \"__rec_val\")\n        emit_local_set(buf, val_local)\n        nl_r = nl_r + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + ri * 8)\n        ri = ri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_r\n    },\n    EHandle(body, _) => ce(buf, body, local_names, next_local, ld),\n    EStringInterp(_) => throw(\"GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)\"),\n    _ => throw(\"unsupported expression in gc codegen\")\n  }\n}\n\n\n// === Builtin generators (copied from codegen.vibe) ===\n\nlet gen_print_i64_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_i32_const(b, 46)\n  emit_local_set(b, 2)\n  emit_i32_const(b, 47)\n  emit_i32_const(b, 10)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_i64_lt_s(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 1)\n  emit_if_i64(b)\n    emit_i64_const(b, 0)\n    emit_local_get(b, 0)\n    emit_i64_sub(b)\n  emit_else(b)\n    emit_local_get(b, 0)\n  emit_end(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 4)\n  emit_i64_eqz(b)\n  emit_if_void(b)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 48)\n    emit_i32_store8(b, 0, 0)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 1)\n    emit_i32_sub(b)\n    emit_local_set(b, 2)\n  emit_end(b)\n  emit_block_void(b)\n    emit_loop_void(b)\n      emit_local_get(b, 4)\n      emit_i64_eqz(b)\n      emit_br_if(b, 1)\n      emit_local_get(b, 4)\n      emit_i64_const(b, 10)\n      emit_i64_rem_s(b)\n      emit_i32_wrap_i64(b)\n      emit_local_set(b, 3)\n      emit_local_get(b, 2)\n      emit_local_get(b, 3)\n      emit_i32_const(b, 48)\n      emit_i32_add(b)\n      emit_i32_store8(b, 0, 0)\n      emit_local_get(b, 2)\n      emit_i32_cons