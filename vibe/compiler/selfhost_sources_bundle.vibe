e) -> Array[Type] = (a, b) -> {\\n  let arr = bytes_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet bytes_four_params: (Type, Type, Type, Type) -> Array[Type] = (a, b, c, d) -> {\\n  let arr = bytes_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  Array::push(arr, d)\\n  arr\\n}\\n\\nlet bytes_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\\n  let arr = bytes_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nlet lookup_bytes_get: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::get\\\" {\\n    Some(CtFn(bytes_two_params(CtBytes, CtInt), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_bytes_new: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::new\\\" {\\n    Some(CtFn(bytes_no_params(), CtBytes, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_bytes_set: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::set\\\" {\\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_bytes_blit: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::blit\\\" {\\n    Some(CtFn(bytes_four_params(CtBytes, CtBytes, CtInt, CtInt), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_bytes_fill: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::fill\\\" {\\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_bytes_push: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::push\\\" {\\n    Some(CtFn(bytes_two_params(CtBytes, CtInt), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_bytes_slice: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::slice\\\" {\\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtBytes, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_bytes_append: (String) -> Option[Type] = (name) -> {\\n  if