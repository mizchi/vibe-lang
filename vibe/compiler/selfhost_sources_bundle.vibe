\n  } else {\\n    bytebuf_push(buf, 0)\\n    0\\n  }\\n  if catch_nl > max_nl {\\n    max_nl = catch_nl\\n  }\\n  let mut ci2 = 0\\n  while ci2 < num_cond_arms {\\n    emit_end(buf)\\n    ci2 = ci2 + 1\\n  }\\n  while Array::length(local_names) < max_nl {\\n    Array::push(local_names, \\\"\\\")\\n  }\\n  max_nl\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\nexport let compile_call = (buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\\n  if is_eident(callee) {\\n    let fname = get_eident_name(callee)\\n    let fn_len2 = Array::length(ctx.func_table.names)\\n    let mut fn_idx_in_list = -1\\n    let mut __tr_j = 0\\n    while __tr_j < fn_len2 {\\n      if Array::get(ctx.func_table.names, __tr_j) == fname {\\n        fn_idx_in_list = __tr_j\\n        __tr_j = fn_len2\\n      } else {\\n        __tr_j = __tr_j + 1\\n      }\\n    }\\n    let mut local_idx_hint = -1\\n    let mut li = Array::length(local_names) - 1\\n    while li >= 0 {\\n      if Array::get(local_names, li) == fname {\\n        local_idx_hint = li\\n        li = -1\\n      } else {\\n        li = li - 1\\n      }\\n    }\\n    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0\\n    let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\\n    if ctor_lookup_idx >= 0 {\\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\\n      let obj_size = 8 + fc * 8\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__ctor_ptr\\\")\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, ptr_local)\\n      emit_global_get(buf, 0)\\n      emit_i32_const(buf, obj_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf