let (eq_fi, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\\n        let map_l = nl\\n        let key_l = nl + 1\\n        let cnt_l = nl + 2\\n        let idx_l = nl + 3\\n        Array::push(local_names, \\\"__hk_map\\\")\\n        Array::push(local_names, \\\"__hk_key\\\")\\n        Array::push(local_names, \\\"__hk_cnt\\\")\\n        Array::push(local_names, \\\"__hk_i\\\")\\n        emit_local_set(buf, key_l)\\n        emit_local_set(buf, map_l)\\n        emit_local_get(buf, map_l)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_load(buf, 2, 0)\\n        emit_i64_extend_i32_u(buf)\\n        emit_local_set(buf, cnt_l)\\n        emit_i64_const(buf, 0)\\n        emit_local_set(buf, idx_l)\\n        emit_block_i64(buf)\\n        emit_block_void(buf)\\n        emit_loop_void(buf)\\n        emit_local_get(buf, idx_l)\\n        emit_local_get(buf, cnt_l)\\n        emit_i64_ge_s(buf)\\n        emit_br_if(buf, 1)\\n        emit_local_get(buf, map_l)\\n        emit_i32_wrap_i64(buf)\\n        emit_local_get(buf, idx_l)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 16)\\n        emit_i32_mul(buf)\\n        emit_i32_add(buf)\\n        emit_i64_load(buf, 3, 8)\\n        emit_local_get(buf, key_l)\\n        emit_call(buf, eq_fi)\\n        emit_i32_wrap_i64(buf)\\n        emit_if_void(buf)\\n        emit_i64_const(buf, 1)\\n        emit_br(buf, 3)\\n        emit_end(buf)\\n        emit_local_get(buf, idx_l)\\n        emit_i64_const(buf, 1)\\n        emit_i64_add(buf)\\n        emit_local_set(buf, idx_l)\\n        emit_br(buf, 0)\\n        emit_end(buf)\\n        emit_end(buf)\\n        emit_i64_const(buf, 0)\\n        emit_end(buf)\\n        nl + 4\\n      }\\n      else if fname == \\\"Map::keys\\\" {\\n        let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n        let (arr_push_fi