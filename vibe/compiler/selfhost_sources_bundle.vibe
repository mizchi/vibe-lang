"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nexport let lookup_builtin: (String) -> Option[Type] = (name) -> {\n  let normalized = canonical_builtin_name(name)\n  match lookup_array(normalized) {\n    Some(t) => Some(t),\n    None => match lookup_fixed_array(normalized) {\n      Some(t) => Some(t),\n      None => match lookup_array_builder(normalized) {\n        Some(t) => Some(t),\n        None => match lookup_string1(normalized) {\n          Some(t) => Some(t),\n          None => match lookup_string2(normalized) {\n            Some(t) => Some(t),\n            None => match lookup_string_builder(normalized) {\n              Some(t) => Some(t),\n              None => match lookup_bytes(normalized) {\n                Some(t) => Some(t),\n                None => match lookup_simd(normalized) {\n                Some(t) => Some(t),\n                None => match lookup_map(normalized) {\n                  Some(t) => Some(t),\n                  None => match lookup_io(normalized) {\n                    Some(t) => Some(t),\n                    None => match lookup_fs(normalized) {\n                      Some(t) => Some(t),\n                      None => match lookup_net(normalized) {\n                        Some(t) => Some(t),\n                        None => match lookup_misc(normalized) {\n                          Some(t) => Some(t),\n                          None => lookup_async(normalized)\n                        }\n                      }\n                    }\n                  }\n                }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n")
}

let selfhost_source_28 = () -> (String, String) {
  ("vibe/compiler/checker/builtins_fs.vibe",
"\n\n\nlet fs_no_params: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet fs_one_param: (Type) -> Array[Type] = (a) -> {\n  let arr = fs_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nlet fs_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\n  let arr = fs_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nlet lookup_fs_copy: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::copy\" {\n    Some(CtFn(fs_two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_chdir: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::chdir\" {\n    Some(CtFn(fs_one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_mkdir: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::mkdir\" {\n    Some(CtFn(fs_one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_append: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::append\" {\n    Some(CtFn(fs_two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_exists: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::exists\" {\n    Some(CtFn(fs_one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_getcwd: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::getcwd\" {\n    Some(CtFn(fs_no_params(), CtString, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_is_dir: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::is_dir\" {\n    Some(CtFn(fs_one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_remove: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::remove\" {\n    Some(CtFn(fs_one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_d: (String) -> Option[Type] = (name) -> {\n  match lookup_fs_remove(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_copy(name) {\n      Some(t) => Some(t),\n      None => lookup_fs_append(name)\n    }\n  }\n}\n\nlet lookup_fs_is_file: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::is_file\" {\n    Some(CtFn(fs_one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_c: (String) -> Option[Type] = (name) -> {\n  match lookup_fs_is_file(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_mkdir(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_getcwd(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_chdir(name)\n      }\n    }\n  }\n}\n\nlet lookup_fs_readdir: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::readdir\" {\n    Some(CtFn(fs_one_param(CtString), CtArray(CtString), Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_read_file: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::read_file\" {\n    Some(CtFn(fs_one_param(CtString), CtString, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_read_bytes: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::read_bytes\" {\n    Some(CtFn(fs_one_param(CtString), CtBytes, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_stat_token: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::stat_token\" {\n    Some(CtFn(fs_one_param(CtString), CtInt, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_b: (String) -> Option[Type] = (name) -> {\n  match lookup_fs_exists(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_stat_token(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_readdir(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_is_dir(name)\n      }\n    }\n  }\n}\n\nlet lookup_fs_write_file: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::write_file\" {\n    Some(CtFn(fs_two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_write_bytes: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::write_bytes\" {\n    Some(CtFn(fs_two_params(CtString, CtBytes), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_a: (String) -> Option[Type] = (name) -> {\n  match lookup_fs_read_file(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_write_file(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_read_bytes(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_write_bytes(name)\n      }\n    }\n  }\n}\n\nexport let lookup_fs: (String) -> Option[Type] = (name) -> {\n  match lookup_fs_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_group_c(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_group_d(name)\n      }\n    }\n  }\n}\n")
}

let selfhost_source_29 = () -> (String, String) {
  ("vibe/compiler/checker/builtins_system.vibe",
"\n\n\nlet system_no_params: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet lookup_io_a: (String) -> Option[Type] = (name) -> {\n  if name == \"sh\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Process\")))\n  } else if name == \"sh_lines\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), Some(\"Process\")))\n  } else if name == \"path\" {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, None))\n  } else if name == \"Path::to_string\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, None))\n  } else if name == \"Path::is_absolute\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, None))\n  } else if name == \"PromptText::new\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Stdin::read_char\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Stdin\")))\n  } else if name == \"Stdin::read_stream\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Stdin\")))\n  } else {\n    None\n  }\n}\n\nlet lookup_io_b: (String) -> Option[Type] = (name) -> {\n  if name == \"Stdout::write_char\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, None))\n  } else if name == \"Stdout::write_stream\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, None))\n  } else if name == \"Env::get\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Env::args_len\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Env\")))\n  } else if name == \"Env::args_get\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Profiler::now_us\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Profiler\")))\n  } else if name == \"sleep\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Async\")))\n  } else if name == \"Path::resolve\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nlet lookup_io_c: (String) -> Option[Type] = (name) -> {\n  if name == \"Lines::parse\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), None))\n  } else if name == \"Lines::stringify\" {\n    Some(CtFn([\n      CtArray(CtString)\n    ], CtString, None))\n  } else if name == \"Llm::complete\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::run\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::finalize\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport let lookup_io: (String) -> Option[Type] = (name) -> {\n  match lookup_io_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_io_b(name) {\n      Some(t) => Some(t),\n      None => lookup_io_c(name)\n    }\n  }\n}\n")
}

