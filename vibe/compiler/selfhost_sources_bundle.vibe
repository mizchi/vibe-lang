\\n    let ptr_local = next_local\\n    let nl2 = next_local + 1\\n    Array::push(local_names, \\\"__closure_ptr\\\")\\n    emit_global_get(buf, 0)\\n    emit_i64_extend_i32_u(buf)\\n    emit_local_tee(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, alloc_size)\\n    emit_i32_add(buf)\\n    emit_global_set(buf, 0)\\n    emit_heap_memory_grow_check(buf)\\n    emit_local_get(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, table_slot)\\n    emit_i32_store(buf, 2, 0)\\n    emit_local_get(buf, ptr_local)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, num_captures)\\n    emit_i32_store(buf, 2, 4)\\n    let mut csi = 0\\n    while csi < num_captures {\\n      let cap_name = Array::get(captures, csi)\\n      let cap_idx = resolve_local(local_names, cap_name, \\\"gc_cap\\\")\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, cap_idx)\\n      emit_i64_store(buf, 3, 8 + csi * 8)\\n      csi = csi + 1\\n    }\\n    emit_local_get(buf, ptr_local)\\n    emit_i64_const(buf, 1)\\n    emit_i64_or(buf)\\n    nl2\\n  }\\n}\\nexport {\\n  emit_lambda_closure_gc\\n}\\nlet make_lambda_ctx_gc: (CompileCtxGc, Array[String], Array[Int]) -> CompileCtxGc = (ctx, ref_cell_names, ref_local_indices) -> {\\n  CompileCtxGc::{\\n    func_table: ctx.func_table, str_table: ctx.str_table,\\n    lambda_table: ctx.lambda_table,\\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\\n    ref_cell_names: ref_cell_names, ref_local_indices: ref_local_indices,\\n    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,\\n    ctor_table: ctx.ctor_table\\n  }\\n}\\nexport {\\n  make_lambda_ctx_gc\\n}\\nexport type CompileLambdaGcFn = (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }\\nexport let compile_lambda_inner_gc: (Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtxGc, CompileLambdaGcFn, Int) -> (Bytes, Int) with { Error } = (params, fn_body, captures, user_params, ctx, compile_fn, ld) -> {\\n  let lam_buf = bytebuf_new()\\n  let lam_locals = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut lpi = 0\\n  while lpi < user_params {\\n    let (lpname, _) = Array::get(params, lpi)\\n    Array::push(lam_locals, lpname)\\n    lpi = lpi + 1\\n  }\\n  Array::push(lam_locals, \\\"__env\\\")\\n  let env_param_idx = user_params\\n  let lam_nl_start = user_params + 1\\n  let lam_ref_cells = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_ref_local_indices = Array::slice([\\n    0\\n  ], 0, 0)\\n  let num_captures = Array::length(captures)\\n  let mut ci3 = 0\\n  let mut lam_nl = lam_nl_start\\n  while ci3 < num_captures {\\n    let cap_local = lam_nl\\n    let cap_name = Array::get(captures, ci3)\\n    emit_local_get(lam_buf, env_param_idx)\\n    emit_i32_wrap_i64(lam_buf)\\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\\n    emit_local_set(lam_buf, cap_local)\\n    Array::push(lam_locals, cap_name)\\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\\n      Array::push(lam_ref_cells, cap_name)\\n    }\\n    lam_nl = lam_nl + 1\\n    ci3 = ci3 + 1\\n  }\\n  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)\\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)\\n  (lam_buf, final_lam_nl)\\n}\\nexport let record_lambda_meta_gc: (CompileCtxGc, Bytes, Int, Array[String], Int) -> Int = (ctx, lam_buf, user_params, captures, final_lam_nl) -> {\\n  let lambda_table = ctx.lambda_table\\n  let lambda_idx = Array::length(lambda_table.bodies)\\n  Array::push(lambda_table.bodies, lam_buf)\\n  Array::push(lambda_table.param_counts, user_params + 1)\\n  Array::push(lambda_table.captures, captures)\\n  let mut extra_lam = 0\\n  let min_lam_nl = user_params + 1\\n  if final_lam_nl > min_lam_nl {\\n    extra_lam = final_lam_nl - min_lam_nl\\n  }\\n  Array::push(lambda_table.meta_i32, 0)\\n  Array::push(lambda_table.meta_i64, extra_lam)\\n  lambda_idx\\n}\\nexport let compile_lambda_gc: (Bytes, Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtxGc, Int, CompileLambdaGcFn) -> Int with { Error } = (buf, params, fn_body, local_names, next_local, ctx, ld, compile_fn) -> {\\n  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)\\n  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)\\n  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)\\n  let table_slot = ctx.num_user_funcs + lambda_idx\\n  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)\\n}\\nlet field_index_in_gc: (Array[String], String) -> Int = (fnames, field) -> {\\n  let mut fi = 0\\n  let mut found = -1\\n  while fi < Array::length(fnames) {\\n    if Array::get(fnames, fi) == field {\\n      found = fi\\n      fi = Array::length(fnames)\\n    } else {\\n      fi = fi + 1\\n    }\\n  }\\n  found\\n}\\nlet struct_field_index_gc: (CompileCtxGc, String, String) -> Int with { Error } = (ctx, sname, field) -> {\\n  let names = ctx.ctor_table.struct_names\\n  let mut si = 0\\n  let mut sidx = -1\\n  while si < Array::length(names) {\\n    if Array::get(names, si) == sname {\\n      sidx = si\\n      si = Array::length(names)\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  if sidx >= 0 {\\n    let found = field_index_in_gc(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\\n    if found < 0 {\\n      throw(String::concat(String::concat(String::concat(\\\"unknown field `\\\", field), \\\"` in struct \\\"), sname))\\n    } else {\\n      found\\n    }\\n  } else {\\n    let mut gsi = 0\\n    let mut gfound = -1\\n    while gsi < Array::length(names) {\\n      let f = field_index_in_gc(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\\n      if f >= 0 {\\n        gfound = f\\n        gsi = Array::length(names)\\n      } else {\\n        gsi = gsi + 1\\n      }\\n    }\\n    if gfound < 0 {\\n      throw(String::concat(\\\"unknown struct field in pattern: \\\", field))\\n    } else {\\n      gfound\\n    }\\n  }\\n}\\nlet compile_match_gc: (Bytes, Expr, Array[(Pat, Expr)], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, scrutinee, arms, local_names, next_local, ctx, ld, ce) -> {\\n  let scrut_local = next_local\\n  Array::push(local_names, \\\"__match_scrut\\\")\\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\\n  emit_local_set(buf, scrut_local)\\n  let num_arms = Array::length(arms)\\n  let catchall_idx = find_catchall_idx(arms)\\n  let num_cond_arms = catchall_idx\\n  let mut max_nl = nl1\\n  let mut ai = 0\\n  while ai < num_cond_arms {\\n    let (p, _) = Array::get(arms, ai)\\n    match p {\\n      PInt(n) => {\\n        emit_local_get(buf, scrut_local)\\n        emit_i64_const(buf, n)\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n        0\\n      },\\n      PBool(bv) => {\\n        emit_local_get(buf, scrut_local)\\n        emit_i64_const(buf, if bv {\\n          1\\n        } else {\\n          0\\n        })\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n        0\\n      },\\n      PCtor(cname_cond, _) => {\\n        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\\n        let expected_tag = if ctor_ci >= 0 {\\n          Array::get(ctx.ctor_table.tags, ctor_ci)\\n        } else {\\n          -1\\n        }\\n        emit_local_get(buf, scrut_local)\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_load(buf, 2, 0)\\n        emit_i32_const(buf, expected_tag)\\n        emit_i32_eq(buf)\\n        emit_if_i64(buf)\\n        0\\n      },\\n      PString(sval) => {\\n        let str_idx = str_table_lookup(ctx.str_table.strs, sval)\\n        if str_idx >= 0 {\\n          emit_local_get(buf, scrut_local)\\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\\n          emit_call(buf, 4)\\n          emit_i64_const(buf, 1)\\n          emit_i64_eq(buf)\\n          emit_if_i64(buf)\\n        }\\n        0\\n      },\\n      _ => 0\\n    }\\n    let names_len_at_arm = Array::length(local_names)\\n    let (p2, arm_body) = Array::get(arms, ai)\\n    let ld_arm = if ld >= 0 {\\n      ld + ai + 1\\n    } else {\\n      -1\\n    }\\n    match p2 {\\n      PCtor(_, cargs_bind) => {\\n        let mut cbi = 0\\n        while cbi < Array::length(cargs_bind) {\\n          match Array::get(cargs_bind, cbi) {\\n            PBind(pname) => {\\n              let fl = Array::length(local_names)\\n              emit_local_get(buf, scrut_local)\\n              emit_i64_const(buf, -2)\\n              emit_i64_and(buf)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, 8 + cbi * 8)\\n              emit_local_set(buf, fl)\\n              Array::push(local_names, pname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => 0\\n          }\\n          cbi = cbi + 1\\n        }\\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\\n        if arm_nl > max_nl {\\n          max_nl = arm_nl\\n        }\\n        0\\n      },\\n      PTuple(tpats) => {\\n        let mut tbi = 0\\n        while tbi < Array::length(tpats) {\\n          match Array::get(tpats, tbi) {\\n            PBind(tname) => {\\n              let tl = Array::length(local_names)\\n              emit_local_get(buf, scrut_local)\\n              emit_i64_const(buf, -2)\\n              emit_i64_and(buf)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, 8 + tbi * 8)\\n              emit_local_set(buf, tl)\\n              Array::push(local_names, tname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => 0\\n          }\\n          tbi = tbi + 1\\n        }\\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\\n        if arm_nl > max_nl {\\n          max_nl = arm_nl\\n        }\\n        0\\n      },\\n      PBind(bname_arm) => {\\n        let bl = Array::length(local_names)\\n        emit_local_get(buf, scrut_local)\\n        emit_local_set(buf, bl)\\n        Array::push(local_names, bname_arm)\\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\\n        if arm_nl > max_nl {\\n          max_nl = arm_nl\\n        }\\n        0\\n      },\\n      _ => {\\n        let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)\\n        if arm_nl > max_nl {\\n          max_nl = arm_nl\\n        }\\n        0\\n      }\\n    }\\n    emit_else(buf)\\n    Array::truncate(local_names, names_len_at_arm)\\n    ai = ai + 1\\n  }\\n  let ld_catch = if ld >= 0 {\\n    ld + num_cond_arms\\n  } else {\\n    -1\\n  }\\n  let _names_len_at_catch = Array::length(local_names)\\n  if catchall_idx < num_arms {\\n    let (cp, cbody) = Array::get(arms, catchall_idx)\\n    let catch_nl = match cp {\\n      PBind(bname) => {\\n        let bind_local = Array::length(local_names)\\n        emit_local_get(buf, scrut_local)\\n        emit_local_set(buf, bind_local)\\n        Array::push(local_names, bname)\\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n      },\\n      PCtor(_cname, cargs) => {\\n        let mut cbi2 = 0\\n        while cbi2 < Array::length(cargs) {\\n          match Array::get(cargs, cbi2) {\\n            PBind(pname) => {\\n              let fl2 = Array::length(local_names)\\n              emit_local_get(buf, scrut_local)\\n              emit_i64_const(buf, -2)\\n              emit_i64_and(buf)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, 8 + cbi2 * 8)\\n              emit_local_set(buf, fl2)\\n              Array::push(local_names, pname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => 0\\n          }\\n          cbi2 = cbi2 + 1\\n        }\\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n      },\\n      PTuple(pats) => {\\n        let ptr_local2 = Array::length(local_names)\\n        emit_local_get(buf, scrut_local)\\n        emit_local_set(buf, ptr_local2)\\n        Array::push(local_names, \\\"__tup_ptr2\\\")\\n        let mut pi2 = 0\\n        while pi2 < Array::length(pats) {\\n          let tp = Array::get(pats, pi2)\\n          match tp {\\n            PBind(pname) => {\\n              let field_l = Array::length(local_names)\\n              emit_local_get(buf, ptr_local2)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, pi2 * 8)\\n              emit_local_set(buf, field_l)\\n              Array::push(local_names, pname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => throw(\\\"unsupported pattern in tuple destructure\\\")\\n          }\\n          pi2 = pi2 + 1\\n        }\\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n      },\\n      PStruct(__sname, sfields) => {\\n        let sp_ptr = Array::length(local_names)\\n        emit_local_get(buf, scrut_local)\\n        emit_local_set(buf, sp_ptr)\\n        Array::push(local_names, \\\"__struct_ptr\\\")\\n        let mut sfi = 0\\n        while sfi < Array::length(sfields) {\\n          let (fname, subpat) = Array::get(sfields, sfi)\\n          match subpat {\\n            PBind(pname) => {\\n              let off = 8 + struct_field_index_gc(ctx, __sname, fname) * 8\\n              let fl = Array::length(local_names)\\n              emit_local_get(buf, sp_ptr)\\n              emit_i64_const(buf, -2)\\n              emit_i64_and(buf)\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, off)\\n              emit_local_set(buf, fl)\\n              Array::push(local_names, pname)\\n              0\\n            },\\n            PWild => 0,\\n            _ => 0\\n          }\\n          sfi = sfi + 1\\n        }\\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n      },\\n      _ => ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\\n    }\\n    if catch_nl > max_nl {\\n      max_nl = catch_nl\\n    }\\n    0\\n  } else {\\n    bytebuf_push(buf, 0)\\n    0\\n  }\\n  let mut ci2 = 0\\n  while ci2 < num_cond_arms {\\n    emit_end(buf)\\n    ci2 = ci2 + 1\\n  }\\n  while Array::length(local_names) < max_nl {\\n    Array::push(local_names, \\\"\\\")\\n  }\\n  max_nl\\n}\\nexport {\\n  compile_match_gc\\n}\\nlet rec compile_expr_gc: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {\\n  let ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error } = (b, e, ln, nl, d) -> {\\n    compile_expr_gc(b, e, ln, nl, ctx, d)\\n  }\\n  match expr {\\n    EInt(n) => {\\n      emit_i64_const(buf, n)\\n      next_local\\n    },\\n    EBool(b_val) => {\\n      emit_i64_const(buf, if b_val {\\n        1\\n      } else {\\n        0\\n      })\\n      next_local\\n    },\\n    EFloat(v) => {\\n      let bits = Double::to_i64_bits(v)\\n      emit_f64_const_bits(buf, bits)\\n      emit_i64_reinterpret_f64(buf)\\n      next_local\\n    },\\n    EString(s) => {\\n      let idx = str_table_lookup(ctx.str_table.strs, s)\\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\\n      next_local\\n    },\\n    EIdent(name, _) => {\\n      let len = Array::length(local_names)\\n      let rec try_local: (Int) -> Int = (i) -> {\\n        if i < 0 {\\n          -1\\n        }\\n        else if Array::get(local_names, i) == name {\\n          i\\n        }\\n        else try_local(i - 1)\\n      }\\n      let local_idx = try_local(len - 1)\\n      if local_idx >= 0 {\\n        if array_contains_str(ctx.ref_cell_names, name) {\\n          emit_local_get(buf, local_idx)\\n          emit_struct_get(buf, ctx.refcell_type_idx, 0)\\n        } else {\\n          emit_local_get(buf, local_idx)\\n        }\\n        next_local\\n      } else {\\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\\n        if ctor_idx >= 0 {\\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\\n          let ptr_l = next_local\\n          Array::push(local_names, \\\"__ctor_ptr\\\")\\n          emit_global_get(buf, 0)\\n          emit_i64_extend_i32_u(buf)\\n          emit_local_set(buf, ptr_l)\\n          emit_global_get(buf, 0)\\n          emit_i32_const(buf, 8)\\n          emit_i32_add(buf)\\n          emit_global_set(buf, 0)\\n          emit_heap_memory_grow_check(buf)\\n          emit_local_get(buf, ptr_l)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_const(buf, tag_c)\\n          emit_i32_store(buf, 2, 0)\\n          emit_local_get(buf, ptr_l)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_const(buf, 0)\\n          emit_i32_store(buf, 2, 4)\\n          emit_local_get(buf, ptr_l)\\n          emit_i64_const(buf, 1)\\n          emit_i64_or(buf)\\n          next_local + 1\\n        } else {\\n          let fn_len = Array::length(ctx.func_table.names)\\n          let mut fni = -1\\n          let mut __fj = 0\\n          while __fj < fn_len {\\n            if Array::get(ctx.func_table.names, __fj) == name {\\n              fni = __fj\\n              __fj = fn_len\\n            } else {\\n              __fj = __fj + 1\\n            }\\n          }\\n          if fni < 0 {\\n            throw(String::concat(\\\"undefined variable: \\\", name))\\n          }\\n          let fidx = Array::get(ctx.func_table.indices, fni)\\n          let table_slot = fidx - ctx.func_offset\\n          emit_i64_const(buf, (table_slot<<2)|2)\\n          next_local\\n        }\\n      }\\n    },\\n    EBinOp(op, lhs, rhs) => {\\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\\n      emit_binop_op(buf, op)\\n      nl2\\n    },\\n    EUnaryOp(op, operand) => if op == \\\"-\\\" {\\n      emit_i64_const(buf, 0)\\n      let nl = ce(buf, operand, local_names, next_local, ld)\\n      emit_i64_sub(buf)\\n      nl\\n    } else if op == \\\"!\\\" {\\n      let nl = ce(buf, operand, local_names, next_local, ld)\\n      emit_i64_eqz(buf)\\n      emit_i64_extend_i32_s(buf)\\n      nl\\n    } else {\\n      throw(String::concat(\\\"unsupported unary op: \\\", op))\\n    }\\n    ,\\n    EIf(cond, then_e, else_e) => {\\n      let nl1 = match cond {\\n        EBinOp(cop, clhs, crhs) => if cop == \\\"==\\\" || cop == \\\"!=\\\" || cop == \\\"<\\\" || cop == \\\">\\\" || cop == \\\"<=\\\" || cop == \\\">=\\\" {\\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\\n          if cop == \\\"==\\\" {\\n            emit_i64_eq(buf)\\n          }\\n          else if cop == \\\"!=\\\" {\\n            emit_i64_ne(buf)\\n          }\\n          else if cop == \\\"<\\\" {\\n            emit_i64_lt_s(buf)\\n          }\\n          else if cop == \\\">\\\" {\\n            emit_i64_gt_s(buf)\\n          }\\n          else if cop == \\\"<=\\\" {\\n            emit_i64_le_s(buf)\\n          }\\n          else {\\n            emit_i64_ge_s(buf)\\n          }\\n          cnl2\\n        } else {\\n          let cnl = ce(buf, cond, local_names, next_local, ld)\\n          emit_i32_wrap_i64(buf)\\n          cnl\\n        },\\n        EBool(b_val) => {\\n          emit_i32_const(buf, if b_val {\\n            1\\n          } else {\\n            0\\n          })\\n          next_local\\n        },\\n        _ => {\\n          let cnl = ce(buf, cond, local_names, next_local, ld)\\n          emit_i32_wrap_i64(buf)\\n          cnl\\n        }\\n      }\\n      emit_if_i64(buf)\\n      let ld_inner = if ld >= 0 {\\n        ld + 1\\n      } else {\\n        -1\\n      }\\n      let names_len_before = Array::length(local_names)\\n      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)\\n      emit_else(buf)\\n      Array::truncate(local_names, names_len_before)\\n      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)\\n      emit_end(buf)\\n      Array::truncate(local_names, names_len_before)\\n      let max_nl = if nl_then > nl_else {\\n        nl_then\\n      } else {\\n        nl_else\\n      }\\n      while Array::length(local_names) < max_nl {\\n        Array::push(local_names, \\\"\\\")\\n      }\\n      max_nl\\n    },\\n    ECall(callee, args, _) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\\n    ELet(name, value, body) => {\\n      let local_idx = next_local\\n      Array::push(local_names, name)\\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\\n      emit_local_set(buf, local_idx)\\n      ce(buf, body, local_names, nl, ld)\\n    },\\n    ELetRec(name, value, body) => {\\n      let local_idx = next_local\\n      Array::push(local_names, name)\\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\\n      emit_local_set(buf, local_idx)\\n      match value {\\n        EFn(_, _, params, _, _, fn_body) => {\\n          let param_names_bp = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          let mut bpi = 0\\n          while bpi < Array::length(params) {\\n            let (pn, _) = Array::get(params, bpi)\\n            Array::push(param_names_bp, pn)\\n            bpi = bpi + 1\\n          }\\n          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\\n          let mut self_cap_idx = -1\\n          let mut bci = 0\\n          while bci < Array::length(caps) {\\n            if Array::get(caps, bci) == name {\\n              self_cap_idx = bci\\n            }\\n            bci = bci + 1\\n          }\\n          if self_cap_idx >= 0 {\\n            emit_local_get(buf, local_idx)\\n            emit_i64_const(buf, -4)\\n            emit_i64_and(buf)\\n            emit_i32_wrap_i64(buf)\\n            emit_local_get(buf, local_idx)\\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\\n          }\\n          0\\n        },\\n        _ => 0\\n      }\\n      ce(buf, body, local_names, nl, ld)\\n    },\\n    ELetMut(name, value, body) => {\\n      let local_idx = next_local\\n      Array::push(local_names, name)\\n      if mut_needs_ref_cell(body, name) {\\n        Array::push(ctx.ref_cell_names, name)\\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\\n        emit_struct_new(buf, ctx.refcell_type_idx)\\n        emit_local_set(buf, local_idx)\\n        Array::push(ctx.ref_local_indices, local_idx)\\n        let nl2 = ce(buf, body, local_names, nl, ld)\\n        nl2\\n      } else {\\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\\n        emit_local_set(buf, local_idx)\\n        let nl2 = ce(buf, body, local_names, nl, ld)\\n        nl2\\n      }\\n    },\\n    EAssign(name, value, body) => {\\n      let idx = resolve_local(local_names, name, \\\"gc_var\\\")\\n      if array_contains_str(ctx.ref_cell_names, name) {\\n        emit_local_get(buf, idx)\\n        let nl = ce(buf, value, local_names, next_local, ld)\\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\\n        ce(buf, body, local_names, nl, ld)\\n      } else {\\n        let nl = ce(buf, value, local_names, next_local, ld)\\n        emit_local_set(buf, idx)\\n        ce(buf, body, local_names, nl, ld)\\n      }\\n    },\\n    EAssignOp(name, op, value, body) => {\\n      let idx = resolve_local(local_names, name, \\\"gc_var\\\")\\n      if array_contains_str(ctx.ref_cell_names, name) {\\n        emit_local_get(buf, idx)\\n        emit_local_get(buf, idx)\\n        emit_struct_get(buf, ctx.refcell_type_idx, 0)\\n        let nl = ce(buf, value, local_names, next_local, ld)\\n        emit_assignop_op(buf, op)\\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\\n        ce(buf, body, local_names, nl, ld)\\n      } else {\\n        emit_local_get(buf, idx)\\n        let nl = ce(buf, value, local_names, next_local, ld)\\n        emit_assignop_op(buf, op)\\n        emit_local_set(buf, idx)\\n        ce(buf, body, local_names, nl, ld)\\n      }\\n    },\\n    ESeq(first, second) => {\\n      let nl_s = ce(buf, first, local_names, next_local, ld)\\n      emit_drop(buf)\\n      ce(buf, second, local_names, nl_s, ld)\\n    },\\n    ETuple(elems) => {\\n      let num_elems = Array::length(elems)\\n      let alloc_size = num_elems * 8\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__tuple_ptr\\\")\\n      let mut nl = next_local + 1\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_tee(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, alloc_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_memory_grow_check(buf)\\n      let mut ti = 0\\n      while ti < num_elems {\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)\\n        emit_i64_store(buf, 3, ti * 8)\\n        ti = ti + 1\\n      }\\n      emit_local_get(buf, ptr_local)\\n      nl\\n    },\\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\\n    EArray(elems) => {\\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::push\\\")\\n      let arr_local = next_local\\n      emit_call(buf, arr_new_idx)\\n      emit_local_set(buf, arr_local)\\n      Array::push(local_names, \\\"__arr_lit\\\")\\n      let mut nl = next_local + 1\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        emit_local_get(buf, arr_local)\\n        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)\\n        emit_call(buf, arr_push_idx)\\n        ei = ei + 1\\n      }\\n      emit_local_get(buf, arr_local)\\n      nl\\n    },\\n    EForIn(var_name, index_name, iter_expr, body) => {\\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::length\\\")\\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::get\\\")\\n      let arr_local = next_local\\n      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)\\n      emit_local_set(buf, arr_local)\\n      Array::push(local_names, \\\"__for_arr\\\")\\n      let i_local = nl1\\n      emit_i64_const(buf, 0)\\n      emit_local_set(buf, i_local)\\n      Array::push(local_names, \\\"__for_i\\\")\\n      let nl2 = nl1 + 1\\n      emit_block_void(buf)\\n      emit_loop_void(buf)\\n      emit_local_get(buf, i_local)\\n      emit_local_get(buf, arr_local)\\n      emit_call(buf, arr_len_idx)\\n      emit_i64_ge_s(buf)\\n      emit_br_if(buf, 1)\\n      let var_local = match index_name {\\n        Some(_) => nl2 + 1,\\n        None => nl2\\n      }\\n      match index_name {\\n        Some(index_name) => {\\n          emit_local_get(buf, i_local)\\n          emit_local_set(buf, nl2)\\n          Array::push(local_names, index_name)\\n        },\\n        None => ()\\n      }\\n      emit_local_get(buf, arr_local)\\n      emit_local_get(buf, i_local)\\n      emit_call(buf, arr_get_idx)\\n      emit_local_set(buf, var_local)\\n      Array::push(local_names, var_name)\\n      let nl3 = var_local + 1\\n      let nl4 = ce(buf, body, local_names, nl3, ld + 1)\\n      emit_drop(buf)\\n      emit_local_get(buf, i_local)\\n      emit_i64_const(buf, 1)\\n      emit_i64_add(buf)\\n      emit_local_set(buf, i_local)\\n      emit_br(buf, 0)\\n      emit_end(buf)\\n      emit_end(buf)\\n      emit_i64_const(buf, 0)\\n      nl4\\n    },\\n    EWhile(cond, body) => {\\n      emit_block_void(buf)\\n      emit_loop_void(buf)\\n      let nl1 = match cond {\\n        EBinOp(wcop, wlhs, wrhs) => if wcop == \\\"==\\\" || wcop == \\\"!=\\\" || wcop == \\\"<\\\" || wcop == \\\">\\\" || wcop == \\\"<=\\\" || wcop == \\\">=\\\" {\\n          let wnl1 = ce(buf, wlhs, local_names, next_local, ld + 1)\\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, ld + 1)\\n          if wcop == \\\"==\\\" {\\n            emit_i64_eq(buf)\\n          }\\n          else if wcop == \\\"!=\\\" {\\n            emit_i64_ne(buf)\\n          }\\n          else if wcop == \\\"<\\\" {\\n            emit_i64_lt_s(buf)\\n          }\\n          else if wcop == \\\">\\\" {\\n            emit_i64_gt_s(buf)\\n          }\\n          else if wcop == \\\"<=\\\" {\\n            emit_i64_le_s(buf)\\n          }\\n          else {\\n            emit_i64_ge_s(buf)\\n          }\\n          emit_i32_eqz(buf)\\n          wnl2\\n        } else {\\n          let wnl = ce(buf, cond, local_names, next_local, ld + 1)\\n          emit_i64_eqz(buf)\\n          wnl\\n        },\\n        _ => {\\n          let wnl = ce(buf, cond, local_names, next_local, ld + 1)\\n          emit_i64_eqz(buf)\\n          wnl\\n        }\\n      }\\n      emit_br_if(buf, 1)\\n      let nl2 = ce(buf, body, local_names, nl1, ld + 1)\\n      emit_drop(buf)\\n      emit_br(buf, 0)\\n      emit_end(buf)\\n      emit_end(buf)\\n      emit_i64_const(buf, 0)\\n      nl2\\n    },\\n    EBreak(_) => {\\n      emit_br(buf, ld + 1)\\n      emit_i64_const(buf, 0)\\n      next_local\\n    },\\n    EContinue(_) => {\\n      emit_br(buf, ld)\\n      emit_i64_const(buf, 0)\\n      next_local\\n    },\\n    EUnit => {\\n      emit_i64_const(buf, 0)\\n      next_local\\n    },\\n    EThrow(msg_expr) => {\\n      let nl = ce(buf, msg_expr, local_names, next_local, ld)\\n      emit_drop(buf)\\n      bytebuf_push(buf, 0)\\n      nl\\n    },\\n    EReturn(ret_expr) => {\\n      let nl = ce(buf, ret_expr, local_names, next_local, ld)\\n      emit_return(buf)\\n      nl\\n    },\\n    EFn(_, _, params, _, _, fn_body) =>\\n    compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),\\n    EDot(obj, field, _) => {\\n      let rec find_struct_field_idx: (Int) -> Int = (si2) -> {\\n        if si2 >= Array::length(ctx.ctor_table.struct_names) {\\n          -1\\n        }\\n        else {\\n          let fnames = Array::get(ctx.ctor_table.struct_field_names, si2)\\n          let rec find_f: (Int) -> Int = (fi) -> {\\n            if fi >= Array::length(fnames) {\\n              -1\\n            }\\n            else if Array::get(fnames, fi) == field {\\n              fi\\n            }\\n            else find_f(fi + 1)\\n          }\\n          let idx = find_f(0)\\n          if idx >= 0 {\\n            idx\\n          }\\n          else find_struct_field_idx(si2 + 1)\\n        }\\n      }\\n      let field_idx = find_struct_field_idx(0)\\n      if field_idx < 0 {\\n        throw(String::concat(\\\"unknown struct field: \\\", field))\\n      }\\n      let nl1 = ce(buf, obj, local_names, next_local, ld)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, 8 + field_idx * 8)\\n      nl1\\n    },\\n    ERecord(fields) => {\\n      let flen = Array::length(fields)\\n      let obj_size = 8 + flen * 8\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__rec_ptr\\\")\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, ptr_local)\\n      emit_global_get(buf, 0)\\n      emit_i32_const(buf, obj_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_memory_grow_check(buf)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 0)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, flen)\\n      emit_i32_store(buf, 2, 4)\\n      let mut nl_r = next_local + 1\\n      let mut ri = 0\\n      whi