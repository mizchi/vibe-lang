"\n\n\n\n\n\n\n\n\n\n\nlet emit_dbg_line_for: (Bytes, Expr, CompileCtx) -> Unit = (buf, value, ctx) -> {\n  if ctx.dbg_line_idx >= 0 {\n    let off = first_offset(value)\n    if off >= 0 {\n      let line = offset_to_line(ctx.dbg_line_nl, off)\n      emit_i32_const(buf, ctx.dbg_line_file_id)\n      emit_i32_const(buf, line)\n      emit_call(buf, ctx.dbg_line_idx)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nlet is_edot: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _, _) => true,\n    _ => false\n  }\n}\n\nlet efn_is_capturing: (Expr, CompileCtx) -> Bool with { Error } = (value, ctx) -> {\n  let params = get_efn_params(value)\n  let pnames = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pn, _) = Array::get(params, pi)\n    Array::push(pnames, pn)\n    pi = pi + 1\n  }\n  let caps = collect_free_vars(get_efn_body(value), pnames, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n  Array::length(caps) > 0\n}\n\nlet slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nlet slot_is_intish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nexport let rec expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport let expr_is_intish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 0 {\n    true\n  } else if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_intish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" {\n      true\n    } else if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      !expr_is_floatish(e, local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    op == \"!\"\n  } else {\n    false\n  }\n}\n\n\nlet assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {\n  let empty1 = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty2 = Array::slice([\n    \"\"\n  ], 0, 0)\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\n}\n\nlet rec reassign_carry_safe: (Expr, String) -> Bool = (e, name) -> {\n  if !assign_value_mentions(e, name) {\n    true\n  } else {\n    match e {\n      EIdent(_, _) => true,\n      EDot(_, _, _) => proj_root_ident(e) == name,\n      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),\n      EUnaryOp(_, x) => reassign_carry_safe(x, name),\n      _ => false\n    }\n  }\n}\n\nlet emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_local_get(buf, local_idx)\n  if tagged {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(buf)\n}\n\nlet emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 16777215)\n  bytebuf_push(buf, 113)\n  emit_i32_const(buf, 16777215)\n  emit_i32_ne(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_sub(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 256)\n  emit_i32_mul(buf)\n  emit_i32_eqz(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_global_get(buf, 2)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_global_set(buf, 2)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nlet reassign_self_reusable: (Expr, String) -> Bool with { Error } = (value, name) -> {\n  if is_etuple(value) {\n    let elems = get_etuple_elems(value)\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(elems) {\n      if !reassign_carry_safe(Array::get(elems, i), name) {\n        ok = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    ok\n  } else {\n    false\n  }\n}\n\nexport let compile_expr_tail: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 9 {\n    let name = get_elet_name(expr)\n    let value = get_elet_val(expr)\n    let body = get_elet_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_for(buf, value, ctx)\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    let val_is_float = expr_is_floatish(value, local_names, ctx)\n    if val_is_float {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 2 + 1)\n    } else if slot_is_intish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 2)\n    }\n    let mut rc_kind = 0\n    let mut is_borrow_ret_ext = false\n    if ctx.enable_rc {\n      if val_is_float {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_etuple(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_earray(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_erecord(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_ctor_call(value, ctx.ctor_table) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_eident(value) {\n        let src = get_eident_name(value)\n        if array_contains_str(ctx.heap_binding_names, src) {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n          if array_contains_str(ctx.rc_alias_dup_names, name) {\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      } else if expr_tag(value) == 8 {\n        let callee = get_ecall_callee(value)\n        let is_borrow_ret = if is_eident(callee) {\n          let cn = get_eident_name(callee)\n          cn == \"Array::get\" || cn == \"__index\" || cn == \"Map::get\" || cn == \"__rec_field\" || array_contains_str(ctx.borrow_ret_names, cn)\n        } else {\n          false\n        }\n        let is_builtin_scalar_ret = if is_eident(callee) {\n          let cn = get_eident_name(callee)\n          let is_always_registered = cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"eq\"\n          let is_user_shadowed = !is_always_registered && array_contains_str(ctx.func_table.names, cn)\n          !is_user_shadowed && (cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"Map::has_key\" || cn == \"Array::contains\" || cn == \"eq\" || cn == \"not\" || cn == \"add\" || cn == \"sub\" || cn == \"mul\" || cn == \"lt\")\n        } else {\n          false\n        }\n        let is_scalar_ret = if is_eident(callee) {\n          array_contains_str(ctx.scalar_ret_names, get_eident_name(callee)) || is_builtin_scalar_ret\n        } else {\n          false\n        }\n        if is_borrow_ret || is_scalar_ret {\n          ()\n        } else {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n        }\n        is_borrow_ret_ext = is_borrow_ret\n      } else if is_edot(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n        emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n      } else if is_efn(value) {\n        if efn_is_capturing(value, ctx) {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n        } else {\n          ()\n        }\n      } else if expr_tag(value) == 7 {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if expr_tag(value) == 16 {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if expr_tag(value) == 9 || expr_tag(value) == 14 {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        let __sf_tag = expr_tag(value)\n        if is_eident(value) || __sf_tag == 0 || __sf_tag == 1 || __sf_tag == 2 || __sf_tag == 3 || __sf_tag == 22 {\n          ()\n        } else {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n        }\n      }\n    } else {\n      ()\n    }\n    if ctx.enable_rc && rc_kind > 0 {\n      let mut dbi = 0\n      while dbi < Array::length(ctx.rc_dup_names) {\n        if Array::get(ctx.rc_dup_names, dbi) == name {\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        dbi = dbi + 1\n      }\n    } else {\n      ()\n    }\n    let mut lb_shadow_removed = 0\n    if ctx.enable_rc {\n      let lb_arr = ctx.loop_borrowed_names\n      let lb_n = Array::length(lb_arr)\n      let mut lb_w = 0\n      let mut lb_i = 0\n      while lb_i < lb_n {\n        let e = Array::get(lb_arr, lb_i)\n        if e == name {\n          lb_shadow_removed = lb_shadow_removed + 1\n        } else {\n          Array::set(lb_arr, lb_w, e)\n          lb_w = lb_w + 1\n        }\n        lb_i = lb_i + 1\n      }\n      Array::truncate(lb_arr, lb_w)\n    } else {\n      ()\n    }\n    let lb_mark = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc && is_borrow_ret_ext {\n      Array::push(ctx.loop_borrowed_names, name)\n    } else {\n      ()\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    if ctx.enable_rc && is_borrow_ret_ext {\n      Array::truncate(ctx.loop_borrowed_names, lb_mark)\n    } else {\n      ()\n    }\n    let mut lb_restore_i = 0\n    while lb_restore_i < lb_shadow_removed {\n      Array::push(ctx.loop_borrowed_names, name)\n      lb_restore_i = lb_restore_i + 1\n    }\n    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {\n      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {\n        emit_local_set(buf, nl2)\n        emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n        emit_local_get(buf, local_idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        emit_local_get(buf, nl2)\n        nl2 + 1\n      } else {\n        if ctx.rc_drop_func_idx >= 0 {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else if rc_kind == 1 {\n          emit_rc_drop_local(buf, local_idx, false)\n        } else {\n          emit_rc_drop_local(buf, local_idx, true)\n        }\n        nl2\n      }\n    } else {\n      nl2\n    }\n  } else if __tag == 10 {\n    let name = get_eletrec_name(expr)\n    let value = get_eletrec_val(expr)\n    let body = get_eletrec_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    if is_efn(value) {\n      let params = get_efn_params(value)\n      let fn_body = get_efn_body(value)\n      let param_names_bp = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut bpi = 0\n      while bpi < Array::length(params) {\n        let (pn, _) = Array::get(params, bpi)\n        Array::push(param_names_bp, pn)\n        bpi = bpi + 1\n      }\n      let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n      let mut self_cap_idx = -1\n      let mut bci = 0\n      while bci < Array::length(caps) {\n        if Array::get(caps, bci) == name {\n          self_cap_idx = bci\n        }\n        bci = bci + 1\n      }\n      if self_cap_idx >= 0 {\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, -4)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, local_idx)\n        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n      }\n      0\n    } else {\n      0\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    nl2\n  } else if __tag == 11 {\n    let name = get_eletmut_name(expr)\n    let value = get_eletmut_val(expr)\n    let body = get_eletmut_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_for(buf, value, ctx)\n    Array::push(local_names, name)\n    if expr_is_floatish(value, local_names, ctx) {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 2 + 1)\n    } else if slot_is_intish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 2)\n    }\n    if mut_needs_ref_cell(body, name) {\n      Array::push(ctx.ref_cell_names, name)\n      if ctx.enable_rc && ctx.rc_alloc_func_idx >= 0 && ctx.rc_drop_func_idx >= 0 && expr_is_intish(value, local_names, ctx) {\n        emit_i64_const(buf, 16)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 16)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 8)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        emit_i64_store(buf, 3, 0)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        nl2\n      } else {\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      nl2\n      }\n    } else {\n      if ctx.enable_rc && (is_etuple(value) || is_earray(value) || is_erecord(value) || is_ctor_call(value, ctx.ctor_table) || is_nullary_ctor_ident(value, ctx.ctor_table) || expr_is_floatish(value, local_names, ctx)) {\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        ()\n      }\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_local_set(buf, local_idx)\n      if ctx.enable_rc {\n        let mut mdbi = 0\n        while mdbi < Array::length(ctx.rc_dup_names) {\n          if Array::get(ctx.rc_dup_names, mdbi) == name {\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          mdbi = mdbi + 1\n        }\n      } else {\n        ()\n      }\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\n        if scope_tail_proj_root(body) == name {\n          emit_local_set(buf, nl2)\n          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          emit_local_get(buf, nl2)\n          nl2 + 1\n        } else {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          nl2\n        }\n      } else {\n        nl2\n      }\n    }\n  } else if __tag == 12 {\n    let name = get_eassign_name(expr)\n    let value = get_eassign_val(expr)\n    let body = get_eassign_body(expr)\n    let idx = resolve_local(local_names, name, \"assign\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)\n      let is_self = assign_value_mentions(value, name)\n      if is_heap_mut && is_self && reassign_self_reusable(value, name) {\n        let old_temp = next_local\n        let scratch = next_local + 1\n        let base = next_local + 2\n        emit_local_get(buf, idx)\n        emit_local_set(buf, old_temp)\n        let elems = get_etuple_elems(value)\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          let elem = Array::get(elems, ei)\n          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {\n            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)\n            emit_local_set(buf, scratch)\n            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          ei = ei + 1\n        }\n        let nl = compile_expr(buf, value, local_names, base, ctx, ld)\n        emit_local_set(buf, idx)\n        emit_local_get(buf, old_temp)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      } else {\n        if is_heap_mut && !is_self {\n          emit_local_get(buf, idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else {\n          ()\n        }\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_local_set(buf, idx)\n        if is_heap_mut && !is_self && is_edot(value) {\n          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        if ctx.enable_rc && is_heap_mut && !is_self {\n          let mut adbi = 0\n          while adbi < Array::length(ctx.rc_dup_names) {\n            if Array::get(ctx.rc_dup_names, adbi) == name {\n              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n            } else {\n              ()\n            }\n            adbi = adbi + 1\n          }\n        } else {\n          ()\n        }\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      }\n    }\n  } else if __tag == 13 {\n    let name = get_eassignop_name(expr)\n    let op = get_eassignop_op(expr)\n    let value = get_eassignop_val(expr)\n    let body = get_eassignop_body(expr)\n    let idx = resolve_local(local_names, name, \"assignop\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 0)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      emit_local_get(buf, idx)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 14 {\n    let first = get_eseq_first(expr)\n    let second = get_eseq_second(expr)\n    emit_dbg_line_for(buf, first, ctx)\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n    emit_drop(buf)\n    compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else {\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let selfhost_source_80 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_expr.vibe",
"\n\n\n\n\n\n\n\n\n\n\nlet emit_tuple_struct_eq: (Bytes, Expr, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_fn) -> {\n  let lit = if is_etuple(lhs) {\n    lhs\n  } else {\n    rhs\n  }\n  let num = Array::length(get_etuple_elems(lit))\n  let aptr = next_local\n  Array::push(local_names, \"__eqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__eqb\")\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  if ctx.enable_rc {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_local_set(buf, aptr)\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\n  if ctx.enable_rc {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_local_set(buf, bptr)\n  let field_off = if ctx.enable_rc {\n    8\n  } else {\n    0\n  }\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < num {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, field_off + i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, field_off + i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  nl2\n}\n\nlet emit_ctor_struct_eq: (Bytes, Expr, Expr, Int, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, fc, local_names, next_local, ctx, ld, compile_expr_fn) -> {\n  let aptr = next_local\n  Array::push(local_names, \"__ceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__ceqb\")\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, aptr)\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, bptr)\n  emit_local_get(buf, aptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_local_get(buf, bptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_eq(buf)\n  emit_if_i64(buf)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < fc {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, 8 + i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, 8 + i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  emit_else(buf)\n  emit_i64_const(buf, 0)\n  emit_end(buf)\n  nl2\n}\n\nlet emit_eq_value: (Bytes, Expr, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, local_names, next_local, ctx, ld, ce) -> {\n  if is_etuple(lhs) || is_etuple(rhs) {\n    emit_tuple_struct_eq(buf, lhs, rhs, local_names, next_local, ctx, ld, ce)\n  } else if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) || is_ctor_call(rhs, ctx.ctor_table) || is_nullary_ctor_ident(rhs, ctx.ctor_table) {\n    let clit = if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) {\n      lhs\n    } else {\n      rhs\n    }\n    let cfc = if is_ctor_call(clit, ctx.ctor_table) {\n      Array::length(get_ecall_args(clit))\n    } else {\n      0\n    }\n    emit_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, ce)\n  } else if expr_is_intish(lhs, local_names, ctx) || expr_is_intish(rhs, local_names, ctx) {\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n    nl2\n  } else {\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n    emit_call(buf, eq_fidx)\n    nl2\n  }\n}\n\nexport let rec compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n    let n = get_eint_value(expr)\n    emit_i64_const(buf, n)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    next_local\n  } else if __tag == 1 {\n    let b_val = get_ebool_value(expr)\n    emit_i64_const(buf, if b_val {\n      if ctx.enable_rc {\n        2\n      } else {\n        1\n      }\n    } else {\n      0\n    })\n    next_local\n  } else if __tag == 2 {\n    let v = get_efloat_value(expr)\n    let lo = Double::to_i64_bits_lo(v)\n    let hi = Double::to_i64_bits_hi(v)\n    emit_f64_const_lohi(buf, lo, hi)\n    emit_i64_reinterpret_f64(buf)\n    if ctx.enable_rc {\n      Array::push(local_names, \"__fbits\")\n      Array::push(local_names, \"__fbox\")\n      emit_box_float(buf, ctx, next_local, next_local + 1)\n      next_local + 2\n    } else {\n      next_local\n    }\n  } else if __tag == 3 {\n    let s = get_estring_value(expr)\n    let idx = str_table_lookup(ctx.str_table.strs, s)\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n    next_local\n  } else if __tag == 4 {\n    let name = get_eident_name(expr)\n    let len = Array::length(local_names)\n    let mut __tl_i = len - 1\n    let mut __tl_result = -1\n    while __tl_i >= 0 {\n      if Array::get(local_names, __tl_i) == name {\n        __tl_result = __tl_i\n        __tl_i = -1\n      } else {\n        __tl_i = __tl_i - 1\n      }\n    }\n    let local_idx = __tl_result\n    if local_idx >= 0 {\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n      } else {\n        emit_local_get(buf, local_idx)\n      }\n      next_local\n    } else {\n      let mut __ci_idx = -1\n      let __ci_len = Array::length(ctx.const_int_names)\n      let mut __ci_j = 0\n      while __ci_j < __ci_len {\n        if Array::get(ctx.const_int_names, __ci_j) == name {\n          __ci_idx = __ci_j\n          __ci_j = __ci_len\n        } else {\n          __ci_j = __ci_j + 1\n        }\n      }\n      if __ci_idx >= 0 {\n        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        next_local\n      } else {\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          if ctx.enable_rc {\n            emit_i64_const(buf, 16)\n            emit_call(buf, ctx.rc_alloc_func_idx)\n            emit_local_set(buf, ptr_l)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 16)\n            emit_i32_store(buf, 2, 0)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 1)\n            emit_i32_store(buf, 2, 4)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 1)\n            emit_i32_store8(buf, 0, 7)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, tag_c)\n            emit_i32_store(buf, 2, 8)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 0)\n            emit_i32_store(buf, 2, 12)\n            emit_local_get(buf, ptr_l)\n            emit_i64_const(buf, 8)\n            emit_i64_add(buf)\n            emit_i64_const(buf, 1)\n            emit_i64_or(buf)\n            next_local + 1\n          } else {\n            emit_global_get(buf, 0)\n            emit_i64_extend_i32_u(buf)\n            emit_local_set(buf, ptr_l)\n            emit_global_get(buf, 0)\n            emit_i32_const(buf, 8)\n            emit_i32_add(buf)\n            emit_global_set(buf, 0)\n            emit_heap_grow_after_heap_set(buf, ctx)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, tag_c)\n            emit_i32_store(buf, 2, 0)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 0)\n            emit_i32_store(buf, 2, 4)\n            emit_local_get(buf, ptr_l)\n            emit_i64_const(buf, 1)\n            emit_i64_or(buf)\n            next_local + 1\n          }\n        } else {\n          let fn_len = Array::length(ctx.func_table.names)\n          let mut __tf_j = 0\n          let mut __tf_result = -1\n          while __tf_j < fn_len {\n            if Array::get(ctx.func_table.names, __tf_j) == name {\n              __tf_result = __tf_j\n              __tf_j = fn_len\n            } else {\n              __tf_j = __tf_j + 1\n            }\n          }\n          if __tf_result < 0 {\n            let mut diag = String::concat(\"undefined variable (ident): \", name)\n            diag = String::concat(diag, \" | locals=[\")\n            let mut di = 0\n            while di < len {\n              if di > 0 {\n                diag = String::concat(diag, \",\")\n              }\n              diag = String::concat(diag, Array::get(local_names, di))\n              di = di + 1\n            }\n            diag = String::concat(diag, \"]\")\n            throw(diag)\n          }\n          let fni = __tf_result\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          if array_contains_str(ctx.thunk_names, name) {\n            emit_i64_const(buf, 0)\n            emit_call(buf, fidx)\n            next_local\n          } else {\n            let table_slot = fidx - ctx.func_offset\n            emit_i64_const(buf, (table_slot<<2)|2)\n            next_local\n          }\n        }\n      }\n    }\n  } else if __tag == 5 {\n    let op = get_ebinop_op(expr)\n    let lhs = get_ebinop_lhs(expr)\n    let rhs = get_ebinop_rhs(expr)\n    if op == \"==\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nle\n    } else if op == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nle\n    } else if expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx) {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n        if op == \"+\" {\n          emit_f64_add(buf)\n        } else if op == \"-\" {\n          emit_f64_sub(buf)\n        } else if op == \"*\" {\n          emit_f64_mul(buf)\n        } else {\n          emit_f64_div(buf)\n        }\n        emit_i64_reinterpret_f64(buf)\n        if ctx.enable_rc {\n          Array::push(local_names, \"__fbits\")\n          Array::push(local_names, \"__fbox\")\n          emit_box_float(buf, ctx, nl2, nl2 + 1)\n          nl2 + 2\n        } else {\n          nl2\n        }\n      } else {\n        if op == \"==\" {\n          emit_f64_eq(buf)\n        } else if op == \"!=\" {\n          emit_f64_ne(buf)\n        } else if op == \"<\" {\n          emit_f64_lt(buf)\n        } else if op == \">\" {\n          emit_f64_gt(buf)\n        } else if op == \"<=\" {\n          emit_f64_le(buf)\n        } else if op == \">=\" {\n          emit_f64_ge(buf)\n        } else {\n          throw(String::concat(\"unsupported float binop: \", op))\n        }\n        emit_i64_extend_i32_s(buf)\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        nl2\n      }\n    } else if ctx.enable_rc {\n      if op == \"<<\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shl(buf)\n        nl2\n      } else if op == \">>\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shr_s(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n        nl2\n      } else {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_binop_op(buf, op)\n        if op == \"*\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shr_s(buf)\n        } else if op == \"/\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else {\n          ()\n        }\n        nl2\n      }\n    } else {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      emit_binop_op(buf, op)\n      nl2\n    }\n  } else if __tag == 6 {\n    let op = get_eunaryop_op(expr)\n    let operand = get_eunaryop_expr(expr)\n    if op == \"-\" {\n      if expr_is_floatish(operand, local_names, ctx) {\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_f64_reinterpret_i64(buf)\n        emit_f64_neg(buf)\n        emit_i64_reinterpret_f64(buf)\n        nl\n      } else {\n        emit_i64_const(buf, 0)\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_i64_sub(buf)\n        nl\n      }\n    } else if op == \"!\" {\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n  } else if __tag == 7 {\n    let cond = get_eif_cond(expr)\n    let then_e = get_eif_then(expr)\n    let else_e = get_eif_else(expr)\n    let cond_tag = expr_tag(cond)\n    let nl1 = if cond_tag == 5 {\n      let cop = get_ebinop_op(cond)\n      if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n        let clhs = get_ebinop_lhs(cond)\n        let crhs = get_ebinop_rhs(cond)\n        if cop == \"==\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\n          emit_i32_wrap_i64(buf)\n          cnl2\n        } else if cop == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          cnl2\n        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"==\" {\n            emit_f64_eq(buf)\n          }\n          else if cop == \"!=\" {\n            emit_f64_ne(buf)\n          }\n          else if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else if cond_tag == 1 {\n      let b_val = get_ebool_value(cond)\n      emit_i32_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    } else if cond_tag == 6 {\n      let uop = get_eunaryop_op(cond)\n      let uoperand = get_eunaryop_expr(cond)\n      if uop == \"!\" {\n        let inner_tag = expr_tag(uoperand)\n        if inner_tag == 5 {\n          let iop = get_ebinop_op(uoperand)\n          if iop == \"==\" || iop == \"!=\" || iop == \"<\" || iop == \">\" || iop == \"<=\" || iop == \">=\" {\n            let ilhs = get_ebinop_lhs(uoperand)\n            let irhs = get_ebinop_rhs(uoperand)\n            if iop == \"==\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if iop == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              if ctx.enable_rc {\n                emit_unbox_float(buf)\n              } else {\n                ()\n              }\n              emit_f64_reinterpret_i64(buf)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if ctx.enable_rc {\n                emit_unbox_float(buf)\n              } else {\n                ()\n              }\n              emit_f64_reinterpret_i64(buf)\n              if iop == \"==\" {\n                emit_f64_eq(buf)\n              }\n              else if iop == \"!=\" {\n                emit_f64_ne(buf)\n              }\n              else if iop == \"<\" {\n                emit_f64_lt(buf)\n              }\n              else if iop == \">\" {\n                emit_f64_gt(buf)\n              }\n              else if iop == \"<=\" {\n                emit_f64_le(buf)\n              }\n              else {\n                emit_f64_ge(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            } else {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if iop == \"<\" {\n                emit_i64_lt_s(buf)\n              }\n              else if iop == \">\" {\n                emit_i64_gt_s(buf)\n              }\n              else if iop == \"<=\" {\n                emit_i64_le_s(buf)\n              }\n              else {\n                emit_i64_ge_s(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            }\n          } else {\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        } else {\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else {\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      cnl\n    }\n    emit_if_i64(buf)\n    let ld_inner = if ld >= 0 {\n      ld + 1\n    } else {\n      -1\n    }\n    let names_len_before = Array::length(local_names)\n    cov_emit_branch(buf, ctx.cov)\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\n    emit_else(buf)\n    Array::truncate(local_names, names_len_before)\n    int_log_reset_above(ctx, names_len_before)\n    cov_emit_branch(buf, ctx.cov)\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\n    emit_end(buf)\n    let max_nl_if = if nl2 > nl3 {\n      nl2\n    } else {\n      nl3\n    }\n    while Array::length(local_names) < max_nl_if {\n      Array::push(local_names, \"\")\n    }\n    max_nl_if\n  } else if __tag == 8 {\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else {\n    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
