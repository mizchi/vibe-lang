  }\\n  else None\\n}\\n\\nlet lookup_fs_read_file: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Fs::read_file\\\" {\\n    Some(CtFn(fs_one_param(CtString), CtString, Some(\\\"Fs\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_fs_read_bytes: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Fs::read_bytes\\\" {\\n    Some(CtFn(fs_one_param(CtString), CtBytes, Some(\\\"Fs\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_fs_stat_token: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Fs::stat_token\\\" {\\n    Some(CtFn(fs_one_param(CtString), CtInt, Some(\\\"Fs\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_fs_group_b: (String) -> Option[Type] = (name) -> {\\n  match lookup_fs_exists(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_fs_stat_token(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_fs_readdir(name) {\\n        Some(t) => Some(t),\\n        None => lookup_fs_is_dir(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_fs_write_file: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Fs::write_file\\\" {\\n    Some(CtFn(fs_two_params(CtString, CtString), CtUnit, Some(\\\"Fs\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_fs_write_bytes: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Fs::write_bytes\\\" {\\n    Some(CtFn(fs_two_params(CtString, CtBytes), CtUnit, Some(\\\"Fs\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_fs_group_a: (String) -> Option[Type] = (name) -> {\\n  match lookup_fs_read_file(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_fs_write_file(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_fs_read_bytes(name) {\\n        Some(t) => Some(t),\\n        None => lookup_fs_write_bytes(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport let lookup_fs: (String) -> Option[Type] = (name) -> {\\n  match lookup_fs_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_fs_group_b(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_fs_group_c(name) {\\n        Some(t) => Some(t),\\n        None => lookup_fs_group_d(name)\\n      }\\n    }\\n  }\\n}\\n\\n\\n\\nlet map_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet map_one_param: (Type) -> Array[Type] = (a) -> {\\n  let arr = map_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet map_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\\n  let arr = map_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet map_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\\n  let arr = map_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nlet lookup_map_get: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Map::get\\\" {\\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_map_has: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"map_has\\\" {\\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_map_set: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Map::set\\\" {\\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtNamed(\\\"Map\\\", [\\n      CtString,\\n      CtUnknown\\n    ]), None))\\n  }\\n  else None\\n}\\n\\nlet lookup_map_keys: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Map::keys\\\" {\\n    Some(CtFn(map_one_param(CtUnknown), CtArray(CtString), None))\\n  }\\n  else None\\n}\\n\\nlet lookup_map_has_key: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Map::has_key\\\" {\\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_map_group_b: (String) -> Option[Type] = (name) -> {\\n  match lookup_map_has(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_map_keys(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_map_has_key(name) {\\n        Some(t) => Some(t),\\n        None => lookup_map_set(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_mapbuilder_new: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"MapBuilder::new\\\" {\\n    Some(CtFn(map_no_params(), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_mapbuilder_set: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"MapBuilder::set\\\" {\\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_mapbuilder_freeze: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"MapBuilder::freeze\\\" {\\n    Some(CtFn(map_one_param(CtUnknown), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_map_group_a: (String) -> Option[Type] = (name) -> {\\n  match lookup_mapbuilder_new(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_mapbuilder_set(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_mapbuilder_freeze(name) {\\n        Some(t) => Some(t),\\n        None => lookup_map_get(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport let lookup_map: (String) -> Option[Type] = (name) -> {\\n  match lookup_map_group_a(name) {\\n    Some(t) => Some(t),\\n    None => lookup_map_group_b(name)\\n  }\\n}\\n\\n\\n\\nlet misc_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet misc_one_param: (Type) -> Array[Type] = (a) -> {\\n  let arr = misc_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet lookup_not: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"not\\\" {\\n    Some(CtFn(misc_one_param(CtBool), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_neg: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"__neg\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet misc_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\\n  let arr = misc_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet lookup_eq: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"eq\\\" {\\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_arithmetic_helper: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"add\\\" || name == \\\"sub\\\" || name == \\\"mul\\\" {\\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtInt, None))\\n  } else if name == \\\"lt\\\" {\\n    Some(CtFn(misc_two_params(CtInt, CtInt), CtBool, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet lookup_none: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"None\\\" {\\n    Some(CtOption(CtUnknown))\\n  }\\n  else None\\n}\\n\\nlet lookup_some: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Some\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtOption(CtUnknown), None))\\n  }\\n  else None\\n}\\n\\nlet lookup_index: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"__index\\\" {\\n    Some(CtFn(misc_two_params(CtUnknown, CtUnknown), CtUnknown, None))\\n  }\\n  else if name == \\\"__set_field\\\" {\\n    let set_field_params = misc_no_params()\\n    Array::push(set_field_params, CtUnknown)\\n    Array::push(set_field_params, CtString)\\n    Array::push(set_field_params, CtUnknown)\\n    Some(CtFn(set_field_params, CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_print: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"print\\\" {\\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_throw: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"throw\\\" {\\n    Some(CtFn(misc_one_param(CtString), CtUnknown, Some(\\\"Error\\\")))\\n  }\\n  else None\\n}\\n\\nlet misc_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\\n  let arr = misc_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nlet lookup_slice: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"__slice\\\" {\\n    Some(CtFn(misc_three_params(CtUnknown, CtInt, CtInt), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_assert: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"assert\\\" {\\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\\n  }\\n  else if name == \\\"assert_true\\\" {\\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\\n  }\\n  else if name == \\\"assert_eq\\\" {\\n    Some(CtFn([\\n      CtUnknown,\\n      CtUnknown\\n    ], CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_println: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"println\\\" {\\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_to_string: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"__to_string\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_len: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"__len\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_iter_intrinsic: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"iter_require\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\\n  } else if name == \\\"iter_length\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\\n  } else if name == \\\"iter_get\\\" {\\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\\n  } else if name == \\\"String::iter_length\\\" {\\n    Some(CtFn(misc_one_param(CtString), CtInt, None))\\n  } else if name == \\\"String::iter_get\\\" {\\n    Some(CtFn(misc_two_params(CtString, CtInt), CtInt, None))\\n  } else if name == \\\"Map::iter_length\\\" {\\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\\n  } else if name == \\\"Map::iter_get\\\" {\\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet lookup_char_to_int: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Char::to_int\\\" {\\n    Some(CtFn(misc_one_param(CtChar), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_misc_group_a: (String) -> Option[Type] = (name) -> {\\n  match lookup_arithmetic_helper(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_eq(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_not(name) {\\n        Some(t) => Some(t),\\n        None => match lookup_neg(name) {\\n          Some(t) => Some(t),\\n          None => match lookup_to_string(name) {\\n            Some(t) => Some(t),\\n            None => match lookup_len(name) {\\n              Some(t) => Some(t),\\n              None => lookup_index(name)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_misc_group_b: (String) -> Option[Type] = (name) -> {\\n  match lookup_slice(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_print(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_println(name) {\\n        Some(t) => Some(t),\\n        None => lookup_assert(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_misc_group_e: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::join\\\" {\\n    Some(CtFn(misc_two_params(CtArray(CtString), CtString), CtString, None))\\n  } else if name == \\\"__rec_field\\\" {\\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\\n  } else {\\n    match lookup_iter_intrinsic(name) {\\n      Some(t) => Some(t),\\n      None => lookup_none(name)\\n    }\\n  }\\n}\\n\\nlet lookup_char_from_int: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Char::from_int\\\" {\\n    Some(CtFn(misc_one_param(CtInt), CtChar, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_double_to_int: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Double::to_int\\\" {\\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_int_to_double: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Int::to_double\\\" {\\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_double_to_i64_bits: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Double::to_i64_bits\\\" || name == \\\"Double::to_i64_bits_lo\\\" || name == \\\"Double::to_i64_bits_hi\\\" {\\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_misc_group_c: (String) -> Option[Type] = (name) -> {\\n  match lookup_throw(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_int_to_double(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_double_to_int(name) {\\n        Some(t) => Some(t),\\n        None => lookup_double_to_i64_bits(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_double_from_i64_bits: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Double::from_i64_bits\\\" {\\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_misc_group_d: (String) -> Option[Type] = (name) -> {\\n  match lookup_double_from_i64_bits(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_char_to_int(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_char_from_int(name) {\\n        Some(t) => Some(t),\\n        None => lookup_some(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport let lookup_misc: (String) -> Option[Type] = (name) -> {\\n  match lookup_misc_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_misc_group_b(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_misc_group_c(name) {\\n        Some(t) => Some(t),\\n        None => match lookup_misc_group_d(name) {\\n          Some(t) => Some(t),\\n          None => lookup_misc_group_e(name)\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n\\n\\n\\nlet simd_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet simd_v128_ty: () -> Type = () -> {\\n  CtNamed(\\\"V128\\\", simd_no_params())\\n}\\n\\nlet simd_one_param: (Type) -> Array[Type] = (a) -> {\\n  let arr = simd_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet simd_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\\n  let arr = simd_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet simd_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\\n  let arr = simd_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nlet lookup_simd_mem: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"v128_load\\\" {\\n    Some(CtFn(simd_two_params(CtBytes, CtInt), simd_v128_ty(), None))\\n  } else if name == \\\"v128_store\\\" {\\n    Some(CtFn(simd_three_params(CtBytes, CtInt, simd_v128_ty()), CtUnit, None))\\n  } else if name == \\\"simd_skip_ws\\\" {\\n    Some(CtFn(simd_three_params(CtBytes, CtInt, CtInt), CtInt, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet lookup_simd_lane_a: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"v128_splat_i8x16\\\" {\\n    Some(CtFn(simd_one_param(CtInt), simd_v128_ty(), None))\\n  } else if name == \\\"v128_eq_i8x16\\\" {\\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\\n  } else if name == \\\"v128_le_u_i8x16\\\" {\\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\\n  } else if name == \\\"v128_ge_u_i8x16\\\" {\\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet lookup_simd_lane_b: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"v128_and\\\" {\\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\\n  } else if name == \\\"v128_or\\\" {\\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\\n  } else if name == \\\"v128_not\\\" {\\n    Some(CtFn(simd_one_param(simd_v128_ty()), simd_v128_ty(), None))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet lookup_simd_reduce: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"v128_bitmask_i8x16\\\" {\\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtInt, None))\\n  } else if name == \\\"v128_any_true\\\" {\\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\\n  } else if name == \\\"v128_all_true_i8x16\\\" {\\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nexport let lookup_simd: (String) -> Option[Type] = (name) -> {\\n  match lookup_simd_mem(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_simd_lane_a(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_simd_lane_b(name) {\\n        Some(t) => Some(t),\\n        None => lookup_simd_reduce(name)\\n      }\\n    }\\n  }\\n}\\n\\n\\n\\nlet net_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet net_one_param: (Type) -> Array[Type] = (a) -> {\\n  let arr = net_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet net_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\\n  let arr = net_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet net_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\\n  let arr = net_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nlet lookup_http_close: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::close\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtUnit, Some(\\\"HttpServer\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_http_accept: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::accept\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtUnknown, Some(\\\"HttpServer\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_http_listen: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::listen\\\" {\\n    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some(\\\"HttpServer\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_http_request: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::request\\\" {\\n    Some(CtFn(net_two_params(CtString, CtString), CtUnknown, Some(\\\"HttpClient\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_http_respond: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::respond\\\" {\\n    Some(CtFn(net_three_params(CtUnknown, CtInt, CtString), CtUnit, Some(\\\"HttpServer\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_socket_tcp_read: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Socket::tcp_read\\\" {\\n    Some(CtFn(net_two_params(CtUnknown, CtInt), CtString, Some(\\\"TcpSocket\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_socket_tcp_close: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Socket::tcp_close\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtUnit, Some(\\\"TcpSocket\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_socket_tcp_write: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Socket::tcp_write\\\" {\\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtInt, Some(\\\"TcpSocket\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_http_response_body: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::response_body\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\\\"HttpClient\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_socket_tcp_connect: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Socket::tcp_connect\\\" {\\n    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some(\\\"TcpSocket\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_net_group_a: (String) -> Option[Type] = (name) -> {\\n  match lookup_socket_tcp_connect(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_socket_tcp_read(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_socket_tcp_write(name) {\\n        Some(t) => Some(t),\\n        None => lookup_socket_tcp_close(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_http_request_header: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::request_header\\\" {\\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\\\"HttpIncoming\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_net_group_d: (String) -> Option[Type] = (name) -> {\\n  match lookup_http_request_header(name) {\\n    Some(t) => Some(t),\\n    None => lookup_http_respond(name)\\n  }\\n}\\n\\nlet lookup_http_request_method: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::request_method\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\\\"HttpIncoming\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_net_group_c: (String) -> Option[Type] = (name) -> {\\n  match lookup_http_close(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_http_listen(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_http_accept(name) {\\n        Some(t) => Some(t),\\n        None => lookup_http_request_method(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_http_response_header: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::response_header\\\" {\\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\\\"HttpClient\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_http_response_status: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Http::response_status\\\" {\\n    Some(CtFn(net_one_param(CtUnknown), CtInt, Some(\\\"HttpClient\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_net_group_b: (String) -> Option[Type] = (name) -> {\\n  match lookup_http_request(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_http_response_status(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_http_response_header(name) {\\n        Some(t) => Some(t),\\n        None => lookup_http_response_body(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport let lookup_net: (String) -> Option[Type] = (name) -> {\\n  match lookup_net_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_net_group_b(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_net_group_c(name) {\\n        Some(t) => Some(t),\\n        None => lookup_net_group_d(name)\\n      }\\n    }\\n  }\\n}\\n\\n\\n\\nlet string1_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet string1_one_param: (Type) -> Array[Type] = (a) -> {\\n  let arr = string1_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet string1_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\\n  let arr = string1_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet string1_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\\n  let arr = string1_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  Array::push(arr, c)\\n  arr\\n}\\n\\nlet lookup_string_concat: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::concat\\\" {\\n    Some(CtFn(string1_two_params(CtString, CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_equals: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::equals\\\" {\\n    Some(CtFn(string1_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_length: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::length\\\" {\\n    Some(CtFn(string1_one_param(CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_char_at: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"string_char_at\\\" {\\n    Some(CtFn(string1_two_params(CtString, CtInt), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_group_a: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_concat(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_length(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_equals(name)\\n    }\\n  }\\n}\\n\\nlet lookup_string_substring: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::substring\\\" {\\n    Some(CtFn(string1_three_params(CtString, CtInt, CtInt), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_group_b: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_substring(name) {\\n    Some(t) => Some(t),\\n    None => lookup_string_char_at(name)\\n  }\\n}\\n\\nexport let lookup_string1: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_group_a(name) {\\n    Some(t) => Some(t),\\n    None => lookup_string_group_b(name)\\n  }\\n}\\n\\n\\n\\nlet string2_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet string2_one_param: (Type) -> Array[Type] = (a) -> {\\n  let arr = string2_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet string2_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\\n  let arr = string2_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet lookup_string_trim: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::trim\\\" {\\n    Some(CtFn(string2_one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_split: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::split\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtArray(CtString), None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_contains: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::contains\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_index_of: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::index_of\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_to_lower: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::to_lower\\\" {\\n    Some(CtFn(string2_one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_to_upper: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::to_upper\\\" {\\n    Some(CtFn(string2_one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_group_c: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_trim(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_to_upper(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_to_lower(name)\\n    }\\n  }\\n}\\n\\nlet lookup_string_ends_with: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::ends_with\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_starts_with: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::starts_with\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string2_group_a: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_index_of(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_contains(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_string_starts_with(name) {\\n        Some(t) => Some(t),\\n        None => lookup_string_ends_with(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_string_char_code_at: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::char_code_at\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtInt), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_last_index_of: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::last_index_of\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_from_char_code: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::from_char_code\\\" {\\n    Some(CtFn(string2_one_param(CtInt), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string2_group_b: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_from_char_code(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_char_code_at(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_string_last_index_of(name) {\\n        Some(t) => Some(t),\\n        None => lookup_string_split(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport let lookup_string2: (String) -> Option[Type] = (name) -> {\\n  match lookup_string2_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string2_group_b(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_group_c(name)\\n    }\\n  }\\n}\\n\\n\\n\\nlet system_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet lookup_io_a: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"sh\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtString, Some(\\\"Process\\\")))\\n  } else if name == \\\"sh_lines\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtArray(CtString), Some(\\\"Process\\\")))\\n  } else if name == \\\"path\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtUnknown, None))\\n  } else if name == \\\"Path::to_string\\\" {\\n    Some(CtFn([\\n      CtUnknown\\n    ], CtString, None))\\n  } else if name == \\\"Path::is_absolute\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtBool, None))\\n  } else if name == \\\"PromptText::new\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtString, None))\\n  } else if name == \\\"Stdin::read_char\\\" {\\n    Some(CtFn(system_no_params(), CtInt, Some(\\\"Stdin\\\")))\\n  } else if name == \\\"Stdin::read_stream\\\" {\\n    Some(CtFn([\\n      CtInt\\n    ], CtString, Some(\\\"Stdin\\\")))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet lookup_io_b: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Stdout::write_char\\\" {\\n    Some(CtFn([\\n      CtInt\\n    ], CtUnit, None))\\n  } else if name == \\\"Stdout::write_stream\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtUnit, None))\\n  } else if name == \\\"Env::get\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtString, Some(\\\"Env\\\")))\\n  } else if name == \\\"Env::args_len\\\" {\\n    Some(CtFn(system_no_params(), CtInt, Some(\\\"Env\\\")))\\n  } else if name == \\\"Env::args_get\\\" {\\n    Some(CtFn([\\n      CtInt\\n    ], CtString, Some(\\\"Env\\\")))\\n  } else if name == \\\"Profiler::now_us\\\" {\\n    Some(CtFn(system_no_params(), CtInt, Some(\\\"Profiler\\\")))\\n  } else if name == \\\"sleep\\\" {\\n    Some(CtFn([\\n      CtInt\\n    ], CtUnit, Some(\\\"Async\\\")))\\n  } else if name == \\\"Path::resolve\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtString, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nlet lookup_io_c: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Lines::parse\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtArray(CtString), None))\\n  } else if name == \\\"Lines::stringify\\\" {\\n    Some(CtFn([\\n      CtArray(CtString)\\n    ], CtString, None))\\n  } else if name == \\\"Llm::complete\\\" {\\n    Some(CtFn([\\n      CtString,\\n      CtString\\n    ], CtString, Some(\\\"Llm\\\")))\\n  } else if name == \\\"Rlm::run\\\" {\\n    Some(CtFn([\\n      CtString,\\n      CtString\\n    ], CtString, Some(\\\"Llm\\\")))\\n  } else if name == \\\"Rlm::finalize\\\" {\\n    Some(CtFn([\\n      CtString\\n    ], CtString, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nexport let lookup_io: (String) -> Option[Type] = (name) -> {\\n  match lookup_io_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_io_b(name) {\\n      Some(t) => Some(t),\\n      None => lookup_io_c(name)\\n    }\\n  }\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\nexport let lookup_builtin: (String) -> Option[Type] = (name) -> {\\n  let normalized = canonical_builtin_name(name)\\n  match lookup_array(normalized) {\\n    Some(t) => Some(t),\\n    None => match lookup_fixed_array(normalized) {\\n      Some(t) => Some(t),\\n      None => match lookup_array_builder(normalized) {\\n        Some(t) => Some(t),\\n        None => match lookup_string1(normalized) {\\n          Some(t) => Some(t),\\n          None => match lookup_string2(normalized) {\\n            Some(t) => Some(t),\\n            None => match lookup_string_builder(normalized) {\\n              Some(t) => Some(t),\\n              None => match lookup_bytes(normalized) {\\n                Some(t) => Some(t),\\n                None => match lookup_simd(normalized) {\\n                Some(t) => Some(t),\\n                None => match lookup_map(normalized) {\\n                  Some(t) => Some(t),\\n                  None => match lookup_io(normalized) {\\n                    Some(t) => Some(t),\\n                    None => match lookup_fs(normalized) {\\n                      Some(t) => Some(t),\\n                      None => match lookup_net(normalized) {\\n                        Some(t) => Some(t),\\n                        None => match lookup_misc(normalized) {\\n                          Some(t) => Some(t),\\n                          None => lookup_async(normalized)\\n                        }\\n                      }\\n                    }\\n                  }\\n                }\\n                }\\n              }\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n\\n\\n\\nexport let rec subst_type_params: (Type, Array[String], Array[Type]) -> Type = (ty, params, args) -> {\\n  match ty {\\n    CtNamed(name, targs) => {\\n      let mut idx = 0 - 1\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        if Array::get(params, i) == name {\\n          idx = i\\n        }\\n        i = i + 1\\n      }\\n      if idx >= 0 && idx < Array::length(args) {\\n        Array::get(args, idx)\\n      } else {\\n        CtNamed(name, for a in targs {\\n          subst_type_params(a, params, args)\\n        })\\n      }\\n    },\\n    CtArray(e) => CtArray(subst_type_params(e, params, args)),\\n    CtOption(e) => CtOption(subst_type_params(e, params, args)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      subst_type_params(e, params, args)\\n    }),\\n    CtFn(ps, ret, eff) => {\\n      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {\\n        let out = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(types) {\\n          Array::push(out, subst_type_params(Array::get(types, i), params, args))\\n          i = i + 1\\n        }\\n        out\\n      }\\n      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)\\n    },\\n    _ => ty\\n  }\\n}\\n\\nexport let rec resolve_type_expr: (TypeExpr, Array[TypeDef]) -> Type = (te, defs) -> {\\n  match te {\\n    TyUnit => CtUnit,\\n    TyName(name) => match resolve_builtin(name) {\\n      Some(t) => t,\\n      None => match find_typedef(defs, name) {\\n        Some(td) => match td {\\n          TDEnum(n, _, _) => CtEnum(n),\\n          TDStruct(n, _, _) => CtStruct(n),\\n          TDAlias(_, _, t) => t\\n        },\\n        None => CtNamed(name, Array::slice([\\n          CtUnknown\\n        ], 0, 0))\\n      }\\n    },\\n    TyApp(name, args) => {\\n      let ra = for a in args {\\n        resolve_type_expr(a, defs)\\n      }\\n      if name == \\\"Array\\\" {\\n        if Array::length(ra) == 1 {\\n          CtArray(Array::get(ra, 0))\\n        }\\n        else CtNamed(name, ra)\\n      } else if name == \\\"Option\\\" {\\n        if Array::length(ra) == 1 {\\n          CtOption(Array::get(ra, 0))\\n        }\\n        else CtNamed(name, ra)\\n      } else {\\n        match find_typedef(defs, name) {\\n          Some(td) => match td {\\n            TDAlias(_, params, body) => subst_type_params(body, params, ra),\\n            _ => CtNamed(name, ra)\\n          },\\n          None => CtNamed(name, ra)\\n        }\\n      }\\n    },\\n    TyTuple(elems) => {\\n      let r = for e in elems {\\n        resolve_type_expr(e, defs)\\n      }\\n      CtTuple(r)\\n    },\\n    TyFn(params, ret, effect_name) => {\\n      let ret_box = Array::slice([\\n        ret\\n      ], 0, 1)\\n      let rp = for p in params {\\n        resolve_type_expr(p, defs)\\n      }\\n      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)\\n    }\\n  }\\n}\\n\\n\\n\\n\\nlet find_ctor_in_defs: (Array[TypeDef], String) -> Option[(String, Array[Type])] = (defs, ctor_name) -> {\\n  let dlen = Array::length(defs)\\n  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {\\n    if di >= dlen {\\n      None\\n    } else {\\n      let d = Array::get(defs, di)\\n      match d {\\n        TDEnum(enum_name, _, variants) => {\\n          let vlen = Array::length(variants)\\n          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {\\n            if vi >= vlen {\\n              go_defs(di + 1)\\n            } else {\\n              let (vname, vtypes) = Array::get(variants, vi)\\n              if vname == ctor_name {\\n                Some((enum_name, vtypes))\\n              } else {\\n                go_variants(vi + 1)\\n              }\\n            }\\n          }\\n          go_variants(0)\\n        },\\n        _ => go_defs(di + 1)\\n      }\\n    }\\n  }\\n  go_defs(0)\\n}\\n\\nexport let rec check_pattern: (Pat, Type, TypeEnv, Array[TypeDef], Array[String]) -> TypeEnv = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv {\\n  match pat {\\n    PWild => env,\\n    PBind(name) => env_bind(env, name, scrutinee_ty),\\n    PInt(_) => {\\n      match scrutinee_ty {\\n        CtInt => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"integer literal pattern cannot match a non-Int scrutinee\\\")\\n      }\\n      env\\n    },\\n    PString(_) => {\\n      match scrutinee_ty {\\n        CtString => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"string literal pattern cannot match a non-String scrutinee\\\")\\n      }\\n      env\\n    },\\n    PBool(_) => {\\n      match scrutinee_ty {\\n        CtBool => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"boolean literal pattern cannot match a non-Bool scrutinee\\\")\\n      }\\n      env\\n    },\\n    PCtor(name, sub_pats) => {\\n      let builtin_payload = match scrutinee_ty {\\n        CtOption(elem) => if name == \\\"Some\\\" {\\n          Some([\\n            elem\\n          ])\\n        } else if name == \\\"None\\\" {\\n          Some(Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        } else {\\n          None\\n        },\\n        _ => None\\n      }\\n      let ctor_payload = match builtin_payload {\\n        Some(types) => Some((\\\"Option\\\", types)),\\n        None => find_ctor_in_defs(defs, name)\\n      }\\n      match ctor_payload {\\n        Some(info) => {\\n          let (enum_name, raw_payload) = info\\n          let payload_types = match scrutinee_ty {\\n            CtNamed(_, sargs) => match find_typedef(defs, enum_name) {\\n              Some(td) => match td {\\n                TDEnum(_, eparams, _) => if Array::length(eparams) > 0 && Array::length(sargs) > 0 {\\n                  for pt in raw_payload {\\n                    subst_type_params(pt, eparams, sargs)\\n                  }\\n                } else {\\n                  raw_payload\\n                },\\n                _ => raw_payload\\n              },\\n              None => raw_payload\\n            },\\n            _ => raw_payload\\n          }\\n          let splen = Array::length(sub_pats)\\n          let ptlen = Array::length(payload_types)\\n          let non_enum_scrutinee = match scrutinee_ty {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtBytes => true,\\n            CtFn(_, _, _) => true,\\n            CtArray(_) => true,\\n            CtTuple(_) => true,\\n            _ => false\\n          }\\n          if non_enum_scrutinee {\\n            Array::push(errors, String::concat(\\\"constructor pattern `\\\", String::concat(name, String::concat(\\\"` (of \\\", String::concat(enum_name, \\\") cannot match this scrutinee type\\\")))))\\n          } else {\\n            ()\\n          }\\n          if enum_name != \\\"Option\\\" && splen != ptlen {\\n            Array::push(errors, String::concat(\\\"constructor pattern `\\\", String::concat(name, String::concat(\\\"` expects \\\", String::concat(__to_string(ptlen), String::concat(\\\" field(s) but binds \\\", __to_string(splen)))))))\\n          } else {\\n            ()\\n          }\\n          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= splen {\\n              acc_env\\n            } else {\\n              let sub_ty = if i < ptlen {\\n                Array::get(payload_types, i)\\n              } else {\\n                CtUnknown\\n              }\\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs, errors)\\n              bind_subs(i + 1, next_env)\\n            }\\n          }\\n          bind_subs(0, env)\\n        },\\n        None => {\\n          let splen = Array::length(sub_pats)\\n          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= splen {\\n              acc_env\\n            } else {\\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs, errors)\\n              bind_unknown(i + 1, next_env)\\n            }\\n          }\\n          bind_unknown(0, env)\\n        }\\n      }\\n    },\\n    PTuple(pats) => {\\n      let plen = Array::length(pats)\\n      match scrutinee_ty {\\n        CtTuple(elem_tys) => {\\n          let elen = Array::length(elem_tys)\\n          if plen != elen {\\n            Array::push(errors, String::concat(\\\"tuple pattern binds \\\", String::concat(__to_string(plen), String::concat(\\\" elements but the value is a \\\", String::concat(__to_string(elen), \\\"-tuple\\\")))))\\n          } else {\\n            ()\\n          }\\n          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= plen {\\n              acc_env\\n            } else {\\n              let et = if i < elen {\\n                Array::get(elem_tys, i)\\n              } else {\\n                CtUnknown\\n              }\\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs, errors)\\n              bind_tuple(i + 1, next_env)\\n            }\\n          }\\n          bind_tuple(0, env)\\n        },\\n        _ => {\\n          let concrete_non_tuple = match scrutinee_ty {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtBytes => true,\\n            CtArray(_) => true,\\n            CtOption(_) => true,\\n            CtFn(_, _, _) => true,\\n            CtStruct(_) => true,\\n            CtEnum(_) => true,\\n            _ => false\\n          }\\n          if concrete_non_tuple {\\n            Array::push(errors, String::concat(\\\"tuple pattern binds \\\", String::concat(__to_string(plen), \\\" elements but the value is not a tuple\\\")))\\n          } else {\\n            ()\\n          }\\n          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= plen {\\n              acc_env\\n            } else {\\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs, errors)\\n              bind_unk(i + 1, next_env)\\n            }\\n          }\\n          bind_unk(0, env)\\n        }\\n      }\\n    },\\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs, errors),\\n    PStruct(_, fields) => {\\n      let flen = Array::length(fields)\\n      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n        if i >= flen {\\n          acc_env\\n        } else {\\n          let (_, fpat) = Array::get(fields, i)\\n          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs, errors)\\n          bind_fields(i + 1, next_env)\\n        }\\n      }\\n      bind_fields(0, env)\\n    }\\n  }\\n}\\n\\n\\n\\n\\n\\n\\n\\nlet min_int: (Int, Int) -> Int = (a, b) -> {\\n  if a < b {\\n    a\\n  } else {\\n    b\\n  }\\n}\\n\\nlet off_marker: (Int) -> String = (off) -> {\\n  if off >= 0 {\\n    String::concat(\\\" [@off=\\\", String::concat(__to_string(off), \\\"]\\\"))\\n  } else {\\n    \\\"\\\"\\n  }\\n}\\n\\nlet off_marker_len: (Int, Int) -> String = (off, len) -> {\\n  if off >= 0 && len > 0 {\\n    String::concat(\\\" [@off=\\\", String::concat(__to_string(off), String::concat(\\\":\\\", String::concat(__to_string(off + len), \\\"]\\\"))))\\n  } else {\\n    off_marker(off)\\n  }\\n}\\n\\nlet prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (first, rest) -> {\\n  let out = Array::slice([\\n    EUnit\\n  ], 0, 0)\\n  Array::push(out, first)\\n  let mut i = 0\\n  while i < Array::length(rest) {\\n    Array::push(out, Array::get(rest, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet rec subst_self_in_type: (Type, Type) -> Type = (ty, self_ty) -> {\\n  match ty {\\n    CtNamed(n, args) => if n == \\\"Self\\\" {\\n      self_ty\\n    } else {\\n      let ra = for a in args {\\n        subst_self_in_type(a, self_ty)\\n      }\\n      CtNamed(n, ra)\\n    },\\n    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),\\n    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),\\n    CtTuple(elems) => CtTuple(for e in elems {\\n      subst_self_in_type(e, self_ty)\\n    }),\\n    CtFn(ps, ret, eff) => CtFn(for p in ps {\\n      subst_self_in_type(p, self_ty)\\n    }, subst_self_in_type(ret, self_ty), eff),\\n    _ => ty\\n  }\\n}\\n\\nlet rec relax_unknown_named: (Type, Array[TypeDef]) -> Type = (ty, defs) -> {\\n  match ty {\\n    CtNamed(n, args) => {\\n      let known = match find_typedef(defs, n) {\\n        Some(_) => true,\\n        None => match resolve_builtin(n) {\\n          Some(_) => true,\\n          None => false\\n        }\\n      }\\n      if known {\\n        CtNamed(n, for a in args {\\n          relax_unknown_named(a, defs)\\n        })\\n      } else {\\n        CtUnknown\\n      }\\n    },\\n    CtArray(e) => CtArray(relax_unknown_named(e, defs)),\\n    CtOption(e) => CtOption(relax_unknown_named(e, defs)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      relax_unknown_named(e, defs)\\n    }),\\n    CtFn(ps, r, eff) => CtFn(for p in ps {\\n      relax_unknown_named(p, defs)\\n    }, relax_unknown_named(r, defs), eff),\\n    _ => ty\\n  }\\n}\\n\\nlet resolve_trait_method_ident: (String, TypeEnv, Array[TypeDef], Subst) -> Option[Type] = (name, env, defs, s) -> {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    let method = String::substring(name, idx + 2, String::length(name))\\n    match env_lookup(env, head) {\\n      Some(head_ty) => match head_ty {\\n        CtVar(vid) => {\\n          let bounds = subst_bounds_for(s, vid)\\n          let self_ty = CtVar(vid)\\n          let mut result = None\\n          let mut bi = 0\\n          while bi < Array::length(bounds) {\\n            let pending = match result {\\n              None => true,\\n              _ => false\\n            }\\n            if pending {\\n              let trait_name = Array::get(bounds, bi)\\n              match trait_method_sig_deep(env, trait_name, method) {\\n                Some(sig) => {\\n                  let (params_te, ret_te) = sig\\n                  let resolved_params = for pte in params_te {\\n                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)\\n                  }\\n                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)\\n                  result = Some(CtFn(resolved_params, resolved_ret, None))\\n                },\\n                None => ()\\n              }\\n            } else {\\n              ()\\n            }\\n            bi = bi + 1\\n          }\\n          result\\n        },\\n        _ => None\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\nlet resolve_qualified_ctor_ident: (String, TypeEnv, Array[TypeDef]) -> Option[Type] = (name, env, defs) -> {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    let member = String::substring(name, idx + 2, String::length(name))\\n    match find_typedef(defs, head) {\\n      Some(TDEnum(_, _, variants)) => {\\n        let mut found = false\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, _) = Array::get(variants, vi)\\n          if vname == member {\\n            found = true\\n          } else {\\n            ()\\n          }\\n          vi = vi + 1\\n        }\\n        if found {\\n          env_lookup(env, member)\\n        } else {\\n          None\\n        }\\n      },\\n      _ => None\\n    }\\n  }\\n}\\n\\nlet expr_ident_name_or_empty: (Expr) -> String = (expr) -> {\\n  match expr {\\n    EIdent(name, _) => name,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\nlet rec strip_effects: (Type) -> Type = (ty) -> {\\n  match ty {\\n    CtFn(params, ret, _) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        Array::push(out, strip_effects(Array::get(params, i)))\\n        i = i + 1\\n      }\\n      CtFn(out, strip_effects(ret), None)\\n    },\\n    CtArray(elem) => CtArray(strip_effects(elem)),\\n    CtOption(elem) => CtOption(strip_effects(elem)),\\n    CtTuple(elems) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        Array::push(out, strip_effects(Array::get(elems, i)))\\n        i = i + 1\\n      }\\n      CtTuple(out)\\n    },\\n    CtNamed(name, args) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        Array::push(out, strip_effects(Array::get(args, i)))\\n        i = i + 1\\n      }\\n      CtNamed(name, out)\\n    },\\n    _ => ty\\n  }\\n}\\n\\nlet rec arm_body_diverges: (Expr) -> Bool = (body) -> {\\n  match body {\\n    EReturn(_) => true,\\n    ESeq(_, rest) => arm_body_diverges(rest),\\n    _ => false\\n  }\\n}\\n\\nlet rec type_is_ground: (Type) -> Bool = (t) -> {\\n  match t {\\n    CtNamed(_, _) => false,\\n    CtVar(_) => false,\\n    CtForAll(_, _, _) => false,\\n    CtTuple(items) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        if !type_is_ground(Array::get(items, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    CtArray(e) => type_is_ground(e),\\n    CtOption(e) => type_is_ground(e),\\n    CtFn(ps, r, _) => {\\n      let mut ok = type_is_ground(r)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if !type_is_ground(Array::get(ps, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    _ => true\\n  }\\n}\\n\\nlet rec type_no_named: (Type) -> Bool = (t) -> {\\n  match t {\\n    CtNamed(_, _) => false,\\n    CtForAll(_, _, _) => false,\\n    CtTuple(items) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        if !type_no_named(Array::get(items, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    CtArray(e) => type_no_named(e),\\n    CtOption(e) => type_no_named(e),\\n    CtFn(ps, r, _) => {\\n      let mut ok = type_no_named(r)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if !type_no_named(Array::get(ps, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    _ => true\\n  }\\n}\\n\\nlet head_kind: (Type) -> Int = (t) -> {\\n  match t {\\n    CtInt => 1,\\n    CtDouble => 2,\\n    CtBool => 3,\\n    CtString => 4,\\n    CtChar => 5,\\n    CtUnit => 6,\\n    CtBytes => 7,\\n    CtTuple(_) => 8,\\n    CtArray(_) => 9,\\n    CtOption(_) => 10,\\n    CtStruct(_) => 11,\\n    CtEnum(_) => 12,\\n    CtFn(_, _, _) => 13,\\n    _ => 0\\n  }\\n}\\n\\nlet struct_fields_ground: (Array[(String, Type)]) -> Bool = (dfields) -> {\\n  let mut ok = true\\n  let mut i = 0\\n  while i < Array::length(dfields) {\\n    let (_, ft) = Array::get(dfields, i)\\n    if !type_is_ground(ft) {\\n      ok = false\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\nexport let check_assignable: (Type, Type, Subst, Array[String], String, Int) -> Subst = (expected, actual, s, errors, what, off) -> {\\n  match unify(expected, actual, s) {\\n    Some(su) => su,\\n    None => {\\n      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {\\n        Some(_) => true,\\n        None => false\\n      }\\n      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))\\n      let eh = head_kind(subst_apply(s, expected))\\n      let ah = head_kind(subst_apply(s, actual))\\n      let head_differ = eh != 0 && ah != 0 && eh != ah\\n      if structural || !(reportable || head_differ) {\\n        s\\n      } else {\\n        Array::push(errors, String::concat(what, String::concat(\\\": expected \\\", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\\\", got \\\", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))\\n        s\\n      }\\n    }\\n  }\\n}\\n\\nlet struct_field_names_match: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (declared, actual) -> {\\n  if Array::length(declared) != Array::length(actual) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while i < Array::length(declared) {\\n      let (dn, _) = Array::get(declared, i)\\n      let mut found = false\\n      let mut j = 0\\n      while j < Array::length(actual) {\\n        let (an, _) = Array::get(actual, j)\\n        if an == dn {\\n          found = true\\n        }\\n        j = j + 1\\n      }\\n      if !found {\\n        ok = false\\n      }\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nlet lookup_actual_field_ty: (Array[(String, Type)], String) -> Option[Type] = (actual, name) -> {\\n  let mut i = 0\\n  let mut out = None\\n  while i < Array::length(actual) {\\n    let (an, at) = Array::get(actual, i)\\n    if an == name {\\n      out = Some(at)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet struct_is_strict_superset: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (dfields, actual) -> {\\n  if Array::length(dfields) <= Array::length(actual) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut all_in = true\\n    while i < Array::length(actual) {\\n      let (an, _) = Array::get(actual, i)\\n      let mut found = false\\n      let mut j = 0\\n      while j < Array::length(dfields) {\\n        let (dn, _) = Array::get(dfields, j)\\n        if dn == an {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        j = j + 1\\n      }\\n      if !found {\\n        all_in = false\\n      } else {\\n        ()\\n      }\\n      i = i + 1\\n    }\\n    all_in\\n  }\\n}\\n\\nlet check_record_fields: (Array[TypeDef], Array[(String, Type)], Subst, Array[String]) -> Subst = (defs, actual, s, errors) -> {\\n  let mut matchct = 0\\n  let mut matched_fields = Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n  let mut di = 0\\n  while di < Array::length(defs) {\\n    match Array::get(defs, di) {\\n      TDStruct(_, dfields, _) => if struct_field_names_match(dfields, actual) {\\n        matchct = matchct + 1\\n        matched_fields = dfields\\n      },\\n      _ => ()\\n    }\\n    di = di + 1\\n  }\\n  if matchct == 1 {\\n    let mut out = s\\n    let mut i = 0\\n    while i < Array::length(matched_fields) {\\n      let (fname, declared_ty) = Array::get(matched_fields, i)\\n      match lookup_actual_field_ty(actual, fname) {\\n        Some(actual_ty) => {\\n          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat(\\\"struct field type mismatch for \\\", fname), 0 - 1)\\n        },\\n        None => ()\\n      }\\n      i = i + 1\\n    }\\n    out\\n  } else {\\n    let mut supct = 0\\n    let mut sup_name = \\\"\\\"\\n    let mut sup_fields = Array::slice([\\n      (\\\"\\\", CtUnknown)\\n    ], 0, 0)\\n    let mut dj = 0\\n    while dj < Array::length(defs) {\\n      match Array::get(defs, dj) {\\n        TDStruct(sname, dfields, _) => if struct_is_strict_superset(dfields, actual) {\\n          supct = supct + 1\\n          sup_name = sname\\n          sup_fields = dfields\\n        },\\n        _ => ()\\n      }\\n      dj = dj + 1\\n    }\\n    if supct == 1 {\\n      let mut fi = 0\\n      while fi < Array::length(sup_fields) {\\n        let (dn, _) = Array::get(sup_fields, fi)\\n        match lookup_actual_field_ty(actual, dn) {\\n          Some(_) => (),\\n          None => Array::push(errors, String::concat(\\\"missing field `\\\", String::concat(dn, String::concat(\\\"` in construction of struct \\\", sup_name))))\\n        }\\n        fi = fi + 1\\n      }\\n      s\\n    } else {\\n      s\\n    }\\n  }\\n}\\n\\nlet resolve_record_struct_name: (Array[TypeDef], Array[(String, Type)]) -> Option[String] = (defs, actual) -> {\\n  let mut matchct = 0\\n  let mut out = None\\n  let mut ground = false\\n  let mut di = 0\\n  while di < Array::length(defs) {\\n    match Array::get(defs, di) {\\n      TDStruct(sname, dfields, _) => if struct_field_names_match(dfields, actual) {\\n        matchct = matchct + 1\\n        out = Some(sname)\\n        ground = struct_fields_ground(dfields)\\n      },\\n      _ => ()\\n    }\\n    di = di + 1\\n  }\\n  if matchct == 1 && ground {\\n    out\\n  } else {\\n    None\\n  }\\n}\\n\\nlet unify_call_args: (Array[Type], Array[Type], Subst, Array[String], String, Int) -> Subst = (param_tys, arg_tys, s, errors, label, off) -> {\\n  let mut out = s\\n  let mut ui = 0\\n  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\\n  while ui < ul {\\n    let pty = Array::get(param_tys, ui)\\n    let aty = Array::get(arg_tys, ui)\\n    out = if label == \\\"__to_string\\\" {\\n      match unify(pty, aty, out) {\\n        Some(su) => su,\\n        None => out\\n      }\\n    } else {\\n      check_assignable(pty, aty, out, errors, String::concat(\\\"argument type mismatch for \\\", label), off)\\n    }\\n    ui = ui + 1\\n  }\\n  out\\n}\\n\\nexport let fn_return_env_name: (String) -> String = (name) -> {\\n  String::concat(\\\"__fn_ret__:\\\", name)\\n}\\n\\nlet direct_builtin_return: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"iter_length\\\" || name == \\\"String::iter_length\\\" || name == \\\"Map::iter_length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"Array::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"FixedArray::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"Bytes::get\\\" || name == \\\"String::index_of\\\" || name == \\\"String::char_code_at\\\" || name == \\\"String::last_index_of\\\" || name == \\\"Char::to_int\\\" || name == \\\"Double::to_int\\\" || name == \\\"Double::to_i64_bits\\\" || name == \\\"Double::to_i64_bits_lo\\\" || name == \\\"Double::to_i64_bits_hi\\\" || name == \\\"Env::args_len\\\" || name == \\\"Stdin::read_char\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::equals\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"Array::any\\\" || name == \\\"Array::all\\\" || name == \\\"Array::contains\\\" || name == \\\"Map::has_key\\\" || name == \\\"map_has\\\" || name == \\\"Path::is_absolute\\\" || name == \\\"Fs::exists\\\" || name == \\\"Fs::is_dir\\\" || name == \\\"Fs::is_file\\\" || name == \\\"eq\\\" || name == \\\"not\\\" {\\n    Some(CtBool)\\n  }\\n  else if name == \\\"String::concat\\\" || name == \\\"String::substring\\\" || name == \\\"String::trim\\\" || name == \\\"String::to_lower\\\" || name == \\\"String::to_upper\\\" || name == \\\"String::from_char_code\\\" || name == \\\"String::join\\\" || name == \\\"Array::join\\\" || name == \\\"Path::to_string\\\" || name == \\\"Path::resolve\\\" || name == \\\"PromptText::new\\\" || name == \\\"Stdin::read_stream\\\" || name == \\\"Env::get\\\" || name == \\\"Env::args_get\\\" || name == \\\"Fs::read_file\\\" || name == \\\"Fs::getcwd\\\" || name == \\\"sh\\\" || name == \\\"Lines::stringify\\\" || name == \\\"Llm::complete\\\" || name == \\\"Rlm::run\\\" || name == \\\"Rlm::finalize\\\" || name == \\\"__to_string\\\" {\\n    Some(CtString)\\n  }\\n  else if name == \\\"__len\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::iter_get\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"iter_get\\\" || name == \\\"Map::iter_get\\\" || name == \\\"iter_require\\\" || name == \\\"__neg\\\" {\\n    Some(CtUnknown)\\n  }\\n  else if name == \\\"Bytes::new\\\" || name == \\\"Bytes::concat\\\" || name == \\\"Bytes::slice\\\" || name == \\\"Bytes::from_array\\\" || name == \\\"Fs::read_bytes\\\" {\\n    Some(CtBytes)\\n  }\\n  else if name == \\\"Array::set\\\" || name == \\\"Array::push\\\" || name == \\\"Array::push_all\\\" || name == \\\"Array::truncate\\\" || name == \\\"Array::foreach\\\" || name == \\\"FixedArray::set\\\" || name == \\\"FixedArray::blit\\\" || name == \\\"FixedArray::unsafe_set\\\" || name == \\\"Bytes::set\\\" || name == \\\"Bytes::push\\\" || name == \\\"Bytes::append\\\" || name == \\\"Bytes::blit\\\" || name == \\\"Bytes::fill\\\" || name == \\\"MapBuilder::set\\\" || name == \\\"Stdout::write_char\\\" || name == \\\"Stdout::write_stream\\\" || name == \\\"sleep\\\" || name == \\\"Fs::copy\\\" || name == \\\"Fs::chdir\\\" || name == \\\"Fs::mkdir\\\" || name == \\\"Fs::append\\\" || name == \\\"Fs::remove\\\" || name == \\\"Fs::write_file\\\" || name == \\\"Fs::write_bytes\\\" || name == \\\"print\\\" || name == \\\"println\\\" || name == \\\"assert\\\" || name == \\\"assert_true\\\" || name == \\\"assert_eq\\\" || name == \\\"__set_field\\\" {\\n    Some(CtUnit)\\n  }\\n  else if name == \\\"Double::from_i64_bits\\\" || name == \\\"Int::to_double\\\" || name == \\\"Double::to_float\\\" || name == \\\"Float::to_double\\\" {\\n    Some(CtDouble)\\n  }\\n  else if name == \\\"Char::from_int\\\" {\\n    Some(CtChar)\\n  }\\n  else if name == \\\"Bytes::to_array\\\" {\\n    Some(CtArray(CtInt))\\n  }\\n  else if name == \\\"Map::keys\\\" || name == \\\"sh_lines\\\" || name == \\\"Lines::parse\\\" {\\n    Some(CtArray(CtString))\\n  }\\n  else if name == \\\"Array::slice\\\" || name == \\\"Array::concat\\\" || name == \\\"Array::filter\\\" || name == \\\"Array::reverse\\\" || name == \\\"Array::sort\\\" || name == \\\"FixedArray::make\\\" {\\n    Some(CtArray(CtUnknown))\\n  }\\n  else if name == \\\"Some\\\" || name == \\\"Array::find\\\" {\\n    Some(CtOption(CtUnknown))\\n  }\\n  else {\\n    None\\n  }\\n}\\n\\nlet direct_call_return: (TypeEnv, String) -> Option[Type] = (env, name) -> {\\n  match env_lookup(env, name) {\\n    Some(_) => None,\\n    None => direct_builtin_return(name)\\n  }\\n}\\n\\nlet builtin_first_arg_head: (String) -> Int = (name) -> {\\n  if name == \\\"Array::length\\\" || name == \\\"Array::get\\\" || name == \\\"Array::set\\\" || name == \\\"Array::push\\\" || name == \\\"Array::push_all\\\" || name == \\\"Array::slice\\\" || name == \\\"Array::concat\\\" || name == \\\"Array::reverse\\\" || name == \\\"Array::truncate\\\" || name == \\\"Array::foreach\\\" || name == \\\"Array::contains\\\" || name == \\\"Array::any\\\" || name == \\\"Array::all\\\" || name == \\\"Array::find\\\" || name == \\\"Array::filter\\\" {\\n    9\\n  } else if name == \\\"String::length\\\" || name == \\\"String::substring\\\" || name == \\\"String::trim\\\" || name == \\\"String::to_lower\\\" || name == \\\"String::to_upper\\\" || name == \\\"String::index_of\\\" || name == \\\"String::last_index_of\\\" || name == \\\"String::char_code_at\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"String::split\\\" || name == \\\"String::concat\\\" {\\n    4\\n  } else if name == \\\"Bytes::length\\\" || name == \\\"Bytes::get\\\" || name == \\\"Bytes::set\\\" || name == \\\"Bytes::slice\\\" || name == \\\"Bytes::to_array\\\" || name == \\\"Bytes::push\\\" || name == \\\"Bytes::append\\\" || name == \\\"Bytes::blit\\\" || name == \\\"Bytes::fill\\\" {\\n    7\\n  } else {\\n    0\\n  }\\n}\\n\\nlet builtin_arg_head_rest: (String, Int) -> Int = (name, i) -> {\\n  if name == \\\"String::concat\\\" {\\n    if i == 1 { 4 } else { 0 }\\n  } else if name == \\\"String::index_of\\\" || name == \\\"String::last_index_of\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"String::split\\\" {\\n    if i == 1 { 4 } else { 0 }\\n  } else if name == \\\"String::substring\\\" {\\n    if i == 1 || i == 2 { 1 } else { 0 }\\n  } else if name == \\\"String::char_code_at\\\" {\\n    if i == 1 { 1 } else { 0 }\\n  } else if name == \\\"Bytes::get\\\" {\\n    if i == 1 { 1 } else { 0 }\\n  } else if name == \\\"Bytes::set\\\" || name == \\\"Bytes::slice\\\" {\\n    if i == 1 || i == 2 { 1 } else { 0 }\\n  } else {\\n    0\\n  }\\n}\\n\\nlet check_hof_param_vs_elem: (Type, Type, Int, Subst, Array[String], String) -> Subst = (recv_ty, fn_ty, pidx, s, errors, msg) -> {\\n  match recv_ty {\\n    CtArray(elem) => match fn_ty {\\n      CtFn(ptys, _, _) => if Array::length(ptys) > pidx {\\n        check_assignable(subst_apply(s, Array::get(ptys, pidx)), subst_apply(s, elem), s, errors, msg, 0 - 1)\\n      } else {\\n        s\\n      },\\n      _ => s\\n    },\\n    _ => s\\n  }\\n}\\n\\nlet check_two_array_elems: (Type, Type, Subst, Array[String], String) -> Subst = (a_app, b_app, s, errors, msg) -> {\\n  match a_app {\\n    CtArray(ea) => match b_app {\\n      CtArray(eb) => check_assignable(subst_apply(s, ea), subst_apply(s, eb), s, errors, msg, 0 - 1),\\n      _ => s\\n    },\\n    _ => s\\n  }\\n}\\n\\nlet struct_field_type: (Array[TypeDef], String, String) -> Option[Type] = (defs, sname, field) -> {\\n  match find_typedef(defs, sname) {\\n    Some(td) => match td {\\n      TDStruct(_, fields, _) => {\\n        let rec go: (Int) -> Option[Type] = (i) -> {\\n          if i >= Array::length(fields) {\\n            None\\n          } else {\\n            let (fname, ftype) = Array::get(fields, i)\\n            if fname == field { Some(ftype) } else { go(i + 1) }\\n          }\\n        }\\n        go(0)\\n      },\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\nlet is_logic_binop: (String) -> Bool = (op) -> {\\n  op == \\\"&&\\\"\\n  || op == \\\"||\\\"\\n}\\n\\nlet is_order_binop: (String) -> Bool = (op) -> {\\n  op == \\\"<\\\"\\n  || op == \\\">\\\"\\n  || op == \\\"<=\\\"\\n  || op == \\\">=\\\"\\n}\\n\\nlet type_name_prefix: (Type) -> String = (ty) -> {\\n  match ty {\\n    CtInt => \\\"Int\\\",\\n    CtDouble => \\\"Double\\\",\\n    CtBool => \\\"Bool\\\",\\n    CtString => \\\"String\\\",\\n    CtChar => \\\"Char\\\",\\n    CtUnit => \\\"Unit\\\",\\n    CtBytes => \\\"Bytes\\\",\\n    CtArray(_) => \\\"Array\\\",\\n    CtOption(_) => \\\"Option\\\",\\n    CtEnum(name) => name,\\n    CtStruct(name) => name,\\n    CtNamed(name, _) => name,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\nlet is_equality_binop: (String) -> Bool = (op) -> {\\n  op == \\\"==\\\"\\n  || op == \\\"!=\\\"\\n}\\n\\nlet unify_binop_candidate: (Type, Type, Type, Subst) -> Option[Subst] = (left_ty, right_ty, target_ty, s) -> {\\n  match unify(left_ty, target_ty, s) {\\n    Some(s1) => unify(right_ty, target_ty, s1),\\n    None => None\\n  }\\n}\\n\\nlet unify_same_binop_operands: (Type, Type, Subst) -> Option[(Type, Subst)] = (left_ty, right_ty, s) -> {\\n  match unify(left_ty, right_ty, s) {\\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\\n    None => None\\n  }\\n}\\n\\nlet infer_named_trait_binop: (TypeEnv, Type, Type, String, Subst) -> Option[(Type, Subst)] = (env, left_ty, right_ty, trait_name, s) -> {\\n  match unify_same_binop_operands(left_ty, right_ty, s) {\\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\\n      Some((resolved, s1))\\n    } else {\\n      None\\n    },\\n    None => None\\n  }\\n}\\n\\nlet infer_binop_type: (String, Type, Type, TypeEnv, Subst, Array[String], Array[(Int, Type)]) -> (Type, Subst) = (op, left_ty, right_ty, env, s, errors, tytab) -> {\\n  if is_logic_binop(op) {\\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Bool\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if is_equality_binop(op) {\\n    match unify(left_ty, right_ty, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must have same type\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if is_order_binop(op) {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtBool, s1),\\n        None => match infer_named_trait_binop(env, left_ty, right_ty, \\\"Ord\\\", s) {\\n          Some((_, s1)) => (CtBool, s1),\\n          None => {\\n            Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int or Double\\\")))\\n            (CtUnknown, s)\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"+\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtDouble, s1),\\n        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\\n          Some(s1) => (CtString, s1),\\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \\\"Add\\\", s) {\\n            Some((resolved, s1)) => (resolved, s1),\\n            None => {\\n              Array::push(errors, \\\"type mismatch in '+': operands must be Int, Double, or String\\\")\\n              (CtUnknown, s)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"-\\\"\\n  || op == \\\"*\\\"\\n  || op == \\\"/\\\" {\\n    let trait_name = if op == \\\"-\\\" {\\n      \\\"Sub\\\"\\n    } else if op == \\\"*\\\" {\\n      \\\"Mul\\\"\\n    } else {\\n      \\\"Div\\\"\\n    }\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtDouble, s1),\\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\\n          Some((resolved, s1)) => (resolved, s1),\\n          None => {\\n            Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int or Double\\\")))\\n            (CtUnknown, s)\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"%\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => {\\n        Array::push(errors, \\\"type mismatch in '%': operands must be Int\\\")\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if op == \\\"&\\\" || op == \\\"|\\\" || op == \\\"^\\\" || op == \\\"<<\\\" || op == \\\">>\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else {\\n    Array::push(errors, String::concat(\\\"unknown operator: \\\", op))\\n    (CtUnknown, s)\\n  }\\n}\\n\\nlet rec resolve_tparams_in: (Type, TypeEnv) -> Type = (ty, env) -> {\\n  match ty {\\n    CtNamed(name, args) => {\\n      let ra = for a in args {\\n        resolve_tparams_in(a, env)\\n      }\\n      match env_lookup(env, name) {\\n        Some(t) => match t {\\n          CtVar(_) => t,\\n          _ => CtNamed(name, ra)\\n        },\\n        None => CtNamed(name, ra)\\n      }\\n    },\\n    CtArray(e) => CtArray(resolve_tparams_in(e, env)),\\n    CtOption(e) => CtOption(resolve_tparams_in(e, env)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      resolve_tparams_in(e, env)\\n    }),\\n    CtFn(ps, ret, eff) => {\\n      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {\\n        let out = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(types) {\\n          Array::push(out, resolve_tparams_in(Array::get(types, i), env))\\n          i = i + 1\\n        }\\n        out\\n      }\\n      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)\\n    },\\n    _ => ty\\n  }\\n}\\n\\nlet tab_call_ty: (Array[(Int, Type)], Int, Type) -> Type = (tytab, call_off, ty) -> {\\n  if call_off >= 0 {\\n    Array::push(tytab, (call_off, ty))\\n  } else {\\n    ()\\n  }\\n  ty\\n}\\n\\nlet check_seq_spine: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab, ce) -> {\\n  let mut cur = expr\\n  let mut cenv = env\\n  let mut s1 = s\\n  let mut c1 = c\\n  let mut done = false\\n  let mut result = (CtUnit, s, c)\\n  while !done {\\n    match cur {\\n      ESeq(left, right) => {\\n        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        cur = right\\n      },\\n      ELet(name, val, body) => {\\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\\n        let gen = generalize(ns, vt)\\n        cenv = env_bind(cenv, name, gen)\\n        s1 = ns\\n        c1 = nc\\n        cur = body\\n      },\\n      ELetMut(name, val, body) => {\\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\\n        cenv = env_bind(cenv, name, vt)\\n        s1 = ns\\n        c1 = nc\\n        cur = body\\n      },\\n      ELetRec(name, val, body) => {\\n        let (tv, c1b) = fresh_var(c1)\\n        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)\\n        let s2 = match unify(tv, vt, ns) {\\n          Some(su) => su,\\n          None => ns\\n        }\\n        let gen = generalize(s2, tv)\\n        cenv = env_bind(cenv, name, gen)\\n        s1 = s2\\n        c1 = nc\\n        cur = body\\n      },\\n      _ => {\\n        result = ce(cur, cenv, defs, s1, c1, errors, tytab)\\n        done = true\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nlet field_write_mut_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, tytab, ce) -> {\\n  if name == \\\"__set_field\\\" && Array::length(args) == 3 {\\n    match Array::get(args, 1) {\\n      EString(field) => {\\n        let throwaway = Array::slice([\\\"\\\"], 0, 0)\\n        let throwtab = Array::slice([(0, CtUnit)], 0, 0)\\n        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\\n        match subst_apply(s, obj_ty) {\\n          CtStruct(sname) => match find_typedef(defs, sname) {\\n            Some(TDStruct(_, dfields, mut_names)) => {\\n              let mut found = false\\n              let mut i = 0\\n              while i < Array::length(mut_names) {\\n                if Array::get(mut_names, i) == field {\\n                  found = true\\n                } else {\\n                  ()\\n                }\\n                i = i + 1\\n              }\\n              if found {\\n                ()\\n              } else {\\n                Array::push(errors, String::concat(\\\"cannot assign to non-`mut` field `\\\", String::concat(field, String::concat(\\\"` of struct \\\", sname))))\\n              }\\n              let mut fty = CtUnknown\\n              let mut has_field = false\\n              let mut fi = 0\\n              while fi < Array::length(dfields) {\\n                let (fn2, ft) = Array::get(dfields, fi)\\n                if fn2 == field {\\n                  fty = ft\\n                  has_field = true\\n                } else {\\n                  ()\\n                }\\n                fi = fi + 1\\n              }\\n              if has_field {\\n                let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)\\n                let _ = check_assignable(subst_apply(s, fty), subst_apply(s, val_ty), s, errors, String::concat(\\\"type mismatch writing field `\\\", String::concat(field, \\\"`\\\")), 0 - 1)\\n                ()\\n              } else {\\n                ()\\n              }\\n            },\\n            _ => ()\\n          },\\n          _ => ()\\n        }\\n      },\\n      _ => ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\nlet index_target_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, ce) -> {\\n  if name == \\\"__index\\\" && Array::length(args) == 2 {\\n    let throwaway = Array::slice([\\\"\\\"], 0, 0)\\n    let throwtab = Array::slice([(0, CtUnit)], 0, 0)\\n    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\\n    let resolved_obj = subst_apply(s, obj_ty)\\n    let not_indexable = match resolved_obj {\\n      CtInt => true,\\n      CtDouble => true,\\n      CtBool => true,\\n      CtChar => true,\\n      CtUnit => true,\\n      _ => false\\n    }\\n    if not_indexable {\\n      Array::push(errors, \\\"cannot index a non-indexable value (expected Array, String, or Bytes)\\\")\\n    } else {\\n      let indexable = match resolved_obj {\\n        CtArray(_) => true,\\n        CtString => true,\\n        CtBytes => true,\\n        _ => false\\n      }\\n      if indexable {\\n        let throwaway2 = Array::slice([\\\"\\\"], 0, 0)\\n        let throwtab2 = Array::slice([(0, CtUnit)], 0, 0)\\n        let (idx_ty, _, _) = ce(Array::get(args, 1), env, defs, s, c, throwaway2, throwtab2)\\n        let bad_index = match subst_apply(s, idx_ty) {\\n          CtInt => false,\\n          _ => type_is_ground(subst_apply(s, idx_ty))\\n        }\\n        if bad_index {\\n          Array::push(errors, \\\"index must be an Int\\\")\\n        } else {\\n          ()\\n        }\\n      } else {\\n        ()\\n      }\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\nlet rec pat_is_catchall: (Pat) -> Bool = (pat) -> {\\n  match pat {\\n    PWild => true,\\n    PBind(_) => true,\\n    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),\\n    _ => false\\n  }\\n}\\n\\nlet rec collect_ctor_names_into: (Pat, Array[String]) -> Unit = (pat, acc) -> {\\n  match pat {\\n    PCtor(name, _) => Array::push(acc, name),\\n    POr(l, r) => {\\n      collect_ctor_names_into(l, acc)\\n      collect_ctor_names_into(r, acc)\\n    },\\n    _ => ()\\n  }\\n}\\n\\nlet parse_tuple_index: (String) -> Option[Int] = (s) -> {\\n  let len = String::length(s)\\n  if len == 0 {\\n    None\\n  } else {\\n    let mut i = 0\\n    let mut val = 0\\n    let mut ok = true\\n    while i < len {\\n      let cc = String::char_code_at(s, i)\\n      if cc >= 48 && cc <= 57 {\\n        val = val * 10 + (cc - 48)\\n      } else {\\n        ok = false\\n      }\\n      i = i + 1\\n    }\\n    if ok {\\n      Some(val)\\n    } else {\\n      None\\n    }\\n  }\\n}\\n\\nexport let rec check_expr: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab) -> {\\n  match expr {\\n    EInt(_) => (CtInt, s, c),\\n    EFloat(_) => (CtDouble, s, c),\\n    EString(_) => (CtString, s, c),\\n    EBool(_) => (CtBool, s, c),\\n    EUnit => (CtUnit, s, c),\\n    EIdent(name, ident_off) => match env_lookup(env, name) {\\n      Some(t) => {\\n        let (ti, c1, new_bounds) = instantiate(t, c)\\n        let nblen = Array::length(new_bounds)\\n        let mut s1 = s\\n        let mut bi = 0\\n        while bi < nblen {\\n          let (vid, bounds) = Array::get(new_bounds, bi)\\n          if Array::length(bounds) != 0 {\\n            s1 = subst_add_bound(s1, vid, bounds)\\n          }\\n          bi = bi + 1\\n        }\\n        if ident_off >= 0 {\\n          Array::push(tytab, (ident_off, ti))\\n        } else {\\n          ()\\n        }\\n        (ti, s1, c1)\\n      },\\n      None => match lookup_builtin(name) {\\n        Some(t) => {\\n          if ident_off >= 0 {\\n            Array::push(tytab, (ident_off, t))\\n          } else {\\n            ()\\n          }\\n          (t, s, c)\\n        },\\n        None => match resolve_trait_method_ident(name, env, defs, s) {\\n          Some(mty) => {\\n            if ident_off >= 0 {\\n              Array::push(tytab, (ident_off, mty))\\n            } else {\\n              ()\\n            }\\n            (mty, s, c)\\n          },\\n          None => match resolve_qualified_ctor_ident(name, env, defs) {\\n            Some(ct) => {\\n              let (ti, c1, new_bounds) = instantiate(ct, c)\\n              let nblen = Array::length(new_bounds)\\n              let mut s1 = s\\n              let mut bi = 0\\n              while bi < nblen {\\n                let (vid, bounds) = Array::get(new_bounds, bi)\\n                if Array::length(bounds) != 0 {\\n                  s1 = subst_add_bound(s1, vid, bounds)\\n                } else {\\n                  ()\\n                }\\n                bi = bi + 1\\n              }\\n              if ident_off >= 0 {\\n                Array::push(tytab, (ident_off, ti))\\n              } else {\\n                ()\\n              }\\n              (ti, s1, c1)\\n            },\\n            None => {\\n              Array::push(errors, String::concat(String::concat(\\\"unknown name: \\\", name), off_marker_len(ident_off, String::length(name))))\\n              (CtUnknown, s, c)\\n            }\\n          }\\n        }\\n      }\\n    },\\n    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELet(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELetMut(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    EIf(cond, then_e, else_e) => {\\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\\n      let resolved_ct = subst_apply(s1, ct)\\n      match resolved_ct {\\n        CtBool => (),\\n        CtUnknown => (),\\n        CtVar(_) => (),\\n        _ => Array::push(errors, \\\"if condition must be Bool\\\")\\n      }\\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)\\n      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)\\n      let rtt = subst_apply(s3, tt)\\n      let ret = subst_apply(s3, et)\\n      let (s3b, if_ty) = match rtt {\\n        CtUnit => (s3, CtUnit),\\n        _ => match ret {\\n          CtUnit => (s3, CtUnit),\\n          _ => (check_assignable(rtt, ret, s3, errors, \\\"if branches have incompatible types\\\", 0 - 1), tt)\\n        }\\n      }\\n      (if_ty, s3b, c3)\\n    },\\n    ECall(callee, args, call_off) => match callee {\\n      EIdent(name, callee_off) => {\\n        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)\\n        index_target_check(name, args, env, defs, s, c, errors, check_expr)\\n        if name == \\\"perform\\\" {\\n        if Array::length(args) == 1 {\\n          match Array::get(args, 0) {\\n            ECall(_, opargs, _) => {\\n              let oalen = Array::length(opargs)\\n              let mut s1 = s\\n              let mut c1 = c\\n              let mut ai = 0\\n              while ai < oalen {\\n                let (_, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)\\n                s1 = ns\\n                c1 = nc\\n                ai = ai + 1\\n              }\\n              let (tv, c2) = fresh_var(c1)\\n              (tv, s1, c2)\\n            },\\n            EIdent(_, _) => {\\n              let (tv, c2) = fresh_var(c)\\n              (tv, s, c2)\\n            },\\n            other => check_expr(other, env, defs, s, c, errors, tytab)\\n          }\\n        } else {\\n          (CtUnknown, s, c)\\n        }\\n      } else if name == \\\"resume\\\" {\\n        let alen = Array::length(args)\\n        let mut s1 = s\\n        let mut c1 = c\\n        let mut ai = 0\\n        while ai < alen {\\n          let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\\n          s1 = ns\\n          c1 = nc\\n          ai = ai + 1\\n        }\\n        let (tv, c2) = fresh_var(c1)\\n        (tv, s1, c2)\\n      } else if name == \\\"Some\\\" {\\n        if Array::length(args) == 1 {\\n          let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n          (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)\\n        } else {\\n          Array::push(errors, String::concat(String::concat(\\\"Some expects 1 argument, got \\\", __to_string(Array::length(args))), off_marker_len(callee_off, 4)))\\n          (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)\\n        }\\n      } else if name == \\\"__index\\\" && Array::length(args) == 2 {\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let result = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => elem,\\n          CtString => CtInt,\\n          CtBytes => CtInt,\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s2, c2)\\n      } else if name == \\\"Array::push\\\" && Array::length(args) == 2 {\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (val_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => check_assignable(subst_apply(s2, elem), subst_apply(s2, val_ty), s2, errors, \\\"Array::push value type mismatch\\\", 0 - 1),\\n          _ => s2\\n        }\\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\\n      } else if name == \\\"Array::set\\\" && Array::length(args) == 3 {\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (val_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let s4 = match subst_apply(s3, obj_ty) {\\n          CtArray(elem) => check_assignable(subst_apply(s3, elem), subst_apply(s3, val_ty), s3, errors, \\\"Array::set value type mismatch\\\", 0 - 1),\\n          _ => s3\\n        }\\n        (tab_call_ty(tytab, call_off, CtUnit), s4, c3)\\n      } else if name == \\\"Array::push_all\\\" && Array::length(args) == 2 {\\n        let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = check_two_array_elems(subst_apply(s2, a_ty), subst_apply(s2, b_ty), s2, errors, \\\"Array::push_all element type mismatch\\\")\\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\\n      } else if name == \\\"Array::get\\\" && Array::length(args) == 2 {\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let result = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => elem,\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s2, c2)\\n      } else if name == \\\"Array::reverse\\\" && Array::length(args) == 1 {\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let result = match subst_apply(s1, obj_ty) {\\n          CtArray(elem) => CtArray(elem),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s1, c1)\\n      } else if name == \\\"Array::concat\\\" && Array::length(args) == 2 {\\n        let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let a_app = subst_apply(s2, a_ty)\\n        let b_app = subst_apply(s2, b_ty)\\n        let s3 = check_two_array_elems(a_app, b_app, s2, errors, \\\"Array::concat element type mismatch\\\")\\n        let result = match a_app {\\n          CtArray(elem) => CtArray(elem),\\n          _ => match b_app {\\n            CtArray(elem) => CtArray(elem),\\n            _ => CtUnknown\\n          }\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c2)\\n      } else if name == \\\"Array::slice\\\" && Array::length(args) == 3 {\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let result = match subst_apply(s3, obj_ty) {\\n          CtArray(elem) => CtArray(elem),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c3)\\n      } else if name == \\\"Array::fold\\\" && Array::length(args) == 3 {\\n        let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (fn_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let s4 = match subst_apply(s3, fn_ty) {\\n          CtFn(ptys, _, _) => if Array::length(ptys) >= 1 {\\n            check_assignable(subst_apply(s3, Array::get(ptys, 0)), subst_apply(s3, init_ty), s3, errors, \\\"Array::fold accumulator type mismatch\\\", 0 - 1)\\n          } else {\\n            s3\\n          },\\n          _ => s3\\n        }\\n        let s5 = check_hof_param_vs_elem(subst_apply(s4, recv_ty), subst_apply(s4, fn_ty), 1, s4, errors, \\\"Array::fold element parameter type mismatch\\\")\\n        (tab_call_ty(tytab, call_off, subst_apply(s5, init_ty)), s5, c3)\\n      } else if name == \\\"Array::map\\\" && Array::length(args) == 2 {\\n        let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (fn_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = check_hof_param_vs_elem(subst_apply(s2, recv_ty), subst_apply(s2, fn_ty), 0, s2, errors, \\\"Array::map function parameter type mismatch\\\")\\n        let result = match subst_apply(s3, fn_ty) {\\n          CtFn(_, ret, _) => CtArray(ret),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c2)\\n      } else {\\n        match direct_call_return(env, name) {\\n          Some(ret_ty) => {\\n            let alen = Array::length(args)\\n            let want_head = builtin_first_arg_head(name)\\n            let mut ai = 0\\n            let mut s2 = s\\n            let mut c2 = c\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              if ai == 0 && want_head != 0 {\\n                let got_head = head_kind(subst_apply(s2, at))\\n                if got_head != 0 && got_head != want_head {\\n                  Array::push(errors, String::concat(String::concat(\\\"argument type mismatch for \\\", String::concat(name, \\\": receiver type \\\")), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\\n                } else {\\n                  ()\\n                }\\n              } else if ai >= 1 {\\n                let want_rest = builtin_arg_head_rest(name, ai)\\n                if want_rest != 0 {\\n                  let got_head = head_kind(subst_apply(s2, at))\\n                  if got_head != 0 && got_head != want_rest {\\n                    Array::push(errors, String::concat(String::concat(\\\"argument type mismatch for \\\", String::concat(name, String::concat(\\\" (arg \\\", String::concat(__to_string(ai), \\\"): \\\")))), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\\n                  } else {\\n                    ()\\n                  }\\n                } else {\\n                  ()\\n                }\\n              } else {\\n                ()\\n              }\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\\n          },\\n          None => {\\n            let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)\\n            let alen = Array::length(args)\\n            let arg_tys = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            let mut s2 = s1\\n            let mut c2 = c1\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              Array::push(arg_tys, at)\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(name, String::concat(\\\": expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              other => {\\n                let not_callable = match other {\\n                  CtInt => true,\\n                  CtDouble => true,\\n                  CtBool => true,\\n                  CtString => true,\\n                  CtChar => true,\\n                  CtUnit => true,\\n                  CtBytes => true,\\n                  CtTuple(_) => true,\\n                  CtArray(_) => true,\\n                  CtOption(_) => true,\\n                  CtEnum(_) => true,\\n                  _ => false\\n                }\\n                if not_callable {\\n                  Array::push(errors, String::concat(String::concat(\\\"calling a non-function value: \\\", name), off_marker_len(callee_off, String::length(name))))\\n                } else {\\n                  ()\\n                }\\n                (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n              }\\n            }\\n          }\\n        }\\n        }\\n      },\\n      EDot(obj, method, _) => {\\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\\n        let resolved = subst_apply(s1, obj_ty)\\n        let type_prefix = type_name_prefix(resolved)\\n        let qualified = String::concat(type_prefix, String::concat(\\\"::\\\", method))\\n        let direct_ret = direct_call_return(env, qualified)\\n        let method_ty = match env_lookup(env, qualified) {\\n          Some(t) => {\\n            let (ti, c2, _) = instantiate(t, c1)\\n            (ti, s1, c2)\\n          },\\n          None => match lookup_builtin(qualified) {\\n            Some(t) => (t, s1, c1),\\n            None => (CtUnknown, s1, c1)\\n          }\\n        }\\n        let (mt, s2, c2) = method_ty\\n        let all_args = prepend_expr(obj, args)\\n        let alen = Array::length(all_args)\\n        let arg_tys = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        Array::push(arg_tys, obj_ty)\\n        let mut ai = 1\\n        let mut s3 = s2\\n        let mut c3 = c2\\n        while ai < alen {\\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)\\n          Array::push(arg_tys, at)\\n          s3 = ns\\n          c3 = nc\\n          ai = ai + 1\\n        }\\n        let applied_method_ty = match mt {\\n          CtFn(_, _, _) => mt,\\n          _ => subst_apply(s3, mt)\\n        }\\n        match applied_method_ty {\\n          CtFn(param_tys, ret, _) => {\\n            let ret_box = Array::slice([\\n              ret\\n            ], 0, 1)\\n            let call_param_tys = param_tys\\n            let plen = Array::length(param_tys)\\n            let alen2 = Array::length(arg_tys)\\n            if alen2 != plen {\\n              Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(qualified, String::concat(\\\": expected \\\", String::concat(__to_string(plen), String::concat(\\\" args, got \\\", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))\\n            }\\n            let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)\\n            let call_ret = Array::get(ret_box, 0)\\n            let selected_ret = match direct_ret {\\n              Some(t) => t,\\n              None => call_ret\\n            }\\n            (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)\\n          },\\n          _ => {\\n            let field_fn = match subst_apply(s3, obj_ty) {\\n              CtStruct(sname) => struct_field_type(defs, sname, method),\\n              _ => None\\n            }\\n            match field_fn {\\n              Some(CtFn(fpts, fret, _)) => {\\n                let explicit = Array::slice(arg_tys, 1, Array::length(arg_tys))\\n                if Array::length(fpts) != Array::length(explicit) {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(qualified, String::concat(\\\": expected \\\", String::concat(__to_string(Array::length(fpts)), String::concat(\\\" args, got \\\", __to_string(Array::length(explicit))))))), off_marker_len(call_off, String::length(qualified))))\\n                }\\n                let s4 = unify_call_args(fpts, explicit, s3, errors, qualified, call_off)\\n                (tab_call_ty(tytab, call_off, subst_apply(s4, fret)), s4, c3)\\n              },\\n              _ => match direct_ret {\\n                Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),\\n                None => (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)\\n              }\\n            }\\n          }\\n        }\\n      },\\n      _ => {\\n        let callee_name0 = expr_ident_name_or_empty(callee)\\n        if callee_name0 != \\\"\\\" {\\n          match direct_call_return(env, callee_name0) {\\n            Some(ret_ty) => {\\n              let alen = Array::length(args)\\n              let mut ai = 0\\n              let mut s2 = s\\n              let mut c2 = c\\n              while ai < alen {\\n                let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n                s2 = ns\\n                c2 = nc\\n                ai = ai + 1\\n              }\\n              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\\n            },\\n            None => {\\n              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\\n              let alen = Array::length(args)\\n              let arg_tys = Array::slice([\\n                CtUnknown\\n              ], 0, 0)\\n              let mut ai = 0\\n              let mut s2 = s1\\n              let mut c2 = c1\\n              while ai < alen {\\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n                Array::push(arg_tys, at)\\n                s2 = ns\\n                c2 = nc\\n                ai = ai + 1\\n              }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(callee_name0, String::concat(\\\": expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n            }\\n            }\\n          }\\n        } else {\\n            let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\\n            let alen = Array::length(args)\\n            let arg_tys = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            let mut s2 = s1\\n            let mut c2 = c1\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              Array::push(arg_tys, at)\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for <expr>: expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))), off_marker(call_off)))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, \\\"<expr>\\\", call_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n            }\\n        }\\n      }\\n    },\\n    EBinOp(op, left, right) => {\\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)\\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)\\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)\\n      (subst_apply(s3, result_ty), s3, c2)\\n    },\\n    EUnaryOp(op, operand) => {\\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)\\n      if op == \\\"!\\\" {\\n        match subst_apply(s1, operand_ty) {\\n          CtBool => (CtBool, s1, c1),\\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\\n            Some(s2) => (CtBool, s2, c1),\\n            None => (CtUnknown, s1, c1)\\n          },\\n          other => {\\n            let flag = match other {\\n              CtUnknown => false,\\n              _ => type_is_ground(other)\\n            }\\n            if flag {\\n              Array::push(errors, \\\"operand of `!` must be Bool\\\")\\n            } else {\\n              ()\\n            }\\n            (CtUnknown, s1, c1)\\n          }\\n        }\\n      } else if op == \\\"-\\\" {\\n        match subst_apply(s1, operand_ty) {\\n          CtDouble => (CtDouble, s1, c1),\\n          CtInt => (CtInt, s1, c1),\\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\\n            Some(s2) => (CtInt, s2, c1),\\n            None => (CtUnknown, s1, c1)\\n          },\\n          other => {\\n            let flag = match other {\\n              CtUnknown => false,\\n              _ => type_is_ground(other)\\n            }\\n            if flag {\\n              Array::push(errors, \\\"operand of unary `-` must be Int or Double\\\")\\n            } else {\\n              ()\\n            }\\n            (CtUnknown, s1, c1)\\n          }\\n        }\\n      } else (CtUnknown, s1, c1)\\n    },\\n    EAssign(name, val, body) => {\\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\\n      let s1b = match env_lookup(env, name) {\\n        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat(\\\"assignment type mismatch for \\\", name), 0 - 1),\\n        None => s1\\n      }\\n      check_expr(body, env, defs, s1b, c1, errors, tytab)\\n    },\\n    EAssignOp(_, _, val, body) => {\\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\\n      check_expr(body, env, defs, s1, c1, errors, tytab)\\n    },\\n    EMatch(scrutinee, arms) => {\\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, tytab)\\n      let alen = Array::length(arms)\\n      if alen == 0 {\\n        (CtUnknown, s1, c1)\\n      }\\n      else {\\n        let mut result_ty = CtUnknown\\n        let mut check_arms = false\\n        let mut si = s1\\n        let mut ci = c1\\n        let mut ai = 0\\n        while ai < alen {\\n          let (pat, body) = Array::get(arms, ai)\\n          let arm_env = check_pattern(pat, scr_ty, env, defs, errors)\\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)\\n          si = ns\\n          ci = nc\\n          if ai == 0 {\\n            result_ty = arm_ty\\n            check_arms = match subst_apply(si, arm_ty) {\\n              CtInt => true,\\n              CtDouble => true,\\n              CtBool => true,\\n              CtString => true,\\n              CtChar => true,\\n              _ => false\\n            }\\n          } else {\\n            if check_arms {\\n              let r2 = subst_apply(si, arm_ty)\\n              si = if arm_body_diverges(body) {\\n                si\\n              } else {\\n                match r2 {\\n                  CtUnit => si,\\n                  _ => check_assignable(result_ty, r2, si, errors, \\\"match arms have incompatible types\\\", 0 - 1)\\n                }\\n              }\\n            } else {\\n              ()\\n            }\\n          }\\n          ai = ai + 1\\n        }\\n        let enum_name_opt = match subst_apply(si, scr_ty) {\\n          CtEnum(en) => Some(en),\\n          CtNamed(en, _) => Some(en),\\n          _ => None\\n        }\\n        match enum_name_opt {\\n          Some(en) => match find_typedef(defs, en) {\\n            Some(TDEnum(_, _, variants)) => {\\n              let mut has_catchall = false\\n              let covered = Array::slice([\\n                \\\"\\\"\\n              ], 0, 0)\\n              let mut ax = 0\\n              while ax < Array::length(arms) {\\n                let (apat, _) = Array::get(arms, ax)\\n                if pat_is_catchall(apat) {\\n                  has_catchall = true\\n                } else {\\n                  ()\\n                }\\n                collect_ctor_names_into(apat, covered)\\n                ax = ax + 1\\n              }\\n              if has_catchall {\\n                ()\\n              } else {\\n                let mut vi = 0\\n                while vi < Array::length(variants) {\\n                  let (vname, _) = Array::get(variants, vi)\\n                  let mut found = false\\n                  let mut ci2 = 0\\n                  while ci2 < Array::length(covered) {\\n                    if Array::get(covered, ci2) == vname {\\n                      found = true\\n                    } else {\\n                      ()\\n                    }\\n                    ci2 = ci2 + 1\\n                  }\\n                  if found {\\n                    ()\\n                  } else {\\n                    Array::push(errors, String::concat(\\\"non-exhaustive match: variant `\\\", String::concat(vname, String::concat(\\\"` of enum \\\", String::concat(en, \\\" is not handled (add it or a `_` arm)\\\")))))\\n                  }\\n                  vi = vi + 1\\n                }\\n              }\\n            },\\n            _ => ()\\n          },\\n          None => ()\\n        }\\n        (result_ty, si, ci)\\n      }\\n    },\\n    EHandle(body, _) => check_expr(body, env, defs, s, c, errors, tytab),\\n    EWhile(cond, body) => {\\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\\n      let resolved_ct = subst_apply(s1, ct)\\n      match resolved_ct {\\n        CtBool => (),\\n        CtUnknown => (),\\n        CtVar(_) => (),\\n        _ => Array::push(errors, \\\"while condition must be Bool\\\")\\n      }\\n      let (_, s2, c2) = check_expr(body, env_bind(env, \\\"__in_loop__\\\", CtUnit), defs, s1, c1, errors, tytab)\\n      (CtUnit, s2, c2)\\n    },\\n    ELoop(params, body) => {\\n      let mut env1 = env\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, init) = Array::get(params, i)\\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)\\n        env1 = env_bind(env1, name, pt)\\n        s1 = ns\\n        c1 = nc\\n        i = i + 1\\n      }\\n      let (_, s2, c2) = check_expr(body, env_bind(env1, \\\"__in_loop__\\\", CtUnit), defs, s1, c1, errors, tytab)\\n      (CtUnit, s2, c2)\\n    },\\n    EForIn(name, index_name, iterable, body) => {\\n      let real_iterable = match iterable {\\n        ECall(callee, args, _) => match callee {\\n          EIdent(nm, _) => if nm == \\\"__await_iter\\\" && Array::length(args) == 1 {\\n            Array::get(args, 0)\\n          } else iterable,\\n          _ => iterable\\n        },\\n        _ => iterable\\n      }\\n      let (it, s1, c1) = check_expr(real_iterable, env, defs, s, c, errors, tytab)\\n      let it_resolved = subst_apply(s1, it)\\n      let (et, c1b) = match it_resolved {\\n        CtArray(elem) => (elem, c1),\\n        CtNamed(nm, args) => if Array::length(args) > 0 {\\n          (Array::get(args, 0), c1)\\n        } else if nm == \\\"Stream\\\" || type_name_has_iterator_impl(env, nm) {\\n          fresh_var(c1)\\n        } else (CtUnknown, c1),\\n        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {\\n          fresh_var(c1)\\n        } else (CtUnknown, c1),\\n        other => {\\n          let flag = match other {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtUnit => true,\\n            CtChar => true,\\n            _ => false\\n          }\\n          if flag {\\n            Array::push(errors, \\\"for loop requires an iterable (Array or iterator)\\\")\\n          } else {\\n            ()\\n          }\\n          (CtUnknown, c1)\\n        }\\n      }\\n      let env2 = env_bind(env, name, et)\\n      let env3 = match index_name {\\n        Some(index_name) => env_bind(env2, index_name, CtInt),\\n        None => env2\\n      }\\n      let (bt, s2, c2) = check_expr(body, env_bind(env3, \\\"__in_loop__\\\", CtUnit), defs, s1, c1b, errors, tytab)\\n      (CtArray(bt), s2, c2)\\n    },\\n    EDot(obj, field, dot_off) => {\\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\\n      let resolved = subst_apply(s1, obj_ty)\\n      let field_ty = match resolved {\\n        CtStruct(sname) => match find_typedef(defs, sname) {\\n          Some(td) => match td {\\n            TDStruct(_, fields, _) => {\\n              let rec find_field: (Int) -> Option[Type] = (i) -> {\\n                if i >= Array::length(fields) {\\n                  None\\n                } else {\\n                  let (fname, ftype) = Array::get(fields, i)\\n                  if fname == field {\\n                    Some(ftype)\\n                  } else find_field(i + 1)\\n                }\\n              }\\n              match find_field(0) {\\n                Some(ft) => ft,\\n                None => {\\n                  Array::push(errors, String::concat(String::concat(\\\"unknown field '\\\", String::concat(field, String::concat(\\\"' on struct \\\", sname))), off_marker(dot_off)))\\n                  CtUnknown\\n                }\\n              }\\n            },\\n            _ => CtUnknown\\n          },\\n          None => CtUnknown\\n        },\\n        CtTuple(elems) => match parse_tuple_index(field) {\\n          Some(idx) => if idx >= 0 && idx < Array::length(elems) {\\n            Array::get(elems, idx)\\n          } else {\\n            Array::push(errors, String::concat(String::concat(\\\"tuple index \\\", String::concat(field, String::concat(\\\" out of range for a \\\", String::concat(__to_string(Array::length(elems)), \\\"-tuple\\\")))), off_marker(dot_off)))\\n            CtUnknown\\n          },\\n          None => CtUnknown\\n        },\\n        other => {\\n          let not_struct = match other {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtOption(_) => true,\\n            CtFn(_, _, _) => true,\\n            _ => false\\n          }\\n          if not_struct {\\n            Array::push(errors, String::concat(String::concat(\\\"field access `.\\\", String::concat(field, \\\"` on a non-struct value\\\")), off_marker(dot_off)))\\n          } else {\\n            ()\\n          }\\n          CtUnknown\\n        }\\n      }\\n      if dot_off >= 0 {\\n        Array::push(tytab, (dot_off, field_ty))\\n      } else {\\n        ()\\n      }\\n      (field_ty, s1, c1)\\n    },\\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\\n      let tplen = Array::length(tparams)\\n      let mut tp_env = env\\n      let mut s0 = s\\n      let mut c0 = c\\n      let mut tpi = 0\\n      while tpi < tplen {\\n        let tpname = Array::get(tparams, tpi)\\n        match fresh_var(c0) {\\n          (tv, nc) => {\\n            let vid = nc - 1\\n            let tblen = Array::length(tbounds)\\n            let mut bounds = Array::slice([\\n              \\\"\\\"\\n            ], 0, 0)\\n            let mut tbi = 0\\n            let mut found_bounds = false\\n            while tbi < tblen {\\n              let (bname, blist) = Array::get(tbounds, tbi)\\n              if !found_bounds && bname == tpname {\\n                bounds = blist\\n                found_bounds = true\\n              }\\n              tbi = tbi + 1\\n            }\\n            s0 = if Array::length(bounds) == 0 {\\n              s0\\n            } else subst_add_bound(s0, vid, bounds)\\n            tp_env = env_bind(tp_env, tpname, tv)\\n            c0 = nc\\n          },\\n          _ => ()\\n        }\\n        tpi = tpi + 1\\n      }\\n      let plen = Array::length(params)\\n      let mut fn_env = tp_env\\n      let mut s1 = s0\\n      let mut c1 = c0\\n      let param_types = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut pi = 0\\n      while pi < plen {\\n        let (raw_name, ann) = Array::get(params, pi)\\n        let nlen = String::length(raw_name)\\n        let name = if nlen > 0 {\\n          let lc = String::char_code_at(raw_name, nlen - 1)\\n          if lc == '~' || lc == '?' {\\n            raw_name[0: nlen - 1]\\n          } else raw_name\\n        } else raw_name\\n        let (pt, ns, nc) = match ann {\\n          Some(te) => {\\n            let resolved = resolve_type_expr(te, defs)\\n            let pt2 = resolve_tparams_in(resolved, fn_env)\\n            (pt2, s1, c1)\\n          },\\n          None => {\\n            let (tv, nc2) = fresh_var(c1)\\n            (tv, s1, nc2)\\n          }\\n        }\\n        fn_env = env_bind(fn_env, name, pt)\\n        Array::push(param_types, pt)\\n        s1 = ns\\n        c1 = nc\\n        pi = pi + 1\\n      }\\n      let body_env = match ret_ty {\\n        Some(rte) => env_bind(fn_env, \\\"__return__\\\", resolve_tparams_in(resolve_type_expr(rte, defs), fn_env)),\\n        None => fn_env\\n      }\\n      let (bt, s2, c2) = check_expr(body, body_env, defs, s1, c1, errors, tytab)\\n      let (final_ret, s3) = match ret_ty {\\n        Some(te) => {\\n          let resolved = resolve_type_expr(te, defs)\\n          let resolved_ret = resolve_tparams_in(resolved, fn_env)\\n          match unify(bt, resolved_ret, s2) {\\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\\n            None => {\\n              Array::push(errors, String::concat(\\\"return type mismatch: expected \\\", String::concat(type_to_string(resolved_ret), String::concat(\\\", got \\\", type_to_string(bt)))))\\n              (CtUnknown, s2)\\n            }\\n          }\\n        },\\n        None => (subst_apply(s2, bt), s2)\\n      }\\n      (CtFn(param_types, final_ret, effect), s3, c2)\\n    },\\n    EBreak(opt) => {\\n      match env_lookup(env, \\\"__in_loop__\\\") {\\n        Some(_) => (),\\n        None => Array::push(errors, \\\"`break` outside a loop\\\")\\n      }\\n      match opt {\\n        Some(e) => {\\n          let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\\n          (CtUnit, s1, c1)\\n        },\\n        None => (CtUnit, s, c)\\n      }\\n    },\\n    EContinue(args) => {\\n      match env_lookup(env, \\\"__in_loop__\\\") {\\n        Some(_) => (),\\n        None => Array::push(errors, \\\"`continue` outside a loop\\\")\\n      }\\n      let alen = Array::length(args)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut ai = 0\\n      while ai < alen {\\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        ai = ai + 1\\n      }\\n      (CtUnit, s1, c1)\\n    },\\n    ERecord(fields) => {\\n      let flen = Array::length(fields)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let field_tys = Array::slice([\\n        (\\\"\\\", CtUnknown)\\n      ], 0, 0)\\n      let mut fi = 0\\n      while fi < flen {\\n        let (fname, fval) = Array::get(fields, fi)\\n        let mut dj = 0\\n        let mut dup = false\\n        while dj < Array::length(field_tys) {\\n          let (pn, _) = Array::get(field_tys, dj)\\n          if pn == fname {\\n            dup = true\\n          } else {\\n            ()\\n          }\\n          dj = dj + 1\\n        }\\n        if dup {\\n          Array::push(errors, String::concat(\\\"duplicate field `\\\", String::concat(fname, \\\"` in record literal\\\")))\\n        } else {\\n          ()\\n        }\\n        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)\\n        Array::push(field_tys, (fname, ft))\\n        s1 = ns\\n        c1 = nc\\n        fi = fi + 1\\n      }\\n      let s2 = check_record_fields(defs, field_tys, s1, errors)\\n      let rec_ty = match resolve_record_struct_name(defs, field_tys) {\\n        Some(sname) => CtStruct(sname),\\n        None => CtUnknown\\n      }\\n      (rec_ty, s2, c1)\\n    },\\n    ETuple(items) => {\\n      let ilen = Array::length(items)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let tys = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut ti = 0\\n      while ti < ilen {\\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)\\n        Array::push(tys, it)\\n        s1 = ns\\n        c1 = nc\\n        ti = ti + 1\\n      }\\n      (CtTuple(tys), s1, c1)\\n    },\\n    EArray(items) => {\\n      let ilen = Array::length(items)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut elem_ty = CtUnknown\\n      let mut check_elems = false\\n      let mut ai = 0\\n      while ai < ilen {\\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        if ai == 0 {\\n          elem_ty = it\\n          check_elems = match subst_apply(s1, it) {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtArray(inner) => match inner {\\n              CtInt => true,\\n              CtDouble => true,\\n              CtBool => true,\\n              CtString => true,\\n              CtChar => true,\\n              _ => false\\n            },\\n            _ => false\\n          }\\n        } else {\\n          if check_elems {\\n            s1 = check_assignable(elem_ty, subst_apply(s1, it), s1, errors, \\\"array elements have incompatible types\\\", 0 - 1)\\n          } else {\\n            ()\\n          }\\n        }\\n        ai = ai + 1\\n      }\\n      (CtArray(elem_ty), s1, c1)\\n    },\\n    EReturn(e) => {\\n      let (et, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\\n      match env_lookup(env, \\\"__return__\\\") {\\n        Some(rt) => {\\n          let _ = check_assignable(subst_apply(s1, rt), subst_apply(s1, et), s1, errors, \\\"return type mismatch\\\", 0 - 1)\\n          ()\\n        },\\n        None => ()\\n      }\\n      (et, s1, c1)\\n    },\\n    _ => (CtUnknown, s, c)\\n  }\\n}\\n\\n\\n\\nexport {\\n  check_expr\\n}\\n\\n\\n\\nexport {\\n  lookup_builtin\\n}\\n\\n\\n\\n\\n\\n\\nexport enum EffectError {\\n  EEThrowOutsideEffect(String);\\n  EEEffectfulCallOutsideEffect(String);\\n  EEPerformUndeclaredEffect(String, String);\\n  EEAssignImmutable(String)\\n}\\n\\n\\nlet is_effectful_type: (Type) -> Bool = (ty) -> {\\n  match ty {\\n    CtFn(_, _, Some(_)) => true,\\n    _ => false\\n  }\\n}\\n\\nlet is_effectful_name: (String, TypeEnv) -> Bool = (name, env) -> {\\n  match env_lookup(env, name) {\\n    Some(ty) => is_effectful_type(ty),\\n    None => {\\n      let normalized = canonical_builtin_name(name)\\n      match lookup_builtin(normalized) {\\n        Some(ty) => is_effectful_type(ty),\\n        None => false\\n      }\\n    }\\n  }\\n}\\n\\nexport let rec check_effects_expr: (Expr, TypeEnv, Bool) -> Array[EffectError] = (expr, env, in_effect) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    EThrow(_) => {\\n      if !in_effect {\\n        Array::push(errors, EEThrowOutsideEffect(\\\"throw\\\"))\\n      }\\n      errors\\n    },\\n    EHandle(body, arms) => {\\n      let body_errs = check_effects_expr(body, env, true)\\n      let mut i = 0\\n      while i < Array::length(body_errs) {\\n        Array::push(errors, Array::get(body_errs, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        let arm_errs = check_effects_expr(arm_body, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(arm_errs) {\\n          Array::push(errors, Array::get(arm_errs, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(name, _) => if !in_effect && is_effectful_name(name, env) {\\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\\n        }\\n        ,\\n        _ => ()\\n      }\\n      let ce = check_effects_expr(callee, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        let ae = check_effects_expr(Array::get(args, ai), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ae) {\\n          Array::push(errors, Array::get(ae, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, _, _, effect, body) => {\\n      let fn_in_effect = match effect {\\n        Some(_) => true,\\n        None => false\\n      }\\n      let body_errs = check_effects_expr(body, env, fn_in_effect)\\n      let mut i = 0\\n      while i < Array::length(body_errs) {\\n        Array::push(errors, Array::get(body_errs, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELetMut(_, val, body) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      let ae = check_effects_expr(a, env, in_effect)\\n      let be = check_effects_expr(b, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ae) {\\n        Array::push(errors, Array::get(ae, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      let ce = check_effects_expr(cond, env, in_effect)\\n      let te = check_effects_expr(then_e, env, in_effect)\\n      let ee = check_effects_expr(else_e, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(te) {\\n        Array::push(errors, Array::get(te, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ee) {\\n        Array::push(errors, Array::get(ee, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      let se = check_effects_expr(scrutinee, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(se) {\\n        Array::push(errors, Array::get(se, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        let ae = check_effects_expr(arm_body, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ae) {\\n          Array::push(errors, Array::get(ae, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      let ce = check_effects_expr(cond, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        let pe = check_effects_expr(init, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(pe) {\\n          Array::push(errors, Array::get(pe, j))\\n          j = j + 1\\n        }\\n        i = i + 1\\n      }\\n      let be = check_effects_expr(body, env, in_effect)\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EForIn(_, _, iter, body) => {\\n      let ie = check_effects_expr(iter, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ie) {\\n        Array::push(errors, Array::get(ie, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      let le = check_effects_expr(left, env, in_effect)\\n      let re = check_effects_expr(right, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(le) {\\n        Array::push(errors, Array::get(le, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(re) {\\n        Array::push(errors, Array::get(re, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EReturn(e) => check_effects_expr(e, env, in_effect),\\n    EUnaryOp(_, operand) => check_effects_expr(operand, env, in_effect),\\n    EAssign(_, val, cont) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let ce = check_effects_expr(cont, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EAssignOp(_, _, val, cont) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let ce = check_effects_expr(cont, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EDot(obj, _, _) => check_effects_expr(obj, env, in_effect),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ee) {\\n          Array::push(errors, Array::get(ee, j))\\n          j = j + 1\\n        }\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ee) {\\n          Array::push(errors, Array::get(ee, j))\\n          j = j + 1\\n        }\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(fields) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        let fe = check_effects_expr(fval, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(fe) {\\n          Array::push(errors, Array::get(fe, j))\\n          j = j + 1\\n        }\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\nexport let check_effects_stmt: (Stmt, TypeEnv) -> Array[EffectError] = (stmt, env) -> {\\n  match stmt {\\n    SLet(_, _, _, _, body) => check_effects_expr(body, env, false),\\n    SLetMut(_, _, body) => check_effects_expr(body, env, false),\\n    STest(_, body) => check_effects_expr(body, env, false),\\n    SBench(_, body) => check_effects_expr(body, env, false),\\n    SExpr(e) => check_effects_expr(e, env, false),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\nexport let check_effects_stmts: (Array[Stmt], TypeEnv) -> Array[EffectError] = (stmts, env) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let se = check_effects_stmt(Array::get(stmts, i), env)\\n    let mut j = 0\\n    while j < Array::length(se) {\\n      Array::push(errors, Array::get(se, j))\\n      j = j + 1\\n    }\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\nexport let effect_error_to_string: (EffectError) -> String = (err) -> {\\n  match err {\\n    EEThrowOutsideEffect(msg) => String::concat(\\\"throw outside effectful context: \\\", msg),\\n    EEEffectfulCallOutsideEffect(name) => String::concat(\\\"effectful call outside effectful context: \\\", name),\\n    EEPerformUndeclaredEffect(op, eff) => String::concat(\\\"use of undeclared effect `\\\", String::concat(eff, String::concat(\\\"` (\\\", String::concat(op, \\\"); add it to the function's `with { ... }` or wrap in a `handle`\\\")))),\\n    EEAssignImmutable(name) => String::concat(\\\"cannot assign to immutable binding `\\\", String::concat(name, \\\"` (declare it with `let mut`)\\\"))\\n  }\\n}\\n\\n\\nlet effect_opt_is_async: (Option[String]) -> Bool = (eff) -> {\\n  match eff {\\n    Some(s) => String::contains(s, \\\"Async\\\"),\\n    None => false\\n  }\\n}\\n\\nlet is_async_primitive: (String, TypeEnv) -> Bool = (name, env) -> {\\n  match env_lookup(env, name) {\\n    Some(_) => false,\\n    None => {\\n      let normalized = canonical_builtin_name(name)\\n      match lookup_builtin(normalized) {\\n        Some(ty) => match ty {\\n          CtFn(_, _, eff) => effect_opt_is_async(eff),\\n          _ => false\\n        },\\n        None => false\\n      }\\n    }\\n  }\\n}\\n\\nlet append_eff_errs: (Array[EffectError], Array[EffectError]) -> Unit = (dst, src) -> {\\n  let mut i = 0\\n  while i < Array::length(src) {\\n    Array::push(dst, Array::get(src, i))\\n    i = i + 1\\n  }\\n}\\n\\nexport let rec check_async_effects_expr: (Expr, TypeEnv, Bool) -> Array[EffectError] = (expr, env, in_async) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(name, _) => if !in_async && is_async_primitive(name, env) {\\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\\n        }\\n        ,\\n        _ => ()\\n      }\\n      append_eff_errs(errors, check_async_effects_expr(callee, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(args, ai), env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, _, _, effect, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(body, env, effect_opt_is_async(effect)))\\n      errors\\n    },\\n    EHandle(body, arms) => {\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELetMut(_, val, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      append_eff_errs(errors, check_async_effects_expr(a, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(b, env, in_async))\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(then_e, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(else_e, env, in_async))\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      append_eff_errs(errors, check_async_effects_expr(scrutinee, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        append_eff_errs(errors, check_async_effects_expr(init, env, in_async))\\n        i = i + 1\\n      }\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    EForIn(_, _, iter, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(iter, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      append_eff_errs(errors, check_async_effects_expr(left, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(right, env, in_async))\\n      errors\\n    },\\n    EReturn(e) => check_async_effects_expr(e, env, in_async),\\n    EUnaryOp(_, operand) => check_async_effects_expr(operand, env, in_async),\\n    EThrow(e) => check_async_effects_expr(e, env, in_async),\\n    EAssign(_, val, cont) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\\n      errors\\n    },\\n    EAssignOp(_, _, val, cont) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\\n      errors\\n    },\\n    EDot(obj, _, _) => check_async_effects_expr(obj, env, in_async),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(fields) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        append_eff_errs(errors, check_async_effects_expr(fval, env, in_async))\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\nlet sig_type_is_async: (Option[TypeExpr]) -> Bool = (topt) -> {\\n  match topt {\\n    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),\\n    _ => false\\n  }\\n}\\n\\nlet check_async_effects_binding: (Option[TypeExpr], Expr, TypeEnv) -> Array[EffectError] = (ty, body, env) -> {\\n  let sig_async = sig_type_is_async(ty)\\n  match body {\\n    EFn(_, _, _, _, eff, fbody) => check_async_effects_expr(fbody, env, sig_async || effect_opt_is_async(eff)),\\n    _ => check_async_effects_expr(body, env, sig_async)\\n  }\\n}\\n\\nexport let check_async_effects_stmt: (Stmt, TypeEnv) -> Array[EffectError] = (stmt, env) -> {\\n  match stmt {\\n    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),\\n    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),\\n    STest(_, body) => check_async_effects_expr(body, env, false),\\n    SBench(_, body) => check_async_effects_expr(body, env, false),\\n    SExpr(e) => check_async_effects_expr(e, env, false),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\nexport let check_async_effects_stmts: (Array[Stmt], TypeEnv) -> Array[EffectError] = (stmts, env) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\n\\nlet effect_decl_labels: (Option[String]) -> Array[String] = (eff) -> {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  match eff {\\n    None => out,\\n    Some(s) => {\\n      let raw = String::split(s, \\\",\\\")\\n      let mut i = 0\\n      while i < Array::length(raw) {\\n        let label = String::trim(Array::get(raw, i))\\n        if String::length(label) > 0 {\\n          let mut seen = false\\n          let mut j = 0\\n          while j < Array::length(out) {\\n            if Array::get(out, j) == label {\\n              seen = true\\n            }\\n            j = j + 1\\n          }\\n          if !seen {\\n            Array::push(out, label)\\n          }\\n        }\\n        i = i + 1\\n      }\\n      out\\n    }\\n  }\\n}\\n\\nlet label_is_effect_var: (String) -> Bool = (name) -> {\\n  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\\n}\\n\\nlet decl_authorizes_effect: (Array[String], String) -> Bool = (labels, eff_name) -> {\\n  let mut i = 0\\n  let mut ok = false\\n  while i < Array::length(labels) {\\n    let l = Array::get(labels, i)\\n    if l == eff_name {\\n      ok = true\\n    } else if label_is_effect_var(l) {\\n      ok = true\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\nlet effect_name_of_op: (String) -> String = (op_name) -> {\\n  let idx = String::index_of(op_name, \\\"::\\\")\\n  if idx > 0 {\\n    op_name[0:idx]\\n  } else {\\n    op_name\\n  }\\n}\\n\\nlet builtin_call_effect: (String) -> Option[String] = (name) -> {\\n  if String::index_of(name, \\\"::\\\") < 0 {\\n    None\\n  } else {\\n    let normalized = canonical_builtin_name(name)\\n    match lookup_builtin(normalized) {\\n      Some(ty) => match ty {\\n        CtFn(_, _, Some(eff)) => if eff == \\\"Error\\\" {\\n          None\\n        } else if eff == \\\"Async\\\" {\\n          None\\n        } else {\\n          Some(eff)\\n        },\\n        _ => None\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\nlet labels_union: (Array[String], Array[String]) -> Array[String] = (a, b) -> {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(a) {\\n    Array::push(out, Array::get(a, i))\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(b) {\\n    let l = Array::get(b, j)\\n    let mut seen = false\\n    let mut k = 0\\n    while k < Array::length(out) {\\n      if Array::get(out, k) == l {\\n        seen = true\\n      }\\n      k = k + 1\\n    }\\n    if !seen {\\n      Array::push(out, l)\\n    }\\n    j = j + 1\\n  }\\n  out\\n}\\n\\nlet collect_handle_effects: (Array[(Pat, Expr)]) -> Array[String] = (arms) -> {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (pat, _) = Array::get(arms, i)\\n    match pat {\\n      PCtor(name, _) => {\\n        let idx = String::index_of(name, \\\"::\\\")\\n        if idx > 0 {\\n          let eff = name[0:idx]\\n          let mut seen = false\\n          let mut j = 0\\n          while j < Array::length(out) {\\n            if Array::get(out, j) == eff {\\n              seen = true\\n            }\\n            j = j + 1\\n          }\\n          if !seen {\\n            Array::push(out, eff)\\n          }\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet fn_binding_effects: (Option[TypeExpr], Expr) -> Array[String] = (ty, body) -> {\\n  let sig = sig_type_effect_labels(ty)\\n  match body {\\n    EFn(_, _, _, _, eff, _) => labels_union(sig, effect_decl_labels(eff)),\\n    _ => sig\\n  }\\n}\\n\\nlet lookup_fn_effs: (Array[String], Array[Array[String]], String) -> Option[Array[String]] = (names, effs, name) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(names) {\\n    match found {\\n      None => if Array::get(names, i) == name {\\n        found = Some(Array::get(effs, i))\\n      } else {\\n        ()\\n      },\\n      Some(_) => ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nexport let check_perform_effects_expr_tx: (Expr, Array[String], Bool, Array[String], Array[Array[String]]) -> Array[EffectError] = (root, root_declared, root_in_handle, fn_names, fn_effs) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let stack = Array::slice([\\n    (root, root_declared, root_in_handle)\\n  ], 0, 1)\\n  while Array::length(stack) > 0 {\\n    let n = Array::length(stack)\\n    let (expr, declared, in_handle) = Array::get(stack, n - 1)\\n    Array::truncate(stack, n - 1)\\n    match expr {\\n      ECall(callee, args, _) => {\\n        match callee {\\n          EIdent(name, _) => {\\n            if name == \\\"perform\\\" && Array::length(args) == 1 {\\n              match Array::get(args, 0) {\\n                ECall(op_callee, _, _) => match op_callee {\\n                  EIdent(op_name, _) => {\\n                    let eff = effect_name_of_op(op_name)\\n                    if !in_handle && !decl_authorizes_effect(declared, eff) {\\n                      Array::push(errors, EEPerformUndeclaredEffect(op_name, eff))\\n                    } else {\\n                      ()\\n                    }\\n                  },\\n                  _ => ()\\n                },\\n                _ => ()\\n              }\\n            } else {\\n              match builtin_call_effect(name) {\\n                Some(eff) => if !in_handle && !decl_authorizes_effect(declared, eff) {\\n                  Array::push(errors, EEPerformUndeclaredEffect(name, eff))\\n                } else {\\n                  ()\\n                },\\n                None => ()\\n              }\\n            }\\n            match lookup_fn_effs(fn_names, fn_effs, name) {\\n              Some(callee_effs) => {\\n                let mut ti = 0\\n                while ti < Array::length(callee_effs) {\\n                  let teff = Array::get(callee_effs, ti)\\n                  if String::length(teff) > 0 && teff != \\\"Error\\\" && teff != \\\"Async\\\" && !label_is_effect_var(teff) && !in_handle && !decl_authorizes_effect(declared, teff) {\\n                    Array::push(errors, EEPerformUndeclaredEffect(name, teff))\\n                  } else {\\n                    ()\\n                  }\\n                  ti = ti + 1\\n                }\\n              },\\n              None => ()\\n            }\\n          },\\n          _ => ()\\n        }\\n        Array::push(stack, (callee, declared, in_handle))\\n        let mut ai = 0\\n        while ai < Array::length(args) {\\n          Array::push(stack, (Array::get(args, ai), declared, in_handle))\\n          ai = ai + 1\\n        }\\n      },\\n      EFn(_, _, _, _, effect, body) => {\\n        Array::push(stack, (body, effect_decl_labels(effect), false))\\n      },\\n      EHandle(body, arms) => {\\n        let discharged = collect_handle_effects(arms)\\n        let body_declared = labels_union(declared, discharged)\\n        let body_in_handle = if Array::length(discharged) == 0 {\\n          true\\n        } else {\\n          in_handle\\n        }\\n        Array::push(stack, (body, body_declared, body_in_handle))\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (_, arm_body) = Array::get(arms, ai)\\n          Array::push(stack, (arm_body, declared, in_handle))\\n          ai = ai + 1\\n        }\\n      },\\n      ELet(_, val, body) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      ELetRec(_, val, body) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      ELetMut(_, val, body) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      ESeq(a, b) => {\\n        Array::push(stack, (a, declared, in_handle))\\n        Array::push(stack, (b, declared, in_handle))\\n      },\\n      EIf(cond, then_e, else_e) => {\\n        Array::push(stack, (cond, declared, in_handle))\\n        Array::push(stack, (then_e, declared, in_handle))\\n        Array::push(stack, (else_e, declared, in_handle))\\n      },\\n      EMatch(scrutinee, arms) => {\\n        Array::push(stack, (scrutinee, declared, in_handle))\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (_, arm_body) = Array::get(arms, ai)\\n          Array::push(stack, (arm_body, declared, in_handle))\\n          ai = ai + 1\\n        }\\n      },\\n      EWhile(cond, body) => {\\n        Array::push(stack, (cond, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      ELoop(params, body) => {\\n        let mut i = 0\\n        while i < Array::length(params) {\\n          let (_, init) = Array::get(params, i)\\n          Array::push(stack, (init, declared, in_handle))\\n          i = i + 1\\n        }\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      EForIn(_, _, iter, body) => {\\n        Array::push(stack, (iter, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      EBinOp(_, left, right) => {\\n        Array::push(stack, (left, declared, in_handle))\\n        Array::push(stack, (right, declared, in_handle))\\n      },\\n      EReturn(e) => Array::push(stack, (e, declared, in_handle)),\\n      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle)),\\n      EThrow(e) => Array::push(stack, (e, declared, in_handle)),\\n      EAssign(_, val, cont) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (cont, declared, in_handle))\\n      },\\n      EAssignOp(_, _, val, cont) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (cont, declared, in_handle))\\n      },\\n      EDot(obj, _, _) => Array::push(stack, (obj, declared, in_handle)),\\n      ETuple(elems) => {\\n        let mut ei = 0\\n        while ei < Array::length(elems) {\\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle))\\n          ei = ei + 1\\n        }\\n      },\\n      EArray(elems) => {\\n        let mut ei = 0\\n        while ei < Array::length(elems) {\\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle))\\n          ei = ei + 1\\n        }\\n      },\\n      ERecord(fields) => {\\n        let mut fi = 0\\n        while fi < Array::length(fields) {\\n          let (_, fval) = Array::get(fields, fi)\\n          Array::push(stack, (fval, declared, in_handle))\\n          fi = fi + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n  }\\n  errors\\n}\\n\\nlet sig_type_effect_labels: (Option[TypeExpr]) -> Array[String] = (topt) -> {\\n  match topt {\\n    Some(TyFn(_, _, eff)) => effect_decl_labels(eff),\\n    _ => effect_decl_labels(None)\\n  }\\n}\\n\\nexport let check_perform_effects_expr: (Expr, Array[String], Bool) -> Array[EffectError] = (root, root_declared, root_in_handle) -> {\\n  check_perform_effects_expr_tx(root, root_declared, root_in_handle, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0))\\n}\\n\\nlet check_perform_effects_binding_tx: (Option[TypeExpr], Expr, Array[String], Array[Array[String]]) -> Array[EffectError] = (ty, body, fn_names, fn_effs) -> {\\n  let sig_labels = sig_type_effect_labels(ty)\\n  match body {\\n    EFn(_, _, _, _, eff, fbody) => check_perform_effects_expr_tx(fbody, labels_union(sig_labels, effect_decl_labels(eff)), false, fn_names, fn_effs),\\n    _ => check_perform_effects_expr_tx(body, sig_labels, false, fn_names, fn_effs)\\n  }\\n}\\n\\nlet check_perform_effects_stmt_tx: (Stmt, Array[String], Array[Array[String]]) -> Array[EffectError] = (stmt, fn_names, fn_effs) -> {\\n  match stmt {\\n    SLet(_, _, _, ty, body) => check_perform_effects_binding_tx(ty, body, fn_names, fn_effs),\\n    SLetMut(_, ty, body) => check_perform_effects_binding_tx(ty, body, fn_names, fn_effs),\\n    STest(_, body) => check_perform_effects_expr_tx(body, effect_decl_labels(None), false, fn_names, fn_effs),\\n    SBench(_, body) => check_perform_effects_expr_tx(body, effect_decl_labels(None), false, fn_names, fn_effs),\\n    SExpr(e) => check_perform_effects_expr_tx(e, effect_decl_labels(None), false, fn_names, fn_effs),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\nexport let check_perform_effects_stmt: (Stmt) -> Array[EffectError] = (stmt) -> {\\n  check_perform_effects_stmt_tx(stmt, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0))\\n}\\n\\nexport let check_perform_effects_stmts: (Array[Stmt]) -> Array[EffectError] = (stmts) -> {\\n  let fn_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let fn_effs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    match Array::get(stmts, m) {\\n      SLet(_, _, name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      SLetMut(name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      _ => ()\\n    }\\n    m = m + 1\\n  }\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    append_eff_errs(errors, check_perform_effects_stmt_tx(Array::get(stmts, i), fn_names, fn_effs))\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\nexport let file_tests_cacheable: (Array[Stmt]) -> Bool = (stmts) -> {\\n  let fn_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let fn_effs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    match Array::get(stmts, m) {\\n      SLet(_, _, name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      SLetMut(name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      _ => ()\\n    }\\n    m = m + 1\\n  }\\n  let empty_decl = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut any_test = false\\n  let mut all_ok = true\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STest(_, body) => {\\n        any_test = true\\n        let errs = check_perform_effects_expr_tx(body, empty_decl, false, fn_names, fn_effs)\\n        if Array::length(errs) != 0 {\\n          all_ok = false\\n        } else {\\n          ()\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  any_test && all_ok\\n}\\n\\n\\nlet mut_has: (Array[String], String) -> Bool = (xs, n) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(xs) {\\n    if Array::get(xs, i) == n {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nlet mut_with: (Array[String], String) -> Array[String] = (base, name) -> {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  Array::push(out, name)\\n  out\\n}\\n\\nlet rec collect_pat_binds_into: (Pat, Array[String]) -> Unit = (pat, acc) -> {\\n  match pat {\\n    PBind(name) => Array::push(acc, name),\\n    PCtor(_, subs) => {\\n      let mut i = 0\\n      while i < Array::length(subs) {\\n        collect_pat_binds_into(Array::get(subs, i), acc)\\n        i = i + 1\\n      }\\n    },\\n    PTuple(subs) => {\\n      let mut i = 0\\n      while i < Array::length(subs) {\\n        collect_pat_binds_into(Array::get(subs, i), acc)\\n        i = i + 1\\n      }\\n    },\\n    POr(l, r) => {\\n      collect_pat_binds_into(l, acc)\\n      collect_pat_binds_into(r, acc)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        collect_pat_binds_into(fp, acc)\\n        i = i + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nlet mut_with_pat: (Array[String], Pat) -> Array[String] = (base, pat) -> {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  collect_pat_binds_into(pat, out)\\n  out\\n}\\n\\nlet mut_with_params: (Array[String], Array[(String, Option[TypeExpr])]) -> Array[String] = (base, params) -> {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, _) = Array::get(params, i)\\n    Array::push(out, pname)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let rec check_mutability_expr: (Expr, Array[String]) -> Array[EffectError] = (expr, mutable) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    ECall(callee, args, _) => {\\n      append_eff_errs(errors, check_mutability_expr(callee, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, params, _, _, body) => {\\n      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))\\n      errors\\n    },\\n    EHandle(body, arms) => {\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (pat, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELetMut(name, val, body) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      append_eff_errs(errors, check_mutability_expr(a, mutable))\\n      append_eff_errs(errors, check_mutability_expr(b, mutable))\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\\n      append_eff_errs(errors, check_mutability_expr(then_e, mutable))\\n      append_eff_errs(errors, check_mutability_expr(else_e, mutable))\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (pat, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let loopmut = Array::slice(mutable, 0, Array::length(mutable))\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, init) = Array::get(params, i)\\n        append_eff_errs(errors, check_mutability_expr(init, mutable))\\n        Array::push(loopmut, pname)\\n        i = i + 1\\n      }\\n      append_eff_errs(errors, check_mutability_expr(body, loopmut))\\n      errors\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      append_eff_errs(errors, check_mutability_expr(iter, mutable))\\n      let base = mut_with(mutable, name)\\n      let formut = match index_name {\\n        Some(idx) => mut_with(base, idx),\\n        None => base\\n      }\\n      append_eff_errs(errors, check_mutability_expr(body, formut))\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      append_eff_errs(errors, check_mutability_expr(left, mutable))\\n      append_eff_errs(errors, check_mutability_expr(right, mutable))\\n      errors\\n    },\\n    EReturn(e) => check_mutability_expr(e, mutable),\\n    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),\\n    EThrow(e) => check_mutability_expr(e, mutable),\\n    EAssign(name, val, cont) => {\\n      if !mut_has(mutable, name) {\\n        Array::push(errors, EEAssignImmutable(name))\\n      } else {\\n        ()\\n      }\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\\n      errors\\n    },\\n    EAssignOp(name, _, val, cont) => {\\n      if !mut_has(mutable, name) {\\n        Array::push(errors, EEAssignImmutable(name))\\n      } else {\\n        ()\\n      }\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\\n      errors\\n    },\\n    EDot(obj, _, _) => check_mutability_expr(obj, mutable),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(fields) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        append_eff_errs(errors, check_mutability_expr(fval, mutable))\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    EMap(entries) => {\\n      let mut mi = 0\\n      while mi < Array::length(entries) {\\n        let (_, mval) = Array::get(entries, mi)\\n        append_eff_errs(errors, check_mutability_expr(mval, mutable))\\n        mi = mi + 1\\n      }\\n      errors\\n    },\\n    ELabeledArg(_, _, inner) => check_mutability_expr(inner, mutable),\\n    ESpread(inner) => check_mutability_expr(inner, mutable),\\n    EBreak(opt) => match opt {\\n      Some(e) => check_mutability_expr(e, mutable),\\n      None => errors\\n    },\\n    EContinue(cargs) => {\\n      let mut ci = 0\\n      while ci < Array::length(cargs) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(cargs, ci), mutable))\\n        ci = ci + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\nlet check_mutability_binding: (Expr) -> Array[EffectError] = (body) -> {\\n  match body {\\n    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), params)),\\n    _ => check_mutability_expr(body, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  }\\n}\\n\\nexport let check_mutability_stmts: (Array[Stmt]) -> Array[EffectError] = (stmts) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body)),\\n      SLetMut(_, _, body) => append_eff_errs(errors, check_mutability_binding(body)),\\n      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))),\\n      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))),\\n      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\n\\n\\n\\nlet empty_expr_array: () -> Array[Expr] = () -> {\\n  Array::slice([\\n    EUnit\\n  ], 0, 0)\\n}\\n\\nlet empty_str_array: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet empty_type_exprs: () -> Array[TypeExpr] = () -> {\\n  Array::slice([\\n    TyUnit\\n  ], 0, 0)\\n}\\n\\nlet method_names_of_sigs: (Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] = (methods) -> {\\n  let out = empty_str_array()\\n  let mut i = 0\\n  while i < Array::length(methods) {\\n    let (mname, _, _) = Array::get(methods, i)\\n    Array::push(out, mname)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet str_array_contains: (Array[String], String) -> Bool = (arr, val) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) {\\n    if Array::get(arr, i) == val {\\n      found = true\\n      i = Array::length(arr)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet split_qualified: (String) -> Option[(String, String)] = (name) -> {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    let member = String::substring(name, idx + 2, String::length(name))\\n    Some((head, member))\\n  }\\n}\\n\\nlet dict_struct_name: (String) -> String = (trait_name) -> {\\n  String::concat(trait_name, \\\"Dict\\\")\\n}\\n\\nlet dict_param_name: (String, String) -> String = (trait_name, tparam) -> {\\n  String::concat(\\\"__dict_\\\", String::concat(trait_name, String::concat(\\\"_\\\", tparam)))\\n}\\n\\nlet collect_method_traits: (Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      (\\\"\\\", empty_type_exprs(), TyUnit)\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STrait(_, tname, _, methods, _) => if Array::length(methods) > 0 {\\n        Array::push(out, (tname, methods))\\n      } else {\\n        ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n\\nlet empty_method_gens: () -> Array[(String, Array[String], Array[(String, Array[String])])] = () -> {\\n  Array::slice([\\n    (\\\"\\\", empty_str_array(), Array::slice([\\n      (\\\"\\\", empty_str_array())\\n    ], 0, 0))\\n  ], 0, 0)\\n}\\n\\nlet collect_trait_method_gens: (Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", empty_method_gens())\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STrait(_, tname, _, _, method_gens) => {\\n        let mut any = false\\n        let mut j = 0\\n        while j < Array::length(method_gens) {\\n          let (_, tps, _) = Array::get(method_gens, j)\\n          if Array::length(tps) > 0 {\\n            any = true\\n          } else {\\n            ()\\n          }\\n          j = j + 1\\n        }\\n        if any {\\n          Array::push(out, (tname, method_gens))\\n        } else {\\n          ()\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_method_gen: (Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], String, String) -> Option[(Array[String], Array[(String, Array[String])])] = (table, trait_name, method) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(table) {\\n    let (tn, gens) = Array::get(table, i)\\n    if tn == trait_name {\\n      let mut j = 0\\n      while j < Array::length(gens) {\\n        let (mname, tps, bounds) = Array::get(gens, j)\\n        if mname == method && Array::length(tps) > 0 {\\n          result = Some((tps, bounds))\\n          j = Array::length(gens)\\n        } else {\\n          j = j + 1\\n        }\\n      }\\n      i = Array::length(table)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet collect_impl_trait_map: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImpl(_, _, trait_name, type_name) => Array::push(out, (type_name, trait_name)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_trait_method_param_types: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String, String) -> Option[Array[TypeExpr]] = (traits, trait_name, method) -> {\\n  match lookup_trait_sigs(traits, trait_name) {\\n    Some(sigs) => {\\n      let mut j = 0\\n      let mut result = None\\n      while j < Array::length(sigs) {\\n        let (mname, ptypes, _) = Array::get(sigs, j)\\n        if mname == method {\\n          result = Some(ptypes)\\n          j = Array::length(sigs)\\n        } else {\\n          j = j + 1\\n        }\\n      }\\n      result\\n    },\\n    None => None\\n  }\\n}\\n\\nlet find_method_generic_for_impl: (Array[(String, String)], Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String, String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] = (impl_map, gen_table, traits, type_name, method) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(impl_map) {\\n    let (tn, trait_name) = Array::get(impl_map, i)\\n    if tn == type_name {\\n      match lookup_method_gen(gen_table, trait_name, method) {\\n        Some(g) => {\\n          let (tps, bounds) = g\\n          match lookup_trait_method_param_types(traits, trait_name, method) {\\n            Some(ptypes) => {\\n              result = Some((tps, bounds, ptypes))\\n              i = Array::length(impl_map)\\n            },\\n            None => {\\n              i = i + 1\\n            }\\n          }\\n        },\\n        None => {\\n          i = i + 1\\n        }\\n      }\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet annotate_params_from_sig: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, ptypes) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, ann) = Array::get(params, i)\\n    let new_ann = match ann {\\n      Some(_) => ann,\\n      None => if i < Array::length(ptypes) {\\n        Some(Array::get(ptypes, i))\\n      } else {\\n        None\\n      }\\n    }\\n    Array::push(out, (pname, new_ann))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet inject_method_generics: (Array[Stmt], Array[(String, String)], Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit = (stmts, impl_map, gen_table, traits) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(exp, isrec, qname, ann, body) => match body {\\n        EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {\\n          match split_qualified(qname) {\\n            Some(parts) => {\\n              let (cname, method) = parts\\n              match find_method_generic_for_impl(impl_map, gen_table, traits, cname, method) {\\n                Some(g) => {\\n                  let (mtparams, mtbounds, ptypes) = g\\n                  let new_params = annotate_params_from_sig(params, ptypes)\\n                  let new_efn = EFn(mtparams, mtbounds, new_params, ret, eff, fbody)\\n                  Array::set(stmts, i, SLet(exp, isrec, qname, ann, new_efn))\\n                },\\n                None => ()\\n              }\\n            },\\n            None => ()\\n          }\\n        } else {\\n          ()\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nlet inject_trait_method_generics_with: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit = (stmts, traits) -> {\\n  let method_gen_table = collect_trait_method_gens(stmts)\\n  if Array::length(method_gen_table) > 0 {\\n    let impl_map = collect_impl_trait_map(stmts)\\n    inject_method_generics(stmts, impl_map, method_gen_table, traits)\\n  } else {\\n    ()\\n  }\\n}\\n\\nexport let inject_trait_method_generics: (Array[Stmt]) -> Unit = (stmts) -> {\\n  let traits_raw = collect_method_traits(stmts)\\n  let supers_map = collect_trait_supers(stmts)\\n  let traits = flatten_traits(traits_raw, supers_map)\\n  inject_trait_method_generics_with(stmts, traits)\\n}\\n\\nlet collect_trait_supers: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", empty_str_array())\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STrait(_, tname, supers, _, _) => Array::push(out, (tname, supers)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_supers: (Array[(String, Array[String])], String) -> Array[String] = (supers_map, name) -> {\\n  let mut i = 0\\n  let mut result = empty_str_array()\\n  while i < Array::length(supers_map) {\\n    let (tname, supers) = Array::get(supers_map, i)\\n    if tname == name {\\n      result = supers\\n      i = Array::length(supers_map)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet rec flatten_trait_sigs_into: (String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[String], Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit = (tname, traits_raw, supers_map, acc_names, out) -> {\\n  let supers = lookup_supers(supers_map, tname)\\n  let mut s = 0\\n  while s < Array::length(supers) {\\n    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out)\\n    s = s + 1\\n  }\\n  match lookup_trait_sigs(traits_raw, tname) {\\n    Some(sigs) => {\\n      let mut i = 0\\n      while i < Array::length(sigs) {\\n        let (mname, params, ret) = Array::get(sigs, i)\\n        if str_array_contains(acc_names, mname) {\\n          ()\\n        } else {\\n          Array::push(acc_names, mname)\\n          Array::push(out, (mname, params, ret))\\n        }\\n        i = i + 1\\n      }\\n    },\\n    None => ()\\n  }\\n}\\n\\nlet flatten_traits: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (traits_raw, supers_map) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      (\\\"\\\", empty_type_exprs(), TyUnit)\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(traits_raw) {\\n    let (tname, _) = Array::get(traits_raw, i)\\n    let acc_names = empty_str_array()\\n    let flat = Array::slice([\\n      (\\\"\\\", empty_type_exprs(), TyUnit)\\n    ], 0, 0)\\n    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat)\\n    Array::push(out, (tname, flat))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_trait_sigs: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] = (traits, name) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(traits) {\\n    let (tname, sigs) = Array::get(traits, i)\\n    if tname == name {\\n      result = Some(sigs)\\n      i = Array::length(traits)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet collect_struct_field_sets: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", empty_str_array())\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, sname, fields, _, _) => {\\n        let names = empty_str_array()\\n        let mut j = 0\\n        while j < Array::length(fields) {\\n          let (fname, _) = Array::get(fields, j)\\n          Array::push(names, fname)\\n          j = j + 1\\n        }\\n        Array::push(out, (sname, names))\\n      },\\n      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet make_dict_struct_stmt: (String, Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt = (trait_name, sigs) -> {\\n  let fields = Array::slice([\\n    (\\\"\\\", TyUnit)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(sigs) {\\n    let (mname, params, ret) = Array::get(sigs, i)\\n    Array::push(fields, (mname, TyFn(params, ret, None)))\\n    i = i + 1\\n  }\\n  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array())\\n}\\n\\nlet field_sets_match: (Array[String], Array[String]) -> Bool = (a, b) -> {\\n  if Array::length(a) != Array::length(b) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while i < Array::length(a) {\\n      if str_array_contains(b, Array::get(a, i)) {\\n        i = i + 1\\n      } else {\\n        ok = false\\n        i = Array::length(a)\\n      }\\n    }\\n    ok\\n  }\\n}\\n\\nlet struct_set_has: (Array[(String, Array[String])], String) -> Bool = (struct_sets, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(struct_sets) {\\n    let (sname, _) = Array::get(struct_sets, i)\\n    if sname == name {\\n      found = true\\n      i = Array::length(struct_sets)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet lookup_var_type: (Array[(String, String)], String) -> Option[String] = (var_types, name) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(var_types) {\\n    let (vn, vt) = Array::get(var_types, i)\\n    if vn == name {\\n      result = Some(vt)\\n      i = Array::length(var_types)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet ctor_enum_of_name: (Array[(String, String)], String) -> Option[String] = (fn_returns, name) -> {\\n  match fn_return_type(fn_returns, name) {\\n    Some(t) => Some(t),\\n    None => match split_qualified(name) {\\n      Some(parts) => {\\n        let (head, member) = parts\\n        match fn_return_type(fn_returns, member) {\\n          Some(en) => if en == head {\\n            Some(en)\\n          } else {\\n            None\\n          },\\n          None => None\\n        }\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\nlet infer_arg_type_name: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Option[String] = (arg, struct_sets, var_types, fn_returns) -> {\\n  match arg {\\n    EInt(_) => Some(\\\"Int\\\"),\\n    EBool(_) => Some(\\\"Bool\\\"),\\n    EString(_) => Some(\\\"String\\\"),\\n    EFloat(_) => Some(\\\"Double\\\"),\\n    EArray(_) => Some(\\\"Array\\\"),\\n    EIdent(name, _) => if name == \\\"None\\\" {\\n      Some(\\\"Option\\\")\\n    } else {\\n      match lookup_var_type(var_types, name) {\\n        Some(t) => Some(t),\\n        None => ctor_enum_of_name(fn_returns, name)\\n      }\\n    },\\n    ECall(callee, _, _) => match callee {\\n      EIdent(\\\"Some\\\", _) => Some(\\\"Option\\\"),\\n      EIdent(\\\"Ok\\\", _) => Some(\\\"Result\\\"),\\n      EIdent(\\\"Err\\\", _) => Some(\\\"Result\\\"),\\n      EIdent(fname, _) => ctor_enum_of_name(fn_returns, fname),\\n      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {\\n        let (_, ann) = Array::get(params, 0)\\n        match ann {\\n          Some(TyName(n)) => Some(n),\\n          Some(TyApp(n, _)) => Some(n),\\n          _ => None\\n        }\\n      } else {\\n        None\\n      },\\n      _ => None\\n    },\\n    ERecord(fields) => {\\n      let names = empty_str_array()\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (fname, _) = Array::get(fields, i)\\n        Array::push(names, fname)\\n        i = i + 1\\n      }\\n      let mut j = 0\\n      let mut result = None\\n      while j < Array::length(struct_sets) {\\n        let (sname, sfields) = Array::get(struct_sets, j)\\n        if field_sets_match(names, sfields) {\\n          result = Some(sname)\\n          j = Array::length(struct_sets)\\n        } else {\\n          j = j + 1\\n        }\\n      }\\n      result\\n    },\\n    _ => None\\n  }\\n}\\n\\nlet empty_threaded: () -> Array[(String, String, Int)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\", 0)\\n  ], 0, 0)\\n}\\n\\nlet empty_dict_binds: () -> Array[(String, String, String, Array[String])] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\", \\\"\\\", empty_str_array())\\n  ], 0, 0)\\n}\\n\\nlet already_threaded: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {\\n  if Array::length(params) == 0 {\\n    false\\n  } else {\\n    let (pname, _) = Array::get(params, 0)\\n    String::starts_with(pname, \\\"__dict_\\\")\\n  }\\n}\\n\\nlet find_recv_index: (Array[(String, Option[TypeExpr])], String) -> Int = (params, tp) -> {\\n  let mut i = 0\\n  let mut idx = -1\\n  while i < Array::length(params) {\\n    let (_, ann) = Array::get(params, i)\\n    match ann {\\n      Some(TyName(n)) => if n == tp {\\n        idx = i\\n        i = Array::length(params)\\n      } else {\\n        i = i + 1\\n      },\\n      _ => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  idx\\n}\\n\\nlet qualified_head: (String) -> String = (name) -> {\\n  match split_qualified(name) {\\n    Some(parts) => {\\n      let (head, _) = parts\\n      head\\n    },\\n    None => \\\"\\\"\\n  }\\n}\\n\\nlet collect_generic_impl_types: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out = empty_str_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImpl(tparams, tbounds, _, type_name) => if Array::length(tparams) > 0 {\\n        let mut has_bound = false\\n        let mut bi = 0\\n        while bi < Array::length(tbounds) {\\n          let (_, bs) = Array::get(tbounds, bi)\\n          let mut bj = 0\\n          while bj < Array::length(bs) {\\n            if Array::get(bs, bj) != \\\"\\\" {\\n              has_bound = true\\n            } else {\\n              ()\\n            }\\n            bj = bj + 1\\n          }\\n          bi = bi + 1\\n        }\\n        if has_bound {\\n          Array::push(out, type_name)\\n        } else {\\n          ()\\n        }\\n      } else (),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet build_gens: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[String]) -> Array[(String, Array[(String, String, Int)])] = (stmts, traits, gimpl_types) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", empty_threaded())\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, fname, _, body) => match body {\\n        EFn(_, bounds, params, _, _, _) => if already_threaded(params) {\\n          ()\\n        } else {\\n          let threaded = empty_threaded()\\n          let mut bi = 0\\n          while bi < Array::length(bounds) {\\n            let (tp, trait_list) = Array::get(bounds, bi)\\n            let mut ti = 0\\n            while ti < Array::length(trait_list) {\\n              let tr = Array::get(trait_list, ti)\\n              match lookup_trait_sigs(traits, tr) {\\n                Some(_) => {\\n                  let ridx = find_recv_index(params, tp)\\n                  if ridx >= 0 {\\n                    Array::push(threaded, (tp, tr, ridx))\\n                  } else if str_array_contains(gimpl_types, qualified_head(fname)) {\\n                    Array::push(threaded, (tp, tr, 0 - 1))\\n                  } else {\\n                    ()\\n                  }\\n                },\\n                None => ()\\n              }\\n              ti = ti + 1\\n            }\\n            bi = bi + 1\\n          }\\n          if Array::length(threaded) > 0 {\\n            Array::push(out, (fname, threaded))\\n          } else {\\n            ()\\n          }\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet lookup_gen: (Array[(String, Array[(String, String, Int)])], String) -> Option[Array[(String, String, Int)]] = (gens, name) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(gens) {\\n    let (gname, threaded) = Array::get(gens, i)\\n    if gname == name {\\n      result = Some(threaded)\\n      i = Array::length(gens)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet find_dict_for_method: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, head, member) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(dict_binds) {\\n    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)\\n    if tp == head && str_array_contains(methods, member) {\\n      result = Some(dict_pname)\\n      i = Array::length(dict_binds)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet find_dict_for_trait: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, tparam, trait_name) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(dict_binds) {\\n    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)\\n    if tp == tparam && tr == trait_name {\\n      result = Some(dict_pname)\\n      i = Array::length(dict_binds)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet first_array_elem: (Expr) -> Option[Expr] = (e) -> {\\n  match e {\\n    EArray(elems) => if Array::length(elems) > 0 {\\n      Some(Array::get(elems, 0))\\n    } else None,\\n    _ => None\\n  }\\n}\\n\\nlet rec build_concrete_dict: (String, String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[(String, String, Int)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String)], Expr) -> Option[Expr] = (cname, trait_name, traits, gens, struct_sets, var_types, fn_returns, arg_expr) -> {\\n  match lookup_trait_sigs(traits, trait_name) {\\n    Some(sigs) => {\\n      let mnames = method_names_of_sigs(sigs)\\n      let recfields = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut mi = 0\\n      let mut failed = false\\n      while mi < Array::length(mnames) {\\n        let m = Array::get(mnames, mi)\\n        let qm = String::concat(cname, String::concat(\\\"::\\\", m))\\n        if not(fn_exists(fn_returns, qm)) {\\n          failed = true\\n        } else {\\n        match lookup_gen(gens, qm) {\\n          Some(threaded) => {\\n            match first_array_elem(arg_expr) {\\n              Some(elem) => match infer_arg_type_name(elem, struct_sets, var_types, fn_returns) {\\n                Some(en) => {\\n                  let callargs = empty_expr_array()\\n                  let mut bi = 0\\n                  let mut subok = true\\n                  while bi < Array::length(threaded) {\\n                    let (_, btrait, _) = Array::get(threaded, bi)\\n                    match build_concrete_dict(en, btrait, traits, gens, struct_sets, var_types, fn_returns, elem) {\\n                      Some(sd) => Array::push(callargs, sd),\\n                      None => {\\n                        subok = false\\n                      }\\n                    }\\n                    bi = bi + 1\\n                  }\\n                  if subok {\\n                    Array::push(callargs, EIdent(\\\"__w\\\", -1))\\n                    let closure = EFn(empty_str_array(), Array::slice([\\n                      (\\\"\\\", empty_str_array())\\n                    ], 0, 0), Array::slice([\\n                      (\\\"__w\\\", None)\\n                    ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))\\n                    Array::push(recfields, (m, closure))\\n                  } else {\\n                    failed = true\\n                  }\\n                },\\n                None => {\\n                  failed = true\\n                }\\n              },\\n              None => {\\n                failed = true\\n              }\\n            }\\n          },\\n          None => Array::push(recfields, (m, EIdent(qm, -1)))\\n        }\\n        }\\n        mi = mi + 1\\n      }\\n      if failed {\\n        None\\n      } else {\\n        Some(ERecord(recfields))\\n      }\\n    },\\n    None => None\\n  }\\n}\\n\\nlet synth_dicts: (Array[(String, String, Int)], Array[Expr], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, Array[(String, String, Int)])]) -> Option[Array[Expr]] = (threaded, orig_args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) -> {\\n  let dicts = empty_expr_array()\\n  let mut ok = true\\n  let mut bi = 0\\n  while bi < Array::length(threaded) {\\n    let (_, trait_name, recv_idx) = Array::get(threaded, bi)\\n    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {\\n      let recv_arg = Array::get(orig_args, recv_idx)\\n      match infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns) {\\n        Some(nm) => match find_dict_for_trait(dict_binds, nm, trait_name) {\\n          Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),\\n          None => match build_concrete_dict(nm, trait_name, traits, gens, struct_sets, var_types, fn_returns, recv_arg) {\\n            Some(dict) => Array::push(dicts, dict),\\n            None => {\\n              ok = false\\n            }\\n          }\\n        },\\n        None => {\\n          ok = false\\n        }\\n      }\\n    } else {\\n      ok = false\\n    }\\n    bi = bi + 1\\n  }\\n  if ok {\\n    Some(dicts)\\n  } else {\\n    None\\n  }\\n}\\n\\nlet concat_expr_arrays: (Array[Expr], Array[Expr]) -> Array[Expr] = (a, b) -> {\\n  let out = empty_expr_array()\\n  let mut i = 0\\n  while i < Array::length(a) {\\n    Array::push(out, Array::get(a, i))\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(b) {\\n    Array::push(out, Array::get(b, j))\\n    j = j + 1\\n  }\\n  out\\n}\\n\\nlet seed_var_types: (Array[(String, Option[TypeExpr])], Array[String], Array[(String, String)]) -> Array[(String, String)] = (params, tparams, base) -> {\\n  let _ = tparams\\n  let out = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  let mut b = 0\\n  while b < Array::length(base) {\\n    Array::push(out, Array::get(base, b))\\n    b = b + 1\\n  }\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, ann) = Array::get(params, i)\\n    match ann {\\n      Some(TyName(tn)) => Array::push(out, (pname, tn)),\\n      Some(TyApp(tn, _)) => Array::push(out, (pname, tn)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet collect_fn_returns: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, fname, _, body) => match body {\\n        EFn(_, _, _, ret, _, _) => {\\n          let rn = match ret {\\n            Some(te) => match te {\\n              TyName(n) => n,\\n              TyApp(n, _) => n,\\n              _ => \\\"\\\"\\n            },\\n            None => \\\"\\\"\\n          }\\n          Array::push(out, (fname, rn))\\n        },\\n        _ => ()\\n      },\\n      SEnum(_, ename, _, variants, _) => {\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, _) = Array::get(variants, vi)\\n          Array::push(out, (vname, ename))\\n          vi = vi + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet fn_exists: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(fn_returns) {\\n    let (n, _) = Array::get(fn_returns, i)\\n    if n == fname {\\n      found = true\\n      i = Array::length(fn_returns)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet fn_return_type: (Array[(String, String)], String) -> Option[String] = (fn_returns, fname) -> {\\n  let mut i = 0\\n  let mut result = None\\n  while i < Array::length(fn_returns) {\\n    let (n, rt) = Array::get(fn_returns, i)\\n    if n == fname {\\n      result = if String::length(rt) == 0 {\\n        None\\n      } else Some(rt)\\n      i = Array::length(fn_returns)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet build_iter_for_with: (String, Expr, Expr, Expr) -> Expr = (name, nextcall, iter, body) -> {\\n  let some_arm = (PCtor(\\\"Some\\\", [\\n    PTuple([\\n      PBind(name),\\n      PBind(\\\"__iter_rest\\\")\\n    ])\\n  ]), EAssign(\\\"__iter_cur\\\", EIdent(\\\"__iter_rest\\\", -1), body))\\n  let none_arm = (PCtor(\\\"None\\\", Array::slice([\\n    PWild\\n  ], 0, 0)), EAssign(\\\"__iter_go\\\", EBool(false), EUnit))\\n  let loop_body = EMatch(nextcall, [\\n    some_arm,\\n    none_arm\\n  ])\\n  ELet(\\\"__iter_src\\\", iter, ELetMut(\\\"__iter_cur\\\", EIdent(\\\"__iter_src\\\", -1), ELetMut(\\\"__iter_go\\\", EBool(true), EWhile(EIdent(\\\"__iter_go\\\", -1), loop_body))))\\n}\\n\\nlet next_call_for: (String) -> Expr = (ctype) -> {\\n  ECall(EIdent(String::concat(ctype, \\\"::next\\\"), -1), [\\n    EIdent(\\\"__iter_cur\\\", -1)\\n  ], -1)\\n}\\n\\nlet build_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {\\n  build_iter_for_with(name, next_call_for(ctype), iter, body)\\n}\\n\\nlet build_await_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {\\n  let awaited = ECall(EIdent(\\\"await\\\", -1), [\\n    next_call_for(ctype)\\n  ], -1)\\n  build_iter_for_with(name, awaited, iter, body)\\n}\\n\\nlet build_pull_for_in: (String, Option[String], Expr, Expr) -> Expr = (value_name, index_name, iterable, body) -> {\\n  let some_arm = match index_name {\\n    Some(ix) => ESeq(body, EAssign(ix, EBinOp(\\\"+\\\", EIdent(ix, -1), EInt(1)), EUnit)),\\n    None => ESeq(body, EUnit)\\n  }\\n  let loop_body = EMatch(ECall(EIdent(\\\"__pull_next\\\", -1), Array::slice([\\n    EUnit\\n  ], 0, 0), -1), [\\n    (PCtor(\\\"Some\\\", [\\n      PBind(value_name)\\n    ]), some_arm),\\n    (PCtor(\\\"None\\\", Array::slice([\\n      PWild\\n    ], 0, 0)), EAssign(\\\"__pull_continue\\\", EBool(false), EUnit))\\n  ])\\n  let core_loop = ELetMut(\\\"__pull_continue\\\", EBool(true), EWhile(EIdent(\\\"__pull_continue\\\", -1), loop_body))\\n  let with_index = match index_name {\\n    Some(ix) => ELetMut(ix, EInt(0), core_loop),\\n    None => core_loop\\n  }\\n  ELet(\\\"__pull_next\\\", iterable, with_index)\\n}\\n\\nlet for_await_inner: (Expr) -> Option[Expr] = (iter) -> {\\n  match iter {\\n    ECall(callee, args, _) => match callee {\\n      EIdent(nm, _) => if nm == \\\"__await_iter\\\" && Array::length(args) == 1 {\\n        Some(Array::get(args, 0))\\n      } else {\\n        None\\n      },\\n      _ => None\\n    },\\n    _ => None\\n  }\\n}\\n\\nlet fn_return_is_future: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {\\n  match fn_return_type(fn_returns, fname) {\\n    Some(head) => head == \\\"Future\\\",\\n    None => false\\n  }\\n}\\n\\nlet classify_for_await_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns) -> {\\n  match infer_arg_type_name(inner, struct_sets, var_types, fn_returns) {\\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \\\"::next\\\")) {\\n      if fn_return_is_future(fn_returns, String::concat(tn, \\\"::next\\\")) {\\n        build_await_iter_for(name, tn, rinner, rbody)\\n      } else {\\n        build_iter_for(name, tn, rinner, rbody)\\n      }\\n    } else {\\n      build_pull_for_in(name, idx, rinner, rbody)\\n    },\\n    None => build_pull_for_in(name, idx, rinner, rbody)\\n  }\\n}\\n\\nlet classify_sync_for_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns) -> {\\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \\\"::next\\\")) {\\n      build_iter_for(name, tn, riter, rbody)\\n    } else {\\n      match fn_return_type(fn_returns, String::concat(tn, \\\"::iter\\\")) {\\n        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, \\\"::iter\\\"), -1), [\\n          riter\\n        ], -1), rbody),\\n        None => EForIn(name, idx, riter, rbody)\\n      }\\n    },\\n    None => EForIn(name, idx, riter, rbody)\\n  }\\n}\\n\\nlet extend_var_types: (Array[(String, String)], String, Option[String]) -> Array[(String, String)] = (var_types, name, inferred) -> {\\n  match inferred {\\n    Some(tname) => {\\n      let out = Array::slice([\\n        (\\\"\\\", \\\"\\\")\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(var_types) {\\n        Array::push(out, Array::get(var_types, i))\\n        i = i + 1\\n      }\\n      Array::push(out, (name, tname))\\n      out\\n    },\\n    None => var_types\\n  }\\n}\\n\\nlet qual_ctor_member: (String, String, Array[(String, Array[String])], Array[(String, String)]) -> Option[String] = (head, member, struct_sets, fn_returns) -> {\\n  if struct_set_has(struct_sets, head) {\\n    match fn_return_type(fn_returns, member) {\\n      Some(en) => if en == head {\\n        Some(member)\\n      } else {\\n        None\\n      },\\n      None => None\\n    }\\n  } else {\\n    None\\n  }\\n}\\n\\nlet try_sentinel: (Expr, Array[Expr]) -> Int = (callee, args) -> {\\n  match callee {\\n    EIdent(n, _) => if n == \\\"__try_bind\\\" {\\n      if Array::length(args) == 2 {\\n        match Array::get(args, 1) {\\n          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {\\n            0\\n          } else {\\n            2\\n          },\\n          _ => 2\\n        }\\n      } else {\\n        2\\n      }\\n    } else if n == \\\"__try_op\\\" {\\n      if Array::length(args) == 1 {\\n        1\\n      } else {\\n        2\\n      }\\n    } else {\\n      2\\n    },\\n    _ => 2\\n  }\\n}\\n\\nlet lower_try_bind: (Expr, String, Expr, Option[String]) -> Expr = (val, name, rest, inferred) -> {\\n  match inferred {\\n    Some(tn) => if tn == \\\"Option\\\" {\\n      EMatch(val, [\\n        (PCtor(\\\"Some\\\", [\\n          PBind(name)\\n        ]), rest),\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), EIdent(\\\"None\\\", -1))\\n      ])\\n    } else {\\n      EMatch(val, [\\n        (PCtor(\\\"Ok\\\", [\\n          PBind(name)\\n        ]), rest),\\n        (PCtor(\\\"Err\\\", [\\n          PBind(\\\"__bind_err\\\")\\n        ]), ECall(EIdent(\\\"Err\\\", -1), [\\n          EIdent(\\\"__bind_err\\\", -1)\\n        ], -1))\\n      ])\\n    },\\n    None => EMatch(val, [\\n      (PCtor(\\\"Ok\\\", [\\n        PBind(name)\\n      ]), rest),\\n      (PCtor(\\\"Err\\\", [\\n        PBind(\\\"__bind_err\\\")\\n      ]), ECall(EIdent(\\\"Err\\\", -1), [\\n        EIdent(\\\"__bind_err\\\", -1)\\n      ], -1))\\n    ])\\n  }\\n}\\n\\nlet lower_try_op: (Expr, Option[String]) -> Expr = (val, inferred) -> {\\n  match inferred {\\n    Some(tn) => if tn == \\\"Option\\\" {\\n      EMatch(val, [\\n        (PCtor(\\\"Some\\\", [\\n          PBind(\\\"__try_v\\\")\\n        ]), EIdent(\\\"__try_v\\\", -1)),\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), EReturn(EIdent(\\\"None\\\", -1)))\\n      ])\\n    } else {\\n      EMatch(val, [\\n        (PCtor(\\\"Ok\\\", [\\n          PBind(\\\"__try_v\\\")\\n        ]), EIdent(\\\"__try_v\\\", -1)),\\n        (PCtor(\\\"Err\\\", [\\n          PBind(\\\"__try_e\\\")\\n        ]), EReturn(ECall(EIdent(\\\"Err\\\", -1), [\\n          EIdent(\\\"__try_e\\\", -1)\\n        ], -1)))\\n      ])\\n    },\\n    None => EMatch(val, [\\n      (PCtor(\\\"Ok\\\", [\\n        PBind(\\\"__try_v\\\")\\n      ]), EIdent(\\\"__try_v\\\", -1)),\\n      (PCtor(\\\"Err\\\", [\\n        PBind(\\\"__try_e\\\")\\n      ]), EReturn(ECall(EIdent(\\\"Err\\\", -1), [\\n        EIdent(\\\"__try_e\\\", -1)\\n      ], -1)))\\n    ])\\n  }\\n}\\n\\nlet rec railway_rw: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, struct_sets, var_types, fn_returns) -> {\\n  match expr {\\n    ECall(callee, args, off) => {\\n      let k = try_sentinel(callee, args)\\n      if k == 0 {\\n        let val = Array::get(args, 0)\\n        match Array::get(args, 1) {\\n          EFn(_, _, ps, _, _, rest) => {\\n            let (name, _) = Array::get(ps, 0)\\n            let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\\n            let body_vars = extend_var_types(var_types, name, inferred)\\n            let rwrest = railway_rw(rest, struct_sets, body_vars, fn_returns)\\n            lower_try_bind(rwval, name, rwrest, inferred)\\n          },\\n          _ => EUnit\\n        }\\n      } else if k == 1 {\\n        let val = Array::get(args, 0)\\n        let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      } else {\\n        ECall(railway_rw(callee, struct_sets, var_types, fn_returns), for a in args {\\n          railway_rw(a, struct_sets, var_types, fn_returns)\\n        }, off)\\n      }\\n    },\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EUnit => expr,\\n    ESpread(e) => ESpread(railway_rw(e, struct_sets, var_types, fn_returns)),\\n    EStringInterp(_) => expr,\\n    EIdent(_, _) => expr,\\n    ETuple(elems) => ETuple(for e in elems {\\n      railway_rw(e, struct_sets, var_types, fn_returns)\\n    }),\\n    EArray(elems) => EArray(for e in elems {\\n      railway_rw(e, struct_sets, var_types, fn_returns)\\n    }),\\n    ERecord(fields) => {\\n      let out = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (fname, fval) = Array::get(fields, i)\\n        Array::push(out, (fname, railway_rw(fval, struct_sets, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      ERecord(out)\\n    },\\n    EMap(fields) => {\\n      let out = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (k, v) = Array::get(fields, i)\\n        Array::push(out, (k, railway_rw(v, struct_sets, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EMap(out)\\n    },\\n    EIf(c, t, e) => EIf(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(t, struct_sets, var_types, fn_returns), railway_rw(e, struct_sets, var_types, fn_returns)),\\n    ELet(name, val, body) => {\\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      ELet(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns))\\n    },\\n    ELetRec(name, val, body) => ELetRec(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\\n    ELetMut(name, val, body) => {\\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      ELetMut(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns))\\n    },\\n    EAssign(name, val, cont) => EAssign(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\\n    ESeq(a, b) => ESeq(railway_rw(a, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\\n    EMatch(scrut, arms) => {\\n      let out = Array::slice([\\n        (PWild, EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, b) = Array::get(arms, i)\\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EMatch(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\\n    },\\n    EHandle(scrut, arms) => {\\n      let out = Array::slice([\\n        (PWild, EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, b) = Array::get(arms, i)\\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EHandle(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\\n    },\\n    EWhile(c, b) => EWhile(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\\n    ELoop(params, body) => ELoop(for param in params {\\n      let (name, init) = param\\n      (name, railway_rw(init, struct_sets, var_types, fn_returns))\\n    }, railway_rw(body, struct_sets, var_types, fn_returns)),\\n    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(iter, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\\n    EBinOp(op, l, r) => EBinOp(op, railway_rw(l, struct_sets, var_types, fn_returns), railway_rw(r, struct_sets, var_types, fn_returns)),\\n    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(e, struct_sets, var_types, fn_returns)),\\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(body, struct_sets, seed_var_types(ps, tp, var_types), fn_returns)),\\n    EDot(obj, field, off) => EDot(railway_rw(obj, struct_sets, var_types, fn_returns), field, off),\\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(body, struct_sets, var_types, fn_returns)),\\n    EThrow(e) => EThrow(railway_rw(e, struct_sets, var_types, fn_returns)),\\n    EReturn(e) => EReturn(railway_rw(e, struct_sets, var_types, fn_returns)),\\n    EBreak(opt) => match opt {\\n      Some(e) => EBreak(Some(railway_rw(e, struct_sets, var_types, fn_returns))),\\n      None => expr\\n    },\\n    EContinue(exprs) => EContinue(for e in exprs {\\n      railway_rw(e, struct_sets, var_types, fn_returns)\\n    })\\n  }\\n}\\n\\nlet rec railway_rw_stmt: (Stmt, Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (s, struct_sets, fn_returns) -> {\\n  let no_vars = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  match s {\\n    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(body, struct_sets, no_vars, fn_returns)),\\n    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(e, struct_sets, no_vars, fn_returns)),\\n    STest(name, body) => STest(name, railway_rw(body, struct_sets, no_vars, fn_returns)),\\n    SBench(name, body) => SBench(name, railway_rw(body, struct_sets, no_vars, fn_returns)),\\n    SExpr(e) => SExpr(railway_rw(e, struct_sets, no_vars, fn_returns)),\\n    SModule(exp, name, body) => SModule(exp, name, for inner in body {\\n      railway_rw_stmt(inner, struct_sets, fn_returns)\\n    }),\\n    _ => s\\n  }\\n}\\n\\nexport let desugar_railway_binds: (Array[Stmt]) -> Unit = (stmts) -> {\\n  let struct_sets = collect_struct_field_sets(stmts)\\n  let fn_returns = collect_fn_returns(stmts)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::set(stmts, i, railway_rw_stmt(Array::get(stmts, i), struct_sets, fn_returns))\\n    i = i + 1\\n  }\\n}\\n\\nlet rec rewrite_expr: (Expr, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, gens, traits, struct_sets, dict_binds, var_types, fn_returns) -> {\\n  match expr {\\n    EIdent(name, off) => match split_qualified(name) {\\n      Some(parts) => {\\n        let (head, member) = parts\\n        match find_dict_for_method(dict_binds, head, member) {\\n          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1),\\n          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {\\n            Some(m) => EIdent(m, off),\\n            None => expr\\n          }\\n        }\\n      },\\n      None => expr\\n    },\\n    ECall(callee, args, off) => {\\n      let try_kind = try_sentinel(callee, args)\\n      if try_kind == 0 {\\n        let val = Array::get(args, 0)\\n        match Array::get(args, 1) {\\n          EFn(_, _, ps, _, _, rest) => {\\n            let (name, _) = Array::get(ps, 0)\\n            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\\n            let body_vars = extend_var_types(var_types, name, inferred)\\n            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)\\n            lower_try_bind(rwval, name, rwrest, inferred)\\n          },\\n          _ => EUnit\\n        }\\n      } else if try_kind == 1 {\\n        let val = Array::get(args, 0)\\n        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      } else {\\n      let rwargs = for a in args {\\n        rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      }\\n      match callee {\\n        EIdent(name0, coff) => {\\n          let name = match split_qualified(name0) {\\n            Some(parts0) => {\\n              let (h0, m0) = parts0\\n              match qual_ctor_member(h0, m0, struct_sets, fn_returns) {\\n                Some(mm) => mm,\\n                None => name0\\n              }\\n            },\\n            None => name0\\n          }\\n          let as_method = match split_qualified(name) {\\n            Some(parts) => {\\n              let (head, member) = parts\\n              find_dict_for_method(dict_binds, head, member)\\n            },\\n            None => None\\n          }\\n          match as_method {\\n            Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1), rwargs, off),\\n            None => match lookup_gen(gens, name) {\\n              Some(threaded) => match synth_dicts(threaded, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {\\n                Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),\\n                None => ECall(EIdent(name, coff), rwargs, off)\\n              },\\n              None => ECall(EIdent(name, coff), rwargs, off)\\n            }\\n          }\\n        },\\n        EDot(obj, m, doff) => ECall(EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), m, doff), rwargs, off),\\n        _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)\\n      }\\n      }\\n    },\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EUnit => expr,\\n    ESpread(_) => expr,\\n    EStringInterp(_) => expr,\\n    ETuple(elems) => ETuple(for e in elems {\\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n    }),\\n    EArray(elems) => EArray(for e in elems {\\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n    }),\\n    ERecord(fields) => {\\n      let out = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (fname, fval) = Array::get(fields, i)\\n        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      ERecord(out)\\n    },\\n    EMap(fields) => {\\n      let out = Array::slice([\\n        (\\\"\\\", EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (k, v) = Array::get(fields, i)\\n        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EMap(out)\\n    },\\n    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    ELet(name, val, body) => {\\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))\\n    },\\n    ELetRec(name, val, body) => ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    ELetMut(name, val, body) => {\\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\\n      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))\\n    },\\n    EAssign(name, val, cont) => EAssign(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EMatch(scrut, arms) => {\\n      let out = Array::slice([\\n        (PWild, EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, b) = Array::get(arms, i)\\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\\n    },\\n    EHandle(scrut, arms) => {\\n      let out = Array::slice([\\n        (PWild, EUnit)\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, b) = Array::get(arms, i)\\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\\n        i = i + 1\\n      }\\n      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\\n    },\\n    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    ELoop(params, body) => ELoop(for param in params {\\n      let (name, init) = param\\n      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))\\n    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EForIn(name, idx, iter, body) => {\\n      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      match for_await_inner(iter) {\\n        Some(inner) => {\\n          let rinner = rewrite_expr(inner, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n          classify_for_await_loop(name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns)\\n        },\\n        None => {\\n          let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n          if Array::length(traits) == 0 {\\n            EForIn(name, idx, riter, rbody)\\n          } else {\\n            classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\\n          }\\n        }\\n      }\\n    },\\n    EBinOp(op, l, r) => {\\n      let rl = rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      let rr = rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n      if op == \\\"==\\\" || op == \\\"!=\\\" {\\n        let empty_l = is_empty_array_lit(l)\\n        let empty_r = is_empty_array_lit(r)\\n        let arr_elem = match infer_earray_elem_type(l) {\\n          Some(t) => Some(t),\\n          None => infer_earray_elem_type(r)\\n        }\\n        if empty_l || empty_r {\\n          let other = if empty_l {\\n            rr\\n          } else {\\n            rl\\n          }\\n          let lencmp = EBinOp(\\\"==\\\", ECall(EIdent(\\\"Array::length\\\", -1), [\\n            other\\n          ], -1), EInt(0))\\n          if op == \\\"==\\\" {\\n            lencmp\\n          } else {\\n            ECall(EIdent(\\\"not\\\", -1), [\\n              lencmp\\n            ], -1)\\n          }\\n        } else {\\n        match arr_elem {\\n          Some(elem) => {\\n            let call = ECall(EIdent(arr_equals_name(elem), -1), [\\n              rl,\\n              rr\\n            ], -1)\\n            if op == \\\"==\\\" {\\n              call\\n            } else {\\n              ECall(EIdent(\\\"not\\\", -1), [\\n                call\\n              ], -1)\\n            }\\n          },\\n          None => {\\n            let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\\n              Some(t) => Some(t),\\n              None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)\\n            }\\n            match ty {\\n              Some(t) => if struct_set_has(struct_sets, t) {\\n                let call = ECall(EIdent(String::concat(t, \\\"::equals\\\"), -1), [\\n                  rl,\\n                  rr\\n                ], -1)\\n                if op == \\\"==\\\" {\\n                  call\\n                } else {\\n                  ECall(EIdent(\\\"not\\\", -1), [\\n                    call\\n                  ], -1)\\n                }\\n              } else if t == \\\"Option\\\" {\\n                let eqm = opt_eq_match(rl, rr)\\n                if op == \\\"==\\\" {\\n                  eqm\\n                } else {\\n                  ECall(EIdent(\\\"not\\\", -1), [\\n                    eqm\\n                  ], -1)\\n                }\\n              } else if t == \\\"Result\\\" {\\n                let eqm = result_eq_match(rl, rr)\\n                if op == \\\"==\\\" {\\n                  eqm\\n                } else {\\n                  ECall(EIdent(\\\"not\\\", -1), [\\n                    eqm\\n                  ], -1)\\n                }\\n              } else {\\n                EBinOp(op, rl, rr)\\n              },\\n              None => EBinOp(op, rl, rr)\\n            }\\n          }\\n        }\\n        }\\n      } else {\\n        EBinOp(op, rl, rr)\\n      }\\n    },\\n    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)),\\n    EDot(obj, field, off) => EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), field, off),\\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EThrow(e) => EThrow(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\\n    EBreak(opt) => match opt {\\n      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),\\n      None => expr\\n    },\\n    EContinue(exprs) => EContinue(for e in exprs {\\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\\n    })\\n  }\\n}\\n\\nlet member_of: (String) -> String = (name) -> {\\n  match split_qualified(name) {\\n    Some(parts) => {\\n      let (_, member) = parts\\n      member\\n    },\\n    None => name\\n  }\\n}\\n\\nlet dict_binds_of: (Array[(String, String, Int)], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] = (threaded, traits) -> {\\n  let out = empty_dict_binds()\\n  let mut i = 0\\n  while i < Array::length(threaded) {\\n    let (tp, trait_name, _) = Array::get(threaded, i)\\n    let methods = match lookup_trait_sigs(traits, trait_name) {\\n      Some(sigs) => method_names_of_sigs(sigs),\\n      None => empty_str_array()\\n    }\\n    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet thread_dict_params: (Array[(String, String, Int)], Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (threaded, params) -> {\\n  let result = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(threaded) {\\n    let (tp, trait_name, _) = Array::get(threaded, i)\\n    let dty = TyApp(dict_struct_name(trait_name), [\\n      TyName(tp)\\n    ])\\n    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(params) {\\n    Array::push(result, Array::get(params, j))\\n    j = j + 1\\n  }\\n  result\\n}\\n\\nlet rewrite_stmt: (Stmt, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (stmt, gens, traits, struct_sets, fn_returns) -> {\\n  let no_binds = empty_dict_binds()\\n  let no_vars = Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n  match stmt {\\n    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {\\n      Some(threaded) => match body {\\n        EFn(tparams, bounds, params, ret, eff, fbody) => {\\n          let binds = dict_binds_of(threaded, traits)\\n          let new_params = thread_dict_params(threaded, params)\\n          let seeded = seed_var_types(params, tparams, no_vars)\\n          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)\\n          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))\\n        },\\n        _ => stmt\\n      },\\n      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns))\\n    },\\n    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\\n    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\\n    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\\n    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\\n    SModule(exp, name, body) => SModule(exp, name, for s in body {\\n      rewrite_stmt(s, gens, traits, struct_sets, fn_returns)\\n    }),\\n    _ => stmt\\n  }\\n}\\n\\n\\nlet qualified_name: (String, String) -> String = (tname, method) -> {\\n  String::concat(tname, String::concat(\\\"::\\\", method))\\n}\\n\\nlet top_level_fn_exists: (Array[Stmt], String) -> Bool = (stmts, fname) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, _, _) => if name == fname {\\n        found = true\\n        i = Array::length(stmts)\\n      } else {\\n        i = i + 1\\n      },\\n      _ => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  found\\n}\\n\\nlet concat2: (Expr, Expr) -> Expr = (a, b) -> {\\n  ECall(EIdent(\\\"String::concat\\\", -1), [\\n    a,\\n    b\\n  ], -1)\\n}\\n\\nlet rec ts_type_key: (TypeExpr) -> String = (ty) -> {\\n  match ty {\\n    TyName(n) => n,\\n    TyApp(n, args) => {\\n      let mut s = n\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        s = String::concat(s, String::concat(\\\"_\\\", ts_type_key(Array::get(args, i))))\\n        i = i + 1\\n      }\\n      s\\n    },\\n    TyTuple(ts) => {\\n      let mut s = \\\"Tup\\\"\\n      let mut i = 0\\n      while i < Array::length(ts) {\\n        s = String::concat(s, String::concat(\\\"_\\\", ts_type_key(Array::get(ts, i))))\\n        i = i + 1\\n      }\\n      s\\n    },\\n    TyUnit => \\\"Unit\\\",\\n    _ => \\\"Any\\\"\\n  }\\n}\\n\\nlet arr_to_string_name: (TypeExpr) -> String = (t) -> {\\n  String::concat(\\\"__arr_to_string__\\\", ts_type_key(t))\\n}\\n\\nlet rec show_for_typed: (TypeExpr, Expr, Array[String]) -> Expr = (fty, val, known_types) -> {\\n  match fty {\\n    TyName(\\\"String\\\") => val,\\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"to_string\\\"), -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    TyApp(\\\"Option\\\", args) => if Array::length(args) == 1 {\\n      let t = Array::get(args, 0)\\n      let inner = show_for_typed(t, EIdent(\\\"__os_v\\\", -1), known_types)\\n      let some_body = concat2(EString(\\\"Some(\\\"), concat2(inner, EString(\\\")\\\")))\\n      EMatch(val, Array::slice([\\n        (PCtor(\\\"Some\\\", Array::slice([\\n          PBind(\\\"__os_v\\\")\\n        ], 0, 1)), some_body),\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), EString(\\\"None\\\"))\\n      ], 0, 2))\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    TyApp(\\\"Result\\\", args) => if Array::length(args) == 2 {\\n      let t = Array::get(args, 0)\\n      let e = Array::get(args, 1)\\n      let ok_inner = show_for_typed(t, EIdent(\\\"__rs_v\\\", -1), known_types)\\n      let err_inner = show_for_typed(e, EIdent(\\\"__rs_v\\\", -1), known_types)\\n      let ok_body = concat2(EString(\\\"Ok(\\\"), concat2(ok_inner, EString(\\\")\\\")))\\n      let err_body = concat2(EString(\\\"Err(\\\"), concat2(err_inner, EString(\\\")\\\")))\\n      EMatch(val, Array::slice([\\n        (PCtor(\\\"Ok\\\", Array::slice([\\n          PBind(\\\"__rs_v\\\")\\n        ], 0, 1)), ok_body),\\n        (PCtor(\\\"Err\\\", Array::slice([\\n          PBind(\\\"__rs_v\\\")\\n        ], 0, 1)), err_body)\\n      ], 0, 2))\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    TyTuple(ts) => {\\n      let n = Array::length(ts)\\n      let pats = Array::slice([\\n        PWild\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < n {\\n        Array::push(pats, PBind(String::concat(\\\"__ts_t\\\", idx_str(i))))\\n        i = i + 1\\n      }\\n      let segs = empty_expr_array()\\n      Array::push(segs, EString(\\\"(\\\"))\\n      let mut k = 0\\n      while k < n {\\n        if k > 0 {\\n          Array::push(segs, EString(\\\", \\\"))\\n        } else {\\n          ()\\n        }\\n        Array::push(segs, show_for_typed(Array::get(ts, k), EIdent(String::concat(\\\"__ts_t\\\", idx_str(k)), -1), known_types))\\n        k = k + 1\\n      }\\n      Array::push(segs, EString(\\\")\\\"))\\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\\n      let mut j = Array::length(segs) - 2\\n      while j >= 0 {\\n        acc = concat2(Array::get(segs, j), acc)\\n        j = j - 1\\n      }\\n      EMatch(val, Array::slice([\\n        (PTuple(pats), acc)\\n      ], 0, 1))\\n    },\\n    TyApp(\\\"Array\\\", args) => if Array::length(args) == 1 {\\n      ECall(EIdent(arr_to_string_name(Array::get(args, 0)), -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    TyApp(n, _) => if str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"to_string\\\"), -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    } else {\\n      ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n        val\\n      ], 0, 1), -1)\\n    },\\n    _ => ECall(EIdent(\\\"__to_string\\\", -1), Array::slice([\\n      val\\n    ], 0, 1), -1)\\n  }\\n}\\n\\nlet field_show_expr: (String, TypeExpr, Array[String]) -> Expr = (fname, fty, known_types) -> {\\n  show_for_typed(fty, EDot(EIdent(\\\"self\\\", -1), fname, -1), known_types)\\n}\\n\\nlet gen_arr_to_string_fn: (TypeExpr, Array[String]) -> Stmt = (elem_ty, known_types) -> {\\n  let elem_get = ECall(EIdent(\\\"Array::get\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1),\\n    EIdent(\\\"__as_i\\\", -1)\\n  ], 0, 2), -1)\\n  let elem_show = show_for_typed(elem_ty, elem_get, known_types)\\n  let sep = EIf(EBinOp(\\\"==\\\", EIdent(\\\"__as_i\\\", -1), EInt(0)), EString(\\\"\\\"), EString(\\\", \\\"))\\n  let append = concat2(concat2(EIdent(\\\"__as_acc\\\", -1), sep), elem_show)\\n  let set_acc = EAssign(\\\"__as_acc\\\", append, EUnit)\\n  let incr = EAssign(\\\"__as_i\\\", EBinOp(\\\"+\\\", EIdent(\\\"__as_i\\\", -1), EInt(1)), EUnit)\\n  let loop_body = ESeq(set_acc, incr)\\n  let while_loop = EWhile(EBinOp(\\\"<\\\", EIdent(\\\"__as_i\\\", -1), ECall(EIdent(\\\"Array::length\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1)\\n  ], 0, 1), -1)), loop_body)\\n  let closed = concat2(EIdent(\\\"__as_acc\\\", -1), EString(\\\"]\\\"))\\n  let body = ELetMut(\\\"__as_i\\\", EInt(0), ELetMut(\\\"__as_acc\\\", EString(\\\"[\\\"), ESeq(while_loop, closed)))\\n  let arr_ty = TyApp(\\\"Array\\\", Array::slice([\\n    elem_ty\\n  ], 0, 1))\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(arr_ty))\\n  ], 0, 1)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, arr_to_string_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"String\\\")), None, body))\\n}\\n\\nlet gen_show_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\\n  let segs = empty_expr_array()\\n  Array::push(segs, EString(String::concat(tname, \\\" { \\\")))\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (fname, fty) = Array::get(fields, i)\\n    let sep = if i == 0 {\\n      \\\"\\\"\\n    } else \\\", \\\"\\n    Array::push(segs, EString(String::concat(sep, String::concat(fname, \\\": \\\"))))\\n    Array::push(segs, field_show_expr(fname, fty, known_types))\\n    i = i + 1\\n  }\\n  Array::push(segs, EString(\\\" }\\\"))\\n  let mut body = Array::get(segs, Array::length(segs) - 1)\\n  let mut j = Array::length(segs) - 2\\n  while j >= 0 {\\n    body = concat2(Array::get(segs, j), body)\\n    j = j - 1\\n  }\\n  let params = Array::slice([\\n    (\\\"self\\\", Some(TyName(tname)))\\n  ], 0, 1)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"to_string\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"String\\\")), None, body))\\n}\\n\\nlet is_scalar_type_name: (String) -> Bool = (n) -> {\\n  n == \\\"Int\\\" || n == \\\"Double\\\" || n == \\\"Bool\\\" || n == \\\"String\\\" || n == \\\"Char\\\" || n == \\\"Unit\\\" || n == \\\"Bytes\\\"\\n}\\n\\nlet rec type_key: (TypeExpr) -> String = (ty) -> {\\n  match ty {\\n    TyName(n) => n,\\n    TyApp(n, args) => {\\n      let mut s = n\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        s = String::concat(s, String::concat(\\\"_\\\", type_key(Array::get(args, i))))\\n        i = i + 1\\n      }\\n      s\\n    },\\n    TyTuple(ts) => {\\n      let mut s = \\\"Tup\\\"\\n      let mut i = 0\\n      while i < Array::length(ts) {\\n        s = String::concat(s, String::concat(\\\"_\\\", type_key(Array::get(ts, i))))\\n        i = i + 1\\n      }\\n      s\\n    },\\n    TyUnit => \\\"Unit\\\",\\n    _ => \\\"Any\\\"\\n  }\\n}\\n\\nlet arr_equals_name: (TypeExpr) -> String = (t) -> {\\n  String::concat(\\\"__arr_equals__\\\", type_key(t))\\n}\\n\\nlet opt_eq_match: (Expr, Expr) -> Expr = (lhs, rhs) -> {\\n  let some_inner = EMatch(rhs, Array::slice([\\n    (PCtor(\\\"Some\\\", Array::slice([\\n      PBind(\\\"__oeq_r\\\")\\n    ], 0, 1)), EBinOp(\\\"==\\\", EIdent(\\\"__oeq_l\\\", -1), EIdent(\\\"__oeq_r\\\", -1))),\\n    (PWild, EBool(false))\\n  ], 0, 2))\\n  let none_inner = EMatch(rhs, Array::slice([\\n    (PCtor(\\\"None\\\", Array::slice([\\n      PWild\\n    ], 0, 0)), EBool(true)),\\n    (PWild, EBool(false))\\n  ], 0, 2))\\n  EMatch(lhs, Array::slice([\\n    (PCtor(\\\"Some\\\", Array::slice([\\n      PBind(\\\"__oeq_l\\\")\\n    ], 0, 1)), some_inner),\\n    (PCtor(\\\"None\\\", Array::slice([\\n      PWild\\n    ], 0, 0)), none_inner)\\n  ], 0, 2))\\n}\\n\\nlet result_eq_match: (Expr, Expr) -> Expr = (lhs, rhs) -> {\\n  let ok_inner = EMatch(rhs, Array::slice([\\n    (PCtor(\\\"Ok\\\", Array::slice([\\n      PBind(\\\"__req_r\\\")\\n    ], 0, 1)), EBinOp(\\\"==\\\", EIdent(\\\"__req_l\\\", -1), EIdent(\\\"__req_r\\\", -1))),\\n    (PWild, EBool(false))\\n  ], 0, 2))\\n  let err_inner = EMatch(rhs, Array::slice([\\n    (PCtor(\\\"Err\\\", Array::slice([\\n      PBind(\\\"__req_r\\\")\\n    ], 0, 1)), EBinOp(\\\"==\\\", EIdent(\\\"__req_l\\\", -1), EIdent(\\\"__req_r\\\", -1))),\\n    (PWild, EBool(false))\\n  ], 0, 2))\\n  EMatch(lhs, Array::slice([\\n    (PCtor(\\\"Ok\\\", Array::slice([\\n      PBind(\\\"__req_l\\\")\\n    ], 0, 1)), ok_inner),\\n    (PCtor(\\\"Err\\\", Array::slice([\\n      PBind(\\\"__req_l\\\")\\n    ], 0, 1)), err_inner)\\n  ], 0, 2))\\n}\\n\\nlet rec eq_for_typed: (TypeExpr, Expr, Expr, Array[String]) -> Expr = (fty, lhs, rhs, known_types) -> {\\n  match fty {\\n    TyName(n) => if n == \\\"Double\\\" || n == \\\"Float\\\" {\\n      EBinOp(\\\"==\\\", ECall(EIdent(\\\"Double::to_float\\\", -1), Array::slice([\\n        lhs\\n      ], 0, 1), -1), ECall(EIdent(\\\"Double::to_float\\\", -1), Array::slice([\\n        rhs\\n      ], 0, 1), -1))\\n    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"equals\\\"), -1), Array::slice([\\n        lhs,\\n        rhs\\n      ], 0, 2), -1)\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    TyApp(\\\"Option\\\", args) => if Array::length(args) == 1 {\\n      let t = Array::get(args, 0)\\n      let inner_eq = eq_for_typed(t, EIdent(\\\"__oeq_l\\\", -1), EIdent(\\\"__oeq_r\\\", -1), known_types)\\n      let some_inner = EMatch(rhs, Array::slice([\\n        (PCtor(\\\"Some\\\", Array::slice([\\n          PBind(\\\"__oeq_r\\\")\\n        ], 0, 1)), inner_eq),\\n        (PWild, EBool(false))\\n      ], 0, 2))\\n      let none_inner = EMatch(rhs, Array::slice([\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), EBool(true)),\\n        (PWild, EBool(false))\\n      ], 0, 2))\\n      EMatch(lhs, Array::slice([\\n        (PCtor(\\\"Some\\\", Array::slice([\\n          PBind(\\\"__oeq_l\\\")\\n        ], 0, 1)), some_inner),\\n        (PCtor(\\\"None\\\", Array::slice([\\n          PWild\\n        ], 0, 0)), none_inner)\\n      ], 0, 2))\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    TyApp(\\\"Result\\\", args) => if Array::length(args) == 2 {\\n      let t = Array::get(args, 0)\\n      let e = Array::get(args, 1)\\n      let ok_eq = eq_for_typed(t, EIdent(\\\"__req_l\\\", -1), EIdent(\\\"__req_r\\\", -1), known_types)\\n      let err_eq = eq_for_typed(e, EIdent(\\\"__req_l\\\", -1), EIdent(\\\"__req_r\\\", -1), known_types)\\n      let ok_inner = EMatch(rhs, Array::slice([\\n        (PCtor(\\\"Ok\\\", Array::slice([\\n          PBind(\\\"__req_r\\\")\\n        ], 0, 1)), ok_eq),\\n        (PWild, EBool(false))\\n      ], 0, 2))\\n      let err_inner = EMatch(rhs, Array::slice([\\n        (PCtor(\\\"Err\\\", Array::slice([\\n          PBind(\\\"__req_r\\\")\\n        ], 0, 1)), err_eq),\\n        (PWild, EBool(false))\\n      ], 0, 2))\\n      EMatch(lhs, Array::slice([\\n        (PCtor(\\\"Ok\\\", Array::slice([\\n          PBind(\\\"__req_l\\\")\\n        ], 0, 1)), ok_inner),\\n        (PCtor(\\\"Err\\\", Array::slice([\\n          PBind(\\\"__req_l\\\")\\n        ], 0, 1)), err_inner)\\n      ], 0, 2))\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    TyTuple(ts) => {\\n      let n = Array::length(ts)\\n      let lpats = Array::slice([\\n        PWild\\n      ], 0, 0)\\n      let rpats = Array::slice([\\n        PWild\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < n {\\n        Array::push(lpats, PBind(String::concat(\\\"__teq_l\\\", idx_str(i))))\\n        Array::push(rpats, PBind(String::concat(\\\"__teq_r\\\", idx_str(i))))\\n        i = i + 1\\n      }\\n      let mut conj = EBool(true)\\n      let mut j = n - 1\\n      while j >= 0 {\\n        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat(\\\"__teq_l\\\", idx_str(j)), -1), EIdent(String::concat(\\\"__teq_r\\\", idx_str(j)), -1), known_types)\\n        conj = EBinOp(\\\"&&\\\", cmp, conj)\\n        j = j - 1\\n      }\\n      let inner = EMatch(rhs, Array::slice([\\n        (PTuple(rpats), conj)\\n      ], 0, 1))\\n      EMatch(lhs, Array::slice([\\n        (PTuple(lpats), inner)\\n      ], 0, 1))\\n    },\\n    TyApp(\\\"Array\\\", args) => if Array::length(args) == 1 {\\n      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([\\n        lhs,\\n        rhs\\n      ], 0, 2), -1)\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    TyApp(n, _) => if str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"equals\\\"), -1), Array::slice([\\n        lhs,\\n        rhs\\n      ], 0, 2), -1)\\n    } else {\\n      EBinOp(\\\"==\\\", lhs, rhs)\\n    },\\n    _ => EBinOp(\\\"==\\\", lhs, rhs)\\n  }\\n}\\n\\nlet gen_arr_equals_fn: (TypeExpr, Array[String]) -> Stmt = (elem_ty, known_types) -> {\\n  let len_a = ECall(EIdent(\\\"Array::length\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1)\\n  ], 0, 1), -1)\\n  let len_b = ECall(EIdent(\\\"Array::length\\\", -1), Array::slice([\\n    EIdent(\\\"b\\\", -1)\\n  ], 0, 1), -1)\\n  let elem_a = ECall(EIdent(\\\"Array::get\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1),\\n    EIdent(\\\"__ae_i\\\", -1)\\n  ], 0, 2), -1)\\n  let elem_b = ECall(EIdent(\\\"Array::get\\\", -1), Array::slice([\\n    EIdent(\\\"b\\\", -1),\\n    EIdent(\\\"__ae_i\\\", -1)\\n  ], 0, 2), -1)\\n  let elem_eq = eq_for_typed(elem_ty, elem_a, elem_b, known_types)\\n  let not_eq = ECall(EIdent(\\\"not\\\", -1), Array::slice([\\n    elem_eq\\n  ], 0, 1), -1)\\n  let set_false = EIf(not_eq, EAssign(\\\"__ae_ok\\\", EBool(false), EUnit), EUnit)\\n  let incr = EAssign(\\\"__ae_i\\\", EBinOp(\\\"+\\\", EIdent(\\\"__ae_i\\\", -1), EInt(1)), EUnit)\\n  let loop_body = ESeq(set_false, incr)\\n  let while_loop = EWhile(EBinOp(\\\"<\\\", EIdent(\\\"__ae_i\\\", -1), ECall(EIdent(\\\"Array::length\\\", -1), Array::slice([\\n    EIdent(\\\"a\\\", -1)\\n  ], 0, 1), -1)), loop_body)\\n  let body_eq = ELetMut(\\\"__ae_i\\\", EInt(0), ELetMut(\\\"__ae_ok\\\", EBool(true), ESeq(while_loop, EIdent(\\\"__ae_ok\\\", -1))))\\n  let body = EIf(EBinOp(\\\"!=\\\", len_a, len_b), EBool(false), body_eq)\\n  let arr_ty = TyApp(\\\"Array\\\", Array::slice([\\n    elem_ty\\n  ], 0, 1))\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(arr_ty)),\\n    (\\\"b\\\", Some(arr_ty))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, arr_equals_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Bool\\\")), None, body))\\n}\\n\\nlet field_eq_expr: (String, TypeExpr, Array[String]) -> Expr = (fname, fty, known_types) -> {\\n  eq_for_typed(fty, EDot(EIdent(\\\"a\\\", -1), fname, -1), EDot(EIdent(\\\"b\\\", -1), fname, -1), known_types)\\n}\\n\\nlet gen_eq_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\\n  let mut body = EBool(true)\\n  let mut i = Array::length(fields) - 1\\n  while i >= 0 {\\n    let (fname, fty) = Array::get(fields, i)\\n    body = EBinOp(\\\"&&\\\", field_eq_expr(fname, fty, known_types), body)\\n    i = i - 1\\n  }\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(TyName(tname))),\\n    (\\\"b\\\", Some(TyName(tname)))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"equals\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Bool\\\")), None, body))\\n}\\n\\nlet digit_str: (Int) -> String = (d) -> {\\n  if d == 0 {\\n    \\\"0\\\"\\n  } else if d == 1 {\\n    \\\"1\\\"\\n  } else if d == 2 {\\n    \\\"2\\\"\\n  } else if d == 3 {\\n    \\\"3\\\"\\n  } else if d == 4 {\\n    \\\"4\\\"\\n  } else if d == 5 {\\n    \\\"5\\\"\\n  } else if d == 6 {\\n    \\\"6\\\"\\n  } else if d == 7 {\\n    \\\"7\\\"\\n  } else if d == 8 {\\n    \\\"8\\\"\\n  } else {\\n    \\\"9\\\"\\n  }\\n}\\n\\nlet rec idx_str: (Int) -> String = (n) -> {\\n  if n < 10 {\\n    digit_str(n)\\n  } else {\\n    String::concat(idx_str(n / 10), digit_str(n % 10))\\n  }\\n}\\n\\nlet gen_enum_eq_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\\n  let outer_arms = Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n  let mut vi = 0\\n  while vi < Array::length(variants) {\\n    let (vname, ftypes) = Array::get(variants, vi)\\n    let nf = Array::length(ftypes)\\n    let abinds = Array::slice([\\n      PWild\\n    ], 0, 0)\\n    let bbinds = Array::slice([\\n      PWild\\n    ], 0, 0)\\n    let mut fi = 0\\n    while fi < nf {\\n      Array::push(abinds, PBind(String::concat(\\\"__a\\\", idx_str(fi))))\\n      Array::push(bbinds, PBind(String::concat(\\\"__b\\\", idx_str(fi))))\\n      fi = fi + 1\\n    }\\n    let mut body = EBool(true)\\n    let mut bi = nf - 1\\n    while bi >= 0 {\\n      let cmp = eq_for_typed(Array::get(ftypes, bi), EIdent(String::concat(\\\"__a\\\", idx_str(bi)), -1), EIdent(String::concat(\\\"__b\\\", idx_str(bi)), -1), known_types)\\n      body = EBinOp(\\\"&&\\\", cmp, body)\\n      bi = bi - 1\\n    }\\n    let inner_arms = Array::slice([\\n      (PCtor(vname, bbinds), body),\\n      (PWild, EBool(false))\\n    ], 0, 2)\\n    let inner = EMatch(EIdent(\\\"b\\\", -1), inner_arms)\\n    Array::push(outer_arms, (PCtor(vname, abinds), inner))\\n    vi = vi + 1\\n  }\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(TyName(ename))),\\n    (\\\"b\\\", Some(TyName(ename)))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(ename, \\\"equals\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Bool\\\")), None, EMatch(EIdent(\\\"a\\\", -1), outer_arms)))\\n}\\n\\nlet gen_compare_fn: (String, Array[(String, TypeExpr)]) -> Stmt = (tname, fields) -> {\\n  let neg_one = 0 - 1\\n  let mut body = EInt(0)\\n  let mut i = Array::length(fields) - 1\\n  while i >= 0 {\\n    let (fname, _) = Array::get(fields, i)\\n    let af = EDot(EIdent(\\\"a\\\", -1), fname, -1)\\n    let bf = EDot(EIdent(\\\"b\\\", -1), fname, -1)\\n    body = EIf(EBinOp(\\\"<\\\", af, bf), EInt(neg_one), EIf(EBinOp(\\\">\\\", af, bf), EInt(1), body))\\n    i = i - 1\\n  }\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(TyName(tname))),\\n    (\\\"b\\\", Some(TyName(tname)))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"compare\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Int\\\")), None, body))\\n}\\n\\nlet show_expr_typed: (Expr, TypeExpr, Array[String]) -> Expr = (val, fty, known_types) -> {\\n  show_for_typed(fty, val, known_types)\\n}\\n\\nlet gen_enum_show_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\\n  let arms = Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n  let mut vi = 0\\n  while vi < Array::length(variants) {\\n    let (vname, ftypes) = Array::get(variants, vi)\\n    let nf = Array::length(ftypes)\\n    let binds = Array::slice([\\n      PWild\\n    ], 0, 0)\\n    let mut fi = 0\\n    while fi < nf {\\n      Array::push(binds, PBind(String::concat(\\\"__s\\\", idx_str(fi))))\\n      fi = fi + 1\\n    }\\n    let body = if nf == 0 {\\n      EString(vname)\\n    } else {\\n      let segs = empty_expr_array()\\n      Array::push(segs, EString(String::concat(vname, \\\"(\\\")))\\n      let mut si = 0\\n      while si < nf {\\n        let sep = if si == 0 {\\n          \\\"\\\"\\n        } else \\\", \\\"\\n        if sep != \\\"\\\" {\\n          Array::push(segs, EString(sep))\\n        } else {\\n          ()\\n        }\\n        Array::push(segs, show_expr_typed(EIdent(String::concat(\\\"__s\\\", idx_str(si)), -1), Array::get(ftypes, si), known_types))\\n        si = si + 1\\n      }\\n      Array::push(segs, EString(\\\")\\\"))\\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\\n      let mut j = Array::length(segs) - 2\\n      while j >= 0 {\\n        acc = concat2(Array::get(segs, j), acc)\\n        j = j - 1\\n      }\\n      acc\\n    }\\n    Array::push(arms, (PCtor(vname, binds), body))\\n    vi = vi + 1\\n  }\\n  let params = Array::slice([\\n    (\\\"self\\\", Some(TyName(ename)))\\n  ], 0, 1)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(ename, \\\"to_string\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"String\\\")), None, EMatch(EIdent(\\\"self\\\", -1), arms)))\\n}\\n\\nlet gen_hash_key_fn: (String) -> Stmt = (tname) -> {\\n  let body = ECall(EIdent(qualified_name(tname, \\\"to_string\\\"), -1), Array::slice([\\n    EIdent(\\\"self\\\", -1)\\n  ], 0, 1), -1)\\n  let params = Array::slice([\\n    (\\\"self\\\", Some(TyName(tname)))\\n  ], 0, 1)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"hash_key\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"String\\\")), None, body))\\n}\\n\\nlet collect_show_array_elems: (TypeExpr, Array[TypeExpr], Array[String]) -> Unit = (ty, acc, keys) -> {\\n  match ty {\\n    TyApp(\\\"Array\\\", args) => if Array::length(args) == 1 {\\n      let et = Array::get(args, 0)\\n      let k = ts_type_key(et)\\n      if str_array_contains(keys, k) {\\n        ()\\n      } else {\\n        Array::push(keys, k)\\n        Array::push(acc, et)\\n      }\\n    } else {\\n      ()\\n    },\\n    _ => ()\\n  }\\n}\\n\\nlet compare_for_typed: (TypeExpr, Expr, Expr, Array[String]) -> Expr = (fty, lhs, rhs, known_types) -> {\\n  let neg_one = 0 - 1\\n  match fty {\\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"compare\\\"), -1), Array::slice([\\n        lhs,\\n        rhs\\n      ], 0, 2), -1)\\n    } else {\\n      EIf(EBinOp(\\\"<\\\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\\\">\\\", lhs, rhs), EInt(1), EInt(0)))\\n    },\\n    _ => EIf(EBinOp(\\\"<\\\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\\\">\\\", lhs, rhs), EInt(1), EInt(0)))\\n  }\\n}\\n\\nlet gen_enum_compare_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\\n  let neg_one = 0 - 1\\n  let outer_arms = Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n  let mut ai = 0\\n  while ai < Array::length(variants) {\\n    let (avname, aftypes) = Array::get(variants, ai)\\n    let anf = Array::length(aftypes)\\n    let abinds = Array::slice([\\n      PWild\\n    ], 0, 0)\\n    let mut afi = 0\\n    while afi < anf {\\n      Array::push(abinds, PBind(String::concat(\\\"__a\\\", idx_str(afi))))\\n      afi = afi + 1\\n    }\\n    let inner_arms = Array::slice([\\n      (PWild, EUnit)\\n    ], 0, 0)\\n    let mut bi = 0\\n    while bi < Array::length(variants) {\\n      let (bvname, bftypes) = Array::get(variants, bi)\\n      let bnf = Array::length(bftypes)\\n      let bbinds = Array::slice([\\n        PWild\\n      ], 0, 0)\\n      let mut bfi = 0\\n      while bfi < bnf {\\n        Array::push(bbinds, PBind(String::concat(\\\"__b\\\", idx_str(bfi))))\\n        bfi = bfi + 1\\n      }\\n      let arm_body = if ai == bi {\\n        let mut body = EInt(0)\\n        let mut pi = anf - 1\\n        while pi >= 0 {\\n          let cmp = compare_for_typed(Array::get(aftypes, pi), EIdent(String::concat(\\\"__a\\\", idx_str(pi)), -1), EIdent(String::concat(\\\"__b\\\", idx_str(pi)), -1), known_types)\\n          let prev = body\\n          body = EIf(EBinOp(\\\"<\\\", cmp, EInt(0)), EInt(neg_one), EIf(EBinOp(\\\">\\\", cmp, EInt(0)), EInt(1), prev))\\n          pi = pi - 1\\n        }\\n        body\\n      } else if ai < bi {\\n        EInt(neg_one)\\n      } else {\\n        EInt(1)\\n      }\\n      Array::push(inner_arms, (PCtor(bvname, bbinds), arm_body))\\n      bi = bi + 1\\n    }\\n    Array::push(outer_arms, (PCtor(avname, abinds), EMatch(EIdent(\\\"b\\\", -1), inner_arms)))\\n    ai = ai + 1\\n  }\\n  let params = Array::slice([\\n    (\\\"a\\\", Some(TyName(ename))),\\n    (\\\"b\\\", Some(TyName(ename)))\\n  ], 0, 2)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(ename, \\\"compare\\\"), None, EFn(no_tp, no_tb, params, Some(TyName(\\\"Int\\\")), None, EMatch(EIdent(\\\"a\\\", -1), outer_arms)))\\n}\\n\\nlet default_for_type: (TypeExpr, Array[String]) -> Expr = (fty, known_types) -> {\\n  match fty {\\n    TyName(\\\"Int\\\") => EInt(0),\\n    TyName(\\\"Double\\\") => EFloat(0.0),\\n    TyName(\\\"Float\\\") => EFloat(0.0),\\n    TyName(\\\"Bool\\\") => EBool(false),\\n    TyName(\\\"String\\\") => EString(\\\"\\\"),\\n    TyName(\\\"Unit\\\") => EUnit,\\n    TyName(n) => if str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"default\\\"), -1), empty_expr_array(), -1)\\n    } else {\\n      EUnit\\n    },\\n    TyApp(\\\"Option\\\", _) => EIdent(\\\"None\\\", -1),\\n    TyApp(\\\"Array\\\", _) => EArray(empty_expr_array()),\\n    TyApp(n, _) => if str_array_contains(known_types, n) {\\n      ECall(EIdent(qualified_name(n, \\\"default\\\"), -1), empty_expr_array(), -1)\\n    } else {\\n      EUnit\\n    },\\n    TyUnit => EUnit,\\n    _ => EUnit\\n  }\\n}\\n\\nlet gen_default_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\\n  let rec_fields = Array::slice([\\n    (\\\"\\\", EUnit)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (fname, fty) = Array::get(fields, i)\\n    Array::push(rec_fields, (fname, default_for_type(fty, known_types)))\\n    i = i + 1\\n  }\\n  let no_params = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(tname, \\\"default\\\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord(rec_fields)))\\n}\\n\\nlet gen_enum_default_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\\n  let (vname, ftypes) = Array::get(variants, 0)\\n  let body = if Array::length(ftypes) == 0 {\\n    EIdent(vname, -1)\\n  } else {\\n    let args = empty_expr_array()\\n    let mut i = 0\\n    while i < Array::length(ftypes) {\\n      Array::push(args, default_for_type(Array::get(ftypes, i), known_types))\\n      i = i + 1\\n    }\\n    ECall(EIdent(vname, -1), args, -1)\\n  }\\n  let no_params = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let no_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let no_tb = Array::slice([\\n    (\\\"\\\", no_tp)\\n  ], 0, 0)\\n  SLet(false, false, qualified_name(ename, \\\"default\\\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))\\n}\\n\\nlet rec collect_array_elem_types: (TypeExpr, Array[TypeExpr], Array[String]) -> Unit = (ty, acc, acc_keys) -> {\\n  match ty {\\n    TyApp(\\\"Array\\\", args) => if Array::length(args) == 1 {\\n      let e = Array::get(args, 0)\\n      let k = type_key(e)\\n      if !str_array_contains(acc_keys, k) {\\n        Array::push(acc, e)\\n        Array::push(acc_keys, k)\\n      } else {\\n        ()\\n      }\\n      collect_array_elem_types(e, acc, acc_keys)\\n    } else {\\n      ()\\n    },\\n    TyApp(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_array_elem_types(Array::get(args, i), acc, acc_keys)\\n        i = i + 1\\n      }\\n    },\\n    TyTuple(ts) => {\\n      let mut i = 0\\n      while i < Array::length(ts) {\\n        collect_array_elem_types(Array::get(ts, i), acc, acc_keys)\\n        i = i + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nlet is_empty_array_lit: (Expr) -> Bool = (e) -> {\\n  match e {\\n    EArray(elems) => Array::length(elems) == 0,\\n    _ => false\\n  }\\n}\\n\\nlet rec infer_earray_elem_type: (Expr) -> Option[TypeExpr] = (arr) -> {\\n  match arr {\\n    EArray(elems) => if Array::length(elems) == 0 {\\n      None\\n    } else {\\n      match Array::get(elems, 0) {\\n        EInt(_) => Some(TyName(\\\"Int\\\")),\\n        EBool(_) => Some(TyName(\\\"Bool\\\")),\\n        EString(_) => Some(TyName(\\\"String\\\")),\\n        EFloat(_) => Some(TyName(\\\"Double\\\")),\\n        EArray(_) => match infer_earray_elem_type(Array::get(elems, 0)) {\\n          Some(inner) => Some(TyApp(\\\"Array\\\", Array::slice([\\n            inner\\n          ], 0, 1))),\\n          None => None\\n        },\\n        _ => None\\n      }\\n    },\\n    _ => None\\n  }\\n}\\n\\nlet rec collect_bare_array_eq_keys: (Expr, Array[TypeExpr], Array[String]) -> Unit = (e, acc, acc_keys) -> {\\n  match e {\\n    EBinOp(op, l, r) => {\\n      if op == \\\"==\\\" || op == \\\"!=\\\" {\\n        let et = match infer_earray_elem_type(l) {\\n          Some(t) => Some(t),\\n          None => infer_earray_elem_type(r)\\n        }\\n        match et {\\n          Some(t) => {\\n            let k = type_key(t)\\n            if !str_array_contains(acc_keys, k) {\\n              Array::push(acc, t)\\n              Array::push(acc_keys, k)\\n            } else {\\n              ()\\n            }\\n            collect_array_elem_types(t, acc, acc_keys)\\n          },\\n          None => ()\\n        }\\n      } else {\\n        ()\\n      }\\n      collect_bare_array_eq_keys(l, acc, acc_keys)\\n      collect_bare_array_eq_keys(r, acc, acc_keys)\\n    },\\n    EInt(_) => (),\\n    EFloat(_) => (),\\n    EString(_) => (),\\n    EBool(_) => (),\\n    EIdent(_, _) => (),\\n    EUnit => (),\\n    ETuple(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\\n    EArray(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\\n    ERecord(fs) => {\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (_, fe) = Array::get(fs, i)\\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\\n        i = i + 1\\n      }\\n    },\\n    EMap(fs) => {\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (_, fe) = Array::get(fs, i)\\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\\n        i = i + 1\\n      }\\n    },\\n    EIf(c, t, el) => {\\n      collect_bare_array_eq_keys(c, acc, acc_keys)\\n      collect_bare_array_eq_keys(t, acc, acc_keys)\\n      collect_bare_array_eq_keys(el, acc, acc_keys)\\n    },\\n    ELet(_, v, b) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    ELetRec(_, v, b) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    ELetMut(_, v, b) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    EAssign(_, v, c) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(c, acc, acc_keys)\\n    },\\n    EAssignOp(_, _, v, c) => {\\n      collect_bare_array_eq_keys(v, acc, acc_keys)\\n      collect_bare_array_eq_keys(c, acc, acc_keys)\\n    },\\n    ESeq(a, b) => {\\n      collect_bare_array_eq_keys(a, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    EMatch(s, arms) => {\\n      collect_bare_array_eq_keys(s, acc, acc_keys)\\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\\n    },\\n    EHandle(s, arms) => {\\n      collect_bare_array_eq_keys(s, acc, acc_keys)\\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\\n    },\\n    EWhile(c, b) => {\\n      collect_bare_array_eq_keys(c, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    ELoop(params, b) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        collect_bare_array_eq_keys(init, acc, acc_keys)\\n        i = i + 1\\n      }\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    EForIn(_, _, it, b) => {\\n      collect_bare_array_eq_keys(it, acc, acc_keys)\\n      collect_bare_array_eq_keys(b, acc, acc_keys)\\n    },\\n    ECall(callee, args, _) => {\\n      collect_bare_array_eq_keys(callee, acc, acc_keys)\\n      collect_bare_array_eq_keys_list(args, acc, acc_keys)\\n    },\\n    EUnaryOp(_, x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n    EFn(_, _, _, _, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\\n    EDot(o, _, _) => collect_bare_array_eq_keys(o, acc, acc_keys),\\n    ELabeledArg(_, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\\n    EThrow(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n    EReturn(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n    EBreak(opt) => match opt {\\n      Some(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n      None => ()\\n    },\\n    EContinue(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\\n    ESpread(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\\n    _ => ()\\n  }\\n}\\n\\nlet collect_bare_array_eq_keys_list: (Array[Expr], Array[TypeExpr], Array[String]) -> Unit = (es, acc, acc_keys) -> {\\n  let mut i = 0\\n  while i < Array::length(es) {\\n    collect_bare_array_eq_keys(Array::get(es, i), acc, acc_keys)\\n    i = i + 1\\n  }\\n}\\n\\nlet collect_bare_array_eq_keys_arms: (Array[(Pat, Expr)], Array[TypeExpr], Array[String]) -> Unit = (arms, acc, acc_keys) -> {\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (_, b) = Array::get(arms, i)\\n    collect_bare_array_eq_keys(b, acc, acc_keys)\\n    i = i + 1\\n  }\\n}\\n\\nlet collect_decl_type_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out = empty_str_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, name, _, _, _) => Array::push(out, name),\\n      SEnum(_, ename, _, _, _) => Array::push(out, ename),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let desugar_derives: (Array[Stmt]) -> Unit = (stmts) -> {\\n  let gen = empty_stmt_list()\\n  let known_types = collect_decl_type_names(stmts)\\n  let arr_elems = empty_type_exprs()\\n  let arr_keys = empty_str_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, name, fields, derives, _) => {\\n        if (str_array_contains(derives, \\\"Show\\\") || str_array_contains(derives, \\\"Hash\\\")) && !top_level_fn_exists(stmts, qualified_name(name, \\\"to_string\\\")) {\\n          Array::push(gen, gen_show_fn(name, fields, known_types))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Hash\\\") && !top_level_fn_exists(stmts, qualified_name(name, \\\"hash_key\\\")) {\\n          Array::push(gen, gen_hash_key_fn(name))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Show\\\") || str_array_contains(derives, \\\"Hash\\\") {\\n          let mut fi = 0\\n          while fi < Array::length(fields) {\\n            let (_, fty) = Array::get(fields, fi)\\n            collect_show_array_elems(fty, arr_elems, arr_keys)\\n            fi = fi + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Ord\\\") && !top_level_fn_exists(stmts, qualified_name(name, \\\"compare\\\")) {\\n          Array::push(gen, gen_compare_fn(name, fields))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Default\\\") && !top_level_fn_exists(stmts, qualified_name(name, \\\"default\\\")) {\\n          Array::push(gen, gen_default_fn(name, fields, known_types))\\n        } else {\\n          ()\\n        }\\n        if !top_level_fn_exists(stmts, qualified_name(name, \\\"equals\\\")) {\\n          Array::push(gen, gen_eq_fn(name, fields, known_types))\\n        } else {\\n          ()\\n        }\\n      },\\n      SEnum(_, ename, _, variants, derives) => {\\n        if (str_array_contains(derives, \\\"Show\\\") || str_array_contains(derives, \\\"Hash\\\")) && !top_level_fn_exists(stmts, qualified_name(ename, \\\"to_string\\\")) {\\n          Array::push(gen, gen_enum_show_fn(ename, variants, known_types))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Hash\\\") && !top_level_fn_exists(stmts, qualified_name(ename, \\\"hash_key\\\")) {\\n          Array::push(gen, gen_hash_key_fn(ename))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Show\\\") || str_array_contains(derives, \\\"Hash\\\") {\\n          let mut vi = 0\\n          while vi < Array::length(variants) {\\n            let (_, ftypes) = Array::get(variants, vi)\\n            let mut ti = 0\\n            while ti < Array::length(ftypes) {\\n              collect_show_array_elems(Array::get(ftypes, ti), arr_elems, arr_keys)\\n              ti = ti + 1\\n            }\\n            vi = vi + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Ord\\\") && !top_level_fn_exists(stmts, qualified_name(ename, \\\"compare\\\")) {\\n          Array::push(gen, gen_enum_compare_fn(ename, variants, known_types))\\n        } else {\\n          ()\\n        }\\n        if str_array_contains(derives, \\\"Default\\\") && !top_level_fn_exists(stmts, qualified_name(ename, \\\"default\\\")) {\\n          Array::push(gen, gen_enum_default_fn(ename, variants, known_types))\\n        } else {\\n          ()\\n        }\\n        if !top_level_fn_exists(stmts, qualified_name(ename, \\\"equals\\\")) {\\n          Array::push(gen, gen_enum_eq_fn(ename, variants, known_types))\\n        } else {\\n          ()\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  let elem_types = empty_type_exprs()\\n  let elem_keys = empty_str_array()\\n  let mut si = 0\\n  while si < Array::length(stmts) {\\n    match Array::get(stmts, si) {\\n      SStruct(_, _, fields, _, _) => {\\n        let mut fi = 0\\n        while fi < Array::length(fields) {\\n          let (_, fty) = Array::get(fields, fi)\\n          collect_array_elem_types(fty, elem_types, elem_keys)\\n          fi = fi + 1\\n        }\\n      },\\n      SEnum(_, _, _, variants, _) => {\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (_, ftypes) = Array::get(variants, vi)\\n          let mut ti = 0\\n          while ti < Array::length(ftypes) {\\n            collect_array_elem_types(Array::get(ftypes, ti), elem_types, elem_keys)\\n            ti = ti + 1\\n          }\\n          vi = vi + 1\\n        }\\n      },\\n      SLet(_, _, _, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      SLetMut(_, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      SExpr(e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      STest(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      SBench(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\\n      _ => ()\\n    }\\n    si = si + 1\\n  }\\n  let mut wi = 0\\n  while wi < Array::length(elem_types) {\\n    collect_array_elem_types(Array::get(elem_types, wi), elem_types, elem_keys)\\n    wi = wi + 1\\n  }\\n  let mut ei = 0\\n  while ei < Array::length(elem_types) {\\n    let et = Array::get(elem_types, ei)\\n    if !top_level_fn_exists(stmts, arr_equals_name(et)) {\\n      Array::push(gen, gen_arr_equals_fn(et, known_types))\\n    } else {\\n      ()\\n    }\\n    ei = ei + 1\\n  }\\n  let mut wi2 = 0\\n  while wi2 < Array::length(arr_elems) {\\n    collect_show_array_elems(Array::get(arr_elems, wi2), arr_elems, arr_keys)\\n    wi2 = wi2 + 1\\n  }\\n  let mut ei2 = 0\\n  while ei2 < Array::length(arr_elems) {\\n    let et2 = Array::get(arr_elems, ei2)\\n    if !top_level_fn_exists(stmts, arr_to_string_name(et2)) {\\n      Array::push(gen, gen_arr_to_string_fn(et2, known_types))\\n    } else {\\n      ()\\n    }\\n    ei2 = ei2 + 1\\n  }\\n  let mut g = 0\\n  while g < Array::length(gen) {\\n    Array::push(stmts, Array::get(gen, g))\\n    g = g + 1\\n  }\\n}\\n\\nlet empty_stmt_list: () -> Array[Stmt] = () -> {\\n  Array::slice([\\n    SExport([\\n      \\\"\\\"\\n    ])\\n  ], 0, 0)\\n}\\n\\nlet struct_decl_exists: (Array[Stmt], String) -> Bool = (stmts, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(_, sname, _, _, _) => if sname == name {\\n        found = true\\n        i = Array::length(stmts)\\n      } else {\\n        i = i + 1\\n      },\\n      _ => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  found\\n}\\n\\nexport let desugar_trait_dicts: (Array[Stmt]) -> Unit = (stmts) -> {\\n  desugar_derives(stmts)\\n  let traits_raw = collect_method_traits(stmts)\\n  let supers_map = collect_trait_supers(stmts)\\n  let traits = flatten_traits(traits_raw, supers_map)\\n  inject_trait_method_generics_with(stmts, traits)\\n  let struct_sets = collect_struct_field_sets(stmts)\\n  let fn_returns = collect_fn_returns(stmts)\\n  let gimpl_types = collect_generic_impl_types(stmts)\\n  let gens = build_gens(stmts, traits, gimpl_types)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::set(stmts, i, rewrite_stmt(Array::get(stmts, i), gens, traits, struct_sets, fn_returns))\\n    i = i + 1\\n  }\\n  if Array::length(traits_raw) == 0 {\\n    ()\\n  } else {\\n    let mut ti = 0\\n    while ti < Array::length(traits) {\\n      let (trait_name, sigs) = Array::get(traits, ti)\\n      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {\\n        ()\\n      } else {\\n        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs))\\n      }\\n      ti = ti + 1\\n    }\\n  }\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\nlet rec import_cache_lookup: (Array[(String, Type)], String, Int) -> Option[Type] = (cache, name, i) -> {\\n  if i >= Array::length(cache) {\\n    None\\n  }\\n  else {\\n    let (cached_name, cached_ty) = Array::get(cache, i)\\n    if cached_name == name {\\n      Some(cached_ty)\\n    }\\n    else import_cache_lookup(cache, name, i + 1)\\n  }\\n}\\n\\nlet bind_stmt_imports: (TypeEnv, Array[(String, Option[String])]) -> TypeEnv = (env, names) -> {\\n  let env_bindings = env_flat_bindings(env)\\n  let import_cache = Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n  let nlen = Array::length(names)\\n  let mut i = 0\\n  let mut acc = env\\n  while i < nlen {\\n    let (name, alias) = Array::get(names, i)\\n    let bound_name = match alias {\\n      Some(a) => a,\\n      None => name\\n    }\\n    let ty = match import_cache_lookup(import_cache, name, 0) {\\n      Some(t) => t,\\n      None => {\\n        let resolved = match env_lookup_flat(env_bindings, name) {\\n          Some(t) => t,\\n          None => CtUnknown\\n        }\\n        Array::push(import_cache, (name, resolved))\\n        resolved\\n      }\\n    }\\n    let acc_with_name = env_bind(acc, bound_name, ty)\\n    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {\\n      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),\\n      None => acc_with_name\\n    }\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nlet annotation_return_type: (Option[TypeExpr], Array[TypeDef]) -> Option[Type] = (ann, defs) -> {\\n  match ann {\\n    Some(te) => match te {\\n      TyFn(params, ret, _) => {\\n        let ret_box = Array::slice([\\n          ret\\n        ], 0, 1)\\n        let _ = Array::length(params)\\n        Some(resolve_type_expr(Array::get(ret_box, 0), defs))\\n      },\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\nlet fn_expr_return_type: (Expr, Array[TypeDef]) -> Option[Type] = (expr, defs) -> {\\n  match expr {\\n    EFn(_, _, _, ret_ty, _, _) => match ret_ty {\\n      Some(te) => Some(resolve_type_expr(te, defs)),\\n      None => None\\n    },\\n    _ => None\\n  }\\n}\\n\\nlet bind_fn_return: (TypeEnv, String, Type) -> TypeEnv = (env, name, ret_ty) -> {\\n  env_bind(env, fn_return_env_name(name), ret_ty)\\n}\\n\\nlet bind_annotation_return: (TypeEnv, String, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, ann, defs) -> {\\n  match annotation_return_type(ann, defs) {\\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\\n    None => env\\n  }\\n}\\n\\nlet bind_value_or_annotation_return: (TypeEnv, String, Expr, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, val, ann, defs) -> {\\n  match fn_expr_return_type(val, defs) {\\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\\n    None => bind_annotation_return(env, name, ann, defs)\\n  }\\n}\\n\\nlet struct_derives_has: (Array[String], String) -> Bool = (derives, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(derives) {\\n    if Array::get(derives, i) == name {\\n      found = true\\n      i = Array::length(derives)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet derive_name_is_known: (String) -> Bool = (name) -> {\\n  name == \\\"Eq\\\" || name == \\\"Ord\\\" || name == \\\"Show\\\" || name == \\\"Hash\\\" || name == \\\"Default\\\"\\n}\\n\\nlet validate_derives: (Array[String], Array[String]) -> Unit = (derives, errors) -> {\\n  let mut i = 0\\n  while i < Array::length(derives) {\\n    let name = Array::get(derives, i)\\n    if name != \\\"\\\" && !derive_name_is_known(name) {\\n      Array::push(errors, String::concat(\\\"unknown trait: \\\", name))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nlet stmt_is_type_decl: (Stmt) -> Bool = (stmt) -> {\\n  match stmt {\\n    SEnum(_, _, _, _, _) => true,\\n    SSuberror(_, _, _) => true,\\n    SStruct(_, _, _, _, _) => true,\\n    STypeAlias(_, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nlet reorder_type_decls_first: (Array[Stmt], Int) -> Array[Stmt] = (stmts, start) -> {\\n  let out = Array::slice(stmts, 0, start)\\n  let n = Array::length(stmts)\\n  let mut i = start\\n  while i < n {\\n    let st = Array::get(stmts, i)\\n    if stmt_is_type_decl(st) {\\n      Array::push(out, st)\\n    }\\n    i = i + 1\\n  }\\n  let mut j = start\\n  while j < n {\\n    let st = Array::get(stmts, j)\\n    if !stmt_is_type_decl(st) {\\n      Array::push(out, st)\\n    }\\n    j = j + 1\\n  }\\n  out\\n}\\n\\nexport let rec check_stmts: (Array[Stmt], Int, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (TypeEnv, Subst, Int) = (raw_stmts, i, env, defs, s, c, errors, tytab) -> {\\n  let stmts = reorder_type_decls_first(raw_stmts, i)\\n  let mut idx = i\\n  let mut cur_env = env\\n  let mut cur_s = s\\n  let mut cur_c = c\\n  let mut hoist_i = idx\\n  while hoist_i < Array::length(stmts) {\\n    match Array::get(stmts, hoist_i) {\\n      SLet(_, _, hname, hann, _) => {\\n        let ht = match hann {\\n          Some(hte) => resolve_type_expr(hte, defs),\\n          None => CtUnknown\\n        }\\n        cur_env = env_bind(cur_env, hname, ht)\\n      },\\n      _ => ()\\n    }\\n    hoist_i = hoist_i + 1\\n  }\\n  while idx < Array::length(stmts) {\\n    let env = cur_env\\n    let s = cur_s\\n    let c = cur_c\\n    let stmt = Array::get(stmts, idx)\\n    let (new_env, s1, c1) = match stmt {\\n      SLet(_, is_rec, name, ann, val) => {\\n        let (vt, ns0, nc) = if is_rec {\\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors, tytab)\\n        } else {\\n          check_expr(val, env, defs, s, c, errors, tytab)\\n        }\\n        let ns = match ann {\\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\\\"binding type mismatch for \\\", name), 0 - 1),\\n          None => ns0\\n        }\\n        let t = match ann {\\n          Some(te) => resolve_type_expr(te, defs),\\n          None => generalize(ns, vt)\\n        }\\n        let env1 = env_bind(env, name, t)\\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\\n      },\\n      SLetMut(name, ann, val) => {\\n        let (vt, ns0, nc) = check_expr(val, env, defs, s, c, errors, tytab)\\n        let ns = match ann {\\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\\\"binding type mismatch for \\\", name), 0 - 1),\\n          None => ns0\\n        }\\n        let t = match ann {\\n          Some(te) => resolve_type_expr(te, defs),\\n          None => vt\\n        }\\n        let env1 = env_bind(env, name, t)\\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\\n      },\\n      SLetPat(pat, val) => {\\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)\\n        let new_env = match pat {\\n          PTuple(pats) => match vt {\\n            CtTuple(types) => {\\n              let mut e = env\\n              let mut pi = 0\\n              while pi < Array::length(pats) {\\n                match Array::get(pats, pi) {\\n                  PBind(name) => if pi < Array::length(types) {\\n                    e = env_bind(e, name, Array::get(types, pi))\\n                  } else {\\n                    e = env_bind(e, name, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n                pi = pi + 1\\n              }\\n              e\\n            },\\n            _ => {\\n              let concrete_non_tuple = match subst_apply(ns, vt) {\\n                CtInt => true,\\n                CtDouble => true,\\n                CtBool => true,\\n                CtString => true,\\n                CtChar => true,\\n                CtUnit => true,\\n                CtBytes => true,\\n                CtArray(_) => true,\\n                CtOption(_) => true,\\n                CtFn(_, _, _) => true,\\n                CtStruct(_) => true,\\n                CtEnum(_) => true,\\n                _ => false\\n              }\\n              if concrete_non_tuple {\\n                Array::push(errors, \\\"tuple pattern cannot destructure a non-tuple value\\\")\\n              } else {\\n                ()\\n              }\\n              let mut e = env\\n              let mut pi = 0\\n              while pi < Array::length(pats) {\\n                match Array::get(pats, pi) {\\n                  PBind(name) => {\\n                    e = env_bind(e, name, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n                pi = pi + 1\\n              }\\n              e\\n            }\\n          },\\n          PBind(name) => env_bind(env, name, vt),\\n          PStruct(_, fields) => {\\n            let mut e = env\\n            let mut fi = 0\\n            while fi < Array::length(fields) {\\n              let (_, fpat) = Array::get(fields, fi)\\n              match fpat {\\n                PBind(name) => {\\n                  e = env_bind(e, name, CtUnknown)\\n                },\\n                _ => ()\\n              }\\n              fi = fi + 1\\n            }\\n            e\\n          },\\n          _ => env\\n        }\\n        (new_env, ns, nc)\\n      },\\n      SEnum(_, name, params, variants, enum_derives) => {\\n        validate_derives(enum_derives, errors)\\n        let param_len = Array::length(params)\\n        let param_var_ids = Array::slice([\\n          0\\n        ], 0, 0)\\n        let param_var_types = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut pi = 0\\n        while pi < param_len {\\n          let vid = c + pi\\n          Array::push(param_var_ids, vid)\\n          Array::push(param_var_types, CtVar(vid))\\n          pi = pi + 1\\n        }\\n        let ctor_result_type = if param_len == 0 {\\n          CtEnum(name)\\n        } else {\\n          CtNamed(name, param_var_types)\\n        }\\n        let ctor_bounds = Array::slice([\\n          (0, Array::slice([\\n            \\\"\\\"\\n          ], 0, 0))\\n        ], 0, 0)\\n        let resolved_variants = Array::slice([\\n          (\\\"\\\", Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        ], 0, 0)\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, vi)\\n          let resolved_vtypes = Array::slice([\\n            CtUnknown\\n          ], 0, 0)\\n          let mut ti = 0\\n          while ti < Array::length(vtypes) {\\n            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)\\n            Array::push(resolved_vtypes, vt)\\n            ti = ti + 1\\n          }\\n          Array::push(resolved_variants, (vname, resolved_vtypes))\\n          vi = vi + 1\\n        }\\n        Array::push(defs, TDEnum(name, params, resolved_variants))\\n        let mut env1 = env_bind(env, name, CtEnum(name))\\n        let mut ci2 = 0\\n        while ci2 < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, ci2)\\n          let ctor_ty = if Array::length(vtypes) == 0 {\\n            ctor_result_type\\n          } else {\\n            let resolved_args = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            while ai < Array::length(vtypes) {\\n              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)\\n              Array::push(resolved_args, arg_ty)\\n              ai = ai + 1\\n            }\\n            CtFn(resolved_args, ctor_result_type, None)\\n          }\\n          let exported_ctor_ty = if param_len == 0 {\\n            ctor_ty\\n          } else {\\n            CtForAll(param_var_ids, ctor_bounds, ctor_ty)\\n          }\\n          env1 = env_bind(env1, vname, exported_ctor_ty)\\n          match ctor_ty {\\n            CtFn(_, ret, _) => {\\n              let exported_ret_ty = if param_len == 0 {\\n                ret\\n              } else {\\n                CtForAll(param_var_ids, ctor_bounds, ret)\\n              }\\n              env1 = bind_fn_return(env1, vname, exported_ret_ty)\\n            },\\n            _ => ()\\n          }\\n          ci2 = ci2 + 1\\n        }\\n        let env_eq = env_bind(env1, String::concat(name, \\\"::equals\\\"), CtFn([\\n          ctor_result_type,\\n          ctor_result_type\\n        ], CtBool, None))\\n        let env_ord = if struct_derives_has(enum_derives, \\\"Ord\\\") {\\n          env_bind(env_eq, String::concat(name, \\\"::compare\\\"), CtFn([\\n            ctor_result_type,\\n            ctor_result_type\\n          ], CtInt, None))\\n        } else {\\n          env_eq\\n        }\\n        let env_show = if struct_derives_has(enum_derives, \\\"Show\\\") || struct_derives_has(enum_derives, \\\"Hash\\\") {\\n          env_bind(env_ord, String::concat(name, \\\"::to_string\\\"), CtFn([\\n            ctor_result_type\\n          ], CtString, None))\\n        } else {\\n          env_ord\\n        }\\n        let env_hash = if struct_derives_has(enum_derives, \\\"Hash\\\") {\\n          let env_h = EnvTraitImpl(\\\"Hash\\\", ctor_result_type, env_show)\\n          env_bind(env_h, String::concat(name, \\\"::hash_key\\\"), CtFn([\\n            ctor_result_type\\n          ], CtString, None))\\n        } else {\\n          env_show\\n        }\\n        let env_default = if struct_derives_has(enum_derives, \\\"Default\\\") {\\n          env_bind(env_hash, String::concat(name, \\\"::default\\\"), CtFn(Array::slice([\\n            CtUnit\\n          ], 0, 0), ctor_result_type, None))\\n        } else {\\n          env_hash\\n        }\\n        (env_default, s, c + param_len)\\n      },\\n      SStruct(_, name, field_defs, derives, mut_fields) => {\\n        validate_derives(derives, errors)\\n        let resolved_fields = Array::slice([\\n          (\\\"\\\", CtUnit)\\n        ], 0, 0)\\n        let mut fi = 0\\n        while fi < Array::length(field_defs) {\\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\\n          let ftype = resolve_type_expr(ftype_expr, defs)\\n          Array::push(resolved_fields, (fname, ftype))\\n          fi = fi + 1\\n        }\\n        Array::push(defs, TDStruct(name, resolved_fields, mut_fields))\\n        let field_types = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut fj = 0\\n        while fj < Array::length(resolved_fields) {\\n          let (_, fty) = Array::get(resolved_fields, fj)\\n          Array::push(field_types, fty)\\n          fj = fj + 1\\n        }\\n        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))\\n        let env2 = if struct_derives_has(derives, \\\"Ord\\\") {\\n          env_bind(env1, String::concat(name, \\\"::compare\\\"), CtFn([\\n            CtStruct(name),\\n            CtStruct(name)\\n          ], CtInt, None))\\n        } else {\\n          env1\\n        }\\n        let env3 = if struct_derives_has(derives, \\\"Show\\\") || struct_derives_has(derives, \\\"Hash\\\") {\\n          env_bind(env2, String::concat(name, \\\"::to_string\\\"), CtFn([\\n            CtStruct(name)\\n          ], CtString, None))\\n        } else {\\n          env2\\n        }\\n        let env4 = env_bind(env3, String::concat(name, \\\"::equals\\\"), CtFn([\\n          CtStruct(name),\\n          CtStruct(name)\\n        ], CtBool, None))\\n        let env_hash = if struct_derives_has(derives, \\\"Hash\\\") {\\n          let env_h = EnvTraitImpl(\\\"Hash\\\", CtStruct(name), env4)\\n          env_bind(env_h, String::concat(name, \\\"::hash_key\\\"), CtFn([\\n            CtStruct(name)\\n          ], CtString, None))\\n        } else {\\n          env4\\n        }\\n        let env5 = if struct_derives_has(derives, \\\"Default\\\") {\\n          env_bind(env_hash, String::concat(name, \\\"::default\\\"), CtFn(Array::slice([\\n            CtUnit\\n          ], 0, 0), CtStruct(name), None))\\n        } else {\\n          env_hash\\n        }\\n        (bind_fn_return(env5, name, CtStruct(name)), s, c)\\n      },\\n      STypeAlias(_, name, params, te) => {\\n        let t = resolve_type_expr(te, defs)\\n        Array::push(defs, TDAlias(name, params, t))\\n        (env_bind(env, name, t), s, c)\\n      },\\n      SExternLet(name, te) => {\\n        let t = resolve_type_expr(te, defs)\\n        let env1 = env_bind(env, name, t)\\n        (bind_annotation_return(env1, name, Some(te), defs), s, c)\\n      },\\n      STest(_, body) => {\\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SBench(_, body) => {\\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SExpr(expr) => {\\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SModule(_, _, body) => {\\n        let _ = check_stmts(body, 0, env, defs, s, c, errors, tytab)\\n        (env, s, c)\\n      },\\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\\n      ,\\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\\n      ,\\n      SAliasDecl(_, _) => (env, s, c)\\n      ,\\n      STrait(_, name, supers, methods, _) => {\\n        let is_open = false\\n        (EnvTraitDef(name, supers, is_open, methods, env), s, c)\\n      },\\n      SImpl(tparams, tbounds, trait_name, type_name) => {\\n        let target = match resolve_builtin(type_name) {\\n          Some(t) => t,\\n          None => CtNamed(type_name, Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        }\\n        let new_env = if Array::length(tparams) > 0 {\\n          EnvTraitImplGen(trait_name, tparams, tbounds, target, env)\\n        } else {\\n          EnvTraitImpl(trait_name, target, env)\\n        }\\n        (new_env, s, c)\\n      },\\n      _ => (env, s, c)\\n    }\\n    cur_env = new_env\\n    cur_s = s1\\n    cur_c = c1\\n    idx = idx + 1\\n  }\\n  (cur_env, cur_s, cur_c)\\n}\\n\\nlet check_program_bounds: (TypeEnv, Subst, Array[String]) -> Unit = (env, s, errors) -> {\\n  let pairs = collect_subst_bounds_pairs(s)\\n  let n = Array::length(pairs)\\n  let mut i = 0\\n  while i < n {\\n    let (vid, bounds) = Array::get(pairs, i)\\n    let resolved = subst_apply(s, CtVar(vid))\\n    match resolved {\\n      CtVar(_) => (),\\n      CtUnknown => (),\\n      _ => {\\n        let bn = Array::length(bounds)\\n        let mut bi = 0\\n        while bi < bn {\\n          let b = Array::get(bounds, bi)\\n          if b != \\\"\\\" && not(type_implements_trait(env, s, resolved, b)) {\\n            Array::push(errors, String::concat(\\\"no impl `\\\", String::concat(b, String::concat(\\\"` for `\\\", String::concat(type_to_string(resolved), \\\"`\\\")))))\\n          }\\n          bi = bi + 1\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nlet collect_async_effect_errors: (Array[Stmt], TypeEnv, Array[String]) -> Unit = (stmts, env, frozen_errors) -> {\\n  if Array::length(frozen_errors) == 0 {\\n    let eff_errs = check_async_effects_stmts(stmts, env)\\n    let mut i = 0\\n    while i < Array::length(eff_errs) {\\n      Array::push(frozen_errors, effect_error_to_string(Array::get(eff_errs, i)))\\n      i = i + 1\\n    }\\n    if Array::length(frozen_errors) == 0 {\\n      let perform_errs = check_perform_effects_stmts(stmts)\\n      let mut j = 0\\n      while j < Array::length(perform_errs) {\\n        Array::push(frozen_errors, effect_error_to_string(Array::get(perform_errs, j)))\\n        j = j + 1\\n      }\\n    }\\n    if Array::length(frozen_errors) == 0 {\\n      let mut_errs = check_mutability_stmts(stmts)\\n      let mut k = 0\\n      while k < Array::length(mut_errs) {\\n        Array::push(frozen_errors, effect_error_to_string(Array::get(mut_errs, k)))\\n        k = k + 1\\n      }\\n    }\\n  }\\n}\\n\\nexport let check_program: (Array[Stmt]) -> TypeEnv with { Error } = (stmts) -> {\\n  inject_trait_method_generics(stmts)\\n  desugar_railway_binds(stmts)\\n  let empty_defs = Array::slice([\\n    TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n  ], 0, 0)\\n  let seeded_raw_env = if trait_defined(EnvEmpty, \\\"Eq\\\") {\\n    EnvEmpty\\n  } else {\\n    register_builtin_traits(EnvEmpty)\\n  }\\n  let seeded_env = env_cache(seeded_raw_env)\\n  let errors = ArrayBuilder::new()\\n  let frozen_errors = ArrayBuilder::freeze(errors)\\n  let tytab = Array::slice([\\n    (0, CtUnit)\\n  ], 0, 0)\\n  let (env, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n  check_program_bounds(env, final_s, frozen_errors)\\n  collect_async_effect_errors(stmts, env, frozen_errors)\\n  if Array::length(frozen_errors) > 0 {\\n    throw(Array::get(frozen_errors, 0))\\n  }\\n  env\\n}\\n\\nexport let check_program_type_table: (Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error } = (stmts) -> {\\n  let empty_defs = Array::slice([\\n    TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n  ], 0, 0)\\n  let seeded_raw_env = if trait_defined(EnvEmpty, \\\"Eq\\\") {\\n    EnvEmpty\\n  } else {\\n    register_builtin_traits(EnvEmpty)\\n  }\\n  let seeded_env = env_cache(seeded_raw_env)\\n  let errors = ArrayBuilder::new()\\n  let frozen_errors = ArrayBuilder::freeze(errors)\\n  let tytab = Array::slice([\\n    (0, CtUnit)\\n  ], 0, 0)\\n  handle {\\n    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n    (tytab, final_s)\\n  } with Error {\\n    Throw(_) => (tytab, SubstEmpty)\\n  }\\n}\\n\\nexport let check_program_with_env: (Array[Stmt], TypeEnv) -> TypeEnv with { Error } = (stmts, initial_env) -> {\\n  match initial_env {\\n    EnvEmpty => check_program(stmts),\\n    _ => {\\n      inject_trait_method_generics(stmts)\\n      desugar_railway_binds(stmts)\\n      let empty_defs = Array::slice([\\n        TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n      ], 0, 0)\\n      let cached_env = env_cache(initial_env)\\n      let seeded_raw_env = if trait_defined(cached_env, \\\"Eq\\\") {\\n        cached_env\\n      } else {\\n        register_builtin_traits(cached_env)\\n      }\\n      let seeded_env = env_cache(seeded_raw_env)\\n      let errors = ArrayBuilder::new()\\n      let frozen_errors = ArrayBuilder::freeze(errors)\\n      let tytab = Array::slice([\\n        (0, CtUnit)\\n      ], 0, 0)\\n      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n      collect_async_effect_errors(stmts, env, frozen_errors)\\n      if Array::length(frozen_errors) > 0 {\\n        throw(Array::get(frozen_errors, 0))\\n      }\\n      env\\n    }\\n  }\\n}\\n\\n\\n\\nexport let emit_end: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, 11)\\n}\\n\\nexport let emit_i32_const: (Bytes, Int) -> Unit = (buf, value) -> {\\n  bytebuf_push_opcode_s64(buf, 65, value)\\n}\\n\\nexport let emit_code_section: (Bytes, Array[Bytes]) -> Unit = (out, bodies) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(bodies))\\n  let mut i = 0\\n  while i < Array::length(bodies) {\\n    let body = Array::get(bodies, i)\\n    let func_buf = bytebuf_new()\\n    leb128_encode_u32(func_buf, 0)\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(content, func_buf)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 10, content)\\n}\\n\\nexport let emit_memory_section: (Bytes, Int) -> Unit = (out, min_pages) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, min_pages)\\n  bytebuf_push_section(out, 5, content)\\n}\\n\\nexport let emit_code_section_with_locals: (Bytes, Array[Bytes], Array[Int]) -> Unit = (out, bodies, local_counts) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(bodies))\\n  let mut i = 0\\n  while i < Array::length(bodies) {\\n    let body = Array::get(bodies, i)\\n    let num_locals = Array::get(local_counts, i)\\n    let func_buf = bytebuf_new()\\n    if num_locals == 0 {\\n      leb128_encode_u32(func_buf, 0)\\n    } else {\\n      leb128_encode_u32(func_buf, 1)\\n      leb128_encode_u32(func_buf, num_locals)\\n      bytebuf_push(func_buf, 126)\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(content, func_buf)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 10, content)\\n}\\n\\n\\n\\nexport let emit_header: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push3(buf, 0, 97, 115)\\n  bytebuf_push3(buf, 109, 1, 0)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n}\\n\\n\\n\\nexport let emit_func_type: (Bytes, Int, Int) -> Unit = (buf, param_count, result_count) -> {\\n  bytebuf_push(buf, 96)\\n  leb128_encode_u32(buf, param_count)\\n  let mut i = 0\\n  while i < param_count {\\n    bytebuf_push(buf, 126)\\n    i = i + 1\\n  }\\n  leb128_encode_u32(buf, result_count)\\n  let mut j = 0\\n  while j < result_count {\\n    bytebuf_push(buf, 126)\\n    j = j + 1\\n  }\\n}\\n\\nexport let emit_type_section_multi: (Bytes, Array[Int]) -> Unit = (out, type_defs) -> {\\n  let count = Array::length(type_defs) / 2\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 1, content)\\n}\\n\\nexport let emit_type_section: (Bytes, Int, Int) -> Unit = (out, param_count, result_count) -> {\\n  let type_defs = Array::slice([\\n    0\\n  ], 0, 0)\\n  Array::push(type_defs, param_count)\\n  Array::push(type_defs, result_count)\\n  emit_type_section_multi(out, type_defs)\\n}\\n\\n\\n\\n\\nexport {\\n  emit_header, emit_func_type, emit_type_section, emit_type_section_multi\\n}\\n\\n\\n\\nexport let emit_name: (Bytes, String) -> Unit = (buf, name) -> {\\n  bytebuf_push_string(buf, name)\\n}\\n\\nexport let emit_function_section: (Bytes, Array[Int]) -> Unit = (out, type_indices) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(type_indices))\\n  let mut i = 0\\n  while i < Array::length(type_indices) {\\n    leb128_encode_u32(content, Array::get(type_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 3, content)\\n}\\n\\nexport let emit_export_section_multi: (Bytes, Array[String], Array[Int]) -> Unit = (out, names, func_indices) -> {\\n  let count = Array::length(names)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    emit_name(content, Array::get(names, i))\\n    bytebuf_push(content, 0)\\n    leb128_encode_u32(content, Array::get(func_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 7, content)\\n}\\n\\nexport let emit_export_section: (Bytes, String, Int) -> Unit = (out, name, func_idx) -> {\\n  emit_export_section_multi(out, [\\n    name\\n  ], [\\n    func_idx\\n  ])\\n}\\n\\n\\n\\n\\nexport {\\n  emit_name, emit_header, emit_func_type, emit_type_section, emit_export_section, emit_function_section, emit_type_section_multi, emit_export_section_multi\\n}\\n\\n\\n\\n\\nexport {\\n  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_code_section, emit_type_section, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_export_section_multi, emit_code_section_with_locals\\n}\\n\\n\\n\\n\\nlet vt_i32 = 127\\n\\nlet sec_data = 11\\n\\nlet type_func = 96\\n\\nlet sec_export = 7\\n\\nlet sec_global = 6\\n\\nlet sec_import = 2\\n\\nlet export_func = 0\\n\\nlet export_memory = 2\\n\\nlet op_global_get = 35\\n\\nlet op_global_set = 36\\n\\nlet op_i32_add = 106\\n\\nlet op_i32_sub = 107\\n\\nlet op_i32_shr_u = 118\\n\\nlet op_i32_gt_u = 75\\n\\nlet op_memory_size = 63\\n\\nlet op_memory_grow = 64\\n\\nlet op_drop = 26\\n\\nlet op_if = 4\\n\\nlet bt_void = 64\\n\\nexport let emit_global_get: (Bytes, Int) -> Unit = (buf, idx) -> {\\n  bytebuf_push_opcode_u32(buf, op_global_get, idx)\\n}\\n\\nexport let emit_heap_memory_grow_check: (Bytes) -> Unit = (buf) -> {\\n  emit_global_get(buf, 0)\\n  emit_i32_const(buf, 65536)\\n  bytebuf_push(buf, op_i32_add)\\n  emit_i32_const(buf, 16)\\n  bytebuf_push(buf, op_i32_shr_u)\\n  bytebuf_push2(buf, op_memory_size, 0)\\n  bytebuf_push(buf, op_i32_gt_u)\\n  bytebuf_push2(buf, op_if, bt_void)\\n  emit_global_get(buf, 0)\\n  emit_i32_const(buf, 65536)\\n  bytebuf_push(buf, op_i32_add)\\n  emit_i32_const(buf, 16)\\n  bytebuf_push(buf, op_i32_shr_u)\\n  bytebuf_push2(buf, op_memory_size, 0)\\n  bytebuf_push(buf, op_i32_sub)\\n  bytebuf_push2(buf, op_memory_grow, 0)\\n  bytebuf_push(buf, op_drop)\\n  emit_end(buf)\\n}\\n\\nexport let emit_global_set: (Bytes, Int) -> Unit = (buf, idx) -> {\\n  bytebuf_push_opcode_u32(buf, op_global_set, idx)\\n}\\n\\nexport let emit_data_section: (Bytes, Int, Bytes) -> Unit = (out, offset, data) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  emit_i32_const(content, offset)\\n  emit_end(content)\\n  leb128_encode_u32(content, Bytes::length(data))\\n  bytebuf_push_buf(content, data)\\n  bytebuf_push_section(out, sec_data, content)\\n}\\n\\nexport let emit_exports_full: (Bytes, Array[String], Array[Int], String, Int, Array[String], Array[Int]) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx, global_names, global_indices) -> {\\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < Array::length(fn_names) {\\n    emit_name(content, Array::get(fn_names, i))\\n    bytebuf_push(content, export_func)\\n    leb128_encode_u32(content, Array::get(fn_indices, i))\\n    i = i + 1\\n  }\\n  emit_name(content, mem_name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  let mut gi = 0\\n  while gi < Array::length(global_names) {\\n    emit_name(content, Array::get(global_names, gi))\\n    bytebuf_push(content, 3)\\n    leb128_encode_u32(content, Array::get(global_indices, gi))\\n    gi = gi + 1\\n  }\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport let emit_export_memory: (Bytes, String, Int) -> Unit = (out, name, mem_idx) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  emit_name(content, name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport let emit_func_type_raw: (Bytes, Array[Int], Array[Int]) -> Unit = (buf, param_types, result_types) -> {\\n  bytebuf_push(buf, type_func)\\n  leb128_encode_u32(buf, Array::length(param_types))\\n  let mut i = 0\\n  while i < Array::length(param_types) {\\n    bytebuf_push(buf, Array::get(param_types, i))\\n    i = i + 1\\n  }\\n  leb128_encode_u32(buf, Array::length(result_types))\\n  let mut j = 0\\n  while j < Array::length(result_types) {\\n    bytebuf_push(buf, Array::get(result_types, j))\\n    j = j + 1\\n  }\\n}\\n\\nexport let emit_exports_with_memory: (Bytes, Array[String], Array[Int], String, Int) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx) -> {\\n  let count = Array::length(fn_names) + 1\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < Array::length(fn_names) {\\n    emit_name(content, Array::get(fn_names, i))\\n    bytebuf_push(content, export_func)\\n    leb128_encode_u32(content, Array::get(fn_indices, i))\\n    i = i + 1\\n  }\\n  emit_name(content, mem_name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport let emit_import_section_func: (Bytes, String, String, Int) -> Unit = (out, module_name, field_name, type_idx) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  emit_name(content, module_name)\\n  emit_name(content, field_name)\\n  bytebuf_push(content, export_func)\\n  leb128_encode_u32(content, type_idx)\\n  bytebuf_push_section(out, sec_import, content)\\n}\\n\\nexport let emit_global_section_i32_mut: (Bytes, Int) -> Unit = (out, init_value) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push2(content, vt_i32, 1)\\n  emit_i32_const(content, init_value)\\n  emit_end(content)\\n  bytebuf_push_section(out, sec_global, content)\\n}\\n\\n\\n\\nexport let emit_function_name_section: (Bytes, Array[String], Int) -> Unit = (out, names, base_index) -> {\\n  let count = Array::length(names)\\n  if count == 0 {\\n    ()\\n  } else {\\n    let content = bytebuf_new()\\n    bytebuf_push_string(content, \\\"name\\\")\\n    let namemap = bytebuf_new()\\n    leb128_encode_u32(namemap, count)\\n    let mut i = 0\\n    while i < count {\\n      leb128_encode_u32(namemap, base_index + i)\\n      bytebuf_push_string(namemap, Array::get(names, i))\\n      i = i + 1\\n    }\\n    bytebuf_push_section(content, 1, namemap)\\n    bytebuf_push_section(out, 0, content)\\n  }\\n}\\n\\nlet emit_ascii_payload: (Bytes, String) -> Unit = (buf, text) -> {\\n  let len = String::length(text)\\n  let mut i = 0\\n  while i < len {\\n    bytebuf_push(buf, String::char_code_at(text, i))\\n    i = i + 1\\n  }\\n}\\n\\nexport let emit_vibe_abi_custom_section: (Bytes, String) -> Unit = (out, host_import_abi) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_string(content, \\\"vibe.abi\\\")\\n  emit_ascii_payload(content, \\\"version=1\\\\n\\\")\\n  emit_ascii_payload(content, String::concat(\\\"host_import_abi=\\\", host_import_abi))\\n  emit_ascii_payload(content, \\\"\\\\n\\\")\\n  bytebuf_push_section(out, 0, content)\\n}\\n\\n\\n\\n\\n\\nexport {\\n  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_global_get, emit_global_set, emit_heap_memory_grow_check, emit_code_section, emit_data_section, emit_exports_full, emit_type_section, emit_export_memory, emit_func_type_raw, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_exports_with_memory, emit_import_section_func, emit_export_section_multi, emit_global_section_i32_mut, emit_code_section_with_locals, emit_vibe_abi_custom_section, emit_function_name_section\\n}\\n\\n\\n\\n\\nlet op_br = 12\\n\\nlet op_if = 4\\n\\nlet bt_i64 = 126\\n\\nlet bt_void = 64\\n\\nexport let emit_br: (Bytes, Int) -> Unit = (buf, label) -> {\\n  bytebuf_push_opcode_u32(buf, op_br, label)\\n}\\n\\nlet op_call = 16\\n\\nlet op_drop = 26\\n\\nlet op_else = 5\\n\\nlet op_loop = 3\\n\\nlet op_block = 2\\n\\nlet op_br_if = 13\\n\\nexport let emit_call: (Bytes, Int) -> Unit = (buf, func_idx) -> {\\n  bytebuf_push_opcode_u32(buf, op_call, func_idx)\\n}\\n\\nexport let emit_drop: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_drop)\\n}\\n\\nexport let emit_else: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_else)\\n}\\n\\nlet op_f64_eq = 97\\n\\nlet op_f64_ge = 102\\n\\nlet op_f64_gt = 100\\n\\nlet op_f64_le = 101\\n\\nlet op_f64_lt = 99\\n\\nlet op_f64_ne = 98\\n\\nlet op_i64_eq = 81\\n\\nlet op_i64_ne = 82\\n\\nlet op_i64_or = 132\\n\\nlet op_return = 15\\n\\nlet sec_table = 4\\n\\nexport let emit_br_if: (Bytes, Int) -> Unit = (buf, label) -> {\\n  bytebuf_push_opcode_u32(buf, op_br_if, label)\\n}\\n\\nlet op_f64_add = 160\\n\\nlet op_f64_div = 163\\n\\nlet op_f64_mul = 162\\n\\nlet op_f64_neg = 154\\n\\nlet op_f64_sub = 161\\n\\nlet op_i32_add = 106\\n\\nlet op_i64_add = 124\\n\\nlet op_i64_and = 131\\n\\nlet op_i64_eqz = 80\\n\\nlet op_i64_mul = 126\\n\\nlet op_i64_shl = 134\\n\\nlet op_i64_sub = 125\\n\\nlet op_i64_xor = 133\\n\\nexport let emit_f64_eq: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_f64_eq)\\n}\\n\\nexport let emit_f64_ge: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_f64_ge)\\n}\\n\\nexport let emit_f64_gt: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_f64_gt)\\n}\\n\\nexport let emit_f64_le: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_f64_le)\\n}\\n\\nexport let emit_f64_lt: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_f64_lt)\\n}\\n\\nexport let emit_f64_ne: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_f64_ne)\\n}\\n\\nexport let emit_i64_eq: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i6