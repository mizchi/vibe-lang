let selfhost_source_169 = () -> (String, String) {
  ("vibe/compiler/entry/compiler/fs_compile/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nlet empty_stmt_array: () -> Array[Stmt] = () -> {\n  Array::slice([\n    SExport([\"_dummy\"])\n  ], 0, 0)\n}\n\nlet seed_type_db: (TypeDb, String, String, Array[(String, String)]) -> TypeDb = (db, main_path, main_source, sources) -> {\n  let mut seeded = db\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    seeded = db_set_source(seeded, path, source)\n    i = i + 1\n  }\n  db_set_source(seeded, main_path, main_source)\n}\n\nlet flatten_source_groups: (Array[(String, Array[(String, String)])]) -> Array[(String, String)] = (source_groups) -> {\n  let flat = Array::slice([(\"\", \"\")], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nlet normalize_source_groups: (Array[(String, Array[(String, String)])], String, String) -> Array[(String, Array[(String, String)])] = (source_groups, main_path, main_source) -> {\n  let normalized = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (group_name, sources) = Array::get(source_groups, gi)\n    let next_sources = Array::slice([(\"\", \"\")], 0, 0)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if path == main_path {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nlet contains_source_path: (Array[(String, String)], String) -> Bool = (sources, target_path) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(sources) && !found {\n    let (path, _) = Array::get(sources, i)\n    if path == target_path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet filter_source_groups: (Array[(String, Array[(String, String)])], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (source_groups, ordered_sources) -> {\n  let filtered_groups = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (group_name, sources) = Array::get(source_groups, gi)\n    let next_sources = Array::slice([(\"\", \"\")], 0, 0)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      if contains_source_path(ordered_sources, path) {\n        Array::push(next_sources, pair)\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered_groups, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered_groups\n}\n\nexport let source_group_total_source_count: (Array[(String, Array[(String, String)])]) -> Int = (source_groups) -> {\n  let mut total = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    total = total + Array::length(sources)\n    gi = gi + 1\n  }\n  total\n}\n\nexport let source_group_ordered_source_count: (String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (main_source, main_path, source_groups) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  Array::length(ordered_sources)\n}\n\nexport let source_group_filtered_group_count: (String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (main_source, main_path, source_groups) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  Array::length(filtered_groups)\n}\n\nlet string_array_contains_local: (Array[String], String) -> Bool = (items, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet append_inline_import_alias_collision_defs: (Array[Stmt], String, Array[Stmt], Array[(String, String)]) -> Unit with { Error } = (merged, current_path, stmts, sources) -> {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains_local(emitted, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      let source = source_lookup_or_throw(sources, resolved)\n      let source_stmts = namespace_private_value_stmts(\n        resolved,\n        parse_program(lex(source))\n      )\n      let mut j = 0\n      let mut done = false\n      while j < Array::length(source_stmts) && !done {\n        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n          Some(local_stmt) => {\n            Array::push(merged, local_stmt)\n            Array::push(emitted, local)\n            done = true\n          },\n          None => ()\n        }\n        j = j + 1\n      }\n    }\n    i = i + 1\n  }\n}\n\nexport let prepare_modules_cached: (TypeDb, String, String, Array[(String, String)]) -> TypeDb with { Error } = (db, main_path, main_source, sources) -> {\n  let seeded = seed_type_db(db, main_path, main_source, sources)\n  db_typecheck(seeded, main_path)\n}\n\nlet prepare_modules_persistent_fs_cached: (TypeDb, String, String, Array[(String, String)]) -> TypeDb with { Error, Fs } = (db, main_path, main_source, sources) -> {\n  let seeded = seed_type_db(db, main_path, main_source, sources)\n  db_typecheck_fs(seeded, main_path)\n}\n\nexport let source_group_prepare_typecheck_count: (TypeDb, String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (db, main_source, main_path, source_groups) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  db_typecheck_count(next_db)\n}\n\nexport let grouped_source_merged_len: (TypeDb, String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (db, main_source, main_path, source_groups) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  let (merged_source, _, _) = db_grouped_merged_source(next_db, filtered_groups)\n  String::length(merged_source)\n}\n\nexport let source_group_module_source_len: (TypeDb, String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (db, main_source, main_path, source_groups) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, _) = db_module_source(module_db, merge_fingerprint, merged_source)\n  String::length(module_source)\n}\n\nexport let compile_with_modules: (String, String, Array[(String, String)]) -> Bytes with { Error } = (main_source, main_path, sources) -> {\n  let (bytes, _) = compile_with_modules_cached(db_new(), main_source, main_path, sources)\n  bytes\n}\n\nexport let compile_with_modules_wasi: (String, String, Array[(String, String)], String) -> Bytes with { Error } = (main_source, main_path, sources, entry_name) -> {\n  let (bytes, _) = compile_with_modules_wasi_cached(db_new(), main_source, main_path, sources, entry_name)\n  bytes\n}\n\nlet artifact_fingerprint_from_source: (String) -> String = (source) -> {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet build_merge_fingerprint_inline: (Array[(String, String)]) -> String = (sources) -> {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", artifact_fingerprint_from_source(source))\n    )\n    acc = artifact_fingerprint_from_source(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_merged_stmts_inline: (Array[(String, String)]) -> Array[Stmt] with { Error } = (sources) -> {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let mut si = 0\n  while si < source_count {\n    let (path, source) = Array::get(sources, si)\n    let stmts = parse_program(lex(source))\n    let namespaced_stmts = if si == source_count - 1 {\n      stmts\n    } else {\n      namespace_private_value_stmts(path, stmts)\n    }\n    let skipped_locals = collect_import_alias_collision_locals(stmts)\n    append_inline_import_alias_collision_defs(merged, path, stmts, sources)\n    append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)\n    si = si + 1\n  }\n  merged\n}\n\nlet prune_entry_stmts: (Array[Stmt], String) -> Array[Stmt] = (stmts, entry_name) -> {\n  dce_stmts(stmts, [entry_name])\n}\n\nexport let closure_ordered_source_count: (String, String, Array[(String, String)]) -> Int with { Error } = (main_source, main_path, sources) -> {\n  Array::length(collect_inline_sources_ordered(main_path, main_source, sources))\n}\n\nexport let closure_merged_stmt_count: (String, String, Array[(String, String)]) -> Int with { Error } = (main_source, main_path, sources) -> {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  Array::length(merged_stmts)\n}\n\nexport let closure_pruned_stmt_count: (String, String, Array[(String, String)], String) -> Int with { Error } = (main_source, main_path, sources, entry_name) -> {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n  Array::length(pruned_stmts)\n}\n\nexport let source_group_pruned_stmt_count: (TypeDb, String, String, Array[(String, Array[(String, String)])], String) -> Int with { Error } = (db, main_source, main_path, source_groups, entry_name) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let _ = db\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n  Array::length(pruned_stmts)\n}\n\nexport let compile_with_modules_cached: (TypeDb, String, String, Array[(String, String)]) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources) -> {\n  let next_db = prepare_modules_cached(db, main_path, main_source, sources)\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let (merged_source, merge_fingerprint, merge_db) = db_merged_source(next_db, main_path, ordered_sources)\n  let (module_source, codegen_db) = db_module_source(merge_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n  match db_load_artifact(codegen_db, main_path, \"module\", \"\", artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let stmts = parse_program(lex(module_source))\n      let bytes = compile_module(stmts)\n      (bytes, db_store_artifact(codegen_db, main_path, \"module\", \"\", artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_modules_wasi_cached: (TypeDb, String, String, Array[(String, String)], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources, entry_name) -> {\n  let next_db = prepare_modules_cached(db, main_path, main_source, sources)\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_cached: (TypeDb, String, String, Array[(String, String)], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources, entry_name) -> {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_mode_cached: (TypeDb, String, String, Array[(String, String)], String, String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources, entry_name, mode) -> {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_kind = if mode == \"mvp\" {\n    \"wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))\n  )\n  match db_load_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let bytes = if mode == \"mvp\" {\n        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n        compile_wasi_module_impl(pruned_stmts, entry_name)\n      } else {\n        compile_wasi_module(merged_stmts, entry_name)\n      }\n      (bytes, db_store_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_unchecked_cached: (TypeDb, String, String, Array[(String, String)], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources, entry_name) -> {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_mode_unchecked_cached: (TypeDb, String, String, Array[(String, String)], String, String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources, entry_name, mode) -> {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_kind = if mode == \"mvp\" {\n    \"wasi-mvp-unchecked\"\n  } else if mode == \"no-dce\" {\n    \"wasi-unchecked\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))\n  )\n  match db_load_artifact(db, main_path, artifact_kind, entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let bytes = if mode == \"mvp\" {\n        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n        compile_wasi_module_impl(pruned_stmts, entry_name)\n      } else {\n        compile_wasi_module(merged_stmts, entry_name)\n      }\n      (bytes, db_store_artifact(db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_mode_unchecked: (String, String, Array[(String, String)], String, String) -> Bytes with { Error } = (main_source, main_path, sources, entry_name, mode) -> {\n  let (bytes, _) = compile_with_closure_sources_wasi_mode_unchecked_cached(\n    db_new(),\n    main_source,\n    main_path,\n    sources,\n    entry_name,\n    mode\n  )\n  bytes\n}\n\nexport let compile_with_closure_sources_wasi_mode_uncached: (String, String, Array[(String, String)], String, String) -> Bytes with { Error } = (main_source, main_path, sources, entry_name, mode) -> {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  if mode == \"mvp\" {\n    let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\nexport let compile_with_source_groups_wasi_cached: (TypeDb, String, String, Array[(String, Array[(String, String)])], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, source_groups, entry_name) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  let (merged_source, merge_fingerprint, codegen_db) = db_grouped_merged_source(next_db, filtered_groups)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let merged_stmts = parse_program(lex(merged_source))\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_source_groups_wasi_unchecked_cached: (TypeDb, String, String, Array[(String, Array[(String, String)])], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, source_groups, entry_name) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, merge_db) = db_grouped_merged_source(db, filtered_groups)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(merge_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, merge_db),\n    None => {\n      let merged_stmts = parse_program(lex(merged_source))\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(merge_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_source_groups_via_module_source_wasi_unchecked_cached: (TypeDb, String, String, Array[(String, Array[(String, String)])], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, source_groups, entry_name) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(module_source, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi-module-source\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let module_stmts = parse_program(lex(module_source))\n      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)\n      let bytes = compile_wasi_module_impl(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi-module-source\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_source_groups_via_module_source_wasi_unchecked_rc: (TypeDb, String, String, Array[(String, Array[(String, String)])], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, source_groups, entry_name) -> {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(module_source, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi-module-source-rc\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let module_stmts = parse_program(lex(module_source))\n      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)\n      let bytes = compile_wasi_module_rc_impl(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi-module-source-rc\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_file_fs: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport let compile_file_fs_module: (String) -> Bytes with { Error, Fs } = (entry_path) -> {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n\nexport let prepare_file_fs_cached: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, entry_path) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nlet prepare_file_fs_from_source_groups_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error } = (db, entry_path, source_groups) -> {\n  let sources = flatten_source_groups(source_groups)\n  let main_source = source_lookup_or_throw(sources, entry_path)\n  prepare_modules_cached(db, entry_path, main_source, sources)\n}\n\nlet prepare_file_fs_from_source_groups_persistent_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } = (db, entry_path, source_groups) -> {\n  let sources = flatten_source_groups(source_groups)\n  let main_source = source_lookup_or_throw(sources, entry_path)\n  prepare_modules_persistent_fs_cached(db, entry_path, main_source, sources)\n}\n\nlet compile_file_fs_cached_slow: (TypeDb, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_fs_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name\n  )\n  match load_persistent_artifact(\"fs-compile-wasi\", entry_name, persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, _, codegen_db) = db_grouped_merged_source(next_db, source_groups)\n      let artifact_fingerprint = artifact_fingerprint_from_source(merged_source)\n      match db_load_artifact(codegen_db, entry_path, \"wasi\", entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(merged_source))\n          let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n          let bytes = compile_wasi_module(pruned_stmts, entry_name)\n          store_persistent_artifact(\n            \"fs-compile-wasi\",\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_cached: (TypeDb, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name) -> {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"fs-compile-wasi\",\n        entry_name,\n        build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_cached_slow(db, entry_path, entry_name)\n      },\n    None => compile_file_fs_cached_slow(db, entry_path, entry_name)\n  }\n}\n\nlet compile_file_fs_module_cached_slow: (TypeDb, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_fs_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\"fs-compile-module\", \"\", persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"fs-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_module_cached: (TypeDb, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path) -> {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"fs-compile-module\",\n        \"\",\n        build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n")
}

let selfhost_source_170 = () -> (String, String) {
  ("vibe/compiler/entry/compiler/fs_compile/closure_order.vibe",
"\n\n\n\nlet dir_of: (String) -> String = (file_path) -> {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else {\n    file_path[0: idx]\n  }\n}\n\nlet contains_int: (Array[Int], Int) -> Bool = (arr, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if !found && Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet normalize_path: (String) -> String = (path) -> {\n  let mut parts = Array::slice([\n    \"\"\n  ], 0, 0)\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(path, i) == 47 {\n      let part = path[start: i]\n      if String::length(part) == 0 || part == \".\" {\n        ()\n      } else if part == \"..\" {\n        if Array::length(parts) > 0 {\n          parts = Array::slice(parts, 0, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  let out = StringBuilder::new()\n  i = 0\n  while i < Array::length(parts) {\n    if i > 0 {\n      StringBuilder::push(out, \"/\")\n    }\n    StringBuilder::push(out, Array::get(parts, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nlet resolve_path: (String, String) -> String = (base_dir, raw_path) -> {\n  let len = String::length(raw_path)\n  let joined = if (len >= 2 && raw_path[0: 2] == \"./\") ||\n  (len >= 3 && raw_path[0: 3] == \"../\") {\n    if base_dir == \"\" {\n      raw_path\n    } else {\n      String::concat(base_dir, String::concat(\"/\", raw_path))\n    }\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\nlet source_find_index: (Array[(String, String)], String) -> Int = (sources, path_key) -> {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(sources) {\n    let (path, _) = Array::get(sources, i)\n    if path == path_key {\n      found = i\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let source_lookup_exists: (Array[(String, String)], String) -> Bool = (sources, path_key) -> {\n  source_find_index(sources, path_key) >= 0\n}\n\nlet normalize_all_sources: (String, String, Array[(String, String)]) -> (Array[(String, String)], Int) = (main_path, main_source, sources) -> {\n  let all_sources = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    Array::push(all_sources, Array::get(sources, si))\n    si = si + 1\n  }\n  let mut main_index = source_find_index(all_sources, main_path)\n  if main_index < 0 {\n    Array::push(all_sources, (main_path, main_source))\n    main_index = Array::length(all_sources) - 1\n  }\n  (all_sources, main_index)\n}\n\nexport let source_lookup_or_throw: (Array[(String, String)], String) -> String with { Error } = (sources, path_key) -> {\n  let idx = source_find_index(sources, path_key)\n  if idx < 0 {\n    throw(String::concat(\"module not found: \", path_key))\n  } else {\n    let (_, source) = Array::get(sources, idx)\n    source\n  }\n}\n\nexport let source_lookup_exists_for_test: (Array[(String, String)], String) -> Bool = (sources, path_key) -> {\n  source_lookup_exists(sources, path_key)\n}\n\nexport let resolve_relative_path_for_test: (String, String) -> String = (base_dir, raw_path) -> {\n  resolve_path(base_dir, raw_path)\n}\n\nexport let first_import_resolved_path_for_test: (String, String) -> String with { Error } = (main_source, main_path) -> {\n  let stmts = parse_program(lex(main_source))\n  let base_dir = dir_of(main_path)\n  let mut i = 0\n  let mut resolved = \"\"\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => {\n        resolved = resolve_path(base_dir, raw_path)\n        i = Array::length(stmts)\n      },\n      SReExport(raw_path, _) => {\n        resolved = resolve_path(base_dir, raw_path)\n        i = Array::length(stmts)\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  resolved\n}\n\nexport let first_import_source_len_for_test: (String, String, Array[(String, String)]) -> Int with { Error } = (main_source, main_path, sources) -> {\n  let resolved = first_import_resolved_path_for_test(main_source, main_path)\n  let mut si = 0\n  let mut found = None\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    if path == resolved {\n      found = Some(source)\n      si = Array::length(sources)\n    } else {\n      si = si + 1\n    }\n  }\n  match found {\n    Some(source) => String::length(source),\n    None => throw(String::concat(\"module not found: \", resolved))\n  }\n}\n\nexport let source_lookup_or_throw_len_for_test: (Array[(String, String)], String) -> Int with { Error } = (sources, path_key) -> {\n  String::length(source_lookup_or_throw(sources, path_key))\n}\n\nlet collect_inline_source_indexes_ordered: (Array[(String, String)], Int) -> Array[Int] with { Error } = (all_sources, main_index) -> {\n  let ordered_indexes = Array::slice([\n    0\n  ], 0, 0)\n  let visited = Array::slice([\n    0\n  ], 0, 0)\n  let mut stack = Array::slice([\n    (0, false)\n  ], 0, 0)\n  Array::push(stack, (main_index, false))\n  while Array::length(stack) > 0 {\n    let stack_len = Array::length(stack)\n    let (source_index, expanded) = Array::get(stack, stack_len - 1)\n    stack = Array::slice(stack, 0, stack_len - 1)\n    if expanded {\n      Array::push(ordered_indexes, source_index)\n    } else if contains_int(visited, source_index) {\n      ()\n    } else {\n      Array::push(visited, source_index)\n      Array::push(stack, (source_index, true))\n      let deps = Array::slice([\n        0\n      ], 0, 0)\n      let (path, source) = Array::get(all_sources, source_index)\n      let stmts = parse_program(lex(source))\n      let base_dir = dir_of(path)\n      let mut i = 0\n      while i < Array::length(stmts) {\n        match Array::get(stmts, i) {\n          SImport(raw_path, _) => {\n            let resolved = resolve_path(base_dir, raw_path)\n            let dep_index = source_find_index(all_sources, resolved)\n            if dep_index < 0 {\n              throw(String::concat(\"module not found: \", resolved))\n            }\n            Array::push(deps, dep_index)\n          },\n          SReExport(raw_path, _) => {\n            let resolved = resolve_path(base_dir, raw_path)\n            let dep_index = source_find_index(all_sources, resolved)\n            if dep_index < 0 {\n              throw(String::concat(\"module not found: \", resolved))\n            }\n            Array::push(deps, dep_index)\n          },\n          _ => ()\n        }\n        i = i + 1\n      }\n      let mut di = Array::length(deps)\n      while di > 0 {\n        let dep_index = Array::get(deps, di - 1)\n        Array::push(stack, (dep_index, false))\n        di = di - 1\n      }\n    }\n  }\n  ordered_indexes\n}\n\nexport let closure_ordered_source_count: (String, String, Array[(String, String)]) -> Int with { Error } = (main_source, main_path, sources) -> {\n  let (all_sources, main_index) = normalize_all_sources(main_path, main_source, sources)\n  Array::length(collect_inline_source_indexes_ordered(all_sources, main_index))\n}\n\nexport let collect_inline_sources_ordered: (String, String, Array[(String, String)]) -> Array[(String, String)] with { Error } = (main_path, main_source, sources) -> {\n  let (all_sources, main_index) = normalize_all_sources(main_path, main_source, sources)\n  let ordered_indexes = collect_inline_source_indexes_ordered(all_sources, main_index)\n  let ordered = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut oi = 0\n  while oi < Array::length(ordered_indexes) {\n    let source_index = Array::get(ordered_indexes, oi)\n    Array::push(ordered, Array::get(all_sources, source_index))\n    oi = oi + 1\n  }\n  ordered\n}\n")
}

let selfhost_source_171 = () -> (String, String) {
  ("vibe/compiler/entry/compiler/file_compile/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nexport effect Profiler {\n  NowUs -> Int\n}\n\n\nlet profiler_now_us: () -> Int with { Profiler } = () -> {\n  perform Profiler::NowUs\n}\n\nlet elapsed_us_since: (Int) -> Int with { Profiler } = (start_us) -> {\n  let elapsed = profiler_now_us() - start_us\n  if elapsed < 0 {\n    0\n  } else {\n    elapsed\n  }\n}\n\nlet artifact_fingerprint_from_source: (String) -> String = (source) -> {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet seed_type_db_from_source_groups: (TypeDb, Array[(String, Array[(String, String)])]) -> TypeDb = (db, source_groups) -> {\n  let mut seeded = db\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      seeded = db_set_source(seeded, path, source)\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  seeded\n}\n\nlet append_stmt_array: (Array[Stmt], Array[Stmt]) -> Unit = (dst, src) -> {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nlet string_array_contains: (Array[String], String) -> Bool = (items, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet parse_program_for_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\n  handle {\n    let (tokens, starts, _ends) = lex_with_offsets(source)\n    parse_program_located(tokens, starts, source)\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nlet append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)]) -> Unit with { Error } = (merged, current_path, stmts, sources) -> {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains(emitted, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(\n            resolved,\n            parse_program_for_path(resolved, source)\n          )\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nlet build_merged_stmts_from_sources: (String, Array[(String, String)]) -> Array[Stmt] with { Error } = (entry_path, sources) -> {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let mut si = 0\n  while si < source_count {\n    let (path, source) = Array::get(sources, si)\n    let stmts = parse_program_for_path(path, source)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    let namespaced_stmts = if is_entry_source {\n      stmts\n    } else {\n      namespace_private_value_stmts(path, stmts)\n    }\n    if stmts_have_import_deep(stmts) {\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_import_alias_collision_defs_from_sources(merged, path, stmts, sources)\n      append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n    si = si + 1\n  }\n  merged\n}\n\nlet build_grouped_merged_stmts: (Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } = (source_groups) -> {\n  let merged = empty_stmt_array()\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let group_stmts = build_merged_stmts_from_sources(\"\", sources)\n    append_stmt_array(merged, group_stmts)\n    gi = gi + 1\n  }\n  merged\n}\n\nlet path_basename: (String) -> String = (p) -> {\n  let n = String::length(p)\n  let mut last = 0 - 1\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(p, i) == 47 {\n      last = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  String::substring(p, last + 1, n)\n}\n\nlet file_newline_offsets: (String) -> Array[Int] = (src) -> {\n  let arr = Array::slice([\n    0\n  ], 0, 0)\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\nlet build_grouped_merged_stmts_prov: (Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } = (source_groups) -> {\n  let merged = empty_stmt_array()\n  let files = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_nls = Array::slice([\n    Array::slice([\n      0\n    ], 0, 0)\n  ], 0, 0)\n  let stmt_file_id = Array::slice([\n    0\n  ], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let (path, source) = Array::get(sources, si)\n      let file_id = Array::length(files)\n      Array::push(files, path_basename(path))\n      Array::push(file_nls, file_newline_offsets(source))\n      let before = Array::length(merged)\n      let stmts = parse_program_for_path(path, source)\n      let is_entry_source = si == source_count - 1\n      let namespaced_stmts = if is_entry_source {\n        stmts\n      } else {\n        namespace_private_value_stmts(path, stmts)\n      }\n      if stmts_have_import_deep(stmts) {\n        let skipped_locals = collect_import_alias_collision_locals(stmts)\n        append_import_alias_collision_defs_from_sources(merged, path, stmts, sources)\n        append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)\n      } else {\n        append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n      }\n      let after = Array::length(merged)\n      let mut k = before\n      while k < after {\n        Array::push(stmt_file_id, file_id)\n        k = k + 1\n      }\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  (merged, files, file_nls, stmt_file_id)\n}\n\nlet prepare_file_fs_from_source_groups_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error } = (db, entry_path, source_groups) -> {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck(seeded, entry_path)\n}\n\nlet prepare_file_fs_from_source_groups_persistent_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } = (db, entry_path, source_groups) -> {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck_fs(seeded, entry_path)\n}\n\nexport let prepare_file_fs_cached: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, entry_path) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nexport let compile_file_fs_mode: (String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\nexport let compile_file_fs_mode_rc: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc(merged_stmts, entry_name)\n}\n\nexport let compile_file_fs_mode_testmeta: (String, String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode, meta_out) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let cacheable = if meta_out != \"\" {\n    file_tests_cacheable(merged_stmts)\n  } else {\n    false\n  }\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  if meta_out != \"\" {\n    Fs::write_file(meta_out, if cacheable {\n      \"1\"\n    } else {\n      \"0\"\n    })\n  } else {\n    ()\n  }\n  bytes\n}\n\nexport let compile_file_fs_mode_coverage: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_coverage(merged_stmts, entry_name)\n}\n\nexport let compile_file_fs_mode_trace: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_trace(merged_stmts, entry_name)\n}\n\nexport let compile_file_fs_mode_break: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)\n  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{\n    files: dbg_files,\n    file_nls: dbg_file_nls,\n    stmt_file_id: dbg_stmt_file_id\n  })\n}\n\nexport let compile_file_fs_mode_profiled: (String, String, String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } = (entry_path, entry_name, mode) -> {\n  let total_start = profiler_now_us()\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let load_us = elapsed_us_since(load_start)\n  let type_start = profiler_now_us()\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let type_us = elapsed_us_since(type_start)\n  let bundle_start = profiler_now_us()\n  let _ = build_source_groups_fingerprint(source_groups)\n  let bundle_us = elapsed_us_since(bundle_start)\n  let parse_start = profiler_now_us()\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let parse_us = elapsed_us_since(parse_start)\n  let compile_start = profiler_now_us()\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let compile_us = elapsed_us_since(compile_start)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n}\n\nlet compile_file_fs_mode_cached_slow_profiled: (TypeDb, String, String, String, String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } = (db, entry_path, entry_name, mode, persistent_artifact_kind) -> {\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),\n    None => {\n      let load_us = elapsed_us_since(load_start)\n      let type_start = profiler_now_us()\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let type_us = elapsed_us_since(type_start)\n      let bundle_start = profiler_now_us()\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let bundle_us = elapsed_us_since(bundle_start)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),\n        None => {\n          let parse_start = profiler_now_us()\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let parse_us = elapsed_us_since(parse_start)\n          let compile_start = profiler_now_us()\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          let compile_us = elapsed_us_since(compile_start)\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)\n        }\n      }\n    }\n  }\n}\n\nlet compile_file_fs_mode_cached_slow: (TypeDb, String, String, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name, mode, persistent_artifact_kind) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db),\n        None => {\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_mode_cached: (TypeDb, String, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name, mode) -> {\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      },\n    None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n  }\n}\n\nexport let compile_file_fs_cached: (TypeDb, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name) -> {\n  compile_file_fs_mode_cached(db, entry_path, entry_name, \"no-dce\")\n}\n\nexport let compile_file_fs: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport let compile_file_fs_mode_cached_profiled: (TypeDb, String, String, String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } = (db, entry_path, entry_name, mode) -> {\n  let total_start = profiler_now_us()\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let load_start = profiler_now_us()\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),\n        None => {\n          let prefix_load_us = elapsed_us_since(load_start)\n          let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n          (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n        }\n      },\n    None => {\n      let prefix_load_us = elapsed_us_since(load_start)\n      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n    }\n  }\n}\n\nlet compile_file_fs_module_cached_slow: (TypeDb, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\n    \"file-compile-module\",\n    \"\",\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"file-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_module_cached: (TypeDb, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path) -> {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"file-compile-module\",\n        \"\",\n        build_file_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n\nexport let compile_file_fs_module: (String) -> Bytes with { Error, Fs } = (entry_path) -> {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n")
}

let selfhost_source_172 = () -> (String, String) {
  ("vibe/compiler/entry/cli_cache/index.vibe",
"\n\n\n\n\nlet strip_trailing_cr: (String) -> String = (line) -> {\n  let len = String::length(line)\n  if len > 0 && String::char_code_at(line, len - 1) == 13 {\n    line[0:len - 1]\n  } else {\n    line\n  }\n}\n\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(line, i) == 9 {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  Array::push(fields, line[start:len])\n  fields\n}\n\nlet string_to_bytes: (String) -> Bytes = (s) -> {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nlet remove_file_if_exists: (String) -> Unit with { Fs } = (path) -> {\n  if Fs::exists(path) {\n    Fs::remove(path)\n  } else {\n    ()\n  }\n}\n\nlet build_type_db_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    acc = compact_string_fingerprint(\n      String::concat(\n        acc,\n        String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n      )\n    )\n    i = i + 1\n  }\n  acc\n}\n\nexport let parse_batch_jobs_tsv: (String) -> Array[(String, String, String)] with { Error } = (raw) -> {\n  let jobs = Array::slice([(\"\", \"\", \"\")], 0, 0)\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let field_count = Array::length(fields)\n        if field_count < 2 || field_count > 3 {\n          throw(\"invalid VIBE_BATCH_TSV row: expected 2 or 3 tab-separated columns\")\n        }\n        let input_path = Array::get(fields, 0)\n        let output_path = Array::get(fields, 1)\n        let entry_name = if field_count == 3 { Array::get(fields, 2) } else { \"\" }\n        if String::length(input_path) == 0 || String::length(output_path) == 0 {\n          throw(\"invalid VIBE_BATCH_TSV row: input/output path must be non-empty\")\n        }\n        Array::push(jobs, (input_path, output_path, entry_name))\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  jobs\n}\n\nlet compile_job_cached: (TypeDb, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, input_path, entry_name) -> {\n  if entry_name == \"\" {\n    compile_file_fs_module_cached(db, input_path)\n  } else {\n    compile_file_fs_cached(db, input_path, entry_name)\n  }\n}\n\nlet prepare_jobs_cached_impl: (TypeDb, Array[(String, String, String)]) -> TypeDb with { Error, Fs } = (db, jobs) -> {\n  let mut next_db = db\n  let mut i = 0\n  while i < Array::length(jobs) {\n    let (input_path, _, _) = Array::get(jobs, i)\n    next_db = prepare_file_fs_cached(next_db, input_path)\n    i = i + 1\n  }\n  next_db\n}\n\nexport let prepare_jobs_cached: (TypeDb, Array[(String, String, String)]) -> TypeDb with { Error, Fs } = (db, jobs) -> {\n  prepare_jobs_cached_impl(db, jobs)\n}\n\nexport let compile_jobs_cached: (TypeDb, Array[(String, String, String)]) -> TypeDb with { Error, Fs } = (db, jobs) -> {\n  let mut next_db = if Array::length(jobs) > 1 {\n    prepare_jobs_cached_impl(db, jobs)\n  } else {\n    db\n  }\n  let mut i = 0\n  while i < Array::length(jobs) {\n    let (input_path, output_path, entry_name) = Array::get(jobs, i)\n    let (bytes, compiled_db) = compile_job_cached(next_db, input_path, entry_name)\n    Fs::write_bytes(output_path, bytes)\n    next_db = compiled_db\n    i = i + 1\n  }\n  next_db\n}\n\nexport let selfbuild_probe_cli_cache_counts: () -> Int with { Error, Fs } = () -> {\n  let helper_path = \"/tmp/vibe_selfhost_cli_cache_v4_helper.vibe\"\n  let main_path = \"/tmp/vibe_selfhost_cli_cache_v4_main.vibe\"\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_write_sources\")\n  Fs::write_bytes(\n    helper_path,\n    string_to_bytes(\"export let add: (Int, Int) -> Int = (a, b) -> { a + b }\")\n  )\n  Fs::write_bytes(\n    main_path,\n    string_to_bytes(\"import ./vibe_selfhost_cli_cache_v4_helper.vibe { add }\\nlet run: () -> Int = () -> { add(1, 2) }\")\n  )\n  let jobs = [(main_path, \"/tmp/vibe_selfhost_cli_cache_v4_out.wasm\", \"run\")]\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_prepare1\")\n  let db1 = prepare_jobs_cached_impl(db_new(), jobs)\n  Fs::write_file(\n    \"_build/cli_cache_counts_inner_v1.txt\",\n    String::concat(\"after_prepare1:\", __to_string(db_typecheck_count(db1)))\n  )\n  let count1 = db_typecheck_count(db1)\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_prepare2\")\n  let db2 = prepare_jobs_cached_impl(db1, jobs)\n  Fs::write_file(\n    \"_build/cli_cache_counts_inner_v1.txt\",\n    String::concat(\"after_prepare2:\", __to_string(db_typecheck_count(db2)))\n  )\n  let count2 = db_typecheck_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_cli_file_cache_counts: () -> Int with { Error, Fs } = () -> {\n  selfbuild_probe_cli_cache_counts()\n}\n\nlet clear_prepare_probe_caches: (String, String, String, String, String, String) -> Unit with { Fs } = (helper_path, helper_source, main1_path, main1_source, main2_path, main2_source) -> {\n  let helper_fp = build_type_db_fingerprint(helper_source, Array::slice([(\"\", \"\")], 0, 0))\n  let main1_fp = build_type_db_fingerprint(main1_source, [(helper_path, helper_fp)])\n  let main2_fp = build_type_db_fingerprint(main2_source, [(helper_path, helper_fp)])\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(helper_path, compact_string_fingerprint(helper_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main1_path, compact_string_fingerprint(main1_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main2_path, compact_string_fingerprint(main2_source))\n  )\n  remove_file_if_exists(persistent_type_env_cache_path(helper_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main1_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main2_fp))\n}\n\nlet prepare_probe_sources: (String, String, String) -> (String, String, String) = (helper_path, main1_path, main2_path) -> {\n  let helper_source = \"export let add: (Int, Int) -> Int = (a, b) -> { a + b }\"\n  let main1_source = String::concat(\n    \"import ./\",\n    String::concat(\n      String::substring(helper_path, String::last_index_of(helper_path, \"/\") + 1, String::length(helper_path)),\n      \" { add }\\nlet run: () -> Int = () -> { add(1, 2) }\"\n    )\n  )\n  let main2_source = String::concat(\n    \"import ./\",\n    String::concat(\n      String::substring(helper_path, String::last_index_of(helper_path, \"/\") + 1, String::length(helper_path)),\n      \" { add }\\nlet run: () -> Int = () -> { add(3, 4) }\"\n    )\n  )\n  (helper_source, main1_source, main2_source)\n}\n\nexport let selfbuild_probe_cli_prepare_batch_parse_counts: () -> Int with { Error, Fs } = () -> {\n  let fresh_helper_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_helper.vibe\"\n  let fresh_main1_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_main1.vibe\"\n  let fresh_main2_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_main2.vibe\"\n  let shared_helper_path = \"/tmp/vibe_selfhost_cli_prepare_shared_helper.vibe\"\n  let shared_main1_path = \"/tmp/vibe_selfhost_cli_prepare_shared_main1.vibe\"\n  let shared_main2_path = \"/tmp/vibe_selfhost_cli_prepare_shared_main2.vibe\"\n  let (fresh_helper_source, fresh_main1_source, fresh_main2_source) = prepare_probe_sources(\n    fresh_helper_path,\n    fresh_main1_path,\n    fresh_main2_path\n  )\n  let (shared_helper_source, shared_main1_source, shared_main2_source) = prepare_probe_sources(\n    shared_helper_path,\n    shared_main1_path,\n    shared_main2_path\n  )\n  Fs::write_bytes(fresh_helper_path, string_to_bytes(fresh_helper_source))\n  Fs::write_bytes(fresh_main1_path, string_to_bytes(fresh_main1_source))\n  Fs::write_bytes(fresh_main2_path, string_to_bytes(fresh_main2_source))\n  Fs::write_bytes(shared_helper_path, string_to_bytes(shared_helper_source))\n  Fs::write_bytes(shared_main1_path, string_to_bytes(shared_main1_source))\n  Fs::write_bytes(shared_main2_path, string_to_bytes(shared_main2_source))\n  clear_prepare_probe_caches(\n    fresh_helper_path,\n    fresh_helper_source,\n    fresh_main1_path,\n    fresh_main1_source,\n    fresh_main2_path,\n    fresh_main2_source\n  )\n  clear_prepare_probe_caches(\n    shared_helper_path,\n    shared_helper_source,\n    shared_main1_path,\n    shared_main1_source,\n    shared_main2_path,\n    shared_main2_source\n  )\n  let fresh_count1 = db_typecheck_count(prepare_jobs_cached_impl(db_new(), [\n    (fresh_main1_path, \"/tmp/vibe_selfhost_cli_prepare_fresh_main1.wasm\", \"run\")\n  ]))\n  let fresh_count2 = db_typecheck_count(prepare_jobs_cached_impl(db_new(), [\n    (fresh_main2_path, \"/tmp/vibe_selfhost_cli_prepare_fresh_main2.wasm\", \"run\")\n  ]))\n  let shared_count = db_typecheck_count(prepare_jobs_cached_impl(db_new(), [\n    (shared_main1_path, \"/tmp/vibe_selfhost_cli_prepare_shared_main1.wasm\", \"run\"),\n    (shared_main2_path, \"/tmp/vibe_selfhost_cli_prepare_shared_main2.wasm\", \"run\")\n  ]))\n  (fresh_count1 + fresh_count2) * 1000 + shared_count\n}\n")
