   bytebuf_push(buf, 8)\\n    bytebuf_push(buf, 2)\\n    nl\\n  } else if __tag == 24 {\\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\\n  } else if __tag == 26 {\\n    let ret_expr = get_ereturn_expr(expr)\\n    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)\\n    emit_return(buf)\\n    nl\\n  } else {\\n    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\nexport let compile_expr_tail2: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\\n  let __tag = expr_tag(expr)\\n  if __tag == 15 {\\n    let __tuple_elems = get_etuple_elems(expr)\\n    let num_elems = Array::length(__tuple_elems)\\n    let ptr_local = next_local\\n    Array::push(local_names, \\\"__tuple_ptr\\\")\\n    let mut nl = next_local + 1\\n    if ctx.enable_rc {\\n      let total = 16 + num_elems * 8\\n      emit_i64_const(buf, total)\\n      emit_call(buf, ctx.rc_alloc_func_idx)\\n      emit_local_set(buf, ptr_local)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, total)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store(buf, 2, 4)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store8(buf, 0, 7)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 3)\\n      emit_i32_store(buf, 2, 8)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, num_elems)\\n      emit_i32_store(buf, 2, 12)\\n      let mut tri = 0\\n      while tri < num_elems {\\n        let __tup_elem = Array::get(__tuple_elems, tri)\\n        nl = compile_expr(buf, __tup_elem, local_names, nl, ctx, ld)\\n        let __tup_val_local = nl\\n        Array::push(local_names, \\\"__tup_val\\\")\\n        emit_local_set(buf, __tup_val_local)\\n        nl = nl + 1\\n        let __tup_is_proj = match __tup_elem {\\n          EDot(_, _, _) => true,\\n          _ => false\\n        }\\n        if ctx.enable_rc && (__tup_is_proj || cc_is_borrow_ret_call(__tup_elem, ctx) || cc_is_loop_borrowed_ident(__tup_elem, ctx)) {\\n          emit_rc_dup_guarded(buf, __tup_val_local, ctx.rc_shadow)\\n        } else {\\n          ()\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_local_get(buf, __tup_val_local)\\n        emit_i64_store(buf, 3, 16 + tri * 8)\\n        tri = tri + 1\\n      }\\n      emit_local_get(buf, ptr_local)\\n      emit_i64_const(buf, 8)\\n      emit_i64_add(buf)\\n      emit_i64_const(buf, 1)\\n      emit_i64_or(buf)\\n      nl\\n    } else {\\n      let alloc_size = num_elems * 8\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_tee(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, alloc_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      let mut ti = 0\\n      while ti < num_elems {\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)\\n        emit_i64_store(buf, 3, ti * 8)\\n        ti = ti + 1\\n      }\\n      emit_local_get(buf, ptr_local)\\n      nl\\n    }\\n  } else if __tag == 16 {\\n    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  } else if __tag == 17 {\\n    let elems = get_earray_elems(expr)\\n    let n_elems = Array::length(elems)\\n    if ctx.enable_rc {\\n      let cap = if n_elems > 8 {\\n        n_elems\\n      } else {\\n        8\\n      }\\n      let total = 20 + cap * 8\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__arr_ptr\\\")\\n      let mut nl = next_local + 1\\n      emit_i64_const(buf, total)\\n      emit_call(buf, ctx.rc_alloc_func_idx)\\n      emit_local_set(buf, ptr_local)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, total)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store(buf, 2, 4)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 5)\\n      emit_i32_store8(buf, 0, 7)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, cap)\\n      emit_i32_store(buf, 2, 8)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, n_elems)\\n      emit_i32_store(buf, 2, 12)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 20)\\n      emit_i32_add(buf)\\n      emit_i32_store(buf, 2, 16)\\n      let mut ai = 0\\n      while ai < n_elems {\\n        let __arr_elem = Array::get(elems, ai)\\n        nl = compile_expr(buf, __arr_elem, local_names, nl, ctx, ld)\\n        let __arr_val_local = nl\\n        Array::push(local_names, \\\"__arr_val\\\")\\n        emit_local_set(buf, __arr_val_local)\\n        nl = nl + 1\\n        let __arr_is_proj = match __arr_elem {\\n          EDot(_, _, _) => true,\\n          _ => false\\n        }\\n        if __arr_is_proj || cc_is_borrow_ret_call(__arr_elem, ctx) || cc_is_loop_borrowed_ident(__arr_elem, ctx) {\\n          emit_rc_dup_guarded(buf, __arr_val_local, ctx.rc_shadow)\\n        } else {\\n          ()\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_local_get(buf, __arr_val_local)\\n        emit_i64_store(buf, 3, 20 + ai * 8)\\n        ai = ai + 1\\n      }\\n      emit_local_get(buf, ptr_local)\\n      emit_i64_const(buf, 8)\\n      emit_i64_add(buf)\\n      emit_i64_const(buf, 1)\\n      emit_i64_or(buf)\\n      nl\\n    } else {\\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::push\\\")\\n      let arr_local = next_local\\n      emit_call(buf, arr_new_idx)\\n      emit_local_set(buf, arr_local)\\n      Array::push(local_names, \\\"__arr_lit\\\")\\n      let mut nl = next_local + 1\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        emit_local_get(buf, arr_local)\\n        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)\\n        emit_call(buf, arr_push_idx)\\n        ei = ei + 1\\n      }\\n      emit_local_get(buf, arr_local)\\n      nl\\n    }\\n  } else if __tag == 18 {\\n    let names_len_at_forin = Array::length(local_names)\\n    let var_name = get_eforin_name(expr)\\n    let iter_expr = get_eforin_iter(expr)\\n    let body = get_eforin_body(expr)\\n    let lb_base = Array::length(ctx.loop_borrowed_names)\\n    if ctx.enable_rc {\\n      let mut lbi = 0\\n      while lbi < names_len_at_forin {\\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\\n        lbi = lbi + 1\\n      }\\n    } else {\\n      ()\\n    }\\n    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::length\\\")\\n    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::get\\\")\\n    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \\\"Array::push\\\")\\n    let result_local = next_local\\n    let arr_local = next_local + 1\\n    let i_local = next_local + 2\\n    Array::push(local_names, \\\"__forin_res\\\")\\n    Array::push(local_names, \\\"__forin_arr\\\")\\n    Array::push(local_names, \\\"__forin_i\\\")\\n    emit_call(buf, arr_new_fi)\\n    emit_local_set(buf, result_local)\\n    let nl1 = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)\\n    emit_local_set(buf, arr_local)\\n    emit_i64_const(buf, 0)\\n    emit_local_set(buf, i_local)\\n    emit_block_void(buf)\\n    emit_loop_void(buf)\\n    emit_local_get(buf, i_local)\\n    emit_local_get(buf, arr_local)\\n    emit_call(buf, arr_len_fi)\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, 1)\\n      emit_i64_shr_s(buf)\\n    }\\n    emit_i64_ge_s(buf)\\n    emit_br_if(buf, 1)\\n    let index_name = get_eforin_index(expr)\\n    let var_local = match index_name {\\n      Some(idx_name) => {\\n        emit_local_get(buf, i_local)\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        }\\n        emit_local_set(buf, nl1)\\n        Array::push(local_names, idx_name)\\n        nl1 + 1\\n      },\\n      None => nl1\\n    }\\n    emit_local_get(buf, arr_local)\\n    emit_local_get(buf, i_local)\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, 1)\\n      emit_i64_shl(buf)\\n    }\\n    emit_call(buf, arr_get_fi)\\n    emit_local_set(buf, var_local)\\n    Array::push(local_names, var_name)\\n    if ctx.enable_rc {\\n      Array::push(ctx.loop_borrowed_names, var_name)\\n    } else {\\n      ()\\n    }\\n    let nl2 = var_local + 1\\n    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, ld + 1)\\n    let body_val = nl3\\n    Array::push(local_names, \\\"__forin_val\\\")\\n    emit_local_set(buf, body_val)\\n    emit_local_get(buf, result_local)\\n    emit_local_get(buf, body_val)\\n    emit_call(buf, arr_push_fi)\\n    emit_local_get(buf, i_local)\\n    emit_i64_const(buf, 1)\\n    emit_i64_add(buf)\\n    emit_local_set(buf, i_local)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    emit_end(buf)\\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\\n    emit_local_get(buf, result_local)\\n    let final_nl = nl3 + 1\\n    Array::truncate(local_names, names_len_at_forin)\\n    while Array::length(local_names) < final_nl {\\n      Array::push(local_names, \\\"\\\")\\n    }\\n    final_nl\\n  } else {\\n    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\nlet emit_dbg_line_for: (Bytes, Expr, CompileCtx) -> Unit = (buf, value, ctx) -> {\\n  if ctx.dbg_line_idx >= 0 {\\n    let off = first_offset(value)\\n    if off >= 0 {\\n      let line = offset_to_line(ctx.dbg_line_nl, off)\\n      emit_i32_const(buf, ctx.dbg_line_file_id)\\n      emit_i32_const(buf, line)\\n      emit_call(buf, ctx.dbg_line_idx)\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\nlet is_edot: (Expr) -> Bool = (e) -> {\\n  match e {\\n    EDot(_, _, _) => true,\\n    _ => false\\n  }\\n}\\nlet efn_is_capturing: (Expr, CompileCtx) -> Bool with { Error } = (value, ctx) -> {\\n  let params = get_efn_params(value)\\n  let pnames = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut pi = 0\\n  while pi < Array::length(params) {\\n    let (pn, _) = Array::get(params, pi)\\n    Array::push(pnames, pn)\\n    pi = pi + 1\\n  }\\n  let caps = collect_free_vars(get_efn_body(value), pnames, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\\n  Array::length(caps) > 0\\n}\\nlet slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\\n  let arr = ctx.float_local_slots\\n  let mut j = Array::length(arr) - 1\\n  let mut result = false\\n  while j >= 0 {\\n    let entry = Array::get(arr, j)\\n    if entry / 2 == slot {\\n      result = (entry % 2) == 1\\n      j = -1\\n    } else {\\n      j = j - 1\\n    }\\n  }\\n  result\\n}\\nlet slot_is_intish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\\n  let arr = ctx.int_local_slots\\n  let mut j = Array::length(arr) - 1\\n  let mut result = false\\n  while j >= 0 {\\n    let entry = Array::get(arr, j)\\n    if entry / 2 == slot {\\n      result = (entry % 2) == 1\\n      j = -1\\n    } else {\\n      j = j - 1\\n    }\\n  }\\n  result\\n}\\nexport let rec expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\\n  let tag = expr_tag(e)\\n  if tag == 2 {\\n    true\\n  } else if tag == 4 {\\n    let nm = get_eident_name(e)\\n    let len = Array::length(local_names)\\n    let mut i = len - 1\\n    let mut slot = -1\\n    while i >= 0 {\\n      if Array::get(local_names, i) == nm {\\n        slot = i\\n        i = -1\\n      } else {\\n        i = i - 1\\n      }\\n    }\\n    if slot >= 0 {\\n      slot_is_floatish(ctx, slot)\\n    } else {\\n      false\\n    }\\n  } else if tag == 5 {\\n    let op = get_ebinop_op(e)\\n    if op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\" || op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" {\\n      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\\n    } else {\\n      false\\n    }\\n  } else if tag == 6 {\\n    let op = get_eunaryop_op(e)\\n    if op == \\\"-\\\" {\\n      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\\n    } else {\\n      false\\n    }\\n  } else if tag == 8 {\\n    let callee = get_ecall_callee(e)\\n    if is_eident(callee) {\\n      let fname = get_eident_name(callee)\\n      fname == \\\"Int::to_double\\\" || fname == \\\"Int::to_float\\\" || fname == \\\"Float::to_double\\\" || fname == \\\"Double::to_float\\\" || fname == \\\"Double::from_i64_bits\\\"\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n}\\nexport let expr_is_intish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\\n  let tag = expr_tag(e)\\n  if tag == 0 {\\n    true\\n  } else if tag == 1 {\\n    true\\n  } else if tag == 4 {\\n    let nm = get_eident_name(e)\\n    let len = Array::length(local_names)\\n    let mut i = len - 1\\n    let mut slot = -1\\n    while i >= 0 {\\n      if Array::get(local_names, i) == nm {\\n        slot = i\\n        i = -1\\n      } else {\\n        i = i - 1\\n      }\\n    }\\n    if slot >= 0 {\\n      slot_is_intish(ctx, slot)\\n    } else {\\n      false\\n    }\\n  } else if tag == 5 {\\n    let op = get_ebinop_op(e)\\n    if op == \\\"&\\\" || op == \\\"|\\\" || op == \\\"^\\\" || op == \\\"<<\\\" || op == \\\">>\\\" || op == \\\"%\\\" || op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" || op == \\\"==\\\" || op == \\\"!=\\\" || op == \\\"&&\\\" || op == \\\"||\\\" {\\n      true\\n    } else if op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\" {\\n      !expr_is_floatish(e, local_names, ctx)\\n    } else {\\n      false\\n    }\\n  } else if tag == 6 {\\n    let op = get_eunaryop_op(e)\\n    op == \\\"!\\\"\\n  } else {\\n    false\\n  }\\n}\\nlet assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {\\n  let empty1 = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let empty2 = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\\n}\\nlet rec reassign_carry_safe: (Expr, String) -> Bool = (e, name) -> {\\n  if !assign_value_mentions(e, name) {\\n    true\\n  } else {\\n    match e {\\n      EIdent(_, _) => true,\\n      EDot(_, _, _) => proj_root_ident(e) == name,\\n      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),\\n      EUnaryOp(_, x) => reassign_carry_safe(x, name),\\n      _ => false\\n    }\\n  }\\n}\\nlet emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\\n  emit_local_get(buf, local_idx)\\n  if tagged {\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n  } else {\\n    ()\\n  }\\n  emit_i32_wrap_i64(buf)\\n}\\nlet emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\\n  emit_i32_const(buf, 4)\\n  emit_i32_sub(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_const(buf, 16777215)\\n  b