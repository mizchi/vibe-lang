local_get(lam_buf, env_param_idx)\\n    emit_i32_wrap_i64(lam_buf)\\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\\n    if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\\n      emit_i64_const(lam_buf, -2)\\n      emit_i64_and(lam_buf)\\n    }\\n    emit_local_set(lam_buf, cap_local)\\n    Array::push(lam_locals, cap_name)\\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\\n      Array::push(lam_ref_cells, cap_name)\\n    } else {\\n      ()\\n    }\\n    if ctx.enable_rc && !array_contains_str(ctx.ref_cell_names, cap_name) {\\n      let cap_consumes = md_consume_count(fn_body, cap_name)\\n      let mut cdup = 0\\n      while cdup < cap_consumes {\\n        emit_rc_dup_guarded(lam_buf, cap_local, ctx.rc_shadow)\\n        cdup = cdup + 1\\n      }\\n    } else {\\n      ()\\n    }\\n    lam_nl = lam_nl + 1\\n    ci3 = ci3 + 1\\n  }\\n  let norm_params = Array::slice(params, 0, 0)\\n  let mut npi = 0\\n  while npi < Array::length(params) {\\n    let (rawn, pty) = Array::get(params, npi)\\n    let rnlen = String::length(rawn)\\n    let sn = if rnlen > 0 {\\n      let lc = String::char_code_at(rawn, rnlen - 1)\\n      if lc == '~' || lc == '?' {\\n        rawn[0: rnlen - 1]\\n      } else {\\n        rawn\\n      }\\n    } else {\\n      rawn\\n    }\\n    Array::push(norm_params, (sn, pty))\\n    npi = npi + 1\\n  }\\n  let lam_drops = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_alias_dups = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_dups = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let lam_heap_params = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  if ctx.enable_rc {\\n    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body, ctx.borrow_ret_names)\\n    let mut ldi = 0\\n    while ldi < Array::length(lam_plan) {\\n      let lpa = Array::get(lam_plan, ldi)\\n      if pa_is_drop(lpa) {\\n        Array::push(lam_drops, lpa.name)\\n      } else if pa_is_alias_dup(lpa) {\\n        Array::push(lam_alias_dups, lpa.name)\\n      } else if pa_is_dup(lpa) {\\n        Array::push(lam_dups, lpa.name)\\n      } else {\\n        ()\\n      }\\n      ldi = ldi + 1\\n    }\\n    let mut hpi = 0\\n    while hpi < Array::length(norm_params) {\\n      let (hpn, hpt) = Array::get(norm_params, hpi)\\n      if param_is_heap_in_body(hpn, hpt, fn_body) {\\n        Array::push(lam_heap_params, hpn)\\n      } else {\\n        ()\\n      }\\n      hpi = hpi + 1\\n    }\\n  }\\n  let lam_ctx = CompileCtx::{\\n    func_table: ctx.func_table, str_table: ctx.str_table,\\n    lambda_table: ctx.lambda_table,\\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\\n    thunk_names: ctx.thunk_names,\\n    const_int_names: ctx.const_int_names,\\n    const_int_values: ctx.const_int_values,\\n    enable_rc: ctx.enable_rc,\\n    rc_shadow: ctx.rc_shadow,\\n    rc_drop_names: lam_drops,\\n    rc_alias_dup_names: lam_alias_dups,\\n    heap_binding_names: lam_heap_params,\\n    rc_drop_func_idx: ctx.rc_drop_func_idx,\\n    rc_alloc_func_idx: ctx.rc_alloc_func_idx,\\n    heap_grow_check_func_idx: ctx.heap_grow_check_func_idx,\\n    rc_dup_names: lam_dups,\\n    float_local_slots: Array::slice([\\n      0\\n    ], 0, 0),\\n    int_local_slots: Array::slice([\\n      0\\n    ], 0, 0),\\n    effect_names: ctx.effect_names,\\n    effect_op_keys: ctx.effect_op_keys,\\n    effect_op_arities: ctx.effect_op_arities,\\n    cov: ctx.cov,\\n    dbg_line_idx: ctx.dbg_line_idx,\\n    dbg_line_nl: ctx.dbg_line_nl,\\n    dbg_line_file_id: ctx.dbg_line_file_id,\\n    loop_borrowed_names: Array::slice([\\n      \\\"\\\"\\n    ], 0, 0),\\n    loop_consumed_names: Array::slice([\\n      \\\"\\\"\\n    ], 0, 0),\\n    borrow_ret_names: ctx.borrow_ret_names,\\n    scalar_ret_names: ctx.scalar_ret_names\\n  }\\n  if ctx.enable_rc {\\n    let mut dpi = 0\\n    while dpi < Array::length(norm_params) {\\n      let (dpn, dpt) = Array::get(norm_params, dpi)\\n      if param_is_heap_in_body(dpn, dpt, fn_body) {\\n        let mut dcount = 0\\n        let mut dqi = 0\\n        while dqi < Array::length(lam_dups) {\\n          if Array::get(lam_dups, dqi) == dpn {\\n            dcount = dcount + 1\\n          } else {\\n            ()\\n          }\\n          dqi = dqi + 1\\n        }\\n        let mut de = 0\\n        while de < dcount {\\n          emit_rc_dup_guarded(lam_buf, dpi, ctx.rc_shadow)\\n          de = de + 1\\n        }\\n      } else {\\n        ()\\n      }\\n      dpi = dpi + 1\\n    }\\n  } else {\\n    ()\\n  }\\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\\n  let mut tail_lam_nl = final_lam_nl\\n  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\\n    let tail_root = scope_tail_proj_root(fn_body)\\n    let mut need_dup = false\\n    let mut ti = 0\\n    while ti < Array::length(norm_params) {\\n      let (tpn, tpt) = Array::get(norm_params, ti)\\n      if param_is_heap_in_body(tpn, tpt, fn_body) && array_contains_str(lam_drops, tpn) && tpn == tail_root {\\n        need_dup = true\\n      } else {\\n        ()\\n      }\\n      ti = ti + 1\\n    }\\n    let rtemp = final_lam_nl\\n    if need_dup {\\n      emit_local_set(lam_buf, rtemp)\\n      emit_rc_dup_guarded(lam_buf, rtemp, ctx.rc_shadow)\\n      tail_lam_nl = final_lam_nl + 1\\n    } else {\\n      ()\\n    }\\n    let mut tj = 0\\n    while tj < Array::length(norm_params) {\\n      let (dpn2, dpt2) = Array::get(norm_params, tj)\\n      if param_is_heap_in_body(dpn2, dpt2, fn_body) && array_contains_str(lam_drops, dpn2) {\\n        emit_local_get(lam_buf, tj)\\n        emit_call(lam_buf, ctx.rc_drop_func_idx)\\n      } else {\\n        ()\\n      }\\n      tj = tj + 1\\n    }\\n    if need_dup {\\n      emit_local_get(lam_buf, rtemp)\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\\n  Array::push(ctx.lambda_table.bodies, lam_buf)\\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\\n  Array::push(ctx.lambda_table.captures, captures)\\n  let mut extra_lam = 0\\n  let min_lam_nl = user_params + 1\\n  if tail_lam_nl > min_lam_nl {\\n    extra_lam = tail_lam_nl - min_lam_nl\\n  }\\n  Array::push(ctx.lambda_table.meta_i32, 0)\\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\\n  let table_slot = ctx.num_user_funcs + lambda_idx\\n  if num_captures == 0 {\\n    emit_i64_const(buf, (table_slot<<2)|2)\\n    next_local\\n  } else {\\n    let ptr_local = next_local\\n    let nl2 = next_local + 1\\n    Array::push(local_names, \\\"__closure_ptr\\\")\\n    let cap_off = if ctx.enable_rc {\\n      16\\n    } else {\\n      8\\n    }\\n    if ctx.enable_rc {\\n      let total = 16 + num_captures * 8\\n      emit_i64_const(buf, total)\\n      emit_call(buf, ctx.rc_alloc_func_idx)\\n      emit_local_set(buf, ptr_local)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, total)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store(buf, 2, 4)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 7)\\n      emit_i32_store8(buf, 0, 7)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, table_slot)\\n      emit_i32_store(buf, 2, 8)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, num_captures)\\n      emit_i32_store(buf, 2, 12)\\n    } else {\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_tee(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 8 + num_captures * 8)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, table_slot)\\n      emit_i32_store(buf, 2, 0)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, num_captures)\\n      emit_i32_store(buf, 2, 4)\\n    }\\n    let mut csi = 0\\n    while csi < num_captures {\\n      let cap_name = Array::get(captures, csi)\\n      let mut __cap_resolve = -1\\n      let mut __cri = Array::length(local_names) - 1\\n      while __cri >= 0 {\\n        if Array::get(local_names, __cri) == cap_name {\\n          __cap_resolve = __cri\\n          __cri = -1\\n        } else {\\n          __cri = __cri - 1\\n        }\\n      }\\n      if __cap_resolve >= 0 {\\n        if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, __cap_resolve)\\n          emit_i64_const(buf, 1)\\n          emit_i64_or(buf)\\n          emit_i64_store(buf, 3, cap_off + csi * 8)\\n          emit_rc_word_inc_saturating(buf, () -> {\\n            emit_local_get(buf, __cap_resolve)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 4)\\n            emit_i32_sub(buf)\\n          })\\n        } else {\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, __cap_resolve)\\n          emit_i64_store(buf, 3, cap_off + csi * 8)\\n        }\\n      } else {\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_const(buf, 0)\\n        emit_i64_store(buf, 3, cap_off + csi * 8)\\n      }\\n      csi = csi + 1\\n    }\\n    if ctx.enable_rc {\\n      emit_local_get(buf, ptr_local)\\n      emit_i64_const(buf, 8)\\n      emit_i64_add(buf)\\n      emit_i64_const(buf, 1)\\n      emit_i64_or(buf)\\n    } else {\\n      emit_local_get(buf, ptr_local)\\n      emit_i64_const(buf, 1)\\n      emit_i64_or(buf)\\n    }\\n    nl2\\n  }\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\nlet emit_rc_dup_guarded_n: (Bytes, Int, Int, Bool) -> Unit = (buf, local_idx, n, rc_shadow) -> {\\n  let mut k = 0\\n  while k < n {\\n    emit_rc_dup_guarded(buf, local_idx, rc_shadow)\\n    k = k + 1\\n  }\\n}\\n\\nlet rec bind_match_pat: (Bytes, Int, Pat, Bool, Array[String], CompileCtx, Expr) -> Unit = (buf, base_local, container_pat, is_ctor_layout, local_names, ctx, body) -> {\\n  let elems = if is_ctor_layout {\\n    get_pctor_args(container_pat)\\n  } else {\\n    get_ptuple_pats(container_pat)\\n  }\\n  let mut i = 0\\n  while i < Array::length(elems) {\\n    let ep = Array::get(elems, i)\\n    let off = if is_ctor_layout {\\n      8 + i * 8\\n    } else if ctx.enable_rc {\\n      8 + i * 8\\n    } else {\\n      i * 8\\n    }\\n    let clear_tag = is_ctor_layout || ctx.enable_rc\\n    if is_pbind(ep) {\\n      let nm = get_pbind_name(ep)\\n      let fl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      if clear_tag {\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n      } else {\\n        ()\\n      }\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, fl)\\n      if ctx.enable_rc {\\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\\n      } else {\\n        ()\\n      }\\n      Array::push(local_names, nm)\\n    } else if is_ptuple(ep) {\\n      let sl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      if clear_tag {\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n      } else {\\n        ()\\n      }\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, sl)\\n      Array::push(local_names, \\\"__bind_sub\\\")\\n      bind_match_pat(buf, sl, ep, false, local_names, ctx, body)\\n    } else if is_pctor(ep) {\\n      let sl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      if clear_tag {\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n      } else {\\n        ()\\n      }\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, sl)\\n      Array::push(local_names, \\\"__bind_sub\\\")\\n      bind_match_pat(buf, sl, ep, true, local_names, ctx, body)\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nlet find_struct_index: (CompileCtx, String) -> Int = (ctx, sname) -> {\\n  let names = ctx.ctor_table.struct_names\\n  let mut si = 0\\n  let mut sidx = -1\\n  while si < Array::length(names) {\\n    if Array::get(names, si) == sname {\\n      sidx = si\\n      si = Array::length(names)\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  sidx\\n}\\n\\nlet field_index_in: (Array[String], String) -> Int = (fnames, field) -> {\\n  let mut fi = 0\\n  let mut found = -1\\n  while fi < Array::length(fnames) {\\n    if Array::get(fnames, fi) == field {\\n      found = fi\\n      fi = Array::length(fnames)\\n    } else {\\n      fi = fi + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet struct_field_index: (CompileCtx, String, String) -> Int with { Error } = (ctx, sname, field) -> {\\n  let sidx = find_struct_index(ctx, sname)\\n  if sidx >= 0 {\\n    let found = field_index_in(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\\n    if found < 0 {\\n      throw(String::concat(String::concat(String::concat(\\\"unknown field `\\\", field), \\\"` in struct \\\"), sname))\\n    } else {\\n      found\\n    }\\n  } else {\\n    let names = ctx.ctor_table.struct_names\\n    let mut gsi = 0\\n    let mut gfound = -1\\n    while gsi < Array::length(names) {\\n      let f = field_index_in(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\\n      if f >= 0 {\\n        gfound = f\\n        gsi = Array::length(names)\\n      } else {\\n        gsi = gsi + 1\\n      }\\n    }\\n    if gfound < 0 {\\n      throw(String::concat(\\\"unknown struct field in pattern: \\\", field))\\n    } else {\\n      gfound\\n    }\\n  }\\n}\\n\\nlet rec bind_struct_pat: (Bytes, Int, String, Array[(String, Pat)], Array[String], CompileCtx, Expr) -> Unit with { Error } = (buf, base_local, sname, fields, local_names, ctx, body) -> {\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (fname, subpat) = Array::get(fields, i)\\n    let off = 8 + struct_field_index(ctx, sname, fname) * 8\\n    if is_pbind(subpat) {\\n      let nm = get_pbind_name(subpat)\\n      let fl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, fl)\\n      if ctx.enable_rc {\\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\\n      } else {\\n        ()\\n      }\\n      Array::push(local_names, nm)\\n    } else if is_ptuple(subpat) {\\n      let sl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, sl)\\n      Array::push(local_names, \\\"__bind_sub\\\")\\n      bind_match_pat(buf, sl, subpat, false, local_names, ctx, body)\\n    } else if is_pctor(subpat) {\\n      let sl = Array::length(local_names)\\n      emit_local_get(buf, base_local)\\n      emit_i64_const(buf, -2)\\n      emit_i64_and(buf)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, off)\\n      emit_local_set(buf, sl)\\n      Array::push(local_names, \\\"__bind_sub\\\")\\n      bind_match_pat(buf, sl, subpat, true, local_names, ctx, body)\\n    } else {\\n      match subpat {\\n        PStruct(__sname, sfields) => {\\n          let sl = Array::length(local_names)\\n          emit_local_get(buf, base_local)\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n          emit_i32_wrap_i64(buf)\\n          emit_i64_load(buf, 3, off)\\n          emit_local_set(buf, sl)\\n          Array::push(local_names, \\\"__bind_sub\\\")\\n          bind_struct_pat(buf, sl, __sname, sfields, local_names, ctx, body)\\n        },\\n        _ => ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nexport let compile_match: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, ce) -> {\\n  let __match_scrutinee = get_match_scrutinee(expr)\\n  let __match_arms = get_match_arms(expr)\\n  let scrut_local = next_local\\n  Array::push(local_names, \\\"__match_scrut\\\")\\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\\n  emit_local_set(buf, scrut_local)\\n  let num_arms = Array::length(__match_arms)\\n  let catchall_idx = find_catchall_idx(__match_arms)\\n  let num_cond_arms = catchall_idx\\n  let mut ai = 0\\n  let mut max_nl = nl1\\n  let names_len_at_match = Array::length(local_names)\\n  let rec emit_pat_test: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\\n    match sp {\\n      POr(__l, __r) => {\\n        emit_pat_test(__l, load_field)\\n        emit_pat_test(__r, load_field)\\n        bytebuf_push(buf, 114)\\n      },\\n      _ => {\\n        if is_pint(sp) {\\n          load_field()\\n          emit_i64_const(buf, get_pint_value(sp))\\n          if ctx.enable_rc {\\n            emit_i64_const(buf, 1)\\n            emit_i64_shl(buf)\\n          }\\n          emit_i64_eq(buf)\\n        } else if is_pbool(sp) {\\n          load_field()\\n          emit_i64_const(buf, if get_pbool_value(sp) {\\n            1\\n          } else {\\n            0\\n          })\\n          if ctx.enable_rc {\\n            emit_i64_const(buf, 1)\\n            emit_i64_shl(buf)\\n          }\\n          emit_i64_eq(buf)\\n        } else if is_pstring(sp) {\\n          let __sv = get_pstring_value(sp)\\n          let __si = str_table_lookup(ctx.str_table.strs, __sv)\\n          if __si >= 0 {\\n            let (__seq_fi, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n            load_field()\\n            emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\\n            emit_call(buf, __seq_fi)\\n            emit_i32_wrap_i64(buf)\\n          } else {\\n            emit_i32_const(buf, 1)\\n          }\\n        } else if is_pctor(sp) {\\n          let __ncname = get_pctor_name(sp)\\n          let __nci = lookup_ctor(ctx.ctor_table.names, __ncname, 0)\\n          let __ntag = if __nci >= 0 {\\n            Array::get(ctx.ctor_table.tags, __nci)\\n          } else {\\n            -1\\n          }\\n          load_field()\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_load(buf, 2, 0)\\n          emit_i32_const(buf, __ntag)\\n          emit_i32_eq(buf)\\n          let __nargs = get_pctor_args(sp)\\n          let mut __nany = false\\n          let mut __nj = 0\\n          while __nj < Array::length(__nargs) {\\n            let __np = Array::get(__nargs, __nj)\\n            if is_pbind(__np) || is_pwild(__np) {\\n              ()\\n            } else {\\n              __nany = true\\n            }\\n            __nj = __nj + 1\\n          }\\n          if __nany {\\n            bytebuf_push(buf, 4)\\n            bytebuf_push(buf, 127)\\n            emit_i32_const(buf, 1)\\n            let mut __nk = 0\\n            while __nk < Array::length(__nargs) {\\n              let __nkk = __nk\\n              let __np2 = Array::get(__nargs, __nkk)\\n              if is_pbind(__np2) || is_pwild(__np2) {\\n                ()\\n              } else {\\n                let __nload: () -> Unit = () -> {\\n                  load_field()\\n                  emit_i64_const(buf, -2)\\n                  emit_i64_and(buf)\\n                  emit_i32_wrap_i64(buf)\\n                  emit_i64_load(buf, 3, 8 + __nkk * 8)\\n                }\\n                emit_pat_test(__np2, __nload)\\n                bytebuf_push(buf, 113)\\n              }\\n              __nk = __nk + 1\\n            }\\n            emit_else(buf)\\n            emit_i32_const(buf, 0)\\n            emit_end(buf)\\n          } else {\\n            ()\\n          }\\n        } else if is_ptuple(sp) {\\n          emit_i32_const(buf, 1)\\n          let __tpats = get_ptuple_pats(sp)\\n          let mut __tk = 0\\n          while __tk < Array::length(__tpats) {\\n            let __tkk = __tk\\n            let __tload: () -> Unit = () -> {\\n              load_field()\\n              if ctx.enable_rc {\\n                emit_i64_const(buf, -2)\\n                emit_i64_and(buf)\\n              }\\n              emit_i32_wrap_i64(buf)\\n              emit_i64_load(buf, 3, if ctx.enable_rc {\\n                8 + __tkk * 8\\n              } else {\\n                __tkk * 8\\n              })\\n            }\\n            emit_pat_test(Array::get(__tpats, __tkk), __tload)\\n            bytebuf_push(buf, 113)\\n            __tk = __tk + 1\\n          }\\n        } else {\\n          emit_i32_const(buf, 1)\\n        }\\n      }\\n    }\\n  }\\n  let emit_sub_tests: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\\n    if is_pbind(sp) || is_pwild(sp) {\\n      ()\\n    } else {\\n      emit_pat_test(sp, load_field)\\n      bytebuf_push(buf, 113)\\n    }\\n  }\\n  while ai < num_cond_arms {\\n    Array::truncate(local_names, names_len_at_match)\\n    int_log_reset_above(ctx, names_len_at_match)\\n    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)\\n    let __cond_done = if is_pint(__cond_p) {\\n      emit_local_get(buf, scrut_local)\\n      emit_i64_const(buf, get_pint_value(__cond_p))\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      emit_i64_eq(buf)\\n      emit_if_i64(buf)\\n      0\\n    } else {\\n      if is_pbool(__cond_p) {\\n        emit_local_get(buf, scrut_local)\\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\\n          if ctx.enable_rc { 2 } else { 1 }\\n        } else {\\n          0\\n        })\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n        0\\n      } else {\\n        if is_pctor(__cond_p) {\\n          let cname_cond = get_pctor_name(__cond_p)\\n          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\\n          let expected_tag = if ctor_ci >= 0 {\\n            Array::get(ctx.ctor_table.tags, ctor_ci)\\n          } else {\\n            -1\\n          }\\n          emit_local_get(buf, scrut_local)\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_load(buf, 2, 0)\\n          emit_i32_const(buf, expected_tag)\\n          emit_i32_eq(buf)\\n          let __cargs_cond = get_pctor_args(__cond_p)\\n          let mut __cany = false\\n          let mut __cj = 0\\n          while __cj < Array::length(__cargs_cond) {\\n            let __cp = Array::get(__cargs_cond, __cj)\\n            if is_pbind(__cp) || is_pwild(__cp) {\\n              ()\\n            } else {\\n              __cany = true\\n            }\\n            __cj = __cj + 1\\n          }\\n          if __cany {\\n            bytebuf_push(buf, 4)\\n            bytebuf_push(buf, 127)\\n            emit_i32_const(buf, 1)\\n            let mut __ck = 0\\n            while __ck < Array::length(__cargs_cond) {\\n              let __ckk = __ck\\n              let __cload: () -> Unit = () -> {\\n                emit_local_get(buf, scrut_local)\\n                emit_i64_const(buf, -2)\\n                emit_i64_and(buf)\\n                emit_i32_wrap_i64(buf)\\n                emit_i64_load(buf, 3, 8 + __ckk * 8)\\n              }\\n              emit_sub_tests(Array::get(__cargs_cond, __ckk), __cload)\\n              __ck = __ck + 1\\n            }\\n            emit_else(buf)\\n            emit_i32_const(buf, 0)\\n            emit_end(buf)\\n          } else {\\n            ()\\n          }\\n          emit_if_i64(buf)\\n          0\\n        } else {\\n          if is_pstring(__cond_p) {\\n            let sval = get_pstring_value(__cond_p)\\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\\n            if str_idx >= 0 {\\n              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n              emit_local_get(buf, scrut_local)\\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\\n              emit_call(buf, str_eq_fi)\\n              emit_i32_wrap_i64(buf)\\n              emit_if_i64(buf)\\n            }\\n            0\\n          } else if is_ptuple(__cond_p) {\\n            emit_i32_const(buf, 1)\\n            let __tpats_cond = get_ptuple_pats(__cond_p)\\n            let mut __tck = 0\\n            while __tck < Array::length(__tpats_cond) {\\n              let __tckk = __tck\\n              let __tcload: () -> Unit = () -> {\\n                emit_local_get(buf, scrut_local)\\n                if ctx.enable_rc {\\n                  emit_i64_const(buf, -2)\\n                  emit_i64_and(buf)\\n                } else {\\n                  ()\\n                }\\n                emit_i32_wrap_i64(buf)\\n                emit_i64_load(buf, 3, if ctx.enable_rc {\\n                  8 + __tckk * 8\\n                } else {\\n                  __tckk * 8\\n                })\\n              }\\n              emit_sub_tests(Array::get(__tpats_cond, __tckk), __tcload)\\n              __tck = __tck + 1\\n            }\\n            emit_if_i64(buf)\\n            0\\n          } else {\\n            let rec emit_or_check: (Pat) -> Unit = (pat) -> {\\n              match pat {\\n                POr(left, right) => {\\n                  emit_or_check(left)\\n                  emit_or_check(right)\\n                  bytebuf_push(buf, 114)\\n                },\\n                PInt(n) => {\\n                  emit_local_get(buf, scrut_local)\\n                  emit_i64_const(buf, n)\\n                  if ctx.enable_rc {\\n                    emit_i64_const(buf, 1)\\n                    emit_i64_shl(buf)\\n                  }\\n                  emit_i64_eq(buf)\\n                },\\n                PCtor(cname, cargs) => {\\n                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)\\n                  let ctag = if ci >= 0 {\\n                    Array::get(ctx.ctor_table.tags, ci)\\n                  } else {\\n                    -1\\n                  }\\n                  emit_local_get(buf, scrut_local)\\n                  emit_i64_const(buf, -2)\\n                  emit_i64_and(buf)\\n                  emit_i32_wrap_i64(buf)\\n                  emit_i32_load(buf, 2, 0)\\n                  emit_i32_const(buf, ctag)\\n                  emit_i32_eq(buf)\\n                  if Array::length(cargs) == 1 {\\n                    match Array::get(cargs, 0) {\\n                      PInt(n) => {\\n                        emit_local_get(buf, scrut_local)\\n                        emit_i64_const(buf, -2)\\n                        emit_i64_and(buf)\\n                        emit_i32_wrap_i64(buf)\\n                        emit_i64_load(buf, 3, 8)\\n                        emit_i64_const(buf, n)\\n                        if ctx.enable_rc {\\n                          emit_i64_const(buf, 1)\\n                          emit_i64_shl(buf)\\n                        }\\n                        emit_i64_eq(buf)\\n                        bytebuf_push(buf, 113)\\n                      },\\n                      _ => ()\\n                    }\\n                  }\\n                },\\n                PBool(b) => {\\n                  emit_local_get(buf, scrut_local)\\n                  emit_i64_const(buf, if b {\\n                    if ctx.enable_rc { 2 } else { 1 }\\n                  } else {\\n                    0\\n                  })\\n                  emit_i64_eq(buf)\\n                },\\n                PString(sv) => {\\n                  let __si = str_table_lookup(ctx.str_table.strs, sv)\\n                  if __si >= 0 {\\n                    let (__eqfi, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n                    emit_local_get(buf, scrut_local)\\n                    emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\\n                    emit_call(buf, __eqfi)\\n                    emit_i32_wrap_i64(buf)\\n                  } else {\\n                    emit_i32_const(buf, 1)\\n                  }\\n                },\\n                PTuple(tpats) => {\\n                  emit_i32_const(buf, 1)\\n                  let mut __ok = 0\\n                  while __ok < Array::length(tpats) {\\n                    let __okk = __ok\\n                    let __oload: () -> Unit = () -> {\\n                      emit_local_get(buf, scrut_local)\\n                      if ctx.enable_rc {\\n                        emit_i64_const(buf, -2)\\n                        emit_i64_and(buf)\\n                      } else {\\n                        ()\\n                      }\\n                      emit_i32_wrap_i64(buf)\\n                      emit_i64_load(buf, 3, if ctx.enable_rc {\\n                        8 + __okk * 8\\n                      } else {\\n                        __okk * 8\\n                      })\\n                    }\\n                    emit_sub_tests(Array::get(tpats, __okk), __oload)\\n                    __ok = __ok + 1\\n                  }\\n                },\\n                _ => emit_i32_const(buf, 1)\\n              }\\n            }\\n            emit_or_check(__cond_p)\\n            emit_if_i64(buf)\\n            0\\n          }\\n        }\\n      }\\n    }\\n    cov_emit_branch(buf, ctx.cov)\\n    let ld_arm = if ld >= 0 {\\n      ld + ai + 1\\n    } else {\\n      -1\\n    }\\n    let arm_nl = if is_pctor(__cond_p) {\\n      let cargs_bind = get_pctor_args(__cond_p)\\n      let mut cbi = 0\\