let push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {
  let (path, source) = pair
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if String::equals(name, group_name) {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = Array::slice([("", "")], 0, 0)
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

  let source_0 = ("vibe/compiler/core/polyfill.vibe",
"//# Functions\n\nexport let __to_string = (n: Int) -> String {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n")

  let source_1 = ("vibe/compiler/core/bytebuf.vibe",
"//# Functions\n\nexport let bytebuf_new = () -> Array[Int] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nexport let bytebuf_push = (buf: Array[Int], byte: Int) -> Unit {\n  Array::push(buf, byte)\n}\n\nexport let bytebuf_length = (buf: Array[Int]) -> Int {\n  Array::length(buf)\n}\n\nexport let bytebuf_to_bytes = (buf: Array[Int]) -> Bytes {\n  Bytes::from_array(buf)\n}\n\nexport let leb128_encode_s32 = (buf: Array[Int], value: Int) -> Unit {\n  let mut v = value\n  let mut more = true\n  while more {\n    let byte = v&127\n    v = v>>7\n    if (v == 0) && ((byte&64) == 0) {\n      Array::push(buf, byte)\n      more = false\n    } else {\n      if (v == 0 - 1) && ((byte&64) != 0) {\n        Array::push(buf, byte)\n        more = false\n      } else {\n        Array::push(buf, byte|128)\n      }\n    }\n  }\n}\n\nexport let leb128_encode_s64 = (buf: Array[Int], value: Int) -> Unit {\n  leb128_encode_s32(buf, value)\n}\n\nexport let leb128_encode_u32 = (buf: Array[Int], value: Int) -> Unit {\n  let mut v = value\n  let mut more = true\n  while more {\n    let byte = v&127\n    v = (v>>7)&((1<<25) - 1)\n    if v == 0 {\n      Array::push(buf, byte)\n      more = false\n    } else {\n      Array::push(buf, byte|128)\n    }\n  }\n}\n\nexport let bytebuf_push_array = (buf: Array[Int], arr: Array[Int]) -> Unit {\n  Array::push_all(buf, arr)\n}\n\nexport let bytebuf_push_bytes = (buf: Array[Int], bytes: Bytes) -> Unit {\n  // In WASM backend, Bytes = Array[Int], so push_all works directly\n  Array::push_all(buf, bytes)\n}\n\nexport let bytebuf_push_section = (out: Array[Int], section_id: Int, content: Array[Int]) -> Unit {\n  Array::push(out, section_id)\n  leb128_encode_u32(out, Array::length(content))\n  bytebuf_push_array(out, content)\n}\n\nexport let bytebuf_push_vec_header = (buf: Array[Int], count: Int) -> Unit {\n  leb128_encode_u32(buf, count)\n}\n")

  let source_2 = ("vibe/compiler/core/ast.vibe",
"//# Types\n\nexport enum Pat {\n  PWild;\n  PBind(String);\n  PInt(Int);\n  PString(String);\n  PBool(Bool);\n  PCtor(String, Array[Pat]);\n  PTuple(Array[Pat]);\n  POr(Pat, Pat)\n}\n\nexport enum TypeExpr {\n  TyName(String);\n  TyApp(String, Array[TypeExpr]);\n  TyFn(Array[TypeExpr], TypeExpr);\n  TyTuple(Array[TypeExpr]);\n  TyUnit\n}\n\nexport enum Expr {\n  EInt(Int);\n  EFloat(Double);\n  EString(String);\n  EBool(Bool);\n  EIdent(String);\n  ETuple(Array[Expr]);\n  EArray(Array[Expr]);\n  ERecord(Array[(String, Expr)]);\n  EIf(Expr, Expr, Expr);\n  ELet(String, Expr, Expr);\n  ELetRec(String, Expr, Expr);\n  ELetMut(String, Expr, Expr);\n  EAssign(String, Expr, Expr);\n  EAssignOp(String, String, Expr, Expr);\n  ESeq(Expr, Expr);\n  EMatch(Expr, Array[(Pat, Expr)]);\n  EHandle(Expr, Array[(Pat, Expr)]);\n  EWhile(Expr, Expr);\n  ELoop(Array[(String, Expr)], Expr);\n  EForIn(String, Option[String], Expr, Expr);\n  ECall(Expr, Array[Expr]);\n  EBinOp(String, Expr, Expr);\n  EUnaryOp(String, Expr);\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\n  EDot(Expr, String);\n  ELabeledArg(String, String, Expr);\n  EThrow(Expr);\n  EBreak(Option[Expr]);\n  EContinue(Array[Expr]);\n  EMap(Array[(String, Expr)]);\n  ESpread(Expr);\n  EStringInterp(Array[String]);\n  EUnit\n}\n\nexport enum Stmt {\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\n  SLetMut(String, Option[TypeExpr], Expr);\n  SEnum(Bool, String, Array[(String, Array[TypeExpr])]);\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\n  SStruct(Bool, String, Array[(String, TypeExpr)]);\n  STypeAlias(Bool, String, TypeExpr);\n  STrait(Bool, String, Array[String]);\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\n  SExternLet(String, TypeExpr);\n  SImport(String, Array[(String, Option[String])]);\n  STest(String, Expr);\n  SBench(String, Expr);\n  SExpr(Expr);\n  SExport(Array[String]);\n  SReExport(String, Array[(String, Option[String])]);\n  SModule(Bool, String, Array[Stmt])\n}\n")

  let source_3 = ("vibe/compiler/core/types.vibe",
"//# Types\n\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Bool);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)]);\n  TDAlias(String, Type)\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst)\n}\n\n//# Functions\n\nexport let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {\n  EnvBind(name, ty, env)\n}\n\nexport let fresh_var = (c: Int) -> (Type, Int) {\n  (CtVar(c), c + 1)\n}\n\nexport let rec occurs_in = (id: Int, ty: Type) -> Bool {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        if occurs_in(id, Array::get(params, i)) {\n          found = true\n          i = Array::length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if occurs_in(id, Array::get(elems, i)) {\n          found = true\n          i = Array::length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport let rec env_lookup = (env: TypeEnv, name: String) -> Option[Type] {\n  match env {\n    EnvEmpty => None,\n    EnvBind(n, ty, rest) => if String::equals(n, name) {\n      Some(ty)\n    } else env_lookup(rest, name),\n    EnvTraitDef(_, _, _, rest) => env_lookup(rest, name),\n    EnvTraitImpl(_, _, rest) => env_lookup(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => env_lookup(rest, name)\n  }\n}\n\nlet empty_env_bindings = () -> Array[(String, Type)] {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let env_flat_bindings = (env: TypeEnv) -> Array[(String, Type)] {\n  let out = empty_env_bindings()\n  let mut cur = env\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(name, ty, rest) => {\n        Array::push(out, (name, ty))\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let env_lookup_flat = (bindings: Array[(String, Type)], name: String) -> Option[Type] {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = Array::get(bindings, i)\n      if String::equals(n, name) {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet join_types = (arr: Array[String], sep: String) -> String {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut acc = \"\"\n  while (!(i >= len)) {\n    let s = if i > 0 {\n      \"\\{acc}\\{sep}\\{Array::get(arr, i)}\"\n    } else Array::get(arr, i)\n    acc = s\n    i = i + 1\n  }\n  acc\n}\n\nlet string_array_equal = (left: Array[String], right: Array[String]) -> Bool {\n  let len = Array::length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else if (!(String::equals(Array::get(left, i), Array::get(right, i)))) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport let rec types_equal = (a: Type, b: Type) -> Bool {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => String::equals(aname, bname),\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => String::equals(aname, bname),\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtNamed(bname, bargs) =>\n      if (!(String::equals(aname, bname))) {\n        false\n      } else if (Array::length(aargs) != Array::length(bargs)) {\n        false\n      } else {\n        let tae_len = Array::length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while (!(tae_done)) {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else if (!(types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)))) {\n            tae_result = false\n            tae_done = true\n          } else {\n            tae_i = tae_i + 1\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if (Array::length(aelems) != Array::length(belems)) {\n        false\n      } else {\n        let tae_len2 = Array::length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while (!(tae_done2)) {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else if (!(types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)))) {\n            tae_result2 = false\n            tae_done2 = true\n          } else {\n            tae_i2 = tae_i2 + 1\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, ahas_error) => match b {\n      CtFn(bparams, bret, bhas_error) =>\n      if (Array::length(aparams) != Array::length(bparams)) {\n        false\n      } else if ahas_error {\n        if (!(bhas_error)) {\n          false\n        } else {\n          let tae_len3 = Array::length(aparams)\n          let mut tae_i3 = 0\n          let mut tae_result3 = true\n          let mut tae_done3 = false\n          while (!(tae_done3)) {\n            if tae_i3 >= tae_len3 {\n              tae_done3 = true\n            } else if (!(types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)))) {\n              tae_result3 = false\n              tae_done3 = true\n            } else {\n              tae_i3 = tae_i3 + 1\n            }\n          }\n          if (!(tae_result3)) {\n            false\n          } else {\n            types_equal(aret, bret)\n          }\n        }\n      } else if bhas_error {\n        false\n      } else {\n        let tae_len4 = Array::length(aparams)\n        let mut tae_i4 = 0\n        let mut tae_result4 = true\n        let mut tae_done4 = false\n        while (!(tae_done4)) {\n          if tae_i4 >= tae_len4 {\n            tae_done4 = true\n          } else if (!(types_equal(Array::get(aparams, tae_i4), Array::get(bparams, tae_i4)))) {\n            tae_result4 = false\n            tae_done4 = true\n          } else {\n            tae_i4 = tae_i4 + 1\n          }\n        }\n        if (!(tae_result4)) {\n          false\n        } else {\n          types_equal(aret, bret)\n        }\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => {\n        if (Array::length(avars) != Array::length(bvars)) {\n          false\n        } else if (Array::length(abounds) != Array::length(bbounds)) {\n          false\n        } else {\n          // inline var_list_equal\n          let vlen = Array::length(avars)\n          let mut vi = 0\n          let mut vresult = true\n          let mut vdone = false\n          while (!(vdone)) {\n            if vi >= vlen {\n              vdone = true\n            } else if (Array::get(avars, vi) != Array::get(bvars, vi)) {\n              vresult = false\n              vdone = true\n            } else {\n              vi = vi + 1\n            }\n          }\n          if (!(vresult)) {\n            false\n          } else {\n            // inline forall_bounds_equal\n            let fbe_len = Array::length(abounds)\n            let mut fbe_i = 0\n            let mut fbe_result = true\n            let mut fbe_done = false\n            while (!(fbe_done)) {\n              if fbe_i >= fbe_len {\n                fbe_done = true\n              } else {\n                let (lvar, lbounds) = Array::get(abounds, fbe_i)\n                let (rvar, rbounds) = Array::get(bbounds, fbe_i)\n                if (lvar != rvar) {\n                  fbe_result = false\n                  fbe_done = true\n                } else if (Array::length(lbounds) != Array::length(rbounds)) {\n                  fbe_result = false\n                  fbe_done = true\n                } else if (!(string_array_equal(lbounds, rbounds))) {\n                  fbe_result = false\n                  fbe_done = true\n                } else {\n                  fbe_i = fbe_i + 1\n                }\n              }\n            }\n            if (!(fbe_result)) {\n              false\n            } else {\n              types_equal(abody, bbody)\n            }\n          }\n        }\n      },\n      _ => false\n    }\n  }\n}\n\nexport let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while (!(i >= len)) {\n    let (name, ty) = Array::get(bindings, i)\n    acc = EnvBind(name, ty, acc)\n    i = i + 1\n  }\n  acc\n}\n\nexport let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {\n  let len = Array::length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else {\n      let d = Array::get(defs, i)\n      let dname = match d {\n        TDEnum(n, _) => n,\n        TDStruct(n, _) => n,\n        TDAlias(n, _) => n\n      }\n      if String::equals(dname, name) {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet subst_bounds = (s: Subst, id: Int) -> Array[String] {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut cur = s\n  let mut out = empty\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(bid, bounds, rest) => {\n        if (bid == id) {\n          out = bounds\n          done = true\n        } else {\n          cur = rest\n        }\n      }\n    }\n  }\n  out\n}\n\nlet rec int_bounds_has_id = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {\n  if i >= Array::length(pairs) {\n    false\n  } else {\n    let (pid, _) = Array::get(pairs, i)\n    if (pid == id) {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_bounds_lookup = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {\n  if i >= Array::length(pairs) {\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    let (pid, bounds) = Array::get(pairs, i)\n    if (pid == id) {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nlet collect_subst_bounds_pairs = (s: Subst) -> Array[(Int, Array[String])] {\n  let out = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut cur = s\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if (!(int_bounds_has_id(out, id, 0))) {\n          Array::push(out, (id, bounds))\n        }\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nlet rec int_int_lookup_or = (pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {\n  if i >= Array::length(pairs) {\n    fallback\n  } else {\n    let (k, v) = Array::get(pairs, i)\n    if (k == key) {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\nexport let subst_lookup = (s: Subst, id: Int) -> Option[Type] {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => {\n        if (i == id) {\n          out = Some(ty)\n          done = true\n        } else {\n          cur = rest\n        }\n      },\n      SubstBound(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nlet int_array_has = (arr: Array[Int], v: Int) -> Bool {\n  let slen = Array::length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while (!(sdone)) {\n    if si >= slen {\n      sdone = true\n    } else if (Array::get(arr, si) == v) {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nexport let rec subst_apply = (s: Subst, ty: Type) -> Type {\n  match ty {\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = Array::slice([\n        0\n      ], 0, 0)\n      while (!(done)) {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            Array::push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          }\n          ,\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, he) => {\n      let rp = for p in params {\n        subst_apply(s, p)\n      }\n      CtFn(rp, subst_apply(s, ret), he)\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => match ta {\n                CtArray(ea) => match tb {\n                  CtArray(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtOption(ea) => match tb {\n                  CtOption(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtFn(pa, ra, _) => match tb {\n                  CtFn(pb, rb, _) => if (Array::length(pa) != Array::length(pb)) {\n                    None\n                  }\n                  else {\n                    let ul_len = Array::length(pa)\n                    let mut ul_i = 0\n                    let mut ul_acc = s\n                    let mut ul_result = Some(s)\n                    let mut ul_done = false\n                    while (!(ul_done)) {\n                      if ul_i >= ul_len {\n                        ul_result = Some(ul_acc)\n                        ul_done = true\n                      } else {\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\n                          Some(s2) => {\n                            ul_acc = s2\n                            ul_i = ul_i + 1\n                          },\n                          None => {\n                            ul_result = None\n                            ul_done = true\n                          }\n                        }\n                      }\n                    }\n                    match ul_result {\n                      Some(s2) => unify(ra, rb, s2),\n                      None => None\n                    }\n                  }\n                  ,\n                  _ => None\n                },\n                CtTuple(ea) => match tb {\n                  CtTuple(eb) => if (Array::length(ea) != Array::length(eb)) {\n                    None\n                  }\n                  else {\n                    let ul_len2 = Array::length(ea)\n                    let mut ul_i2 = 0\n                    let mut ul_acc2 = s\n                    let mut ul_result2 = Some(s)\n                    let mut ul_done2 = false\n                    while (!(ul_done2)) {\n                      if ul_i2 >= ul_len2 {\n                        ul_result2 = Some(ul_acc2)\n                        ul_done2 = true\n                      } else {\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\n                          Some(s2) => {\n                            ul_acc2 = s2\n                            ul_i2 = ul_i2 + 1\n                          },\n                          None => {\n                            ul_result2 = None\n                            ul_done2 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result2\n                  }\n                  ,\n                  _ => None\n                },\n                CtEnum(a_name) => match tb {\n                  CtEnum(b_name) => if String::equals(a_name, b_name) {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtStruct(a_name) => match tb {\n                  CtStruct(b_name) => if String::equals(a_name, b_name) {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtNamed(a_name, a_args) => match tb {\n                  CtNamed(b_name, b_args) => if (!(String::equals(a_name, b_name))) {\n                    None\n                  }\n                  else if (Array::length(a_args) != Array::length(b_args)) {\n                    None\n                  }\n                  else {\n                    let ul_len3 = Array::length(a_args)\n                    let mut ul_i3 = 0\n                    let mut ul_acc3 = s\n                    let mut ul_result3 = Some(s)\n                    let mut ul_done3 = false\n                    while (!(ul_done3)) {\n                      if ul_i3 >= ul_len3 {\n                        ul_result3 = Some(ul_acc3)\n                        ul_done3 = true\n                      } else {\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\n                          Some(s2) => {\n                            ul_acc3 = s2\n                            ul_i3 = ul_i3 + 1\n                          },\n                          None => {\n                            ul_result3 = None\n                            ul_done3 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result3\n                  }\n                  ,\n                  _ => None\n                },\n                _ => None\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let rec trait_supers = (env: TypeEnv, name: String) -> Array[String] {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, rest) => if String::equals(tname, name) {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name)\n  }\n}\n\nlet rec array_has_int = (arr: Array[Int], val: Int, i: Int) -> Bool {\n  if i >= Array::length(arr) {\n    false\n  }\n  else if (Array::get(arr, i) == val) {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nlet rec collect_tvars_walk = (t: Type, out: Array[Int]) -> Int {\n  match t {\n    CtVar(id) => {\n      if (!(array_has_int(out, id, 0))) {\n        Array::push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport let collect_tvars = (ty: Type) -> Array[Int] {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nexport let generalize = (s: Subst, ty: Type) -> Type {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if (Array::length(tvars) == 0) {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = Array::slice([\n      (0, Array::slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0)\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if (Array::length(bounds) != 0) {\n        Array::push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nexport let rec trait_defined = (env: TypeEnv, name: String) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, rest) => if String::equals(tname, name) {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name)\n  }\n}\n\nexport let rec type_to_string = (ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => \"?t\\{id}\",\n    CtForAll(vars, _, body) => {\n      let vlen = Array::length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while (!(vi >= vlen)) {\n        let v = \"?t\\{Array::get(vars, vi)}\"\n        let next = if vi > 0 {\n          \"\\{vacc} \\{v}\"\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      \"forall \\{vacc}. \\{type_to_string(body)}\"\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => \"Array[\\{type_to_string(elem)}]\",\n    CtOption(elem) => \"Option[\\{type_to_string(elem)}]\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if (Array::length(args) == 0) {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      \"\\{name}[\\{join_types(parts, \", \")}]\"\n    }\n    ,\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      \"(\\{join_types(parts, \", \")})\"\n    },\n    CtFn(params, ret, has_error) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let base = \"(\\{join_types(parts, \", \")}) -> \\{type_to_string(ret)}\"\n      if has_error {\n        \"\\{base} with {Error}\"\n      } else base\n    }\n  }\n}\n\nexport let resolve_builtin = (name: String) -> Option[Type] {\n  if String::equals(name, \"Int\") {\n    Some(CtInt)\n  }\n  else if String::equals(name, \"Double\") {\n    Some(CtDouble)\n  }\n  else if String::equals(name, \"Bool\") {\n    Some(CtBool)\n  }\n  else if String::equals(name, \"String\") {\n    Some(CtString)\n  }\n  else if String::equals(name, \"Char\") {\n    Some(CtChar)\n  }\n  else if String::equals(name, \"Unit\") {\n    Some(CtUnit)\n  }\n  else if String::equals(name, \"Bytes\") {\n    Some(CtBytes)\n  }\n  else None\n}\n\nexport let subst_add_bound = (s: Subst, id: Int, bounds: Array[String]) -> Subst {\n  SubstBound(id, bounds, s)\n}\n\nlet empty_var_bounds = () -> Array[(Int, Array[String])] {\n  Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n}\n\nexport let instantiate = (ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = Array::length(bound_vars)\n      let id_map = Array::slice([\n        (0, 0)\n      ], 0, 0)\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      let mut bnc = c\n      while (!(bi >= blen)) {\n        let old_id = Array::get(bound_vars, bi)\n        Array::push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      // Remap var_bounds: old_id -> new_id\n      let new_bounds = Array::slice([\n        (0, Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        Array::push(new_bounds, (new_id, bounds))\n      };\n      (subst_apply(inst_s, body), c1, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport let types_compatible = (expected: Type, actual: Type) -> Bool {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport let rec impls_overlap_for = (env: TypeEnv, trait_name: String, new_target: Type) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if String::equals(tname, trait_name) {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nexport let rec trait_is_subtrait = (env: TypeEnv, sub: String, super_name: String) -> Bool {\n  // DFS: sub's supers include super_name, or any of sub's supers is a subtrait of super_name\n  if String::equals(sub, super_name) {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = Array::length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while (!(sdone)) {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = Array::get(supers, si)\n        if String::equals(s, super_name) {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nlet rec type_implements_check_super = (e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\nlet rec type_implements_check_env = (e: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if String::equals(tname, trait_name) {\n      if types_equal(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nexport let rec type_implements_trait = (env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else {\n    // Check supertrait: if trait_name has subtrait impls\n    let supers = trait_supers(env, trait_name)\n    let slen = Array::length(supers)\n    if (slen == 0) {\n      false\n    }\n    else {\n      // Type implements trait_name if it implements all supers? No — reversed:\n      // If T implements sub-trait B where B: A, then T also implements A\n      // So check all traits that the type implements and see if any is a subtrait of trait_name\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n")

  let source_4 = ("vibe/compiler/core/dce.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nlet clone_arr = (arr: Array[String]) -> Array[String] {\n  Array::slice(arr, 0, Array::length(arr))\n}\n\nlet stmt_name = (stmt: Stmt) -> Option[String] {\n  match stmt {\n    SLet(_, _, name, _, _) => Some(name),\n    SLetMut(name, _, _) => Some(name),\n    _ => None\n  }\n}\n\nlet array_contains_str = (arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let rec search = (i: Int) -> Bool {\n    if i >= len {\n      false\n    }\n    else if String::equals(Array::get(arr, i), s) {\n      true\n    }\n    else search(i + 1)\n  }\n  search(0)\n}\n\nlet add_ref = (out: Array[String], bound: Array[String], name: String) -> Int {\n  if not(array_contains_str(bound, name)) {\n    if not(array_contains_str(out, name)) {\n      Array::push(out, name)\n    }\n  }\n  0\n}\n\nlet rec collect_pat_bindings = (pat: Pat, bound: Array[String]) -> Int {\n  match pat {\n    PWild => 0,\n    PBind(name) => {\n      Array::push(bound, name)\n      0\n    },\n    PInt(_) => 0,\n    PString(_) => 0,\n    PBool(_) => 0,\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    POr(p1, p2) => {\n      collect_pat_bindings(p1, bound)\n      collect_pat_bindings(p2, bound)\n      0\n    }\n  }\n}\n\nlet rec collect_refs_into = (expr: Expr, bound: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name) => add_ref(out, bound, name)\n    ,\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(e) => collect_refs_into(e, bound, out)\n    ,\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out)\n    ,\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    ECall(callee, args) => {\n      collect_refs_into(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_refs_into(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(then_e, bound, out)\n      collect_refs_into(else_e, bound, out)\n      0\n    },\n    ELet(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetRec(name, val, body) => {\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(val, bound2, out)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetMut(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EAssign(_, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ESeq(l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    EMatch(scr, arms) => {\n      collect_refs_into(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(body_expr, arms) => {\n      collect_refs_into(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(arm_body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ELoop(params, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        collect_refs_into(init, bound2, out)\n        Array::push(bound2, name)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EForIn(name, index_name, iter, body) => {\n      collect_refs_into(iter, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      match index_name {\n        Some(index_name) => Array::push(bound2, index_name),\n        None => ()\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(bound2, pname)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EDot(obj, _) => {\n      collect_refs_into(obj, bound, out)\n      0\n    },\n    ELabeledArg(_, _, e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EStringInterp(_) => 0\n  }\n}\n\nlet collect_refs = (expr: Expr, bound: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_refs_into(expr, bound, out)\n  out\n}\n\nlet is_type_or_structural = (stmt: Stmt) -> Bool {\n  match stmt {\n    SEnum(_, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SStruct(_, _, _) => true,\n    STypeAlias(_, _, _) => true,\n    STrait(_, _, _) => true,\n    SImpl(_, _, _, _) => true,\n    SExternLet(_, _) => true,\n    SImport(_, _) => true,\n    STest(_, _) => true,\n    SBench(_, _) => true,\n    SExpr(_) => true,\n    SExport(_) => true,\n    SReExport(_, _) => true,\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport let dce_stmts = (stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    if not(array_contains_str(reachable, name)) {\n      Array::push(reachable, name)\n      Array::push(queue, name)\n    }\n    j = j + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if String::equals(Array::get(def_names, k), current) {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  let result = Array::slice([\n    Array::get(stmts, 0)\n  ], 0, 0)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    let stmt = Array::get(stmts, m)\n    if is_type_or_structural(stmt) {\n      Array::push(result, stmt)\n    } else {\n      match stmt_name(stmt) {\n        Some(name) => if array_contains_str(reachable, name) {\n          Array::push(result, stmt)\n        }\n        ,\n        None => Array::push(result, stmt)\n      }\n    }\n    m = m + 1\n  }\n  result\n}\n")

  let source_5 = ("vibe/compiler/core/index.vibe",
"export ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nexport ./polyfill.vibe {\n  __to_string\n}\n\nexport ./bytebuf.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_array, bytebuf_push_bytes, bytebuf_push_section, bytebuf_push_vec_header\n}\n\nexport ./dce.vibe {\n  dce_stmts\n}\n\nexport ./types.vibe {\n  Type, TypeDef, TypeEnv, Subst, env_bind, fresh_var, occurs_in, env_lookup, env_flat_bindings, env_lookup_flat, types_equal, env_bind_all, find_typedef, subst_lookup, subst_apply, unify, trait_supers, collect_tvars, generalize, trait_defined, type_to_string, resolve_builtin, subst_add_bound, instantiate, types_compatible, impls_overlap_for, trait_is_subtrait, type_implements_trait\n}\n")

  let source_6 = ("vibe/compiler/polyfill.vibe",
"//# Imports\n\nexport ./core {\n  __to_string\n}\n\n//# Misc\n\nexport {\n  __to_string\n}\n")

  let source_7 = ("vibe/compiler/bytebuf.vibe",
"//# Imports\n\nexport ./core {\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_push_bytes, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32\n}\n\n//# Misc\n\nexport {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_array, bytebuf_push_bytes, bytebuf_push_section, bytebuf_push_vec_header\n}\n")

  let source_8 = ("vibe/compiler/ast.vibe",
"//# Imports\n\nexport ./core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Misc\n\nexport {\n  Pat, Expr, Stmt, TypeExpr\n}\n")

  let source_9 = ("vibe/compiler/syntax/token.vibe",
"//# Imports\n\nimport ../core {\n  __to_string\n}\n\nimport ./float_format.vibe {\n  double_to_string_compiler\n}\n\n//# Types\n\nexport enum Token {\n  TInt(Int);\n  TFloat(Double);\n  TString(String);\n  TIdent(String);\n  TLet;\n  TRec;\n  TMut;\n  TFn;\n  TIf;\n  TElse;\n  TMatch;\n  TDo;\n  TEnum;\n  TStruct;\n  TType;\n  TTrait;\n  TImpl;\n  TExport;\n  TTest;\n  TWhile;\n  TFor;\n  TIn;\n  TLoop;\n  TBreak;\n  TContinue;\n  TReturn;\n  TWith;\n  THandle;\n  TThrow;\n  TRaise;\n  TYield;\n  TBench;\n  TDeclare;\n  TAs;\n  TModule;\n  TSuberror;\n  TDerive;\n  TOpen;\n  TImport;\n  TPlus;\n  TMinus;\n  TStar;\n  TSlash;\n  TPercent;\n  TEqEq;\n  TNeq;\n  TLt;\n  TLte;\n  TGt;\n  TGte;\n  TAnd;\n  TOr;\n  TNot;\n  TBitAnd;\n  TBitOr;\n  TBitXor;\n  TLShift;\n  TRShift;\n  TPipeGt;\n  TArrow;\n  TThinArrow;\n  TEq;\n  TDot;\n  TColon;\n  TDoubleColon;\n  TComma;\n  TSemicolon;\n  THash;\n  TTilde;\n  TQuestion;\n  TPlusEq;\n  TMinusEq;\n  TStarEq;\n  TSlashEq;\n  TPercentEq;\n  TLParen;\n  TRParen;\n  TLBrace;\n  TRBrace;\n  TLBracket;\n  TRBracket;\n  TDotDotDot;\n  TStringInterp(Array[String]);\n  TEof\n}\n\n//# Functions\n\nexport let token_to_string = (t: Token) -> String {\n  match t {\n    TInt(n) => String::concat(\"TInt(\", String::concat(__to_string(n), \")\")),\n    TFloat(n) =>\n    String::concat(\"TFloat(\", String::concat(double_to_string_compiler(n), \")\")),\n    TString(s) => String::concat(\"TString(\\\"\", String::concat(s, \"\\\")\")),\n    TIdent(s) => String::concat(\"TIdent(\", String::concat(s, \")\")),\n    TLet => \"TLet\",\n    TRec => \"TRec\",\n    TMut => \"TMut\",\n    TFn => \"TFn\",\n    TIf => \"TIf\",\n    TElse => \"TElse\",\n    TMatch => \"TMatch\",\n    TDo => \"TDo\",\n    TEnum => \"TEnum\",\n    TStruct => \"TStruct\",\n    TType => \"TType\",\n    TTrait => \"TTrait\",\n    TImpl => \"TImpl\",\n    TExport => \"TExport\",\n    TTest => \"TTest\",\n    TWhile => \"TWhile\",\n    TFor => \"TFor\",\n    TIn => \"TIn\",\n    TLoop => \"TLoop\",\n    TBreak => \"TBreak\",\n    TContinue => \"TContinue\",\n    TReturn => \"TReturn\",\n    TWith => \"TWith\",\n    THandle => \"THandle\",\n    TThrow => \"TThrow\",\n    TRaise => \"TRaise\",\n    TYield => \"TYield\",\n    TBench => \"TBench\",\n    TDeclare => \"TDeclare\",\n    TAs => \"TAs\",\n    TModule => \"TModule\",\n    TSuberror => \"TSuberror\",\n    TDerive => \"TDerive\",\n    TOpen => \"TOpen\",\n    TImport => \"TImport\",\n    TPlus => \"TPlus\",\n    TMinus => \"TMinus\",\n    TStar => \"TStar\",\n    TSlash => \"TSlash\",\n    TPercent => \"TPercent\",\n    TEqEq => \"TEqEq\",\n    TNeq => \"TNeq\",\n    TLt => \"TLt\",\n    TLte => \"TLte\",\n    TGt => \"TGt\",\n    TGte => \"TGte\",\n    TAnd => \"TAnd\",\n    TOr => \"TOr\",\n    TNot => \"TNot\",\n    TBitAnd => \"TBitAnd\",\n    TBitOr => \"TBitOr\",\n    TBitXor => \"TBitXor\",\n    TLShift => \"TLShift\",\n    TRShift => \"TRShift\",\n    TPipeGt => \"TPipeGt\",\n    TArrow => \"TArrow\",\n    TThinArrow => \"TThinArrow\",\n    TEq => \"TEq\",\n    TDot => \"TDot\",\n    TColon => \"TColon\",\n    TDoubleColon => \"TDoubleColon\",\n    TComma => \"TComma\",\n    TSemicolon => \"TSemicolon\",\n    THash => \"THash\",\n    TTilde => \"TTilde\",\n    TQuestion => \"TQuestion\",\n    TPlusEq => \"TPlusEq\",\n    TMinusEq => \"TMinusEq\",\n    TStarEq => \"TStarEq\",\n    TSlashEq => \"TSlashEq\",\n    TPercentEq => \"TPercentEq\",\n    TLParen => \"TLParen\",\n    TRParen => \"TRParen\",\n    TLBrace => \"TLBrace\",\n    TRBrace => \"TRBrace\",\n    TLBracket => \"TLBracket\",\n    TRBracket => \"TRBracket\",\n    TDotDotDot => \"TDotDotDot\",\n    TStringInterp(_) => \"TStringInterp\",\n    TEof => \"TEof\"\n  }\n}\n")

  let source_10 = ("vibe/compiler/syntax/float_format.vibe",
"//# Imports\n\nimport ../core {\n  __to_string\n}\n\n//# Functions\n\nlet zero_pad_6 = (n: Int) -> String {\n  let s = __to_string(n)\n  let len = String::length(s)\n  if len >= 6 {\n    s\n  } else {\n    let mut out = \"\"\n    let mut i = len\n    while i < 6 {\n      out = String::concat(out, \"0\")\n      i = i + 1\n    }\n    String::concat(out, s)\n  }\n}\n\nlet trim_trailing_zeros = (s: String) -> String {\n  let mut end = String::length(s)\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\n    end = end - 1\n  }\n  if end <= 0 {\n    \"\"\n  } else {\n    String::substring(s, 0, end)\n  }\n}\n\nexport let double_to_string_compiler = (d: Double) -> String {\n  if d != d {\n    \"nan\"\n  } else {\n    let neg = d < 0.0\n    let abs_d = if neg {\n      0.0 - d\n    } else {\n      d\n    }\n    let int_part = Double::to_int(abs_d)\n    let frac = abs_d - Int::to_double(int_part)\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\n    let int_norm = if eq(scaled_raw, 1000000) {\n      int_part + 1\n    } else {\n      int_part\n    }\n    let frac_norm = if eq(scaled_raw, 1000000) {\n      0\n    } else {\n      scaled_raw\n    }\n    let int_s = __to_string(int_norm)\n    let frac_s = if eq(frac_norm, 0) {\n      \"\"\n    } else {\n      trim_trailing_zeros(zero_pad_6(frac_norm))\n    }\n    let body = if String::length(frac_s) == 0 {\n      int_s\n    } else {\n      String::concat(int_s, String::concat(\".\", frac_s))\n    }\n    if neg {\n      String::concat(\"-\", body)\n    } else {\n      body\n    }\n  }\n}\n")

  let source_11 = ("vibe/compiler/syntax/lexer.vibe",
"//# Imports\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet is_ws = (c: Int) -> Bool {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nlet is_alpha = (c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nlet is_digit = (c: Int) -> Bool {\n  c >= '0' && c <= '9'\n}\n\nlet is_alnum = (c: Int) -> Bool {\n  is_alpha(c) || is_digit(c)\n}\n\nlet lex_char = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = String::char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = String::char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nlet is_hex_digit = (c: Int) -> Bool {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nlet keyword_lookup = (word: String) -> Option[Token] {\n  let len = String::length(word)\n  if len == 2 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'f' {\n      if String::equals(word, \"fn\") {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if String::equals(word, \"if\") {\n        Some(TIf)\n      } else if String::equals(word, \"in\") {\n        Some(TIn)\n      } else None\n    } else if c0 == 'd' {\n      if String::equals(word, \"do\") {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if String::equals(word, \"as\") {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'l' {\n      if String::equals(word, \"let\") {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if String::equals(word, \"rec\") {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if String::equals(word, \"mut\") {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if String::equals(word, \"for\") {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'e' {\n      if String::equals(word, \"else\") {\n        Some(TElse)\n      } else if String::equals(word, \"enum\") {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if String::equals(word, \"true\") {\n        Some(TIdent(\"true\"))\n      } else if String::equals(word, \"type\") {\n        Some(TType)\n      } else if String::equals(word, \"test\") {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if String::equals(word, \"with\") {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if String::equals(word, \"loop\") {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if String::equals(word, \"open\") {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if String::equals(word, \"impl\") {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'f' {\n      if String::equals(word, \"false\") {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if String::equals(word, \"match\") {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if String::equals(word, \"trait\") {\n        Some(TTrait)\n      } else if String::equals(word, \"throw\") {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if String::equals(word, \"while\") {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if String::equals(word, \"break\") {\n        Some(TBreak)\n      } else if String::equals(word, \"bench\") {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if String::equals(word, \"raise\") {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if String::equals(word, \"yield\") {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 's' {\n      if String::equals(word, \"struct\") {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if String::equals(word, \"export\") {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if String::equals(word, \"return\") {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if String::equals(word, \"handle\") {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if String::equals(word, \"module\") {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if String::equals(word, \"derive\") {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if String::equals(word, \"import\") {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if String::equals(word, \"declare\") {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'c' {\n      if String::equals(word, \"continue\") {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if String::equals(word, \"suberror\") {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nlet rec scan_ident_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_alnum(String::char_code_at(s, i)) {\n    scan_ident_end(s, len, i + 1)\n  } else i\n}\n\nlet lex_ident = (s: String, len: Int, i: Int) -> (Token, Int) {\n  let end = scan_ident_end(s, len, i)\n  let word = String::substring(s, i, end)\n  match keyword_lookup(word) {\n    Some(tok) => if String::equals(word, \"true\") || String::equals(word, \"false\") {\n      (TIdent(word), end)\n    } else (tok, end),\n    None => (TIdent(word), end)\n  }\n}\n\nlet rec scan_interp_end = (s: String, len: Int, idx: Int, depth: Int) -> Int with { Error } {\n  if idx >= len {\n    throw(\"unterminated string interpolation\")\n  }\n  let c = String::char_code_at(s, idx)\n  if c == '{' {\n    scan_interp_end(s, len, idx + 1, depth + 1)\n  } else if c == '}' {\n    if depth == 1 {\n      idx\n    } else scan_interp_end(s, len, idx + 1, depth - 1)\n  } else scan_interp_end(s, len, idx + 1, depth)\n}\n\nlet rec lex_string_go = (\n  s: String,\n  len: Int,\n  idx: Int,\n  start: Int,\n  acc: String,\n  has_interp: Bool,\n  parts: ArrayBuilder[String]\n) -> (Token, Int) with { Error } {\n  {\n    if idx >= len {\n      throw(\"unterminated string\")\n    }\n    let c = String::char_code_at(s, idx)\n    if c == '\"' {\n      let chunk = String::substring(s, start, idx)\n      let value = String::concat(acc, chunk)\n      if has_interp {\n        ArrayBuilder::push(parts, value)\n        (TStringInterp(ArrayBuilder::freeze(parts)), idx + 1)\n      } else {\n        (TString(value), idx + 1)\n      }\n    } else if c == '\\\\' {\n      let chunk = String::substring(s, start, idx)\n      let next = idx + 1\n      if next >= len {\n        throw(\"unterminated string escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      if esc == '{' {\n        ArrayBuilder::push(parts, String::concat(acc, chunk))\n        let interp_end = scan_interp_end(s, len, next + 1, 1)\n        let expr_src = String::substring(s, next + 1, interp_end)\n        ArrayBuilder::push(parts, expr_src)\n        lex_string_go(s, len, interp_end + 1, interp_end + 1, \"\", true, parts)\n      } else {\n        let escaped = if esc == '\"' {\n          \"\\\"\"\n        }\n        else if esc == '\\\\' {\n          \"\\\\\"\n        }\n        else if esc == 'n' {\n          \"\\n\"\n        }\n        else if esc == 't' {\n          \"\\t\"\n        }\n        else if esc == 'r' {\n          String::from_char_code(13)\n        }\n        else if esc == '0' {\n          String::from_char_code(0)\n        }\n        else throw(\"invalid escape sequence\")\n        lex_string_go(\n          s,\n          len,\n          next + 1,\n          next + 1,\n          String::concat(String::concat(acc, chunk), escaped),\n          has_interp,\n          parts\n        )\n      }\n    } else {\n      lex_string_go(s, len, idx + 1, start, acc, has_interp, parts)\n    }\n  }\n}\n\nlet lex_string = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  lex_string_go(s, len, i + 1, i + 1, \"\", false, ArrayBuilder::new())\n}\n\nlet rec scan_digits_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_digit(String::char_code_at(s, i)) {\n    scan_digits_end(s, len, i + 1)\n  } else i\n}\n\nlet rec parse_frac_digits = (s: String, len: Int, i: Int, acc: Double, scale: Double) -> (Double, Int) {\n  if i < len {\n    let c = String::char_code_at(s, i)\n    if is_digit(c) {\n      parse_frac_digits(s, len, i + 1, acc + Int::to_double(c - 48) / scale, scale * 10.0)\n    } else (acc, i)\n  } else (acc, i)\n}\n\nlet rec skip_until_newline = (s: String, len: Int, i: Int) -> Int {\n  if i < len {\n    if String::char_code_at(s, i) == '\\n' {\n      i + 1\n    } else skip_until_newline(s, len, i + 1)\n  } else i\n}\n\nlet rec skip_ws = (s: String, len: Int, i: Int) -> Int {\n  if i < len {\n    let c = String::char_code_at(s, i)\n    if is_ws(c) {\n      skip_ws(s, len, i + 1)\n    } else if c == '/' && i + 1 < len && String::char_code_at(s, i + 1) == '/' {\n      let after_comment = skip_until_newline(s, len, i + 2)\n      skip_ws(s, len, after_comment)\n    } else i\n  } else i\n}\n\nlet rec scan_hex_digits_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_hex_digit(String::char_code_at(s, i)) {\n    scan_hex_digits_end(s, len, i + 1)\n  } else i\n}\n\nlet parse_hex_from_string = (s: String) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nlet parse_int_from_string = (s: String) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    acc = acc * 10 + (c - 48)\n    i = i + 1\n  }\n  acc\n}\n\nlet lex_decimal = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  if int_end < len && String::char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\n      let int_str = String::substring(s, i, int_end)\n      let int_val = Int::to_double(parse_int_from_string(int_str))\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\n      (TFloat(int_val + frac_val), frac_end)\n    } else {\n      let int_str = String::substring(s, i, int_end);\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else {\n    let int_str = String::substring(s, i, int_end);\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nlet lex_number = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\n    let next_c = String::char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = String::substring(s, hex_start, hex_end);\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\nexport let lex = (source: String) -> Array[Token] with { Error } {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let mut pos = skip_ws(source, len, 0)\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = if is_alpha(c) {\n        lex_ident(source, len, pos)\n      } else if is_digit(c) {\n        lex_number(source, len, pos)\n      } else if c == '\"' {\n        lex_string(source, len, pos)\n      } else if c == '+' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TPlusEq, pos + 2)\n        } else (TPlus, pos + 1)\n      } else if c == '-' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TThinArrow, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TMinusEq, pos + 2)\n        } else (TMinus, pos + 1)\n      } else if c == '*' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TStarEq, pos + 2)\n        } else (TStar, pos + 1)\n      } else if c == '/' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TSlashEq, pos + 2)\n        } else (TSlash, pos + 1)\n      } else if c == '%' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TPercentEq, pos + 2)\n        } else (TPercent, pos + 1)\n      } else if c == '=' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TEqEq, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TArrow, pos + 2)\n        } else (TEq, pos + 1)\n      } else if c == '!' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TNeq, pos + 2)\n        } else (TNot, pos + 1)\n      } else if c == '<' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TLte, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\n          (TLShift, pos + 2)\n        } else (TLt, pos + 1)\n      } else if c == '>' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TGte, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TRShift, pos + 2)\n        } else (TGt, pos + 1)\n      } else if c == '&' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\n          (TAnd, pos + 2)\n        } else (TBitAnd, pos + 1)\n      } else if c == '|' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\n          (TOr, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TPipeGt, pos + 2)\n        } else (TBitOr, pos + 1)\n      } else if c == '^' {\n        (TBitXor, pos + 1)\n      } else if c == '(' {\n        (TLParen, pos + 1)\n      } else if c == ')' {\n        (TRParen, pos + 1)\n      } else if c == '{' {\n        (TLBrace, pos + 1)\n      } else if c == '}' {\n        (TRBrace, pos + 1)\n      } else if c == '[' {\n        (TLBracket, pos + 1)\n      } else if c == ']' {\n        (TRBracket, pos + 1)\n      } else if c == ',' {\n        (TComma, pos + 1)\n      } else if c == ';' {\n        (TSemicolon, pos + 1)\n      } else if c == '.' {\n        if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\n          (TDotDotDot, pos + 3)\n        } else (TDot, pos + 1)\n      } else if c == ':' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\n          (TDoubleColon, pos + 2)\n        } else (TColon, pos + 1)\n      } else if c == '#' {\n        (THash, pos + 1)\n      } else if c == '~' {\n        (TTilde, pos + 1)\n      } else if c == '?' {\n        (TQuestion, pos + 1)\n      } else if c == '\\'' {\n        lex_char(source, len, pos)\n      } else throw(String::concat(\"unexpected character: \", String::from_char_code(c)))\n      ArrayBuilder::push(b, tok)\n      pos = skip_ws(source, len, next)\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::freeze(b)\n  }\n}\n\nexport let lex_ok = (source: String) -> Bool {\n  handle {\n    let _ = lex(source)\n    true\n  } {\n    Error(_) => false\n  }\n}\n")

  let source_12 = ("vibe/compiler/syntax/parser.vibe",
"//# Imports\n\nimport ../core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet peek = (tokens: Array[Token], pos: Int) -> Token {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else TEof\n}\n\nlet _no_tp = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet _no_tb = () -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet mode_if = 21\n\nlet tk_name = (tok: Token) -> String {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TStringInterp(_) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TDotDotDot => \"...\",\n    TStringInterp(_) => \"string\",\n    TEof => \"eof\"\n  }\n}\n\nlet is_tk = (tok: Token, name: String) -> Bool {\n  String::equals(tk_name(tok), name)\n}\n\nlet expect_tk = (tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  }\n  else throw(\"expected \\{expected} but got \\{tk_name(peek(tokens, pos))}\")\n}\n\nlet skip_semi = (tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nlet empty_arms = () -> Array[(Pat, Expr)] {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nlet empty_pats = () -> Array[Pat] {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nlet mode_block = 20\n\nlet mode_match = 22\n\nlet mode_while = 23\n\nlet empty_ctors = () -> Array[(String, Array[TypeExpr])] {\n  Array::slice([\n    (\"_\", Array::slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet empty_exprs = () -> Array[Expr] {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet empty_names = () -> Array[String] {\n  Array::slice([\n    \"_\"\n  ], 0, 0)\n}\n\nlet mode_for_in = 25\n\nlet mode_handle = 24\n\nlet empty_fields = () -> Array[(String, TypeExpr)] {\n  Array::slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nlet empty_params = () -> Array[(String, Option[TypeExpr])] {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nlet rec parse_pattern = (tokens: Array[Token], pos: Int) -> (Pat, Int)with { Error } {\n  let rec parse_pat_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Pat]) -> (Array[Pat], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen = (tokens: Array[Token], pos: Int) -> (Array[Pat], Int)with { Error } {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => if String::equals(name, \"true\") {\n      (PBool(true), pos + 1)\n    }\n    else if String::equals(name, \"false\") {\n      (PBool(false), pos + 1)\n    }\n    else if String::equals(name, \"_\") {\n      (PWild, pos + 1)\n    }\n    else {\n      let fc = String::char_code_at(name, 0)\n      if fc >= 65 && fc <= 90 {\n        match peek(tokens, pos + 1) {\n          TLParen => {\n            let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n            (PCtor(name, args), end)\n          },\n          _ => (PCtor(name, empty_pats()), pos + 1)\n        }\n      } else (PBind(name), pos + 1)\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => throw(\"unexpected in pattern: \\{tk_name(peek(tokens, pos))}\")\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nlet parse_impl_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"_\", empty_strings)\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TLBracket => throw(\"impl type parameters are not supported yet\"),\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, pos + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => (SImpl(empty_strings, empty_bounds, trait_name, type_name), fp + 1),\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nlet empty_type_exprs = () -> Array[TypeExpr] {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nlet rec parse_type_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int)with { Error } {\n  let rec type_list_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n        ArrayBuilder::push(b, ty)\n        type_list_rest(tokens, next, b)\n      },\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  if mode == 0 {\n    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n    match peek(tokens, atom_next) {\n      TThinArrow => {\n        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n        let params = match atom_ty {\n          TyUnit => empty_type_exprs(),\n          TyTuple(elems) => elems,\n          _ => [\n            atom_ty\n          ]\n        }\n        let rn2 = match peek(tokens, rn) {\n          TWith => {\n            let p1 = rn + 1\n            match peek(tokens, p1) {\n              TLBrace => {\n                let mut p2 = p1 + 1\n                let mut done = false\n                while (!(done)) {\n                  match peek(tokens, p2) {\n                    TRBrace => {\n                      done = true\n                    },\n                    _ => {\n                      p2 = p2 + 1\n                    }\n                  }\n                }\n                p2 + 1\n              },\n              _ => rn\n            }\n          },\n          _ => rn\n        };\n        (TyFn(params, ret), rn2)\n      },\n      _ => (atom_ty, atom_next)\n    }\n  } else match peek(tokens, pos) {\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (TyUnit, pos + 2),\n      _ => {\n        let (first, n1) = parse_type_impl(tokens, pos + 1, 0)\n        match peek(tokens, n1) {\n          TRParen => (first, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, first)\n            let (rest, end) = type_list_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \")\");\n            (TyTuple(rest), en)\n          },\n          _ => throw(\"expected ')' or ',' in type\")\n        }\n      }\n    },\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLBracket => {\n        let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n        match peek(tokens, n1) {\n          TRBracket => (TyApp(name, [\n            first\n          ]), n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, first)\n            let (rest, end) = type_list_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \"]\");\n            (TyApp(name, rest), en)\n          },\n          _ => throw(\"expected ']' or ',' in type application\")\n        }\n      },\n      _ => (TyName(name), pos + 1)\n    },\n    _ => throw(\"expected type but got \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nexport let parse_type = (tokens: Array[Token], pos: Int) -> (TypeExpr, Int)with { Error } {\n  parse_type_impl(tokens, pos, 0)\n}\n\nlet parse_one_param = (tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = \"\\{name}~\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        ((name, Some(ty)), tp)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => throw(\"expected parameter name\")\n  }\n}\n\nlet rec parse_param_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (p, pn) = parse_one_param(tokens, pos + 1)\n      ArrayBuilder::push(b, p)\n      parse_param_cont(tokens, pn, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in param list\")\n  }\n}\n\nlet parse_param_list = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nlet parse_trait_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TColon => {\n        let rec parse_supers = (p: Int, acc: Array[String]) -> (Array[String], Int) {\n          match peek(tokens, p) {\n            TIdent(sname) => match peek(tokens, p + 1) {\n              TPlus => parse_supers(p + 2, Array::concat(acc, [\n                sname\n              ])),\n              _ => (Array::concat(acc, [\n                sname\n              ]), p + 1)\n            },\n            _ => (acc, p)\n          }\n        }\n        let (supers, np) = parse_supers(pos + 2, empty_strings);\n        (STrait(exported, name, supers), np)\n      },\n      _ => (STrait(exported, name, empty_strings), pos + 1)\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nlet is_expr_end_token = (tok: Token) -> Bool {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TStringInterp(_) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nlet is_non_pipe_infix = (tok: Token) -> Bool {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nlet parse_import_item = (tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int)with { Error } {\n  let parse_import_name = (name_pos: Int) -> ((String, Option[String]), Int)with { Error } {\n    match peek(tokens, name_pos) {\n      TIdent(name) => match peek(tokens, name_pos + 1) {\n        TAs => match peek(tokens, name_pos + 2) {\n          TIdent(alias) => ((name, Some(alias)), name_pos + 3),\n          _ => throw(\"expected alias name after 'as'\")\n        },\n        _ => ((name, None), name_pos + 1)\n      },\n      _ => throw(\"expected import item name\")\n    }\n  }\n  match peek(tokens, pos) {\n    TIdent(_) => parse_import_name(pos),\n    TType => parse_import_name(pos + 1),\n    TTrait => parse_import_name(pos + 1),\n    _ => throw(\"expected import item name\")\n  }\n}\n\nlet empty_import_items = () -> Array[(String, Option[String])] {\n  Array::slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nlet parse_binding_name = (tokens: Array[Token], pos: Int) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nlet parse_struct_field = (tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, pos + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nlet rec collect_import_path = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, \"\\{acc}.\"),\n    TSlash => collect_import_path(tokens, pos + 1, \"\\{acc}/\"),\n    TIdent(name) => collect_import_path(tokens, pos + 1, \"\\{acc}\\{name}\"),\n    TMinus => collect_import_path(tokens, pos + 1, \"\\{acc}-\"),\n    TModule => collect_import_path(tokens, pos + 1, \"\\{acc}module\"),\n    TType => collect_import_path(tokens, pos + 1, \"\\{acc}type\"),\n    TMatch => collect_import_path(tokens, pos + 1, \"\\{acc}match\"),\n    TTest => collect_import_path(tokens, pos + 1, \"\\{acc}test\"),\n    _ => throw(\"unexpected token in import path: \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nlet rec collect_effect_names = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let new_acc = if String::length(acc) == 0 {\n        name\n      } else \"\\{acc}, \\{name}\"\n      match peek(tokens, pos + 1) {\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\n        TRBrace => (new_acc, pos + 2),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nlet rec is_lambda_start_impl = (tokens: Array[Token], pos: Int, depth: Int, has_colon: Bool) -> Bool {\n  match peek(tokens, pos) {\n    TColon => if depth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => has_colon,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)\n  }\n}\n\nlet is_lambda_start = (tokens: Array[Token], pos: Int) -> Bool {\n  is_lambda_start_impl(tokens, pos, 0, false)\n}\n\nlet rec parse_ctor_types_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nlet parse_enum_ctor = (tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nlet rec parse_enum_ctors_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in enum\")\n  }\n}\n\nlet parse_enum_ctors = (tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_enum_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      (SEnum(exported, name, ctors), end)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nlet parse_suberror_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = ArrayBuilder::new()\n          ArrayBuilder::push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = ArrayBuilder::new()\n          ArrayBuilder::push(ctors_b, (name, args))\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nlet parse_type_alias_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let ep = expect_tk(tokens, pos + 1, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nlet has_non_pipe_infix_top = (tokens: Array[Token], start: Int, end: Int) -> Bool {\n  let rec go = (i: Int, depth: Int, prev_top_end: Bool) -> Bool {\n    if i >= end {\n      false\n    } else {\n      let tok = peek(tokens, i)\n      if depth == 0 {\n        if is_non_pipe_infix(tok) {\n          if prev_top_end {\n            true\n          } else go(i + 1, 0, false)\n        } else match tok {\n          TLParen => go(i + 1, 1, false),\n          TLBracket => go(i + 1, 1, false),\n          TLBrace => go(i + 1, 1, false),\n          _ => go(i + 1, 0, is_expr_end_token(tok))\n        }\n      } else match tok {\n        TLParen => go(i + 1, depth + 1, prev_top_end),\n        TLBracket => go(i + 1, depth + 1, prev_top_end),\n        TLBrace => go(i + 1, depth + 1, prev_top_end),\n        TRParen => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        TRBracket => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        TRBrace => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        _ => go(i + 1, depth, prev_top_end)\n      }\n    }\n  }\n  go(start, 0, false)\n}\n\nexport let rec parse_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (Expr, Int)with { Error } {\n  let rec parse_comma_exprs_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (e, next) = parse_impl(tokens, pos + 1, 0)\n        ArrayBuilder::push(b, e)\n        parse_comma_exprs_rest(tokens, next, b)\n      },\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  let parse_primary = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TInt(n) => (EInt(n), pos + 1),\n      TFloat(n) => (EFloat(n), pos + 1),\n      TString(s) => (EString(s), pos + 1),\n      TStringInterp(parts) => (EStringInterp(parts), pos + 1),\n      TIdent(name) => if String::equals(name, \"true\") {\n        (EBool(true), pos + 1)\n      }\n      else if String::equals(name, \"false\") {\n        (EBool(false), pos + 1)\n      }\n      else if String::equals(name, \"map\") {\n        match peek(tokens, pos + 1) {\n          TLBrace => {\n            let rec parse_map_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int)with { Error } {\n              match peek(toks, p) {\n                TRBrace => (ArrayBuilder::freeze(b), p + 1),\n                TIdent(fname) => {\n                  let cn = expect_tk(toks, p + 1, \":\")\n                  let (val, vn) = parse_impl(toks, cn, 0)\n                  ArrayBuilder::push(b, (fname, val))\n                  match peek(toks, vn) {\n                    TComma => parse_map_fields(toks, vn + 1, b),\n                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),\n                    _ => throw(\"expected ',' or '}' in map literal\")\n                  }\n                },\n                TString(skey) => {\n                  let cn = expect_tk(toks, p + 1, \":\")\n                  let (val, vn) = parse_impl(toks, cn, 0)\n                  ArrayBuilder::push(b, (skey, val))\n                  match peek(toks, vn) {\n                    TComma => parse_map_fields(toks, vn + 1, b),\n                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),\n                    _ => throw(\"expected ',' or '}' in map literal\")\n                  }\n                },\n                _ => throw(\"expected field name or '}' in map literal\")\n              }\n            }\n            let mb = ArrayBuilder::new()\n            let (fields, end) = parse_map_fields(tokens, pos + 2, mb);\n            (EMap(fields), end)\n          },\n          _ => (EIdent(name), pos + 1)\n        }\n      }\n      else match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TIdent(member) => (EIdent(String::concat(name, String::concat(\"::\", member))), pos + 3),\n          TLBrace => {\n            let rec parse_record_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int)with { Error } {\n              match peek(toks, p) {\n                TRBrace => (ArrayBuilder::freeze(b), p + 1),\n                TIdent(fname) => {\n                  let cn = expect_tk(toks, p + 1, \":\")\n                  let (val, vn) = parse_impl(toks, cn, 0)\n                  ArrayBuilder::push(b, (fname, val))\n                  match peek(toks, vn) {\n                    TComma => parse_record_fields(toks, vn + 1, b),\n                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),\n                    _ => throw(\"expected ',' or '}' in record literal\")\n                  }\n                },\n                _ => throw(\"expected field name or '}' in record literal\")\n              }\n            }\n            let rb = ArrayBuilder::new()\n            let (fields, end) = parse_record_fields(tokens, pos + 3, rb);\n            (ERecord(fields), end)\n          },\n          _ => (EIdent(name), pos + 1)\n        },\n        _ => (EIdent(name), pos + 1)\n      },\n      TLParen => if is_lambda_start(tokens, pos + 1) {\n        let (params, ap) = parse_param_list(tokens, pos + 1)\n        let parse_lambda_body = (saved_params: Array[(String, Option[TypeExpr])], saved_ret_ty: Option[TypeExpr], saved_effect: Option[String], body_pos: Int, body_mode: Int) -> (Expr, Int)with { Error } {\n          let (body, end) = parse_impl(tokens, body_pos, body_mode);\n          (EFn(_no_tp(), _no_tb(), saved_params, saved_ret_ty, saved_effect, body), end)\n        }\n        match peek(tokens, ap) {\n          TThinArrow => {\n            let after_arrow = ap + 1\n            match peek(tokens, after_arrow) {\n              TIdent(_) => {\n                let (ty, tp) = parse_type_impl(tokens, after_arrow, 0)\n                match peek(tokens, tp) {\n                  TLBrace => parse_lambda_body(params, Some(ty), None, tp + 1, mode_block),\n                  TWith => {\n                    let wb = expect_tk(tokens, tp + 1, \"{\")\n                    let (eff, eb) = collect_effect_names(tokens, wb, \"\")\n                    let bb = expect_tk(tokens, eb, \"{\")\n                    parse_lambda_body(params, Some(ty), Some(eff), bb, mode_block)\n                  },\n                  _ => parse_lambda_body(params, None, None, after_arrow, 0)\n                }\n              },\n              TLParen => {\n                let (ty, tp) = parse_type_impl(tokens, after_arrow, 0)\n                match peek(tokens, tp) {\n                  TLBrace => parse_lambda_body(params, Some(ty), None, tp + 1, mode_block),\n                  TWith => {\n                    let wb = expect_tk(tokens, tp + 1, \"{\")\n                    let (eff, eb) = collect_effect_names(tokens, wb, \"\")\n                    let bb = expect_tk(tokens, eb, \"{\")\n                    parse_lambda_body(params, Some(ty), Some(eff), bb, mode_block)\n                  },\n                  _ => parse_lambda_body(params, None, None, after_arrow, 0)\n                }\n              },\n              _ => parse_lambda_body(params, None, None, after_arrow, 0)\n            }\n          },\n          TLBrace => parse_lambda_body(params, None, None, ap + 1, mode_block),\n          _ => throw(\"expected '->' or '{' after fn params\")\n        }\n      } else match peek(tokens, pos + 1) {\n        TRParen => (EUnit, pos + 2),\n        _ => {\n          let (f, n1) = parse_impl(tokens, pos + 1, 0)\n          match peek(tokens, n1) {\n            TRParen => (f, n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, f)\n              let (tup, end) = parse_comma_exprs_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (ETuple(tup), en)\n            },\n            _ => throw(\"expected ')' or ','\")\n          }\n        }\n      },\n      TLBracket => {\n        let rec parse_array_elems_rest = (toks: Array[Token], p: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {\n          match peek(toks, p) {\n            TComma => {\n              let next_p = p + 1\n              match peek(toks, next_p) {\n                TDotDotDot => {\n                  let (e, en) = parse_impl(toks, next_p + 1, 0)\n                  ArrayBuilder::push(b, ESpread(e))\n                  parse_array_elems_rest(toks, en, b)\n                },\n                _ => {\n                  let (e, en) = parse_impl(toks, next_p, 0)\n                  ArrayBuilder::push(b, e)\n                  parse_array_elems_rest(toks, en, b)\n                }\n              }\n            },\n            _ => (ArrayBuilder::freeze(b), p)\n          }\n        }\n        match peek(tokens, pos + 1) {\n          TRBracket => (EArray(empty_exprs()), pos + 2),\n          TDotDotDot => {\n            let b = ArrayBuilder::new()\n            let (f, n1) = parse_impl(tokens, pos + 2, 0)\n            ArrayBuilder::push(b, ESpread(f))\n            let (arr, end) = parse_array_elems_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \"]\");\n            (EArray(arr), en)\n          },\n          _ => {\n            let b = ArrayBuilder::new()\n            let (f, n1) = parse_impl(tokens, pos + 1, 0)\n            ArrayBuilder::push(b, f)\n            let (arr, end) = parse_array_elems_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \"]\");\n            (EArray(arr), en)\n          }\n        }\n      },\n      TLBrace => parse_impl(tokens, pos + 1, mode_block),\n      TIf => parse_impl(tokens, pos + 1, mode_if),\n      TMatch => parse_impl(tokens, pos + 1, mode_match),\n      THandle => parse_impl(tokens, pos + 1, mode_handle),\n      TWhile => parse_impl(tokens, pos + 1, mode_while),\n      TFor => parse_impl(tokens, pos + 1, mode_for_in),\n      TThrow => {\n        let lp = expect_tk(tokens, pos + 1, \"(\")\n        let (e, en) = parse_impl(tokens, lp, 0)\n        let rp = expect_tk(tokens, en, \")\");\n        (EThrow(e), rp)\n      },\n      TBreak => {\n        let next_tok = peek(tokens, pos + 1)\n        match next_tok {\n          TRBrace => (EBreak(None), pos + 1),\n          TSemicolon => (EBreak(None), pos + 1),\n          TEof => (EBreak(None), pos + 1),\n          _ => {\n            let (e, en) = parse_impl(tokens, pos + 1, 0);\n            (EBreak(Some(e)), en)\n          }\n        }\n      },\n      TContinue => match peek(tokens, pos + 1) {\n        TLParen => {\n          let b = ArrayBuilder::new()\n          match peek(tokens, pos + 2) {\n            TRParen => (EContinue(empty_exprs()), pos + 3),\n            _ => {\n              let (f, fn1) = parse_impl(tokens, pos + 2, 0)\n              ArrayBuilder::push(b, f)\n              let (args, end) = parse_comma_exprs_rest(tokens, fn1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (EContinue(args), en)\n            }\n          }\n        },\n        _ => (EContinue(empty_exprs()), pos + 1)\n      }\n      ,\n      TRaise => throw(\"'raise' is deprecated, use 'throw(expr)' instead\"),\n      TReturn => throw(\"'return' is not supported; use implicit returns\"),\n      TDo => throw(\"'do' is reserved; use 'while' or 'for' instead\"),\n      TLoop => match peek(tokens, pos + 1) {\n        TLParen => {\n          let params_b = ArrayBuilder::new()\n          let mut cur = pos + 2\n          let mut done = false\n          while !done {\n            match peek(tokens, cur) {\n              TRParen => {\n                cur = cur + 1\n                done = true\n              },\n              TIdent(name) => {\n                let eq = expect_tk(tokens, cur + 1, \"=\")\n                let (init, next) = parse_impl(tokens, eq, 0)\n                ArrayBuilder::push(params_b, (name, init))\n                match peek(tokens, next) {\n                  TComma => {\n                    cur = next + 1\n                  },\n                  TRParen => {\n                    cur = next + 1\n                    done = true\n                  },\n                  _ => throw(\"expected ',' or ')' in loop params\")\n                }\n              },\n              _ => throw(\"expected loop parameter name or ')'\")\n            }\n          }\n          let br = expect_tk(tokens, cur, \"{\")\n          let (body, end) = parse_impl(tokens, br, mode_block)\n          (ELoop(ArrayBuilder::freeze(params_b), body), end)\n        },\n        _ => {\n          let br = expect_tk(tokens, pos + 1, \"{\")\n          let (body, end) = parse_impl(tokens, br, mode_block)\n          (EWhile(EBool(true), body), end)\n        }\n      },\n      TYield => throw(\"'yield' is not supported\"),\n      TDeclare => throw(\"'declare' is not supported\"),\n      _ => throw(\"unexpected token: \\{tk_name(peek(tokens, pos))}\")\n    }\n  }\n  let parse_call_arg = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TIdent(name) => match peek(tokens, pos + 1) {\n        TTilde => match peek(tokens, pos + 2) {\n          TEq => {\n            let (val, end) = parse_impl(tokens, pos + 3, 0);\n            (ELabeledArg(name, \"~\", val), end)\n          },\n          _ => parse_impl(tokens, pos, 0)\n        },\n        TQuestion => match peek(tokens, pos + 2) {\n          TEq => {\n            let (val, end) = parse_impl(tokens, pos + 3, 0);\n            (ELabeledArg(name, \"?\", val), end)\n          },\n          _ => parse_impl(tokens, pos, 0)\n        },\n        TEq => {\n          let (val, end) = parse_impl(tokens, pos + 2, 0);\n          (ELabeledArg(name, \"~\", val), end)\n        },\n        _ => parse_impl(tokens, pos, 0)\n      },\n      _ => parse_impl(tokens, pos, 0)\n    }\n  }\n  let rec parse_call_args_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (e, next) = parse_call_arg(tokens, pos + 1)\n        ArrayBuilder::push(b, e)\n        parse_call_args_rest(tokens, next, b)\n      },\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  let parse_postfix = (tokens: Array[Token], pos: Int, expr: Expr) -> (Expr, Int)with { Error } {\n    let mut cur_expr = expr\n    let mut cur_pos = pos\n    let mut done = false\n    while !done {\n      match peek(tokens, cur_pos) {\n        TLParen => match cur_expr {\n          ECall(_, _) => {\n            done = true\n          },\n          _ => match peek(tokens, cur_pos + 1) {\n            TRParen => {\n              cur_expr = ECall(cur_expr, empty_exprs())\n              cur_pos = cur_pos + 2\n            },\n            _ => {\n              let b = ArrayBuilder::new()\n              let (f, n1) = parse_call_arg(tokens, cur_pos + 1)\n              ArrayBuilder::push(b, f)\n              let (args, end) = parse_call_args_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\")\n              cur_expr = ECall(cur_expr, args)\n              cur_pos = en\n            }\n          }\n        },\n        TDot => match peek(tokens, cur_pos + 1) {\n          TIdent(field) => {\n            cur_expr = EDot(cur_expr, field)\n            cur_pos = cur_pos + 2\n          },\n          _ => {\n            done = true\n          }\n        },\n        _ => {\n          done = true\n        }\n      }\n    }\n    (cur_expr, cur_pos)\n  }\n  let pipe_desugar = (lhs: Expr, rhs: Expr) -> Expr {\n    match rhs {\n      ECall(callee, args) => ECall(callee, Array::concat([\n        lhs\n      ], args)),\n      _ => ECall(rhs, [\n        lhs\n      ])\n    }\n  }\n  let binop_prec = (tok: Token) -> Int {\n    match tok {\n      TOr => 0,\n      TAnd => 1,\n      TPipeGt => 2,\n      TEqEq => 3,\n      TNeq => 3,\n      TLt => 3,\n      TLte => 3,\n      TGt => 3,\n      TGte => 3,\n      TBitOr => 4,\n      TBitXor => 5,\n      TBitAnd => 6,\n      TLShift => 7,\n      TRShift => 7,\n      TPlus => 8,\n      TMinus => 8,\n      TStar => 9,\n      TSlash => 9,\n      TPercent => 9,\n      _ => -1\n    }\n  }\n  let binop_op = (tok: Token) -> String with { Error } {\n    match tok {\n      TOr => \"||\",\n      TAnd => \"&&\",\n      TPipeGt => \"|>\",\n      TEqEq => \"==\",\n      TNeq => \"!=\",\n      TLt => \"<\",\n      TLte => \"<=\",\n      TGt => \">\",\n      TGte => \">=\",\n      TBitOr => \"|\",\n      TBitXor => \"^\",\n      TBitAnd => \"&\",\n      TLShift => \"<<\",\n      TRShift => \">>\",\n      TPlus => \"+\",\n      TMinus => \"-\",\n      TStar => \"*\",\n      TSlash => \"/\",\n      TPercent => \"%\",\n      _ => throw(\"internal parser error: not a binary operator\")\n    }\n  }\n  let rec parse_prefix = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TMinus => {\n        let (e, next) = parse_prefix(tokens, pos + 1);\n        (EUnaryOp(\"-\", e), next)\n      },\n      TNot => {\n        let (e, next) = parse_prefix(tokens, pos + 1);\n        (EUnaryOp(\"!\", e), next)\n      },\n      _ => {\n        let (e, next) = parse_primary(tokens, pos)\n        parse_postfix(tokens, next, e)\n      }\n    }\n  }\n  let rec parse_infix_loop = (tokens: Array[Token], left: Expr, next: Int, min_prec: Int, expr_start: Int, cmp_locked: Bool) -> (Expr, Int)with { Error } {\n    let tok = peek(tokens, next)\n    let prec = binop_prec(tok)\n    if prec < min_prec || (cmp_locked && prec == 3) {\n      (left, next)\n    } else {\n      let op = binop_op(tok)\n      if String::equals(op, \"|>\") {\n        if has_non_pipe_infix_top(tokens, expr_start, next) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n      let (right0, right_next0) = parse_prefix(tokens, next + 1)\n      let (right, rn) = parse_infix_loop(tokens, right0, right_next0, prec + 1, next + 1, false)\n      if String::equals(op, \"|>\") {\n        if has_non_pipe_infix_top(tokens, next + 1, rn) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n      let combined = if String::equals(op, \"|>\") {\n        pipe_desugar(left, right)\n      } else {\n        EBinOp(op, left, right)\n      }\n      let next_cmp_locked = if prec == 3 {\n        true\n      } else {\n        cmp_locked\n      }\n      parse_infix_loop(tokens, combined, rn, min_prec, expr_start, next_cmp_locked)\n    }\n  }\n  let rec parse_infix = (tokens: Array[Token], pos: Int, min_prec: Int, expr_start: Int) -> (Expr, Int)with { Error } {\n    let (left0, next0) = parse_prefix(tokens, pos)\n    let (expr, en) = parse_infix_loop(tokens, left0, next0, min_prec, expr_start, false)\n    match peek(tokens, en) {\n      TIdent(kw) => if String::equals(kw, \"is\") {\n        let (pat, pn) = parse_pattern(tokens, en + 1)\n        (EMatch(expr, [(pat, EBool(true)), (PWild, EBool(false))]), pn)\n      } else {\n        (expr, en)\n      },\n      _ => (expr, en)\n    }\n  }\n  let rec parse_match_rest = (tokens: Array[Token], pos: Int, scrutinee: Expr, b: ArrayBuilder[(Pat, Expr)]) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 2),\n        _ => {\n          let (pa, paa) = parse_pattern(tokens, pos + 1)\n          let a2 = expect_tk(tokens, paa, \"=>\")\n          let (ea, en) = parse_impl(tokens, a2, 0)\n          ArrayBuilder::push(b, (pa, ea))\n          parse_match_rest(tokens, en, scrutinee, b)\n        }\n      },\n      TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 1),\n      _ => throw(\"expected ',' or '}' in match\")\n    }\n  }\n  let rec parse_handle_rest = (tokens: Array[Token], pos: Int, body: Expr, b: ArrayBuilder[(Pat, Expr)]) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\n        _ => {\n          let (pa, paa) = parse_pattern(tokens, pos + 1)\n          let a2 = expect_tk(tokens, paa, \"=>\")\n          let (ea, en) = parse_impl(tokens, a2, 0)\n          ArrayBuilder::push(b, (pa, ea))\n          parse_handle_rest(tokens, en, body, b)\n        }\n      },\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\n      _ => throw(\"expected ',' or '}' in handle\")\n    }\n  }\n  let rec parse_block_after_expr = (tokens: Array[Token], pos: Int, e: Expr) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TRBrace => (e, pos + 1),\n      TSemicolon => {\n        let (rest, end) = parse_impl(tokens, pos + 1, mode_block);\n        (ESeq(e, rest), end)\n      },\n      TEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssign(name, val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TPlusEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"+\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TMinusEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"-\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TStarEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"*\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TSlashEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"/\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TPercentEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"%\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      _ => {\n        let (rest, end) = parse_impl(tokens, pos, mode_block)\n        if end <= pos {\n          throw(\"internal parser error: block continuation did not advance\")\n        } else (ESeq(e, rest), end)\n      }\n    }\n  }\n  if mode == mode_match {\n    let (scrutinee, sn) = parse_impl(tokens, pos, 0)\n    let br = expect_tk(tokens, sn, \"{\")\n    match peek(tokens, br) {\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (fp, fa) = parse_pattern(tokens, br)\n        let aa = expect_tk(tokens, fa, \"=>\")\n        let (fe, fn1) = parse_impl(tokens, aa, 0)\n        ArrayBuilder::push(b, (fp, fe))\n        parse_match_rest(tokens, fn1, scrutinee, b)\n      }\n    }\n  } else if mode == mode_if {\n    let (cond, cn) = parse_impl(tokens, pos, 0)\n    let mut is_mode = false\n    let mut is_pat_val = PWild\n    let mut brace_pos = cn\n    match peek(tokens, cn) {\n      TIdent(kw) => if String::equals(kw, \"is\") {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      _ => ()\n    }\n    let br = expect_tk(tokens, brace_pos, \"{\")\n    let (then_e, tn) = parse_impl(tokens, br, mode_block)\n    let (else_e, end_pos) = match peek(tokens, tn) {\n      TElse => match peek(tokens, tn + 1) {\n        TIf => parse_impl(tokens, tn + 2, mode_if),\n        TLBrace => parse_impl(tokens, tn + 2, mode_block),\n        _ => parse_impl(tokens, tn + 1, 0)\n      },\n      _ => (EUnit, tn)\n    }\n    if is_mode {\n      (EMatch(cond, [(is_pat_val, then_e), (PWild, else_e)]), end_pos)\n    } else {\n      (EIf(cond, then_e, else_e), end_pos)\n    }\n  } else if mode == mode_while {\n    let (cond, cn) = parse_impl(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (body, end) = parse_impl(tokens, br, mode_block);\n    (EWhile(cond, body), end)\n  } else if mode == mode_handle {\n    let br = expect_tk(tokens, pos, \"{\")\n    let (body, bn) = parse_impl(tokens, br, mode_block)\n    let hb = expect_tk(tokens, bn, \"{\")\n    match peek(tokens, hb) {\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (fp, fa) = parse_pattern(tokens, hb)\n        let aa = expect_tk(tokens, fa, \"=>\")\n        let (fe, fn1) = parse_impl(tokens, aa, 0)\n        ArrayBuilder::push(b, (fp, fe))\n        parse_handle_rest(tokens, fn1, body, b)\n      }\n    }\n  } else if mode == mode_for_in {\n    match peek(tokens, pos) {\n      TIdent(first_name) => {\n        let (value_name, index_name, name_end) = match peek(tokens, pos + 1) {\n          TComma => match peek(tokens, pos + 2) {\n            TIdent(second_name) => (second_name, Some(first_name), pos + 3),\n            _ => throw(\"expected value binding name after ','\")\n          },\n          _ => (first_name, None, pos + 1)\n        }\n        let ip = expect_tk(tokens, name_end, \"in\")\n        let (iterable, inext) = parse_impl(tokens, ip, 0)\n        let bb = expect_tk(tokens, inext, \"{\")\n        let (body, end) = parse_impl(tokens, bb, mode_block);\n        (EForIn(value_name, index_name, iterable, body), end)\n      },\n      _ => throw(\"expected identifier after 'for'\")\n    }\n  } else if mode == mode_block {\n    match peek(tokens, pos) {\n      TRBrace => (EUnit, pos + 1),\n      TLet => {\n        let next = pos + 1\n        match peek(tokens, next) {\n          TRec => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq = expect_tk(tokens, next + 2, \"=\")\n              let (val, vn) = parse_impl(tokens, eq, 0)\n              let a = skip_semi(tokens, vn)\n              let (body, end) = parse_impl(tokens, a, mode_block)\n              if end <= a {\n                throw(\"internal parser error: block let-rec parser did not advance\")\n              } else (ELetRec(name, val, body), end)\n            },\n            _ => throw(\"expected identifier after 'let rec'\")\n          },\n          TMut => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq = expect_tk(tokens, next + 2, \"=\")\n              let (val, vn) = parse_impl(tokens, eq, 0)\n              let a = skip_semi(tokens, vn)\n              let (body, end) = parse_impl(tokens, a, mode_block)\n              if end <= a {\n                throw(\"internal parser error: block let-mut parser did not advance\")\n              } else (ELetMut(name, val, body), end)\n            },\n            _ => throw(\"expected identifier after 'let mut'\")\n          },\n          TIdent(name) => {\n            let eq = expect_tk(tokens, next + 1, \"=\")\n            let (val, vn) = parse_impl(tokens, eq, 0)\n            let a = skip_semi(tokens, vn)\n            let (body, end) = parse_impl(tokens, a, mode_block)\n            if end <= a {\n              throw(\"internal parser error: block let parser did not advance\")\n            } else (ELet(name, val, body), end)\n          },\n          TLParen => {\n            let (pat, pn) = parse_pattern(tokens, next)\n            let eq = expect_tk(tokens, pn, \"=\")\n            let (val, vn) = parse_impl(tokens, eq, 0)\n            let a = skip_semi(tokens, vn)\n            let (body, end) = parse_impl(tokens, a, mode_block)\n            if end <= a {\n              throw(\"internal parser error: block let-pat parser did not advance\")\n            } else {\n              let arms = [\n                (pat, body)\n              ]\n              (EMatch(val, arms), end)\n            }\n          },\n          _ => throw(\"expected identifier after 'let'\")\n        }\n      },\n      _ => {\n        let (e, next) = parse_impl(tokens, pos, 0)\n        if next <= pos {\n          throw(\"internal parser error: block expr parser did not advance\")\n        } else parse_block_after_expr(tokens, next, e)\n      }\n    }\n  } else if mode >= 0 && mode <= 10 {\n    parse_infix(tokens, pos, mode, pos)\n  } else {\n    throw(\"internal parser error: unknown parse mode\")\n  }\n}\n\nexport let parse = (tokens: Array[Token]) -> Expr with { Error } {\n  let (e, next) = parse_impl(tokens, 0, 0)\n  match peek(tokens, next) {\n    TEof => e,\n    _ => throw(\"unexpected after expression: \\{tk_name(peek(tokens, next))}\")\n  }\n}\n\nexport let parse_ok = (tokens: Array[Token]) -> Bool {\n  handle {\n    let _ = parse(tokens)\n    true\n  } {\n    Error(_) => false\n  }\n}\n\nexport let parse_expr = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n  parse_impl(tokens, pos, 0)\n}\n\nlet parse_let_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TRec => {\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\n      let (ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0);\n          (Some(ty), tp)\n        },\n        _ => (None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (val, vn) = parse_impl(tokens, ep, 0);\n      (SLet(exported, true, name, ty_opt, val), vn)\n    },\n    TMut => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let (val, vn) = parse_impl(tokens, ep, 0);\n        (SLetMut(name, ty_opt, val), vn)\n      },\n      _ => throw(\"expected name after 'let mut'\")\n    },\n    TIdent(_) => {\n      let (name, name_next) = parse_binding_name(tokens, pos)\n      let (ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0);\n          (Some(ty), tp)\n        },\n        _ => (None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (val, vn) = parse_impl(tokens, ep, 0);\n      (SLet(exported, false, name, ty_opt, val), vn)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nlet parse_test_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, mode_block);\n      (STest(name, body), end)\n    },\n    _ => throw(\"expected test name string\")\n  }\n}\n\nlet parse_bench_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, mode_block);\n      (SBench(name, body), end)\n    },\n    _ => throw(\"expected bench name string\")\n  }\n}\n\nlet rec parse_export_names_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        parse_export_names_rest(tokens, pos + 2, b)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in export list\")\n  }\n}\n\nlet rec parse_import_items_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (item, next) = parse_import_item(tokens, pos + 1)\n        ArrayBuilder::push(b, item)\n        parse_import_items_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in import list\")\n  }\n}\n\nlet parse_import_items = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_import_items(), pos + 1),\n    _ => {\n      let (first, next) = parse_import_item(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_import_items_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_import_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let (path, bp) = collect_import_path(tokens, pos, \"\")\n  let br = expect_tk(tokens, bp, \"{\")\n  let (items, end) = parse_import_items(tokens, br);\n  (SImport(path, items), end)\n}\n\nlet parse_impl_stmt_dispatch = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  parse_impl_stmt(tokens, pos)\n}\n\nlet rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), pos + 1),\n    _ => {\n      let (first, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_struct_fields_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (fields, end) = parse_struct_fields(tokens, br);\n      (SStruct(exported, name, fields), end)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\nlet parse_export_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TLet => parse_let_stmt(tokens, pos + 1, true),\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\n    TStruct => parse_struct_stmt(tokens, pos + 1, true),\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\n    TOpen => match peek(tokens, pos + 1) {\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\n      _ => throw(\"expected 'trait' after 'open'\")\n    },\n    TLBrace => match peek(tokens, pos + 1) {\n      TRBrace => (SExport(empty_names()), pos + 2),\n      TIdent(name) => {\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, name)\n        let (names, end) = parse_export_names_rest(tokens, pos + 2, b);\n        (SExport(names), end)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    _ => throw(\"unexpected after 'export': \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nlet parse_percent_symbol_name = (tokens: Array[Token], pos: Int, label: String) -> (String, Int)with { Error } {\n  let pp = expect_tk(tokens, pos, \"%\")\n  match peek(tokens, pp) {\n    TIdent(name) => (\"%\\{name}\", pp + 1),\n    _ => throw(\"expected \\{label} after '%'\")\n  }\n}\n\nlet parse_extern_let_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let lp = expect_tk(tokens, pos, \"let\")\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \"extern symbol name\")\n  let cp = expect_tk(tokens, np, \":\")\n  let (ty, end) = parse_type_impl(tokens, cp, 0);\n  (SExternLet(name, ty), end)\n}\n\nexport let rec parse_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let rec parse_module_body = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Stmt]) -> (Array[Stmt], Int)with { Error } {\n    match peek(tokens, pos) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, pos)\n        ArrayBuilder::push(b, stmt)\n        parse_module_body(tokens, next, b)\n      }\n    }\n  }\n  let head = peek(tokens, pos)\n  match head {\n    TLet => parse_let_stmt(tokens, pos + 1, false),\n    TExport => match peek(tokens, pos + 1) {\n      TModule => match peek(tokens, pos + 2) {\n        TIdent(name) => {\n          let br = expect_tk(tokens, pos + 3, \"{\")\n          {\n            let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());\n            (SModule(true, name, stmts), end)\n          }\n        },\n        _ => throw(\"expected module name\")\n      },\n      _ => parse_export_stmt(tokens, pos + 1)\n    },\n    TModule => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let br = expect_tk(tokens, pos + 2, \"{\")\n        {\n          let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());\n          (SModule(false, name, stmts), end)\n        }\n      },\n      _ => throw(\"expected module name\")\n    },\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\n    TStruct => parse_struct_stmt(tokens, pos + 1, false),\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\n    TTest => parse_test_stmt(tokens, pos + 1),\n    TBench => parse_bench_stmt(tokens, pos + 1),\n    TImport => parse_import_stmt(tokens, pos + 1),\n    TIdent(name) => if String::equals(name, \"extern\") {\n      parse_extern_let_stmt(tokens, pos + 1)\n    } else if String::equals(name, \"use\") {\n      throw(\"'use' syntax is removed; use 'import <module-ref> { ... }'\")\n    } else {\n      let (e, next) = parse_impl(tokens, pos, 0);\n      (SExpr(e), next)\n    },\n    _ => {\n      let (e, next) = parse_impl(tokens, pos, 0);\n      (SExpr(e), next)\n    }\n  }\n}\n\nexport let parse_program = (tokens: Array[Token]) -> Array[Stmt] with { Error } {\n  let rec go = (pos: Int, b: ArrayBuilder[Stmt]) -> Array[Stmt] with { Error } {\n    if is_tk(peek(tokens, pos), \"eof\") {\n      ArrayBuilder::freeze(b)\n    } else {\n      let (stmt, next) = if is_tk(peek(tokens, pos), \"impl\") {\n        parse_impl_stmt_dispatch(tokens, pos + 1)\n      } else {\n        parse_stmt(tokens, pos)\n      }\n      ArrayBuilder::push(b, stmt)\n      go(next, b)\n    }\n  }\n  go(0, ArrayBuilder::new())\n}\n\n//# Misc\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_impl, parse_stmt, parse_type, parse_program\n}\n")

  let source_13 = ("vibe/compiler/syntax/expand_interp.vibe",
"//# Imports\n\nimport ../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./token.vibe {\n  Token\n}\n\nimport ./lexer.vibe {\n  lex\n}\n\nimport ./parser.vibe {\n  parse\n}\n\n//# Functions\n\n// Desugar EStringInterp(parts) into String::concat + __to_string calls.\nlet desugar_parts = (parts: Array[String]) -> Expr with { Error } {\n  let plen = Array::length(parts)\n  let exprs = ArrayBuilder::new()\n  let mut i = 0\n  while i < plen {\n    let lit = Array::get(parts, i)\n    if String::length(lit) > 0 {\n      ArrayBuilder::push(exprs, EString(lit))\n    }\n    if i + 1 < plen {\n      let expr_src = Array::get(parts, i + 1)\n      let expr_tokens = lex(expr_src)\n      let parsed = parse(expr_tokens)\n      // Recursively resolve any nested interpolation\n      let resolved = resolve_expr(parsed)\n      ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\"), [resolved]))\n    }\n    i = i + 2\n  }\n  let result_arr = ArrayBuilder::freeze(exprs)\n  let result_len = Array::length(result_arr)\n  if result_len == 0 {\n    EString(\"\")\n  } else {\n    let mut result = Array::get(result_arr, 0)\n    let mut j = 1\n    while j < result_len {\n      result = ECall(EIdent(\"String::concat\"), [result, Array::get(result_arr, j)])\n      j = j + 1\n    }\n    result\n  }\n}\n\nlet resolve_arr = (exprs: Array[Expr]) -> Array[Expr] with { Error } {\n  for e in exprs {\n    resolve_expr(e)\n  }\n}\n\nlet rec resolve_expr = (e: Expr) -> Expr with { Error } {\n  match e {\n    EStringInterp(parts) => desugar_parts(parts),\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EUnit => e,\n    EIdent(_) => e,\n    ETuple(elems) => ETuple(resolve_arr(elems)),\n    EArray(elems) => EArray(resolve_arr(elems)),\n    ERecord(fields) => ERecord(for f in fields { let (n, v) = f; (n, resolve_expr(v)) }),\n    EMap(fields) => EMap(for f in fields { let (n, v) = f; (n, resolve_expr(v)) }),\n    EIf(c, t, el) => EIf(resolve_expr(c), resolve_expr(t), resolve_expr(el)),\n    ELet(n, v, b) => ELet(n, resolve_expr(v), resolve_expr(b)),\n    ELetRec(n, v, b) => ELetRec(n, resolve_expr(v), resolve_expr(b)),\n    ELetMut(n, v, b) => ELetMut(n, resolve_expr(v), resolve_expr(b)),\n    EAssign(n, v, b) => EAssign(n, resolve_expr(v), resolve_expr(b)),\n    EAssignOp(n, op, v, b) => EAssignOp(n, op, resolve_expr(v), resolve_expr(b)),\n    ESeq(a, b) => ESeq(resolve_expr(a), resolve_expr(b)),\n    EMatch(s, arms) => EMatch(resolve_expr(s), for a in arms { let (p, ex) = a; (p, resolve_expr(ex)) }),\n    EHandle(body, arms) => EHandle(resolve_expr(body), for a in arms { let (p, ex) = a; (p, resolve_expr(ex)) }),\n    EWhile(c, b) => EWhile(resolve_expr(c), resolve_expr(b)),\n    ELoop(params, body) => ELoop(for param in params { let (name, init) = param; (name, resolve_expr(init)) }, resolve_expr(body)),\n    EForIn(vn, idx, it, b) => EForIn(vn, idx, resolve_expr(it), resolve_expr(b)),\n    ECall(callee, args) => ECall(resolve_expr(callee), resolve_arr(args)),\n    EBinOp(op, l, r) => EBinOp(op, resolve_expr(l), resolve_expr(r)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_expr(inner)),\n    EFn(a, b, params, ret, eff, body) => EFn(a, b, params, ret, eff, resolve_expr(body)),\n    EDot(inner, field) => EDot(resolve_expr(inner), field),\n    EThrow(inner) => EThrow(resolve_expr(inner)),\n    EBreak(opt) => match opt { None => e, Some(v) => EBreak(Some(resolve_expr(v))) },\n    EContinue(args) => EContinue(resolve_arr(args)),\n    ELabeledArg(n, m, v) => ELabeledArg(n, m, resolve_expr(v)),\n    ESpread(inner) => ESpread(resolve_expr(inner))\n  }\n}\n\nlet resolve_stmt = (s: Stmt) -> Stmt with { Error } {\n  match s {\n    SLet(exp, is_rec, name, ty, val) => SLet(exp, is_rec, name, ty, resolve_expr(val)),\n    SLetMut(name, ty, val) => SLetMut(name, ty, resolve_expr(val)),\n    STest(name, body) => STest(name, resolve_expr(body)),\n    SBench(name, body) => SBench(name, resolve_expr(body)),\n    SExpr(e) => SExpr(resolve_expr(e)),\n    _ => s\n  }\n}\n\n// Resolve all EStringInterp nodes in a program's statements.\n// Call this after parse_program to desugar interpolations.\nexport let resolve_interp_stmts = (stmts: Array[Stmt]) -> Array[Stmt] with { Error } {\n  for s in stmts {\n    resolve_stmt(s)\n  }\n}\n\n// Resolve all EStringInterp nodes in a single expression.\nexport let resolve_interp_expr = (e: Expr) -> Expr with { Error } {\n  resolve_expr(e)\n}\n")

  let source_14 = ("vibe/compiler/syntax/printer.vibe",
"//# Imports\n\nimport ../core {\n  Expr, Pat, Stmt, TypeExpr, __to_string\n}\n\nimport ./float_format.vibe {\n  double_to_string_compiler\n}\n\n//# Functions\n\nlet join = (arr: Array[String], sep: String) -> String {\n  let len = Array::length(arr)\n  if len == 0 {\n    \"\"\n  } else {\n    let b = ArrayBuilder::new()\n    let mut i = 0\n    while i < len {\n      if i > 0 {\n        ArrayBuilder::push(b, sep)\n      }\n      ArrayBuilder::push(b, Array::get(arr, i))\n      i = i + 1\n    }\n    String::join(ArrayBuilder::freeze(b), \"\")\n  }\n}\n\nlet escape_string = (s: String) -> String {\n  let len = String::length(s)\n  let b = ArrayBuilder::new()\n  let push_chunk = (start: Int, end: Int) -> Unit {\n    if end > start {\n      ArrayBuilder::push(b, String::substring(s, start, end))\n    }\n  }\n  let mut i = 0\n  let mut start = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    if c == '\"' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\"\")\n      i = i + 1\n      start = i\n    } else if c == '\\\\' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\\\")\n      i = i + 1\n      start = i\n    } else if c == '\\n' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\n\")\n      i = i + 1\n      start = i\n    } else if c == '\\t' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\t\")\n      i = i + 1\n      start = i\n    } else if c == 13 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\r\")\n      i = i + 1\n      start = i\n    } else if c == 0 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\0\")\n      i = i + 1\n      start = i\n    } else {\n      i = i + 1\n    }\n  }\n  push_chunk(start, len)\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n\nexport let rec print_pat = (p: Pat) -> String {\n  match p {\n    PWild => \"_\",\n    PBind(name) => name,\n    PInt(n) => __to_string(n),\n    PString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    PBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    PCtor(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        print_pat(arg)\n      }\n      String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n    },\n    PTuple(elems) => {\n      let parts = for elem in elems {\n        print_pat(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    },\n    POr(left, right) => String::concat(print_pat(left), String::concat(\" | \", print_pat(right)))\n  }\n}\n\nlet map_to_strings = (exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {\n  for expr in exprs {\n    f(expr)\n  }\n}\n\nexport let rec print_type_expr = (ty: TypeExpr) -> String {\n  match ty {\n    TyName(name) => name,\n    TyUnit => \"()\",\n    TyApp(name, args) => {\n      let parts = for arg in args {\n        print_type_expr(arg)\n      }\n      String::concat(name, String::concat(\"[\", String::concat(join(parts, \", \"), \"]\")))\n    },\n    TyFn(params, ret) => {\n      let parts = for param in params {\n        print_type_expr(param)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), String::concat(\") -> \", print_type_expr(ret))))\n    },\n    TyTuple(elems) => {\n      let parts = for elem in elems {\n        print_type_expr(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    }\n  }\n}\n\nlet print_ctor = (ctor: (String, Array[TypeExpr])) -> String {\n  let (name, args) = ctor\n  if eq(Array::length(args), 0) {\n    name\n  }\n  else {\n    let parts = for arg in args {\n      print_type_expr(arg)\n    }\n    String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n  }\n}\n\nexport let rec print_expr = (e: Expr) -> String {\n  match e {\n    EInt(n) => __to_string(n),\n    EFloat(n) => double_to_string_compiler(n),\n    EString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    EBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    EIdent(name) => name,\n    EUnit => \"()\",\n    ETuple(elems) => String::concat(\"(\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \")\")),\n    EArray(elems) => String::concat(\"[\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \"]\")),\n    ERecord(fields) => {\n      let parts = for field in fields {\n        let (name, val) = field\n        String::concat(name, String::concat(\": \", print_expr(val)))\n      }\n      String::concat(\"{ \", String::concat(join(parts, \", \"), \" }\"))\n    },\n    EIf(cond, then_e, else_e) => match else_e {\n      EUnit => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), \" }\")))),\n      _ => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), String::concat(\" } else { \", String::concat(print_expr(else_e), \" }\"))))))\n    },\n    ELet(name, val, body) => String::concat(\"{ let \", String::concat(name, String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetRec(name, val, body) => String::concat(\"{ let rec \", String::concat(name, String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetMut(name, val, body) => String::concat(\"{ let mut \", String::concat(name, String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssign(name, val, body) => String::concat(\"{ \", String::concat(name, String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssignOp(name, op, val, body) => String::concat(\"{ \", String::concat(name, String::concat(\" \", String::concat(op, String::concat(\"= \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))))),\n    ESeq(a, b) => String::concat(\"{ \", String::concat(print_expr(a), String::concat(\"; \", String::concat(print_expr(b), \" }\")))),\n    EMatch(scrutinee, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_pat(pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"match \", String::concat(print_expr(scrutinee), String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    EHandle(body, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_pat(pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"handle { \", String::concat(print_expr(body), String::concat(\" } { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    EWhile(cond, body) => String::concat(\"while \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(body), \" }\")))),\n    ELoop(params, body) => {\n      let parts = for param in params {\n        let (name, init) = param\n        String::concat(name, String::concat(\" = \", print_expr(init)))\n      }\n      String::concat(\"loop (\", String::concat(join(parts, \", \"), String::concat(\") { \", String::concat(print_expr(body), \" }\"))))\n    },\n    EForIn(value_name, index_name, iterable, body) => {\n      let binding = match index_name {\n        Some(index_name) => String::concat(index_name, String::concat(\", \", value_name)),\n        None => value_name\n      }\n      String::concat(\"for \", String::concat(binding, String::concat(\" in \", String::concat(print_expr(iterable), String::concat(\" { \", String::concat(print_expr(body), \" }\"))))))\n    },\n    ECall(callee, args) => String::concat(print_expr(callee), String::concat(\"(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\"))),\n    EBinOp(op, left, right) => String::concat(\"(\", String::concat(print_expr(left), String::concat(\" \", String::concat(op, String::concat(\" \", String::concat(print_expr(right), \")\")))))),\n    EUnaryOp(op, expr) => String::concat(\"(\", String::concat(op, String::concat(print_expr(expr), \")\"))),\n    EFn(_, _, params, ret_ty, effect, body) => {\n      let parts = for param in params {\n        let (name, ty_opt) = param\n        match ty_opt {\n          Some(ty) => String::concat(name, String::concat(\": \", print_type_expr(ty))),\n          None => name\n        }\n      }\n      let ret_str = match ret_ty {\n        Some(rt) => {\n          let eff_str = match effect {\n            Some(e) => String::concat(\" with {\", String::concat(e, \"}\")),\n            None => \"\"\n          }\n          String::concat(\") -> \", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(\" { \", String::concat(print_expr(body), \" }\")))))\n        },\n        None => String::concat(\") -> \", print_expr(body))\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), ret_str))\n    },\n    EDot(expr, field) => String::concat(print_expr(expr), String::concat(\".\", field)),\n    EThrow(e) => String::concat(\"throw(\", String::concat(print_expr(e), \")\")),\n    EBreak(opt) => match opt {\n      None => \"break\",\n      Some(v) => String::concat(\"break \", print_expr(v))\n    },\n    EContinue(args) => if eq(Array::length(args), 0) {\n      \"continue\"\n    } else String::concat(\"continue(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")),\n    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat(\"=\", print_expr(val))),\n    EMap(fields) => if eq(Array::length(fields), 0) {\n      \"map {}\"\n    } else {\n      let parts = for field in fields {\n        let (k, v) = field\n        String::concat(k, String::concat(\": \", print_expr(v)))\n      }\n      String::concat(\"map { \", String::concat(join(parts, \", \"), \" }\"))\n    }\n    ,\n    ESpread(inner) => String::concat(\"...\", print_expr(inner)),\n    EStringInterp(parts) => String::concat(\"\\\"\", String::concat(join(parts, \"\"), \"\\\"\"))\n  }\n}\n\nlet print_ctor_list = (ctors: Array[(String, Array[TypeExpr])]) -> String {\n  let parts = for ctor in ctors {\n    print_ctor(ctor)\n  }\n  join(parts, \"; \")\n}\n\nexport let rec print_stmt = (s: Stmt) -> String {\n  let prefix = (exported: Bool) -> String {\n    if exported {\n      \"export \"\n    } else \"\"\n  }\n  match s {\n    SLet(exported, is_rec, name, ty_opt, val) => {\n      let p = prefix(exported)\n      let r = if is_rec {\n        \"let rec \"\n      } else \"let \"\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(p, String::concat(r, String::concat(name, String::concat(t, String::concat(\" = \", print_expr(val))))))\n    },\n    SLetMut(name, ty_opt, val) => {\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(\"let mut \", String::concat(name, String::concat(t, String::concat(\" = \", print_expr(val)))))\n    },\n    SEnum(exported, name, ctors) => String::concat(prefix(exported), String::concat(\"enum \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\"))))),\n    SSuberror(exported, name, ctors) => {\n      let p = prefix(exported)\n      if eq(Array::length(ctors), 1) {\n        let (ctor_name, ctor_args) = Array::get(ctors, 0)\n        if String::equals(ctor_name, name) {\n          let parts = for arg in ctor_args {\n            print_type_expr(arg)\n          }\n          String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))))\n        }\n        else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n      } else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n    },\n    SStruct(exported, name, fields) => {\n      let parts = for field in fields {\n        let (fn1, ty) = field\n        String::concat(fn1, String::concat(\": \", print_type_expr(ty)))\n      }\n      String::concat(prefix(exported), String::concat(\"struct \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"; \"), \" }\")))))\n    },\n    STypeAlias(exported, name, ty) => String::concat(prefix(exported), String::concat(\"type \", String::concat(name, String::concat(\" = \", print_type_expr(ty))))),\n    STrait(exported, name, supers) => {\n      let base = String::concat(prefix(exported), String::concat(\"trait \", name))\n      if eq(Array::length(supers), 0) {\n        base\n      }\n      else String::concat(base, String::concat(\": \", join(supers, \" + \")))\n    },\n    SImpl(tparams, _, trait_name, type_name) => {\n      let base = String::concat(\"impl \", String::concat(trait_name, String::concat(\" for \", type_name)))\n      if eq(Array::length(tparams), 0) {\n        base\n      }\n      else String::concat(\"[\", String::concat(join(tparams, \", \"), String::concat(\"] \", base)))\n    },\n    SExternLet(name, ty) => String::concat(\"extern let \", String::concat(name, String::concat(\": \", print_type_expr(ty)))),\n    SImport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"import \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    STest(name, body) => String::concat(\"test \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SBench(name, body) => String::concat(\"bench \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SExpr(e) => print_expr(e),\n    SExport(names) => String::concat(\"export { \", String::concat(join(names, \", \"), \" }\")),\n    SReExport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"export \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    SModule(exported, name, stmts) => {\n      let parts = for s in stmts {\n        print_stmt(s)\n      }\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      String::concat(p, String::concat(\"module \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"\\n\"), \" }\")))))\n    }\n  }\n}\n\nexport let print_program = (stmts: Array[Stmt]) -> String {\n  let parts = for s in stmts {\n    print_stmt(s)\n  }\n  join(parts, \"\\n\")\n}\n")

  let source_15 = ("vibe/compiler/syntax/index.vibe",
"export ./token.vibe {\n  Token, token_to_string\n}\n\nexport ./lexer.vibe {\n  lex, lex_ok\n}\n\nexport ./parser.vibe {\n  parse, parse_expr, parse_ok, parse_program, parse_stmt, parse_type\n}\n\nexport ./expand_interp.vibe {\n  resolve_interp_stmts, resolve_interp_expr\n}\n\nexport ./printer.vibe {\n  print_expr, print_pat, print_program, print_stmt, print_type_expr\n}\n\nexport ./float_format.vibe {\n  double_to_string_compiler\n}\n")

  let source_16 = ("vibe/compiler/token.vibe",
"//# Imports\n\nexport ./syntax {\n  Token, token_to_string\n}\n\n//# Misc\n\nexport {\n  Token, token_to_string\n}\n")

  let source_17 = ("vibe/compiler/float_format.vibe",
"//# Imports\n\nexport ./syntax {\n  double_to_string_compiler\n}\n\n//# Misc\n\nexport {\n  double_to_string_compiler\n}\n")

  let source_18 = ("vibe/compiler/types.vibe",
"//# Imports\n\nexport ./core {\n  Subst, Type, TypeDef, TypeEnv, collect_tvars, env_bind, env_bind_all, env_flat_bindings, env_lookup, env_lookup_flat, find_typedef, fresh_var, generalize, impls_overlap_for, instantiate, occurs_in, resolve_builtin, subst_add_bound, subst_apply, subst_lookup, trait_defined, trait_is_subtrait, trait_supers, type_implements_trait, type_to_string, types_compatible, types_equal, unify\n}\n\n//# Misc\n\nexport {\n  Type, Subst, unify, TypeDef, TypeEnv, env_bind, fresh_var, occurs_in, env_lookup, generalize, instantiate, subst_apply, types_equal, env_bind_all, find_typedef, subst_lookup, trait_supers, collect_tvars, trait_defined, type_to_string, env_lookup_flat, resolve_builtin, subst_add_bound, types_compatible, env_flat_bindings, impls_overlap_for, trait_is_subtrait, type_implements_trait\n}\n")

  let source_19 = ("vibe/compiler/bytebuf.vibe",
"//# Imports\n\nexport ./core {\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_push_bytes, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32\n}\n\n//# Misc\n\nexport {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_array, bytebuf_push_bytes, bytebuf_push_section, bytebuf_push_vec_header\n}\n")

