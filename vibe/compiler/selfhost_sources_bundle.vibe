"//# Types\n\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Bool);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)]);\n  TDAlias(String, Type)\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst)\n}\n\n//# Functions\n\nexport let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {\n  EnvBind(name, ty, env)\n}\n\nexport let fresh_var = (c: Int) -> (Type, Int) {\n  (CtVar(c), c + 1)\n}\n\nexport let rec occurs_in = (id: Int, ty: Type) -> Bool {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < array_length(params) {\n        if occurs_in(id, array_get(params, i)) {\n          found = true\n          i = array_length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < array_length(elems) {\n        if occurs_in(id, array_get(elems, i)) {\n          found = true\n          i = array_length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport let rec env_lookup = (env: TypeEnv, name: String) -> Option[Type] {\n  match env {\n    EnvEmpty => None,\n    EnvBind(n, ty, rest) => if string_equals(n, name) {\n      Some(ty)\n    } else env_lookup(rest, name),\n    EnvTraitDef(_, _, _, rest) => env_lookup(rest, name),\n    EnvTraitImpl(_, _, rest) => env_lookup(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => env_lookup(rest, name)\n  }\n}\n\nlet empty_env_bindings = () -> Array[(String, Type)] {\n  array_slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let env_flat_bindings = (env: TypeEnv) -> Array[(String, Type)] {\n  let out = empty_env_bindings()\n  let mut cur = env\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(name, ty, rest) => {\n        array_push(out, (name, ty))\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let env_lookup_flat = (bindings: Array[(String, Type)], name: String) -> Option[Type] {\n  let len = array_length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = array_get(bindings, i)\n      if string_equals(n, name) {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet join_types = (arr: Array[String], sep: String) -> String {\n  let len = array_length(arr)\n  let mut i = 0\n  let mut acc = \"\"\n  while (!(i >= len)) {\n    let s = if i > 0 {\n      string_concat(string_concat(acc, sep), array_get(arr, i))\n    } else array_get(arr, i)\n    acc = s\n    i = i + 1\n  }\n  acc\n}\n\nlet string_array_equal = (left: Array[String], right: Array[String]) -> Bool {\n  let len = array_length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else if (!(string_equals(array_get(left, i), array_get(right, i)))) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport let rec types_equal = (a: Type, b: Type) -> Bool {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => string_equals(aname, bname),\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => string_equals(aname, bname),\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtNamed(bname, bargs) =>\n      if (!(string_equals(aname, bname))) {\n        false\n      } else if (array_length(aargs) != array_length(bargs)) {\n        false\n      } else {\n        let tae_len = array_length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while (!(tae_done)) {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else if (!(types_equal(array_get(aargs, tae_i), array_get(bargs, tae_i)))) {\n            tae_result = false\n            tae_done = true\n          } else {\n            tae_i = tae_i + 1\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if (array_length(aelems) != array_length(belems)) {\n        false\n      } else {\n        let tae_len2 = array_length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while (!(tae_done2)) {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else if (!(types_equal(array_get(aelems, tae_i2), array_get(belems, tae_i2)))) {\n            tae_result2 = false\n            tae_done2 = true\n          } else {\n            tae_i2 = tae_i2 + 1\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, ahas_error) => match b {\n      CtFn(bparams, bret, bhas_error) =>\n      if (array_length(aparams) != array_length(bparams)) {\n        false\n      } else if ahas_error {\n        if (!(bhas_error)) {\n          false\n        } else {\n          let tae_len3 = array_length(aparams)\n          let mut tae_i3 = 0\n          let mut tae_result3 = true\n          let mut tae_done3 = false\n          while (!(tae_done3)) {\n            if tae_i3 >= tae_len3 {\n              tae_done3 = true\n            } else if (!(types_equal(array_get(aparams, tae_i3), array_get(bparams, tae_i3)))) {\n              tae_result3 = false\n              tae_done3 = true\n            } else {\n              tae_i3 = tae_i3 + 1\n            }\n          }\n          if (!(tae_result3)) {\n            false\n          } else {\n            types_equal(aret, bret)\n          }\n        }\n      } else if bhas_error {\n        false\n      } else {\n        let tae_len4 = array_length(aparams)\n        let mut tae_i4 = 0\n        let mut tae_result4 = true\n        let mut tae_done4 = false\n        while (!(tae_done4)) {\n          if tae_i4 >= tae_len4 {\n            tae_done4 = true\n          } else if (!(types_equal(array_get(aparams, tae_i4), array_get(bparams, tae_i4)))) {\n            tae_result4 = false\n            tae_done4 = true\n          } else {\n            tae_i4 = tae_i4 + 1\n          }\n        }\n        if (!(tae_result4)) {\n          false\n        } else {\n          types_equal(aret, bret)\n        }\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => {\n        if (array_length(avars) != array_length(bvars)) {\n          false\n        } else if (array_length(abounds) != array_length(bbounds)) {\n          false\n        } else {\n          // inline var_list_equal\n          let vlen = array_length(avars)\n          let mut vi = 0\n          let mut vresult = true\n          let mut vdone = false\n          while (!(vdone)) {\n            if vi >= vlen {\n              vdone = true\n            } else if (array_get(avars, vi) != array_get(bvars, vi)) {\n              vresult = false\n              vdone = true\n            } else {\n              vi = vi + 1\n            }\n          }\n          if (!(vresult)) {\n            false\n          } else {\n            // inline forall_bounds_equal\n            let fbe_len = array_length(abounds)\n            let mut fbe_i = 0\n            let mut fbe_result = true\n            let mut fbe_done = false\n            while (!(fbe_done)) {\n              if fbe_i >= fbe_len {\n                fbe_done = true\n              } else {\n                let (lvar, lbounds) = array_get(abounds, fbe_i)\n                let (rvar, rbounds) = array_get(bbounds, fbe_i)\n                if (lvar != rvar) {\n                  fbe_result = false\n                  fbe_done = true\n                } else if (array_length(lbounds) != array_length(rbounds)) {\n                  fbe_result = false\n                  fbe_done = true\n                } else if (!(string_array_equal(lbounds, rbounds))) {\n                  fbe_result = false\n                  fbe_done = true\n                } else {\n                  fbe_i = fbe_i + 1\n                }\n              }\n            }\n            if (!(fbe_result)) {\n              false\n            } else {\n              types_equal(abody, bbody)\n            }\n          }\n        }\n      },\n      _ => false\n    }\n  }\n}\n\nexport let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {\n  let len = array_length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while (!(i >= len)) {\n    let (name, ty) = array_get(bindings, i)\n    acc = EnvBind(name, ty, acc)\n    i = i + 1\n  }\n  acc\n}\n\nexport let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {\n  let len = array_length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else {\n      let d = array_get(defs, i)\n      let dname = match d {\n        TDEnum(n, _) => n,\n        TDStruct(n, _) => n,\n        TDAlias(n, _) => n\n      }\n      if string_equals(dname, name) {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet subst_bounds = (s: Subst, id: Int) -> Array[String] {\n  let empty = array_slice([\n    \"\"\n  ], 0, 0)\n  let mut cur = s\n  let mut out = empty\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(bid, bounds, rest) => {\n        if (bid == id) {\n          out = bounds\n          done = true\n        } else {\n          cur = rest\n        }\n      }\n    }\n  }\n  out\n}\n\nlet rec int_bounds_has_id = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {\n  if i >= array_length(pairs) {\n    false\n  } else {\n    let (pid, _) = array_get(pairs, i)\n    if (pid == id) {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_bounds_lookup = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {\n  if i >= array_length(pairs) {\n    array_slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    let (pid, bounds) = array_get(pairs, i)\n    if (pid == id) {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nlet collect_subst_bounds_pairs = (s: Subst) -> Array[(Int, Array[String])] {\n  let out = array_slice([\n    (0, array_slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut cur = s\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if (!(int_bounds_has_id(out, id, 0))) {\n          array_push(out, (id, bounds))\n        }\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nlet rec int_int_lookup_or = (pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {\n  if i >= array_length(pairs) {\n    fallback\n  } else {\n    let (k, v) = array_get(pairs, i)\n    if (k == key) {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\nexport let subst_lookup = (s: Subst, id: Int) -> Option[Type] {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => {\n        if (i == id) {\n          out = Some(ty)\n          done = true\n        } else {\n          cur = rest\n        }\n      },\n      SubstBound(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nlet int_array_has = (arr: Array[Int], v: Int) -> Bool {\n  let slen = array_length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while (!(sdone)) {\n    if si >= slen {\n      sdone = true\n    } else if (array_get(arr, si) == v) {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nexport let rec subst_apply = (s: Subst, ty: Type) -> Type {\n  match ty {\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = array_slice([\n        0\n      ], 0, 0)\n      while (!(done)) {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            array_push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          }\n          ,\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, he) => {\n      let rp = for p in params {\n        subst_apply(s, p)\n      }\n      CtFn(rp, subst_apply(s, ret), he)\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtArray(ea) => match tb {\n              CtArray(eb) => unify(ea, eb, s),\n              _ => None\n            },\n            CtOption(ea) => match tb {\n              CtOption(eb) => unify(ea, eb, s),\n              _ => None\n            },\n            CtFn(pa, ra, _) => match tb {\n              CtFn(pb, rb, _) => if (array_length(pa) != array_length(pb)) {\n                None\n              }\n              else {\n                let ul_len = array_length(pa)\n                let mut ul_i = 0\n                let mut ul_acc = s\n                let mut ul_result = Some(s)\n                let mut ul_done = false\n                while (!(ul_done)) {\n                  if ul_i >= ul_len {\n                    ul_result = Some(ul_acc)\n                    ul_done = true\n                  } else {\n                    match unify(array_get(pa, ul_i), array_get(pb, ul_i), ul_acc) {\n                      Some(s2) => {\n                        ul_acc = s2\n                        ul_i = ul_i + 1\n                      },\n                      None => {\n                        ul_result = None\n                        ul_done = true\n                      }\n                    }\n                  }\n                }\n                match ul_result {\n                  Some(s2) => unify(ra, rb, s2),\n                  None => None\n                }\n              }\n              ,\n              _ => None\n            },\n            CtTuple(ea) => match tb {\n              CtTuple(eb) => if (array_length(ea) != array_length(eb)) {\n                None\n              }\n              else {\n                let ul_len2 = array_length(ea)\n                let mut ul_i2 = 0\n                let mut ul_acc2 = s\n                let mut ul_result2 = Some(s)\n                let mut ul_done2 = false\n                while (!(ul_done2)) {\n                  if ul_i2 >= ul_len2 {\n                    ul_result2 = Some(ul_acc2)\n                    ul_done2 = true\n                  } else {\n                    match unify(array_get(ea, ul_i2), array_get(eb, ul_i2), ul_acc2) {\n                      Some(s2) => {\n                        ul_acc2 = s2\n                        ul_i2 = ul_i2 + 1\n                      },\n                      None => {\n                        ul_result2 = None\n                        ul_done2 = true\n                      }\n                    }\n                  }\n                }\n                ul_result2\n              }\n              ,\n              _ => None\n            },\n            CtEnum(a_name) => match tb {\n              CtEnum(b_name) => if string_equals(a_name, b_name) {\n                Some(s)\n              } else None,\n              _ => None\n            },\n            CtStruct(a_name) => match tb {\n              CtStruct(b_name) => if string_equals(a_name, b_name) {\n                Some(s)\n              } else None,\n              _ => None\n            },\n            CtNamed(a_name, a_args) => match tb {\n              CtNamed(b_name, b_args) => if (!(string_equals(a_name, b_name))) {\n                None\n              }\n              else if (array_length(a_args) != array_length(b_args)) {\n                None\n              }\n              else {\n                let ul_len3 = array_length(a_args)\n                let mut ul_i3 = 0\n                let mut ul_acc3 = s\n                let mut ul_result3 = Some(s)\n                let mut ul_done3 = false\n                while (!(ul_done3)) {\n                  if ul_i3 >= ul_len3 {\n                    ul_result3 = Some(ul_acc3)\n                    ul_done3 = true\n                  } else {\n                    match unify(array_get(a_args, ul_i3), array_get(b_args, ul_i3), ul_acc3) {\n                      Some(s2) => {\n                        ul_acc3 = s2\n                        ul_i3 = ul_i3 + 1\n                      },\n                      None => {\n                        ul_result3 = None\n                        ul_done3 = true\n                      }\n                    }\n                  }\n                }\n                ul_result3\n              }\n              ,\n              _ => None\n            },\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => None\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let rec trait_supers = (env: TypeEnv, name: String) -> Array[String] {\n  let empty = array_slice([\n    \"\"\n  ], 0, 0)\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, rest) => if string_equals(tname, name) {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name)\n  }\n}\n\nlet rec array_has_int = (arr: Array[Int], val: Int, i: Int) -> Bool {\n  if i >= array_length(arr) {\n    false\n  }\n  else if (array_get(arr, i) == val) {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nlet rec collect_tvars_walk = (t: Type, out: Array[Int]) -> Int {\n  match t {\n    CtVar(id) => {\n      if (!(array_has_int(out, id, 0))) {\n        array_push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport let collect_tvars = (ty: Type) -> Array[Int] {\n  let out = array_slice([\n    0\n  ], 0, 0)\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nexport let generalize = (s: Subst, ty: Type) -> Type {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if (array_length(tvars) == 0) {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = array_slice([\n      (0, array_slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0)\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if (array_length(bounds) != 0) {\n        array_push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nexport let rec trait_defined = (env: TypeEnv, name: String) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, rest) => if string_equals(tname, name) {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name)\n  }\n}\n\nexport let rec type_to_string = (ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => string_concat(\"?t\", __to_string(id)),\n    CtForAll(vars, _, body) => {\n      let vlen = array_length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while (!(vi >= vlen)) {\n        let v = string_concat(\"?t\", __to_string(array_get(vars, vi)))\n        let next = if vi > 0 {\n          string_concat(string_concat(vacc, \" \"), v)\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      string_concat(\"forall \", string_concat(vacc, string_concat(\". \", type_to_string(body))))\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => string_concat(\"Array[\", string_concat(type_to_string(elem), \"]\")),\n    CtOption(elem) => string_concat(\"Option[\", string_concat(type_to_string(elem), \"]\")),\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if (array_length(args) == 0) {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      string_concat(name, string_concat(\"[\", string_concat(join_types(parts, \", \"), \"]\")))\n    }\n    ,\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      string_concat(\"(\", string_concat(join_types(parts, \", \"), \")\"))\n    },\n    CtFn(params, ret, has_error) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let base = string_concat(\"(\", string_concat(join_types(parts, \", \"), string_concat(\") -> \", type_to_string(ret))))\n      if has_error {\n        string_concat(base, \" with {Error}\")\n      } else base\n    }\n  }\n}\n\nexport let resolve_builtin = (name: String) -> Option[Type] {\n  if string_equals(name, \"Int\") {\n    Some(CtInt)\n  }\n  else if string_equals(name, \"Double\") {\n    Some(CtDouble)\n  }\n  else if string_equals(name, \"Bool\") {\n    Some(CtBool)\n  }\n  else if string_equals(name, \"String\") {\n    Some(CtString)\n  }\n  else if string_equals(name, \"Char\") {\n    Some(CtChar)\n  }\n  else if string_equals(name, \"Unit\") {\n    Some(CtUnit)\n  }\n  else if string_equals(name, \"Bytes\") {\n    Some(CtBytes)\n  }\n  else None\n}\n\nexport let subst_add_bound = (s: Subst, id: Int, bounds: Array[String]) -> Subst {\n  SubstBound(id, bounds, s)\n}\n\nlet empty_var_bounds = () -> Array[(Int, Array[String])] {\n  array_slice([\n    (0, array_slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n}\n\nexport let instantiate = (ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = array_length(bound_vars)\n      let id_map = array_slice([\n        (0, 0)\n      ], 0, 0)\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      let mut bnc = c\n      while (!(bi >= blen)) {\n        let old_id = array_get(bound_vars, bi)\n        array_push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      // Remap var_bounds: old_id -> new_id\n      let new_bounds = array_slice([\n        (0, array_slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        array_push(new_bounds, (new_id, bounds))\n      };\n      (subst_apply(inst_s, body), c1, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport let types_compatible = (expected: Type, actual: Type) -> Bool {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport let rec impls_overlap_for = (env: TypeEnv, trait_name: String, new_target: Type) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if string_equals(tname, trait_name) {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nexport let rec trait_is_subtrait = (env: TypeEnv, sub: String, super_name: String) -> Bool {\n  // DFS: sub's supers include super_name, or any of sub's supers is a subtrait of super_name\n  if string_equals(sub, super_name) {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = array_length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while (!(sdone)) {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = array_get(supers, si)\n        if string_equals(s, super_name) {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nlet rec type_implements_check_super = (e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\nlet rec type_implements_check_env = (e: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if string_equals(tname, trait_name) {\n      if types_equal(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nexport let rec type_implements_trait = (env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else {\n    // Check supertrait: if trait_name has subtrait impls\n    let supers = trait_supers(env, trait_name)\n    let slen = array_length(supers)\n    if (slen == 0) {\n      false\n    }\n    else {\n      // Type implements trait_name if it implements all supers? No — reversed:\n      // If T implements sub-trait B where B: A, then T also implements A\n      // So check all traits that the type implements and see if any is a subtrait of trait_name\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n")
    ,
    ("vibe/compiler/bytebuf.vibe",
"// ByteBuf: mutable byte buffer for WASM binary generation\n// ByteBuf = Array[Int], converts to Bytes via bytes_from_array\n\nexport let bytebuf_new = () -> Array[Int] {\n  array_slice([0], 0, 0)\n}\n\nexport let bytebuf_push = (buf: Array[Int], byte: Int) -> Unit {\n  array_push(buf, byte & 255)\n}\n\nexport let bytebuf_length = (buf: Array[Int]) -> Int {\n  array_length(buf)\n}\n\nexport let bytebuf_to_bytes = (buf: Array[Int]) -> Bytes {\n  bytes_from_array(buf)\n}\n\n// LEB128 unsigned encoding\nexport let leb128_encode_u32 = (buf: Array[Int], value: Int) -> Unit {\n  let mut v = value\n  let mut more = true\n  while more {\n    let byte = v & 127\n    v = (v >> 7) & ((1 << 25) - 1)\n    if v == 0 {\n      array_push(buf, byte)\n      more = false\n    } else {\n      array_push(buf, byte | 128)\n    }\n  }\n}\n\n// LEB128 signed encoding (for i32/i64 immediates)\nexport let leb128_encode_s32 = (buf: Array[Int], value: Int) -> Unit {\n  let mut v = value\n  let mut more = true\n  while more {\n    let byte = v & 127\n    v = v >> 7\n    if (v == 0) && ((byte & 64) == 0) {\n      array_push(buf, byte)\n      more = false\n    } else {\n      if (v == 0 - 1) && ((byte & 64) != 0) {\n        array_push(buf, byte)\n        more = false\n      } else {\n        array_push(buf, byte | 128)\n      }\n    }\n  }\n}\n\nexport let leb128_encode_s64 = (buf: Array[Int], value: Int) -> Unit {\n  leb128_encode_s32(buf, value)\n}\n\nexport let bytebuf_push_bytes = (buf: Array[Int], bytes: Bytes) -> Unit {\n  let len = bytes_length(bytes)\n  let mut i = 0\n  while i < len {\n    array_push(buf, bytes_get(bytes, i))\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push_array = (buf: Array[Int], arr: Array[Int]) -> Unit {\n  let len = array_length(arr)\n  let mut i = 0\n  while i < len {\n    array_push(buf, array_get(arr, i) & 255)\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push_section = (out: Array[Int], section_id: Int, content: Array[Int]) -> Unit {\n  array_push(out, section_id)\n  leb128_encode_u32(out, array_length(content))\n  bytebuf_push_array(out, content)\n}\n\nexport let bytebuf_push_vec_header = (buf: Array[Int], count: Int) -> Unit {\n  leb128_encode_u32(buf, count)\n}\n")
    ,
    ("vibe/compiler/lexer.vibe",
"//# Imports\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet is_ws = (c: Int) -> Bool {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nlet is_alpha = (c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nlet is_digit = (c: Int) -> Bool {\n  c >= '0' && c <= '9'\n}\n\nlet is_alnum = (c: Int) -> Bool {\n  is_alpha(c) || is_digit(c)\n}\n\nlet lex_char = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = string_char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = string_char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || string_char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || string_char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nlet rec lex_string_scan = (s: String, len: Int, idx: Int, start: Int, acc: String) -> (String, Int) with { Error } {\n  if idx >= len {\n    throw(\"unterminated string\")\n  }\n  let c = string_char_code_at(s, idx)\n  if c == '\"' {\n    let chunk = string_substring(s, start, idx);\n    (string_concat(acc, chunk), idx + 1)\n  } else if c == '\\\\' {\n    let chunk = string_substring(s, start, idx)\n    let next = idx + 1\n    if next >= len {\n      throw(\"unterminated string escape\")\n    }\n    let esc = string_char_code_at(s, next)\n    let escaped = if esc == '\"' {\n      \"\\\"\"\n    }\n    else if esc == '\\\\' {\n      \"\\\\\"\n    }\n    else if esc == 'n' {\n      \"\\n\"\n    }\n    else if esc == 't' {\n      \"\\t\"\n    }\n    else if esc == 'r' {\n      string_from_char_code(13)\n    }\n    else if esc == '0' {\n      string_from_char_code(0)\n    }\n    else throw(\"invalid escape sequence\");\n    lex_string_scan(s, len, next + 1, next + 1, string_concat(string_concat(acc, chunk), escaped))\n  } else lex_string_scan(s, len, idx + 1, start, acc)\n}\n\nlet lex_string = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let (value, end) = lex_string_scan(s, len, i + 1, i + 1, \"\");\n  (TString(value), end)\n}\n\nlet is_hex_digit = (c: Int) -> Bool {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nlet keyword_lookup = (word: String) -> Option[Token] {\n  let len = string_length(word)\n  if len == 2 {\n    let c0 = string_char_code_at(word, 0)\n    if c0 == 'f' {\n      if string_equals(word, \"fn\") {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if string_equals(word, \"if\") {\n        Some(TIf)\n      } else if string_equals(word, \"in\") {\n        Some(TIn)\n      } else None\n    } else if c0 == 'd' {\n      if string_equals(word, \"do\") {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if string_equals(word, \"as\") {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = string_char_code_at(word, 0)\n    if c0 == 'l' {\n      if string_equals(word, \"let\") {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if string_equals(word, \"rec\") {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if string_equals(word, \"mut\") {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if string_equals(word, \"for\") {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = string_char_code_at(word, 0)\n    if c0 == 'e' {\n      if string_equals(word, \"else\") {\n        Some(TElse)\n      } else if string_equals(word, \"enum\") {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if string_equals(word, \"true\") {\n        Some(TIdent(\"true\"))\n      } else if string_equals(word, \"type\") {\n        Some(TType)\n      } else if string_equals(word, \"test\") {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if string_equals(word, \"with\") {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if string_equals(word, \"loop\") {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if string_equals(word, \"open\") {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if string_equals(word, \"impl\") {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = string_char_code_at(word, 0)\n    if c0 == 'f' {\n      if string_equals(word, \"false\") {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if string_equals(word, \"match\") {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if string_equals(word, \"trait\") {\n        Some(TTrait)\n      } else if string_equals(word, \"throw\") {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if string_equals(word, \"while\") {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if string_equals(word, \"break\") {\n        Some(TBreak)\n      } else if string_equals(word, \"bench\") {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if string_equals(word, \"raise\") {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if string_equals(word, \"yield\") {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = string_char_code_at(word, 0)\n    if c0 == 's' {\n      if string_equals(word, \"struct\") {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if string_equals(word, \"export\") {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if string_equals(word, \"return\") {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if string_equals(word, \"handle\") {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if string_equals(word, \"module\") {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if string_equals(word, \"derive\") {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if string_equals(word, \"import\") {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if string_equals(word, \"declare\") {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = string_char_code_at(word, 0)\n    if c0 == 'c' {\n      if string_equals(word, \"continue\") {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if string_equals(word, \"suberror\") {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nlet rec scan_ident_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_alnum(string_char_code_at(s, i)) {\n    scan_ident_end(s, len, i + 1)\n  } else i\n}\n\nlet lex_ident = (s: String, len: Int, i: Int) -> (Token, Int) {\n  let end = scan_ident_end(s, len, i)\n  let word = string_substring(s, i, end)\n  match keyword_lookup(word) {\n    Some(tok) => if string_equals(word, \"true\") || string_equals(word, \"false\") {\n      (TIdent(word), end)\n    } else (tok, end),\n    None => (TIdent(word), end)\n  }\n}\n\nlet rec scan_digits_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_digit(string_char_code_at(s, i)) {\n    scan_digits_end(s, len, i + 1)\n  } else i\n}\n\nlet rec parse_frac_digits = (s: String, len: Int, i: Int, acc: Double, scale: Double) -> (Double, Int) {\n  if i < len {\n    let c = string_char_code_at(s, i)\n    if is_digit(c) {\n      parse_frac_digits(s, len, i + 1, acc + int_to_double(c - 48) / scale, scale * 10.0)\n    } else (acc, i)\n  } else (acc, i)\n}\n\nlet rec skip_until_newline = (s: String, len: Int, i: Int) -> Int {\n  if i < len {\n    if string_char_code_at(s, i) == '\\n' {\n      i + 1\n    } else skip_until_newline(s, len, i + 1)\n  } else i\n}\n\nlet rec skip_ws = (s: String, len: Int, i: Int) -> Int {\n  if i < len {\n    let c = string_char_code_at(s, i)\n    if is_ws(c) {\n      skip_ws(s, len, i + 1)\n    } else if c == '/' && i + 1 < len && string_char_code_at(s, i + 1) == '/' {\n      let after_comment = skip_until_newline(s, len, i + 2)\n      skip_ws(s, len, after_comment)\n    } else i\n  } else i\n}\n\nlet rec scan_hex_digits_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_hex_digit(string_char_code_at(s, i)) {\n    scan_hex_digits_end(s, len, i + 1)\n  } else i\n}\n\nlet parse_hex_from_string = (s: String) -> Int {\n  let len = string_length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = string_char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nlet parse_int_from_string = (s: String) -> Int {\n  let len = string_length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = string_char_code_at(s, i)\n    acc = acc * 10 + (c - 48)\n    i = i + 1\n  }\n  acc\n}\n\nlet lex_decimal = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  if int_end < len && string_char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(string_char_code_at(s, int_end + 1)) {\n      let int_str = string_substring(s, i, int_end)\n      let int_val = int_to_double(parse_int_from_string(int_str))\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\n      (TFloat(int_val + frac_val), frac_end)\n    } else {\n      let int_str = string_substring(s, i, int_end);\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else {\n    let int_str = string_substring(s, i, int_end);\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nlet lex_number = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  if i + 1 < len && string_char_code_at(s, i) == '0' {\n    let next_c = string_char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = string_substring(s, hex_start, hex_end);\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\nexport let lex = (source: String) -> Array[Token] with { Error } {\n  let len = string_length(source)\n  {\n    let b = array_builder()\n    let mut pos = skip_ws(source, len, 0)\n    while pos < len {\n      let c = string_char_code_at(source, pos)\n      let (tok, next) = if is_alpha(c) {\n        lex_ident(source, len, pos)\n      } else if is_digit(c) {\n        lex_number(source, len, pos)\n      } else if c == '\"' {\n        lex_string(source, len, pos)\n      } else if c == '+' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TPlusEq, pos + 2)\n        } else (TPlus, pos + 1)\n      } else if c == '-' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '>' {\n          (TThinArrow, pos + 2)\n        } else if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TMinusEq, pos + 2)\n        } else (TMinus, pos + 1)\n      } else if c == '*' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TStarEq, pos + 2)\n        } else (TStar, pos + 1)\n      } else if c == '/' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TSlashEq, pos + 2)\n        } else (TSlash, pos + 1)\n      } else if c == '%' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TPercentEq, pos + 2)\n        } else (TPercent, pos + 1)\n      } else if c == '=' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TEqEq, pos + 2)\n        } else if pos + 1 < len && string_char_code_at(source, pos + 1) == '>' {\n          (TArrow, pos + 2)\n        } else (TEq, pos + 1)\n      } else if c == '!' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TNeq, pos + 2)\n        } else (TNot, pos + 1)\n      } else if c == '<' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TLte, pos + 2)\n        } else if pos + 1 < len && string_char_code_at(source, pos + 1) == '<' {\n          (TLShift, pos + 2)\n        } else (TLt, pos + 1)\n      } else if c == '>' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '=' {\n          (TGte, pos + 2)\n        } else if pos + 1 < len && string_char_code_at(source, pos + 1) == '>' {\n          (TRShift, pos + 2)\n        } else (TGt, pos + 1)\n      } else if c == '&' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '&' {\n          (TAnd, pos + 2)\n        } else (TBitAnd, pos + 1)\n      } else if c == '|' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == '|' {\n          (TOr, pos + 2)\n        } else if pos + 1 < len && string_char_code_at(source, pos + 1) == '>' {\n          (TPipeGt, pos + 2)\n        } else (TBitOr, pos + 1)\n      } else if c == '^' {\n        (TBitXor, pos + 1)\n      } else if c == '(' {\n        (TLParen, pos + 1)\n      } else if c == ')' {\n        (TRParen, pos + 1)\n      } else if c == '{' {\n        (TLBrace, pos + 1)\n      } else if c == '}' {\n        (TRBrace, pos + 1)\n      } else if c == '[' {\n        (TLBracket, pos + 1)\n      } else if c == ']' {\n        (TRBracket, pos + 1)\n      } else if c == ',' {\n        (TComma, pos + 1)\n      } else if c == ';' {\n        (TSemicolon, pos + 1)\n      } else if c == '.' {\n        (TDot, pos + 1)\n      } else if c == ':' {\n        if pos + 1 < len && string_char_code_at(source, pos + 1) == ':' {\n          (TDoubleColon, pos + 2)\n        } else (TColon, pos + 1)\n      } else if c == '#' {\n        (THash, pos + 1)\n      } else if c == '~' {\n        (TTilde, pos + 1)\n      } else if c == '?' {\n        (TQuestion, pos + 1)\n      } else if c == '\\'' {\n        lex_char(source, len, pos)\n      } else throw(string_concat(\"unexpected character: \", string_from_char_code(c)))\n      array_builder_push(b, tok)\n      pos = skip_ws(source, len, next)\n    }\n    array_builder_push(b, TEof)\n    array_builder_freeze(b)\n  }\n}\n\nexport let lex_ok = (source: String) -> Bool {\n  handle {\n    let _ = lex(source)\n    true\n  } {\n    Error(_) => false\n  }\n}\n")
    ,
    ("vibe/compiler/parser.vibe",
"//# Imports\n\nexport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./token.vibe {\n  Token\n}\n\n//# Parse Mode Constants\n// Precedence modes: 0-10 (used arithmetically in parse_infix)\n// Named modes for structured parsing:\nlet mode_block = 20\nlet mode_if = 21\nlet mode_match = 22\nlet mode_while = 23\nlet mode_handle = 24\nlet mode_for_in = 25\n\n//# Functions\n\nlet peek = (tokens: Array[Token], pos: Int) -> Token {\n  if pos < array_length(tokens) {\n    array_get(tokens, pos)\n  } else TEof\n}\n\nlet _no_tp = () -> Array[String] {\n  array_slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet _no_tb = () -> Array[(String, Array[String])] {\n  array_slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet tk_name = (tok: Token) -> String {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TEof => \"eof\"\n  }\n}\n\nlet is_tk = (tok: Token, name: String) -> Bool {\n  string_equals(tk_name(tok), name)\n}\n\nlet expect_tk = (tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  }\n  else throw(string_concat(\"expected \", string_concat(expected, string_concat(\" but got \", tk_name(peek(tokens, pos))))))\n}\n\nlet skip_semi = (tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nlet empty_arms = () -> Array[(Pat, Expr)] {\n  array_slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nlet empty_pats = () -> Array[Pat] {\n  array_slice([\n    PWild\n  ], 0, 0)\n}\n\nlet empty_ctors = () -> Array[(String, Array[TypeExpr])] {\n  array_slice([\n    (\"_\", array_slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet empty_exprs = () -> Array[Expr] {\n  array_slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet empty_names = () -> Array[String] {\n  array_slice([\n    \"_\"\n  ], 0, 0)\n}\n\nlet empty_fields = () -> Array[(String, TypeExpr)] {\n  array_slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nlet empty_params = () -> Array[(String, Option[TypeExpr])] {\n  array_slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nlet rec parse_pattern = (tokens: Array[Token], pos: Int) -> (Pat, Int)with { Error } {\n  let rec parse_pat_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Pat]) -> (Array[Pat], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        array_builder_push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (array_builder_freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen = (tokens: Array[Token], pos: Int) -> (Array[Pat], Int)with { Error } {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = array_builder()\n        array_builder_push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => if string_equals(name, \"true\") {\n      (PBool(true), pos + 1)\n    }\n    else if string_equals(name, \"false\") {\n      (PBool(false), pos + 1)\n    }\n    else if string_equals(name, \"_\") {\n      (PWild, pos + 1)\n    }\n    else {\n      let fc = string_char_code_at(name, 0)\n      if fc >= 65 && fc <= 90 {\n        match peek(tokens, pos + 1) {\n          TLParen => {\n            let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n            (PCtor(name, args), end)\n          },\n          _ => (PCtor(name, empty_pats()), pos + 1)\n        }\n      } else (PBind(name), pos + 1)\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = array_builder()\n            array_builder_push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => throw(string_concat(\"unexpected in pattern: \", tk_name(peek(tokens, pos))))\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nlet parse_impl_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let empty_strings = array_slice([\n    \"_\"\n  ], 0, 0)\n  let empty_bounds = array_slice([\n    (\"_\", empty_strings)\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TLBracket => throw(\"impl type parameters are not supported yet\"),\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, pos + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => (SImpl(empty_strings, empty_bounds, trait_name, type_name), fp + 1),\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nlet empty_type_exprs = () -> Array[TypeExpr] {\n  array_slice([\n    TyUnit\n  ], 0, 0)\n}\n\nlet rec parse_type_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int)with { Error } {\n  let rec type_list_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n        array_builder_push(b, ty)\n        type_list_rest(tokens, next, b)\n      },\n      _ => (array_builder_freeze(b), pos)\n    }\n  }\n  if mode == 0 {\n    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n    match peek(tokens, atom_next) {\n      TThinArrow => {\n        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n        let params = match atom_ty {\n          TyUnit => empty_type_exprs(),\n          TyTuple(elems) => elems,\n          _ => [\n            atom_ty\n          ]\n        }\n        // Skip optional `with { Error, ... }` effect annotation\n        let rn2 = match peek(tokens, rn) {\n          TWith => {\n            let p1 = rn + 1\n            match peek(tokens, p1) {\n              TLBrace => {\n                // skip tokens until matching TRBrace\n                let mut p2 = p1 + 1\n                let mut done = false\n                while (!(done)) {\n                  match peek(tokens, p2) {\n                    TRBrace => { done = true },\n                    _ => { p2 = p2 + 1 }\n                  }\n                }\n                p2 + 1\n              },\n              _ => rn\n            }\n          },\n          _ => rn\n        };\n        (TyFn(params, ret), rn2)\n      },\n      _ => (atom_ty, atom_next)\n    }\n  } else match peek(tokens, pos) {\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (TyUnit, pos + 2),\n      _ => {\n        let (first, n1) = parse_type_impl(tokens, pos + 1, 0)\n        match peek(tokens, n1) {\n          TRParen => (first, n1 + 1),\n          TComma => {\n            let b = array_builder()\n            array_builder_push(b, first)\n            let (rest, end) = type_list_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \")\");\n            (TyTuple(rest), en)\n          },\n          _ => throw(\"expected ')' or ',' in type\")\n        }\n      }\n    },\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLBracket => {\n        let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n        match peek(tokens, n1) {\n          TRBracket => (TyApp(name, [\n            first\n          ]), n1 + 1),\n          TComma => {\n            let b = array_builder()\n            array_builder_push(b, first)\n            let (rest, end) = type_list_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \"]\");\n            (TyApp(name, rest), en)\n          },\n          _ => throw(\"expected ']' or ',' in type application\")\n        }\n      },\n      _ => (TyName(name), pos + 1)\n    },\n    _ => throw(string_concat(\"expected type but got \", tk_name(peek(tokens, pos))))\n  }\n}\n\nexport let parse_type = (tokens: Array[Token], pos: Int) -> (TypeExpr, Int)with { Error } {\n  parse_type_impl(tokens, pos, 0)\n}\n\nlet parse_one_param = (tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = string_concat(name, \"~\")\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        ((name, Some(ty)), tp)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => throw(\"expected parameter name\")\n  }\n}\n\nlet rec parse_param_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (p, pn) = parse_one_param(tokens, pos + 1)\n      array_builder_push(b, p)\n      parse_param_cont(tokens, pn, b)\n    },\n    TRParen => (array_builder_freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in param list\")\n  }\n}\n\nlet parse_param_list = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = array_builder()\n      array_builder_push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nlet parse_trait_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  let empty_strings = array_slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TColon => {\n        // Parse supertrait list: trait Name: Trait1 + Trait2\n        let rec parse_supers = (p: Int, acc: Array[String]) -> (Array[String], Int) {\n          match peek(tokens, p) {\n            TIdent(sname) => match peek(tokens, p + 1) {\n              TPlus => parse_supers(p + 2, array_concat(acc, [\n                sname\n              ])),\n              _ => (array_concat(acc, [\n                sname\n              ]), p + 1)\n            },\n            _ => (acc, p)\n          }\n        }\n        let (supers, np) = parse_supers(pos + 2, empty_strings);\n        (STrait(exported, name, supers), np)\n      },\n      _ => (STrait(exported, name, empty_strings), pos + 1)\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nlet is_expr_end_token = (tok: Token) -> Bool {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nlet is_non_pipe_infix = (tok: Token) -> Bool {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nlet parse_import_item = (tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TAs => match peek(tokens, pos + 2) {\n        TIdent(alias) => ((name, Some(alias)), pos + 3),\n        _ => throw(\"expected alias name after 'as'\")\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => throw(\"expected import item name\")\n  }\n}\n\nlet empty_import_items = () -> Array[(String, Option[String])] {\n  array_slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nlet parse_struct_field = (tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, pos + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nlet rec collect_import_path = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, string_concat(acc, \".\")),\n    TSlash => collect_import_path(tokens, pos + 1, string_concat(acc, \"/\")),\n    TIdent(name) => collect_import_path(tokens, pos + 1, string_concat(acc, name)),\n    TMinus => collect_import_path(tokens, pos + 1, string_concat(acc, \"-\")),\n    TModule => collect_import_path(tokens, pos + 1, string_concat(acc, \"module\")),\n    TType => collect_import_path(tokens, pos + 1, string_concat(acc, \"type\")),\n    TMatch => collect_import_path(tokens, pos + 1, string_concat(acc, \"match\")),\n    TTest => collect_import_path(tokens, pos + 1, string_concat(acc, \"test\")),\n    _ => throw(string_concat(\"unexpected token in import path: \", tk_name(peek(tokens, pos))))\n  }\n}\n\nlet rec collect_effect_names = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let new_acc = if string_length(acc) == 0 {\n        name\n      } else string_concat(acc, string_concat(\", \", name))\n      match peek(tokens, pos + 1) {\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\n        TRBrace => (new_acc, pos + 2),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nlet rec is_lambda_start_impl = (tokens: Array[Token], pos: Int, depth: Int, has_colon: Bool) -> Bool {\n  match peek(tokens, pos) {\n    TColon => if depth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => has_colon,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)\n  }\n}\n\nlet is_lambda_start = (tokens: Array[Token], pos: Int) -> Bool {\n  is_lambda_start_impl(tokens, pos, 0, false)\n}\n\nlet rec parse_ctor_types_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      array_builder_push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (array_builder_freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nlet parse_enum_ctor = (tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = array_builder()\n          array_builder_push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nlet rec parse_enum_ctors_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (array_builder_freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        array_builder_push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (array_builder_freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        array_builder_push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (array_builder_freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in enum\")\n  }\n}\n\nlet parse_enum_ctors = (tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = array_builder()\n      array_builder_push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_enum_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      (SEnum(exported, name, ctors), end)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nlet parse_suberror_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = array_builder()\n          array_builder_push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, array_builder_freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = array_builder()\n          array_builder_push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = array_builder()\n          array_builder_push(ctors_b, (name, args))\n          (SSuberror(exported, name, array_builder_freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nlet parse_type_alias_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let ep = expect_tk(tokens, pos + 1, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nlet has_non_pipe_infix_top = (tokens: Array[Token], start: Int, end: Int) -> Bool {\n  let rec go = (i: Int, depth: Int, prev_top_end: Bool) -> Bool {\n    if i >= end {\n      false\n    } else {\n      let tok = peek(tokens, i)\n      if depth == 0 {\n        if is_non_pipe_infix(tok) {\n          if prev_top_end {\n            true\n          } else go(i + 1, 0, false)\n        } else match tok {\n          TLParen => go(i + 1, 1, false),\n          TLBracket => go(i + 1, 1, false),\n          TLBrace => go(i + 1, 1, false),\n          _ => go(i + 1, 0, is_expr_end_token(tok))\n        }\n      } else match tok {\n        TLParen => go(i + 1, depth + 1, prev_top_end),\n        TLBracket => go(i + 1, depth + 1, prev_top_end),\n        TLBrace => go(i + 1, depth + 1, prev_top_end),\n        TRParen => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        TRBracket => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        TRBrace => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        _ => go(i + 1, depth, prev_top_end)\n      }\n    }\n  }\n  go(start, 0, false)\n}\n\nexport let rec parse_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (Expr, Int)with { Error } {\n  let rec parse_comma_exprs_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (e, next) = parse_impl(tokens, pos + 1, 0)\n        array_builder_push(b, e)\n        parse_comma_exprs_rest(tokens, next, b)\n      },\n      _ => (array_builder_freeze(b), pos)\n    }\n  }\n  let parse_primary = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TInt(n) => (EInt(n), pos + 1),\n      TFloat(n) => (EFloat(n), pos + 1),\n      TString(s) => (EString(s), pos + 1),\n      TIdent(name) => if string_equals(name, \"true\") {\n        (EBool(true), pos + 1)\n      }\n      else if string_equals(name, \"false\") {\n        (EBool(false), pos + 1)\n      }\n      else match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TLBrace => {\n            // Name::{ field: val, ... } record literal\n            let rec parse_record_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int) with { Error } {\n              match peek(toks, p) {\n                TRBrace => (array_builder_freeze(b), p + 1),\n                TIdent(fname) => {\n                  let cn = expect_tk(toks, p + 1, \":\")\n                  let (val, vn) = parse_impl(toks, cn, 0)\n                  array_builder_push(b, (fname, val))\n                  match peek(toks, vn) {\n                    TComma => parse_record_fields(toks, vn + 1, b),\n                    TRBrace => (array_builder_freeze(b), vn + 1),\n                    _ => throw(\"expected ',' or '}' in record literal\")\n                  }\n                },\n                _ => throw(\"expected field name or '}' in record literal\")\n              }\n            }\n            let rb = array_builder()\n            let (fields, end) = parse_record_fields(tokens, pos + 3, rb);\n            (ERecord(fields), end)\n          },\n          _ => (EIdent(name), pos + 1)\n        },\n        _ => (EIdent(name), pos + 1)\n      },\n      TLParen => if is_lambda_start(tokens, pos + 1) {\n        let (params, ap) = parse_param_list(tokens, pos + 1)\n        let parse_lambda_body = (saved_params: Array[(String, Option[TypeExpr])], saved_ret_ty: Option[TypeExpr], saved_effect: Option[String], body_pos: Int, body_mode: Int) -> (Expr, Int)with { Error } {\n          let (body, end) = parse_impl(tokens, body_pos, body_mode);\n          (EFn(_no_tp(), _no_tb(), saved_params, saved_ret_ty, saved_effect, body), end)\n        }\n        match peek(tokens, ap) {\n          TThinArrow => {\n            let after_arrow = ap + 1\n            match peek(tokens, after_arrow) {\n              TIdent(_) => {\n                let (ty, tp) = parse_type_impl(tokens, after_arrow, 0)\n                match peek(tokens, tp) {\n                  TLBrace => parse_lambda_body(params, Some(ty), None, tp + 1, mode_block),\n                  TWith => {\n                    let wb = expect_tk(tokens, tp + 1, \"{\")\n                    let (eff, eb) = collect_effect_names(tokens, wb, \"\")\n                    let bb = expect_tk(tokens, eb, \"{\")\n                    parse_lambda_body(params, Some(ty), Some(eff), bb, mode_block)\n                  },\n                  _ => parse_lambda_body(params, None, None, after_arrow, 0)\n                }\n              },\n              TLParen => {\n                let (ty, tp) = parse_type_impl(tokens, after_arrow, 0)\n                match peek(tokens, tp) {\n                  TLBrace => parse_lambda_body(params, Some(ty), None, tp + 1, mode_block),\n                  TWith => {\n                    let wb = expect_tk(tokens, tp + 1, \"{\")\n                    let (eff, eb) = collect_effect_names(tokens, wb, \"\")\n                    let bb = expect_tk(tokens, eb, \"{\")\n                    parse_lambda_body(params, Some(ty), Some(eff), bb, mode_block)\n                  },\n                  _ => parse_lambda_body(params, None, None, after_arrow, 0)\n                }\n              },\n              _ => parse_lambda_body(params, None, None, after_arrow, 0)\n            }\n          },\n          TLBrace => parse_lambda_body(params, None, None, ap + 1, mode_block),\n          _ => throw(\"expected '->' or '{' after fn params\")\n        }\n      } else match peek(tokens, pos + 1) {\n        TRParen => (EUnit, pos + 2),\n        _ => {\n          let (f, n1) = parse_impl(tokens, pos + 1, 0)\n          match peek(tokens, n1) {\n            TRParen => (f, n1 + 1),\n            TComma => {\n              let b = array_builder()\n              array_builder_push(b, f)\n              let (tup, end) = parse_comma_exprs_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (ETuple(tup), en)\n            },\n            _ => throw(\"expected ')' or ','\")\n          }\n        }\n      },\n      TLBracket => match peek(tokens, pos + 1) {\n        TRBracket => (EArray(empty_exprs()), pos + 2),\n        _ => {\n          let b = array_builder()\n          let (f, n1) = parse_impl(tokens, pos + 1, 0)\n          array_builder_push(b, f)\n          let (arr, end) = parse_comma_exprs_rest(tokens, n1, b)\n          let en = expect_tk(tokens, end, \"]\");\n          (EArray(arr), en)\n        }\n      },\n      TLBrace => parse_impl(tokens, pos + 1, mode_block),\n      TIf => parse_impl(tokens, pos + 1, mode_if),\n      TMatch => parse_impl(tokens, pos + 1, mode_match),\n      THandle => parse_impl(tokens, pos + 1, mode_handle),\n      TWhile => parse_impl(tokens, pos + 1, mode_while),\n      TFor => parse_impl(tokens, pos + 1, mode_for_in),\n      TThrow => {\n        let lp = expect_tk(tokens, pos + 1, \"(\")\n        let (e, en) = parse_impl(tokens, lp, 0)\n        let rp = expect_tk(tokens, en, \")\");\n        (EThrow(e), rp)\n      },\n      TBreak => {\n        let next_tok = peek(tokens, pos + 1)\n        match next_tok {\n          TRBrace => (EBreak(None), pos + 1),\n          TSemicolon => (EBreak(None), pos + 1),\n          TEof => (EBreak(None), pos + 1),\n          _ => {\n            let (e, en) = parse_impl(tokens, pos + 1, 0);\n            (EBreak(Some(e)), en)\n          }\n        }\n      },\n      TContinue => match peek(tokens, pos + 1) {\n        TLParen => {\n          let b = array_builder()\n          match peek(tokens, pos + 2) {\n            TRParen => (EContinue(empty_exprs()), pos + 3),\n            _ => {\n              let (f, fn1) = parse_impl(tokens, pos + 2, 0)\n              array_builder_push(b, f)\n              let (args, end) = parse_comma_exprs_rest(tokens, fn1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (EContinue(args), en)\n            }\n          }\n        },\n        _ => (EContinue(empty_exprs()), pos + 1)\n      }\n      ,\n      TRaise => throw(\"'raise' is deprecated, use 'throw(expr)' instead\"),\n      TReturn => throw(\"'return' is not supported; use implicit returns\"),\n      TDo => throw(\"'do' is reserved; use 'while' or 'for' instead\"),\n      TLoop => throw(\"'loop' is reserved; use 'while true' instead\"),\n      TYield => throw(\"'yield' is not supported\"),\n      TDeclare => throw(\"'declare' is not supported\"),\n      _ => throw(string_concat(\"unexpected token: \", tk_name(peek(tokens, pos))))\n    }\n  }\n  let parse_call_arg = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TIdent(name) => match peek(tokens, pos + 1) {\n        TTilde => match peek(tokens, pos + 2) {\n          TEq => {\n            let (val, end) = parse_impl(tokens, pos + 3, 0);\n            (ELabeledArg(name, \"~\", val), end)\n          },\n          _ => parse_impl(tokens, pos, 0)\n        },\n        TQuestion => match peek(tokens, pos + 2) {\n          TEq => {\n            let (val, end) = parse_impl(tokens, pos + 3, 0);\n            (ELabeledArg(name, \"?\", val), end)\n          },\n          _ => parse_impl(tokens, pos, 0)\n        },\n        TEq => {\n          let (val, end) = parse_impl(tokens, pos + 2, 0);\n          (ELabeledArg(name, \"~\", val), end)\n        },\n        _ => parse_impl(tokens, pos, 0)\n      },\n      _ => parse_impl(tokens, pos, 0)\n    }\n  }\n  let rec parse_call_args_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (e, next) = parse_call_arg(tokens, pos + 1)\n        array_builder_push(b, e)\n        parse_call_args_rest(tokens, next, b)\n      },\n      _ => (array_builder_freeze(b), pos)\n    }\n  }\n  let rec parse_postfix = (tokens: Array[Token], pos: Int, expr: Expr) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => parse_postfix(tokens, pos + 2, ECall(expr, empty_exprs())),\n        _ => {\n          let b = array_builder()\n          let (f, n1) = parse_call_arg(tokens, pos + 1)\n          array_builder_push(b, f)\n          let (args, end) = parse_call_args_rest(tokens, n1, b)\n          let en = expect_tk(tokens, end, \")\")\n          parse_postfix(tokens, en, ECall(expr, args))\n        }\n      },\n      TDot => match peek(tokens, pos + 1) {\n        TIdent(field) => parse_postfix(tokens, pos + 2, EDot(expr, field)),\n        _ => (expr, pos)\n      },\n      _ => (expr, pos)\n    }\n  }\n  let pipe_desugar = (lhs: Expr, rhs: Expr) -> Expr {\n    match rhs {\n      ECall(callee, args) => ECall(callee, array_concat([\n        lhs\n      ], args)),\n      _ => ECall(rhs, [\n        lhs\n      ])\n    }\n  }\n  let binop_prec = (tok: Token) -> Int {\n    match tok {\n      TOr => 0,\n      TAnd => 1,\n      TPipeGt => 2,\n      TEqEq => 3,\n      TNeq => 3,\n      TLt => 3,\n      TLte => 3,\n      TGt => 3,\n      TGte => 3,\n      TBitOr => 4,\n      TBitXor => 5,\n      TBitAnd => 6,\n      TLShift => 7,\n      TRShift => 7,\n      TPlus => 8,\n      TMinus => 8,\n      TStar => 9,\n      TSlash => 9,\n      TPercent => 9,\n      _ => -1\n    }\n  }\n  let binop_op = (tok: Token) -> String with { Error } {\n    match tok {\n      TOr => \"||\",\n      TAnd => \"&&\",\n      TPipeGt => \"|>\",\n      TEqEq => \"==\",\n      TNeq => \"!=\",\n      TLt => \"<\",\n      TLte => \"<=\",\n      TGt => \">\",\n      TGte => \">=\",\n      TBitOr => \"|\",\n      TBitXor => \"^\",\n      TBitAnd => \"&\",\n      TLShift => \"<<\",\n      TRShift => \">>\",\n      TPlus => \"+\",\n      TMinus => \"-\",\n      TStar => \"*\",\n      TSlash => \"/\",\n      TPercent => \"%\",\n      _ => throw(\"internal parser error: not a binary operator\")\n    }\n  }\n  let rec parse_prefix = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TMinus => {\n        let (e, next) = parse_prefix(tokens, pos + 1);\n        (EUnaryOp(\"-\", e), next)\n      },\n      TNot => {\n        let (e, next) = parse_prefix(tokens, pos + 1);\n        (EUnaryOp(\"!\", e), next)\n      },\n      _ => {\n        let (e, next) = parse_primary(tokens, pos)\n        parse_postfix(tokens, next, e)\n      }\n    }\n  }\n  let rec parse_infix_loop = (tokens: Array[Token], left: Expr, next: Int, min_prec: Int, expr_start: Int, cmp_locked: Bool) -> (Expr, Int)with { Error } {\n    let tok = peek(tokens, next)\n    let prec = binop_prec(tok)\n    if prec < min_prec || (cmp_locked && prec == 3) {\n      (left, next)\n    } else {\n      let op = binop_op(tok)\n      if string_equals(op, \"|>\") {\n        if has_non_pipe_infix_top(tokens, expr_start, next) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n      let (right0, right_next0) = parse_prefix(tokens, next + 1)\n      let (right, rn) = parse_infix_loop(tokens, right0, right_next0, prec + 1, next + 1, false)\n      if string_equals(op, \"|>\") {\n        if has_non_pipe_infix_top(tokens, next + 1, rn) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n      let combined = if string_equals(op, \"|>\") {\n        pipe_desugar(left, right)\n      } else {\n        EBinOp(op, left, right)\n      }\n      let next_cmp_locked = if prec == 3 {\n        true\n      } else {\n        cmp_locked\n      }\n      parse_infix_loop(tokens, combined, rn, min_prec, expr_start, next_cmp_locked)\n    }\n  }\n  let rec parse_infix = (tokens: Array[Token], pos: Int, min_prec: Int, expr_start: Int) -> (Expr, Int)with { Error } {\n    let (left0, next0) = parse_prefix(tokens, pos)\n    parse_infix_loop(tokens, left0, next0, min_prec, expr_start, false)\n  }\n  let rec parse_match_rest = (tokens: Array[Token], pos: Int, scrutinee: Expr, b: ArrayBuilder[(Pat, Expr)]) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRBrace => (EMatch(scrutinee, array_builder_freeze(b)), pos + 2),\n        _ => {\n          let (pa, paa) = parse_pattern(tokens, pos + 1)\n          let a2 = expect_tk(tokens, paa, \"=>\")\n          let (ea, en) = parse_impl(tokens, a2, 0)\n          array_builder_push(b, (pa, ea))\n          parse_match_rest(tokens, en, scrutinee, b)\n        }\n      },\n      TRBrace => (EMatch(scrutinee, array_builder_freeze(b)), pos + 1),\n      _ => throw(\"expected ',' or '}' in match\")\n    }\n  }\n  let rec parse_handle_rest = (tokens: Array[Token], pos: Int, body: Expr, b: ArrayBuilder[(Pat, Expr)]) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRBrace => (EHandle(body, array_builder_freeze(b)), pos + 2),\n        _ => {\n          let (pa, paa) = parse_pattern(tokens, pos + 1)\n          let a2 = expect_tk(tokens, paa, \"=>\")\n          let (ea, en) = parse_impl(tokens, a2, 0)\n          array_builder_push(b, (pa, ea))\n          parse_handle_rest(tokens, en, body, b)\n        }\n      },\n      TRBrace => (EHandle(body, array_builder_freeze(b)), pos + 1),\n      _ => throw(\"expected ',' or '}' in handle\")\n    }\n  }\n  let rec parse_block_after_expr = (tokens: Array[Token], pos: Int, e: Expr) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TRBrace => (e, pos + 1),\n      TSemicolon => {\n        let (rest, end) = parse_impl(tokens, pos + 1, mode_block);\n        (ESeq(e, rest), end)\n      },\n      TEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssign(name, val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TPlusEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"+\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TMinusEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"-\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TStarEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"*\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TSlashEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"/\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TPercentEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"%\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      _ => {\n        // Implicit sequence: continue parsing rest of block (handles let, expressions, etc.)\n        let (rest, end) = parse_impl(tokens, pos, mode_block)\n        if end <= pos {\n          throw(\"internal parser error: block continuation did not advance\")\n        } else (ESeq(e, rest), end)\n      }\n    }\n  }\n  if mode == mode_match {\n    let (scrutinee, sn) = parse_impl(tokens, pos, 0)\n    let br = expect_tk(tokens, sn, \"{\")\n    match peek(tokens, br) {\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\n      _ => {\n        let b = array_builder()\n        let (fp, fa) = parse_pattern(tokens, br)\n        let aa = expect_tk(tokens, fa, \"=>\")\n        let (fe, fn1) = parse_impl(tokens, aa, 0)\n        array_builder_push(b, (fp, fe))\n        parse_match_rest(tokens, fn1, scrutinee, b)\n      }\n    }\n  } else if mode == mode_if {\n    let (cond, cn) = parse_impl(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (then_e, tn) = parse_impl(tokens, br, mode_block)\n    match peek(tokens, tn) {\n      TElse => match peek(tokens, tn + 1) {\n        TIf => {\n          let (else_e, end) = parse_impl(tokens, tn + 2, mode_if);\n          (EIf(cond, then_e, else_e), end)\n        },\n        TLBrace => {\n          let (else_e, end) = parse_impl(tokens, tn + 2, mode_block);\n          (EIf(cond, then_e, else_e), end)\n        },\n        _ => {\n          let (else_e, end) = parse_impl(tokens, tn + 1, 0);\n          (EIf(cond, then_e, else_e), end)\n        }\n      },\n      _ => (EIf(cond, then_e, EUnit), tn)\n    }\n  } else if mode == mode_while {\n    let (cond, cn) = parse_impl(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (body, end) = parse_impl(tokens, br, mode_block);\n    (EWhile(cond, body), end)\n  } else if mode == mode_handle {\n    let br = expect_tk(tokens, pos, \"{\")\n    let (body, bn) = parse_impl(tokens, br, mode_block)\n    let hb = expect_tk(tokens, bn, \"{\")\n    match peek(tokens, hb) {\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\n      _ => {\n        let b = array_builder()\n        let (fp, fa) = parse_pattern(tokens, hb)\n        let aa = expect_tk(tokens, fa, \"=>\")\n        let (fe, fn1) = parse_impl(tokens, aa, 0)\n        array_builder_push(b, (fp, fe))\n        parse_handle_rest(tokens, fn1, body, b)\n      }\n    }\n  } else if mode == mode_for_in {\n    match peek(tokens, pos) {\n      TIdent(name) => {\n        let ip = expect_tk(tokens, pos + 1, \"in\")\n        let (iterable, inext) = parse_impl(tokens, ip, 0)\n        let bb = expect_tk(tokens, inext, \"{\")\n        let (body, end) = parse_impl(tokens, bb, mode_block);\n        (EForIn(name, iterable, body), end)\n      },\n      _ => throw(\"expected identifier after 'for'\")\n    }\n  } else if mode == mode_block {\n    match peek(tokens, pos) {\n      TRBrace => (EUnit, pos + 1),\n      TLet => {\n        let next = pos + 1\n        match peek(tokens, next) {\n          TRec => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq = expect_tk(tokens, next + 2, \"=\")\n              let (val, vn) = parse_impl(tokens, eq, 0)\n              let a = skip_semi(tokens, vn)\n              let (body, end) = parse_impl(tokens, a, mode_block)\n              if end <= a {\n                throw(\"internal parser error: block let-rec parser did not advance\")\n              } else (ELetRec(name, val, body), end)\n            },\n            _ => throw(\"expected identifier after 'let rec'\")\n          },\n          TMut => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq = expect_tk(tokens, next + 2, \"=\")\n              let (val, vn) = parse_impl(tokens, eq, 0)\n              let a = skip_semi(tokens, vn)\n              let (body, end) = parse_impl(tokens, a, mode_block)\n              if end <= a {\n                throw(\"internal parser error: block let-mut parser did not advance\")\n              } else (ELetMut(name, val, body), end)\n            },\n            _ => throw(\"expected identifier after 'let mut'\")\n          },\n          TIdent(name) => {\n            let eq = expect_tk(tokens, next + 1, \"=\")\n            let (val, vn) = parse_impl(tokens, eq, 0)\n            let a = skip_semi(tokens, vn)\n            let (body, end) = parse_impl(tokens, a, mode_block)\n            if end <= a {\n              throw(\"internal parser error: block let parser did not advance\")\n            } else (ELet(name, val, body), end)\n          },\n          TLParen => {\n            let (pat, pn) = parse_pattern(tokens, next)\n            let eq = expect_tk(tokens, pn, \"=\")\n            let (val, vn) = parse_impl(tokens, eq, 0)\n            let a = skip_semi(tokens, vn)\n            let (body, end) = parse_impl(tokens, a, mode_block)\n            if end <= a {\n              throw(\"internal parser error: block let-pat parser did not advance\")\n            } else {\n              let arms = [\n                (pat, body)\n              ]\n              (EMatch(val, arms), end)\n            }\n          },\n          _ => throw(\"expected identifier after 'let'\")\n        }\n      },\n      _ => {\n        let (e, next) = parse_impl(tokens, pos, 0)\n        if next <= pos {\n          throw(\"internal parser error: block expr parser did not advance\")\n        } else parse_block_after_expr(tokens, next, e)\n      }\n    }\n  } else if mode >= 0 && mode <= 10 {\n    parse_infix(tokens, pos, mode, pos)\n  } else {\n    throw(\"internal parser error: unknown parse mode\")\n  }\n}\n\nexport let parse = (tokens: Array[Token]) -> Expr with { Error } {\n  let (e, next) = parse_impl(tokens, 0, 0)\n  match peek(tokens, next) {\n    TEof => e,\n    _ => throw(string_concat(\"unexpected after expression: \", tk_name(peek(tokens, next))))\n  }\n}\n\nexport let parse_ok = (tokens: Array[Token]) -> Bool {\n  handle {\n    let _ = parse(tokens)\n    true\n  } {\n    Error(_) => false\n  }\n}\n\nexport let parse_expr = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n  parse_impl(tokens, pos, 0)\n}\n\nlet parse_let_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TRec => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let (val, vn) = parse_impl(tokens, ep, 0);\n        (SLet(exported, true, name, ty_opt, val), vn)\n      },\n      _ => throw(\"expected name after 'let rec'\")\n    },\n    TMut => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let (val, vn) = parse_impl(tokens, ep, 0);\n        (SLetMut(name, ty_opt, val), vn)\n      },\n      _ => throw(\"expected name after 'let mut'\")\n    },\n    TIdent(name) => {\n      let (ty_opt, eq_pos) = match peek(tokens, pos + 1) {\n        TColon => {\n          let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n          (Some(ty), tp)\n        },\n        _ => (None, pos + 1)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (val, vn) = parse_impl(tokens, ep, 0);\n      (SLet(exported, false, name, ty_opt, val), vn)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nlet parse_test_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, mode_block);\n      (STest(name, body), end)\n    },\n    _ => throw(\"expected test name string\")\n  }\n}\n\nlet parse_bench_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, mode_block);\n      (SBench(name, body), end)\n    },\n    _ => throw(\"expected bench name string\")\n  }\n}\n\nlet rec parse_export_names_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        array_builder_push(b, name)\n        parse_export_names_rest(tokens, pos + 2, b)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TRBrace => (array_builder_freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in export list\")\n  }\n}\n\nlet rec parse_import_items_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (item, next) = parse_import_item(tokens, pos + 1)\n      array_builder_push(b, item)\n      parse_import_items_rest(tokens, next, b)\n    },\n    TRBrace => (array_builder_freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in import list\")\n  }\n}\n\nlet parse_import_items = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_import_items(), pos + 1),\n    _ => {\n      let (first, next) = parse_import_item(tokens, pos)\n      let b = array_builder()\n      array_builder_push(b, first)\n      parse_import_items_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_import_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let (path, bp) = collect_import_path(tokens, pos, \"\")\n  let br = expect_tk(tokens, bp, \"{\")\n  let (items, end) = parse_import_items(tokens, br);\n  (SImport(path, items), end)\n}\n\nlet parse_impl_stmt_dispatch = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  parse_impl_stmt(tokens, pos)\n}\n\nlet rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (array_builder_freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        array_builder_push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (array_builder_freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        array_builder_push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (array_builder_freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), pos + 1),\n    _ => {\n      let (first, next) = parse_struct_field(tokens, pos)\n      let b = array_builder()\n      array_builder_push(b, first)\n      parse_struct_fields_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (fields, end) = parse_struct_fields(tokens, br);\n      (SStruct(exported, name, fields), end)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\nlet parse_export_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TLet => parse_let_stmt(tokens, pos + 1, true),\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\n    TStruct => parse_struct_stmt(tokens, pos + 1, true),\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\n    TOpen => match peek(tokens, pos + 1) {\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\n      _ => throw(\"expected 'trait' after 'open'\")\n    },\n    TLBrace => match peek(tokens, pos + 1) {\n      TRBrace => (SExport(empty_names()), pos + 2),\n      TIdent(name) => {\n        let b = array_builder()\n        array_builder_push(b, name)\n        let (names, end) = parse_export_names_rest(tokens, pos + 2, b);\n        (SExport(names), end)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    _ => throw(string_concat(\"unexpected after 'export': \", tk_name(peek(tokens, pos))))\n  }\n}\n\nlet parse_percent_symbol_name = (tokens: Array[Token], pos: Int, label: String) -> (String, Int)with { Error } {\n  let pp = expect_tk(tokens, pos, \"%\")\n  match peek(tokens, pp) {\n    TIdent(name) => (string_concat(\"%\", name), pp + 1),\n    _ => throw(string_concat(\"expected \", string_concat(label, \" after '%'\")))\n  }\n}\n\nlet parse_extern_let_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let lp = expect_tk(tokens, pos, \"let\")\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \"extern symbol name\")\n  let cp = expect_tk(tokens, np, \":\")\n  let (ty, end) = parse_type_impl(tokens, cp, 0);\n  (SExternLet(name, ty), end)\n}\n\nexport let rec parse_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let rec parse_module_body = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Stmt]) -> (Array[Stmt], Int)with { Error } {\n    match peek(tokens, pos) {\n      TRBrace => (array_builder_freeze(b), pos + 1),\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, pos)\n        array_builder_push(b, stmt)\n        parse_module_body(tokens, next, b)\n      }\n    }\n  }\n  let head = peek(tokens, pos)\n  match head {\n    TLet => parse_let_stmt(tokens, pos + 1, false),\n    TExport => match peek(tokens, pos + 1) {\n      TModule => match peek(tokens, pos + 2) {\n        TIdent(name) => {\n          let br = expect_tk(tokens, pos + 3, \"{\")\n          {\n            let (stmts, end) = parse_module_body(tokens, br, array_builder());\n            (SModule(true, name, stmts), end)\n          }\n        },\n        _ => throw(\"expected module name\")\n      },\n      _ => parse_export_stmt(tokens, pos + 1)\n    },\n    TModule => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let br = expect_tk(tokens, pos + 2, \"{\")\n        {\n          let (stmts, end) = parse_module_body(tokens, br, array_builder());\n          (SModule(false, name, stmts), end)\n        }\n      },\n      _ => throw(\"expected module name\")\n    },\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\n    TStruct => parse_struct_stmt(tokens, pos + 1, false),\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\n    TTest => parse_test_stmt(tokens, pos + 1),\n    TBench => parse_bench_stmt(tokens, pos + 1),\n    TImport => parse_import_stmt(tokens, pos + 1),\n    TIdent(name) => if string_equals(name, \"extern\") {\n      parse_extern_let_stmt(tokens, pos + 1)\n    } else if string_equals(name, \"use\") {\n      throw(\"'use' syntax is removed; use 'import <module-ref> { ... }'\")\n    } else {\n      let (e, next) = parse_impl(tokens, pos, 0);\n      (SExpr(e), next)\n    },\n    _ => {\n      let (e, next) = parse_impl(tokens, pos, 0);\n      (SExpr(e), next)\n    }\n  }\n}\n\nexport let parse_program = (tokens: Array[Token]) -> Array[Stmt] with { Error } {\n  let rec go = (pos: Int, b: ArrayBuilder[Stmt]) -> Array[Stmt] with { Error } {\n    if is_tk(peek(tokens, pos), \"eof\") {\n      array_builder_freeze(b)\n    } else {\n      let (stmt, next) = if is_tk(peek(tokens, pos), \"impl\") {\n        parse_impl_stmt_dispatch(tokens, pos + 1)\n      } else {\n        parse_stmt(tokens, pos)\n      }\n      array_builder_push(b, stmt)\n      go(next, b)\n    }\n  }\n  go(0, array_builder())\n}\n\n//# Misc\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_impl, parse_stmt, parse_type, parse_program\n}\n")
    ,
    ("vibe/compiler/printer.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nlet join = (arr: Array[String], sep: String) -> String {\n  let len = array_length(arr)\n  if len == 0 {\n    \"\"\n  } else {\n    let b = array_builder()\n    let mut i = 0\n    while i < len {\n      if i > 0 {\n        array_builder_push(b, sep)\n      }\n      array_builder_push(b, array_get(arr, i))\n      i = i + 1\n    }\n    string_join(array_builder_freeze(b), \"\")\n  }\n}\n\nlet escape_string = (s: String) -> String {\n  let len = string_length(s)\n  let b = array_builder()\n  let push_chunk = (start: Int, end: Int) -> Unit {\n    if end > start {\n      array_builder_push(b, string_substring(s, start, end))\n    }\n  }\n  let mut i = 0\n  let mut start = 0\n  while i < len {\n    let c = string_char_code_at(s, i)\n    if c == '\"' {\n      push_chunk(start, i)\n      array_builder_push(b, \"\\\\\\\"\")\n      i = i + 1\n      start = i\n    } else if c == '\\\\' {\n      push_chunk(start, i)\n      array_builder_push(b, \"\\\\\\\\\")\n      i = i + 1\n      start = i\n    } else if c == '\\n' {\n      push_chunk(start, i)\n      array_builder_push(b, \"\\\\n\")\n      i = i + 1\n      start = i\n    } else if c == '\\t' {\n      push_chunk(start, i)\n      array_builder_push(b, \"\\\\t\")\n      i = i + 1\n      start = i\n    } else if c == 13 {\n      push_chunk(start, i)\n      array_builder_push(b, \"\\\\r\")\n      i = i + 1\n      start = i\n    } else if c == 0 {\n      push_chunk(start, i)\n      array_builder_push(b, \"\\\\0\")\n      i = i + 1\n      start = i\n    } else {\n      i = i + 1\n    }\n  }\n  push_chunk(start, len)\n  string_join(array_builder_freeze(b), \"\")\n}\n\nexport let rec print_pat = (p: Pat) -> String {\n  match p {\n    PWild => \"_\",\n    PBind(name) => name,\n    PInt(n) => __to_string(n),\n    PString(s) => string_concat(\"\\\"\", string_concat(escape_string(s), \"\\\"\")),\n    PBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    PCtor(name, args) => if array_length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        print_pat(arg)\n      }\n      string_concat(name, string_concat(\"(\", string_concat(join(parts, \", \"), \")\")))\n    },\n    PTuple(elems) => {\n      let parts = for elem in elems {\n        print_pat(elem)\n      }\n      string_concat(\"(\", string_concat(join(parts, \", \"), \")\"))\n    },\n    POr(left, right) => string_concat(print_pat(left), string_concat(\" | \", print_pat(right)))\n  }\n}\n\nlet map_to_strings = (exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {\n  for expr in exprs {\n    f(expr)\n  }\n}\n\nexport let rec print_type_expr = (ty: TypeExpr) -> String {\n  match ty {\n    TyName(name) => name,\n    TyUnit => \"()\",\n    TyApp(name, args) => {\n      let parts = for arg in args {\n        print_type_expr(arg)\n      }\n      string_concat(name, string_concat(\"[\", string_concat(join(parts, \", \"), \"]\")))\n    },\n    TyFn(params, ret) => {\n      let parts = for param in params {\n        print_type_expr(param)\n      }\n      string_concat(\"(\", string_concat(join(parts, \", \"), string_concat(\") -> \", print_type_expr(ret))))\n    },\n    TyTuple(elems) => {\n      let parts = for elem in elems {\n        print_type_expr(elem)\n      }\n      string_concat(\"(\", string_concat(join(parts, \", \"), \")\"))\n    }\n  }\n}\n\nlet print_ctor = (ctor: (String, Array[TypeExpr])) -> String {\n  let (name, args) = ctor\n  if eq(array_length(args), 0) {\n    name\n  }\n  else {\n    let parts = for arg in args {\n      print_type_expr(arg)\n    }\n    string_concat(name, string_concat(\"(\", string_concat(join(parts, \", \"), \")\")))\n  }\n}\n\nexport let rec print_expr = (e: Expr) -> String {\n  match e {\n    EInt(n) => __to_string(n),\n    EFloat(n) => __to_string(n),\n    EString(s) => string_concat(\"\\\"\", string_concat(escape_string(s), \"\\\"\")),\n    EBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    EIdent(name) => name,\n    EUnit => \"()\",\n    ETuple(elems) => string_concat(\"(\", string_concat(join(map_to_strings(elems, print_expr), \", \"), \")\")),\n    EArray(elems) => string_concat(\"[\", string_concat(join(map_to_strings(elems, print_expr), \", \"), \"]\")),\n    ERecord(fields) => {\n      let parts = for field in fields {\n        let (name, val) = field\n        string_concat(name, string_concat(\": \", print_expr(val)))\n      }\n      string_concat(\"{ \", string_concat(join(parts, \", \"), \" }\"))\n    },\n    EIf(cond, then_e, else_e) => match else_e {\n      EUnit => string_concat(\"if \", string_concat(print_expr(cond), string_concat(\" { \", string_concat(print_expr(then_e), \" }\")))),\n      _ => string_concat(\"if \", string_concat(print_expr(cond), string_concat(\" { \", string_concat(print_expr(then_e), string_concat(\" } else { \", string_concat(print_expr(else_e), \" }\"))))))\n    },\n    ELet(name, val, body) => string_concat(\"{ let \", string_concat(name, string_concat(\" = \", string_concat(print_expr(val), string_concat(\"; \", string_concat(print_expr(body), \" }\")))))),\n    ELetRec(name, val, body) => string_concat(\"{ let rec \", string_concat(name, string_concat(\" = \", string_concat(print_expr(val), string_concat(\"; \", string_concat(print_expr(body), \" }\")))))),\n    ELetMut(name, val, body) => string_concat(\"{ let mut \", string_concat(name, string_concat(\" = \", string_concat(print_expr(val), string_concat(\"; \", string_concat(print_expr(body), \" }\")))))),\n    EAssign(name, val, body) => string_concat(\"{ \", string_concat(name, string_concat(\" = \", string_concat(print_expr(val), string_concat(\"; \", string_concat(print_expr(body), \" }\")))))),\n    EAssignOp(name, op, val, body) => string_concat(\"{ \", string_concat(name, string_concat(\" \", string_concat(op, string_concat(\"= \", string_concat(print_expr(val), string_concat(\"; \", string_concat(print_expr(body), \" }\")))))))),\n    ESeq(a, b) => string_concat(\"{ \", string_concat(print_expr(a), string_concat(\"; \", string_concat(print_expr(b), \" }\")))),\n    EMatch(scrutinee, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        string_concat(print_pat(pat), string_concat(\" => \", print_expr(expr)))\n      }\n      string_concat(\"match \", string_concat(print_expr(scrutinee), string_concat(\" { \", string_concat(join(parts, \", \"), \" }\"))))\n    },\n    EHandle(body, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        string_concat(print_pat(pat), string_concat(\" => \", print_expr(expr)))\n      }\n      string_concat(\"handle { \", string_concat(print_expr(body), string_concat(\" } { \", string_concat(join(parts, \", \"), \" }\"))))\n    },\n    EWhile(cond, body) => string_concat(\"while \", string_concat(print_expr(cond), string_concat(\" { \", string_concat(print_expr(body), \" }\")))),\n    EForIn(name, iterable, body) => string_concat(\"for \", string_concat(name, string_concat(\" in \", string_concat(print_expr(iterable), string_concat(\" { \", string_concat(print_expr(body), \" }\")))))),\n    ECall(callee, args) => string_concat(print_expr(callee), string_concat(\"(\", string_concat(join(map_to_strings(args, print_expr), \", \"), \")\"))),\n    EBinOp(op, left, right) => string_concat(\"(\", string_concat(print_expr(left), string_concat(\" \", string_concat(op, string_concat(\" \", string_concat(print_expr(right), \")\")))))),\n    EUnaryOp(op, expr) => string_concat(\"(\", string_concat(op, string_concat(print_expr(expr), \")\"))),\n    EFn(_, _, params, ret_ty, effect, body) => {\n      let parts = for param in params {\n        let (name, ty_opt) = param\n        match ty_opt {\n          Some(ty) => string_concat(name, string_concat(\": \", print_type_expr(ty))),\n          None => name\n        }\n      }\n      let ret_str = match ret_ty {\n        Some(rt) => {\n          let eff_str = match effect {\n            Some(e) => string_concat(\" with {\", string_concat(e, \"}\")),\n            None => \"\"\n          }\n          string_concat(\") -> \", string_concat(print_type_expr(rt), string_concat(eff_str, string_concat(\" { \", string_concat(print_expr(body), \" }\")))))\n        },\n        None => string_concat(\") -> \", print_expr(body))\n      }\n      string_concat(\"(\", string_concat(join(parts, \", \"), ret_str))\n    },\n    EDot(expr, field) => string_concat(print_expr(expr), string_concat(\".\", field)),\n    EThrow(e) => string_concat(\"throw(\", string_concat(print_expr(e), \")\")),\n    EBreak(opt) => match opt {\n      None => \"break\",\n      Some(v) => string_concat(\"break \", print_expr(v))\n    },\n    EContinue(args) => if eq(array_length(args), 0) {\n      \"continue\"\n    } else string_concat(\"continue(\", string_concat(join(map_to_strings(args, print_expr), \", \"), \")\")),\n    ELabeledArg(name, _modifier, val) => string_concat(name, string_concat(\"=\", print_expr(val)))\n  }\n}\n\nlet print_ctor_list = (ctors: Array[(String, Array[TypeExpr])]) -> String {\n  let parts = for ctor in ctors {\n    print_ctor(ctor)\n  }\n  join(parts, \"; \")\n}\n\nexport let rec print_stmt = (s: Stmt) -> String {\n  let prefix = (exported: Bool) -> String {\n    if exported {\n      \"export \"\n    } else \"\"\n  }\n  match s {\n    SLet(exported, is_rec, name, ty_opt, val) => {\n      let p = prefix(exported)\n      let r = if is_rec {\n        \"let rec \"\n      } else \"let \"\n      let t = match ty_opt {\n        Some(ty) => string_concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      string_concat(p, string_concat(r, string_concat(name, string_concat(t, string_concat(\" = \", print_expr(val))))))\n    },\n    SLetMut(name, ty_opt, val) => {\n      let t = match ty_opt {\n        Some(ty) => string_concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      string_concat(\"let mut \", string_concat(name, string_concat(t, string_concat(\" = \", print_expr(val)))))\n    },\n    SEnum(exported, name, ctors) => string_concat(prefix(exported), string_concat(\"enum \", string_concat(name, string_concat(\" { \", string_concat(print_ctor_list(ctors), \" }\"))))),\n    SSuberror(exported, name, ctors) => {\n      let p = prefix(exported)\n      if eq(array_length(ctors), 1) {\n        let (ctor_name, ctor_args) = array_get(ctors, 0)\n        if string_equals(ctor_name, name) {\n          let parts = for arg in ctor_args {\n            print_type_expr(arg)\n          }\n          string_concat(p, string_concat(\"suberror \", string_concat(name, string_concat(\"(\", string_concat(join(parts, \", \"), \")\")))))\n        }\n        else string_concat(p, string_concat(\"suberror \", string_concat(name, string_concat(\" { \", string_concat(print_ctor_list(ctors), \" }\")))))\n      } else string_concat(p, string_concat(\"suberror \", string_concat(name, string_concat(\" { \", string_concat(print_ctor_list(ctors), \" }\")))))\n    },\n    SStruct(exported, name, fields) => {\n      let parts = for field in fields {\n        let (fn1, ty) = field\n        string_concat(fn1, string_concat(\": \", print_type_expr(ty)))\n      }\n      string_concat(prefix(exported), string_concat(\"struct \", string_concat(name, string_concat(\" { \", string_concat(join(parts, \"; \"), \" }\")))))\n    },\n    STypeAlias(exported, name, ty) => string_concat(prefix(exported), string_concat(\"type \", string_concat(name, string_concat(\" = \", print_type_expr(ty))))),\n    STrait(exported, name, supers) => {\n      let base = string_concat(prefix(exported), string_concat(\"trait \", name))\n      if eq(array_length(supers), 0) {\n        base\n      }\n      else string_concat(base, string_concat(\": \", join(supers, \" + \")))\n    },\n    SImpl(tparams, _, trait_name, type_name) => {\n      let base = string_concat(\"impl \", string_concat(trait_name, string_concat(\" for \", type_name)))\n      if eq(array_length(tparams), 0) {\n        base\n      }\n      else string_concat(\"[\", string_concat(join(tparams, \", \"), string_concat(\"] \", base)))\n    },\n    SExternLet(name, ty) => string_concat(\"extern let \", string_concat(name, string_concat(\": \", print_type_expr(ty)))),\n    SImport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => string_concat(name, string_concat(\" as \", a)),\n          None => name\n        }\n      }\n      string_concat(\"import \", string_concat(path, string_concat(\" { \", string_concat(join(parts, \", \"), \" }\"))))\n    },\n    STest(name, body) => string_concat(\"test \\\"\", string_concat(name, string_concat(\"\\\" { \", string_concat(print_expr(body), \" }\")))),\n    SBench(name, body) => string_concat(\"bench \\\"\", string_concat(name, string_concat(\"\\\" { \", string_concat(print_expr(body), \" }\")))),\n    SExpr(e) => print_expr(e),\n    SExport(names) => string_concat(\"export { \", string_concat(join(names, \", \"), \" }\")),\n    SReExport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => string_concat(name, string_concat(\" as \", a)),\n          None => name\n        }\n      }\n      string_concat(\"export \", string_concat(path, string_concat(\" { \", string_concat(join(parts, \", \"), \" }\"))))\n    },\n    SModule(exported, name, stmts) => {\n      let parts = for s in stmts {\n        print_stmt(s)\n      }\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      string_concat(p, string_concat(\"module \", string_concat(name, string_concat(\" { \", string_concat(join(parts, \"\\n\"), \" }\")))))\n    }\n  }\n}\n\nexport let print_program = (stmts: Array[Stmt]) -> String {\n  let parts = for s in stmts {\n    print_stmt(s)\n  }\n  join(parts, \"\\n\")\n}\n")
    ,
    ("vibe/compiler/builtins.vibe",
"//# Imports\n\nimport ./types.vibe {\n  Type\n}\n\n//# Functions\n\nlet no_params = () -> Array[Type] {\n  array_slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet lookup_map = (name: String) -> Option[Type] {\n  if string_equals(name, \"map_builder\") {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if string_equals(name, \"map_builder_set\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"map_builder_freeze\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnknown, false))\n  }\n  else if string_equals(name, \"map_get\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtUnknown, false))\n  }\n  else if string_equals(name, \"map_has\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtBool, false))\n  }\n  else if string_equals(name, \"map_keys\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtArray(CtString), false))\n  }\n  else None\n}\n\nlet lookup_misc = (name: String) -> Option[Type] {\n  if string_equals(name, \"eq\") {\n    Some(CtFn([\n      CtInt,\n      CtInt\n    ], CtBool, false))\n  }\n  else if string_equals(name, \"not\") {\n    Some(CtFn([\n      CtBool\n    ], CtBool, false))\n  }\n  else if string_equals(name, \"__to_string\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else if string_equals(name, \"print\") {\n    Some(CtFn([\n      CtString\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"println\") {\n    Some(CtFn([\n      CtString\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"assert\") {\n    Some(CtFn([\n      CtBool\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"throw\") {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, true))\n  }\n  else if string_equals(name, \"int_to_double\") {\n    Some(CtFn([\n      CtInt\n    ], CtDouble, false))\n  }\n  else if string_equals(name, \"double_to_int\") {\n    Some(CtFn([\n      CtDouble\n    ], CtInt, false))\n  }\n  else if string_equals(name, \"double_to_i64_bits\") {\n    Some(CtFn([\n      CtDouble\n    ], CtInt, false))\n  }\n  else if string_equals(name, \"i64_bits_to_double\") {\n    Some(CtFn([\n      CtInt\n    ], CtDouble, false))\n  }\n  else None\n}\n\nlet lookup_array = (name: String) -> Option[Type] {\n  if string_equals(name, \"array_length\") {\n    Some(CtFn([\n      CtArray(CtUnknown)\n    ], CtInt, false))\n  }\n  else if string_equals(name, \"array_get\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt\n    ], CtUnknown, false))\n  }\n  else if string_equals(name, \"array_set\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"array_push\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"array_slice\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtInt\n    ], CtArray(CtUnknown), false))\n  }\n  else if string_equals(name, \"array_concat\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtArray(CtUnknown)\n    ], CtArray(CtUnknown), false))\n  }\n  else None\n}\n\nlet lookup_bytes = (name: String) -> Option[Type] {\n  if string_equals(name, \"bytes_new\") {\n    Some(CtFn(no_params(), CtBytes, false))\n  }\n  else if string_equals(name, \"bytes_length\") {\n    Some(CtFn([\n      CtBytes\n    ], CtInt, false))\n  }\n  else if string_equals(name, \"bytes_get\") {\n    Some(CtFn([\n      CtBytes,\n      CtInt\n    ], CtInt, false))\n  }\n  else if string_equals(name, \"bytes_set\") {\n    Some(CtFn([\n      CtBytes,\n      CtInt,\n      CtInt\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"bytes_push\") {\n    Some(CtFn([\n      CtBytes,\n      CtInt\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"bytes_concat\") {\n    Some(CtFn([\n      CtBytes,\n      CtBytes\n    ], CtBytes, false))\n  }\n  else if string_equals(name, \"bytes_slice\") {\n    Some(CtFn([\n      CtBytes,\n      CtInt,\n      CtInt\n    ], CtBytes, false))\n  }\n  else if string_equals(name, \"bytes_from_array\") {\n    Some(CtFn([\n      CtArray(CtInt)\n    ], CtBytes, false))\n  }\n  else if string_equals(name, \"bytes_to_array\") {\n    Some(CtFn([\n      CtBytes\n    ], CtArray(CtInt), false))\n  }\n  else None\n}\n\nlet lookup_string1 = (name: String) -> Option[Type] {\n  if string_equals(name, \"string_concat\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, false))\n  }\n  else if string_equals(name, \"string_length\") {\n    Some(CtFn([\n      CtString\n    ], CtInt, false))\n  }\n  else if string_equals(name, \"string_equals\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if string_equals(name, \"string_substring\") {\n    Some(CtFn([\n      CtString,\n      CtInt,\n      CtInt\n    ], CtString, false))\n  }\n  else if string_equals(name, \"string_char_at\") {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtString, false))\n  }\n  else None\n}\n\nlet lookup_string2 = (name: String) -> Option[Type] {\n  if string_equals(name, \"string_index_of\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtInt, false))\n  }\n  else if string_equals(name, \"string_contains\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if string_equals(name, \"string_starts_with\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if string_equals(name, \"string_ends_with\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if string_equals(name, \"string_from_char_code\") {\n    Some(CtFn([\n      CtInt\n    ], CtString, false))\n  }\n  else if string_equals(name, \"string_char_code_at\") {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtInt, false))\n  }\n  else if string_equals(name, \"string_last_index_of\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtInt, false))\n  }\n  else None\n}\n\nlet lookup_array_builder = (name: String) -> Option[Type] {\n  if string_equals(name, \"array_builder\") {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if string_equals(name, \"array_builder_push\") {\n    Some(CtFn([\n      CtUnknown,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"array_builder_freeze\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtArray(CtUnknown), false))\n  }\n  else None\n}\n\nlet lookup_string_builder = (name: String) -> Option[Type] {\n  if string_equals(name, \"string_builder\") {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if string_equals(name, \"string_builder_push\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtUnit, false))\n  }\n  else if string_equals(name, \"string_builder_freeze\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else None\n}\n\nlet lookup_io = (name: String) -> Option[Type] {\n  if string_equals(name, \"sh\") {\n    Some(CtFn([CtString], CtString, true))\n  }\n  else if string_equals(name, \"sh_lines\") {\n    Some(CtFn([CtString], CtArray(CtString), true))\n  }\n  else if string_equals(name, \"path\") {\n    Some(CtFn([CtString], CtUnknown, false))\n  }\n  else if string_equals(name, \"path_to_string\") {\n    Some(CtFn([CtUnknown], CtString, false))\n  }\n  else if string_equals(name, \"path_is_absolute\") {\n    Some(CtFn([CtString], CtBool, false))\n  }\n  else if string_equals(name, \"prompt_text\") {\n    Some(CtFn([CtString], CtString, false))\n  }\n  else if string_equals(name, \"stdin_read_char\") {\n    Some(CtFn(no_params(), CtInt, true))\n  }\n  else if string_equals(name, \"stdin_read_stream\") {\n    Some(CtFn(no_params(), CtString, true))\n  }\n  else if string_equals(name, \"stdout_write_char\") {\n    Some(CtFn([CtInt], CtUnit, false))\n  }\n  else if string_equals(name, \"stdout_write_stream\") {\n    Some(CtFn([CtString], CtUnit, false))\n  }\n  else if string_equals(name, \"env_get\") {\n    Some(CtFn([CtString], CtString, true))\n  }\n  else if string_equals(name, \"sleep\") {\n    Some(CtFn([CtInt], CtUnit, false))\n  }\n  else if string_equals(name, \"dynamic_path_resolve\") {\n    Some(CtFn([CtString], CtString, false))\n  }\n  else None\n}\n\nlet lookup_fs = (name: String) -> Option[Type] {\n  if string_equals(name, \"fs_read_file\") {\n    Some(CtFn([CtString], CtString, true))\n  }\n  else if string_equals(name, \"fs_write_file\") {\n    Some(CtFn([CtString, CtString], CtUnit, true))\n  }\n  else if string_equals(name, \"fs_read_bytes\") {\n    Some(CtFn([CtString], CtBytes, true))\n  }\n  else if string_equals(name, \"fs_write_bytes\") {\n    Some(CtFn([CtString, CtBytes], CtUnit, true))\n  }\n  else if string_equals(name, \"fs_exists\") {\n    Some(CtFn([CtString], CtBool, true))\n  }\n  else if string_equals(name, \"fs_readdir\") {\n    Some(CtFn([CtString], CtArray(CtString), true))\n  }\n  else if string_equals(name, \"fs_is_dir\") {\n    Some(CtFn([CtString], CtBool, true))\n  }\n  else if string_equals(name, \"fs_is_file\") {\n    Some(CtFn([CtString], CtBool, true))\n  }\n  else if string_equals(name, \"fs_mkdir\") {\n    Some(CtFn([CtString], CtUnit, true))\n  }\n  else if string_equals(name, \"fs_getcwd\") {\n    Some(CtFn(no_params(), CtString, true))\n  }\n  else if string_equals(name, \"fs_chdir\") {\n    Some(CtFn([CtString], CtUnit, true))\n  }\n  else if string_equals(name, \"fs_remove\") {\n    Some(CtFn([CtString], CtUnit, true))\n  }\n  else if string_equals(name, \"fs_copy\") {\n    Some(CtFn([CtString, CtString], CtUnit, true))\n  }\n  else if string_equals(name, \"fs_append\") {\n    Some(CtFn([CtString, CtString], CtUnit, true))\n  }\n  else None\n}\n\nlet lookup_net = (name: String) -> Option[Type] {\n  if string_equals(name, \"socket_tcp_connect\") {\n    Some(CtFn([CtString, CtInt], CtUnknown, true))\n  }\n  else if string_equals(name, \"socket_tcp_read\") {\n    Some(CtFn([CtUnknown, CtInt], CtString, true))\n  }\n  else if string_equals(name, \"socket_tcp_write\") {\n    Some(CtFn([CtUnknown, CtString], CtInt, true))\n  }\n  else if string_equals(name, \"socket_tcp_close\") {\n    Some(CtFn([CtUnknown], CtUnit, true))\n  }\n  else if string_equals(name, \"http_request\") {\n    Some(CtFn([CtString, CtString], CtUnknown, true))\n  }\n  else if string_equals(name, \"http_response_status\") {\n    Some(CtFn([CtUnknown], CtInt, false))\n  }\n  else if string_equals(name, \"http_response_header\") {\n    Some(CtFn([CtUnknown, CtString], CtString, false))\n  }\n  else if string_equals(name, \"http_response_body\") {\n    Some(CtFn([CtUnknown], CtString, true))\n  }\n  else if string_equals(name, \"http_close\") {\n    Some(CtFn([CtUnknown], CtUnit, false))\n  }\n  else if string_equals(name, \"http_listen\") {\n    Some(CtFn([CtString, CtInt], CtUnknown, true))\n  }\n  else if string_equals(name, \"http_accept\") {\n    Some(CtFn([CtUnknown], CtUnknown, true))\n  }\n  else if string_equals(name, \"http_request_method\") {\n    Some(CtFn([CtUnknown], CtString, false))\n  }\n  else if string_equals(name, \"http_request_header\") {\n    Some(CtFn([CtUnknown, CtString], CtString, false))\n  }\n  else if string_equals(name, \"http_respond\") {\n    Some(CtFn([CtUnknown, CtInt, CtString], CtUnit, true))\n  }\n  else None\n}\n\nexport let lookup_builtin = (name: String) -> Option[Type] {\n  match lookup_array(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_builder(name) {\n      Some(t) => Some(t),\n      None => match lookup_string1(name) {\n        Some(t) => Some(t),\n        None => match lookup_string2(name) {\n          Some(t) => Some(t),\n          None => match lookup_string_builder(name) {\n            Some(t) => Some(t),\n            None => match lookup_bytes(name) {\n              Some(t) => Some(t),\n              None => match lookup_map(name) {\n                Some(t) => Some(t),\n                None => match lookup_io(name) {\n                  Some(t) => Some(t),\n                  None => match lookup_fs(name) {\n                    Some(t) => Some(t),\n                    None => match lookup_net(name) {\n                      Some(t) => Some(t),\n                      None => lookup_misc(name)\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n")
    ,
    ("vibe/compiler/checker_resolve.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./types.vibe {\n  Type, TypeDef, find_typedef, resolve_builtin\n}\n\n//# Functions\n\nexport let rec resolve_type_expr = (te: TypeExpr, defs: Array[TypeDef]) -> Type {\n  match te {\n    TyUnit => CtUnit,\n    TyName(name) => match resolve_builtin(name) {\n      Some(t) => t,\n      None => match find_typedef(defs, name) {\n        Some(td) => match td {\n          TDEnum(n, _) => CtEnum(n),\n          TDStruct(n, _) => CtStruct(n),\n          TDAlias(_, t) => t\n        },\n        None => CtNamed(name, array_slice([\n          CtUnknown\n        ], 0, 0))\n      }\n    }\n    ,\n    TyApp(name, args) => {\n      let ra = for a in args {\n        resolve_type_expr(a, defs)\n      }\n      if string_equals(name, \"Array\") {\n        if array_length(ra) == 1 {\n          CtArray(array_get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else if string_equals(name, \"Option\") {\n        if array_length(ra) == 1 {\n          CtOption(array_get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else CtNamed(name, ra)\n    },\n    TyTuple(elems) => {\n      let r = for e in elems {\n        resolve_type_expr(e, defs)\n      }\n      CtTuple(r)\n    },\n    TyFn(params, ret) => {\n      let rp = for p in params {\n        resolve_type_expr(p, defs)\n      }\n      CtFn(rp, resolve_type_expr(ret, defs), false)\n    }\n  }\n}\n")
    ,
    ("vibe/compiler/checker_pattern.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Pat\n}\n\nimport ./types.vibe {\n  Type, TypeDef, TypeEnv, env_bind, find_typedef\n}\n\n//# Functions\n\n// Find constructor in defs: returns (enum_name, payload_types) or None\nlet find_ctor_in_defs = (defs: Array[TypeDef], ctor_name: String) -> Option[(String, Array[Type])] {\n  let dlen = array_length(defs)\n  let rec go_defs = (di: Int) -> Option[(String, Array[Type])] {\n    if di >= dlen {\n      None\n    } else {\n      let d = array_get(defs, di)\n      match d {\n        TDEnum(enum_name, variants) => {\n          let vlen = array_length(variants)\n          let rec go_variants = (vi: Int) -> Option[(String, Array[Type])] {\n            if vi >= vlen {\n              go_defs(di + 1)\n            } else {\n              let (vname, vtypes) = array_get(variants, vi)\n              if string_equals(vname, ctor_name) {\n                Some((enum_name, vtypes))\n              } else {\n                go_variants(vi + 1)\n              }\n            }\n          }\n          go_variants(0)\n        },\n        _ => go_defs(di + 1)\n      }\n    }\n  }\n  go_defs(0)\n}\n\n// Check a pattern against a scrutinee type, returning extended env with bindings\nexport let rec check_pattern = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {\n  match pat {\n    PWild => env,\n    PBind(name) => env_bind(env, name, scrutinee_ty),\n    PInt(_) => env,\n    PString(_) => env,\n    PBool(_) => env,\n    PCtor(name, sub_pats) => {\n      match find_ctor_in_defs(defs, name) {\n        Some(info) => {\n          let (_, payload_types) = info\n          let splen = array_length(sub_pats)\n          let ptlen = array_length(payload_types)\n          let rec bind_subs = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n            if i >= splen {\n              acc_env\n            } else {\n              let sub_ty = if i < ptlen {\n                array_get(payload_types, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(array_get(sub_pats, i), sub_ty, acc_env, defs)\n              bind_subs(i + 1, next_env)\n            }\n          }\n          bind_subs(0, env)\n        },\n        None => {\n          // Unknown constructor: bind sub-patterns to CtUnknown\n          let splen = array_length(sub_pats)\n          let rec bind_unknown = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n            if i >= splen {\n              acc_env\n            } else {\n              let next_env = check_pattern(array_get(sub_pats, i), CtUnknown, acc_env, defs)\n              bind_unknown(i + 1, next_env)\n            }\n          }\n          bind_unknown(0, env)\n        }\n      }\n    },\n    PTuple(pats) => {\n      let plen = array_length(pats)\n      match scrutinee_ty {\n        CtTuple(elem_tys) => {\n          let elen = array_length(elem_tys)\n          let rec bind_tuple = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n            if i >= plen {\n              acc_env\n            } else {\n              let et = if i < elen {\n                array_get(elem_tys, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(array_get(pats, i), et, acc_env, defs)\n              bind_tuple(i + 1, next_env)\n            }\n          }\n          bind_tuple(0, env)\n        },\n        _ => {\n          // Scrutinee not a tuple: bind all to CtUnknown\n          let rec bind_unk = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n            if i >= plen {\n              acc_env\n            } else {\n              let next_env = check_pattern(array_get(pats, i), CtUnknown, acc_env, defs)\n              bind_unk(i + 1, next_env)\n            }\n          }\n          bind_unk(0, env)\n        }\n      }\n    },\n    POr(left, _right) => {\n      // Check left side; both should produce same bindings, return left's\n      check_pattern(left, scrutinee_ty, env, defs)\n    }\n  }\n}\n")
    ,
    ("vibe/compiler/checker.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./builtins.vibe {\n  lookup_builtin\n}\n\nimport ./checker_pattern.vibe {\n  check_pattern\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\nimport ./types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, type_implements_trait, unify\n}\n\n//# Functions\n\nlet min_int = (a: Int, b: Int) -> Int {\n  if a < b {\n    a\n  } else {\n    b\n  }\n}\n\nlet is_bool_binop = (op: String) -> Bool {\n  string_equals(op, \"==\")\n  || string_equals(op, \"!=\")\n  || string_equals(op, \"<\")\n  || string_equals(op, \">\")\n  || string_equals(op, \"<=\")\n  || string_equals(op, \">=\")\n  || string_equals(op, \"&&\")\n  || string_equals(op, \"||\")\n}\n\nexport let rec check_expr = (expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int) -> (Type, Subst, Int) {\n  match expr {\n    EInt(_) => (CtInt, s, c),\n    EFloat(_) => (CtDouble, s, c),\n    EString(_) => (CtString, s, c),\n    EBool(_) => (CtBool, s, c),\n    EUnit => (CtUnit, s, c),\n    EIdent(name) => match env_lookup(env, name) {\n      Some(t) => {\n        let (ti, c1, new_bounds) = instantiate(t, c)\n        let nblen = array_length(new_bounds)\n        let mut s1 = s\n        let mut bi = 0\n        while bi < nblen {\n          let (vid, bounds) = array_get(new_bounds, bi)\n          if !eq(array_length(bounds), 0) {\n            s1 = subst_add_bound(s1, vid, bounds)\n          }\n          bi = bi + 1\n        }\n        (ti, s1, c1)\n      },\n      None => match lookup_builtin(name) {\n        Some(t) => (t, s, c),\n        None => (CtUnknown, s, c)\n      }\n    }\n    ,\n    ESeq(left, right) => {\n      let (_, s1, c1) = check_expr(left, env, defs, s, c)\n      check_expr(right, env, defs, s1, c1)\n    },\n    ELet(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c)\n      let gen = generalize(s1, vt)\n      check_expr(body, env_bind(env, name, gen), defs, s1, c1)\n    },\n    ELetRec(name, val, body) => {\n      let (tv, c1) = fresh_var(c)\n      let (vt, s1, c2) = check_expr(val, env_bind(env, name, tv), defs, s, c1)\n      let s2 = match unify(tv, vt, s1) {\n        Some(su) => su,\n        None => s1\n      }\n      let gen = generalize(s2, tv)\n      check_expr(body, env_bind(env, name, gen), defs, s2, c2)\n    },\n    ELetMut(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env_bind(env, name, vt), defs, s1, c1)\n    },\n    EIf(cond, then_e, else_e) => {\n      let (_, s1, c1) = check_expr(cond, env, defs, s, c)\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1)\n      let (_, s3, c3) = check_expr(else_e, env, defs, s2, c2)\n      (tt, s3, c3)\n    },\n    ECall(callee, args) => {\n      let (ct, s1, c1) = check_expr(callee, env, defs, s, c)\n      let alen = array_length(args)\n      let arg_tys = array_slice([\n        CtUnknown\n      ], 0, 0)\n      let mut ai = 0\n      let mut s2 = s1\n      let mut c2 = c1\n      while ai < alen {\n        let (at, ns, nc) = check_expr(array_get(args, ai), env, defs, s2, c2)\n        array_push(arg_tys, at)\n        s2 = ns\n        c2 = nc\n        ai = ai + 1\n      }\n      match subst_apply(s2, ct) {\n        CtFn(param_tys, ret, _) => {\n          let mut s3 = s2\n          let mut ui = 0\n          let ul = min_int(array_length(arg_tys), array_length(param_tys))\n          while ui < ul {\n            s3 = match unify(array_get(param_tys, ui), array_get(arg_tys, ui), s3) {\n              Some(su) => su,\n              None => s3\n            }\n            ui = ui + 1\n          }\n          (subst_apply(s3, ret), s3, c2)\n        },\n        CtStruct(sname) => (CtStruct(sname), s2, c2),\n        _ => (CtUnknown, s2, c2)\n      }\n    },\n    EBinOp(op, left, right) => {\n      let (_, s1, c1) = check_expr(left, env, defs, s, c)\n      let (_, s2, c2) = check_expr(right, env, defs, s1, c1)\n      if is_bool_binop(op) {\n        (CtBool, s2, c2)\n      }\n      else (CtInt, s2, c2)\n    },\n    EUnaryOp(op, operand) => {\n      let (_, s1, c1) = check_expr(operand, env, defs, s, c)\n      if string_equals(op, \"!\") {\n        (CtBool, s1, c1)\n      } else (CtInt, s1, c1)\n    },\n    EAssign(_, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env, defs, s1, c1)\n    },\n    EAssignOp(_, _, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env, defs, s1, c1)\n    },\n    EMatch(scrutinee, arms) => {\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c)\n      let alen = array_length(arms)\n      if eq(alen, 0) {\n        (CtUnknown, s1, c1)\n      }\n      else {\n        let mut result_ty = CtUnknown\n        let mut si = s1\n        let mut ci = c1\n        let mut ai = 0\n        while ai < alen {\n          let (pat, body) = array_get(arms, ai)\n          let arm_env = check_pattern(pat, scr_ty, env, defs)\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci)\n          if eq(ai, 0) {\n            result_ty = arm_ty\n          }\n          si = ns\n          ci = nc\n          ai = ai + 1\n        }\n        (result_ty, si, ci)\n      }\n    },\n    EHandle(body, _) => check_expr(body, env, defs, s, c),\n    EWhile(cond, body) => {\n      let (_, s1, c1) = check_expr(cond, env, defs, s, c)\n      let (_, s2, c2) = check_expr(body, env, defs, s1, c1)\n      (CtUnit, s2, c2)\n    },\n    EForIn(name, iterable, body) => {\n      let (it, s1, c1) = check_expr(iterable, env, defs, s, c)\n      let et = match it {\n        CtArray(elem) => elem,\n        _ => CtUnknown\n      }\n      let (bt, s2, c2) = check_expr(body, env_bind(env, name, et), defs, s1, c1)\n      (CtArray(bt), s2, c2)\n    },\n    EDot(obj, field) => {\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c)\n      let resolved = subst_apply(s1, obj_ty)\n      let field_ty = match resolved {\n        CtStruct(sname) => match find_typedef(defs, sname) {\n          Some(td) => match td {\n            TDStruct(_, fields) => {\n              let rec find_field = (i: Int) -> Type {\n                if i >= array_length(fields) {\n                  CtUnknown\n                } else {\n                  let (fname, ftype) = array_get(fields, i)\n                  if string_equals(fname, field) {\n                    ftype\n                  } else find_field(i + 1)\n                }\n              }\n              find_field(0)\n            },\n            _ => CtUnknown\n          },\n          None => CtUnknown\n        },\n        _ => CtUnknown\n      }\n      (field_ty, s1, c1)\n    },\n    EFn(tparams, tbounds, params, _, effect, body) => {\n      let he = match effect {\n        Some(_) => true,\n        None => false\n      }\n      // Allocate fresh vars for type params\n      let tplen = array_length(tparams)\n      let rec alloc_tparams = (i: Int, acc_env: TypeEnv, acc_s: Subst, acc_c: Int) -> (TypeEnv, Subst, Int) {\n        if i >= tplen {\n          (acc_env, acc_s, acc_c)\n        }\n        else {\n          let tpname = array_get(tparams, i)\n          let (tv, nc) = fresh_var(acc_c)\n          let vid = nc - 1\n          // Find bounds for this type param\n          let tblen = array_length(tbounds)\n          let rec find_bounds = (j: Int) -> Array[String] {\n            if j >= tblen {\n              array_slice([\n                \"\"\n              ], 0, 0)\n            }\n            else {\n              let (bname, blist) = array_get(tbounds, j)\n              if string_equals(bname, tpname) {\n                blist\n              }\n              else find_bounds(j + 1)\n            }\n          }\n          let bounds = find_bounds(0)\n          let ns = if eq(array_length(bounds), 0) {\n            acc_s\n          }\n          else subst_add_bound(acc_s, vid, bounds)\n          alloc_tparams(i + 1, env_bind(acc_env, tpname, tv), ns, nc)\n        }\n      }\n      let (tp_env, s0, c0) = alloc_tparams(0, env, s, c)\n      let plen = array_length(params)\n      let mut fn_env = tp_env\n      let mut s1 = s0\n      let mut c1 = c0\n      let param_types = array_slice([\n        CtUnknown\n      ], 0, 0)\n      let mut pi = 0\n      while pi < plen {\n        let (name, ann) = array_get(params, pi)\n        let (pt, ns, nc) = match ann {\n          Some(te) => {\n            let resolved = resolve_type_expr(te, defs)\n            let pt2 = match resolved {\n              CtNamed(tn, _) => match env_lookup(fn_env, tn) {\n                Some(t) => t,\n                None => resolved\n              },\n              _ => resolved\n            }\n            (pt2, s1, c1)\n          },\n          None => {\n            let (tv, nc2) = fresh_var(c1)\n            (tv, s1, nc2)\n          }\n        }\n        fn_env = env_bind(fn_env, name, pt)\n        array_push(param_types, pt)\n        s1 = ns\n        c1 = nc\n        pi = pi + 1\n      }\n      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1)\n      let resolved_params = for p in param_types {\n        subst_apply(s2, p)\n      }\n      let resolved_ret = subst_apply(s2, bt)\n      (CtFn(resolved_params, resolved_ret, he), s2, c2)\n    },\n    EBreak(opt) => match opt {\n      Some(e) => {\n        let (_, s1, c1) = check_expr(e, env, defs, s, c)\n        (CtUnit, s1, c1)\n      },\n      None => (CtUnit, s, c)\n    }\n    ,\n    EContinue(args) => {\n      let alen = array_length(args)\n      let mut s1 = s\n      let mut c1 = c\n      let mut ai = 0\n      while ai < alen {\n        let (_, ns, nc) = check_expr(array_get(args, ai), env, defs, s1, c1)\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtUnit, s1, c1)\n    },\n    ERecord(fields) => {\n      let flen = array_length(fields)\n      let mut s1 = s\n      let mut c1 = c\n      let mut fi = 0\n      while fi < flen {\n        let (_, fval) = array_get(fields, fi)\n        let (_, ns, nc) = check_expr(fval, env, defs, s1, c1)\n        s1 = ns\n        c1 = nc\n        fi = fi + 1\n      }\n      (CtUnknown, s1, c1)\n    },\n    ETuple(items) => {\n      let ilen = array_length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let tys = array_slice([CtUnknown], 0, 0)\n      let mut ti = 0\n      while ti < ilen {\n        let (it, ns, nc) = check_expr(array_get(items, ti), env, defs, s1, c1)\n        array_push(tys, it)\n        s1 = ns\n        c1 = nc\n        ti = ti + 1\n      }\n      (CtTuple(tys), s1, c1)\n    },\n    EArray(items) => {\n      let ilen = array_length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let mut elem_ty = CtUnknown\n      let mut ai = 0\n      while ai < ilen {\n        let (it, ns, nc) = check_expr(array_get(items, ai), env, defs, s1, c1)\n        if eq(ai, 0) {\n          elem_ty = it\n        }\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtArray(elem_ty), s1, c1)\n    },\n    _ => (CtUnknown, s, c)\n  }\n}\n")
    ,
    ("vibe/compiler/checker_stmt.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./checker.vibe {\n  check_expr\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\nimport ./types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_flat_bindings, env_lookup_flat, generalize, impls_overlap_for, resolve_builtin, subst_apply, trait_defined\n}\n\n//# Functions\n\nlet rec import_cache_lookup = (cache: Array[(String, Type)], name: String, i: Int) -> Option[Type] {\n  if i >= array_length(cache) {\n    None\n  }\n  else {\n    let (cached_name, cached_ty) = array_get(cache, i)\n    if string_equals(cached_name, name) {\n      Some(cached_ty)\n    }\n    else import_cache_lookup(cache, name, i + 1)\n  }\n}\n\nexport let rec check_stmts = (stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int) -> (TypeEnv, Subst, Int) {\n  if i >= array_length(stmts) {\n    (env, s, c)\n  } else {\n    let stmt = array_get(stmts, i)\n    let (new_env, s1, c1) = match stmt {\n      SLet(_, is_rec, name, ann, val) => {\n        let (vt, ns, nc) = if is_rec {\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c)\n        } else {\n          check_expr(val, env, defs, s, c)\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => generalize(ns, vt)\n        }\n        (env_bind(env, name, t), ns, nc)\n      },\n      SLetMut(name, ann, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c)\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => vt\n        }\n        (env_bind(env, name, t), ns, nc)\n      },\n      SEnum(_, name, variants) => {\n        // Resolve variants and register TDEnum in defs\n        let resolved_variants = array_slice([\n          (\"\", array_slice([CtUnknown], 0, 0))\n        ], 0, 0)\n        let mut vi = 0\n        while vi < array_length(variants) {\n          let (vname, vtypes) = array_get(variants, vi)\n          let resolved_vtypes = array_slice([CtUnknown], 0, 0)\n          let mut ti = 0\n          while ti < array_length(vtypes) {\n            let vt = resolve_type_expr(array_get(vtypes, ti), defs)\n            array_push(resolved_vtypes, vt)\n            ti = ti + 1\n          }\n          array_push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        array_push(defs, TDEnum(name, resolved_variants))\n        // Bind enum type name\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        // Bind each variant constructor\n        let mut ci2 = 0\n        while ci2 < array_length(variants) {\n          let (vname, vtypes) = array_get(variants, ci2)\n          if eq(array_length(vtypes), 0) {\n            env1 = env_bind(env1, vname, CtEnum(name))\n          } else {\n            let resolved_args = array_slice([CtUnknown], 0, 0)\n            let mut ai = 0\n            while ai < array_length(vtypes) {\n              array_push(resolved_args, resolve_type_expr(array_get(vtypes, ai), defs))\n              ai = ai + 1\n            }\n            env1 = env_bind(env1, vname, CtFn(resolved_args, CtEnum(name), false))\n          }\n          ci2 = ci2 + 1\n        }\n        (env1, s, c)\n      }\n      ,\n      SStruct(_, name, field_defs) => {\n        // Register TDStruct in defs for field type resolution\n        let resolved_fields = array_slice([\n          (\"\", CtUnit)\n        ], 0, 0)\n        let mut fi = 0\n        while fi < array_length(field_defs) {\n          let (fname, ftype_expr) = array_get(field_defs, fi)\n          let ftype = resolve_type_expr(ftype_expr, defs)\n          array_push(resolved_fields, (fname, ftype))\n          fi = fi + 1\n        }\n        array_push(defs, TDStruct(name, resolved_fields))\n        // Bind struct constructor as CtFn(field_types, CtStruct(name), false)\n        let field_types = array_slice([CtUnknown], 0, 0)\n        let mut fj = 0\n        while fj < array_length(resolved_fields) {\n          let (_, fty) = array_get(resolved_fields, fj)\n          array_push(field_types, fty)\n          fj = fj + 1\n        }\n        (env_bind(env, name, CtFn(field_types, CtStruct(name), false)), s, c)\n      }\n      ,\n      STypeAlias(_, name, te) => {\n        let t = resolve_type_expr(te, defs)\n        (env_bind(env, name, t), s, c)\n      },\n      SExternLet(name, te) => {\n        let t = resolve_type_expr(te, defs)\n        (env_bind(env, name, t), s, c)\n      },\n      STest(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SBench(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SExpr(expr) => {\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SModule(_, _, body) => {\n        let _ = check_stmts(body, 0, env, defs, s, c)\n        (env, s, c)\n      },\n      SImport(_, names) => {\n        let env_bindings = env_flat_bindings(env)\n        let import_cache = array_slice([\n          (\"\", CtUnknown)\n        ], 0, 0)\n        let nlen = array_length(names)\n        let rec bind_imports = (i: Int, acc: TypeEnv) -> TypeEnv {\n          if i >= nlen {\n            acc\n          }\n          else {\n            let (name, alias) = array_get(names, i)\n            let bound_name = match alias {\n              Some(a) => a,\n              None => name\n            }\n            let ty = match import_cache_lookup(import_cache, name, 0) {\n              Some(t) => t,\n              None => {\n                let resolved = match env_lookup_flat(env_bindings, name) {\n                  Some(t) => t,\n                  None => CtUnknown\n                }\n                array_push(import_cache, (name, resolved))\n                resolved\n              }\n            }\n            bind_imports(i + 1, env_bind(acc, bound_name, ty))\n          }\n        }\n        (bind_imports(0, env), s, c)\n      },\n      STrait(_, name, supers) => {\n        // Register trait definition in env\n        let is_open = false\n        (EnvTraitDef(name, supers, is_open, env), s, c)\n      },\n      SImpl(_, _, trait_name, type_name) => {\n        // Resolve target type\n        let target = match resolve_builtin(type_name) {\n          Some(t) => t,\n          None => CtNamed(type_name, array_slice([\n            CtUnknown\n          ], 0, 0))\n        }\n        // Register impl in env\n        (EnvTraitImpl(trait_name, target, env), s, c)\n      },\n      _ => (env, s, c)\n    }\n    check_stmts(stmts, i + 1, new_env, defs, s1, c1)\n  }\n}\n\nexport let check_program = (stmts: Array[Stmt]) -> TypeEnv {\n  let empty_defs = array_slice([\n    TDAlias(\"_dummy\", CtUnit)\n  ], 0, 0)\n  let (env, _, _) = check_stmts(stmts, 0, EnvEmpty, empty_defs, SubstEmpty, 0)\n  env\n}\n\nexport let check_program_with_env = (stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv {\n  let empty_defs = array_slice([\n    TDAlias(\"_dummy\", CtUnit)\n  ], 0, 0)\n  let (env, _, _) = check_stmts(stmts, 0, initial_env, empty_defs, SubstEmpty, 0)\n  env\n}\n")
    ,
    ("vibe/compiler/wasm_emit.vibe",
"// WASM binary emitter — generates minimal valid .wasm modules\n// Uses bytebuf.vibe for byte-level binary construction\n\nimport ./bytebuf.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes,\n  bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header,\n  leb128_encode_u32, leb128_encode_s64\n}\n\n// === Emit helpers ===\n\n// Emit WASM magic number and version\nexport let emit_header = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 97)   // 'a'\n  bytebuf_push(buf, 115)  // 's'\n  bytebuf_push(buf, 109)  // 'm'\n  bytebuf_push(buf, 1)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n\n// Encode a function type: (i64 x param_count) -> (i64 x result_count)\nexport let emit_func_type = (buf: Array[Int], param_count: Int, result_count: Int) -> Unit {\n  bytebuf_push(buf, 96)  // 0x60 = func type marker\n  leb128_encode_u32(buf, param_count)\n  let mut i = 0\n  while i < param_count {\n    bytebuf_push(buf, 126)  // i64\n    i = i + 1\n  }\n  leb128_encode_u32(buf, result_count)\n  let mut j = 0\n  while j < result_count {\n    bytebuf_push(buf, 126)  // i64\n    j = j + 1\n  }\n}\n\n// Emit type section with multiple function types\n// type_defs: flat array of [param_count, result_count, param_count, result_count, ...]\nexport let emit_type_section_multi = (out: Array[Int], type_defs: Array[Int]) -> Unit {\n  let count = array_length(type_defs) / 2\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_func_type(content, array_get(type_defs, i * 2), array_get(type_defs, (i * 2) + 1))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 1, content)\n}\n\n// Emit type section with a single function type (convenience)\nexport let emit_type_section = (out: Array[Int], param_count: Int, result_count: Int) -> Unit {\n  emit_type_section_multi(out, [param_count, result_count])\n}\n\n// Emit function section — maps function indices to type indices\nexport let emit_function_section = (out: Array[Int], type_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, array_length(type_indices))\n  let mut i = 0\n  while i < array_length(type_indices) {\n    leb128_encode_u32(content, array_get(type_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 3, content)\n}\n\n// Helper: emit a name string (length-prefixed ASCII)\nexport let emit_name = (buf: Array[Int], name: String) -> Unit {\n  let name_len = string_length(name)\n  leb128_encode_u32(buf, name_len)\n  let mut i = 0\n  while i < name_len {\n    bytebuf_push(buf, string_char_code_at(name, i))\n    i = i + 1\n  }\n}\n\n// Emit export section with multiple exports\n// names: array of export names, func_indices: matching array of function indices\nexport let emit_export_section_multi = (out: Array[Int], names: Array[String], func_indices: Array[Int]) -> Unit {\n  let count = array_length(names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_name(content, array_get(names, i))\n    bytebuf_push(content, 0)  // export kind: function\n    leb128_encode_u32(content, array_get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit export section — single export (convenience)\nexport let emit_export_section = (out: Array[Int], name: String, func_idx: Int) -> Unit {\n  emit_export_section_multi(out, [name], [func_idx])\n}\n\n// Emit memory section: 1 memory with min pages, no max\nexport let emit_memory_section = (out: Array[Int], min_pages: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 memory\n  bytebuf_push(content, 0)  // limits: no max\n  leb128_encode_u32(content, min_pages)\n  bytebuf_push_section(out, 5, content)\n}\n\n// Emit a code section with function bodies\n// Each body is pre-encoded instructions (without end opcode)\nexport let emit_code_section = (out: Array[Int], bodies: Array[Array[Int]]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, array_length(bodies))\n  let mut i = 0\n  while i < array_length(bodies) {\n    let body = array_get(bodies, i)\n    let func_buf = bytebuf_new()\n    leb128_encode_u32(func_buf, 0)  // 0 local declarations\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end opcode\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_array(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\n// Emit code section with local declarations\n// local_decls: array of [count, valtype] pairs per function (flat)\n// For now: emit one block of count locals of type i64\nexport let emit_code_section_with_locals = (out: Array[Int], bodies: Array[Array[Int]], local_counts: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, array_length(bodies))\n  let mut i = 0\n  while i < array_length(bodies) {\n    let body = array_get(bodies, i)\n    let num_locals = array_get(local_counts, i)\n    let func_buf = bytebuf_new()\n    if num_locals == 0 {\n      leb128_encode_u32(func_buf, 0)  // 0 local decl blocks\n    } else {\n      leb128_encode_u32(func_buf, 1)  // 1 local decl block\n      leb128_encode_u32(func_buf, num_locals)\n      bytebuf_push(func_buf, 126)  // i64\n    }\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_array(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\n// === Instruction emitters ===\n\nexport let emit_local_get = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 32)  // local.get\n  leb128_encode_u32(buf, idx)\n}\n\nexport let emit_local_set = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 33)  // local.set\n  leb128_encode_u32(buf, idx)\n}\n\nexport let emit_local_tee = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 34)  // local.tee\n  leb128_encode_u32(buf, idx)\n}\n\nexport let emit_i64_const = (buf: Array[Int], value: Int) -> Unit {\n  bytebuf_push(buf, 66)  // i64.const\n  leb128_encode_s64(buf, value)\n}\n\nexport let emit_i64_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 124)\n}\n\nexport let emit_i64_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 125)\n}\n\nexport let emit_i64_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 126)\n}\n\nexport let emit_i64_div_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 127)\n}\n\nexport let emit_i64_rem_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 129)  // 0x81\n}\n\nexport let emit_i64_and = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 131)  // 0x83\n}\n\nexport let emit_i64_or = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 132)  // 0x84\n}\n\nexport let emit_i64_xor = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 133)  // 0x85\n}\n\nexport let emit_i64_shl = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 134)  // 0x86\n}\n\nexport let emit_i64_shr_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 135)  // 0x87\n}\n\nexport let emit_i64_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 81)  // 0x51\n}\n\nexport let emit_i64_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 82)  // 0x52\n}\n\nexport let emit_i64_lt_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 83)  // 0x53\n}\n\nexport let emit_i64_gt_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 85)  // 0x55\n}\n\nexport let emit_i64_le_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 87)  // 0x57\n}\n\nexport let emit_i64_ge_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 89)  // 0x59\n}\n\nexport let emit_i64_eqz = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 80)  // 0x50\n}\n\nexport let emit_call = (buf: Array[Int], func_idx: Int) -> Unit {\n  bytebuf_push(buf, 16)  // call\n  leb128_encode_u32(buf, func_idx)\n}\n\nexport let emit_drop = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 26)  // drop\n}\n\nexport let emit_return = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 15)  // return\n}\n\n// Control flow: block types\n// 0x40 = void block, 0x7E = i64 block\nexport let emit_block_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 2)   // block\n  bytebuf_push(buf, 64)  // 0x40 = void\n}\n\nexport let emit_block_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 2)   // block\n  bytebuf_push(buf, 126) // 0x7E = i64\n}\n\nexport let emit_loop_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 3)   // loop\n  bytebuf_push(buf, 64)  // void\n}\n\nexport let emit_if_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 4)   // if\n  bytebuf_push(buf, 64)  // void\n}\n\nexport let emit_if_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 4)   // if\n  bytebuf_push(buf, 126) // i64\n}\n\nexport let emit_else = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 5)   // else\n}\n\nexport let emit_end = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 11)  // end\n}\n\nexport let emit_br = (buf: Array[Int], label: Int) -> Unit {\n  bytebuf_push(buf, 12)  // br\n  leb128_encode_u32(buf, label)\n}\n\nexport let emit_br_if = (buf: Array[Int], label: Int) -> Unit {\n  bytebuf_push(buf, 13)  // br_if\n  leb128_encode_u32(buf, label)\n}\n\n// i64.extend_i32_s — extend i32 comparison result to i64\nexport let emit_i64_extend_i32_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 172)  // 0xAC\n}\n\n// i32.wrap_i64 — truncate i64 to i32\nexport let emit_i32_wrap_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 167)  // 0xA7\n}\n\n// === i32 instructions (needed for WASI APIs) ===\n\nexport let emit_i32_const = (buf: Array[Int], value: Int) -> Unit {\n  bytebuf_push(buf, 65)  // i32.const\n  leb128_encode_s64(buf, value)  // sleb128 works for i32 too\n}\n\nexport let emit_i32_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 106)  // 0x6A\n}\n\nexport let emit_i32_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 54)  // 0x36 i32.store\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_i32_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 40)  // 0x28 i32.load\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_i32_store8 = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 58)  // 0x3A i32.store8\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_i32_load8_u = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 45)  // 0x2D i32.load8_u\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n// === Section emitters: Import, Data, Global ===\n\n// Emit raw func type with explicit valtype arrays\n// param_types/result_types: arrays of valtype ints (126=i64, 127=i32)\nexport let emit_func_type_raw = (buf: Array[Int], param_types: Array[Int], result_types: Array[Int]) -> Unit {\n  bytebuf_push(buf, 96)  // 0x60\n  leb128_encode_u32(buf, array_length(param_types))\n  let mut i = 0\n  while i < array_length(param_types) {\n    bytebuf_push(buf, array_get(param_types, i))\n    i = i + 1\n  }\n  leb128_encode_u32(buf, array_length(result_types))\n  let mut j = 0\n  while j < array_length(result_types) {\n    bytebuf_push(buf, array_get(result_types, j))\n    j = j + 1\n  }\n}\n\n// Emit import section: import a function\n// module_name, field_name: import path, type_idx: type index\nexport let emit_import_section_func = (out: Array[Int], module_name: String, field_name: String, type_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 import\n  emit_name(content, module_name)\n  emit_name(content, field_name)\n  bytebuf_push(content, 0)  // import kind: function\n  leb128_encode_u32(content, type_idx)\n  bytebuf_push_section(out, 2, content)  // section id 2 = import\n}\n\n// Emit data section: place byte data at a memory offset\n// segments: array of [offset, data_buf] pairs\nexport let emit_data_section = (out: Array[Int], offset: Int, data: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 data segment\n  // Active data segment: memory index 0\n  bytebuf_push(content, 0)  // flags: active, memory 0\n  // Offset expression: i32.const <offset>, end\n  emit_i32_const(content, offset)\n  emit_end(content)\n  // Data bytes\n  leb128_encode_u32(content, array_length(data))\n  bytebuf_push_array(content, data)\n  bytebuf_push_section(out, 11, content)  // section id 11 = data\n}\n\n// Emit global section: one mutable i32 global with initial value\nexport let emit_global_section_i32_mut = (out: Array[Int], init_value: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 global\n  bytebuf_push(content, 127)  // i32\n  bytebuf_push(content, 1)    // mutable\n  emit_i32_const(content, init_value)\n  emit_end(content)\n  bytebuf_push_section(out, 6, content)  // section id 6 = global\n}\n\nexport let emit_global_get = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 35)  // global.get\n  leb128_encode_u32(buf, idx)\n}\n\nexport let emit_global_set = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 36)  // global.set\n  leb128_encode_u32(buf, idx)\n}\n\n// Emit export for memory\nexport let emit_export_memory = (out: Array[Int], name: String, mem_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, name)\n  bytebuf_push(content, 2)  // export kind: memory\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit combined export section: functions + optional memory\nexport let emit_exports_with_memory = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {\n  let count = array_length(fn_names) + 1\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  // Function exports\n  let mut i = 0\n  while i < array_length(fn_names) {\n    emit_name(content, array_get(fn_names, i))\n    bytebuf_push(content, 0)  // function\n    leb128_encode_u32(content, array_get(fn_indices, i))\n    i = i + 1\n  }\n  // Memory export\n  emit_name(content, mem_name)\n  bytebuf_push(content, 2)  // memory\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit export section with functions, memory, and globals\n// Export kinds: 0=func, 1=table, 2=memory, 3=global\nexport let emit_exports_full = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {\n  let count = array_length(fn_names) + 1 + array_length(global_names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  // Function exports\n  let mut i = 0\n  while i < array_length(fn_names) {\n    emit_name(content, array_get(fn_names, i))\n    bytebuf_push(content, 0)  // function\n    leb128_encode_u32(content, array_get(fn_indices, i))\n    i = i + 1\n  }\n  // Memory export\n  emit_name(content, mem_name)\n  bytebuf_push(content, 2)  // memory\n  leb128_encode_u32(content, mem_idx)\n  // Global exports\n  let mut gi = 0\n  while gi < array_length(global_names) {\n    emit_name(content, array_get(global_names, gi))\n    bytebuf_push(content, 3)  // global\n    leb128_encode_u32(content, array_get(global_indices, gi))\n    gi = gi + 1\n  }\n  bytebuf_push_section(out, 7, content)\n}\n\n// === High-level: build a complete module ===\n\n// Build a minimal WASM module with one exported function: add(i64, i64) -> i64\nexport let build_add_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, [body])\n  bytebuf_to_bytes(out)\n}\n\n// Build a module with internal call: square(x) = x*x, sum_sq(a,b) = square(a) + square(b)\nexport let build_call_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // 2 types: type0 = (i64) -> (i64), type1 = (i64, i64) -> (i64)\n  emit_type_section_multi(out, [1, 1, 2, 1])\n\n  // 2 functions: func0=square(type0), func1=sum_sq(type1)\n  emit_function_section(out, [0, 1])\n\n  // export both\n  emit_export_section_multi(out, [\"square\", \"sum_sq\"], [0, 1])\n\n  // square: x * x\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n\n  // sum_sq: square(a) + square(b)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)  // call square\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)  // call square\n  emit_i64_add(ss_body)\n\n  emit_code_section(out, [sq_body, ss_body])\n  bytebuf_to_bytes(out)\n}\n\n// Build a module with add, sub, mul exported (all using same type: (i64, i64) -> i64)\nexport let build_arithmetic_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // 1 type: (i64, i64) -> (i64)\n  emit_type_section(out, 2, 1)\n\n  // 3 functions, all type 0\n  emit_function_section(out, [0, 0, 0])\n\n  // 3 exports\n  emit_export_section_multi(out, [\"add\", \"sub\", \"mul\"], [0, 1, 2])\n\n  // 3 function bodies\n  let add_body = bytebuf_new()\n  emit_local_get(add_body, 0)\n  emit_local_get(add_body, 1)\n  emit_i64_add(add_body)\n\n  let sub_body = bytebuf_new()\n  emit_local_get(sub_body, 0)\n  emit_local_get(sub_body, 1)\n  emit_i64_sub(sub_body)\n\n  let mul_body = bytebuf_new()\n  emit_local_get(mul_body, 0)\n  emit_local_get(mul_body, 1)\n  emit_i64_mul(mul_body)\n\n  emit_code_section(out, [add_body, sub_body, mul_body])\n  bytebuf_to_bytes(out)\n}\n\n// Build fibonacci module: fib(n) iterative\n// params: n (local 0)\n// locals: a (local 1), b (local 2), tmp (local 3)\n// Algorithm: a=0, b=1, while(n>0) { tmp=a+b; a=b; b=tmp; n=n-1 }; return a\nexport let build_fibonacci_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // type0: (i64) -> (i64)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"fib\", 0)\n\n  let b = bytebuf_new()\n  // local 0 = n (param), locals 1=a, 2=b, 3=tmp\n\n  // a = 0\n  emit_i64_const(b, 0)\n  emit_local_set(b, 1)\n  // b = 1\n  emit_i64_const(b, 1)\n  emit_local_set(b, 2)\n\n  // block $break\n  emit_block_void(b)\n    // loop $continue\n    emit_loop_void(b)\n      // if n <= 0, break\n      emit_local_get(b, 0)\n      emit_i64_const(b, 0)\n      emit_i64_le_s(b)\n      emit_br_if(b, 1)  // br $break (label 1 = outer block)\n\n      // tmp = a + b\n      emit_local_get(b, 1)\n      emit_local_get(b, 2)\n      emit_i64_add(b)\n      emit_local_set(b, 3)\n      // a = b\n      emit_local_get(b, 2)\n      emit_local_set(b, 1)\n      // b = tmp\n      emit_local_get(b, 3)\n      emit_local_set(b, 2)\n      // n = n - 1\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_sub(b)\n      emit_local_set(b, 0)\n\n      // br $continue (label 0 = loop)\n      emit_br(b, 0)\n    emit_end(b)  // end loop\n  emit_end(b)    // end block\n\n  // return a\n  emit_local_get(b, 1)\n\n  emit_code_section_with_locals(out, [b], [3])\n  bytebuf_to_bytes(out)\n}\n\n// Build factorial module: fact(n) iterative\n// params: n (local 0), locals: result (local 1)\n// Algorithm: result=1, while(n>1) { result=result*n; n=n-1 }; return result\nexport let build_factorial_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"fact\", 0)\n\n  let b = bytebuf_new()\n  // result = 1\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n\n  // block $break\n  emit_block_void(b)\n    // loop $continue\n    emit_loop_void(b)\n      // if n <= 1, break\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_le_s(b)\n      emit_br_if(b, 1)\n\n      // result = result * n\n      emit_local_get(b, 1)\n      emit_local_get(b, 0)\n      emit_i64_mul(b)\n      emit_local_set(b, 1)\n\n      // n = n - 1\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_sub(b)\n      emit_local_set(b, 0)\n\n      emit_br(b, 0)\n    emit_end(b)\n  emit_end(b)\n\n  // return result\n  emit_local_get(b, 1)\n\n  emit_code_section_with_locals(out, [b], [1])\n  bytebuf_to_bytes(out)\n}\n\n// Build a WASI hello world module\n// Imports fd_write from wasi_snapshot_preview1, writes \"hello world\\n\" to stdout\nexport let build_hello_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // Type section:\n  //   type0: fd_write(i32, i32, i32, i32) -> i32\n  //   type1: _start() -> void\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])\n  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))\n  bytebuf_push_section(out, 1, type_content)\n\n  // Import section: fd_write from wasi_snapshot_preview1 (func index 0)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n\n  // Function section: _start is func index 1 (after 1 import), type 1\n  emit_function_section(out, [1])\n\n  // Memory section: 1 page\n  emit_memory_section(out, 1)\n\n  // Export section: _start + memory\n  emit_exports_with_memory(out, [\"_start\"], [1], \"memory\", 0)\n\n  // Code section: _start body (must come before data section)\n  // Setup iovec at memory[0]: {ptr=8, len=12}\n  // Then call fd_write(1, 0, 1, 100)\n  //   fd=1 (stdout), iovs_ptr=0, iovs_count=1, nwritten_ptr=100\n  let b = bytebuf_new()\n\n  // mem[0] = 8 (iovec.buf pointer)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n\n  // mem[4] = 12 (iovec.buf_len)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 12)\n  emit_i32_store(b, 2, 0)\n\n  // call fd_write(1, 0, 1, 100)\n  emit_i32_const(b, 1)    // fd = stdout\n  emit_i32_const(b, 0)    // iovs ptr\n  emit_i32_const(b, 1)    // iovs count\n  emit_i32_const(b, 100)  // nwritten ptr\n  emit_call(b, 0)         // call fd_write (import index 0)\n  emit_drop(b)            // discard return value\n\n  emit_code_section(out, [b])\n\n  // Data section: \"hello world\\n\" at offset 8\n  let hello_data = bytebuf_new()\n  bytebuf_push(hello_data, 104)  // h\n  bytebuf_push(hello_data, 101)  // e\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 111)  // o\n  bytebuf_push(hello_data, 32)   // ' '\n  bytebuf_push(hello_data, 119)  // w\n  bytebuf_push(hello_data, 111)  // o\n  bytebuf_push(hello_data, 114)  // r\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 100)  // d\n  bytebuf_push(hello_data, 10)   // \\n\n  emit_data_section(out, 8, hello_data)\n\n  bytebuf_to_bytes(out)\n}\n\n// === String data helpers ===\n\n// Convert a string to a byte array (ASCII only)\nexport let string_to_data = (s: String) -> Array[Int] {\n  let buf = bytebuf_new()\n  let len = string_length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, string_char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\n// Emit data section with multiple segments\nexport let emit_data_section_multi = (out: Array[Int], offsets: Array[Int], datas: Array[Array[Int]]) -> Unit {\n  let count = array_length(offsets)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    bytebuf_push(content, 0)  // active, memory 0\n    emit_i32_const(content, array_get(offsets, i))\n    emit_end(content)\n    let data = array_get(datas, i)\n    leb128_encode_u32(content, array_length(data))\n    bytebuf_push_array(content, data)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 11, content)\n}\n\n// Build a WASI module that prints a custom string\nexport let build_print_string_module = (msg: String) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // Types: fd_write(i32,i32,i32,i32)->i32, _start()->void\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])\n  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))\n  bytebuf_push_section(out, 1, type_content)\n\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, [1])\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, [\"_start\"], [1], \"memory\", 0)\n\n  // String data at offset 16 (leave 0-15 for iovec + nwritten)\n  let str_data = string_to_data(msg)\n  let str_len = array_length(str_data)\n\n  // Code: setup iovec and call fd_write\n  let b = bytebuf_new()\n  // iovec[0].buf = 16\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 16)\n  emit_i32_store(b, 2, 0)\n  // iovec[0].len = str_len\n  emit_i32_const(b, 4)\n  emit_i32_const(b, str_len)\n  emit_i32_store(b, 2, 0)\n  // fd_write(stdout=1, iovs=0, count=1, nwritten=8)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n\n  emit_code_section(out, [b])\n  emit_data_section(out, 16, str_data)\n  bytebuf_to_bytes(out)\n}\n\n// === f64 instructions ===\n\n// f64.const — emit raw i64 bits as f64 constant\n// Caller provides the raw i64 bits (from double_to_i64_bits builtin)\nexport let emit_f64_const_bits = (buf: Array[Int], bits: Int) -> Unit {\n  bytebuf_push(buf, 68)  // 0x44 f64.const\n  // Emit 8 bytes in little-endian\n  bytebuf_push(buf, bits & 255)\n  bytebuf_push(buf, (bits >> 8) & 255)\n  bytebuf_push(buf, (bits >> 16) & 255)\n  bytebuf_push(buf, (bits >> 24) & 255)\n  bytebuf_push(buf, (bits >> 32) & 255)\n  bytebuf_push(buf, (bits >> 40) & 255)\n  bytebuf_push(buf, (bits >> 48) & 255)\n  bytebuf_push(buf, (bits >> 56) & 255)\n}\n\nexport let emit_f64_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 160)  // 0xA0\n}\n\nexport let emit_f64_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 161)  // 0xA1\n}\n\nexport let emit_f64_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 162)  // 0xA2\n}\n\nexport let emit_f64_div = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 163)  // 0xA3\n}\n\nexport let emit_f64_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 97)  // 0x61\n}\n\nexport let emit_f64_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 98)  // 0x62\n}\n\nexport let emit_f64_lt = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 99)  // 0x63\n}\n\nexport let emit_f64_gt = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 100)  // 0x64\n}\n\nexport let emit_f64_le = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 101)  // 0x65\n}\n\nexport let emit_f64_ge = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 102)  // 0x66\n}\n\nexport let emit_f64_neg = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 154)  // 0x9A\n}\n\n// i64.reinterpret_f64 — reinterpret f64 bits as i64\nexport let emit_i64_reinterpret_f64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 189)  // 0xBD\n}\n\n// f64.reinterpret_i64 — reinterpret i64 bits as f64\nexport let emit_f64_reinterpret_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 191)  // 0xBF\n}\n\n// i64.trunc_f64_s — truncate f64 to signed i64\nexport let emit_i64_trunc_f64_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 176)  // 0xB0\n}\n\n// f64.convert_i64_s — convert signed i64 to f64\nexport let emit_f64_convert_i64_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 185)  // 0xB9\n}\n\n// === Table and indirect call support ===\n\n// call_indirect: opcode 0x11 + type_idx (LEB128) + table 0x00\nexport let emit_call_indirect = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push(buf, 17)  // 0x11\n  leb128_encode_u32(buf, type_idx)\n  bytebuf_push(buf, 0)   // table index 0\n}\n\n// Emit table section (section 4): 1 funcref table with min=num_entries, no max\nexport let emit_table_section_funcref = (out: Array[Int], num_entries: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 table\n  bytebuf_push(content, 112)  // 0x70 = funcref\n  bytebuf_push(content, 0)    // limits: no max\n  leb128_encode_u32(content, num_entries)\n  bytebuf_push_section(out, 4, content)\n}\n\n// Emit element section (section 9): active segment for table 0 at offset 0\n// func_indices: array of function indices to place in table\nexport let emit_element_section_active = (out: Array[Int], func_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 segment\n  bytebuf_push(content, 0)  // flags: active, table 0\n  // Offset expression: i32.const 0, end\n  emit_i32_const(content, 0)\n  emit_end(content)\n  // Function indices\n  leb128_encode_u32(content, array_length(func_indices))\n  let mut i = 0\n  while i < array_length(func_indices) {\n    leb128_encode_u32(content, array_get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 9, content)\n}\n\n// === GC instructions ===\n\n// Emit a struct type definition: struct { field_types[i] with field_muts[i] }\n// field_types: valtype bytes (0x7E=i64, 0x7F=i32, etc.)\n// field_muts: 0x00=const, 0x01=mut\nexport let emit_struct_type_raw = (buf: Array[Int], field_types: Array[Int], field_muts: Array[Int]) -> Unit {\n  bytebuf_push(buf, 95)  // 0x5F = struct\n  leb128_encode_u32(buf, array_length(field_types))\n  let mut i = 0\n  while i < array_length(field_types) {\n    bytebuf_push(buf, array_get(field_types, i))\n    bytebuf_push(buf, array_get(field_muts, i))\n    i = i + 1\n  }\n}\n\n// struct.new $type — create a new struct (values on stack)\nexport let emit_struct_new = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push(buf, 251)  // 0xFB GC prefix\n  leb128_encode_u32(buf, 0)  // struct.new\n  leb128_encode_u32(buf, type_idx)\n}\n\n// struct.get $type $field — read a struct field\nexport let emit_struct_get = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push(buf, 251)  // 0xFB\n  leb128_encode_u32(buf, 2)  // struct.get\n  leb128_encode_u32(buf, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\n// struct.set $type $field — write a struct field\nexport let emit_struct_set = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push(buf, 251)  // 0xFB\n  leb128_encode_u32(buf, 5)  // struct.set\n  leb128_encode_u32(buf, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\n// ref.func $func — get a typed function reference\nexport let emit_ref_func = (buf: Array[Int], func_idx: Int) -> Unit {\n  bytebuf_push(buf, 210)  // 0xD2\n  leb128_encode_u32(buf, func_idx)\n}\n\n// call_ref $type — call a function reference\nexport let emit_call_ref = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push(buf, 20)  // 0x14\n  leb128_encode_u32(buf, type_idx)\n}\n\n// ref.null $heaptype — push a null reference\nexport let emit_ref_null = (buf: Array[Int], heap_type_byte: Int) -> Unit {\n  bytebuf_push(buf, 208)  // 0xD0\n  bytebuf_push(buf, heap_type_byte)\n}\n")
    ,
    ("vibe/compiler/codegen_common.vibe",
"// Shared utilities for WASM codegen backends (linear memory & wasm-gc)\n// AST analysis, string tables, free variable analysis, helper emitters\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./bytebuf.vibe {\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ./wasm_emit.vibe {\n  emit_i64_const, emit_i64_shl, emit_i64_or,\n  emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s, emit_i64_rem_s,\n  emit_i64_and, emit_i64_xor, emit_i64_shr_s,\n  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_ge_s,\n  emit_i64_extend_i32_s, emit_i64_eqz,\n  emit_local_get, emit_local_set,\n  emit_if_void, emit_else, emit_end,\n  emit_i32_wrap_i64, emit_i32_load,\n  emit_call_indirect\n}\n\n// === Additional i32/i64 ops not in wasm_emit ===\n\nexport let emit_i32_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 107)  // 0x6B\n}\n\nexport let emit_i32_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 108)  // 0x6C\n}\n\nexport let emit_i32_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 71)  // 0x47\n}\n\nexport let emit_i32_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 70)  // 0x46\n}\n\nexport let emit_i32_ge_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 79)  // 0x4F\n}\n\nexport let emit_i32_eqz = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 69)  // 0x45\n}\n\nexport let emit_i64_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 55)  // 0x37\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_i64_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 41)  // 0x29\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_i64_extend_i32_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 173)  // 0xAD\n}\n\nexport let emit_memory_copy = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 252)  // 0xFC prefix\n  leb128_encode_u32(buf, 10)  // memory.copy\n  bytebuf_push(buf, 0)  // src memory\n  bytebuf_push(buf, 0)  // dst memory\n}\n\n// === Shared codegen helpers ===\n\n// Emit WASM instruction for a binary operator\nexport let emit_binop_op = (buf: Array[Int], op: String) -> Unit with { Error } {\n  if string_equals(op, \"+\") { emit_i64_add(buf) }\n  else if string_equals(op, \"-\") { emit_i64_sub(buf) }\n  else if string_equals(op, \"*\") { emit_i64_mul(buf) }\n  else if string_equals(op, \"/\") { emit_i64_div_s(buf) }\n  else if string_equals(op, \"%\") { emit_i64_rem_s(buf) }\n  else if string_equals(op, \"&\") { emit_i64_and(buf) }\n  else if string_equals(op, \"|\") { emit_i64_or(buf) }\n  else if string_equals(op, \"^\") { emit_i64_xor(buf) }\n  else if string_equals(op, \"<<\") { emit_i64_shl(buf) }\n  else if string_equals(op, \">>\") { emit_i64_shr_s(buf) }\n  else if string_equals(op, \"==\") { emit_i64_eq(buf); emit_i64_extend_i32_s(buf) }\n  else if string_equals(op, \"!=\") { emit_i64_ne(buf); emit_i64_extend_i32_s(buf) }\n  else if string_equals(op, \"<\") { emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf) }\n  else if string_equals(op, \">\") { emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf) }\n  else if string_equals(op, \"<=\") { emit_i64_le_s(buf); emit_i64_extend_i32_s(buf) }\n  else if string_equals(op, \">=\") { emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf) }\n  else if string_equals(op, \"&&\") { emit_i64_and(buf) }\n  else if string_equals(op, \"||\") { emit_i64_or(buf) }\n  else { throw(string_concat(\"unsupported binop: \", op)) }\n}\n\n// Emit WASM instruction for an assign operator (+=, -=, etc.)\nexport let emit_assignop_op = (buf: Array[Int], op: String) -> Unit with { Error } {\n  if string_equals(op, \"+\") { emit_i64_add(buf) }\n  else if string_equals(op, \"-\") { emit_i64_sub(buf) }\n  else if string_equals(op, \"*\") { emit_i64_mul(buf) }\n  else if string_equals(op, \"/\") { emit_i64_div_s(buf) }\n  else if string_equals(op, \"%\") { emit_i64_rem_s(buf) }\n  else { throw(string_concat(\"unsupported assign op: \", op)) }\n}\n\n// Resolve closure/fn value tag and fill slot_local/env_local\n// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)\nexport let emit_closure_resolve = (buf: Array[Int], fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n    // Bare fn: table_slot = fn_val >> 2, env = 0\n    emit_local_get(buf, fn_val_local)\n    emit_i64_const(buf, 2)\n    emit_i64_shr_s(buf)\n    emit_local_set(buf, slot_local)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, env_local)\n  emit_else(buf)\n    // Closure: env = fn_val & ~3, slot = i32.load(env, 0)\n    emit_local_get(buf, fn_val_local)\n    emit_i64_const(buf, -4)\n    emit_i64_and(buf)\n    emit_local_set(buf, env_local)\n    emit_local_get(buf, env_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\n// Emit the tail of an indirect closure call (push env, push slot, call_indirect)\nexport let emit_closure_call_tail = (buf: Array[Int], env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\n// === Compilation context ===\n\nexport let resolve_local = (names: Array[String], name: String, tag: String) -> Int with { Error } {\n  let mut i = array_length(names) - 1\n  let mut result = -1\n  while i >= 0 {\n    if string_equals(array_get(names, i), name) {\n      result = i\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  if result < 0 {\n    let mut dbg = string_concat(\"undefined variable (local): \", name)\n    dbg = string_concat(dbg, \" [locals: \")\n    let mut di = 0\n    let dlen = array_length(names)\n    while di < dlen {\n      if di > 0 { dbg = string_concat(dbg, \", \") }\n      dbg = string_concat(dbg, array_get(names, di))\n      di = di + 1\n    }\n    dbg = string_concat(dbg, \"]\")\n    dbg = string_concat(dbg, \" @\")\n    dbg = string_concat(dbg, tag)\n    throw(dbg)\n  }\n  result\n}\n\n// Function registry: groups parallel arrays for function metadata\nexport struct FuncTable {\n  names: Array[String];\n  indices: Array[Int];\n  params: Array[Int];\n  returns: Array[Int]\n}\n\n// Resolve function: returns (func_index, param_count, has_return)\nexport let resolve_func = (ft: FuncTable, name: String) -> (Int, Int, Int) with { Error } {\n  let len = array_length(ft.names)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if string_equals(array_get(ft.names, i), name) {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(string_concat(\"undefined function: \", name))\n  };\n  (array_get(ft.indices, found), array_get(ft.params, found), array_get(ft.returns, found))\n}\n\n// String table: groups string data with their WASM data segment offsets/lengths\nexport struct StrTable {\n  strs: Array[String];\n  offsets: Array[Int];\n  lengths: Array[Int]\n}\n\n// Lambda accumulator: collects compiled lambda bodies and metadata\nexport struct LambdaTable {\n  bodies: Array[Array[Int]];\n  param_counts: Array[Int];\n  captures: Array[Array[String]];\n  meta_i32: Array[Int];\n  meta_i64: Array[Int]\n}\n\n// Constructor/struct registry: enum variant + struct constructors\nexport struct CtorTable {\n  names: Array[String];\n  tags: Array[Int];\n  field_counts: Array[Int];\n  type_names: Array[String];\n  struct_names: Array[String];\n  struct_field_names: Array[Array[String]]\n}\n\n// Compilation context: all shared state for compile_expr\nexport struct CompileCtx {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ctor_table: CtorTable;\n  thunk_names: Array[String]\n}\n\n// GC backend compilation context (extends CompileCtx with GC-specific fields)\nexport struct CompileCtxGc {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ref_local_indices: Array[Int];\n  refcell_type_idx: Int;\n  closure_type_base: Int;\n  ctor_table: CtorTable\n}\n\n// === String table ===\n\nexport let emit_str_ref = (buf: Array[Int], offset: Int, length: Int) -> Unit {\n  emit_i64_const(buf, offset)\n  emit_i64_const(buf, 32)\n  emit_i64_shl(buf)\n  emit_i64_const(buf, length)\n  emit_i64_or(buf)\n}\n\nexport let rec collect_strings_expr = (expr: Expr, out: Array[String]) -> Int {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < array_length(out) {\n        if string_equals(array_get(out, i), s) {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found { array_push(out, s) }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args) => {\n      collect_strings_expr(callee, out)\n      let mut i = 0\n      while i < array_length(args) {\n        collect_strings_expr(array_get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < array_length(elems) {\n        collect_strings_expr(array_get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < array_length(elems) {\n        collect_strings_expr(array_get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < array_length(arms) {\n        let (pat, arm_expr) = array_get(arms, i)\n        match pat {\n          PString(s) => {\n            let mut pf = false\n            let mut pi = 0\n            while pi < array_length(out) {\n              if string_equals(array_get(out, pi), s) { pf = true }\n              pi = pi + 1\n            }\n            if !pf { array_push(out, s) }\n            0\n          },\n          _ => 0\n        }\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EThrow(msg) => collect_strings_expr(msg, out),\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < array_length(arms) {\n        let (_, arm_expr) = array_get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport let collect_strings_stmts = (stmts: Array[Stmt]) -> Array[String] {\n  let out = array_slice([\"\"], 0, 0)\n  let mut i = 0\n  while i < array_length(stmts) {\n    match array_get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\n// === Free variable analysis ===\n\nexport let array_contains_str = (arr: Array[String], s: String) -> Bool {\n  let len = array_length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if string_equals(array_get(arr, i), s) {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Extract all binding names from a pattern into the given array\nlet rec collect_pattern_bindings = (pat: Pat, bindings: Array[String]) -> Int {\n  match pat {\n    PBind(name) => { array_push(bindings, name); 0 },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < array_length(pats) {\n        collect_pattern_bindings(array_get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < array_length(args) {\n        collect_pattern_bindings(array_get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => { collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings) },\n    _ => 0\n  }\n}\n\n// Stack-based free variable analysis: uses in-place push/truncate on bound array\n// to avoid O(n) array copies at every scope boundary. This dramatically reduces\n// heap allocation during meta-circular self-compilation.\nexport let rec collect_free_vars_expr = (expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name) => {\n      if array_contains_str(bound, name) { 0 }\n      else if array_contains_str(fn_names, name) { 0 }\n      else if array_contains_str(out, name) { 0 }\n      else {\n        array_push(out, name)\n        0\n      }\n    },\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => { collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out) },\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\n    EIf(cond, then_e, else_e) => { collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out) },\n    ECall(callee, args) => {\n      collect_free_vars_expr(callee, bound, fn_names, out)\n      let mut i = 0\n      while i < array_length(args) {\n        collect_free_vars_expr(array_get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = array_length(bound)\n      array_push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      array_truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = array_length(bound)\n      array_push(bound, name)\n      collect_free_vars_expr(value, bound, fn_names, out)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      array_truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = array_length(bound)\n      array_push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      array_truncate(bound, saved)\n      0\n    },\n    EAssign(_, value, body) => { collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out) },\n    EAssignOp(_, _, value, body) => { collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out) },\n    ESeq(first, second) => { collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out) },\n    EWhile(cond, body) => { collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out) },\n    EForIn(var_name, iter_e, body) => {\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\n      let saved = array_length(bound)\n      array_push(bound, var_name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      array_truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < array_length(elems) {\n        collect_free_vars_expr(array_get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < array_length(elems) {\n        collect_free_vars_expr(array_get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\n      let mut i = 0\n      while i < array_length(arms) {\n        let (arm_pat, arm_expr) = array_get(arms, i)\n        let saved = array_length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        array_truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = array_length(bound)\n      let mut pi = 0\n      while pi < array_length(params) {\n        let (pname, _) = array_get(params, pi)\n        array_push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      array_truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr(body, bound, fn_names, out)\n      let mut hi = 0\n      while hi < array_length(arms) {\n        let (_, arm_expr) = array_get(arms, hi)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _) => collect_free_vars_expr(obj, bound, fn_names, out),\n    ERecord(fields) => {\n      let mut ri = 0\n      while ri < array_length(fields) {\n        let (_, fval) = array_get(fields, ri)\n        collect_free_vars_expr(fval, bound, fn_names, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\n    _ => 0\n  }\n}\n\nexport let collect_free_vars = (body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\n  let out = array_slice([\"\"], 0, 0)\n  // Make a mutable copy of param_names for stack-based push/truncate\n  let bound = array_slice(param_names, 0, array_length(param_names))\n  collect_free_vars_expr(body, bound, fn_names, out)\n  out\n}\n\n// === Mutable capture analysis ===\n\n// Check if a mutable variable is captured by any nested EFn in the given expression\nexport let rec is_mut_captured_in = (expr: Expr, name: String) -> Bool {\n  match expr {\n    EIdent(_) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args) => {\n      if is_mut_captured_in(callee, name) { true }\n      else {\n        let mut i = 0\n        let mut found = false\n        while i < array_length(args) {\n          if is_mut_captured_in(array_get(args, i), name) { found = true }\n          i = i + 1\n        }\n        found\n      }\n    },\n    ELet(n, value, body) => {\n      if string_equals(n, name) { is_mut_captured_in(value, name) }\n      else { is_mut_captured_in(value, name) || is_mut_captured_in(body, name) }\n    },\n    ELetRec(n, value, body) => {\n      if string_equals(n, name) { false }\n      else { is_mut_captured_in(value, name) || is_mut_captured_in(body, name) }\n    },\n    ELetMut(n, value, body) => {\n      if string_equals(n, name) { is_mut_captured_in(value, name) }\n      else { is_mut_captured_in(value, name) || is_mut_captured_in(body, name) }\n    },\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < array_length(elems) {\n        if is_mut_captured_in(array_get(elems, i), name) { found = true }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < array_length(elems) {\n        if is_mut_captured_in(array_get(elems, i), name) { found = true }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => {\n      if is_mut_captured_in(scrutinee, name) { true }\n      else {\n        let mut i = 0\n        let mut found = false\n        while i < array_length(arms) {\n          let (_, arm_expr) = array_get(arms, i)\n          if is_mut_captured_in(arm_expr, name) { found = true }\n          i = i + 1\n        }\n        found\n      }\n    },\n    EFn(_, _, params, _, _, fn_body) => {\n      // Check if name is shadowed by params\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < array_length(params) {\n        let (pname, _) = array_get(params, pi)\n        if string_equals(pname, name) { shadowed = true }\n        pi = pi + 1\n      }\n      if shadowed { false }\n      else {\n        // Check if name is free in this EFn\n        let param_names = array_slice([\"\"], 0, 0)\n        let mut pi2 = 0\n        while pi2 < array_length(params) {\n          let (pname2, _) = array_get(params, pi2)\n          array_push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, array_slice([\"\"], 0, 0))\n        if array_contains_str(fv, name) { true }\n        else {\n          // Also check recursively for deeper nesting\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EThrow(msg) => is_mut_captured_in(msg, name),\n    _ => false\n  }\n}\n\n// === Lookup helpers ===\n\nexport let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {\n  let len = array_length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if string_equals(array_get(strs, i), s) {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(string_concat(\"string not in table: \", s))\n  }\n  found\n}\n\n// Check if a pattern is unconditionally matching (catch-all)\nexport let is_catchall_pat = (p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      // PTuple is catch-all only if ALL sub-patterns are catch-all\n      let mut i = 0\n      let mut all_catch = true\n      while i < array_length(pats) {\n        if !is_catchall_pat(array_get(pats, i)) { all_catch = false }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\n// Find the index of the first catch-all pattern in match arms\n// Returns num_arms if no catch-all found\nexport let find_catchall_idx = (arms: Array[(Pat, Expr)]) -> Int {\n  let num = array_length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = array_get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\n// Find the SLet statement for a given function name\nexport let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {\n  let len = array_length(stmts)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    let stmt = array_get(stmts, i)\n    match stmt {\n      SLet(_, _, sname, _, _) => {\n        if string_equals(sname, name) {\n          found = i\n          i = len\n        }\n      },\n      _ => ()\n    }\n    if found < 0 { i = i + 1 }\n  }\n  if found < 0 {\n    throw(string_concat(\"function not found: \", name))\n  }\n  array_get(stmts, found)\n}\n\n// Extract function body from SLet(_, _, _, _, EFn(_, _, _, _, _, body))\nexport let get_func_body = (stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, _, _, _, body) => body,\n      _ => throw(\"get_func_body: not a function\")\n    },\n    _ => throw(\"get_func_body: not a let statement\")\n  }\n}\n\n// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))\nexport let get_func_param_names = (stmt: Stmt) -> Array[String] with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = array_slice([\"\"], 0, 0)\n        let mut i = 0\n        while i < array_length(params) {\n          let (pname, _) = array_get(params, i)\n          array_push(names, pname)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\n// Extract scrutinee from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_scrutinee = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n\n// Extract arms from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_arms = (expr: Expr) -> Array[(Pat, Expr)] with { Error } {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\n// Extract pattern from match arm pair\nexport let get_arm_pat = (arm: (Pat, Expr)) -> Pat {\n  let (p, _) = arm\n  p\n}\n\n// Extract body from match arm pair\nexport let get_arm_body = (arm: (Pat, Expr)) -> Expr {\n  let (_, b) = arm\n  b\n}\n\n// Extract sub-patterns from PTuple\nexport let get_ptuple_pats = (p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\n// Extract name from PBind\nexport let get_pbind_name = (p: Pat) -> String with { Error } {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\n// Extract PCtor name and args\nexport let get_pctor_name = (p: Pat) -> String with { Error } {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\nexport let get_pctor_args = (p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\n// Extract PInt value\nexport let get_pint_value = (p: Pat) -> Int with { Error } {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\n// Extract PBool value\nexport let get_pbool_value = (p: Pat) -> Bool with { Error } {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\n// Extract PString value\nexport let get_pstring_value = (p: Pat) -> String with { Error } {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\n// Extract elements from ETuple\nexport let get_etuple_elems = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\n// Check if expr is an ETuple\nexport let is_etuple = (expr: Expr) -> Bool {\n  match expr {\n    ETuple(_) => true,\n    _ => false\n  }\n}\n\n// Check pattern type\nexport let is_ptuple = (p: Pat) -> Bool {\n  match p { PTuple(_) => true, _ => false }\n}\nexport let is_pwild = (p: Pat) -> Bool {\n  match p { PWild => true, _ => false }\n}\nexport let is_pbind = (p: Pat) -> Bool {\n  match p { PBind(_) => true, _ => false }\n}\nexport let is_pint = (p: Pat) -> Bool {\n  match p { PInt(_) => true, _ => false }\n}\nexport let is_pbool = (p: Pat) -> Bool {\n  match p { PBool(_) => true, _ => false }\n}\nexport let is_pctor = (p: Pat) -> Bool {\n  match p { PCtor(_, _) => true, _ => false }\n}\nexport let is_pstring = (p: Pat) -> Bool {\n  match p { PString(_) => true, _ => false }\n}\n\n// === Expr extraction helpers (to avoid stale match bindings in let rec) ===\n\nexport let get_eint_value = (expr: Expr) -> Int with { Error } {\n  match expr { EInt(n) => n, _ => throw(\"not EInt\") }\n}\nexport let get_ebool_value = (expr: Expr) -> Bool with { Error } {\n  match expr { EBool(b) => b, _ => throw(\"not EBool\") }\n}\nexport let get_efloat_value = (expr: Expr) -> Double with { Error } {\n  match expr { EFloat(v) => v, _ => throw(\"not EFloat\") }\n}\nexport let get_estring_value = (expr: Expr) -> String with { Error } {\n  match expr { EString(s) => s, _ => throw(\"not EString\") }\n}\nexport let get_eident_name = (expr: Expr) -> String with { Error } {\n  match expr { EIdent(name) => name, _ => throw(\"not EIdent\") }\n}\nexport let get_ecall_callee = (expr: Expr) -> Expr with { Error } {\n  match expr { ECall(callee, _) => callee, _ => throw(\"not ECall\") }\n}\nexport let get_ecall_args = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr { ECall(_, args) => args, _ => throw(\"not ECall\") }\n}\nexport let get_ebinop_op = (expr: Expr) -> String with { Error } {\n  match expr { EBinOp(op, _, _) => op, _ => throw(\"not EBinOp\") }\n}\nexport let get_ebinop_lhs = (expr: Expr) -> Expr with { Error } {\n  match expr { EBinOp(_, lhs, _) => lhs, _ => throw(\"not EBinOp\") }\n}\nexport let get_ebinop_rhs = (expr: Expr) -> Expr with { Error } {\n  match expr { EBinOp(_, _, rhs) => rhs, _ => throw(\"not EBinOp\") }\n}\nexport let get_eif_cond = (expr: Expr) -> Expr with { Error } {\n  match expr { EIf(c, _, _) => c, _ => throw(\"not EIf\") }\n}\nexport let get_eif_then = (expr: Expr) -> Expr with { Error } {\n  match expr { EIf(_, t, _) => t, _ => throw(\"not EIf\") }\n}\nexport let get_eif_else = (expr: Expr) -> Expr with { Error } {\n  match expr { EIf(_, _, e) => e, _ => throw(\"not EIf\") }\n}\nexport let get_elet_name = (expr: Expr) -> String with { Error } {\n  match expr { ELet(name, _, _) => name, _ => throw(\"not ELet\") }\n}\nexport let get_elet_val = (expr: Expr) -> Expr with { Error } {\n  match expr { ELet(_, val, _) => val, _ => throw(\"not ELet\") }\n}\nexport let get_elet_body = (expr: Expr) -> Expr with { Error } {\n  match expr { ELet(_, _, body) => body, _ => throw(\"not ELet\") }\n}\nexport let get_eletrec_name = (expr: Expr) -> String with { Error } {\n  match expr { ELetRec(name, _, _) => name, _ => throw(\"not ELetRec\") }\n}\nexport let get_eletrec_val = (expr: Expr) -> Expr with { Error } {\n  match expr { ELetRec(_, val, _) => val, _ => throw(\"not ELetRec\") }\n}\nexport let get_eletrec_body = (expr: Expr) -> Expr with { Error } {\n  match expr { ELetRec(_, _, body) => body, _ => throw(\"not ELetRec\") }\n}\nexport let get_eletmut_name = (expr: Expr) -> String with { Error } {\n  match expr { ELetMut(name, _, _) => name, _ => throw(\"not ELetMut\") }\n}\nexport let get_eletmut_val = (expr: Expr) -> Expr with { Error } {\n  match expr { ELetMut(_, val, _) => val, _ => throw(\"not ELetMut\") }\n}\nexport let get_eletmut_body = (expr: Expr) -> Expr with { Error } {\n  match expr { ELetMut(_, _, body) => body, _ => throw(\"not ELetMut\") }\n}\nexport let get_eassign_name = (expr: Expr) -> String with { Error } {\n  match expr { EAssign(name, _, _) => name, _ => throw(\"not EAssign\") }\n}\nexport let get_eassign_val = (expr: Expr) -> Expr with { Error } {\n  match expr { EAssign(_, val, _) => val, _ => throw(\"not EAssign\") }\n}\nexport let get_eassign_body = (expr: Expr) -> Expr with { Error } {\n  match expr { EAssign(_, _, body) => body, _ => throw(\"not EAssign\") }\n}\nexport let get_eassignop_name = (expr: Expr) -> String with { Error } {\n  match expr { EAssignOp(name, _, _, _) => name, _ => throw(\"not EAssignOp\") }\n}\nexport let get_eassignop_op = (expr: Expr) -> String with { Error } {\n  match expr { EAssignOp(_, op, _, _) => op, _ => throw(\"not EAssignOp\") }\n}\nexport let get_eassignop_val = (expr: Expr) -> Expr with { Error } {\n  match expr { EAssignOp(_, _, val, _) => val, _ => throw(\"not EAssignOp\") }\n}\nexport let get_eassignop_body = (expr: Expr) -> Expr with { Error } {\n  match expr { EAssignOp(_, _, _, body) => body, _ => throw(\"not EAssignOp\") }\n}\nexport let get_eseq_first = (expr: Expr) -> Expr with { Error } {\n  match expr { ESeq(first, _) => first, _ => throw(\"not ESeq\") }\n}\nexport let get_eseq_second = (expr: Expr) -> Expr with { Error } {\n  match expr { ESeq(_, second) => second, _ => throw(\"not ESeq\") }\n}\nexport let get_ewhile_cond = (expr: Expr) -> Expr with { Error } {\n  match expr { EWhile(cond, _) => cond, _ => throw(\"not EWhile\") }\n}\nexport let get_ewhile_body = (expr: Expr) -> Expr with { Error } {\n  match expr { EWhile(_, body) => body, _ => throw(\"not EWhile\") }\n}\nexport let get_eunaryop_op = (expr: Expr) -> String with { Error } {\n  match expr { EUnaryOp(op, _) => op, _ => throw(\"not EUnaryOp\") }\n}\nexport let get_eunaryop_expr = (expr: Expr) -> Expr with { Error } {\n  match expr { EUnaryOp(_, e) => e, _ => throw(\"not EUnaryOp\") }\n}\nexport let get_eforin_name = (expr: Expr) -> String with { Error } {\n  match expr { EForIn(name, _, _) => name, _ => throw(\"not EForIn\") }\n}\nexport let get_eforin_iter = (expr: Expr) -> Expr with { Error } {\n  match expr { EForIn(_, iter, _) => iter, _ => throw(\"not EForIn\") }\n}\nexport let get_eforin_body = (expr: Expr) -> Expr with { Error } {\n  match expr { EForIn(_, _, body) => body, _ => throw(\"not EForIn\") }\n}\nexport let get_earray_elems = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr { EArray(elems) => elems, _ => throw(\"not EArray\") }\n}\nexport let get_ethrow_expr = (expr: Expr) -> Expr with { Error } {\n  match expr { EThrow(e) => e, _ => throw(\"not EThrow\") }\n}\nexport let get_efn_params = (expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\n  match expr { EFn(_, _, params, _, _, _) => params, _ => throw(\"not EFn\") }\n}\nexport let get_efn_body = (expr: Expr) -> Expr with { Error } {\n  match expr { EFn(_, _, _, _, _, body) => body, _ => throw(\"not EFn\") }\n}\n// Expr type checks (only those needed inside match arms)\nexport let is_eident = (expr: Expr) -> Bool { match expr { EIdent(_) => true, _ => false } }\nexport let is_efn = (expr: Expr) -> Bool { match expr { EFn(_, _, _, _, _, _) => true, _ => false } }\n\n// Expr tag: returns a numeric tag for dispatch without match in let rec\n// 0=EInt, 1=EBool, 2=EFloat, 3=EString, 4=EIdent, 5=EBinOp, 6=EUnaryOp,\n// 7=EIf, 8=ECall, 9=ELet, 10=ELetRec, 11=ELetMut, 12=EAssign, 13=EAssignOp,\n// 14=ESeq, 15=ETuple, 16=EMatch, 17=EArray, 18=EForIn, 19=EWhile,\n// 20=EBreak, 21=EContinue, 22=EUnit, 23=EThrow, 24=EFn, -1=unknown\nexport let expr_tag = (expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0, EBool(_) => 1, EFloat(_) => 2, EString(_) => 3,\n    EIdent(_) => 4, EBinOp(_, _, _) => 5, EUnaryOp(_, _) => 6,\n    EIf(_, _, _) => 7, ECall(_, _) => 8, ELet(_, _, _) => 9,\n    ELetRec(_, _, _) => 10, ELetMut(_, _, _) => 11, EAssign(_, _, _) => 12,\n    EAssignOp(_, _, _, _) => 13, ESeq(_, _) => 14, ETuple(_) => 15,\n    EMatch(_, _) => 16, EArray(_) => 17, EForIn(_, _, _) => 18,\n    EWhile(_, _) => 19, EBreak(_) => 20, EContinue(_) => 21,\n    EUnit => 22, EThrow(_) => 23, EFn(_, _, _, _, _, _) => 24,\n    _ => -1\n  }\n}\n\n// === Stmt extractors ===\nexport let is_slet = (stmt: Stmt) -> Bool { match stmt { SLet(_, _, _, _, _) => true, _ => false } }\nexport let get_slet_name = (stmt: Stmt) -> String with { Error } {\n  match stmt { SLet(_, _, name, _, _) => name, _ => throw(\"not SLet\") }\n}\nexport let get_slet_expr = (stmt: Stmt) -> Expr with { Error } {\n  match stmt { SLet(_, _, _, _, expr) => expr, _ => throw(\"not SLet\") }\n}\nexport let get_slet_export = (stmt: Stmt) -> Bool with { Error } {\n  match stmt { SLet(is_export, _, _, _, _) => is_export, _ => throw(\"not SLet\") }\n}\n\n// === Enum constructor lookup ===\n\n// Returns index into ctor_names array, or -1 if not found\nexport let rec lookup_ctor = (ctor_names: Array[String], name: String, i: Int) -> Int {\n  if i >= array_length(ctor_names) { -1 }\n  else if string_equals(array_get(ctor_names, i), name) { i }\n  else lookup_ctor(ctor_names, name, i + 1)\n}\n")
    ,
    ("vibe/compiler/codegen.vibe",
"// AST-to-WASM codegen (linear memory backend)\n// Supports: Int arithmetic, let/mut/assign, functions, if/else, while, calls,\n// strings (packed i64 refs), tuples (heap), arrays (heap), match expressions, closures\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./bytebuf.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,\n  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,\n  leb128_encode_u32, leb128_encode_s64\n}\n\nimport ./wasm_emit.vibe {\n  emit_header,\n  emit_type_section, emit_type_section_multi,\n  emit_function_section, emit_export_section, emit_export_section_multi,\n  emit_code_section, emit_code_section_with_locals,\n  emit_name, emit_func_type_raw,\n  emit_import_section_func, emit_memory_section,\n  emit_exports_with_memory, emit_exports_full, emit_data_section, emit_data_section_multi,\n  emit_local_get, emit_local_set, emit_local_tee,\n  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,\n  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,\n  emit_i64_shl, emit_i64_shr_s,\n  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,\n  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,\n  emit_i64_extend_i32_s, emit_i32_wrap_i64,\n  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,\n  emit_i32_store8, emit_i32_load8_u,\n  emit_call, emit_drop, emit_return,\n  emit_block_void, emit_block_i64, emit_loop_void,\n  emit_if_void, emit_if_i64, emit_else, emit_end,\n  emit_br, emit_br_if,\n  emit_global_section_i32_mut, emit_global_get, emit_global_set,\n  string_to_data,\n  emit_f64_const_bits, emit_f64_add, emit_f64_sub, emit_f64_mul, emit_f64_div,\n  emit_f64_eq, emit_f64_ne, emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge,\n  emit_f64_neg, emit_i64_reinterpret_f64, emit_f64_reinterpret_i64,\n  emit_i64_trunc_f64_s, emit_f64_convert_i64_s,\n  emit_call_indirect, emit_table_section_funcref, emit_element_section_active\n}\n\nimport ./codegen_common.vibe {\n  emit_i32_sub, emit_i32_mul, emit_i32_ne, emit_i32_eq, emit_i32_ge_u, emit_i32_eqz,\n  emit_i64_store, emit_i64_load, emit_i64_extend_i32_u, emit_memory_copy,\n  resolve_local, resolve_func, FuncTable, StrTable, LambdaTable, CtorTable, CompileCtx,\n  emit_str_ref, collect_strings_stmts,\n  array_contains_str, collect_free_vars, is_mut_captured_in,\n  str_table_lookup, find_catchall_idx,\n  lookup_ctor,\n  emit_binop_op, emit_assignop_op, emit_closure_resolve, emit_closure_call_tail,\n  get_match_scrutinee, get_match_arms,\n  get_arm_pat, get_arm_body,\n  get_ptuple_pats, get_pbind_name,\n  get_pctor_name, get_pctor_args,\n  get_pint_value, get_pbool_value, get_pstring_value,\n  is_ptuple, is_pwild, is_pbind, is_pint, is_pbool, is_pctor, is_pstring,\n  get_etuple_elems, is_etuple,\n  get_eint_value, get_ebool_value, get_efloat_value, get_estring_value,\n  get_eident_name, get_ecall_callee, get_ecall_args,\n  get_ebinop_op, get_ebinop_lhs, get_ebinop_rhs,\n  get_eif_cond, get_eif_then, get_eif_else,\n  get_elet_name, get_elet_val, get_elet_body,\n  get_eletrec_name, get_eletrec_val, get_eletrec_body,\n  get_eletmut_name, get_eletmut_val, get_eletmut_body,\n  get_eassign_name, get_eassign_val, get_eassign_body,\n  get_eassignop_name, get_eassignop_op, get_eassignop_val, get_eassignop_body,\n  get_eseq_first, get_eseq_second,\n  get_ewhile_cond, get_ewhile_body,\n  get_eunaryop_op, get_eunaryop_expr,\n  get_eforin_name, get_eforin_iter, get_eforin_body,\n  get_earray_elems, get_ethrow_expr,\n  get_efn_params, get_efn_body,\n  is_eident, is_efn,\n  expr_tag,\n  is_slet, get_slet_name, get_slet_expr, get_slet_export\n}\n\n// === Expression compiler ===\n\n// === Sub-compilers (linear memory backend) ===\n\nlet compile_call = (\n  buf: Array[Int], callee: Expr, args: Array[Expr],\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtx, ld: Int,\n  ce: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }\n) -> Int with { Error } {\n  if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n      if ctor_lookup_idx >= 0 {\n        let tag = array_get(ctx.ctor_table.tags, ctor_lookup_idx)\n        let fc = array_get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        array_push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let actual_args = if array_length(args) == 1 {\n          match array_get(args, 0) {\n            ERecord(rec_fields) => {\n              let mut si2 = 0\n              let mut sn_idx = -1\n              while si2 < array_length(ctx.ctor_table.struct_names) {\n                if string_equals(array_get(ctx.ctor_table.struct_names, si2), fname) {\n                  sn_idx = si2\n                  si2 = array_length(ctx.ctor_table.struct_names)\n                } else {\n                  si2 = si2 + 1\n                }\n              }\n              if sn_idx >= 0 {\n                let def_fnames = array_get(ctx.ctor_table.struct_field_names, sn_idx)\n                let ordered = array_slice([EUnit], 0, 0)\n                let mut oi = 0\n                while oi < array_length(def_fnames) {\n                  let target_name = array_get(def_fnames, oi)\n                  let mut ri = 0\n                  let mut found_rfv = EUnit\n                  while ri < array_length(rec_fields) {\n                    let (rfn, rfv) = array_get(rec_fields, ri)\n                    if string_equals(rfn, target_name) {\n                      found_rfv = rfv\n                      ri = array_length(rec_fields)\n                    } else {\n                      ri = ri + 1\n                    }\n                  }\n                  array_push(ordered, found_rfv)\n                  oi = oi + 1\n                }\n                ordered\n              } else { args }\n            },\n            _ => args\n          }\n        } else { args }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < array_length(actual_args) {\n          nl_c = ce(buf, array_get(actual_args, fi_c), local_names, nl_c, ctx, ld)\n          let val_local = nl_c\n          array_push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n      else if string_equals(fname, \"bytes_from_array\") {\n        // bytes_from_array is identity in linear memory backend\n        ce(buf, array_get(args, 0), local_names, next_local, ctx, ld)\n      }\n      else if string_equals(fname, \"bytes_length\") {\n        // bytes_length = array_length (same layout)\n        let (al_idx, _, _) = resolve_func(ctx.func_table, \"array_length\")\n        let mut nl = ce(buf, array_get(args, 0), local_names, next_local, ctx, ld)\n        emit_call(buf, al_idx)\n        nl\n      }\n      else if string_equals(fname, \"bytes_get\") {\n        // bytes_get = array_get (same layout)\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \"array_get\")\n        let mut nl = ce(buf, array_get(args, 0), local_names, next_local, ctx, ld)\n        nl = ce(buf, array_get(args, 1), local_names, nl, ctx, ld)\n        emit_call(buf, ag_idx)\n        nl\n      }\n      else if string_equals(fname, \"eq\") {\n        // eq(a, b) = a == b (inline: i64.eq + extend)\n        let mut nl = ce(buf, array_get(args, 0), local_names, next_local, ctx, ld)\n        nl = ce(buf, array_get(args, 1), local_names, nl, ctx, ld)\n        emit_i64_eq(buf)\n        emit_i64_extend_i32_s(buf)\n        nl\n      }\n      else if string_equals(fname, \"not\") {\n        // not(x) = x == 0 (inline: i64.eqz + extend)\n        let nl = ce(buf, array_get(args, 0), local_names, next_local, ctx, ld)\n        emit_i64_eqz(buf)\n        emit_i64_extend_i32_s(buf)\n        nl\n      }\n      else if string_equals(fname, \"double_to_i64_bits\") {\n        // double_to_i64_bits(x) = identity (floats are already stored as i64 bits)\n        ce(buf, array_get(args, 0), local_names, next_local, ctx, ld)\n      }\n      else if string_equals(fname, \"string_ends_with\") {\n        // Direct wasm builtin call (func 24)\n        let mut nl = ce(buf, array_get(args, 0), local_names, next_local, ctx, ld)\n        nl = ce(buf, array_get(args, 1), local_names, nl, ctx, ld)\n        emit_call(buf, 24)\n        nl\n      }\n      else if string_equals(fname, \"string_last_index_of\") {\n        // Direct wasm builtin call (func 25)\n        let mut nl = ce(buf, array_get(args, 0), local_names, next_local, ctx, ld)\n        nl = ce(buf, array_get(args, 1), local_names, nl, ctx, ld)\n        emit_call(buf, 25)\n        nl\n      }\n      else {\n      let fn_len2 = array_length(ctx.func_table.names)\n      let mut __tr_j = 0\n      let mut __tr_result = -1\n      while __tr_j < fn_len2 {\n        if string_equals(array_get(ctx.func_table.names, __tr_j), fname) {\n          __tr_result = __tr_j\n          __tr_j = fn_len2\n        } else {\n          __tr_j = __tr_j + 1\n        }\n      }\n      let fn_idx_in_list = __tr_result\n      if fn_idx_in_list >= 0 {\n        let fidx = array_get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = array_get(ctx.func_table.returns, fn_idx_in_list)\n        let mut nl = next_local\n        let mut ci = 0\n        while ci < array_length(args) {\n          nl = ce(buf, array_get(args, ci), local_names, nl, ctx, ld)\n          ci = ci + 1\n        }\n        if ctx.func_offset > 0 {\n          if fidx >= ctx.func_offset {\n            emit_i64_const(buf, 0)\n          }\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        let local_idx2 = resolve_local(local_names, fname, \"call\")\n        let num_args = array_length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        array_push(local_names, \"__fn_val\")\n        array_push(local_names, \"__slot\")\n        array_push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          nl = ce(buf, array_get(args, ci), local_names, nl, ctx, ld)\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n        nl\n      }\n      } // close ctor_lookup else\n  } else {\n      let num_args = array_length(args)\n      let fn_val_local = next_local\n      let slot_local = next_local + 1\n      let env_local = next_local + 2\n      let mut nl = next_local + 3\n      array_push(local_names, \"__fn_val\")\n      array_push(local_names, \"__slot\")\n      array_push(local_names, \"__env\")\n      nl = ce(buf, callee, local_names, nl, ctx, ld)\n      emit_local_set(buf, fn_val_local)\n      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n      let mut ci = 0\n      while ci < num_args {\n        nl = ce(buf, array_get(args, ci), local_names, nl, ctx, ld)\n        ci = ci + 1\n      }\n      emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n      nl\n  }\n}\n\nlet compile_match = (\n  buf: Array[Int], expr: Expr,\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtx, ld: Int,\n  ce: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }\n) -> Int with { Error } {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  array_push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = array_length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = array_length(local_names)\n  while ai < num_cond_arms {\n    array_truncate(local_names, names_len_at_match)\n    let __cond_p = get_arm_pat(array_get(__match_arms, ai))\n    let __cond_done = if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else { if is_pbool(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, if get_pbool_value(__cond_p) { 1 } else { 0 })\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else { if is_pctor(__cond_p) {\n      let cname_cond = get_pctor_name(__cond_p)\n      let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n      let expected_tag = if ctor_ci >= 0 { array_get(ctx.ctor_table.tags, ctor_ci) } else { -1 }\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 0)\n      emit_i32_const(buf, expected_tag)\n      emit_i32_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else { if is_pstring(__cond_p) {\n      let sval = get_pstring_value(__cond_p)\n      let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n      if str_idx >= 0 {\n        emit_local_get(buf, scrut_local)\n        emit_str_ref(buf, array_get(ctx.str_table.offsets, str_idx), array_get(ctx.str_table.lengths, str_idx))\n        emit_call(buf, 4)\n        emit_i64_const(buf, 1)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n      }\n      0\n    } else { 0 } } } }\n    let __arm_body = get_arm_body(array_get(__match_arms, ai))\n    let ld_arm = if ld >= 0 { ld + ai + 1 } else { -1 }\n    let arm_nl = if is_pctor(__cond_p) {\n      let cargs_bind = get_pctor_args(__cond_p)\n      let mut cbi = 0\n      while cbi < array_length(cargs_bind) {\n        let __sub_p = array_get(cargs_bind, cbi)\n        if is_pbind(__sub_p) {\n          let pname = get_pbind_name(__sub_p)\n          let fl = array_length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, fl)\n          array_push(local_names, pname)\n        }\n        cbi = cbi + 1\n      }\n      ce(buf, __arm_body, local_names, array_length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl { max_nl = arm_nl }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  array_truncate(local_names, names_len_at_match)\n  let ld_catch = if ld >= 0 { ld + num_cond_arms } else { -1 }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = array_get(__match_arms, catchall_idx)\n    let __catch_p = get_arm_pat(__catch_arm)\n    let __catch_body = get_arm_body(__catch_arm)\n    0\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = array_length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      array_push(local_names, bname)\n      ce(buf, __catch_body, local_names, array_length(local_names), ctx, ld_catch)\n    } else { if is_pctor(__catch_p) {\n      let cargs = get_pctor_args(__catch_p)\n      let mut cbi2 = 0\n      while cbi2 < array_length(cargs) {\n        let __sub_p2 = array_get(cargs, cbi2)\n        if is_pbind(__sub_p2) {\n          let pname = get_pbind_name(__sub_p2)\n          let fl2 = array_length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi2 * 8)\n          emit_local_set(buf, fl2)\n          array_push(local_names, pname)\n        }\n        cbi2 = cbi2 + 1\n      }\n      ce(buf, __catch_body, local_names, array_length(local_names), ctx, ld_catch)\n    } else { if is_ptuple(__catch_p) {\n      let pats = get_ptuple_pats(__catch_p)\n      let ptr_local2 = array_length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, ptr_local2)\n      array_push(local_names, \"__tup_ptr2\")\n      let mut pi2 = 0\n      while pi2 < array_length(pats) {\n        let __tp = array_get(pats, pi2)\n        if is_pbind(__tp) {\n          let pname = get_pbind_name(__tp)\n          let field_l = array_length(local_names)\n          emit_local_get(buf, ptr_local2)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, pi2 * 8)\n          emit_local_set(buf, field_l)\n          array_push(local_names, pname)\n          0\n        } else { if is_pwild(__tp) {\n          0\n        } else {\n          throw(\"unsupported pattern in tuple destructure\")\n        } }\n        pi2 = pi2 + 1\n      }\n      ce(buf, __catch_body, local_names, array_length(local_names), ctx, ld_catch)\n    } else {\n      ce(buf, __catch_body, local_names, array_length(local_names), ctx, ld_catch)\n    } } }\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  if catch_nl > max_nl { max_nl = catch_nl }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  // Pad local_names to stay in sync with max_nl.\n  // After arm truncation, array_length(local_names) < max_nl.\n  // Without padding, subsequent ELet would push names at wrong indices.\n  while array_length(local_names) < max_nl {\n    array_push(local_names, \"\")\n  }\n  max_nl\n}\n\nlet compile_lambda = (\n  buf: Array[Int], params: Array[(String, Option[TypeExpr])], fn_body: Expr,\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtx, ld: Int,\n  compile_fn: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }\n) -> Int with { Error } {\n  let param_names_arr = array_slice([\"\"], 0, 0)\n  let mut pi = 0\n  while pi < array_length(params) {\n    let (pname, _) = array_get(params, pi)\n    array_push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = array_concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = array_length(captures)\n  let user_params = array_length(params)\n\n  let lam_buf = bytebuf_new()\n  let lam_locals = array_slice([\"\"], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = array_get(params, lpi)\n    array_push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  array_push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n\n  let lam_ref_cells = array_slice([\"\"], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = array_get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    array_push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      array_push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    thunk_names: ctx.thunk_names\n  }\n  let final_lam_nl = compile_fn(\n    lam_buf, fn_body, lam_locals, lam_nl,\n    lam_ctx, -1\n  )\n\n  let lambda_idx = array_length(ctx.lambda_table.bodies)\n  array_push(ctx.lambda_table.bodies, lam_buf)\n  array_push(ctx.lambda_table.param_counts, user_params + 1)\n  array_push(ctx.lambda_table.captures, captures)\n  let extra_lam = if final_lam_nl > (user_params + 1) { final_lam_nl - (user_params + 1) } else { 0 }\n  array_push(ctx.lambda_table.meta_i32, 0)\n  array_push(ctx.lambda_table.meta_i64, extra_lam)\n\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot << 2) | 2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    array_push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = array_get(captures, csi)\n      // Enhanced error: include all captures in diagnostic\n      let mut __cap_resolve = -1\n      let mut __cri = array_length(local_names) - 1\n      while __cri >= 0 {\n        if string_equals(array_get(local_names, __cri), cap_name) {\n          __cap_resolve = __cri\n          __cri = -1\n        } else { __cri = __cri - 1 }\n      }\n      if __cap_resolve >= 0 {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __cap_resolve)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      } else {\n        // Spurious capture: variable is defined inside the lambda body\n        // (e.g. via let-tuple destructure in a match arm). The lambda body\n        // will shadow this capture slot with the real value from compile_match.\n        // Emit zero placeholder.\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      }\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\n// === Expression compiler (linear memory backend) ===\n\nlet rec compile_expr = (\n  buf: Array[Int],\n  expr: Expr,\n  local_names: Array[String],\n  next_local: Int,\n  ctx: CompileCtx,\n  ld: Int  // loop depth: -1 = not in loop, 0+ = depth from while's loop block\n) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n      // EInt\n      let n = get_eint_value(expr)\n      emit_i64_const(buf, n)\n      next_local\n  } else if __tag == 1 {\n      // EBool\n      let b_val = get_ebool_value(expr)\n      emit_i64_const(buf, if b_val { 1 } else { 0 })\n      next_local\n  } else if __tag == 2 {\n      // EFloat\n      let v = get_efloat_value(expr)\n      let bits = double_to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n  } else if __tag == 3 {\n      // EString\n      let s = get_estring_value(expr)\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, array_get(ctx.str_table.offsets, idx), array_get(ctx.str_table.lengths, idx))\n      next_local\n  } else if __tag == 4 {\n      // EIdent\n      let name = get_eident_name(expr)\n      // Try local first, then check if it's a top-level function as value\n      let len = array_length(local_names)\n      let mut __tl_i = len - 1\n      let mut __tl_result = -1\n      while __tl_i >= 0 {\n        if string_equals(array_get(local_names, __tl_i), name) {\n          __tl_result = __tl_i\n          __tl_i = -1  // break\n        } else {\n          __tl_i = __tl_i - 1\n        }\n      }\n      let local_idx = __tl_result\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          emit_local_get(buf, local_idx)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = array_get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          array_push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n        let fn_len = array_length(ctx.func_table.names)\n        let mut __tf_j = 0\n        let mut __tf_result = -1\n        while __tf_j < fn_len {\n          if string_equals(array_get(ctx.func_table.names, __tf_j), name) {\n            __tf_result = __tf_j\n            __tf_j = fn_len  // break\n          } else {\n            __tf_j = __tf_j + 1\n          }\n        }\n        if __tf_result < 0 {\n            let mut diag = string_concat(\"undefined variable (ident): \", name)\n            diag = string_concat(diag, \" | locals=[\")\n            let mut di = 0\n            while di < len {\n              if di > 0 { diag = string_concat(diag, \",\") }\n              diag = string_concat(diag, array_get(local_names, di))\n              di = di + 1\n            }\n            diag = string_concat(diag, \"]\")\n            throw(diag)\n        }\n        let fni = __tf_result\n        let fidx = array_get(ctx.func_table.indices, fni)\n        if array_contains_str(ctx.thunk_names, name) {\n          // Thunk: call the zero-param function to get its value\n          emit_i64_const(buf, 0)  // env=0\n          emit_call(buf, fidx)\n          next_local\n        } else {\n          let table_slot = fidx - ctx.func_offset\n          emit_i64_const(buf, (table_slot << 2) | 2)\n          next_local\n        }\n        }\n      }\n  } else if __tag == 5 {\n      // EBinOp\n      let op = get_ebinop_op(expr)\n      let lhs = get_ebinop_lhs(expr)\n      let rhs = get_ebinop_rhs(expr)\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      emit_binop_op(buf, op)\n      nl2\n  } else if __tag == 6 {\n      // EUnaryOp\n      let op = get_eunaryop_op(expr)\n      let operand = get_eunaryop_expr(expr)\n      if string_equals(op, \"-\") {\n        emit_i64_const(buf, 0)\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_i64_sub(buf)\n        nl\n      } else if string_equals(op, \"!\") {\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        // Bool: true=1, false=0. Use eqz to negate.\n        emit_i64_eqz(buf)\n        emit_i64_extend_i32_s(buf)\n        nl\n      } else {\n        throw(string_concat(\"unsupported unary op: \", op))\n      }\n  } else if __tag == 7 {\n      // EIf\n      let cond = get_eif_cond(expr)\n      let then_e = get_eif_then(expr)\n      let else_e = get_eif_else(expr)\n      let nl1 = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      emit_if_i64(buf)\n      let ld_inner = if ld >= 0 { ld + 1 } else { -1 }\n      let names_len_before = array_length(local_names)\n      let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\n      emit_else(buf)\n      array_truncate(local_names, names_len_before)\n      let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\n      emit_end(buf)\n      let max_nl_if = if nl2 > nl3 { nl2 } else { nl3 }\n      // Pad local_names to stay in sync with max next_local\n      while array_length(local_names) < max_nl_if {\n        array_push(local_names, \"\")\n      }\n      max_nl_if\n  } else if __tag == 8 {\n      // ECall\n      compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 9 {\n      // ELet\n      let name = get_elet_name(expr)\n      let value = get_elet_val(expr)\n      let body = get_elet_body(expr)\n      let local_idx = next_local\n      array_push(local_names, name)\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_local_set(buf, local_idx)\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      nl2\n  } else if __tag == 10 {\n      // ELetRec\n      let name = get_eletrec_name(expr)\n      let value = get_eletrec_val(expr)\n      let body = get_eletrec_body(expr)\n      let local_idx = next_local\n      array_push(local_names, name)\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_local_set(buf, local_idx)\n      // Backpatch self-reference in closure for recursive let rec\n      if is_efn(value) {\n          let params = get_efn_params(value)\n          let fn_body = get_efn_body(value)\n          let param_names_bp = array_slice([\"\"], 0, 0)\n          let mut bpi = 0\n          while bpi < array_length(params) {\n            let (pn, _) = array_get(params, bpi)\n            array_push(param_names_bp, pn)\n            bpi = bpi + 1\n          }\n          let caps = collect_free_vars(fn_body, param_names_bp, array_concat(ctx.func_table.names, ctx.ctor_table.names))\n          let mut self_cap_idx = -1\n          let mut bci = 0\n          while bci < array_length(caps) {\n            if string_equals(array_get(caps, bci), name) {\n              self_cap_idx = bci\n            }\n            bci = bci + 1\n          }\n          if self_cap_idx >= 0 {\n            emit_local_get(buf, local_idx)\n            emit_i64_const(buf, -4)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, local_idx)\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n          }\n          0\n      } else { 0 }\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      nl2\n  } else if __tag == 11 {\n      // ELetMut\n      let name = get_eletmut_name(expr)\n      let value = get_eletmut_val(expr)\n      let body = get_eletmut_body(expr)\n      let local_idx = next_local\n      array_push(local_names, name)\n      if is_mut_captured_in(body, name) {\n        array_push(ctx.ref_cell_names, name)\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_tee(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 8)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        emit_i64_store(buf, 3, 0)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        nl2\n      } else {\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        emit_local_set(buf, local_idx)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        nl2\n      }\n  } else if __tag == 12 {\n      // EAssign\n      let name = get_eassign_name(expr)\n      let value = get_eassign_val(expr)\n      let body = get_eassign_body(expr)\n      let idx = resolve_local(local_names, name, \"assign\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_i64_store(buf, 3, 0)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      } else {\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_local_set(buf, idx)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      }\n  } else if __tag == 13 {\n      // EAssignOp\n      let name = get_eassignop_name(expr)\n      let op = get_eassignop_op(expr)\n      let value = get_eassignop_val(expr)\n      let body = get_eassignop_body(expr)\n      let idx = resolve_local(local_names, name, \"assignop\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_assignop_op(buf, op)\n        emit_i64_store(buf, 3, 0)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      } else {\n        emit_local_get(buf, idx)\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_assignop_op(buf, op)\n        emit_local_set(buf, idx)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      }\n  } else if __tag == 14 {\n      // ESeq\n      let first = get_eseq_first(expr)\n      let second = get_eseq_second(expr)\n      let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n      emit_drop(buf)\n      compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else if __tag == 15 {\n      // ETuple\n      let __tuple_elems = get_etuple_elems(expr)\n      // Allocate N*8 bytes on heap, store each element as i64\n      let num_elems = array_length(__tuple_elems)\n      let alloc_size = num_elems * 8\n      // ptr_local stores heap ptr as i64 (user locals are i64)\n      let ptr_local = next_local\n      array_push(local_names, \"__tuple_ptr\")\n      let mut nl = next_local + 1\n      // ptr = heap_ptr as i64; heap_ptr += alloc_size\n      emit_global_get(buf, 0)  // i32\n      emit_i64_extend_i32_u(buf)  // -> i64\n      emit_local_tee(buf, ptr_local)  // save as i64\n      emit_i32_wrap_i64(buf)  // back to i32 for arithmetic\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      // Store each element\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)  // ptr as i32 for store\n        nl = compile_expr(buf, array_get(__tuple_elems, ti), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      // Return ptr as i64 (already stored as i64)\n      emit_local_get(buf, ptr_local)\n      nl\n  } else if __tag == 16 {\n      // EMatch\n      compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 17 {\n      // EArray\n      let elems = get_earray_elems(expr)\n      // Compile [a, b, c] as: let arr = array_new(); array_push(arr, a); ...\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"array_push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      array_push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < array_length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = compile_expr(buf, array_get(elems, ei), local_names, nl, ctx, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n  } else if __tag == 18 {\n      // EForIn\n      let var_name = get_eforin_name(expr)\n      let iter_expr = get_eforin_iter(expr)\n      let body = get_eforin_body(expr)\n      // for x in arr { body } => let arr = iter; let mut i = 0; while i < array_length(arr) { let x = array_get(arr, i); body; i = i + 1 }\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \"array_length\")\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \"array_get\")\n      // Compile iterator and store\n      let arr_local = next_local\n      let nl1 = compile_expr(buf, iter_expr, local_names, next_local + 1, ctx, ld)\n      emit_local_set(buf, arr_local)\n      array_push(local_names, \"__for_arr\")\n      // Counter local\n      let i_local = nl1\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_local)\n      array_push(local_names, \"__for_i\")\n      let nl2 = nl1 + 1\n      // block { loop {\n      emit_block_void(buf)\n        emit_loop_void(buf)\n          // if i >= array_length(arr) then break\n          emit_local_get(buf, i_local)\n          emit_local_get(buf, arr_local)\n          emit_call(buf, arr_len_idx)\n          emit_i64_ge_s(buf)\n          emit_i64_extend_i32_s(buf)\n          emit_i32_wrap_i64(buf)\n          emit_br_if(buf, 1)\n          // let var_name = array_get(arr, i)\n          let var_local = nl2\n          emit_local_get(buf, arr_local)\n          emit_local_get(buf, i_local)\n          emit_call(buf, arr_get_idx)\n          emit_local_set(buf, var_local)\n          array_push(local_names, var_name)\n          let nl3 = nl2 + 1\n          // body (ld+1 for break/continue label offsets inside loop)\n          let nl4 = compile_expr(buf, body, local_names, nl3, ctx, ld + 1)\n          emit_drop(buf)\n          // i = i + 1\n          emit_local_get(buf, i_local)\n          emit_i64_const(buf, 1)\n          emit_i64_add(buf)\n          emit_local_set(buf, i_local)\n          emit_br(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl4\n  } else if __tag == 19 {\n      // EWhile\n      let cond = get_ewhile_cond(expr)\n      let body = get_ewhile_body(expr)\n      emit_block_void(buf)\n        emit_loop_void(buf)\n          let nl1 = compile_expr(buf, cond, local_names, next_local, ctx, ld + 1)\n          emit_i64_eqz(buf)\n          emit_br_if(buf, 1)\n          let nl2 = compile_expr(buf, body, local_names, nl1, ctx, ld + 1)\n          emit_drop(buf)\n          emit_br(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl2\n  } else if __tag == 20 {\n      // EBreak\n      emit_br(buf, ld + 1)\n      emit_i64_const(buf, 0)\n      next_local\n  } else if __tag == 21 {\n      // EContinue\n      emit_br(buf, ld)\n      emit_i64_const(buf, 0)\n      next_local\n  } else if __tag == 22 {\n      // EUnit\n      emit_i64_const(buf, 0)\n      next_local\n  } else if __tag == 23 {\n      // EThrow\n      let msg_expr = get_ethrow_expr(expr)\n      let nl = compile_expr(buf, msg_expr, local_names, next_local, ctx, ld)\n      emit_drop(buf)\n      bytebuf_push(buf, 0)  // unreachable\n      nl\n  } else if __tag == 24 {\n      // EFn\n      compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else {\n      // Handle EDot and ERecord (tag == -1)\n      match expr {\n        EDot(obj, field) => {\n          // Struct field access: obj must be a tagged heap ptr\n          // Find struct and field index\n          let mut si_search = 0\n          let mut field_idx = -1\n          while si_search < array_length(ctx.ctor_table.struct_names) {\n            let fnames = array_get(ctx.ctor_table.struct_field_names, si_search)\n            let mut fi = 0\n            while fi < array_length(fnames) {\n              if string_equals(array_get(fnames, fi), field) {\n                field_idx = fi\n                fi = array_length(fnames)\n              } else {\n                fi = fi + 1\n              }\n            }\n            if field_idx >= 0 {\n              si_search = array_length(ctx.ctor_table.struct_names)\n            } else {\n              si_search = si_search + 1\n            }\n          }\n          if field_idx < 0 {\n            throw(string_concat(\"unknown struct field: \", field))\n          }\n          // Compile obj, untag ptr, load field\n          let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n          // Untag: ptr & ~1 (clear low bit), then wrap to i32\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          // Load field at offset 8 + field_idx * 8\n          emit_i64_load(buf, 3, 8 + field_idx * 8)\n          nl1\n        },\n        ERecord(fields) => {\n          // Record literal: allocate heap [tag_i32 | field_count_i32 | field_0 | field_1 | ...]\n          // Use tag 0 for anonymous records (struct ctor will wrap via ECall)\n          let flen = array_length(fields)\n          let obj_size = 8 + flen * 8\n          let ptr_local = next_local\n          array_push(local_names, \"__rec_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_local)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, obj_size)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          // Store tag=0 at offset 0\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 0)\n          // Store field_count at offset 4\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, flen)\n          emit_i32_store(buf, 2, 4)\n          // Compile and store each field\n          let mut nl_r = next_local + 1\n          let mut ri = 0\n          while ri < flen {\n            let (_, fexpr) = array_get(fields, ri)\n            nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n            let val_local = nl_r\n            array_push(local_names, \"__rec_val\")\n            emit_local_set(buf, val_local)\n            nl_r = nl_r + 1\n            emit_local_get(buf, ptr_local)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, val_local)\n            emit_i64_store(buf, 3, 8 + ri * 8)\n            ri = ri + 1\n          }\n          // Return ptr | 1\n          emit_local_get(buf, ptr_local)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          nl_r\n        },\n        EForIn(_, _, _) => throw(\"unsupported expression in codegen: EForIn\"),\n        EHandle(body, _) => {\n          // Compile body only, ignore error handler (stub for S5)\n          compile_expr(buf, body, local_names, next_local, ctx, ld)\n        },\n        ELabeledArg(_, _, _) => throw(\"unsupported expression in codegen: ELabeledArg\"),\n        _ => throw(\"unsupported expression in codegen: unknown\")\n      }\n  }\n}\n\n\n// === Module compiler (non-WASI, for --invoke) ===\n\nexport let compile_module = (stmts: Array[Stmt]) -> Bytes with { Error } {\n  let fn_names_list = array_slice([\"\"], 0, 0)\n  let fn_param_counts = array_slice([0], 0, 0)\n  let export_names = array_slice([\"\"], 0, 0)\n  let export_indices = array_slice([0], 0, 0)\n  let fn_bodies_list = array_slice([EInt(0)], 0, 0)\n  let fn_param_names_list = array_slice([array_slice([\"\"], 0, 0)], 0, 0)\n\n  let mut i = 0\n  while i < array_length(stmts) {\n    let stmt = array_get(stmts, i)\n    match stmt {\n      SLet(is_export, _, name, _, expr) => {\n        match expr {\n          EFn(_, _, params, _, _, body) => {\n            let cur_idx = array_length(fn_names_list)\n            array_push(fn_names_list, name)\n            array_push(fn_param_counts, array_length(params))\n            array_push(fn_bodies_list, body)\n            let pnames = array_slice([\"\"], 0, 0)\n            let mut pi = 0\n            while pi < array_length(params) {\n              let (pname, _) = array_get(params, pi)\n              array_push(pnames, pname)\n              pi = pi + 1\n            }\n            array_push(fn_param_names_list, pnames)\n            if is_export {\n              array_push(export_names, name)\n              array_push(export_indices, cur_idx)\n            }\n            0\n          },\n          _ => 0\n        }\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n\n  let num_funcs = array_length(fn_names_list)\n  if num_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n\n  let fn_indices_list = array_slice([0], 0, 0)\n  let fn_returns_list = array_slice([0], 0, 0)\n  let mut fi = 0\n  while fi < num_funcs {\n    array_push(fn_indices_list, fi)\n    array_push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n\n  let type_defs = array_slice([0], 0, 0)\n  let mut ti = 0\n  while ti < num_funcs {\n    array_push(type_defs, array_get(fn_param_counts, ti))\n    array_push(type_defs, 1)\n    ti = ti + 1\n  }\n\n  let type_indices = array_slice([0], 0, 0)\n  let mut tii = 0\n  while tii < num_funcs {\n    array_push(type_indices, tii)\n    tii = tii + 1\n  }\n\n  // Lambda accumulators (not used in non-WASI compile_module for now)\n  let lt_m = LambdaTable::{\n    bodies: array_slice([array_slice([0], 0, 0)], 0, 0),\n    param_counts: array_slice([0], 0, 0),\n    captures: array_slice([array_slice([\"\"], 0, 0)], 0, 0),\n    meta_i32: array_slice([0], 0, 0),\n    meta_i64: array_slice([0], 0, 0)\n  }\n\n  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)\n  let local_counts = array_slice([0], 0, 0)\n  let mut bi = 0\n  while bi < num_funcs {\n    let body = array_get(fn_bodies_list, bi)\n    let param_names = array_get(fn_param_names_list, bi)\n    let body_buf = bytebuf_new()\n    let local_names = array_slice([\"\"], 0, 0)\n    let mut pi = 0\n    while pi < array_length(param_names) {\n      array_push(local_names, array_get(param_names, pi))\n      pi = pi + 1\n    }\n    let param_count = array_length(param_names)\n    let empty_strs = array_slice([\"\"], 0, 0)\n    let empty_offs = array_slice([0], 0, 0)\n    let empty_lens = array_slice([0], 0, 0)\n    let compile_ctx = CompileCtx::{\n      func_table: FuncTable::{ names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list },\n      str_table: StrTable::{ strs: empty_strs, offsets: empty_offs, lengths: empty_lens },\n      lambda_table: lt_m,\n      num_user_funcs: num_funcs, func_offset: 0,\n      ref_cell_names: array_slice([\"\"], 0, 0),\n      ctor_table: CtorTable::{ names: array_slice([\"\"], 0, 0), tags: array_slice([0], 0, 0), field_counts: array_slice([0], 0, 0), type_names: array_slice([\"\"], 0, 0), struct_names: array_slice([\"\"], 0, 0), struct_field_names: array_slice([array_slice([\"\"], 0, 0)], 0, 0) },\n      thunk_names: array_slice([\"\"], 0, 0)\n    }\n    let final_nl = compile_expr(\n      body_buf, body, local_names, param_count, compile_ctx, -1\n    )\n    array_push(bodies, body_buf)\n    let extra = if final_nl > param_count { final_nl - param_count } else { 0 }\n    array_push(local_counts, extra)\n    bi = bi + 1\n  }\n\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section_multi(out, type_defs)\n  emit_function_section(out, type_indices)\n\n  if array_length(export_names) > 0 {\n    emit_export_section_multi(out, export_names, export_indices)\n  }\n\n  emit_code_section_with_locals(out, bodies, local_counts)\n  bytebuf_to_bytes(out)\n}\n\n// === WASI Module compiler ===\n// Memory layout:\n//   0-7: iovec struct\n//   8-11: nwritten\n//   16-47: digit buffer (itoa + newline)\n//   48-63: reserved\n//   64+: string literal data\n//   after strings: heap (bump allocator, global 0 = heap_ptr)\n\n// Generate __print_i64 body (func 1)\n// Param: 0=val(i64)\n// Extra locals (i32 first, then i64): 1=is_neg(i32), 2=pos(i32), 3=digit(i32), 4=abs_val(i64)\nlet gen_print_i64_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_i32_const(b, 46)\n  emit_local_set(b, 2)\n  emit_i32_const(b, 47)\n  emit_i32_const(b, 10)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_i64_lt_s(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 1)\n  emit_if_i64(b)\n    emit_i64_const(b, 0)\n    emit_local_get(b, 0)\n    emit_i64_sub(b)\n  emit_else(b)\n    emit_local_get(b, 0)\n  emit_end(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 4)\n  emit_i64_eqz(b)\n  emit_if_void(b)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 48)\n    emit_i32_store8(b, 0, 0)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 1)\n    emit_i32_sub(b)\n    emit_local_set(b, 2)\n  emit_end(b)\n  emit_block_void(b)\n    emit_loop_void(b)\n      emit_local_get(b, 4)\n      emit_i64_eqz(b)\n      emit_br_if(b, 1)\n      emit_local_get(b, 4)\n      emit_i64_const(b, 10)\n      emit_i64_rem_s(b)\n      emit_i32_wrap_i64(b)\n      emit_local_set(b, 3)\n      emit_local_get(b, 2)\n      emit_local_get(b, 3)\n      emit_i32_const(b, 48)\n      emit_i32_add(b)\n      emit_i32_store8(b, 0, 0)\n      emit_local_get(b, 2)\n      emit_i32_const(b, 1)\n      emit_i32_sub(b)\n      emit_local_set(b, 2)\n      emit_local_get(b, 4)\n      emit_i64_const(b, 10)\n      emit_i64_div_s(b)\n      emit_local_set(b, 4)\n      emit_br(b, 0)\n    emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_if_void(b)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 45)\n    emit_i32_store8(b, 0, 0)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 1)\n    emit_i32_sub(b)\n    emit_local_set(b, 2)\n  emit_end(b)\n  emit_i32_const(b, 0)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 47)\n  emit_local_get(b, 2)\n  emit_i32_sub(b)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n  b\n}\n\n// Generate __print_str body (func 2)\n// local 0: packed(i64), local 1: offset(i32), local 2: length(i32)\nlet gen_print_str_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_i32_const(b, 0)\n  emit_local_get(b, 1)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_local_get(b, 2)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n  b\n}\n\n// Generate __str_len body (func 3): (packed: i64) -> i64\n// Returns lower 32 bits as i64\nlet gen_str_len_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)  // 0xFFFFFFFF\n  emit_i64_and(b)\n  b\n}\n\n// Generate __str_eq body (func 4): (a: i64, b: i64) -> i64\n// Compare string contents byte-by-byte\n// locals: 0=a(i64), 1=b(i64), 2=len_a(i32), 3=len_b(i32),\n//         4=off_a(i32), 5=off_b(i32), 6=i(i32)\nlet gen_str_eq_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // len_a = a & 0xFFFFFFFF\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // len_b = b & 0xFFFFFFFF\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // if len_a != len_b, return false (0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_ne(b)\n  emit_if_i64(b)\n    emit_i64_const(b, 0)\n  emit_else(b)\n    // off_a = (a >> 32) as i32\n    emit_local_get(b, 0)\n    emit_i64_const(b, 32)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 4)\n    // off_b = (b >> 32) as i32\n    emit_local_get(b, 1)\n    emit_i64_const(b, 32)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 5)\n    // i = 0\n    emit_i32_const(b, 0)\n    emit_local_set(b, 6)\n    // loop: compare bytes\n    emit_block_i64(b)\n      emit_block_void(b)\n        emit_loop_void(b)\n          // if i >= len_a, break (all matched)\n          emit_local_get(b, 6)\n          emit_local_get(b, 2)\n          emit_i32_ge_u(b)\n          emit_br_if(b, 1)  // break to inner block_void\n          // if mem[off_a+i] != mem[off_b+i], return 0\n          emit_local_get(b, 4)\n          emit_local_get(b, 6)\n          emit_i32_add(b)\n          emit_i32_load8_u(b, 0, 0)\n          emit_local_get(b, 5)\n          emit_local_get(b, 6)\n          emit_i32_add(b)\n          emit_i32_load8_u(b, 0, 0)\n          emit_i32_ne(b)\n          emit_if_void(b)\n            emit_i64_const(b, 0)  // false\n            emit_br(b, 3)  // break to block_i64 with false\n          emit_end(b)\n          // i++\n          emit_local_get(b, 6)\n          emit_i32_const(b, 1)\n          emit_i32_add(b)\n          emit_local_set(b, 6)\n          emit_br(b, 0)  // continue loop\n        emit_end(b)\n      emit_end(b)\n      // All bytes matched — return true (1)\n      emit_i64_const(b, 1)\n    emit_end(b)\n  emit_end(b)\n  b\n}\n\n// Generate __str_concat body (func 5): (a: i64, b: i64) -> i64\n// Allocate new string, copy bytes, return packed ref\n// locals: 0=a(i64), 1=b(i64), 2=len_a(i32), 3=len_b(i32),\n//         4=off_a(i32), 5=off_b(i32), 6=new_ptr(i32), 7=new_len(i32)\nlet gen_str_concat_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // len_a = a & 0xFFFFFFFF\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // len_b\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // off_a = (a >> 32) as i32\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  // off_b\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  // new_len = len_a + len_b\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_add(b)\n  emit_local_set(b, 7)\n  // new_ptr = heap_ptr; heap_ptr += new_len\n  emit_global_get(b, 0)\n  emit_local_tee(b, 6)\n  emit_local_get(b, 7)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  // memory.copy(new_ptr, off_a, len_a)\n  emit_local_get(b, 6)  // dest\n  emit_local_get(b, 4)  // src\n  emit_local_get(b, 2)  // len\n  emit_memory_copy(b)\n  // memory.copy(new_ptr + len_a, off_b, len_b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 2)\n  emit_i32_add(b)   // dest = new_ptr + len_a\n  emit_local_get(b, 5)  // src\n  emit_local_get(b, 3)  // len\n  emit_memory_copy(b)\n  // Return packed ref: (new_ptr << 32) | new_len\n  emit_local_get(b, 6)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 7)\n  emit_i64_extend_i32_u(b)\n  emit_i64_or(b)\n  b\n}\n\n// Generate __arr_new body (func 6): () -> i64\n// Create empty array: [cap=8(i32), len=0(i32), data_ptr(i32)]\n// Header: 12 bytes. Data: cap * 8 bytes.\n// Returns header ptr as i64.\nlet gen_arr_new_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // local 0: header_ptr (i32)\n  // Allocate header (12 bytes) + data (8*8 = 64 bytes) = 76 bytes\n  emit_global_get(b, 0)\n  emit_local_tee(b, 0)\n  emit_i32_const(b, 76)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  // header[0] = cap = 8\n  emit_local_get(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n  // header[4] = len = 0\n  emit_local_get(b, 0)\n  emit_i32_const(b, 0)\n  emit_i32_store(b, 2, 4)\n  // header[8] = data_ptr = header_ptr + 12\n  emit_local_get(b, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 8)\n  // Return header_ptr as i64\n  emit_local_get(b, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// Generate __arr_len body (func 7): (arr: i64) -> i64\n// Read header[4] = length\nlet gen_arr_len_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)  // header[4] = length\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// Generate __arr_get body (func 8): (arr: i64, idx: i64) -> i64\n// Read data[idx * 8]\n// local 0: arr(i64), local 1: idx(i64), local 2: data_ptr(i32)\nlet gen_arr_get_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // data_ptr = header[8]\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 2)\n  // load data_ptr + idx*8\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  // i32.shl\n  bytebuf_push(b, 116)  // 0x74 i32.shl\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 0)\n  b\n}\n\n// Generate __arr_push body (func 9): (arr: i64, val: i64) -> void\n// Append val to array, grow if needed\n// local 0: arr(i64), local 1: val(i64), local 2: hdr(i32),\n// local 3: cap(i32), local 4: len(i32), local 5: data_ptr(i32),\n// local 6: new_data(i32), local 7: new_cap(i32)\nlet gen_arr_push_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // hdr = arr as i32\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // cap = hdr[0]\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 3)\n  // len = hdr[4]\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  // data_ptr = hdr[8]\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 5)\n  // if len >= cap: grow\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n    // new_cap = cap * 2\n    emit_local_get(b, 3)\n    emit_i32_const(b, 2)\n    emit_i32_mul(b)\n    emit_local_set(b, 7)\n    // new_data = alloc(new_cap * 8)\n    emit_global_get(b, 0)\n    emit_local_tee(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    // memory.copy(new_data, data_ptr, len * 8)\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    // update header\n    emit_local_get(b, 2)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 0)  // cap = new_cap\n    emit_local_get(b, 2)\n    emit_local_get(b, 6)\n    emit_i32_store(b, 2, 8)  // data_ptr = new_data\n    // update local\n    emit_local_get(b, 6)\n    emit_local_set(b, 5)\n  emit_end(b)\n  // data[len] = val\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 1)\n  emit_i64_store(b, 3, 0)\n  // len++\n  emit_local_get(b, 2)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\n// Generate __arr_set body (func 10): (arr: i64, idx: i64, val: i64) -> void\n// local 0: arr(i64), local 1: idx(i64), local 2: val(i64), local 3: data_ptr(i32)\nlet gen_arr_set_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // data_ptr = header[8]\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  // data[idx*8] = val\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 2)\n  emit_i64_store(b, 3, 0)\n  b\n}\n\n// Generate __arr_slice body: (arr: i64, start: i64, end: i64) -> i64\n// Creates new array with elements from start to end\n// locals: 0=arr(i64), 1=start(i64), 2=end(i64), 3=hdr(i32), 4=src_data(i32),\n//   5=new_len(i32), 6=new_hdr(i32), 7=new_data(i32), 8=cap(i32)\nlet gen_arr_slice_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // hdr = arr as i32\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // src_data = hdr[8]\n  emit_local_get(b, 3)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 4)\n  // new_len = end - start (as i32)\n  emit_local_get(b, 2)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_sub(b)\n  emit_local_set(b, 5)\n  // cap = new_len + 8 (always at least 8, avoids 0-size alloc)\n  emit_local_get(b, 5)\n  emit_i32_const(b, 8)\n  emit_i32_add(b)\n  emit_local_set(b, 8)\n  // Allocate header (12 bytes) + data (cap * 8 bytes)\n  emit_global_get(b, 0)\n  emit_local_tee(b, 6)\n  emit_i32_const(b, 12)\n  emit_local_get(b, 8)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl (cap * 8)\n  emit_i32_add(b)  // 12 + cap * 8\n  emit_i32_add(b)  // heap_ptr + alloc_size\n  emit_global_set(b, 0)\n  // Set header: cap\n  emit_local_get(b, 6)\n  emit_local_get(b, 8)\n  emit_i32_store(b, 2, 0)\n  // Set header: len = new_len\n  emit_local_get(b, 6)\n  emit_local_get(b, 5)\n  emit_i32_store(b, 2, 4)\n  // new_data = new_hdr + 12\n  emit_local_get(b, 6)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_local_set(b, 7)\n  // Set header: data_ptr = new_data\n  emit_local_get(b, 6)\n  emit_local_get(b, 7)\n  emit_i32_store(b, 2, 8)\n  // memory.copy(new_data, src_data + start*8, new_len*8)\n  emit_local_get(b, 7)\n  emit_local_get(b, 4)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 5)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_memory_copy(b)\n  // Return new_hdr as i64\n  emit_local_get(b, 6)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// Generate __arr_concat body: (arr1: i64, arr2: i64) -> i64\n// Creates new array with all elements from both arrays\n// locals: 0=arr1(i64), 1=arr2(i64), 2=hdr1(i32), 3=hdr2(i32),\n//   4=len1(i32), 5=len2(i32), 6=data1(i32), 7=data2(i32),\n//   8=total_len(i32), 9=new_hdr(i32), 10=new_data(i32)\nlet gen_arr_concat_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // hdr1 = arr1 as i32\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // hdr2 = arr2 as i32\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // len1 = hdr1[4]\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  // len2 = hdr2[4]\n  emit_local_get(b, 3)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 5)\n  // data1 = hdr1[8]\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 6)\n  // data2 = hdr2[8]\n  emit_local_get(b, 3)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 7)\n  // total_len = len1 + len2\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_local_set(b, 8)\n  // Allocate new array: header (12) + total_len * 8\n  emit_global_get(b, 0)\n  emit_local_tee(b, 9)\n  emit_i32_const(b, 12)\n  emit_local_get(b, 8)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_i32_add(b)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  // Set header: cap = total_len\n  emit_local_get(b, 9)\n  emit_local_get(b, 8)\n  emit_i32_store(b, 2, 0)\n  // Set header: len = total_len\n  emit_local_get(b, 9)\n  emit_local_get(b, 8)\n  emit_i32_store(b, 2, 4)\n  // new_data = new_hdr + 12\n  emit_local_get(b, 9)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_local_set(b, 10)\n  // Set header: data_ptr = new_data\n  emit_local_get(b, 9)\n  emit_local_get(b, 10)\n  emit_i32_store(b, 2, 8)\n  // memory.copy(new_data, data1, len1*8)\n  emit_local_get(b, 10)\n  emit_local_get(b, 6)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_memory_copy(b)\n  // memory.copy(new_data + len1*8, data2, len2*8)\n  emit_local_get(b, 10)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 7)\n  emit_local_get(b, 5)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_memory_copy(b)\n  // Return new_hdr as i64\n  emit_local_get(b, 9)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// Generate __str_char_code_at body (func 13): (s: i64, idx: i64) -> i64\n// Extract offset from packed string, load byte at offset+idx\n// locals: 0=s(i64), 1=idx(i64), 2=offset(i32)\nlet gen_str_char_code_at_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // offset = (s >> 32) as i32\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // result = mem[offset + idx] as i64\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// Generate __str_from_char_code body (func 14): (code: i64) -> i64\n// Allocate 1 byte on heap, store char, return packed i64\n// locals: 0=code(i64), 1=ptr(i32)\nlet gen_str_from_char_code_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // ptr = heap_ptr\n  emit_global_get(b, 0)\n  emit_local_tee(b, 1)\n  // heap_ptr += 1\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  // mem[ptr] = code as byte\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  // return (ptr << 32) | 1\n  emit_local_get(b, 1)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_i64_const(b, 1)\n  emit_i64_or(b)\n  b\n}\n\n// Generate __str_substring body (func 15): (s: i64, start: i64, end: i64) -> i64\n// Return packed i64 with new_offset = old_offset + start, new_len = end - start\n// locals: 0=s(i64), 1=start(i64), 2=end(i64), 3=old_offset(i32), 4=new_len(i32)\nlet gen_str_substring_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // old_offset = (s >> 32) as i32\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // new_len = (end - start) as i32\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_sub(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  // new_offset = old_offset + start as i32\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  // return (new_offset << 32) | new_len\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_i64_or(b)\n  b\n}\n\n// Generate __identity body (func 16): (val: i64) -> i64\n// Just returns the argument unchanged (used for array_builder_freeze)\nlet gen_identity_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  b\n}\n\n// Generate __double_to_int body (func 11): (val: i64) -> i64\n// Reinterpret i64 bits as f64, then truncate to i64\nlet gen_double_to_int_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_i64_trunc_f64_s(b)\n  b\n}\n\n// Generate __int_to_double body (func 12): (val: i64) -> i64\n// Convert i64 to f64, then reinterpret as i64 bits\nlet gen_int_to_double_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_convert_i64_s(b)\n  emit_i64_reinterpret_f64(b)\n  b\n}\n\n// Generate __arr_truncate body (func 19): (arr: i64, new_len: i64) -> void\n// Truncate array by setting header[4] = new_len\n// local 0: arr(i64), local 1: new_len(i64)\nlet gen_arr_truncate_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // header[4] = new_len as i32\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\n// Generate __string_join body (func 20): (arr: i64, sep: i64) -> i64\n// Join array of strings with separator\n// WASM locals grouped by type: params(i64,i64), then i32s, then i64s\n// local 0: arr(i64 param), local 1: sep(i64 param)\n// local 2: len(i32), local 3: i(i32)          [meta_i32=2]\n// local 4: result(i64), local 5: elem(i64)    [meta_i64=2]\nlet gen_string_join_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // len = arr_len(arr) [call func 7]\n  emit_local_get(b, 0)\n  emit_call(b, 7)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // if len == 0, return empty string (0)\n  emit_local_get(b, 2)\n  emit_i32_eqz(b)\n  emit_if_i64(b)\n    emit_i64_const(b, 0)\n  emit_else(b)\n    // result = arr_get(arr, 0) [call func 8]\n    emit_local_get(b, 0)\n    emit_i64_const(b, 0)\n    emit_call(b, 8)\n    emit_local_set(b, 4)\n    // i = 1\n    emit_i32_const(b, 1)\n    emit_local_set(b, 3)\n    // block $break\n    emit_block_void(b)\n      // loop $loop\n      emit_loop_void(b)\n        // if i >= len, br $break\n        emit_local_get(b, 3)\n        emit_local_get(b, 2)\n        emit_i32_ge_u(b)\n        emit_br_if(b, 1)\n        // result = string_concat(result, sep) [call func 5]\n        emit_local_get(b, 4)\n        emit_local_get(b, 1)\n        emit_call(b, 5)\n        emit_local_set(b, 4)\n        // elem = arr_get(arr, i) [call func 8]\n        emit_local_get(b, 0)\n        emit_local_get(b, 3)\n        emit_i64_extend_i32_u(b)\n        emit_call(b, 8)\n        emit_local_set(b, 5)\n        // result = string_concat(result, elem) [call func 5]\n        emit_local_get(b, 4)\n        emit_local_get(b, 5)\n        emit_call(b, 5)\n        emit_local_set(b, 4)\n        // i++\n        emit_local_get(b, 3)\n        emit_i32_const(b, 1)\n        emit_i32_add(b)\n        emit_local_set(b, 3)\n        // br $loop\n        emit_br(b, 0)\n      emit_end(b)  // end loop\n    emit_end(b)  // end block\n    emit_local_get(b, 4)\n  emit_end(b)  // end if\n  b\n}\n\n// Generate __fs_read_file_stub body (func 21): (path: i64) -> i64\n// Stub: returns empty string (0). Real I/O is handled by host imports.\nlet gen_fs_read_file_stub_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_i64_const(b, 0)\n  b\n}\n\n// Generate __fs_write_bytes_stub body (func 22): (path: i64, bytes: i64) -> void\n// Stub: does nothing. Real I/O is handled by host imports.\nlet gen_fs_write_bytes_stub_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  b\n}\n\n// Generate __eq body (func 23): (a: i64, b: i64) -> i64\n// Integer equality: returns 1 if a == b, 0 otherwise\nlet gen_eq_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_eq(b)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// Generate __string_ends_with body (func 24): (s: i64, suffix: i64) -> i64\n// Returns 1 if s ends with suffix, 0 otherwise\n// local 0: s(i64), local 1: suffix(i64), local 2: slen(i32), local 3: suflen(i32), local 4: tail(i64)\nlet gen_string_ends_with_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // slen = string_length(s) [call func 3]\n  emit_local_get(b, 0)\n  emit_call(b, 3)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // suflen = string_length(suffix) [call func 3]\n  emit_local_get(b, 1)\n  emit_call(b, 3)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // if suflen > slen, return 0\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  bytebuf_push(b, 75)  // i32.gt_u\n  emit_if_i64(b)\n    emit_i64_const(b, 0)\n  emit_else(b)\n    // tail = string_substring(s, slen - suflen, slen) [call func 15]\n    emit_local_get(b, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 3)\n    emit_i32_sub(b)\n    emit_i64_extend_i32_u(b)\n    emit_local_get(b, 2)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, 15)\n    emit_local_set(b, 4)\n    // return string_equals(tail, suffix) [call func 4]\n    emit_local_get(b, 4)\n    emit_local_get(b, 1)\n    emit_call(b, 4)\n  emit_end(b)\n  b\n}\n\n// Generate __string_last_index_of body (func 25): (s: i64, sub: i64) -> i64\n// Returns last index of sub in s, or -1 if not found\n// local 0: s(i64), local 1: sub(i64), local 2: slen(i32), local 3: sublen(i32), local 4: i(i32), local 5: chunk(i64)\nlet gen_string_last_index_of_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // slen = string_length(s) [call func 3]\n  emit_local_get(b, 0)\n  emit_call(b, 3)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // sublen = string_length(sub) [call func 3]\n  emit_local_get(b, 1)\n  emit_call(b, 3)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // if sublen > slen, return -1\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  bytebuf_push(b, 75)  // i32.gt_u\n  emit_if_i64(b)\n    emit_i64_const(b, -1)\n  emit_else(b)\n    // i = slen - sublen\n    emit_local_get(b, 2)\n    emit_local_get(b, 3)\n    emit_i32_sub(b)\n    emit_local_set(b, 4)\n    // block $found\n    emit_block_i64(b)\n      // block $notfound\n      emit_block_void(b)\n        // loop $loop\n        emit_loop_void(b)\n          // if i < 0, br $notfound\n          emit_local_get(b, 4)\n          emit_i32_const(b, 0)\n          bytebuf_push(b, 72)  // i32.lt_s\n          emit_br_if(b, 1)\n          // chunk = string_substring(s, i, i + sublen) [call func 15]\n          emit_local_get(b, 0)\n          emit_local_get(b, 4)\n          emit_i64_extend_i32_u(b)\n          emit_local_get(b, 4)\n          emit_local_get(b, 3)\n          emit_i32_add(b)\n          emit_i64_extend_i32_u(b)\n          emit_call(b, 15)\n          emit_local_set(b, 5)\n          // if string_equals(chunk, sub), br $found with i\n          emit_local_get(b, 5)\n          emit_local_get(b, 1)\n          emit_call(b, 4)\n          emit_i32_wrap_i64(b)\n          emit_if_void(b)\n            emit_local_get(b, 4)\n            emit_i64_extend_i32_u(b)\n            emit_br(b, 3)  // br $found (past block $notfound + loop + if)\n          emit_end(b)\n          // i--\n          emit_local_get(b, 4)\n          emit_i32_const(b, 1)\n          emit_i32_sub(b)\n          emit_local_set(b, 4)\n          // br $loop\n          emit_br(b, 0)\n        emit_end(b)  // end loop\n      emit_end(b)  // end block $notfound\n      // not found: return -1\n      emit_i64_const(b, -1)\n    emit_end(b)  // end block $found\n  emit_end(b)  // end if\n  b\n}\n\n// Generate __selfhost_sources_stub body (func 26): () -> i64\n// Stub: returns empty array. The real sources are provided by selfhost_sources_bundle.vibe\n// which is not part of the meta-circular bundle.\nlet gen_selfhost_sources_stub_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // Call arr_new (func 6) to return an empty array\n  emit_call(b, 6)\n  b\n}\n\n// Generate proper selfhost_sources body that returns Array[(String, String)]\n// from embedded source data in the string table.\n// Each source pair (path, content) is stored as a 2-tuple (2 x i64) on the heap.\n// locals: local 0 = i32 (tuple heap ptr), local 1 = i64 (array ref)\nlet gen_selfhost_sources_proper_body = (\n  num_sources: Int,\n  str_offsets: Array[Int],\n  str_lengths: Array[Int],\n  src_str_base: Int\n) -> Array[Int] {\n  let b = bytebuf_new()\n  // Create empty array\n  emit_call(b, 6)  // arr_new -> i64\n  emit_local_set(b, 1)  // local 1 (i64) = array\n\n  let mut si = 0\n  while si < num_sources {\n    let path_idx = src_str_base + si * 2\n    let content_idx = src_str_base + si * 2 + 1\n    let path_off = array_get(str_offsets, path_idx)\n    let path_len = array_get(str_lengths, path_idx)\n    let content_off = array_get(str_offsets, content_idx)\n    let content_len = array_get(str_lengths, content_idx)\n\n    // Allocate 16-byte tuple on heap (2 x i64 fields, no header)\n    emit_global_get(b, 0)    // heap_ptr (i32)\n    emit_local_tee(b, 0)     // local 0 (i32) = tuple_ptr\n    emit_i32_const(b, 16)\n    emit_i32_add(b)\n    emit_global_set(b, 0)    // heap_ptr += 16\n\n    // Write path string ref at tuple_ptr+0 (i64)\n    emit_local_get(b, 0)\n    let path_ref = (path_off << 32) | path_len\n    emit_i64_const(b, path_ref)\n    emit_i64_store(b, 3, 0)\n\n    // Write content string ref at tuple_ptr+8 (i64)\n    emit_local_get(b, 0)\n    let content_ref = (content_off << 32) | content_len\n    emit_i64_const(b, content_ref)\n    emit_i64_store(b, 3, 8)\n\n    // Push tuple to array: arr_push(array, tuple_ptr as i64)\n    emit_local_get(b, 1)     // array ref (i64)\n    emit_local_get(b, 0)     // tuple_ptr (i32)\n    emit_i64_extend_i32_u(b) // extend to i64\n    emit_call(b, 9)          // arr_push(i64, i64)\n\n    si = si + 1\n  }\n\n  // Return array\n  emit_local_get(b, 1)\n  b\n}\n\n// === Builtin registry ===\n// Builtin descriptor indices (after fd_write import at func 0):\n// func 1: __print_i64 — (i64) -> void, 4 mixed locals\n// func 2: __print_str — (i64) -> void, 2 i32 locals\n// func 3: __str_len — (i64) -> i64, 0 extra\n// func 4: __str_eq — (i64,i64) -> i64, 5 i32 locals\n// func 5: __str_concat — (i64,i64) -> i64, 6 i32 locals\n// func 6: __arr_new — () -> i64, 1 i32 local\n// func 7: __arr_len — (i64) -> i64, 0 extra\n// func 8: __arr_get — (i64,i64) -> i64, 1 i32 local\n// func 9: __arr_push — (i64,i64) -> void, 6 i32 locals\n// func 10: __arr_set — (i64,i64,i64) -> void, 1 i32 local\n// func 11: __double_to_int — (i64) -> i64, 0 extra\n// func 12: __int_to_double — (i64) -> i64, 0 extra\n// func 13: __str_char_code_at — (i64,i64) -> i64, 1 i32 local\n// func 14: __str_from_char_code — (i64) -> i64, 1 i32 local\n// func 15: __str_substring — (i64,i64,i64) -> i64, 2 i32 locals\n// func 16: __identity — (i64) -> i64, 0 extra [array_builder_freeze]\n// func 17: __arr_slice — (i64,i64,i64) -> i64, 6 i32 locals\n// func 18: __arr_concat — (i64,i64) -> i64, 9 i32 locals\n// func 19: __arr_truncate — (i64,i64) -> void, 0 extra\n// func 20: __string_join — (i64,i64) -> i64, 4 i32 + 2 i64 locals\n// func 21: __fs_read_file_stub — (i64) -> i64, 0 extra\n// func 22: __fs_write_bytes_stub — (i64,i64) -> void, 0 extra\n\nexport let compile_wasi_module_with_sources = (stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\n  // Collect user functions\n  let fn_names_list = array_slice([\"\"], 0, 0)\n  let fn_param_counts = array_slice([0], 0, 0)\n\n  // Store stmt indices for body extraction during compilation\n  let fn_stmt_indices = array_slice([0], 0, 0)\n\n  // Track non-function SLet bindings compiled as zero-param thunks\n  let thunk_names_list = array_slice([\"\"], 0, 0)\n\n  // Track exported function names and their user-function indices\n  let export_fn_names = array_slice([\"\"], 0, 0)\n  let export_fn_user_indices = array_slice([0], 0, 0)\n\n  let mut i = 0\n  while i < array_length(stmts) {\n    let stmt = array_get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = array_length(fn_names_list)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        array_push(fn_names_list, name)\n        array_push(fn_param_counts, array_length(params))\n        array_push(fn_stmt_indices, i)\n      } else {\n        // Non-function SLet: compile as zero-param thunk function\n        array_push(fn_names_list, name)\n        array_push(fn_param_counts, 0)\n        array_push(fn_stmt_indices, i)\n        array_push(thunk_names_list, name)\n      }\n      if is_export {\n        array_push(export_fn_names, name)\n        array_push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n\n  // Collect enum variant constructors with stable type-scoped tags\n  // Tag scheme: (type_index << 16) | variant_index\n  // Built-in: Option = type 0 (None=0, Some=1)\n  let ctor_names_list = array_slice([\"None\", \"Some\"], 0, 2)\n  let ctor_tags_list = array_slice([0, 1], 0, 2)\n  let ctor_field_counts_list = array_slice([0, 1], 0, 2)\n  let ctor_type_names_list = array_slice([\"Option\", \"Option\"], 0, 2)\n  let mut type_index = 1  // type 0 = Option\n  let mut ei2 = 0\n  while ei2 < array_length(stmts) {\n    match array_get(stmts, ei2) {\n      SEnum(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < array_length(variants) {\n          let (vname, vfields) = array_get(variants, vi)\n          array_push(ctor_names_list, vname)\n          array_push(ctor_tags_list, (type_index << 16) | vi)\n          array_push(ctor_field_counts_list, array_length(vfields))\n          array_push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields) => {\n        type_index = type_index + 1\n        array_push(ctor_names_list, sname)\n        array_push(ctor_tags_list, type_index << 16)\n        array_push(ctor_field_counts_list, array_length(sfields))\n        array_push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n\n  // Build struct field name index tables (parallel arrays)\n  // struct_names[i] = struct name, struct_field_names[i] = [field0, field1, ...]\n  let struct_names = array_slice([\"\"], 0, 0)\n  let struct_field_names = array_slice([array_slice([\"\"], 0, 0)], 0, 0)\n  let mut si = 0\n  while si < array_length(stmts) {\n    match array_get(stmts, si) {\n      SStruct(_, sname, sfields) => {\n        array_push(struct_names, sname)\n        let fnames = array_slice([\"\"], 0, 0)\n        let mut sfi = 0\n        while sfi < array_length(sfields) {\n          let (fname, _) = array_get(sfields, sfi)\n          array_push(fnames, fname)\n          sfi = sfi + 1\n        }\n        array_push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n\n  let num_user_funcs = array_length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n\n  // Find entry function\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if string_equals(array_get(fn_names_list, ei), entry_name) {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 {\n    throw(string_concat(\"entry function not found: \", entry_name))\n  }\n\n  // String table\n  let str_strs = collect_strings_stmts(stmts)\n  // Add selfhost source strings directly to the string table.\n  // This bypasses collect_strings_stmts dedup to avoid O(n²) comparisons\n  // on large source content strings, which caused OOM in previous approaches.\n  let src_str_base = array_length(str_strs)\n  let num_src_pairs = array_length(selfhost_srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = array_get(selfhost_srcs, __src_i)\n    array_push(str_strs, __src_path)\n    array_push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = array_length(str_strs)\n  let data_base = 64\n  let str_offsets = array_slice([0], 0, 0)\n  let str_lengths = array_slice([0], 0, 0)\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = array_get(str_strs, si)\n    let slen = string_length(s)\n    array_push(str_offsets, str_pos)\n    array_push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  // Align heap start to 8 bytes\n  let heap_start = ((str_pos + 7) / 8) * 8\n\n  // Function layout:\n  // func 0: fd_write (import)\n  // func 1-26: generated builtins (26 funcs)\n  // func 27..27+N-1: user functions\n  // func 27+N: _start\n  let num_generated = 26\n  let func_offset = 1 + num_generated  // = 27\n\n  // Builtin table: (name, param_count, wasm_func_idx, has_return)\n  // To add a new builtin: add one entry here + one gen_*_body() push below\n  let builtin_defs = [\n    (\"print_int\",           1, 1,  0),\n    (\"print_str\",           1, 2,  0),\n    (\"string_length\",       1, 3,  1),\n    (\"string_equals\",       2, 4,  1),\n    (\"string_concat\",       2, 5,  1),\n    (\"array_new\",           0, 6,  1),\n    (\"array_length\",        1, 7,  1),\n    (\"array_get\",           2, 8,  1),\n    (\"array_push\",          2, 9,  0),\n    (\"array_set\",           3, 10, 0),\n    (\"double_to_int\",       1, 11, 1),\n    (\"int_to_double\",       1, 12, 1),\n    (\"string_char_code_at\", 2, 13, 1),\n    (\"string_from_char_code\", 1, 14, 1),\n    (\"string_substring\",    3, 15, 1),\n    // New builtins (func 19-22)\n    (\"array_truncate\",      2, 19, 0),\n    (\"string_join\",         2, 20, 1),\n    (\"fs_read_file\",        1, 21, 1),\n    (\"fs_write_bytes\",      2, 22, 0),\n    (\"eq\",                  2, 23, 1),\n    (\"string_ends_with\",   2, 24, 1),\n    (\"string_last_index_of\", 2, 25, 1),\n    (\"selfhost_sources\",    0, 26, 1),\n    // Aliases (point to existing wasm funcs)\n    (\"array_builder\",       0, 6,  1),\n    (\"array_builder_push\",  2, 9,  0),\n    (\"array_builder_freeze\", 1, 16, 1),\n    (\"array_slice\",         3, 17, 1),\n    (\"array_concat\",        2, 18, 1),\n    // Bytes aliases (same representation as arrays)\n    (\"bytes_from_array\",    1, 16, 1),\n    (\"bytes_length\",        1, 7,  1),\n    (\"bytes_get\",           2, 8,  1),\n    // Float/double aliases\n    (\"double_to_i64_bits\",  1, 16, 1)\n  ]\n  let mut __bi = 0\n  while __bi < array_length(builtin_defs) {\n    let (bname, bparams, _, _) = array_get(builtin_defs, __bi)\n    array_push(fn_names_list, bname)\n    array_push(fn_param_counts, bparams)\n    __bi = __bi + 1\n  }\n\n  // Build fn_indices and fn_returns\n  let fn_indices_list = array_slice([0], 0, 0)\n  let fn_returns_list = array_slice([0], 0, 0)\n  let mut fi = 0\n  while fi < num_user_funcs {\n    array_push(fn_indices_list, fi + func_offset)\n    array_push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  // Builtin indices and returns (from builtin_defs table)\n  let mut __bi2 = 0\n  while __bi2 < array_length(builtin_defs) {\n    let (_, _, bwasm_idx, breturns) = array_get(builtin_defs, __bi2)\n    array_push(fn_indices_list, bwasm_idx)\n    array_push(fn_returns_list, breturns)\n    __bi2 = __bi2 + 1\n  }\n\n  // === Type section ===\n  // type 0: fd_write (i32,i32,i32,i32) -> (i32)\n  // type 1: (i64) -> () [print_int, print_str]\n  // type 2: () -> () [_start]\n  // type 3: (i64) -> (i64) [string_length, array_length, str_from_char_code]\n  // type 4: (i64,i64) -> (i64) [string_equals, string_concat, array_get, str_char_code_at]\n  // type 5: () -> (i64) [array_new]\n  // type 6: (i64,i64) -> () [array_push]\n  // type 7: (i64,i64,i64) -> () [array_set]\n  // type 8: (i64,i64,i64) -> (i64) [str_substring]\n  // type 9+: closure call types\n  let num_base_types = 9\n\n  // Lambda accumulators (populated during compilation)\n  let lt_w = LambdaTable::{\n    bodies: array_slice([array_slice([0], 0, 0)], 0, 0),\n    param_counts: array_slice([0], 0, 0),\n    captures: array_slice([array_slice([\"\"], 0, 0)], 0, 0),\n    meta_i32: array_slice([0], 0, 0),\n    meta_i64: array_slice([0], 0, 0)\n  }\n\n  // === Code section bodies ===\n  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)\n  let meta_i32 = array_slice([0], 0, 0)\n  let meta_i64 = array_slice([0], 0, 0)\n\n  // Builtin bodies\n  array_push(bodies, gen_print_i64_body())\n  array_push(meta_i32, 3)\n  array_push(meta_i64, 1)\n  array_push(bodies, gen_print_str_body())\n  array_push(meta_i32, 2)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_str_len_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_str_eq_body())\n  array_push(meta_i32, 5)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_str_concat_body())\n  array_push(meta_i32, 6)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_arr_new_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_arr_len_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_arr_get_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_arr_push_body())\n  array_push(meta_i32, 6)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_arr_set_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_double_to_int_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_int_to_double_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_str_char_code_at_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_str_from_char_code_body())\n  array_push(meta_i32, 1)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_str_substring_body())\n  array_push(meta_i32, 2)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_identity_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_arr_slice_body())\n  array_push(meta_i32, 6)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_arr_concat_body())\n  array_push(meta_i32, 9)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_arr_truncate_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_string_join_body())\n  array_push(meta_i32, 2)\n  array_push(meta_i64, 2)\n  array_push(bodies, gen_fs_read_file_stub_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_fs_write_bytes_stub_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_eq_body())\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n  array_push(bodies, gen_string_ends_with_body())\n  array_push(meta_i32, 2)\n  array_push(meta_i64, 1)\n  array_push(bodies, gen_string_last_index_of_body())\n  array_push(meta_i32, 3)\n  array_push(meta_i64, 1)\n  // func 26: selfhost_sources\n  // When sources are provided, generate a proper body that constructs the array\n  // from strings embedded in the data section. Otherwise, use the stub (empty array).\n  if num_src_pairs > 0 {\n    array_push(bodies, gen_selfhost_sources_proper_body(\n      num_src_pairs, str_offsets, str_lengths, src_str_base\n    ))\n    array_push(meta_i32, 1)  // 1 i32 local (tuple ptr)\n    array_push(meta_i64, 1)  // 1 i64 local (array ref)\n  } else {\n    array_push(bodies, gen_selfhost_sources_stub_body())\n    array_push(meta_i32, 0)\n    array_push(meta_i64, 0)\n  }\n\n  // Compile user function bodies (lambdas accumulated here)\n  // In WASI mode, all user funcs get an extra __env param (i64) for table compatibility\n  let mut bi = 0\n  while bi < num_user_funcs {\n    // Extract body and params from original stmts via stmt index\n    let __bi_stmt = array_get(stmts, array_get(fn_stmt_indices, bi))\n    let __bi_expr = get_slet_expr(__bi_stmt)\n    let body_buf = bytebuf_new()\n    let local_names = array_slice([\"\"], 0, 0)\n    let fn_name_dbg = array_get(fn_names_list, bi)\n    let compile_ctx = CompileCtx::{\n      func_table: FuncTable::{ names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list },\n      str_table: StrTable::{ strs: str_strs, offsets: str_offsets, lengths: str_lengths },\n      lambda_table: lt_w,\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\n      ref_cell_names: array_slice([\"\"], 0, 0),\n      ctor_table: CtorTable::{ names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names },\n      thunk_names: thunk_names_list\n    }\n    if is_efn(__bi_expr) {\n      // Normal function: extract params and body from EFn\n      let __bi_params = get_efn_params(__bi_expr)\n      let body = get_efn_body(__bi_expr)\n      let mut pi = 0\n      while pi < array_length(__bi_params) {\n        let (pname, _) = array_get(__bi_params, pi)\n        array_push(local_names, pname)\n        pi = pi + 1\n      }\n      // Add __env param (unused, but needed for table calling convention)\n      array_push(local_names, \"__env\")\n      let param_count = array_length(__bi_params) + 1  // includes __env\n      let final_nl = compile_expr(\n        body_buf, body, local_names, param_count, compile_ctx, -1\n      )\n      array_push(bodies, body_buf)\n      let extra = if final_nl > param_count { final_nl - param_count } else { 0 }\n      array_push(meta_i32, 0)\n      array_push(meta_i64, extra)\n    } else {\n      // Thunk: non-function SLet compiled as zero-param function\n      // Only has __env param\n      array_push(local_names, \"__env\")\n      let param_count = 1  // just __env\n      let final_nl = compile_expr(\n        body_buf, __bi_expr, local_names, param_count, compile_ctx, -1\n      )\n      array_push(bodies, body_buf)\n      let extra = if final_nl > param_count { final_nl - param_count } else { 0 }\n      array_push(meta_i32, 0)\n      array_push(meta_i64, extra)\n    }\n    bi = bi + 1\n  }\n\n  let num_lambdas = array_length(lt_w.bodies)\n\n  // _start body: calls entry function and prints result\n  let start_body = bytebuf_new()\n  let entry_func_idx = entry_user_idx + func_offset\n  let entry_params = array_get(fn_param_counts, entry_user_idx)\n  if entry_params != 0 {\n    throw(\"WASI entry function must take 0 parameters\")\n  }\n  emit_i64_const(start_body, 0)  // env=0 for user func\n  emit_call(start_body, entry_func_idx)\n  emit_call(start_body, 1)  // __print_i64\n  array_push(bodies, start_body)\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n\n  // run body: no-op (returns 0). The JS host runner calls specific exports directly.\n  // _start handles standalone execution (calls entry + prints result).\n  let run_body = bytebuf_new()\n  emit_i64_const(run_body, 0)\n  array_push(bodies, run_body)\n  array_push(meta_i32, 0)\n  array_push(meta_i64, 0)\n\n  // Append lambda bodies after _start+run\n  let mut li = 0\n  while li < num_lambdas {\n    array_push(bodies, array_get(lt_w.bodies, li))\n    array_push(meta_i32, array_get(lt_w.meta_i32, li))\n    array_push(meta_i64, array_get(lt_w.meta_i64, li))\n    li = li + 1\n  }\n\n  // Determine max closure call arity needed (user_params, i.e. N where sig is (i64^(N+1))->i64)\n  // Closure call types: for each arity N (0,1,2,...,max_arity), type = (i64^(N+1)) -> i64\n  // These start at type index = num_base_types + num_user_funcs\n  let mut max_closure_arity = -1\n  // Check all lambda param counts (which include +1 for env)\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = array_get(lt_w.param_counts, lai) - 1  // user_params = total - 1 (env)\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  // Also check user funcs that might be used as values (they get env=0 appended)\n  // Their call_indirect arity = their param_count\n  let mut uai = 0\n  while uai < num_user_funcs {\n    let upc = array_get(fn_param_counts, uai)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai = uai + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 { max_closure_arity + 1 } else { 0 }\n\n  // === Type section ===\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\n\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])  // type 0: fd_write\n  emit_func_type_raw(type_content, [126], array_slice([0], 0, 0))  // type 1: (i64)->()\n  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))  // type 2: ()->()\n  emit_func_type_raw(type_content, [126], [126])  // type 3: (i64)->(i64)\n  emit_func_type_raw(type_content, [126, 126], [126])  // type 4: (i64,i64)->(i64)\n  emit_func_type_raw(type_content, array_slice([0], 0, 0), [126])  // type 5: ()->(i64)\n  emit_func_type_raw(type_content, [126, 126], array_slice([0], 0, 0))  // type 6: (i64,i64)->()\n  emit_func_type_raw(type_content, [126, 126, 126], array_slice([0], 0, 0))  // type 7: (i64,i64,i64)->()\n  emit_func_type_raw(type_content, [126, 126, 126], [126])  // type 8: (i64,i64,i64)->(i64)\n\n  // Closure call types: (i64^(N+1)) -> i64 for N = 0..max_closure_arity\n  // Used for both user funcs (with env) and lambdas\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1  // N user params + 1 env\n    let ct_params = array_slice([0], 0, 0)\n    let mut cpti = 0\n    while cpti < num_params {\n      array_push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [126])\n    cti = cti + 1\n  }\n\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n\n  // === Import section ===\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n\n  // === Function section ===\n  // func 1-26: builtins, func 27..27+N-1: user, func 27+N: _start, func 27+N+1...: lambdas\n  let func_type_indices = array_slice([0], 0, 0)\n  array_push(func_type_indices, 1)  // __print_i64\n  array_push(func_type_indices, 1)  // __print_str\n  array_push(func_type_indices, 3)  // __str_len\n  array_push(func_type_indices, 4)  // __str_eq\n  array_push(func_type_indices, 4)  // __str_concat\n  array_push(func_type_indices, 5)  // __arr_new\n  array_push(func_type_indices, 3)  // __arr_len\n  array_push(func_type_indices, 4)  // __arr_get\n  array_push(func_type_indices, 6)  // __arr_push\n  array_push(func_type_indices, 7)  // __arr_set\n  array_push(func_type_indices, 3)  // __double_to_int\n  array_push(func_type_indices, 3)  // __int_to_double\n  array_push(func_type_indices, 4)  // __str_char_code_at\n  array_push(func_type_indices, 3)  // __str_from_char_code\n  array_push(func_type_indices, 8)  // __str_substring\n  array_push(func_type_indices, 3)  // __identity (array_builder_freeze)\n  array_push(func_type_indices, 8)  // __arr_slice (i64,i64,i64) -> (i64)\n  array_push(func_type_indices, 4)  // __arr_concat (i64,i64) -> (i64)\n  array_push(func_type_indices, 6)  // __arr_truncate (i64,i64) -> ()\n  array_push(func_type_indices, 4)  // __string_join (i64,i64) -> (i64)\n  array_push(func_type_indices, 3)  // __fs_read_file_stub (i64) -> (i64)\n  array_push(func_type_indices, 6)  // __fs_write_bytes_stub (i64,i64) -> ()\n  array_push(func_type_indices, 4)  // __eq (i64,i64) -> (i64)\n  array_push(func_type_indices, 4)  // __string_ends_with (i64,i64) -> (i64)\n  array_push(func_type_indices, 4)  // __string_last_index_of (i64,i64) -> (i64)\n  array_push(func_type_indices, 5)  // __selfhost_sources_stub () -> (i64)\n  // User funcs: type = closure call type for their arity (includes env)\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = array_get(fn_param_counts, fti)\n    array_push(func_type_indices, num_base_types + upc)\n    fti = fti + 1\n  }\n  array_push(func_type_indices, 2)  // _start () -> ()\n  array_push(func_type_indices, 5)  // run () -> (i64)\n  // Lambda function type indices\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = array_get(lt_w.param_counts, lfi) - 1\n    array_push(func_type_indices, num_base_types + lam_user_params)\n    lfi = lfi + 1\n  }\n  emit_function_section(out, func_type_indices)\n\n  // === Table section (if closures exist) ===\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n\n  // === Memory section ===\n  // 8192 pages = 512MB initial memory\n  emit_memory_section(out, 8192)\n\n  // === Global section: heap_ptr ===\n  emit_global_section_i32_mut(out, heap_start)\n\n  // === Export section ===\n  // _start = func_offset + num_user_funcs, run = _start + 1\n  let start_func_idx = func_offset + num_user_funcs\n  let run_func_idx = start_func_idx + 1\n  // Build export lists: _start, run, entry function, + all export-marked functions\n  let all_export_names = array_slice([\"_start\", \"run\", entry_name], 0, 3)\n  let all_export_indices = array_slice([start_func_idx, run_func_idx, entry_func_idx], 0, 3)\n  // Add user-exported functions (skip if already exported as entry)\n  let mut exi = 0\n  while exi < array_length(export_fn_names) {\n    let ename = array_get(export_fn_names, exi)\n    if string_equals(ename, entry_name) == false {\n      array_push(all_export_names, ename)\n      array_push(all_export_indices, array_get(export_fn_user_indices, exi) + func_offset)\n    }\n    exi = exi + 1\n  }\n  emit_exports_full(out,\n    all_export_names, all_export_indices,\n    \"memory\", 0,\n    [\"__heap_ptr\"], [0]\n  )\n\n  // === Element section (if closures exist) ===\n  if total_table_entries > 0 {\n    let table_func_indices = array_slice([0], 0, 0)\n    // User funcs: table slot i -> func index func_offset+i\n    let mut tei = 0\n    while tei < num_user_funcs {\n      array_push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    // Lambda funcs: table slot num_user_funcs+j -> func index run_func_idx+1+j\n    // (lambdas come after _start and run in the function list)\n    let mut tej = 0\n    while tej < num_lambdas {\n      array_push(table_func_indices, run_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n\n  // === Encode code section manually (mixed local types) ===\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, array_length(bodies))\n\n  let mut ci = 0\n  while ci < array_length(bodies) {\n    let body = array_get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = array_get(meta_i32, ci)\n    let ni64 = array_get(meta_i64, ci)\n\n    if ni32 == 0 {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 0)  // no locals\n      } else {\n        leb128_encode_u32(func_buf, 1)  // 1 group\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)  // i64\n      }\n    } else {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)  // i32\n      } else {\n        leb128_encode_u32(func_buf, 2)  // 2 groups\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)  // i32\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)  // i64\n      }\n    }\n\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_array(code_content, func_buf)\n    ci = ci + 1\n  }\n\n  bytebuf_push_section(out, 10, code_content)\n\n  // === Data section ===\n  if num_strings > 0 {\n    let data_offsets = array_slice([0], 0, 0)\n    let data_bufs = array_slice([array_slice([0], 0, 0)], 0, 0)\n    let mut di = 0\n    while di < num_strings {\n      array_push(data_offsets, array_get(str_offsets, di))\n      array_push(data_bufs, string_to_data(array_get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n\n  bytebuf_to_bytes(out)\n}\n\n// Backward-compatible wrapper: compile WASI module without embedded selfhost sources\nexport let compile_wasi_module = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_with_sources(stmts, entry_name, array_slice([(\"\", \"\")], 0, 0))\n}\n")
    ,
    ("vibe/compiler/codegen_gc.vibe",
"// AST-to-WASM codegen (wasm-gc backend)\n// Uses GC struct types for ref cells instead of linear memory bump allocation.\n// Closures use table-based call_indirect (same as linear memory backend).\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./bytebuf.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,\n  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,\n  leb128_encode_u32, leb128_encode_s64\n}\n\nimport ./wasm_emit.vibe {\n  emit_header,\n  emit_type_section, emit_type_section_multi,\n  emit_function_section, emit_export_section, emit_export_section_multi,\n  emit_code_section, emit_code_section_with_locals,\n  emit_name, emit_func_type_raw,\n  emit_import_section_func, emit_memory_section,\n  emit_exports_with_memory, emit_data_section, emit_data_section_multi,\n  emit_local_get, emit_local_set, emit_local_tee,\n  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,\n  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,\n  emit_i64_shl, emit_i64_shr_s,\n  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,\n  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,\n  emit_i64_extend_i32_s, emit_i32_wrap_i64,\n  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,\n  emit_i32_store8, emit_i32_load8_u,\n  emit_call, emit_drop, emit_return,\n  emit_block_void, emit_block_i64, emit_loop_void,\n  emit_if_void, emit_if_i64, emit_else, emit_end,\n  emit_br, emit_br_if,\n  emit_global_section_i32_mut, emit_global_get, emit_global_set,\n  string_to_data,\n  emit_f64_const_bits, emit_f64_add, emit_f64_sub, emit_f64_mul, emit_f64_div,\n  emit_f64_eq, emit_f64_ne, emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge,\n  emit_f64_neg, emit_i64_reinterpret_f64, emit_f64_reinterpret_i64,\n  emit_i64_trunc_f64_s, emit_f64_convert_i64_s,\n  emit_call_indirect, emit_table_section_funcref, emit_element_section_active,\n  emit_struct_type_raw, emit_struct_new, emit_struct_get, emit_struct_set\n}\n\nimport ./codegen_common.vibe {\n  emit_i32_sub, emit_i32_mul, emit_i32_ne, emit_i32_eq, emit_i32_ge_u, emit_i32_eqz,\n  emit_i64_store, emit_i64_load, emit_i64_extend_i32_u, emit_memory_copy,\n  resolve_local, resolve_func, FuncTable, StrTable, LambdaTable, CtorTable, CompileCtxGc,\n  emit_str_ref, collect_strings_stmts,\n  array_contains_str, collect_free_vars, is_mut_captured_in,\n  str_table_lookup, find_catchall_idx, find_func_stmt,\n  lookup_ctor,\n  emit_binop_op, emit_assignop_op, emit_closure_resolve, emit_closure_call_tail\n}\n\n// === Sub-compilers (GC backend) ===\n\nlet compile_call_gc = (\n  buf: Array[Int], callee: Expr, args: Array[Expr],\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  ce: (Array[Int], Expr, Array[String], Int, Int) -> Int with { Error }\n) -> Int with { Error } {\n  match callee {\n    EIdent(fname) => {\n      // Check if this is an enum constructor call\n      let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n      if ctor_lookup_idx >= 0 {\n        let tag = array_get(ctx.ctor_table.tags, ctor_lookup_idx)\n        let fc = array_get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        array_push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        // For structs, unwrap ERecord and reorder fields\n        let actual_args = if array_length(args) == 1 {\n          match array_get(args, 0) {\n            ERecord(rec_fields) => {\n              let rec find_sn = (sni: Int) -> Int {\n                if sni >= array_length(ctx.ctor_table.struct_names) { -1 }\n                else if string_equals(array_get(ctx.ctor_table.struct_names, sni), fname) { sni }\n                else find_sn(sni + 1)\n              }\n              let sn_idx = find_sn(0)\n              if sn_idx >= 0 {\n                let def_fnames = array_get(ctx.ctor_table.struct_field_names, sn_idx)\n                let ordered = array_slice([EUnit], 0, 0)\n                let mut oi = 0\n                while oi < array_length(def_fnames) {\n                  let target_name = array_get(def_fnames, oi)\n                  let rec find_rf = (ri: Int) -> Expr {\n                    if ri >= array_length(rec_fields) { EUnit }\n                    else {\n                      let (rfn, rfv) = array_get(rec_fields, ri)\n                      if string_equals(rfn, target_name) { rfv }\n                      else find_rf(ri + 1)\n                    }\n                  }\n                  array_push(ordered, find_rf(0))\n                  oi = oi + 1\n                }\n                ordered\n              } else { args }\n            },\n            _ => args\n          }\n        } else { args }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < array_length(actual_args) {\n          nl_c = ce(buf, array_get(actual_args, fi_c), local_names, nl_c, ld)\n          let val_local = nl_c\n          array_push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n      else {\n      let fn_len2 = array_length(ctx.func_table.names)\n      let rec try_resolve = (j: Int) -> Int {\n        if j >= fn_len2 { -1 }\n        else if string_equals(array_get(ctx.func_table.names, j), fname) { j }\n        else try_resolve(j + 1)\n      }\n      let fn_idx_in_list = try_resolve(0)\n      if fn_idx_in_list >= 0 {\n        // Direct call to known function\n        let fidx = array_get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = array_get(ctx.func_table.returns, fn_idx_in_list)\n        let mut nl = next_local\n        let mut ci = 0\n        while ci < array_length(args) {\n          nl = ce(buf, array_get(args, ci), local_names, nl, ld)\n          ci = ci + 1\n        }\n        // User funcs in GC backend have __env param for table compatibility\n        if ctx.func_offset > 0 {\n          if fidx >= ctx.func_offset {\n            emit_i64_const(buf, 0)\n          }\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        // Indirect call: fname is a local holding a closure/fn value\n        let local_idx2 = resolve_local(local_names, fname, \"gc_call\")\n        let num_args = array_length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        array_push(local_names, \"__fn_val\")\n        array_push(local_names, \"__slot\")\n        array_push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          nl = ce(buf, array_get(args, ci), local_names, nl, ld)\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)\n        nl\n      }\n      } // close ctor_lookup else\n    },\n    _ => {\n      // Callee is an arbitrary expression\n      let num_args = array_length(args)\n      let fn_val_local = next_local\n      let slot_local = next_local + 1\n      let env_local = next_local + 2\n      let mut nl = next_local + 3\n      array_push(local_names, \"__fn_val\")\n      array_push(local_names, \"__slot\")\n      array_push(local_names, \"__env\")\n      nl = ce(buf, callee, local_names, nl, ld)\n      emit_local_set(buf, fn_val_local)\n      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n      let mut ci = 0\n      while ci < num_args {\n        nl = ce(buf, array_get(args, ci), local_names, nl, ld)\n        ci = ci + 1\n      }\n      emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)\n      nl\n    }\n  }\n}\n\nlet compile_match_gc = (\n  buf: Array[Int], scrutinee: Expr, arms: Array[(Pat, Expr)],\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  ce: (Array[Int], Expr, Array[String], Int, Int) -> Int with { Error }\n) -> Int with { Error } {\n  let scrut_local = next_local\n  array_push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = array_length(arms)\n  let catchall_idx = find_catchall_idx(arms)\n  let num_cond_arms = catchall_idx\n  let mut max_nl = nl1\n  let mut ai = 0\n  while ai < num_cond_arms {\n    let (p, _) = array_get(arms, ai)\n    match p {\n      PInt(n) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, n)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PBool(bv) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if bv { 1 } else { 0 })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PCtor(cname_cond, _) => {\n        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n        let expected_tag = if ctor_ci >= 0 { array_get(ctx.ctor_table.tags, ctor_ci) } else { -1 }\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i32_const(buf, expected_tag)\n        emit_i32_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PString(sval) => {\n        let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n        if str_idx >= 0 {\n          emit_local_get(buf, scrut_local)\n          emit_str_ref(buf, array_get(ctx.str_table.offsets, str_idx), array_get(ctx.str_table.lengths, str_idx))\n          emit_call(buf, 4)\n          emit_i64_const(buf, 1)\n          emit_i64_eq(buf)\n          emit_if_i64(buf)\n        }\n        0\n      },\n      _ => 0\n    }\n    let names_len_at_arm = array_length(local_names)\n    let (p2, arm_body) = array_get(arms, ai)\n    let ld_arm = if ld >= 0 { ld + ai + 1 } else { -1 }\n    match p2 {\n      PCtor(_, cargs_bind) => {\n        let mut cbi = 0\n        while cbi < array_length(cargs_bind) {\n          match array_get(cargs_bind, cbi) {\n            PBind(pname) => {\n              let fl = array_length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi * 8)\n              emit_local_set(buf, fl)\n              array_push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi = cbi + 1\n        }\n        let arm_nl = ce(buf, arm_body, local_names, array_length(local_names), ld_arm)\n        if arm_nl > max_nl { max_nl = arm_nl }\n        0\n      },\n      _ => {\n        let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)\n        if arm_nl > max_nl { max_nl = arm_nl }\n        0\n      }\n    }\n    emit_else(buf)\n    array_truncate(local_names, names_len_at_arm)\n    ai = ai + 1\n  }\n  let ld_catch = if ld >= 0 { ld + num_cond_arms } else { -1 }\n  let _names_len_at_catch = array_length(local_names)\n  if catchall_idx < num_arms {\n    let (cp, cbody) = array_get(arms, catchall_idx)\n    let catch_nl = match cp {\n      PBind(bname) => {\n        let bind_local = array_length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, bind_local)\n        array_push(local_names, bname)\n        ce(buf, cbody, local_names, array_length(local_names), ld_catch)\n      },\n      PCtor(_cname, cargs) => {\n        let mut cbi2 = 0\n        while cbi2 < array_length(cargs) {\n          match array_get(cargs, cbi2) {\n            PBind(pname) => {\n              let fl2 = array_length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi2 * 8)\n              emit_local_set(buf, fl2)\n              array_push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, cbody, local_names, array_length(local_names), ld_catch)\n      },\n      PTuple(pats) => {\n        let ptr_local2 = array_length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, ptr_local2)\n        array_push(local_names, \"__tup_ptr2\")\n        let mut pi2 = 0\n        while pi2 < array_length(pats) {\n          let tp = array_get(pats, pi2)\n          match tp {\n            PBind(pname) => {\n              let field_l = array_length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, field_l)\n              array_push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => throw(\"unsupported pattern in tuple destructure\")\n          }\n          pi2 = pi2 + 1\n        }\n        ce(buf, cbody, local_names, array_length(local_names), ld_catch)\n      },\n      _ => {\n        ce(buf, cbody, local_names, array_length(local_names), ld_catch)\n      }\n    }\n    if catch_nl > max_nl { max_nl = catch_nl }\n    0\n  } else {\n    bytebuf_push(buf, 0)  // unreachable\n    0\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  // Pad local_names to stay in sync with max_nl\n  while array_length(local_names) < max_nl {\n    array_push(local_names, \"\")\n  }\n  max_nl\n}\n\nlet compile_lambda_gc = (\n  buf: Array[Int], params: Array[(String, Option[TypeExpr])], fn_body: Expr,\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  compile_fn: (Array[Int], Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }\n) -> Int with { Error } {\n  let param_names_arr = array_slice([\"\"], 0, 0)\n  let mut pi = 0\n  while pi < array_length(params) {\n    let (pname, _) = array_get(params, pi)\n    array_push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = array_concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = array_length(captures)\n  let user_params = array_length(params)\n\n  // Compile lambda body into a separate buffer\n  let lam_buf = bytebuf_new()\n  let lam_locals = array_slice([\"\"], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = array_get(params, lpi)\n    array_push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  array_push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n\n  // Prologue: extract captures from env\n  let lam_ref_cells = array_slice([\"\"], 0, 0)\n  let lam_ref_local_indices = array_slice([0], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = array_get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    array_push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      array_push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n\n  // Compile lambda body\n  let lam_ctx = CompileCtxGc::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ref_local_indices: lam_ref_local_indices,\n    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,\n    ctor_table: ctx.ctor_table\n  }\n  let final_lam_nl = compile_fn(\n    lam_buf, fn_body, lam_locals, lam_nl,\n    lam_ctx, ld\n  )\n\n  // Record lambda AFTER body compilation (nested lambdas already added)\n  let lambda_idx = array_length(ctx.lambda_table.bodies)\n  array_push(ctx.lambda_table.bodies, lam_buf)\n  array_push(ctx.lambda_table.param_counts, user_params + 1)\n  array_push(ctx.lambda_table.captures, captures)\n  let extra_lam = if final_lam_nl > (user_params + 1) { final_lam_nl - (user_params + 1) } else { 0 }\n  array_push(ctx.lambda_table.meta_i32, 0)\n  array_push(ctx.lambda_table.meta_i64, extra_lam)\n\n  // Emit closure creation code\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot << 2) | 2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    array_push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = array_get(captures, csi)\n      let cap_idx = resolve_local(local_names, cap_name, \"gc_cap\")\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, cap_idx)\n      emit_i64_store(buf, 3, 8 + csi * 8)\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\n// === Expression compiler (GC backend) ===\n\nlet rec compile_expr_gc = (\n  buf: Array[Int],\n  expr: Expr,\n  local_names: Array[String],\n  next_local: Int,\n  ctx: CompileCtxGc,\n  ld: Int\n) -> Int with { Error } {\n  // shorthand for recursive call\n  let ce = (b: Array[Int], e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {\n    compile_expr_gc(b, e, ln, nl, ctx, d)\n  }\n  match expr {\n    EInt(n) => {\n      emit_i64_const(buf, n)\n      next_local\n    },\n    EBool(b_val) => {\n      emit_i64_const(buf, if b_val { 1 } else { 0 })\n      next_local\n    },\n    EFloat(v) => {\n      let bits = double_to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n    },\n    EString(s) => {\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, array_get(ctx.str_table.offsets, idx), array_get(ctx.str_table.lengths, idx))\n      next_local\n    },\n    EIdent(name) => {\n      // Try local first\n      let len = array_length(local_names)\n      let rec try_local = (i: Int) -> Int {\n        if i < 0 { -1 }\n        else if string_equals(array_get(local_names, i), name) { i }\n        else try_local(i - 1)\n      }\n      let local_idx = try_local(len - 1)\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          // Ref cell: local holds (ref $RefCell), read via struct.get\n          emit_local_get(buf, local_idx)\n          emit_struct_get(buf, ctx.refcell_type_idx, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        // Check if it's a 0-arg enum constructor\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = array_get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          array_push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n        // Check if it's a top-level function — emit as bare fn value\n        let fn_len = array_length(ctx.func_table.names)\n        let rec try_fn = (j: Int) -> Int with { Error } {\n          if j >= fn_len { throw(string_concat(\"undefined variable: \", name)) }\n          else if string_equals(array_get(ctx.func_table.names, j), name) { j }\n          else try_fn(j + 1)\n        }\n        let fni = try_fn(0)\n        let fidx = array_get(ctx.func_table.indices, fni)\n        let table_slot = fidx - ctx.func_offset\n        emit_i64_const(buf, (table_slot << 2) | 2)\n        next_local\n        }\n      }\n    },\n    EBinOp(op, lhs, rhs) => {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_binop_op(buf, op)\n      nl2\n    },\n    EUnaryOp(op, operand) => {\n      if string_equals(op, \"-\") {\n        emit_i64_const(buf, 0)\n        let nl = ce(buf, operand, local_names, next_local, ld)\n        emit_i64_sub(buf)\n        nl\n      } else if string_equals(op, \"!\") {\n        let nl = ce(buf, operand, local_names, next_local, ld)\n        // Bool: true=1, false=0. Use eqz to negate.\n        emit_i64_eqz(buf)\n        emit_i64_extend_i32_s(buf)\n        nl\n      } else {\n        throw(string_concat(\"unsupported unary op: \", op))\n      }\n    },\n    EIf(cond, then_e, else_e) => {\n      let nl1 = ce(buf, cond, local_names, next_local, ld)\n      emit_i32_wrap_i64(buf)\n      emit_if_i64(buf)\n      let ld_inner = if ld >= 0 { ld + 1 } else { -1 }\n      let names_len_before = array_length(local_names)\n      let nl2 = ce(buf, then_e, local_names, nl1, ld_inner)\n      emit_else(buf)\n      array_truncate(local_names, names_len_before)\n      let nl3 = ce(buf, else_e, local_names, nl1, ld_inner)\n      emit_end(buf)\n      let max_nl_if = if nl2 > nl3 { nl2 } else { nl3 }\n      // Pad local_names to stay in sync with max next_local\n      while array_length(local_names) < max_nl_if {\n        array_push(local_names, \"\")\n      }\n      max_nl_if\n    },\n    ECall(callee, args) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\n    ELet(name, value, body) => {\n      let local_idx = next_local\n      array_push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      let nl2 = ce(buf, body, local_names, nl, ld)\n      nl2\n    },\n    ELetRec(name, value, body) => {\n      let local_idx = next_local\n      array_push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      // Backpatch self-reference in closure for recursive let rec\n      match value {\n        EFn(_, _, params, _, _, fn_body) => {\n          let param_names_bp = array_slice([\"\"], 0, 0)\n          let mut bpi = 0\n          while bpi < array_length(params) {\n            let (pn, _) = array_get(params, bpi)\n            array_push(param_names_bp, pn)\n            bpi = bpi + 1\n          }\n          let caps = collect_free_vars(fn_body, param_names_bp, array_concat(ctx.func_table.names, ctx.ctor_table.names))\n          let mut self_cap_idx = -1\n          let mut bci = 0\n          while bci < array_length(caps) {\n            if string_equals(array_get(caps, bci), name) {\n              self_cap_idx = bci\n            }\n            bci = bci + 1\n          }\n          if self_cap_idx >= 0 {\n            emit_local_get(buf, local_idx)\n            emit_i64_const(buf, -4)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, local_idx)\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n          }\n          0\n        },\n        _ => 0\n      }\n      let nl2 = ce(buf, body, local_names, nl, ld)\n      nl2\n    },\n    ELetMut(name, value, body) => {\n      let local_idx = next_local\n      array_push(local_names, name)\n      if is_mut_captured_in(body, name) {\n        // Mutable captured: allocate GC ref cell via struct.new\n        array_push(ctx.ref_cell_names, name)\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_struct_new(buf, ctx.refcell_type_idx)\n        emit_local_set(buf, local_idx)\n        array_push(ctx.ref_local_indices, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      } else {\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_local_set(buf, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      }\n    },\n    EAssign(name, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        // Ref cell: struct.set\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    EAssignOp(name, op, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        // Ref cell: read via struct.get, compute, write via struct.set\n        emit_local_get(buf, idx)   // ref on stack (for struct.set later)\n        emit_local_get(buf, idx)   // ref on stack (for struct.get)\n        emit_struct_get(buf, ctx.refcell_type_idx, 0)  // current value\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    ESeq(first, second) => {\n      let nl = ce(buf, first, local_names, next_local, ld)\n      emit_drop(buf)\n      ce(buf, second, local_names, nl, ld)\n    },\n    ETuple(elems) => {\n      // Allocate N*8 bytes on heap, store each element as i64\n      let num_elems = array_length(elems)\n      let alloc_size = num_elems * 8\n      let ptr_local = next_local\n      array_push(local_names, \"__tuple_ptr\")\n      let mut nl = next_local + 1\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = ce(buf, array_get(elems, ti), local_names, nl, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    },\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\n    EArray(elems) => {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"array_push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      array_push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < array_length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = ce(buf, array_get(elems, ei), local_names, nl, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    },\n    EForIn(var_name, iter_expr, body) => {\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \"array_length\")\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \"array_get\")\n      let arr_local = next_local\n      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)\n      emit_local_set(buf, arr_local)\n      array_push(local_names, \"__for_arr\")\n      let i_local = nl1\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_local)\n      array_push(local_names, \"__for_i\")\n      let nl2 = nl1 + 1\n      emit_block_void(buf)\n        emit_loop_void(buf)\n          emit_local_get(buf, i_local)\n          emit_local_get(buf, arr_local)\n          emit_call(buf, arr_len_idx)\n          emit_i64_ge_s(buf)\n          emit_i64_extend_i32_s(buf)\n          emit_i32_wrap_i64(buf)\n          emit_br_if(buf, 1)\n          let var_local = nl2\n          emit_local_get(buf, arr_local)\n          emit_local_get(buf, i_local)\n          emit_call(buf, arr_get_idx)\n          emit_local_set(buf, var_local)\n          array_push(local_names, var_name)\n          let nl3 = nl2 + 1\n          let nl4 = ce(buf, body, local_names, nl3, ld + 1)\n          emit_drop(buf)\n          emit_local_get(buf, i_local)\n          emit_i64_const(buf, 1)\n          emit_i64_add(buf)\n          emit_local_set(buf, i_local)\n          emit_br(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl4\n    },\n    EWhile(cond, body) => {\n      emit_block_void(buf)\n        emit_loop_void(buf)\n          let nl1 = ce(buf, cond, local_names, next_local, ld + 1)\n          emit_i64_eqz(buf)\n          emit_br_if(buf, 1)\n          let nl2 = ce(buf, body, local_names, nl1, ld + 1)\n          emit_drop(buf)\n          emit_br(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl2\n    },\n    EBreak(_) => {\n      emit_br(buf, ld + 1)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EContinue(_) => {\n      emit_br(buf, ld)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EUnit => {\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EThrow(msg_expr) => {\n      let nl = ce(buf, msg_expr, local_names, next_local, ld)\n      emit_drop(buf)\n      bytebuf_push(buf, 0)  // unreachable\n      nl\n    },\n    EFn(_, _, params, _, _, fn_body) =>\n      compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),\n    EDot(obj, field) => {\n      // Struct field access: find field index from ctx.ctor_table.struct_field_names\n      let rec find_struct_field_idx = (si2: Int) -> Int {\n        if si2 >= array_length(ctx.ctor_table.struct_names) { -1 }\n        else {\n          let fnames = array_get(ctx.ctor_table.struct_field_names, si2)\n          let rec find_f = (fi: