  let source_23 = ("vibe/compiler/checker/builtins.vibe",
"//# Imports\n\nimport ../core {\n  Type, resolve_builtin\n}\n\n//# Functions\n\nlet no_params = () -> Array[Type] {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet lookup_fs = (name: String) -> Option[Type] {\n  if String::equals(name, \"Fs::read_file\") {\n    Some(CtFn([\n      CtString\n    ], CtString, true))\n  }\n  else if String::equals(name, \"Fs::write_file\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtUnit, true))\n  }\n  else if String::equals(name, \"Fs::read_bytes\") {\n    Some(CtFn([\n      CtString\n    ], CtBytes, true))\n  }\n  else if String::equals(name, \"Fs::write_bytes\") {\n    Some(CtFn([\n      CtString,\n      CtBytes\n    ], CtUnit, true))\n  }\n  else if String::equals(name, \"Fs::exists\") {\n    Some(CtFn([\n      CtString\n    ], CtBool, true))\n  }\n  else if String::equals(name, \"Fs::stat_token\") {\n    Some(CtFn([\n      CtString\n    ], CtInt, true))\n  }\n  else if String::equals(name, \"Fs::readdir\") {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), true))\n  }\n  else if String::equals(name, \"Fs::is_dir\") {\n    Some(CtFn([\n      CtString\n    ], CtBool, true))\n  }\n  else if String::equals(name, \"Fs::is_file\") {\n    Some(CtFn([\n      CtString\n    ], CtBool, true))\n  }\n  else if String::equals(name, \"Fs::mkdir\") {\n    Some(CtFn([\n      CtString\n    ], CtUnit, true))\n  }\n  else if String::equals(name, \"Fs::getcwd\") {\n    Some(CtFn(no_params(), CtString, true))\n  }\n  else if String::equals(name, \"Fs::chdir\") {\n    Some(CtFn([\n      CtString\n    ], CtUnit, true))\n  }\n  else if String::equals(name, \"Fs::remove\") {\n    Some(CtFn([\n      CtString\n    ], CtUnit, true))\n  }\n  else if String::equals(name, \"Fs::copy\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtUnit, true))\n  }\n  else if String::equals(name, \"Fs::append\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtUnit, true))\n  }\n  else None\n}\n\nlet lookup_io = (name: String) -> Option[Type] {\n  if String::equals(name, \"sh\") {\n    Some(CtFn([\n      CtString\n    ], CtString, true))\n  }\n  else if String::equals(name, \"sh_lines\") {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), true))\n  }\n  else if String::equals(name, \"path\") {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, false))\n  }\n  else if String::equals(name, \"Path::to_string\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else if String::equals(name, \"Path::is_absolute\") {\n    Some(CtFn([\n      CtString\n    ], CtBool, false))\n  }\n  else if String::equals(name, \"PromptText::new\") {\n    Some(CtFn([\n      CtString\n    ], CtString, false))\n  }\n  else if String::equals(name, \"Stdin::read_char\") {\n    Some(CtFn(no_params(), CtInt, true))\n  }\n  else if String::equals(name, \"Stdin::read_stream\") {\n    Some(CtFn(no_params(), CtString, true))\n  }\n  else if String::equals(name, \"Stdout::write_char\") {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Stdout::write_stream\") {\n    Some(CtFn([\n      CtString\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Env::get\") {\n    Some(CtFn([\n      CtString\n    ], CtString, true))\n  }\n  else if String::equals(name, \"Env::args_len\") {\n    Some(CtFn(no_params(), CtInt, true))\n  }\n  else if String::equals(name, \"Env::args_get\") {\n    Some(CtFn([\n      CtInt\n    ], CtString, true))\n  }\n  else if String::equals(name, \"sleep\") {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Path::resolve\") {\n    Some(CtFn([\n      CtString\n    ], CtString, false))\n  }\n  else None\n}\n\nlet lookup_map = (name: String) -> Option[Type] {\n  if String::equals(name, \"MapBuilder::new\") {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if String::equals(name, \"MapBuilder::set\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"MapBuilder::freeze\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnknown, false))\n  }\n  else if String::equals(name, \"Map::get\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtUnknown, false))\n  }\n  else if String::equals(name, \"map_has\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtBool, false))\n  }\n  else if String::equals(name, \"Map::keys\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtArray(CtString), false))\n  }\n  else None\n}\n\nlet lookup_net = (name: String) -> Option[Type] {\n  if String::equals(name, \"Socket::tcp_connect\") {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtUnknown, true))\n  }\n  else if String::equals(name, \"Socket::tcp_read\") {\n    Some(CtFn([\n      CtUnknown,\n      CtInt\n    ], CtString, true))\n  }\n  else if String::equals(name, \"Socket::tcp_write\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtInt, true))\n  }\n  else if String::equals(name, \"Socket::tcp_close\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnit, true))\n  }\n  else if String::equals(name, \"Http::request\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtUnknown, true))\n  }\n  else if String::equals(name, \"Http::response_status\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"Http::response_header\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtString, false))\n  }\n  else if String::equals(name, \"Http::response_body\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, true))\n  }\n  else if String::equals(name, \"Http::close\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Http::listen\") {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtUnknown, true))\n  }\n  else if String::equals(name, \"Http::accept\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnknown, true))\n  }\n  else if String::equals(name, \"Http::request_method\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else if String::equals(name, \"Http::request_header\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtString, false))\n  }\n  else if String::equals(name, \"Http::respond\") {\n    Some(CtFn([\n      CtUnknown,\n      CtInt,\n      CtString\n    ], CtUnit, true))\n  }\n  else None\n}\n\nlet lookup_misc = (name: String) -> Option[Type] {\n  if String::equals(name, \"eq\") {\n    Some(CtFn([\n      CtInt,\n      CtInt\n    ], CtBool, false))\n  }\n  else if String::equals(name, \"not\") {\n    Some(CtFn([\n      CtBool\n    ], CtBool, false))\n  }\n  else if String::equals(name, \"__to_string\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else if String::equals(name, \"print\") {\n    Some(CtFn([\n      CtString\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"println\") {\n    Some(CtFn([\n      CtString\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"assert\") {\n    Some(CtFn([\n      CtBool\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"throw\") {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, true))\n  }\n  else if String::equals(name, \"Int::to_double\") {\n    Some(CtFn([\n      CtInt\n    ], CtDouble, false))\n  }\n  else if String::equals(name, \"Double::to_int\") {\n    Some(CtFn([\n      CtDouble\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"Double::to_i64_bits\") {\n    Some(CtFn([\n      CtDouble\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"Double::from_i64_bits\") {\n    Some(CtFn([\n      CtInt\n    ], CtDouble, false))\n  }\n  else None\n}\n\nlet lookup_array = (name: String) -> Option[Type] {\n  if String::equals(name, \"Array::length\") {\n    Some(CtFn([\n      CtArray(CtUnknown)\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"Array::get\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt\n    ], CtUnknown, false))\n  }\n  else if String::equals(name, \"Array::set\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Array::push\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Array::slice\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtInt\n    ], CtArray(CtUnknown), false))\n  }\n  else if String::equals(name, \"Array::push_all\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtArray(CtUnknown)\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Array::concat\") {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtArray(CtUnknown)\n    ], CtArray(CtUnknown), false))\n  }\n  else None\n}\n\nlet lookup_bytes = (name: String) -> Option[Type] {\n  if String::equals(name, \"Bytes::new\") {\n    Some(CtFn(no_params(), CtBytes, false))\n  }\n  else if String::equals(name, \"Bytes::length\") {\n    Some(CtFn([\n      CtBytes\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"Bytes::get\") {\n    Some(CtFn([\n      CtBytes,\n      CtInt\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"Bytes::set\") {\n    Some(CtFn([\n      CtBytes,\n      CtInt,\n      CtInt\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Bytes::push\") {\n    Some(CtFn([\n      CtBytes,\n      CtInt\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"Bytes::concat\") {\n    Some(CtFn([\n      CtBytes,\n      CtBytes\n    ], CtBytes, false))\n  }\n  else if String::equals(name, \"Bytes::slice\") {\n    Some(CtFn([\n      CtBytes,\n      CtInt,\n      CtInt\n    ], CtBytes, false))\n  }\n  else if String::equals(name, \"Bytes::from_array\") {\n    Some(CtFn([\n      CtArray(CtInt)\n    ], CtBytes, false))\n  }\n  else if String::equals(name, \"Bytes::to_array\") {\n    Some(CtFn([\n      CtBytes\n    ], CtArray(CtInt), false))\n  }\n  else None\n}\n\nlet lookup_string1 = (name: String) -> Option[Type] {\n  if String::equals(name, \"String::concat\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, false))\n  }\n  else if String::equals(name, \"String::length\") {\n    Some(CtFn([\n      CtString\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"String::equals\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if String::equals(name, \"String::substring\") {\n    Some(CtFn([\n      CtString,\n      CtInt,\n      CtInt\n    ], CtString, false))\n  }\n  else if String::equals(name, \"string_char_at\") {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtString, false))\n  }\n  else None\n}\n\nlet lookup_string2 = (name: String) -> Option[Type] {\n  if String::equals(name, \"String::index_of\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"String::contains\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if String::equals(name, \"String::starts_with\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if String::equals(name, \"String::ends_with\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if String::equals(name, \"String::from_char_code\") {\n    Some(CtFn([\n      CtInt\n    ], CtString, false))\n  }\n  else if String::equals(name, \"String::char_code_at\") {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtInt, false))\n  }\n  else if String::equals(name, \"String::last_index_of\") {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtInt, false))\n  }\n  else None\n}\n\nlet lookup_array_builder = (name: String) -> Option[Type] {\n  if String::equals(name, \"ArrayBuilder::new\") {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if String::equals(name, \"ArrayBuilder::push\") {\n    Some(CtFn([\n      CtUnknown,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"ArrayBuilder::freeze\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtArray(CtUnknown), false))\n  }\n  else None\n}\n\nlet lookup_string_builder = (name: String) -> Option[Type] {\n  if String::equals(name, \"StringBuilder::new\") {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if String::equals(name, \"StringBuilder::push\") {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtUnit, false))\n  }\n  else if String::equals(name, \"StringBuilder::freeze\") {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else None\n}\n\nexport let lookup_builtin = (name: String) -> Option[Type] {\n  match lookup_array(name) {\n    Some(t) => Some(t),\n    None => match lookup_array_builder(name) {\n      Some(t) => Some(t),\n      None => match lookup_string1(name) {\n        Some(t) => Some(t),\n        None => match lookup_string2(name) {\n          Some(t) => Some(t),\n          None => match lookup_string_builder(name) {\n            Some(t) => Some(t),\n            None => match lookup_bytes(name) {\n              Some(t) => Some(t),\n              None => match lookup_map(name) {\n                Some(t) => Some(t),\n                None => match lookup_io(name) {\n                  Some(t) => Some(t),\n                  None => match lookup_fs(name) {\n                    Some(t) => Some(t),\n                    None => match lookup_net(name) {\n                      Some(t) => Some(t),\n                      None => lookup_misc(name)\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n")

  let source_24 = ("vibe/compiler/checker/checker_resolve.vibe",
"//# Imports\n\nimport ../core {\n  Type, TypeDef, TypeExpr, find_typedef, resolve_builtin\n}\n\n//# Functions\n\nexport let rec resolve_type_expr = (te: TypeExpr, defs: Array[TypeDef]) -> Type {\n  match te {\n    TyUnit => CtUnit,\n    TyName(name) => match resolve_builtin(name) {\n      Some(t) => t,\n      None => match find_typedef(defs, name) {\n        Some(td) => match td {\n          TDEnum(n, _) => CtEnum(n),\n          TDStruct(n, _) => CtStruct(n),\n          TDAlias(_, t) => t\n        },\n        None => CtNamed(name, Array::slice([\n          CtUnknown\n        ], 0, 0))\n      }\n    }\n    ,\n    TyApp(name, args) => {\n      let ra = for a in args {\n        resolve_type_expr(a, defs)\n      }\n      if String::equals(name, \"Array\") {\n        if Array::length(ra) == 1 {\n          CtArray(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else if String::equals(name, \"Option\") {\n        if Array::length(ra) == 1 {\n          CtOption(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else CtNamed(name, ra)\n    },\n    TyTuple(elems) => {\n      let r = for e in elems {\n        resolve_type_expr(e, defs)\n      }\n      CtTuple(r)\n    },\n    TyFn(params, ret) => {\n      let rp = for p in params {\n        resolve_type_expr(p, defs)\n      }\n      CtFn(rp, resolve_type_expr(ret, defs), false)\n    }\n  }\n}\n")

  let source_25 = ("vibe/compiler/checker/checker_pattern.vibe",
"//# Imports\n\nimport ../core {\n  Pat, Type, TypeDef, TypeEnv, env_bind, find_typedef\n}\n\n//# Functions\n\nlet find_ctor_in_defs = (defs: Array[TypeDef], ctor_name: String) -> Option[(String, Array[Type])] {\n  let dlen = Array::length(defs)\n  let rec go_defs = (di: Int) -> Option[(String, Array[Type])] {\n    if di >= dlen {\n      None\n    } else {\n      let d = Array::get(defs, di)\n      match d {\n        TDEnum(enum_name, variants) => {\n          let vlen = Array::length(variants)\n          let rec go_variants = (vi: Int) -> Option[(String, Array[Type])] {\n            if vi >= vlen {\n              go_defs(di + 1)\n            } else {\n              let (vname, vtypes) = Array::get(variants, vi)\n              if String::equals(vname, ctor_name) {\n                Some((enum_name, vtypes))\n              } else {\n                go_variants(vi + 1)\n              }\n            }\n          }\n          go_variants(0)\n        },\n        _ => go_defs(di + 1)\n      }\n    }\n  }\n  go_defs(0)\n}\n\nexport let rec check_pattern = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {\n  match pat {\n    PWild => env,\n    PBind(name) => env_bind(env, name, scrutinee_ty),\n    PInt(_) => env,\n    PString(_) => env,\n    PBool(_) => env,\n    PCtor(name, sub_pats) => match find_ctor_in_defs(defs, name) {\n      Some(info) => {\n        let (_, payload_types) = info\n        let splen = Array::length(sub_pats)\n        let ptlen = Array::length(payload_types)\n        let rec bind_subs = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n          if i >= splen {\n            acc_env\n          } else {\n            let sub_ty = if i < ptlen {\n              Array::get(payload_types, i)\n            } else {\n              CtUnknown\n            }\n            let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs)\n            bind_subs(i + 1, next_env)\n          }\n        }\n        bind_subs(0, env)\n      },\n      None => {\n        let splen = Array::length(sub_pats)\n        let rec bind_unknown = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n          if i >= splen {\n            acc_env\n          } else {\n            let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs)\n            bind_unknown(i + 1, next_env)\n          }\n        }\n        bind_unknown(0, env)\n      }\n    }\n    ,\n    PTuple(pats) => {\n      let plen = Array::length(pats)\n      match scrutinee_ty {\n        CtTuple(elem_tys) => {\n          let elen = Array::length(elem_tys)\n          let rec bind_tuple = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n            if i >= plen {\n              acc_env\n            } else {\n              let et = if i < elen {\n                Array::get(elem_tys, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs)\n              bind_tuple(i + 1, next_env)\n            }\n          }\n          bind_tuple(0, env)\n        },\n        _ => {\n          let rec bind_unk = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n            if i >= plen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs)\n              bind_unk(i + 1, next_env)\n            }\n          }\n          bind_unk(0, env)\n        }\n      }\n    },\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs)\n  }\n}\n")

  let source_26 = ("vibe/compiler/checker/checker.vibe",
"//# Imports\n\nimport ../core {\n  Expr, Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, type_implements_trait, unify\n}\n\nimport ./builtins.vibe {\n  lookup_builtin\n}\n\nimport ./checker_pattern.vibe {\n  check_pattern\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\n//# Functions\n\nlet min_int = (a: Int, b: Int) -> Int {\n  if a < b {\n    a\n  } else {\n    b\n  }\n}\n\nlet prepend_expr = (first: Expr, rest: Array[Expr]) -> Array[Expr] {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  Array::push(out, first)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nlet is_bool_binop = (op: String) -> Bool {\n  String::equals(op, \"==\")\n  || String::equals(op, \"!=\")\n  || String::equals(op, \"<\")\n  || String::equals(op, \">\")\n  || String::equals(op, \"<=\")\n  || String::equals(op, \">=\")\n  || String::equals(op, \"&&\")\n  || String::equals(op, \"||\")\n}\n\nlet is_logic_binop = (op: String) -> Bool {\n  String::equals(op, \"&&\")\n  || String::equals(op, \"||\")\n}\n\nlet is_equality_binop = (op: String) -> Bool {\n  String::equals(op, \"==\")\n  || String::equals(op, \"!=\")\n}\n\nlet is_order_binop = (op: String) -> Bool {\n  String::equals(op, \"<\")\n  || String::equals(op, \">\")\n  || String::equals(op, \"<=\")\n  || String::equals(op, \">=\")\n}\n\nlet unify_binop_candidate = (left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {\n  match unify(left_ty, target_ty, s) {\n    Some(s1) => unify(right_ty, target_ty, s1),\n    None => None\n  }\n}\n\nlet infer_binop_type = (op: String, left_ty: Type, right_ty: Type, s: Subst) -> (Type, Subst) {\n  if is_logic_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\n      Some(s1) => (CtBool, s1),\n      None => (CtUnknown, s)\n    }\n  }\n  else if is_equality_binop(op) {\n    match unify(left_ty, right_ty, s) {\n      Some(s1) => (CtBool, s1),\n      None => (CtUnknown, s)\n    }\n  }\n  else if is_order_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtBool, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtBool, s1),\n        None => (CtUnknown, s)\n      }\n    }\n  }\n  else if String::equals(op, \"+\") {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\n          Some(s1) => (CtString, s1),\n          None => (CtUnknown, s)\n        }\n      }\n    }\n  }\n  else if String::equals(op, \"-\")\n    || String::equals(op, \"*\")\n    || String::equals(op, \"/\") {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => (CtUnknown, s)\n      }\n    }\n  }\n  else if String::equals(op, \"%\") {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => (CtUnknown, s)\n    }\n  }\n  else (CtUnknown, s)\n}\n\nlet type_name_prefix = (ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"Unit\",\n    CtBytes => \"Bytes\",\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, _) => name,\n    _ => \"\"\n  }\n}\n\nexport let rec check_expr = (expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int) -> (Type, Subst, Int) {\n  match expr {\n    EInt(_) => (CtInt, s, c),\n    EFloat(_) => (CtDouble, s, c),\n    EString(_) => (CtString, s, c),\n    EBool(_) => (CtBool, s, c),\n    EUnit => (CtUnit, s, c),\n    EIdent(name) => match env_lookup(env, name) {\n      Some(t) => {\n        let (ti, c1, new_bounds) = instantiate(t, c)\n        let nblen = Array::length(new_bounds)\n        let mut s1 = s\n        let mut bi = 0\n        while bi < nblen {\n          let (vid, bounds) = Array::get(new_bounds, bi)\n          if !eq(Array::length(bounds), 0) {\n            s1 = subst_add_bound(s1, vid, bounds)\n          }\n          bi = bi + 1\n        }\n        (ti, s1, c1)\n      },\n      None => match lookup_builtin(name) {\n        Some(t) => (t, s, c),\n        None => (CtUnknown, s, c)\n      }\n    }\n    ,\n    ESeq(left, right) => {\n      let (_, s1, c1) = check_expr(left, env, defs, s, c)\n      check_expr(right, env, defs, s1, c1)\n    },\n    ELet(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c)\n      let gen = generalize(s1, vt)\n      check_expr(body, env_bind(env, name, gen), defs, s1, c1)\n    },\n    ELetRec(name, val, body) => {\n      let (tv, c1) = fresh_var(c)\n      let (vt, s1, c2) = check_expr(val, env_bind(env, name, tv), defs, s, c1)\n      let s2 = match unify(tv, vt, s1) {\n        Some(su) => su,\n        None => s1\n      }\n      let gen = generalize(s2, tv)\n      check_expr(body, env_bind(env, name, gen), defs, s2, c2)\n    },\n    ELetMut(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env_bind(env, name, vt), defs, s1, c1)\n    },\n    EIf(cond, then_e, else_e) => {\n      let (_, s1, c1) = check_expr(cond, env, defs, s, c)\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1)\n      let (_, s3, c3) = check_expr(else_e, env, defs, s2, c2)\n      (tt, s3, c3)\n    },\n    ECall(callee, args) => match callee {\n      EDot(obj, method) => {\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c)\n        let resolved = subst_apply(s1, obj_ty)\n        let type_prefix = type_name_prefix(resolved)\n        let qualified = String::concat(type_prefix, String::concat(\"::\", method))\n        let method_ty = match env_lookup(env, qualified) {\n          Some(t) => {\n            let (ti, c2, _) = instantiate(t, c1)\n            (ti, s1, c2)\n          },\n          None => match lookup_builtin(qualified) {\n            Some(t) => (t, s1, c1),\n            None => (CtUnknown, s1, c1)\n          }\n        }\n        let (mt, s2, c2) = method_ty\n        let all_args = prepend_expr(obj, args)\n        let alen = Array::length(all_args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        Array::push(arg_tys, obj_ty)\n        let mut ai = 1\n        let mut s3 = s2\n        let mut c3 = c2\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3)\n          Array::push(arg_tys, at)\n          s3 = ns\n          c3 = nc\n          ai = ai + 1\n        }\n        match subst_apply(s3, mt) {\n          CtFn(param_tys, ret, _) => {\n            let mut s4 = s3\n            let mut ui = 0\n            let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\n            while ui < ul {\n              s4 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s4) {\n                Some(su) => su,\n                None => s4\n              }\n              ui = ui + 1\n            }\n            (subst_apply(s4, ret), s4, c3)\n          },\n          _ => (CtUnknown, s3, c3)\n        }\n      },\n      _ => {\n        let (ct, s1, c1) = check_expr(callee, env, defs, s, c)\n        let alen = Array::length(args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut ai = 0\n        let mut s2 = s1\n        let mut c2 = c1\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2)\n          Array::push(arg_tys, at)\n          s2 = ns\n          c2 = nc\n          ai = ai + 1\n        }\n        match subst_apply(s2, ct) {\n          CtFn(param_tys, ret, _) => {\n            let mut s3 = s2\n            let mut ui = 0\n            let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\n            while ui < ul {\n              s3 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s3) {\n                Some(su) => su,\n                None => s3\n              }\n              ui = ui + 1\n            }\n            (subst_apply(s3, ret), s3, c2)\n          },\n          CtStruct(sname) => (CtStruct(sname), s2, c2),\n          _ => (CtUnknown, s2, c2)\n        }\n      }\n    },\n    EBinOp(op, left, right) => {\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c)\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1)\n      let (result_ty, s3) = infer_binop_type(\n        op,\n        subst_apply(s2, left_ty),\n        subst_apply(s2, right_ty),\n        s2\n      )\n      (subst_apply(s3, result_ty), s3, c2)\n    },\n    EUnaryOp(op, operand) => {\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c)\n      if String::equals(op, \"!\") {\n        match subst_apply(s1, operand_ty) {\n          CtBool => (CtBool, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\n            Some(s2) => (CtBool, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          _ => (CtUnknown, s1, c1)\n        }\n      } else if String::equals(op, \"-\") {\n        match subst_apply(s1, operand_ty) {\n          CtDouble => (CtDouble, s1, c1),\n          CtInt => (CtInt, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\n            Some(s2) => (CtInt, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          _ => (CtUnknown, s1, c1)\n        }\n      } else (CtUnknown, s1, c1)\n    },\n    EAssign(_, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env, defs, s1, c1)\n    },\n    EAssignOp(_, _, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env, defs, s1, c1)\n    },\n    EMatch(scrutinee, arms) => {\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c)\n      let alen = Array::length(arms)\n      if eq(alen, 0) {\n        (CtUnknown, s1, c1)\n      }\n      else {\n        let mut result_ty = CtUnknown\n        let mut si = s1\n        let mut ci = c1\n        let mut ai = 0\n        while ai < alen {\n          let (pat, body) = Array::get(arms, ai)\n          let arm_env = check_pattern(pat, scr_ty, env, defs)\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci)\n          if eq(ai, 0) {\n            result_ty = arm_ty\n          }\n          si = ns\n          ci = nc\n          ai = ai + 1\n        }\n        (result_ty, si, ci)\n      }\n    },\n    EHandle(body, _) => check_expr(body, env, defs, s, c),\n    EWhile(cond, body) => {\n      let (_, s1, c1) = check_expr(cond, env, defs, s, c)\n      let (_, s2, c2) = check_expr(body, env, defs, s1, c1)\n      (CtUnit, s2, c2)\n    },\n    ELoop(params, body) => {\n      let mut env1 = env\n      let mut s1 = s\n      let mut c1 = c\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1)\n        env1 = env_bind(env1, name, pt)\n        s1 = ns\n        c1 = nc\n        i = i + 1\n      }\n      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1)\n      (CtUnit, s2, c2)\n    },\n    EForIn(name, index_name, iterable, body) => {\n      let (it, s1, c1) = check_expr(iterable, env, defs, s, c)\n      let et = match it {\n        CtArray(elem) => elem,\n        _ => CtUnknown\n      }\n      let env2 = env_bind(env, name, et)\n      let env3 = match index_name {\n        Some(index_name) => env_bind(env2, index_name, CtInt),\n        None => env2\n      }\n      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1)\n      (CtArray(bt), s2, c2)\n    },\n    EDot(obj, field) => {\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c)\n      let resolved = subst_apply(s1, obj_ty)\n      let field_ty = match resolved {\n        CtStruct(sname) => match find_typedef(defs, sname) {\n          Some(td) => match td {\n            TDStruct(_, fields) => {\n              let rec find_field = (i: Int) -> Type {\n                if i >= Array::length(fields) {\n                  CtUnknown\n                } else {\n                  let (fname, ftype) = Array::get(fields, i)\n                  if String::equals(fname, field) {\n                    ftype\n                  } else find_field(i + 1)\n                }\n              }\n              find_field(0)\n            },\n            _ => CtUnknown\n          },\n          None => CtUnknown\n        },\n        _ => CtUnknown\n      }\n      (field_ty, s1, c1)\n    },\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\n      let he = match effect {\n        Some(_) => true,\n        None => false\n      }\n      let tplen = Array::length(tparams)\n      let rec alloc_tparams = (i: Int, acc_env: TypeEnv, acc_s: Subst, acc_c: Int) -> (TypeEnv, Subst, Int) {\n        if i >= tplen {\n          (acc_env, acc_s, acc_c)\n        }\n        else {\n          let tpname = Array::get(tparams, i)\n          let (tv, nc) = fresh_var(acc_c)\n          let vid = nc - 1\n          let tblen = Array::length(tbounds)\n          let rec find_bounds = (j: Int) -> Array[String] {\n            if j >= tblen {\n              Array::slice([\n                \"\"\n              ], 0, 0)\n            }\n            else {\n              let (bname, blist) = Array::get(tbounds, j)\n              if String::equals(bname, tpname) {\n                blist\n              }\n              else find_bounds(j + 1)\n            }\n          }\n          let bounds = find_bounds(0)\n          let ns = if eq(Array::length(bounds), 0) {\n            acc_s\n          }\n          else subst_add_bound(acc_s, vid, bounds)\n          alloc_tparams(i + 1, env_bind(acc_env, tpname, tv), ns, nc)\n        }\n      }\n      let (tp_env, s0, c0) = alloc_tparams(0, env, s, c)\n      let plen = Array::length(params)\n      let mut fn_env = tp_env\n      let mut s1 = s0\n      let mut c1 = c0\n      let param_types = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut pi = 0\n      while pi < plen {\n        let (name, ann) = Array::get(params, pi)\n        let (pt, ns, nc) = match ann {\n          Some(te) => {\n            let resolved = resolve_type_expr(te, defs)\n            let pt2 = match resolved {\n              CtNamed(tn, _) => match env_lookup(fn_env, tn) {\n                Some(t) => t,\n                None => resolved\n              },\n              _ => resolved\n            }\n            (pt2, s1, c1)\n          },\n          None => {\n            let (tv, nc2) = fresh_var(c1)\n            (tv, s1, nc2)\n          }\n        }\n        fn_env = env_bind(fn_env, name, pt)\n        Array::push(param_types, pt)\n        s1 = ns\n        c1 = nc\n        pi = pi + 1\n      }\n      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1)\n      let (final_ret, s3) = match ret_ty {\n        Some(te) => {\n          let resolved = resolve_type_expr(te, defs)\n          let resolved_ret = match resolved {\n            CtNamed(tn, _) => match env_lookup(fn_env, tn) {\n              Some(t) => t,\n              None => resolved\n            },\n            _ => resolved\n          }\n          match unify(bt, resolved_ret, s2) {\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\n            None => (CtUnknown, s2)\n          }\n        },\n        None => (subst_apply(s2, bt), s2)\n      }\n      let resolved_params = for p in param_types {\n        subst_apply(s3, p)\n      }\n      (CtFn(resolved_params, final_ret, he), s3, c2)\n    },\n    EBreak(opt) => match opt {\n      Some(e) => {\n        let (_, s1, c1) = check_expr(e, env, defs, s, c)\n        (CtUnit, s1, c1)\n      },\n      None => (CtUnit, s, c)\n    }\n    ,\n    EContinue(args) => {\n      let alen = Array::length(args)\n      let mut s1 = s\n      let mut c1 = c\n      let mut ai = 0\n      while ai < alen {\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1)\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtUnit, s1, c1)\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      let mut s1 = s\n      let mut c1 = c\n      let mut fi = 0\n      while fi < flen {\n        let (_, fval) = Array::get(fields, fi)\n        let (_, ns, nc) = check_expr(fval, env, defs, s1, c1)\n        s1 = ns\n        c1 = nc\n        fi = fi + 1\n      }\n      (CtUnknown, s1, c1)\n    },\n    ETuple(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let tys = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut ti = 0\n      while ti < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1)\n        Array::push(tys, it)\n        s1 = ns\n        c1 = nc\n        ti = ti + 1\n      }\n      (CtTuple(tys), s1, c1)\n    },\n    EArray(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let mut elem_ty = CtUnknown\n      let mut ai = 0\n      while ai < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1)\n        if eq(ai, 0) {\n          elem_ty = it\n        }\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtArray(elem_ty), s1, c1)\n    },\n    _ => (CtUnknown, s, c)\n  }\n}\n")

  let source_27 = ("vibe/compiler/checker/checker_stmt.vibe",
"//# Imports\n\nimport ../core {\n  Stmt, Subst, Type, TypeDef, TypeEnv, env_bind, env_flat_bindings, env_lookup_flat, generalize, impls_overlap_for, resolve_builtin, subst_apply, trait_defined\n}\n\nimport ./checker.vibe {\n  check_expr\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\n//# Functions\n\nlet rec import_cache_lookup = (cache: Array[(String, Type)], name: String, i: Int) -> Option[Type] {\n  if i >= Array::length(cache) {\n    None\n  }\n  else {\n    let (cached_name, cached_ty) = Array::get(cache, i)\n    if String::equals(cached_name, name) {\n      Some(cached_ty)\n    }\n    else import_cache_lookup(cache, name, i + 1)\n  }\n}\n\nexport let rec check_stmts = (stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int) -> (TypeEnv, Subst, Int) {\n  if i >= Array::length(stmts) {\n    (env, s, c)\n  } else {\n    let stmt = Array::get(stmts, i)\n    let (new_env, s1, c1) = match stmt {\n      SLet(_, is_rec, name, ann, val) => {\n        let (vt, ns, nc) = if is_rec {\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c)\n        } else {\n          check_expr(val, env, defs, s, c)\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => generalize(ns, vt)\n        }\n        (env_bind(env, name, t), ns, nc)\n      },\n      SLetMut(name, ann, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c)\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => vt\n        }\n        (env_bind(env, name, t), ns, nc)\n      },\n      SEnum(_, name, variants) => {\n        let resolved_variants = Array::slice([\n          (\"\", Array::slice([\n            CtUnknown\n          ], 0, 0))\n        ], 0, 0)\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = Array::slice([\n            CtUnknown\n          ], 0, 0)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            let vt = resolve_type_expr(Array::get(vtypes, ti), defs)\n            Array::push(resolved_vtypes, vt)\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, resolved_variants))\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          if eq(Array::length(vtypes), 0) {\n            env1 = env_bind(env1, vname, CtEnum(name))\n          } else {\n            let resolved_args = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))\n              ai = ai + 1\n            }\n            env1 = env_bind(env1, vname, CtFn(resolved_args, CtEnum(name), false))\n          }\n          ci2 = ci2 + 1\n        }\n        (env1, s, c)\n      }\n      ,\n      SStruct(_, name, field_defs) => {\n        let resolved_fields = Array::slice([\n          (\"\", CtUnit)\n        ], 0, 0)\n        let mut fi = 0\n        while fi < Array::length(field_defs) {\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\n          let ftype = resolve_type_expr(ftype_expr, defs)\n          Array::push(resolved_fields, (fname, ftype))\n          fi = fi + 1\n        }\n        Array::push(defs, TDStruct(name, resolved_fields))\n        let field_types = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut fj = 0\n        while fj < Array::length(resolved_fields) {\n          let (_, fty) = Array::get(resolved_fields, fj)\n          Array::push(field_types, fty)\n          fj = fj + 1\n        }\n        (env_bind(env, name, CtFn(field_types, CtStruct(name), false)), s, c)\n      }\n      ,\n      STypeAlias(_, name, te) => {\n        let t = resolve_type_expr(te, defs)\n        (env_bind(env, name, t), s, c)\n      },\n      SExternLet(name, te) => {\n        let t = resolve_type_expr(te, defs)\n        (env_bind(env, name, t), s, c)\n      },\n      STest(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SBench(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SExpr(expr) => {\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SModule(_, _, body) => {\n        let _ = check_stmts(body, 0, env, defs, s, c)\n        (env, s, c)\n      },\n      SImport(_, names) => {\n        let env_bindings = env_flat_bindings(env)\n        let import_cache = Array::slice([\n          (\"\", CtUnknown)\n        ], 0, 0)\n        let nlen = Array::length(names)\n        let rec bind_imports = (i: Int, acc: TypeEnv) -> TypeEnv {\n          if i >= nlen {\n            acc\n          }\n          else {\n            let (name, alias) = Array::get(names, i)\n            let bound_name = match alias {\n              Some(a) => a,\n              None => name\n            }\n            let ty = match import_cache_lookup(import_cache, name, 0) {\n              Some(t) => t,\n              None => {\n                let resolved = match env_lookup_flat(env_bindings, name) {\n                  Some(t) => t,\n                  None => CtUnknown\n                }\n                Array::push(import_cache, (name, resolved))\n                resolved\n              }\n            }\n            bind_imports(i + 1, env_bind(acc, bound_name, ty))\n          }\n        }\n        (bind_imports(0, env), s, c)\n      },\n      STrait(_, name, supers) => {\n        let is_open = false\n        (EnvTraitDef(name, supers, is_open, env), s, c)\n      },\n      SImpl(_, _, trait_name, type_name) => {\n        let target = match resolve_builtin(type_name) {\n          Some(t) => t,\n          None => CtNamed(type_name, Array::slice([\n            CtUnknown\n          ], 0, 0))\n        }\n        (EnvTraitImpl(trait_name, target, env), s, c)\n      },\n      _ => (env, s, c)\n    }\n    check_stmts(stmts, i + 1, new_env, defs, s1, c1)\n  }\n}\n\nexport let check_program = (stmts: Array[Stmt]) -> TypeEnv {\n  let empty_defs = Array::slice([\n    TDAlias(\"_dummy\", CtUnit)\n  ], 0, 0)\n  let (env, _, _) = check_stmts(stmts, 0, EnvEmpty, empty_defs, SubstEmpty, 0)\n  env\n}\n\nexport let check_program_with_env = (stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv {\n  let empty_defs = Array::slice([\n    TDAlias(\"_dummy\", CtUnit)\n  ], 0, 0)\n  let (env, _, _) = check_stmts(stmts, 0, initial_env, empty_defs, SubstEmpty, 0)\n  env\n}\n")

  let source_28 = ("vibe/compiler/checker/index.vibe",
"export ./builtins.vibe {\n  lookup_builtin\n}\n\nexport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\nexport ./checker_pattern.vibe {\n  check_pattern\n}\n\nexport ./checker.vibe {\n  check_expr\n}\n\nexport ./checker_stmt.vibe {\n  check_stmts, check_program, check_program_with_env\n}\n")

  let source_29 = ("vibe/compiler/builtins.vibe",
"//# Imports\n\nexport ./checker {\n  lookup_builtin\n}\n\n//# Misc\n\nexport {\n  lookup_builtin\n}\n")

  let source_30 = ("vibe/compiler/checker_resolve.vibe",
"//# Imports\n\nexport ./checker {\n  resolve_type_expr\n}\n\n//# Misc\n\nexport {\n  resolve_type_expr\n}\n")

  let source_31 = ("vibe/compiler/checker_pattern.vibe",
"//# Imports\n\nexport ./checker {\n  check_pattern\n}\n\n//# Misc\n\nexport {\n  check_pattern\n}\n")

  let source_32 = ("vibe/compiler/checker.vibe",
"//# Imports\n\nexport ./checker {\n  check_expr\n}\n\n//# Misc\n\nexport {\n  check_expr\n}\n")

  let source_33 = ("vibe/compiler/checker_stmt.vibe",
"//# Imports\n\nexport ./checker {\n  check_program, check_program_with_env, check_stmts\n}\n\n//# Misc\n\nexport {\n  check_stmts, check_program, check_program_with_env\n}\n")

  let source_34 = ("vibe/compiler/codegen/wasm_emit/index.vibe",
"// WASM binary emitter — generates minimal valid .wasm modules\n// Uses bytebuf.vibe for byte-level binary construction\n\nimport ../../core/index.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes,\n  bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header,\n  leb128_encode_u32, leb128_encode_s64\n}\n\n// === Emit helpers ===\n\n// Emit WASM magic number and version\nexport let emit_header = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 97)   // 'a'\n  bytebuf_push(buf, 115)  // 's'\n  bytebuf_push(buf, 109)  // 'm'\n  bytebuf_push(buf, 1)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n\n// Encode a function type: (i64 x param_count) -> (i64 x result_count)\nexport let emit_func_type = (buf: Array[Int], param_count: Int, result_count: Int) -> Unit {\n  bytebuf_push(buf, 96)  // 0x60 = func type marker\n  leb128_encode_u32(buf, param_count)\n  let mut i = 0\n  while i < param_count {\n    bytebuf_push(buf, 126)  // i64\n    i = i + 1\n  }\n  leb128_encode_u32(buf, result_count)\n  let mut j = 0\n  while j < result_count {\n    bytebuf_push(buf, 126)  // i64\n    j = j + 1\n  }\n}\n\n// Emit type section with multiple function types\n// type_defs: flat array of [param_count, result_count, param_count, result_count, ...]\nexport let emit_type_section_multi = (out: Array[Int], type_defs: Array[Int]) -> Unit {\n  let count = Array::length(type_defs) / 2\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 1, content)\n}\n\n// Emit type section with a single function type (convenience)\nexport let emit_type_section = (out: Array[Int], param_count: Int, result_count: Int) -> Unit {\n  emit_type_section_multi(out, [param_count, result_count])\n}\n\n// Emit function section — maps function indices to type indices\nexport let emit_function_section = (out: Array[Int], type_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(type_indices))\n  let mut i = 0\n  while i < Array::length(type_indices) {\n    leb128_encode_u32(content, Array::get(type_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 3, content)\n}\n\n// Helper: emit a name string (length-prefixed ASCII)\nexport let emit_name = (buf: Array[Int], name: String) -> Unit {\n  let name_len = String::length(name)\n  leb128_encode_u32(buf, name_len)\n  let mut i = 0\n  while i < name_len {\n    bytebuf_push(buf, String::char_code_at(name, i))\n    i = i + 1\n  }\n}\n\n// Emit export section with multiple exports\n// names: array of export names, func_indices: matching array of function indices\nexport let emit_export_section_multi = (out: Array[Int], names: Array[String], func_indices: Array[Int]) -> Unit {\n  let count = Array::length(names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_name(content, Array::get(names, i))\n    bytebuf_push(content, 0)  // export kind: function\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit export section — single export (convenience)\nexport let emit_export_section = (out: Array[Int], name: String, func_idx: Int) -> Unit {\n  emit_export_section_multi(out, [name], [func_idx])\n}\n\n// Emit memory section: 1 memory with min pages, no max\nexport let emit_memory_section = (out: Array[Int], min_pages: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 memory\n  bytebuf_push(content, 0)  // limits: no max\n  leb128_encode_u32(content, min_pages)\n  bytebuf_push_section(out, 5, content)\n}\n\n// Emit a code section with function bodies\n// Each body is pre-encoded instructions (without end opcode)\nexport let emit_code_section = (out: Array[Int], bodies: Array[Array[Int]]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let func_buf = bytebuf_new()\n    leb128_encode_u32(func_buf, 0)  // 0 local declarations\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end opcode\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_array(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\n// Emit code section with local declarations\n// local_decls: array of [count, valtype] pairs per function (flat)\n// For now: emit one block of count locals of type i64\nexport let emit_code_section_with_locals = (out: Array[Int], bodies: Array[Array[Int]], local_counts: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let num_locals = Array::get(local_counts, i)\n    let func_buf = bytebuf_new()\n    if num_locals == 0 {\n      leb128_encode_u32(func_buf, 0)  // 0 local decl blocks\n    } else {\n      leb128_encode_u32(func_buf, 1)  // 1 local decl block\n      leb128_encode_u32(func_buf, num_locals)\n      bytebuf_push(func_buf, 126)  // i64\n    }\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_array(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\n// === Instruction emitters ===\n\nexport let emit_local_get = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 32)  // local.get\n  leb128_encode_u32(buf, idx)\n}\n\nexport let emit_local_set = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 33)  // local.set\n  leb128_encode_u32(buf, idx)\n}\n\nexport let emit_local_tee = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 34)  // local.tee\n  leb128_encode_u32(buf, idx)\n}\n\nexport let emit_i64_const = (buf: Array[Int], value: Int) -> Unit {\n  bytebuf_push(buf, 66)  // i64.const\n  leb128_encode_s64(buf, value)\n}\n\nexport let emit_i64_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 124)\n}\n\nexport let emit_i64_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 125)\n}\n\nexport let emit_i64_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 126)\n}\n\nexport let emit_i64_div_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 127)\n}\n\nexport let emit_i64_rem_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 129)  // 0x81\n}\n\nexport let emit_i64_and = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 131)  // 0x83\n}\n\nexport let emit_i64_or = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 132)  // 0x84\n}\n\nexport let emit_i64_xor = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 133)  // 0x85\n}\n\nexport let emit_i64_shl = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 134)  // 0x86\n}\n\nexport let emit_i64_shr_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 135)  // 0x87\n}\n\nexport let emit_i64_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 81)  // 0x51\n}\n\nexport let emit_i64_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 82)  // 0x52\n}\n\nexport let emit_i64_lt_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 83)  // 0x53\n}\n\nexport let emit_i64_gt_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 85)  // 0x55\n}\n\nexport let emit_i64_le_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 87)  // 0x57\n}\n\nexport let emit_i64_ge_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 89)  // 0x59\n}\n\nexport let emit_i64_eqz = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 80)  // 0x50\n}\n\nexport let emit_call = (buf: Array[Int], func_idx: Int) -> Unit {\n  bytebuf_push(buf, 16)  // call\n  leb128_encode_u32(buf, func_idx)\n}\n\nexport let emit_drop = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 26)  // drop\n}\n\nexport let emit_return = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 15)  // return\n}\n\n// Control flow: block types\n// 0x40 = void block, 0x7E = i64 block\nexport let emit_block_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 2)   // block\n  bytebuf_push(buf, 64)  // 0x40 = void\n}\n\nexport let emit_block_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 2)   // block\n  bytebuf_push(buf, 126) // 0x7E = i64\n}\n\nexport let emit_loop_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 3)   // loop\n  bytebuf_push(buf, 64)  // void\n}\n\nexport let emit_if_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 4)   // if\n  bytebuf_push(buf, 64)  // void\n}\n\nexport let emit_if_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 4)   // if\n  bytebuf_push(buf, 126) // i64\n}\n\nexport let emit_else = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 5)   // else\n}\n\nexport let emit_end = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 11)  // end\n}\n\nexport let emit_br = (buf: Array[Int], label: Int) -> Unit {\n  bytebuf_push(buf, 12)  // br\n  leb128_encode_u32(buf, label)\n}\n\nexport let emit_br_if = (buf: Array[Int], label: Int) -> Unit {\n  bytebuf_push(buf, 13)  // br_if\n  leb128_encode_u32(buf, label)\n}\n\n// i64.extend_i32_s — extend i32 comparison result to i64\nexport let emit_i64_extend_i32_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 172)  // 0xAC\n}\n\n// i32.wrap_i64 — truncate i64 to i32\nexport let emit_i32_wrap_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 167)  // 0xA7\n}\n\n// === i32 instructions (needed for WASI APIs) ===\n\nexport let emit_i32_const = (buf: Array[Int], value: Int) -> Unit {\n  bytebuf_push(buf, 65)  // i32.const\n  leb128_encode_s64(buf, value)  // sleb128 works for i32 too\n}\n\nexport let emit_i32_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 106)  // 0x6A\n}\n\nexport let emit_i32_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 54)  // 0x36 i32.store\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_i32_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 40)  // 0x28 i32.load\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_i32_store8 = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 58)  // 0x3A i32.store8\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_i32_load8_u = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 45)  // 0x2D i32.load8_u\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n// === Section emitters: Import, Data, Global ===\n\n// Emit raw func type with explicit valtype arrays\n// param_types/result_types: arrays of valtype ints (126=i64, 127=i32)\nexport let emit_func_type_raw = (buf: Array[Int], param_types: Array[Int], result_types: Array[Int]) -> Unit {\n  bytebuf_push(buf, 96)  // 0x60\n  leb128_encode_u32(buf, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    bytebuf_push(buf, Array::get(param_types, i))\n    i = i + 1\n  }\n  leb128_encode_u32(buf, Array::length(result_types))\n  let mut j = 0\n  while j < Array::length(result_types) {\n    bytebuf_push(buf, Array::get(result_types, j))\n    j = j + 1\n  }\n}\n\n// Emit import section: import a function\n// module_name, field_name: import path, type_idx: type index\nexport let emit_import_section_func = (out: Array[Int], module_name: String, field_name: String, type_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 import\n  emit_name(content, module_name)\n  emit_name(content, field_name)\n  bytebuf_push(content, 0)  // import kind: function\n  leb128_encode_u32(content, type_idx)\n  bytebuf_push_section(out, 2, content)  // section id 2 = import\n}\n\n// Emit data section: place byte data at a memory offset\n// segments: array of [offset, data_buf] pairs\nexport let emit_data_section = (out: Array[Int], offset: Int, data: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 data segment\n  // Active data segment: memory index 0\n  bytebuf_push(content, 0)  // flags: active, memory 0\n  // Offset expression: i32.const <offset>, end\n  emit_i32_const(content, offset)\n  emit_end(content)\n  // Data bytes\n  leb128_encode_u32(content, Array::length(data))\n  bytebuf_push_array(content, data)\n  bytebuf_push_section(out, 11, content)  // section id 11 = data\n}\n\n// Emit global section: one mutable i32 global with initial value\nexport let emit_global_section_i32_mut = (out: Array[Int], init_value: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 global\n  bytebuf_push(content, 127)  // i32\n  bytebuf_push(content, 1)    // mutable\n  emit_i32_const(content, init_value)\n  emit_end(content)\n  bytebuf_push_section(out, 6, content)  // section id 6 = global\n}\n\nexport let emit_global_get = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 35)  // global.get\n  leb128_encode_u32(buf, idx)\n}\n\nexport let emit_global_set = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push(buf, 36)  // global.set\n  leb128_encode_u32(buf, idx)\n}\n\n// Emit export for memory\nexport let emit_export_memory = (out: Array[Int], name: String, mem_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, name)\n  bytebuf_push(content, 2)  // export kind: memory\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit combined export section: functions + optional memory\nexport let emit_exports_with_memory = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {\n  let count = Array::length(fn_names) + 1\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  // Function exports\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, 0)  // function\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  // Memory export\n  emit_name(content, mem_name)\n  bytebuf_push(content, 2)  // memory\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, 7, content)\n}\n\n// Emit export section with functions, memory, and globals\n// Export kinds: 0=func, 1=table, 2=memory, 3=global\nexport let emit_exports_full = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  // Function exports\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, 0)  // function\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  // Memory export\n  emit_name(content, mem_name)\n  bytebuf_push(content, 2)  // memory\n  leb128_encode_u32(content, mem_idx)\n  // Global exports\n  let mut gi = 0\n  while gi < Array::length(global_names) {\n    emit_name(content, Array::get(global_names, gi))\n    bytebuf_push(content, 3)  // global\n    leb128_encode_u32(content, Array::get(global_indices, gi))\n    gi = gi + 1\n  }\n  bytebuf_push_section(out, 7, content)\n}\n\n// === High-level: build a complete module ===\n\n// Build a minimal WASM module with one exported function: add(i64, i64) -> i64\nexport let build_add_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, [body])\n  bytebuf_to_bytes(out)\n}\n\n// Build a module with internal call: square(x) = x*x, sum_sq(a,b) = square(a) + square(b)\nexport let build_call_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // 2 types: type0 = (i64) -> (i64), type1 = (i64, i64) -> (i64)\n  emit_type_section_multi(out, [1, 1, 2, 1])\n\n  // 2 functions: func0=square(type0), func1=sum_sq(type1)\n  emit_function_section(out, [0, 1])\n\n  // export both\n  emit_export_section_multi(out, [\"square\", \"sum_sq\"], [0, 1])\n\n  // square: x * x\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n\n  // sum_sq: square(a) + square(b)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)  // call square\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)  // call square\n  emit_i64_add(ss_body)\n\n  emit_code_section(out, [sq_body, ss_body])\n  bytebuf_to_bytes(out)\n}\n\n// Build a module with add, sub, mul exported (all using same type: (i64, i64) -> i64)\nexport let build_arithmetic_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // 1 type: (i64, i64) -> (i64)\n  emit_type_section(out, 2, 1)\n\n  // 3 functions, all type 0\n  emit_function_section(out, [0, 0, 0])\n\n  // 3 exports\n  emit_export_section_multi(out, [\"add\", \"sub\", \"mul\"], [0, 1, 2])\n\n  // 3 function bodies\n  let add_body = bytebuf_new()\n  emit_local_get(add_body, 0)\n  emit_local_get(add_body, 1)\n  emit_i64_add(add_body)\n\n  let sub_body = bytebuf_new()\n  emit_local_get(sub_body, 0)\n  emit_local_get(sub_body, 1)\n  emit_i64_sub(sub_body)\n\n  let mul_body = bytebuf_new()\n  emit_local_get(mul_body, 0)\n  emit_local_get(mul_body, 1)\n  emit_i64_mul(mul_body)\n\n  emit_code_section(out, [add_body, sub_body, mul_body])\n  bytebuf_to_bytes(out)\n}\n\n// Build fibonacci module: fib(n) iterative\n// params: n (local 0)\n// locals: a (local 1), b (local 2), tmp (local 3)\n// Algorithm: a=0, b=1, while(n>0) { tmp=a+b; a=b; b=tmp; n=n-1 }; return a\nexport let build_fibonacci_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // type0: (i64) -> (i64)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"fib\", 0)\n\n  let b = bytebuf_new()\n  // local 0 = n (param), locals 1=a, 2=b, 3=tmp\n\n  // a = 0\n  emit_i64_const(b, 0)\n  emit_local_set(b, 1)\n  // b = 1\n  emit_i64_const(b, 1)\n  emit_local_set(b, 2)\n\n  // block $break\n  emit_block_void(b)\n    // loop $continue\n    emit_loop_void(b)\n      // if n <= 0, break\n      emit_local_get(b, 0)\n      emit_i64_const(b, 0)\n      emit_i64_le_s(b)\n      emit_br_if(b, 1)  // br $break (label 1 = outer block)\n\n      // tmp = a + b\n      emit_local_get(b, 1)\n      emit_local_get(b, 2)\n      emit_i64_add(b)\n      emit_local_set(b, 3)\n      // a = b\n      emit_local_get(b, 2)\n      emit_local_set(b, 1)\n      // b = tmp\n      emit_local_get(b, 3)\n      emit_local_set(b, 2)\n      // n = n - 1\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_sub(b)\n      emit_local_set(b, 0)\n\n      // br $continue (label 0 = loop)\n      emit_br(b, 0)\n    emit_end(b)  // end loop\n  emit_end(b)    // end block\n\n  // return a\n  emit_local_get(b, 1)\n\n  emit_code_section_with_locals(out, [b], [3])\n  bytebuf_to_bytes(out)\n}\n\n// Build factorial module: fact(n) iterative\n// params: n (local 0), locals: result (local 1)\n// Algorithm: result=1, while(n>1) { result=result*n; n=n-1 }; return result\nexport let build_factorial_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"fact\", 0)\n\n  let b = bytebuf_new()\n  // result = 1\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n\n  // block $break\n  emit_block_void(b)\n    // loop $continue\n    emit_loop_void(b)\n      // if n <= 1, break\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_le_s(b)\n      emit_br_if(b, 1)\n\n      // result = result * n\n      emit_local_get(b, 1)\n      emit_local_get(b, 0)\n      emit_i64_mul(b)\n      emit_local_set(b, 1)\n\n      // n = n - 1\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_sub(b)\n      emit_local_set(b, 0)\n\n      emit_br(b, 0)\n    emit_end(b)\n  emit_end(b)\n\n  // return result\n  emit_local_get(b, 1)\n\n  emit_code_section_with_locals(out, [b], [1])\n  bytebuf_to_bytes(out)\n}\n\n// Build a WASI hello world module\n// Imports fd_write from wasi_snapshot_preview1, writes \"hello world\\n\" to stdout\nexport let build_hello_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // Type section:\n  //   type0: fd_write(i32, i32, i32, i32) -> i32\n  //   type1: _start() -> void\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])\n  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))\n  bytebuf_push_section(out, 1, type_content)\n\n  // Import section: fd_write from wasi_snapshot_preview1 (func index 0)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n\n  // Function section: _start is func index 1 (after 1 import), type 1\n  emit_function_section(out, [1])\n\n  // Memory section: 1 page\n  emit_memory_section(out, 1)\n\n  // Export section: _start + memory\n  emit_exports_with_memory(out, [\"_start\"], [1], \"memory\", 0)\n\n  // Code section: _start body (must come before data section)\n  // Setup iovec at memory[0]: {ptr=8, len=12}\n  // Then call fd_write(1, 0, 1, 100)\n  //   fd=1 (stdout), iovs_ptr=0, iovs_count=1, nwritten_ptr=100\n  let b = bytebuf_new()\n\n  // mem[0] = 8 (iovec.buf pointer)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n\n  // mem[4] = 12 (iovec.buf_len)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 12)\n  emit_i32_store(b, 2, 0)\n\n  // call fd_write(1, 0, 1, 100)\n  emit_i32_const(b, 1)    // fd = stdout\n  emit_i32_const(b, 0)    // iovs ptr\n  emit_i32_const(b, 1)    // iovs count\n  emit_i32_const(b, 100)  // nwritten ptr\n  emit_call(b, 0)         // call fd_write (import index 0)\n  emit_drop(b)            // discard return value\n\n  emit_code_section(out, [b])\n\n  // Data section: \"hello world\\n\" at offset 8\n  let hello_data = bytebuf_new()\n  bytebuf_push(hello_data, 104)  // h\n  bytebuf_push(hello_data, 101)  // e\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 111)  // o\n  bytebuf_push(hello_data, 32)   // ' '\n  bytebuf_push(hello_data, 119)  // w\n  bytebuf_push(hello_data, 111)  // o\n  bytebuf_push(hello_data, 114)  // r\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 100)  // d\n  bytebuf_push(hello_data, 10)   // \\n\n  emit_data_section(out, 8, hello_data)\n\n  bytebuf_to_bytes(out)\n}\n\n// === String data helpers ===\n\n// Convert a string to a byte array (ASCII only)\nexport let string_to_data = (s: String) -> Array[Int] {\n  let buf = bytebuf_new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\n// Emit data section with multiple segments\nexport let emit_data_section_multi = (out: Array[Int], offsets: Array[Int], datas: Array[Array[Int]]) -> Unit {\n  let count = Array::length(offsets)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    bytebuf_push(content, 0)  // active, memory 0\n    emit_i32_const(content, Array::get(offsets, i))\n    emit_end(content)\n    let data = Array::get(datas, i)\n    leb128_encode_u32(content, Array::length(data))\n    bytebuf_push_array(content, data)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 11, content)\n}\n\n// Build a WASI module that prints a custom string\nexport let build_print_string_module = (msg: String) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // Types: fd_write(i32,i32,i32,i32)->i32, _start()->void\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])\n  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))\n  bytebuf_push_section(out, 1, type_content)\n\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, [1])\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, [\"_start\"], [1], \"memory\", 0)\n\n  // String data at offset 16 (leave 0-15 for iovec + nwritten)\n  let str_data = string_to_data(msg)\n  let str_len = Array::length(str_data)\n\n  // Code: setup iovec and call fd_write\n  let b = bytebuf_new()\n  // iovec[0].buf = 16\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 16)\n  emit_i32_store(b, 2, 0)\n  // iovec[0].len = str_len\n  emit_i32_const(b, 4)\n  emit_i32_const(b, str_len)\n  emit_i32_store(b, 2, 0)\n  // fd_write(stdout=1, iovs=0, count=1, nwritten=8)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n\n  emit_code_section(out, [b])\n  emit_data_section(out, 16, str_data)\n  bytebuf_to_bytes(out)\n}\n\n// === f64 instructions ===\n\n// f64.const — emit raw i64 bits as f64 constant\n// Caller provides the raw i64 bits (from Double::to_i64_bits builtin)\nexport let emit_f64_const_bits = (buf: Array[Int], bits: Int) -> Unit {\n  bytebuf_push(buf, 68)  // 0x44 f64.const\n  // Emit 8 bytes in little-endian\n  bytebuf_push(buf, bits & 255)\n  bytebuf_push(buf, (bits >> 8) & 255)\n  bytebuf_push(buf, (bits >> 16) & 255)\n  bytebuf_push(buf, (bits >> 24) & 255)\n  bytebuf_push(buf, (bits >> 32) & 255)\n  bytebuf_push(buf, (bits >> 40) & 255)\n  bytebuf_push(buf, (bits >> 48) & 255)\n  bytebuf_push(buf, (bits >> 56) & 255)\n}\n\nexport let emit_f64_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 160)  // 0xA0\n}\n\nexport let emit_f64_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 161)  // 0xA1\n}\n\nexport let emit_f64_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 162)  // 0xA2\n}\n\nexport let emit_f64_div = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 163)  // 0xA3\n}\n\nexport let emit_f64_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 97)  // 0x61\n}\n\nexport let emit_f64_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 98)  // 0x62\n}\n\nexport let emit_f64_lt = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 99)  // 0x63\n}\n\nexport let emit_f64_gt = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 100)  // 0x64\n}\n\nexport let emit_f64_le = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 101)  // 0x65\n}\n\nexport let emit_f64_ge = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 102)  // 0x66\n}\n\nexport let emit_f64_neg = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 154)  // 0x9A\n}\n\n// i64.reinterpret_f64 — reinterpret f64 bits as i64\nexport let emit_i64_reinterpret_f64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 189)  // 0xBD\n}\n\n// f64.reinterpret_i64 — reinterpret i64 bits as f64\nexport let emit_f64_reinterpret_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 191)  // 0xBF\n}\n\n// i64.trunc_f64_s — truncate f64 to signed i64\nexport let emit_i64_trunc_f64_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 176)  // 0xB0\n}\n\n// f64.convert_i64_s — convert signed i64 to f64\nexport let emit_f64_convert_i64_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 185)  // 0xB9\n}\n\n// === Table and indirect call support ===\n\n// call_indirect: opcode 0x11 + type_idx (LEB128) + table 0x00\nexport let emit_call_indirect = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push(buf, 17)  // 0x11\n  leb128_encode_u32(buf, type_idx)\n  bytebuf_push(buf, 0)   // table index 0\n}\n\n// Emit table section (section 4): 1 funcref table with min=num_entries, no max\nexport let emit_table_section_funcref = (out: Array[Int], num_entries: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 table\n  bytebuf_push(content, 112)  // 0x70 = funcref\n  bytebuf_push(content, 0)    // limits: no max\n  leb128_encode_u32(content, num_entries)\n  bytebuf_push_section(out, 4, content)\n}\n\n// Emit element section (section 9): active segment for table 0 at offset 0\n// func_indices: array of function indices to place in table\nexport let emit_element_section_active = (out: Array[Int], func_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 segment\n  bytebuf_push(content, 0)  // flags: active, table 0\n  // Offset expression: i32.const 0, end\n  emit_i32_const(content, 0)\n  emit_end(content)\n  // Function indices\n  leb128_encode_u32(content, Array::length(func_indices))\n  let mut i = 0\n  while i < Array::length(func_indices) {\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 9, content)\n}\n\n// === GC instructions ===\n\n// Emit a struct type definition: struct { field_types[i] with field_muts[i] }\n// field_types: valtype bytes (0x7E=i64, 0x7F=i32, etc.)\n// field_muts: 0x00=const, 0x01=mut\nexport let emit_struct_type_raw = (buf: Array[Int], field_types: Array[Int], field_muts: Array[Int]) -> Unit {\n  bytebuf_push(buf, 95)  // 0x5F = struct\n  leb128_encode_u32(buf, Array::length(field_types))\n  let mut i = 0\n  while i < Array::length(field_types) {\n    bytebuf_push(buf, Array::get(field_types, i))\n    bytebuf_push(buf, Array::get(field_muts, i))\n    i = i + 1\n  }\n}\n\n// struct.new $type — create a new struct (values on stack)\nexport let emit_struct_new = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push(buf, 251)  // 0xFB GC prefix\n  leb128_encode_u32(buf, 0)  // struct.new\n  leb128_encode_u32(buf, type_idx)\n}\n\n// struct.get $type $field — read a struct field\nexport let emit_struct_get = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push(buf, 251)  // 0xFB\n  leb128_encode_u32(buf, 2)  // struct.get\n  leb128_encode_u32(buf, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\n// struct.set $type $field — write a struct field\nexport let emit_struct_set = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push(buf, 251)  // 0xFB\n  leb128_encode_u32(buf, 5)  // struct.set\n  leb128_encode_u32(buf, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\n// ref.func $func — get a typed function reference\nexport let emit_ref_func = (buf: Array[Int], func_idx: Int) -> Unit {\n  bytebuf_push(buf, 210)  // 0xD2\n  leb128_encode_u32(buf, func_idx)\n}\n\n// call_ref $type — call a function reference\nexport let emit_call_ref = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push(buf, 20)  // 0x14\n  leb128_encode_u32(buf, type_idx)\n}\n\n// ref.null $heaptype — push a null reference\nexport let emit_ref_null = (buf: Array[Int], heap_type_byte: Int) -> Unit {\n  bytebuf_push(buf, 208)  // 0xD0\n  bytebuf_push(buf, heap_type_byte)\n}\n")

  let source_35 = ("vibe/compiler/codegen/common_base/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_xor, emit_if_void, emit_local_get, emit_local_set\n}\n\n//# Types\n\n// Function registry: groups parallel arrays for function metadata\nexport struct FuncTable {\n  names: Array[String];\n  indices: Array[Int];\n  params: Array[Int];\n  returns: Array[Int]\n}\n\n// String table: groups string data with their WASM data segment offsets/lengths\nexport struct StrTable {\n  strs: Array[String];\n  offsets: Array[Int];\n  lengths: Array[Int]\n}\n\n// Lambda accumulator: collects compiled lambda bodies and metadata\nexport struct LambdaTable {\n  bodies: Array[Array[Int]];\n  param_counts: Array[Int];\n  captures: Array[Array[String]];\n  meta_i32: Array[Int];\n  meta_i64: Array[Int]\n}\n\n// Constructor/struct registry: enum variant + struct constructors\nexport struct CtorTable {\n  names: Array[String];\n  tags: Array[Int];\n  field_counts: Array[Int];\n  type_names: Array[String];\n  struct_names: Array[String];\n  struct_field_names: Array[Array[String]]\n}\n\n// Compilation context: all shared state for compile_expr\nexport struct CompileCtx {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ctor_table: CtorTable;\n  thunk_names: Array[String]\n}\n\n// GC backend compilation context (extends CompileCtx with GC-specific fields)\nexport struct CompileCtxGc {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ref_local_indices: Array[Int];\n  refcell_type_idx: Int;\n  closure_type_base: Int;\n  ctor_table: CtorTable\n}\n\n//# Functions\n\nexport let is_efn = (expr: Expr) -> Bool {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pint = (p: Pat) -> Bool {\n  match p {\n    PInt(_) => true,\n    _ => false\n  }\n}\n\n// === Stmt extractors ===\nexport let is_slet = (stmt: Stmt) -> Bool {\n  match stmt {\n    SLet(_, _, _, _, _) => true,\n    _ => false\n  }\n}\n\n// Expr tag: returns a numeric tag for dispatch without match in let rec\n// 0=EInt, 1=EBool, 2=EFloat, 3=EString, 4=EIdent, 5=EBinOp, 6=EUnaryOp,\n// 7=EIf, 8=ECall, 9=ELet, 10=ELetRec, 11=ELetMut, 12=EAssign, 13=EAssignOp,\n// 14=ESeq, 15=ETuple, 16=EMatch, 17=EArray, 18=EForIn, 19=EWhile,\n// 20=EBreak, 21=EContinue, 22=EUnit, 23=EThrow, 24=EFn, -1=unknown\nexport let expr_tag = (expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EBool(_) => 1,\n    EFloat(_) => 2,\n    EString(_) => 3,\n    EIdent(_) => 4,\n    EBinOp(_, _, _) => 5,\n    EUnaryOp(_, _) => 6,\n    EIf(_, _, _) => 7,\n    ECall(_, _) => 8,\n    ELet(_, _, _) => 9,\n    ELetRec(_, _, _) => 10,\n    ELetMut(_, _, _) => 11,\n    EAssign(_, _, _) => 12,\n    EAssignOp(_, _, _, _) => 13,\n    ESeq(_, _) => 14,\n    ETuple(_) => 15,\n    EMatch(_, _) => 16,\n    EArray(_) => 17,\n    EForIn(_, _, _, _) => 18,\n    EWhile(_, _) => 19,\n    EBreak(_) => 20,\n    EContinue(_) => 21,\n    EUnit => 22,\n    EThrow(_) => 23,\n    EFn(_, _, _, _, _, _) => 24,\n    _ => -1\n  }\n}\n\nexport let is_pbind = (p: Pat) -> Bool {\n  match p {\n    PBind(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pbool = (p: Pat) -> Bool {\n  match p {\n    PBool(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pctor = (p: Pat) -> Bool {\n  match p {\n    PCtor(_, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pwild = (p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    _ => false\n  }\n}\n\n// Expr type checks (only those needed inside match arms)\nexport let is_eident = (expr: Expr) -> Bool {\n  match expr {\n    EIdent(_) => true,\n    _ => false\n  }\n}\n\n// Check if expr is an ETuple\nexport let is_etuple = (expr: Expr) -> Bool {\n  match expr {\n    ETuple(_) => true,\n    _ => false\n  }\n}\n\n// Check pattern type\nexport let is_ptuple = (p: Pat) -> Bool {\n  match p {\n    PTuple(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pstring = (p: Pat) -> Bool {\n  match p {\n    PString(_) => true,\n    _ => false\n  }\n}\n\nexport let emit_i32_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 70)\n  // 0x46\n}\n\nexport let emit_i32_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 71)\n  // 0x47\n}\n\n// Extract pattern from match arm pair\nexport let get_arm_pat = (arm: (Pat, Expr)) -> Pat {\n  let (p, _) = arm\n  p\n}\n\n// Returns index into ctor_names array, or -1 if not found\nexport let rec lookup_ctor = (ctor_names: Array[String], name: String, i: Int) -> Int {\n  if i >= Array::length(ctor_names) {\n    -1\n  }\n  else if String::equals(Array::get(ctor_names, i), name) {\n    i\n  }\n  else lookup_ctor(ctor_names, name, i + 1)\n}\n\nexport let emit_i32_eqz = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 69)\n  // 0x45\n}\n\nexport let emit_i32_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 108)\n  // 0x6C\n}\n\nexport let emit_i32_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 107)\n  // 0x6B\n}\n\nexport let emit_str_ref = (buf: Array[Int], offset: Int, length: Int) -> Unit {\n  emit_i64_const(buf, offset)\n  emit_i64_const(buf, 32)\n  emit_i64_shl(buf)\n  emit_i64_const(buf, length)\n  emit_i64_or(buf)\n}\n\n// Extract body from match arm pair\nexport let get_arm_body = (arm: (Pat, Expr)) -> Expr {\n  let (_, b) = arm\n  b\n}\n\nexport let get_efn_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EFn(_, _, _, _, _, body) => body,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eif_cond = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(c, _, _) => c,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_else = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, _, e) => e,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_then = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, t, _) => t,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_elet_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, val, _) => val,\n    _ => throw(\"not ELet\")\n  }\n}\n\n// Resolve function: returns (func_index, param_count, has_return)\nexport let resolve_func = (ft: FuncTable, name: String) -> (Int, Int, Int)with { Error } {\n  let len = Array::length(ft.names)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if String::equals(Array::get(ft.names, i), name) {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"undefined function: \", name))\n  };\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\n}\n\n// Emit WASM instruction for a binary operator\nexport let emit_binop_op = (buf: Array[Int], op: String) -> Unit with { Error } {\n  if String::equals(op, \"+\") {\n    emit_i64_add(buf)\n  }\n  else if String::equals(op, \"-\") {\n    emit_i64_sub(buf)\n  }\n  else if String::equals(op, \"*\") {\n    emit_i64_mul(buf)\n  }\n  else if String::equals(op, \"/\") {\n    emit_i64_div_s(buf)\n  }\n  else if String::equals(op, \"%\") {\n    emit_i64_rem_s(buf)\n  }\n  else if String::equals(op, \"&\") {\n    emit_i64_and(buf)\n  }\n  else if String::equals(op, \"|\") {\n    emit_i64_or(buf)\n  }\n  else if String::equals(op, \"^\") {\n    emit_i64_xor(buf)\n  }\n  else if String::equals(op, \"<<\") {\n    emit_i64_shl(buf)\n  }\n  else if String::equals(op, \">>\") {\n    emit_i64_shr_s(buf)\n  }\n  else if String::equals(op, \"==\") {\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if String::equals(op, \"!=\") {\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if String::equals(op, \"<\") {\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if String::equals(op, \">\") {\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if String::equals(op, \"<=\") {\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if String::equals(op, \">=\") {\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if String::equals(op, \"&&\") {\n    emit_i64_and(buf)\n  }\n  else if String::equals(op, \"||\") {\n    emit_i64_or(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported binop: \", op))\n  }\n}\n\nexport let emit_i32_ge_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 79)\n  // 0x4F\n}\n\nexport let emit_i64_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 41)\n  // 0x29\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let get_ebinop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EBinOp(op, _, _) => op,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_elet_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, _, body) => body,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let get_elet_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELet(name, _, _) => name,\n    _ => throw(\"not ELet\")\n  }\n}\n\n// Extract function body from SLet(_, _, _, _, EFn(_, _, _, _, _, body))\nexport let get_func_body = (stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, _, _, _, body) => body,\n      _ => throw(\"get_func_body: not a function\")\n    },\n    _ => throw(\"get_func_body: not a let statement\")\n  }\n}\n\nexport let get_slet_expr = (stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => expr,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let get_slet_name = (stmt: Stmt) -> String with { Error } {\n  match stmt {\n    SLet(_, _, name, _, _) => name,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let resolve_local = (names: Array[String], name: String, tag: String) -> Int with { Error } {\n  let mut i = Array::length(names) - 1\n  let mut result = -1\n  while i >= 0 {\n    if String::equals(Array::get(names, i), name) {\n      result = i\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  if result < 0 {\n    let mut dbg = String::concat(\"undefined variable (local): \", name)\n    dbg = String::concat(dbg, \" [locals: \")\n    let mut di = 0\n    let dlen = Array::length(names)\n    while di < dlen {\n      if di > 0 {\n        dbg = String::concat(dbg, \", \")\n      }\n      dbg = String::concat(dbg, Array::get(names, di))\n      di = di + 1\n    }\n    dbg = String::concat(dbg, \"]\")\n    dbg = String::concat(dbg, \" @\")\n    dbg = String::concat(dbg, tag)\n    throw(dbg)\n  }\n  result\n}\n\nexport let emit_i64_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 55)\n  // 0x37\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n// Find the SLet statement for a given function name\nexport let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {\n  let len = Array::length(stmts)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, sname, _, _) => if String::equals(sname, name) {\n        found = i\n        i = len\n      }\n      ,\n      _ => ()\n    }\n    if found < 0 {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"function not found: \", name))\n  }\n  Array::get(stmts, found)\n}\n")

  let source_36 = ("vibe/compiler/codegen/common_extractors/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub\n}\n\n//# Functions\n\nexport let get_ebinop_lhs = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, lhs, _) => lhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ebinop_rhs = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, _, rhs) => rhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ecall_args = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ECall(_, args) => args,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efn_params = (expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\n  match expr {\n    EFn(_, _, params, _, _, _) => params,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eint_value = (expr: Expr) -> Int with { Error } {\n  match expr {\n    EInt(n) => n,\n    _ => throw(\"not EInt\")\n  }\n}\n\nexport let get_eseq_first = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(first, _) => first,\n    _ => throw(\"not ESeq\")\n  }\n}\n\n// Extract arms from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_arms = (expr: Expr) -> Array[(Pat, Expr)] with { Error } {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\n// Extract name from PBind\nexport let get_pbind_name = (p: Pat) -> String with { Error } {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\nexport let get_pctor_args = (p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\n// Extract PCtor name and args\nexport let get_pctor_name = (p: Pat) -> String with { Error } {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\n// Extract PInt value\nexport let get_pint_value = (p: Pat) -> Int with { Error } {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\nexport let get_eassign_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, val, _) => val,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_ebool_value = (expr: Expr) -> Bool with { Error } {\n  match expr {\n    EBool(b) => b,\n    _ => throw(\"not EBool\")\n  }\n}\n\nexport let get_eforin_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, _, body) => body,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_iter = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, iter, _) => iter,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EForIn(name, _, _, _) => name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eident_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EIdent(name) => name,\n    _ => throw(\"not EIdent\")\n  }\n}\n\nexport let get_eletmut_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, val, _) => val,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, val, _) => val,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eseq_second = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(_, second) => second,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport let get_ethrow_expr = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EThrow(e) => e,\n    _ => throw(\"not EThrow\")\n  }\n}\n\nexport let get_eunaryop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EUnaryOp(op, _) => op,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport let get_ewhile_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(_, body) => body,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport let get_ewhile_cond = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(cond, _) => cond,\n    _ => throw(\"not EWhile\")\n  }\n}\n\n// Extract PBool value\nexport let get_pbool_value = (p: Pat) -> Bool with { Error } {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\n// Extract sub-patterns from PTuple\nexport let get_ptuple_pats = (p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\nexport let get_slet_export = (stmt: Stmt) -> Bool with { Error } {\n  match stmt {\n    SLet(is_export, _, _, _, _) => is_export,\n    _ => throw(\"not SLet\")\n  }\n}\n\n// Check if a pattern is unconditionally matching (catch-all)\nexport let rec is_catchall_pat = (p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      // PTuple is catch-all only if ALL sub-patterns are catch-all\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(pats) {\n        if !is_catchall_pat(Array::get(pats, i)) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\n// Emit WASM instruction for an assign operator (+=, -=, etc.)\nexport let emit_assignop_op = (buf: Array[Int], op: String) -> Unit with { Error } {\n  if String::equals(op, \"+\") {\n    emit_i64_add(buf)\n  }\n  else if String::equals(op, \"-\") {\n    emit_i64_sub(buf)\n  }\n  else if String::equals(op, \"*\") {\n    emit_i64_mul(buf)\n  }\n  else if String::equals(op, \"/\") {\n    emit_i64_div_s(buf)\n  }\n  else if String::equals(op, \"%\") {\n    emit_i64_rem_s(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported assign op: \", op))\n  }\n}\n\nexport let emit_memory_copy = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 252)\n  // 0xFC prefix\n  leb128_encode_u32(buf, 10)\n  // memory.copy\n  bytebuf_push(buf, 0)\n  // src memory\n  bytebuf_push(buf, 0)\n  // dst memory\n}\n\nexport let get_earray_elems = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    EArray(elems) => elems,\n    _ => throw(\"not EArray\")\n  }\n}\n\nexport let get_eassign_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, _, body) => body,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassign_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssign(name, _, _) => name,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassignop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(_, op, _, _) => op,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_ecall_callee = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ECall(callee, _) => callee,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efloat_value = (expr: Expr) -> Double with { Error } {\n  match expr {\n    EFloat(v) => v,\n    _ => throw(\"not EFloat\")\n  }\n}\n\nexport let get_eletmut_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, _, body) => body,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletmut_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELetMut(name, _, _) => name,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, _, body) => body,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eletrec_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELetRec(name, _, _) => name,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\n// Extract elements from ETuple\nexport let get_etuple_elems = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\nexport let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {\n  let len = Array::length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if String::equals(Array::get(strs, i), s) {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"string not in table: \", s))\n  }\n  found\n}\n\n// Find the index of the first catch-all pattern in match arms\n// Returns num_arms if no catch-all found\nexport let find_catchall_idx = (arms: Array[(Pat, Expr)]) -> Int {\n  let num = Array::length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = Array::get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\nexport let get_eassignop_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, val, _) => val,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_estring_value = (expr: Expr) -> String with { Error } {\n  match expr {\n    EString(s) => s,\n    _ => throw(\"not EString\")\n  }\n}\n\nexport let get_eunaryop_expr = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EUnaryOp(_, e) => e,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\n// Extract PString value\nexport let get_pstring_value = (p: Pat) -> String with { Error } {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\nexport let array_contains_str = (arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if String::equals(Array::get(arr, i), s) {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let get_eassignop_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, _, body) => body,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_eassignop_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(name, _, _, _) => name,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\n// Extract scrutinee from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_scrutinee = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n")

  let source_37 = ("vibe/compiler/codegen/common_analysis/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_and, emit_i64_const, emit_i64_eq, emit_i64_or, emit_i64_shl, emit_i64_shr_s, emit_if_void, emit_local_get, emit_local_set\n}\n\n//# Functions\n\n\nexport let rec collect_strings_expr = (expr: Expr, out: Array[String]) -> Int {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(out) {\n        if String::equals(Array::get(out, i), s) {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found {\n        Array::push(out, s)\n      }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args) => {\n      collect_strings_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_strings_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, _, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_expr) = Array::get(arms, i)\n        match pat {\n          PString(s) => {\n            let mut pf = false\n            let mut pi = 0\n            while pi < Array::length(out) {\n              if String::equals(Array::get(out, pi), s) {\n                pf = true\n              }\n              pi = pi + 1\n            }\n            if !pf {\n              Array::push(out, s)\n            }\n            0\n          },\n          _ => 0\n        }\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EThrow(msg) => collect_strings_expr(msg, out),\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\n// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))\nexport let get_func_param_names = (stmt: Stmt) -> Array[String] with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, _) = Array::get(params, i)\n          Array::push(names, pname)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\nexport let collect_strings_stmts = (stmts: Array[Stmt]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let emit_i64_extend_i32_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, 173)\n  // 0xAD\n}\n\n// Resolve closure/fn value tag and fill slot_local/env_local\n// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)\nexport let emit_closure_resolve = (buf: Array[Int], fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n  // Bare fn: table_slot = fn_val >> 2, env = 0\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 2)\n  emit_i64_shr_s(buf)\n  emit_local_set(buf, slot_local)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, env_local)\n  emit_else(buf)\n  // Closure: env = fn_val & ~3, slot = i32.load(env, 0)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, -4)\n  emit_i64_and(buf)\n  emit_local_set(buf, env_local)\n  emit_local_get(buf, env_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i64_extend_i32_u(buf)\n  emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\n// Emit the tail of an indirect closure call (push env, push slot, call_indirect)\nexport let emit_closure_call_tail = (buf: Array[Int], env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\nlet rec collect_pattern_bindings = (pat: Pat, bindings: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(bindings, name); 0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pattern_bindings(Array::get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_pattern_bindings(Array::get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\n    },\n    _ => 0\n  }\n}\n\n// Stack-based free variable analysis: uses in-place push/truncate on bound array\n// to avoid O(n) array copies at every scope boundary. This dramatically reduces\n// heap allocation during meta-circular self-compilation.\nexport let rec collect_free_vars_expr = (expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name) => if array_contains_str(bound, name) {\n      0\n    }\n    else if array_contains_str(fn_names, name) {\n      0\n    }\n    else if array_contains_str(out, name) {\n      0\n    }\n    else {\n      Array::push(out, name)\n      0\n    }\n    ,\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => {\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\n    },\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\n    EIf(cond, then_e, else_e) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\n    },\n    ECall(callee, args) => {\n      collect_free_vars_expr(callee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(value, bound, fn_names, out)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EAssign(_, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    ESeq(first, second) => {\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\n    },\n    EWhile(cond, body) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EForIn(var_name, index_name, iter_e, body) => {\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, var_name)\n      match index_name {\n        Some(index_name) => Array::push(bound, index_name),\n        None => ()\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (arm_pat, arm_expr) = Array::get(arms, i)\n        let saved = Array::length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        Array::truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = Array::length(bound)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        Array::push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr(body, bound, fn_names, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _) => collect_free_vars_expr(obj, bound, fn_names, out),\n    ERecord(fields) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_free_vars_expr(fval, bound, fn_names, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\n    _ => 0\n  }\n}\n\nexport let collect_free_vars = (body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  // Make a mutable copy of param_names for stack-based push/truncate\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\n  collect_free_vars_expr(body, bound, fn_names, out)\n  out\n}\n\n// Check if a mutable variable is captured by any nested EFn in the given expression\nexport let rec is_mut_captured_in = (expr: Expr, name: String) -> Bool {\n  match expr {\n    EIdent(_) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args) => if is_mut_captured_in(callee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if is_mut_captured_in(Array::get(args, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    }\n    ,\n    ELet(n, value, body) => if String::equals(n, name) {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    ELetRec(n, value, body) => if String::equals(n, name) {\n      false\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    ELetMut(n, value, body) => if String::equals(n, name) {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    }\n    ,\n    EFn(_, _, params, _, _, fn_body) => {\n      // Check if name is shadowed by params\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        if String::equals(pname, name) {\n          shadowed = true\n        }\n        pi = pi + 1\n      }\n      if shadowed {\n        false\n      }\n      else {\n        // Check if name is free in this EFn\n        let param_names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut pi2 = 0\n        while pi2 < Array::length(params) {\n          let (pname2, _) = Array::get(params, pi2)\n          Array::push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\n          \"\"\n        ], 0, 0))\n        if array_contains_str(fv, name) {\n          true\n        }\n        else {\n          // Also check recursively for deeper nesting\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EThrow(msg) => is_mut_captured_in(msg, name),\n    _ => false\n  }\n}\n")

  let source_38 = ("vibe/compiler/codegen/expr/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport ../common_base/index.vibe {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport ../common_analysis/index.vibe {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nlet compile_call = (buf: Array[Int], callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  if is_eident(callee) {\n    let fname = get_eident_name(callee)\n    let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n    if ctor_lookup_idx >= 0 {\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n      let obj_size = 8 + fc * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__ctor_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, tag)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, fc)\n      emit_i32_store(buf, 2, 4)\n      let actual_args = if Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ERecord(rec_fields) => {\n            let mut si2 = 0\n            let mut sn_idx = -1\n            while si2 < Array::length(ctx.ctor_table.struct_names) {\n              if String::equals(Array::get(ctx.ctor_table.struct_names, si2), fname) {\n                sn_idx = si2\n                si2 = Array::length(ctx.ctor_table.struct_names)\n              } else {\n                si2 = si2 + 1\n              }\n            }\n            if sn_idx >= 0 {\n              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n              let ordered = Array::slice([\n                EUnit\n              ], 0, 0)\n              let mut oi = 0\n              while oi < Array::length(def_fnames) {\n                let target_name = Array::get(def_fnames, oi)\n                let mut ri = 0\n                let mut found_rfv = EUnit\n                while ri < Array::length(rec_fields) {\n                  let (rfn, rfv) = Array::get(rec_fields, ri)\n                  if String::equals(rfn, target_name) {\n                    found_rfv = rfv\n                    ri = Array::length(rec_fields)\n                  } else {\n                    ri = ri + 1\n                  }\n                }\n                Array::push(ordered, found_rfv)\n                oi = oi + 1\n              }\n              ordered\n            } else {\n              args\n            }\n          },\n          _ => args\n        }\n      } else {\n        args\n      }\n      let mut nl_c = next_local + 1\n      let mut fi_c = 0\n      while fi_c < Array::length(actual_args) {\n        nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)\n        let val_local = nl_c\n        Array::push(local_names, \"__ctor_val\")\n        emit_local_set(buf, val_local)\n        nl_c = nl_c + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + fi_c * 8)\n        fi_c = fi_c + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_c\n    }\n    else if String::equals(fname, \"Bytes::from_array\") {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if String::equals(fname, \"Bytes::length\") {\n      let (al_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_call(buf, al_idx)\n      nl\n    }\n    else if String::equals(fname, \"Bytes::get\") {\n      let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_call(buf, ag_idx)\n      nl\n    }\n    else if String::equals(fname, \"eq\") {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_eq(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if String::equals(fname, \"not\") {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if String::equals(fname, \"Double::to_i64_bits\") {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if String::equals(fname, \"String::ends_with\") {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_call(buf, 29)\n      nl\n    }\n    else if String::equals(fname, \"String::last_index_of\") {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_call(buf, 30)\n      nl\n    }\n    else {\n      let fn_len2 = Array::length(ctx.func_table.names)\n      let mut __tr_j = 0\n      let mut __tr_result = -1\n      while __tr_j < fn_len2 {\n        if String::equals(Array::get(ctx.func_table.names, __tr_j), fname) {\n          __tr_result = __tr_j\n          __tr_j = fn_len2\n        } else {\n          __tr_j = __tr_j + 1\n        }\n      }\n      let fn_idx_in_list = __tr_result\n      if fn_idx_in_list >= 0 {\n        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\n        let mut nl = next_local\n        let mut ci = 0\n        while ci < Array::length(args) {\n          nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)\n          ci = ci + 1\n        }\n        if ctx.func_offset > 0 {\n          if fidx >= ctx.func_offset {\n            emit_i64_const(buf, 0)\n          }\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        let local_idx2 = resolve_local(local_names, fname, \"call\")\n        let num_args = Array::length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        Array::push(local_names, \"__fn_val\")\n        Array::push(local_names, \"__slot\")\n        Array::push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n        nl\n      }\n    }\n    // close ctor_lookup else\n  } else {\n    let num_args = Array::length(args)\n    let fn_val_local = next_local\n    let slot_local = next_local + 1\n    let env_local = next_local + 2\n    let mut nl = next_local + 3\n    Array::push(local_names, \"__fn_val\")\n    Array::push(local_names, \"__slot\")\n    Array::push(local_names, \"__env\")\n    nl = ce(buf, callee, local_names, nl, ctx, ld)\n    emit_local_set(buf, fn_val_local)\n    emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n    let mut ci = 0\n    while ci < num_args {\n      nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)\n      ci = ci + 1\n    }\n    emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n    nl\n  }\n}\n\nlet compile_match = (buf: Array[Int], expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    let __cond_p = get_arm_pat(Array::get(__match_arms, ai))\n    let __cond_done = if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else {\n      if is_pbool(__cond_p) {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\n          1\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      } else {\n        if is_pctor(__cond_p) {\n          let cname_cond = get_pctor_name(__cond_p)\n          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n          let expected_tag = if ctor_ci >= 0 {\n            Array::get(ctx.ctor_table.tags, ctor_ci)\n          } else {\n            -1\n          }\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, expected_tag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          0\n        } else {\n          if is_pstring(__cond_p) {\n            let sval = get_pstring_value(__cond_p)\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n            if str_idx >= 0 {\n              emit_local_get(buf, scrut_local)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n              emit_call(buf, 8)\n              emit_i64_const(buf, 1)\n              emit_i64_eq(buf)\n              emit_if_i64(buf)\n            }\n            0\n          } else {\n            0\n          }\n        }\n      }\n    }\n    let __arm_body = get_arm_body(Array::get(__match_arms, ai))\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    let arm_nl = if is_pctor(__cond_p) {\n      let cargs_bind = get_pctor_args(__cond_p)\n      let mut cbi = 0\n      while cbi < Array::length(cargs_bind) {\n        let __sub_p = Array::get(cargs_bind, cbi)\n        if is_pbind(__sub_p) {\n          let pname = get_pbind_name(__sub_p)\n          let fl = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, fl)\n          Array::push(local_names, pname)\n        }\n        cbi = cbi + 1\n      }\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  Array::truncate(local_names, names_len_at_match)\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\n    let __catch_p = get_arm_pat(__catch_arm)\n    let __catch_body = get_arm_body(__catch_arm)\n    0\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      Array::push(local_names, bname)\n      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n    } else {\n      if is_pctor(__catch_p) {\n        let cargs = get_pctor_args(__catch_p)\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          let __sub_p2 = Array::get(cargs, cbi2)\n          if is_pbind(__sub_p2) {\n            let pname = get_pbind_name(__sub_p2)\n            let fl2 = Array::length(local_names)\n            emit_local_get(buf, scrut_local)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, 8 + cbi2 * 8)\n            emit_local_set(buf, fl2)\n            Array::push(local_names, pname)\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n      } else {\n        if is_ptuple(__catch_p) {\n          let pats = get_ptuple_pats(__catch_p)\n          let ptr_local2 = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_local_set(buf, ptr_local2)\n          Array::push(local_names, \"__tup_ptr2\")\n          let mut pi2 = 0\n          while pi2 < Array::length(pats) {\n            let __tp = Array::get(pats, pi2)\n            if is_pbind(__tp) {\n              let pname = get_pbind_name(__tp)\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            } else {\n              if is_pwild(__tp) {\n                0\n              } else {\n                throw(\"unsupported pattern in tuple destructure\")\n              }\n            }\n            pi2 = pi2 + 1\n          }\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        } else {\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        }\n      }\n    }\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  if catch_nl > max_nl {\n    max_nl = catch_nl\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n\nlet compile_lambda = (buf: Array[Int], params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let param_names_arr = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    thunk_names: ctx.thunk_names\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let extra_lam = if final_lam_nl > (user_params + 1) {\n    final_lam_nl - (user_params + 1)\n  } else {\n    0\n  }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let mut __cap_resolve = -1\n      let mut __cri = Array::length(local_names) - 1\n      while __cri >= 0 {\n        if String::equals(Array::get(local_names, __cri), cap_name) {\n          __cap_resolve = __cri\n          __cri = -1\n        } else {\n          __cri = __cri - 1\n        }\n      }\n      if __cap_resolve >= 0 {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __cap_resolve)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      } else {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      }\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\nexport let rec compile_expr = (buf: Array[Int], expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n    let n = get_eint_value(expr)\n    emit_i64_const(buf, n)\n    next_local\n  } else if __tag == 1 {\n    let b_val = get_ebool_value(expr)\n    emit_i64_const(buf, if b_val {\n      1\n    } else {\n      0\n    })\n    next_local\n  } else if __tag == 2 {\n    let v = get_efloat_value(expr)\n    let bits = Double::to_i64_bits(v)\n    emit_f64_const_bits(buf, bits)\n    emit_i64_reinterpret_f64(buf)\n    next_local\n  } else if __tag == 3 {\n    let s = get_estring_value(expr)\n    let idx = str_table_lookup(ctx.str_table.strs, s)\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n    next_local\n  } else if __tag == 4 {\n    let name = get_eident_name(expr)\n    let len = Array::length(local_names)\n    let mut __tl_i = len - 1\n    let mut __tl_result = -1\n    while __tl_i >= 0 {\n      if String::equals(Array::get(local_names, __tl_i), name) {\n        __tl_result = __tl_i\n        __tl_i = -1\n        // break\n      } else {\n        __tl_i = __tl_i - 1\n      }\n    }\n    let local_idx = __tl_result\n    if local_idx >= 0 {\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n      } else {\n        emit_local_get(buf, local_idx)\n      }\n      next_local\n    } else {\n      let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n      if ctor_idx >= 0 {\n        let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n        let ptr_l = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_l)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, 8)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_l)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag_c)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_l)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 0)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, ptr_l)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        next_local + 1\n      } else {\n        let fn_len = Array::length(ctx.func_table.names)\n        let mut __tf_j = 0\n        let mut __tf_result = -1\n        while __tf_j < fn_len {\n          if String::equals(Array::get(ctx.func_table.names, __tf_j), name) {\n            __tf_result = __tf_j\n            __tf_j = fn_len\n            // break\n          } else {\n            __tf_j = __tf_j + 1\n          }\n        }\n        if __tf_result < 0 {\n          let mut diag = String::concat(\"undefined variable (ident): \", name)\n          diag = String::concat(diag, \" | locals=[\")\n          let mut di = 0\n          while di < len {\n            if di > 0 {\n              diag = String::concat(diag, \",\")\n            }\n            diag = String::concat(diag, Array::get(local_names, di))\n            di = di + 1\n          }\n          diag = String::concat(diag, \"]\")\n          throw(diag)\n        }\n        let fni = __tf_result\n        let fidx = Array::get(ctx.func_table.indices, fni)\n        if array_contains_str(ctx.thunk_names, name) {\n          emit_i64_const(buf, 0)\n          // env=0\n          emit_call(buf, fidx)\n          next_local\n        } else {\n          let table_slot = fidx - ctx.func_offset\n          emit_i64_const(buf, (table_slot<<2)|2)\n          next_local\n        }\n      }\n    }\n  } else if __tag == 5 {\n    let op = get_ebinop_op(expr)\n    let lhs = get_ebinop_lhs(expr)\n    let rhs = get_ebinop_rhs(expr)\n    let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n    emit_binop_op(buf, op)\n    nl2\n  } else if __tag == 6 {\n    let op = get_eunaryop_op(expr)\n    let operand = get_eunaryop_expr(expr)\n    if String::equals(op, \"-\") {\n      emit_i64_const(buf, 0)\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_sub(buf)\n      nl\n    } else if String::equals(op, \"!\") {\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n  } else if __tag == 7 {\n    let cond = get_eif_cond(expr)\n    let then_e = get_eif_then(expr)\n    let else_e = get_eif_else(expr)\n    // S1b: skip extend+wrap roundtrip for comparison conditions\n    let cond_tag = expr_tag(cond)\n    let nl1 = if cond_tag == 5 {\n      // EBinOp: check if comparison op\n      let cop = get_ebinop_op(cond)\n      if String::equals(cop, \"==\") || String::equals(cop, \"!=\") || String::equals(cop, \"<\") || String::equals(cop, \">\") || String::equals(cop, \"<=\") || String::equals(cop, \">=\") {\n        let clhs = get_ebinop_lhs(cond)\n        let crhs = get_ebinop_rhs(cond)\n        let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n        let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n        // Emit comparison (leaves i32 on stack, no extend needed)\n        if String::equals(cop, \"==\") { emit_i64_eq(buf) }\n        else if String::equals(cop, \"!=\") { emit_i64_ne(buf) }\n        else if String::equals(cop, \"<\") { emit_i64_lt_s(buf) }\n        else if String::equals(cop, \">\") { emit_i64_gt_s(buf) }\n        else if String::equals(cop, \"<=\") { emit_i64_le_s(buf) }\n        else { emit_i64_ge_s(buf) }\n        cnl2\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else if cond_tag == 1 {\n      // EBool literal: emit i32 directly\n      let b_val = get_ebool_value(cond)\n      emit_i32_const(buf, if b_val { 1 } else { 0 })\n      next_local\n    } else if cond_tag == 6 {\n      // EUnaryOp \"!\": check if operand is comparison\n      let uop = get_eunaryop_op(cond)\n      let uoperand = get_eunaryop_expr(cond)\n      if String::equals(uop, \"!\") {\n        let inner_tag = expr_tag(uoperand)\n        if inner_tag == 5 {\n          let iop = get_ebinop_op(uoperand)\n          if String::equals(iop, \"==\") || String::equals(iop, \"!=\") || String::equals(iop, \"<\") || String::equals(iop, \">\") || String::equals(iop, \"<=\") || String::equals(iop, \">=\") {\n            let ilhs = get_ebinop_lhs(uoperand)\n            let irhs = get_ebinop_rhs(uoperand)\n            let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n            let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n            if String::equals(iop, \"==\") { emit_i64_eq(buf) }\n            else if String::equals(iop, \"!=\") { emit_i64_ne(buf) }\n            else if String::equals(iop, \"<\") { emit_i64_lt_s(buf) }\n            else if String::equals(iop, \">\") { emit_i64_gt_s(buf) }\n            else if String::equals(iop, \"<=\") { emit_i64_le_s(buf) }\n            else { emit_i64_ge_s(buf) }\n            emit_i32_eqz(buf)\n            inl2\n          } else {\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        } else {\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else {\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld