catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let _names_len_at_catch = Array::length(local_names)\n  if catchall_idx < num_arms {\n    let (cp, cbody) = Array::get(arms, catchall_idx)\n    let catch_nl = match cp {\n      PBind(bname) => {\n        let bind_local = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, bind_local)\n        Array::push(local_names, bname)\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PCtor(_cname, cargs) => {\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          match Array::get(cargs, cbi2) {\n            PBind(pname) => {\n              let fl2 = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi2 * 8)\n              emit_local_set(buf, fl2)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PTuple(pats) => {\n        let ptr_local2 = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, ptr_local2)\n        Array::push(local_names, \"__tup_ptr2\")\n        let mut pi2 = 0\n        while pi2 < Array::length(pats) {\n          let tp = Array::get(pats, pi2)\n          match tp {\n            PBind(pname) => {\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => throw(\"unsupported pattern in tuple destructure\")\n          }\n          pi2 = pi2 + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PStruct(__sname, sfields) => {\n        let sp_ptr = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, sp_ptr)\n        Array::push(local_names, \"__struct_ptr\")\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, subpat) = Array::get(sfields, sfi)\n          match subpat {\n            PBind(pname) => {\n              let off = 8 + struct_field_index_gc(ctx, __sname, fname) * 8\n              let fl = Array::length(local_names)\n              emit_local_get(buf, sp_ptr)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, off)\n              emit_local_set(buf, fl)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          sfi = sfi + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      _ => ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n    }\n    if catch_nl > max_nl {\n      max_nl = catch_nl\n    }\n    0\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n\n\nexport {\n  compile_match_gc\n}\n")
