out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 1)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  bytebuf_push_section(out, 1, tc)\n  emit_function_section(out, [\n    0\n  ])\n  emit_export_section(out, \"fd_write\", 0)\n  let body = bytebuf_new()\n  emit_i32_const(body, 0)\n  emit_code_section(out, [\n    body\n  ])\n  bytebuf_to_bytes(out)\n}\n\nexport let comp_emit_component_wasm_async_trampolined_p1: (Bytes, String, Int) -> Bytes = (main_core_wasm, export_name, comp_result_valtype) -> {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, main_core_wasm)\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\n  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())\n  emit_core_instance_instantiate_section(buf, 2, Array::slice([\n    \"\"\n  ], 0, 0))\n  emit_core_instance_instantiate_args(buf, 0, [\n    \"wasi_snapshot_preview1\"\n  ], [\n    0\n  ])\n  emit_canon_task_return(buf, comp_result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_alias_section(buf, 1, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"run\"\n  ], [\n    1\n  ])\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"main\",\n    \"cm\"\n  ], [\n    3,\n    2\n  ])\n  emit_comp_async_functype_section(buf, comp_result_valtype)\n  emit_alias_section(buf, 4, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 2, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n")
