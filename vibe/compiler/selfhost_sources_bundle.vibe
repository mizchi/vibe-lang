ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      if op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\" {\\n        if op == \\\"+\\\" {\\n          emit_f64_add(buf)\\n        } else if op == \\\"-\\\" {\\n          emit_f64_sub(buf)\\n        } else if op == \\\"*\\\" {\\n          emit_f64_mul(buf)\\n        } else {\\n          emit_f64_div(buf)\\n        }\\n        emit_i64_reinterpret_f64(buf)\\n        if ctx.enable_rc {\\n          Array::push(local_names, \\\"__fbits\\\")\\n          Array::push(local_names, \\\"__fbox\\\")\\n          emit_box_float(buf, ctx, nl2, nl2 + 1)\\n          nl2 + 2\\n        } else {\\n          nl2\\n        }\\n      } else {\\n        if op == \\\"==\\\" {\\n          emit_f64_eq(buf)\\n        } else if op == \\\"!=\\\" {\\n          emit_f64_ne(buf)\\n        } else if op == \\\"<\\\" {\\n          emit_f64_lt(buf)\\n        } else if op == \\\">\\\" {\\n          emit_f64_gt(buf)\\n        } else if op == \\\"<=\\\" {\\n          emit_f64_le(buf)\\n        } else if op == \\\">=\\\" {\\n          emit_f64_ge(buf)\\n        } else {\\n          throw(String::concat(\\\"unsupported float binop: \\\", op))\\n        }\\n        emit_i64_extend_i32_s(buf)\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        }\\n        nl2\\n      }\\n    } else if ctx.enable_rc {\\n      if op == \\\"<<\\\" {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        emit_i64_shl(buf)\\n        nl2\\n      } else if op == \\\">>\\\" {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        emit_i64_shr_s(buf)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n        nl2\\n      } else {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_binop_op(buf, op)\\n        if op == \\\"*\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shr_s(buf)\\n        } else if op == \\\"/\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        } else if op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        } else {\\n          ()\\n        }\\n        nl2\\n      }\\n    } else {\\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n      emit_binop_op(buf, op)\\n      nl2\\n    }\\n  } else if __tag == 6 {\\n    let op = get_eunaryop_op(expr)\\n    let operand = get_eunaryop_expr(expr)\\n    if op == \\\"-\\\" {\\n      if expr_is_floatish(operand, local_names, ctx) {\\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n        emit_f64_reinterpret_i64(buf)\\n        emit_f64_neg(buf)\\n        emit_i64_reinterpret_f64(buf)\\n        nl\\n      } else {\\n        emit_i64_const(buf, 0)\\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n        emit_i64_sub(buf)\\n        nl\\n      }\\n    } else if op == \\\"!\\\" {\\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n      emit_i64_eqz(buf)\\n      emit_i64_extend_i32_s(buf)\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      nl\\n    } else {\\n      throw(String::concat(\\\"unsupported unary op: \\\", op))\\n    }\\n  } else if __tag == 7 {\\n    let cond = get_eif