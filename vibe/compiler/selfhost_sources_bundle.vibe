    let mut ppi = 0\n          while ppi < Array::length(params) {\n            let (pname, _) = Array::get(params, ppi)\n            Array::push(local_names, pname)\n            ppi = ppi + 1\n          }\n          Array::push(local_names, \"__env\")\n          let param_count = Array::length(params) + 1\n          let ref_cell_names_f = Array::slice([\n            \"\"\n          ], 0, 0)\n          let ref_local_indices_f = Array::slice([\n            0\n          ], 0, 0)\n          let ft = FuncTable::{\n            names: ft_names,\n            indices: ft_indices,\n            params: ft_params,\n            returns: ft_returns,\n            needs_env: ft_needs_env\n          }\n          let st = StrTable::{\n            strs: str_strs, offsets: str_offsets, lengths: str_lengths\n          }\n          let ct = CtorTable::{\n            names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names\n          }\n          let func_ctx = CompileCtxGc::{\n            func_table: ft, str_table: st, lambda_table: lt_w,\n            num_user_funcs: num_user_funcs, func_offset: func_offset,\n            ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,\n            refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\n            ctor_table: ct\n          }\n          let final_nl = compile_expr_gc(body_buf, body, local_names, param_count, func_ctx, -1)\n          Array::push(bodies, body_buf)\n          let extra = if final_nl > param_count {\n            final_nl - param_count\n          } else {\n            0\n          }\n          Array::push(meta_i32, 0)\n          Array::push(meta_i64, extra)\n          Array::push(user_ref_local_indices_all, ref_local_indices_f)\n        },\n        _ => throw(\"expected function\")\n      }\n      ,\n      _ => throw(\"expected let statement\")\n    }\n   