let push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {
  let (path, source) = pair
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if String::equals(name, group_name) {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = Array::slice([("", "")], 0, 0)
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

  let source_0 = ("vibe/compiler/core/polyfill.vibe",
"\nexport let __to_string = (n: Int) -> String {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n")

  let source_1 = ("vibe/compiler/core/bytebuf.vibe",
"\nexport let bytebuf_new = () -> Bytes {\n  Bytes::new()\n}\n\nexport let bytebuf_push = (buf: Bytes, byte: Int) -> Unit {\n  Bytes::push(buf, byte)\n}\n\nexport let bytebuf_push2 = (buf: Bytes, b1: Int, b2: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n}\n\nexport let bytebuf_push3 = (buf: Bytes, b1: Int, b2: Int, b3: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n}\n\nexport let bytebuf_push9 = (buf: Bytes, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int, b8: Int, b9: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n  bytebuf_push(buf, b4)\n  bytebuf_push(buf, b5)\n  bytebuf_push(buf, b6)\n  bytebuf_push(buf, b7)\n  bytebuf_push(buf, b8)\n  bytebuf_push(buf, b9)\n}\n\nexport let bytebuf_length = (buf: Bytes) -> Int {\n  Bytes::length(buf)\n}\n\nexport let bytebuf_push_buf = (dst: Bytes, src: Bytes) -> Unit {\n  Bytes::append(dst, src)\n}\n\nexport let bytebuf_to_bytes = (buf: Bytes) -> Bytes {\n  buf\n}\n\nexport let leb128_encode_s32 = (buf: Bytes, value: Int) -> Unit {\n  if value >= (0 - 64) && value < 64 {\n    Bytes::push(buf, value&127)\n  } else {\n    if value >= (0 - 8192) && value < 8192 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = v>>7\n        if (v == 0) && (byte&64) == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          if (v == 0 - 1) && (byte&64) != 0 {\n            Bytes::push(buf, byte)\n            more = false\n          } else {\n            Bytes::push(buf, byte|128)\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let leb128_encode_s64 = (buf: Bytes, value: Int) -> Unit {\n  leb128_encode_s32(buf, value)\n}\n\nexport let leb128_encode_u32 = (buf: Bytes, value: Int) -> Unit {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = (v>>7)&((1<<25) - 1)\n        if v == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          Bytes::push(buf, byte|128)\n        }\n      }\n    }\n  }\n}\n\nexport let bytebuf_push_string = (buf: Bytes, s: String) -> Unit {\n  let slen = String::length(s)\n  leb128_encode_u32(buf, slen)\n  let mut i = 0\n  while i < slen {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push_section = (out: Bytes, section_id: Int, content: Bytes) -> Unit {\n  bytebuf_push(out, section_id)\n  leb128_encode_u32(out, bytebuf_length(content))\n  bytebuf_push_buf(out, content)\n}\n\nexport let bytebuf_push_opcode_s64 = (buf: Bytes, opcode: Int, value: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_s32(buf, value)\n}\n\nexport let bytebuf_push_opcode_u32 = (buf: Bytes, opcode: Int, value: Int) -> Unit {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, opcode)\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, opcode)\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      Bytes::push(buf, opcode)\n      leb128_encode_u32(buf, value)\n    }\n  }\n}\n\nexport let bytebuf_push_vec_header = (buf: Bytes, count: Int) -> Unit {\n  leb128_encode_u32(buf, count)\n}\n\nexport let bytebuf_push_opcode_u32_u32 = (buf: Bytes, opcode: Int, a: Int, b: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_u32(buf, a)\n  leb128_encode_u32(buf, b)\n}\n")

  let source_2 = ("vibe/compiler/core/ast.vibe",
"\nexport enum Pat {\n  PWild;\n  PBind(String);\n  PInt(Int);\n  PString(String);\n  PBool(Bool);\n  PCtor(String, Array[Pat]);\n  PTuple(Array[Pat]);\n  POr(Pat, Pat)\n}\n\nexport enum TypeExpr {\n  TyName(String);\n  TyApp(String, Array[TypeExpr]);\n  TyFn(Array[TypeExpr], TypeExpr, Option[String]);\n  TyTuple(Array[TypeExpr]);\n  TyUnit\n}\n\nexport enum Expr {\n  EInt(Int);\n  EFloat(Double);\n  EString(String);\n  EBool(Bool);\n  EIdent(String);\n  ETuple(Array[Expr]);\n  EArray(Array[Expr]);\n  ERecord(Array[(String, Expr)]);\n  EIf(Expr, Expr, Expr);\n  ELet(String, Expr, Expr);\n  ELetRec(String, Expr, Expr);\n  ELetMut(String, Expr, Expr);\n  EAssign(String, Expr, Expr);\n  EAssignOp(String, String, Expr, Expr);\n  ESeq(Expr, Expr);\n  EMatch(Expr, Array[(Pat, Expr)]);\n  EHandle(Expr, Array[(Pat, Expr)]);\n  EWhile(Expr, Expr);\n  ELoop(Array[(String, Expr)], Expr);\n  EForIn(String, Option[String], Expr, Expr);\n  ECall(Expr, Array[Expr]);\n  EBinOp(String, Expr, Expr);\n  EUnaryOp(String, Expr);\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\n  EDot(Expr, String);\n  ELabeledArg(String, String, Expr);\n  EThrow(Expr);\n  EBreak(Option[Expr]);\n  EContinue(Array[Expr]);\n  EMap(Array[(String, Expr)]);\n  ESpread(Expr);\n  EStringInterp(Array[String]);\n  EUnit\n}\n\nexport enum Stmt {\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\n  SLetMut(String, Option[TypeExpr], Expr);\n  SEnum(Bool, String, Array[(String, Array[TypeExpr])]);\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\n  SStruct(Bool, String, Array[(String, TypeExpr)]);\n  STypeAlias(Bool, String, TypeExpr);\n  STrait(Bool, String, Array[String]);\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\n  SExternLet(String, TypeExpr);\n  SImport(String, Array[(String, Option[String])]);\n  STest(String, Expr);\n  SBench(String, Expr);\n  SExpr(Expr);\n  SExport(Array[String]);\n  SReExport(String, Array[(String, Option[String])]);\n  SAliasDecl(String, String);\n  SLetPat(Pat, Expr);\n  SModule(Bool, String, Array[Stmt]);\n  SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)])\n}\n")

  let source_3 = ("vibe/compiler/core/types.vibe",
"\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Option[String]);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)]);\n  TDAlias(String, Type)\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);\n  EnvCached(Map[String, Type], TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst);\n  SubstCached(Map[String, Type], Map[String, Array[String]], Subst)\n}\n\n\nexport let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {\n  EnvBind(name, ty, env)\n}\n\nexport let env_cache = (env: TypeEnv) -> TypeEnv {\n  let is_empty = match env {\n    EnvEmpty => true,\n    _ => false\n  }\n  if is_empty {\n    EnvEmpty\n  } else {\n    let names = ArrayBuilder::new()\n    let types = ArrayBuilder::new()\n    let rec collect = (cur: TypeEnv) -> Unit {\n      match cur {\n        EnvEmpty => (),\n        EnvBind(n, ty, rest) => {\n          ArrayBuilder::push(names, n)\n          ArrayBuilder::push(types, ty)\n          collect(rest)\n        },\n        EnvTraitDef(_, _, _, rest) => collect(rest),\n        EnvTraitImpl(_, _, rest) => collect(rest),\n        EnvTraitImplGen(_, _, _, _, rest) => collect(rest),\n        EnvCached(_, rest) => collect(rest)\n      }\n    }\n    collect(env)\n    let na = ArrayBuilder::freeze(names)\n    let ta = ArrayBuilder::freeze(types)\n    let cache = MapBuilder::new()\n    let len = Array::length(na)\n    let mut i = 0\n    while i < len {\n      let idx = len - i - 1\n      MapBuilder::set(cache, Array::get(na, idx), Array::get(ta, idx))\n      i = i + 1\n    }\n    EnvCached(MapBuilder::freeze(cache), env)\n  }\n}\n\nexport let fresh_var = (c: Int) -> (Type, Int) {\n  (CtVar(c), c + 1)\n}\n\nexport let rec occurs_in = (id: Int, ty: Type) -> Bool {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        if occurs_in(id, Array::get(params, i)) {\n          found = true\n          i = Array::length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if occurs_in(id, Array::get(elems, i)) {\n          found = true\n          i = Array::length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport let rec env_lookup = (env: TypeEnv, name: String) -> Option[Type] {\n  match env {\n    EnvEmpty => None,\n    EnvBind(n, ty, rest) => if n == name {\n      Some(ty)\n    } else {\n      env_lookup(rest, name)\n    },\n    EnvTraitDef(_, _, _, rest) => env_lookup(rest, name),\n    EnvTraitImpl(_, _, rest) => env_lookup(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => env_lookup(rest, name),\n    EnvCached(cache, rest) => if Map::has_key(cache, name) {\n      Some(Map::get(cache, name))\n    } else {\n      env_lookup(rest, name)\n    }\n  }\n}\n\nexport let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while i < len {\n    let (name, ty) = Array::get(bindings, i)\n    acc = EnvBind(name, ty, acc)\n    i = i + 1\n  }\n  acc\n}\n\nexport let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {\n  let len = Array::length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let d = Array::get(defs, i)\n      let dname = match d {\n        TDEnum(n, _) => n,\n        TDStruct(n, _) => n,\n        TDAlias(n, _) => n\n      }\n      if dname == name {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport let subst_lookup = (s: Subst, id: Int) -> Option[Type] {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  let key = __to_string(id)\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => if i == id {\n        out = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      }\n      ,\n      SubstBound(_, _, rest) => {\n        cur = rest\n      },\n      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {\n        out = Some(Map::get(cache, key))\n        done = true\n      } else {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let rec trait_supers = (env: TypeEnv, name: String) -> Array[String] {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, rest) => if tname == name {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),\n    EnvCached(_, rest) => trait_supers(rest, name)\n  }\n}\n\nlet rec array_has_int = (arr: Array[Int], val: Int, i: Int) -> Bool {\n  if i >= Array::length(arr) {\n    false\n  }\n  else if Array::get(arr, i) == val {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nlet int_array_has = (arr: Array[Int], v: Int) -> Bool {\n  let slen = Array::length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while !sdone {\n    if si >= slen {\n      sdone = true\n    } else if Array::get(arr, si) == v {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nexport let rec subst_apply = (s: Subst, ty: Type) -> Type {\n  match ty {\n    CtInt => ty,\n    CtBool => ty,\n    CtString => ty,\n    CtUnit => ty,\n    CtDouble => ty,\n    CtChar => ty,\n    CtBytes => ty,\n    CtUnknown => ty,\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = Array::slice([\n        0\n      ], 0, 0)\n      while !done {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            Array::push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          },\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, effect_name) => {\n      let rp = for p in params {\n        subst_apply(s, p)\n      }\n      CtFn(rp, subst_apply(s, ret), effect_name)\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport let rec trait_defined = (env: TypeEnv, name: String) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, rest) => if tname == name {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),\n    EnvCached(_, rest) => trait_defined(rest, name)\n  }\n}\n\nexport let rec type_to_string = (ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => \"?t\\{id}\",\n    CtForAll(vars, _, body) => {\n      let vlen = Array::length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while vi < vlen {\n        let v = \"?t\\{Array::get(vars, vi)}\"\n        let next = if vi > 0 {\n          \"\\{vacc} \\{v}\"\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      \"forall \\{vacc}. \\{type_to_string(body)}\"\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => \"Array[\\{type_to_string(elem)}]\",\n    CtOption(elem) => \"Option[\\{type_to_string(elem)}]\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          \"\\{joined}, \\{Array::get(parts, i)}\"\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      \"\\{name}[\\{joined}]\"\n    },\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          \"\\{joined}, \\{Array::get(parts, i)}\"\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      \"(\\{joined})\"\n    },\n    CtFn(params, ret, effect_name) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          \"\\{joined}, \\{Array::get(parts, i)}\"\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      let base = \"(\\{joined}) -> \\{type_to_string(ret)}\"\n      match effect_name {\n        Some(name) => \"\\{base} with {\\{name}}\",\n        None => base\n      }\n    }\n  }\n}\n\nlet empty_type_args = () -> Array[Type] {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nexport let env_lookup_flat = (bindings: Array[(String, Type)], name: String) -> Option[Type] {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = Array::get(bindings, i)\n      if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport let resolve_builtin = (name: String) -> Option[Type] {\n  if name == \"Int\" || name == \"i32\" {\n    Some(CtInt)\n  }\n  else if name == \"Double\" || name == \"f64\" {\n    Some(CtDouble)\n  }\n  else if name == \"Bool\" {\n    Some(CtBool)\n  }\n  else if name == \"String\" {\n    Some(CtString)\n  }\n  else if name == \"Char\" {\n    Some(CtChar)\n  }\n  else if name == \"Unit\" {\n    Some(CtUnit)\n  }\n  else if name == \"Bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"i64\"\n  || name == \"u8\"\n  || name == \"u16\"\n  || name == \"u32\"\n  || name == \"u64\"\n  || name == \"i16\"\n  || name == \"v128\" {\n    Some(CtNamed(name, empty_type_args()))\n  }\n  else None\n}\n\nexport let subst_add_bound = (s: Subst, id: Int, bounds: Array[String]) -> Subst {\n  SubstBound(id, bounds, s)\n}\n\nlet empty_var_bounds = () -> Array[(Int, Array[String])] {\n  Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet rec int_bounds_has_id = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {\n  if i >= Array::length(pairs) {\n    false\n  } else {\n    let (pid, _) = Array::get(pairs, i)\n    if pid == id {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_bounds_lookup = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {\n  if i >= Array::length(pairs) {\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    let (pid, bounds) = Array::get(pairs, i)\n    if pid == id {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_int_lookup_or = (pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {\n  if i >= Array::length(pairs) {\n    fallback\n  } else {\n    let (k, v) = Array::get(pairs, i)\n    if k == key {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\nexport let instantiate = (ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = Array::length(bound_vars)\n      let id_map = Array::slice([\n        (0, 0)\n      ], 0, 0)\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      let mut bnc = c\n      while bi < blen {\n        let old_id = Array::get(bound_vars, bi)\n        Array::push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      let new_bounds = Array::slice([\n        (0, Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        Array::push(new_bounds, (new_id, bounds))\n      };\n      (subst_apply(inst_s, body), c1, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport let rec trait_is_subtrait = (env: TypeEnv, sub: String, super_name: String) -> Bool {\n  if sub == super_name {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = Array::length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while !sdone {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = Array::get(supers, si)\n        if s == super_name {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nlet rec collect_tvars_walk = (t: Type, out: Array[Int]) -> Int {\n  match t {\n    CtVar(id) => {\n      if !array_has_int(out, id, 0) {\n        Array::push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport let collect_tvars = (ty: Type) -> Array[Int] {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nlet empty_env_bindings = () -> Array[(String, Type)] {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let env_flat_bindings = (env: TypeEnv) -> Array[(String, Type)] {\n  let out = empty_env_bindings()\n  let rec collect = (cur: TypeEnv) -> Unit {\n    match cur {\n      EnvEmpty => (),\n      EnvBind(name, ty, rest) => {\n        Array::push(out, (name, ty))\n        collect(rest)\n      },\n      EnvTraitDef(_, _, _, rest) => collect(rest),\n      EnvTraitImpl(_, _, rest) => collect(rest),\n      EnvTraitImplGen(_, _, _, _, rest) => collect(rest),\n      EnvCached(_, rest) => collect(rest)\n    }\n  }\n  collect(env)\n  out\n}\n\nlet string_array_equal = (left: Array[String], right: Array[String]) -> Bool {\n  let len = Array::length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else if Array::get(left, i) != Array::get(right, i) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet option_string_equal = (left: Option[String], right: Option[String]) -> Bool {\n  match left {\n    Some(left_name) => match right {\n      Some(right_name) => left_name == right_name,\n      None => false\n    },\n    None => match right {\n      Some(_) => false,\n      None => true\n    }\n  }\n}\n\nexport let rec types_equal = (a: Type, b: Type) -> Bool {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => aname == bname,\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => aname == bname,\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtNamed(bname, bargs) =>\n      if aname != bname {\n        false\n      } else if Array::length(aargs) != Array::length(bargs) {\n        false\n      } else {\n        let tae_len = Array::length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while !tae_done {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else {\n            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {\n              tae_i = tae_i + 1\n            } else {\n              tae_result = false\n              tae_done = true\n            }\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if Array::length(aelems) != Array::length(belems) {\n        false\n      } else {\n        let tae_len2 = Array::length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while !tae_done2 {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else {\n            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {\n              tae_i2 = tae_i2 + 1\n            } else {\n              tae_result2 = false\n              tae_done2 = true\n            }\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, aeffect) => match b {\n      CtFn(bparams, bret, beffect) =>\n      if Array::length(aparams) != Array::length(bparams) {\n        false\n      } else if option_string_equal(aeffect, beffect) {\n        let tae_len3 = Array::length(aparams)\n        let mut tae_i3 = 0\n        let mut tae_result3 = true\n        let mut tae_done3 = false\n        while !tae_done3 {\n          if tae_i3 >= tae_len3 {\n            tae_done3 = true\n          } else {\n            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {\n              tae_i3 = tae_i3 + 1\n            } else {\n              tae_result3 = false\n              tae_done3 = true\n            }\n          }\n        }\n        if tae_result3 {\n          types_equal(aret, bret)\n        } else {\n          false\n        }\n      } else {\n        false\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {\n        false\n      } else if Array::length(abounds) != Array::length(bbounds) {\n        false\n      } else {\n        let vlen = Array::length(avars)\n        let mut vi = 0\n        let mut vresult = true\n        let mut vdone = false\n        while !vdone {\n          if vi >= vlen {\n            vdone = true\n          } else if Array::get(avars, vi) != Array::get(bvars, vi) {\n            vresult = false\n            vdone = true\n          } else {\n            vi = vi + 1\n          }\n        }\n        if vresult {\n          let fbe_len = Array::length(abounds)\n          let mut fbe_i = 0\n          let mut fbe_result = true\n          let mut fbe_done = false\n          while !fbe_done {\n            if fbe_i >= fbe_len {\n              fbe_done = true\n            } else {\n              let (lvar, lbounds) = Array::get(abounds, fbe_i)\n              let (rvar, rbounds) = Array::get(bbounds, fbe_i)\n              if lvar != rvar {\n                fbe_result = false\n                fbe_done = true\n              } else if Array::length(lbounds) != Array::length(rbounds) {\n                fbe_result = false\n                fbe_done = true\n              } else {\n                if string_array_equal(lbounds, rbounds) {\n                  fbe_i = fbe_i + 1\n                } else {\n                  fbe_result = false\n                  fbe_done = true\n                }\n              }\n            }\n          }\n          if fbe_result {\n            types_equal(abody, bbody)\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      }\n      ,\n      _ => false\n    }\n  }\n}\n\nexport let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => match ta {\n                CtArray(ea) => match tb {\n                  CtArray(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtOption(ea) => match tb {\n                  CtOption(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtFn(pa, ra, aeffect) => match tb {\n                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {\n                    None\n                  }\n                  else if !option_string_equal(aeffect, beffect) {\n                    None\n                  }\n                  else {\n                    let ul_len = Array::length(pa)\n                    let mut ul_i = 0\n                    let mut ul_acc = s\n                    let mut ul_result = Some(s)\n                    let mut ul_done = false\n                    while !ul_done {\n                      if ul_i >= ul_len {\n                        ul_result = Some(ul_acc)\n                        ul_done = true\n                      } else {\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\n                          Some(s2) => {\n                            ul_acc = s2\n                            ul_i = ul_i + 1\n                          },\n                          None => {\n                            ul_result = None\n                            ul_done = true\n                          }\n                        }\n                      }\n                    }\n                    match ul_result {\n                      Some(s2) => unify(ra, rb, s2),\n                      None => None\n                    }\n                  },\n                  _ => None\n                },\n                CtTuple(ea) => match tb {\n                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {\n                    None\n                  }\n                  else {\n                    let ul_len2 = Array::length(ea)\n                    let mut ul_i2 = 0\n                    let mut ul_acc2 = s\n                    let mut ul_result2 = Some(s)\n                    let mut ul_done2 = false\n                    while !ul_done2 {\n                      if ul_i2 >= ul_len2 {\n                        ul_result2 = Some(ul_acc2)\n                        ul_done2 = true\n                      } else {\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\n                          Some(s2) => {\n                            ul_acc2 = s2\n                            ul_i2 = ul_i2 + 1\n                          },\n                          None => {\n                            ul_result2 = None\n                            ul_done2 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result2\n                  },\n                  _ => None\n                },\n                CtEnum(a_name) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtStruct(a_name) => match tb {\n                  CtStruct(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtNamed(a_name, a_args) => match tb {\n                  CtNamed(b_name, b_args) => if a_name != b_name {\n                    None\n                  }\n                  else if Array::length(a_args) != Array::length(b_args) {\n                    None\n                  }\n                  else {\n                    let ul_len3 = Array::length(a_args)\n                    let mut ul_i3 = 0\n                    let mut ul_acc3 = s\n                    let mut ul_result3 = Some(s)\n                    let mut ul_done3 = false\n                    while !ul_done3 {\n                      if ul_i3 >= ul_len3 {\n                        ul_result3 = Some(ul_acc3)\n                        ul_done3 = true\n                      } else {\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\n                          Some(s2) => {\n                            ul_acc3 = s2\n                            ul_i3 = ul_i3 + 1\n                          },\n                          None => {\n                            ul_result3 = None\n                            ul_done3 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result3\n                  },\n                  _ => None\n                },\n                _ => None\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let types_compatible = (expected: Type, actual: Type) -> Bool {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport let rec impls_overlap_for = (env: TypeEnv, trait_name: String, new_target: Type) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvCached(_, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nlet rec type_implements_check_env = (e: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvCached(_, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nlet collect_subst_bounds_pairs = (s: Subst) -> Array[(Int, Array[String])] {\n  let out = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut cur = s\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if !int_bounds_has_id(out, id, 0) {\n          Array::push(out, (id, bounds))\n        }\n        cur = rest\n      },\n      SubstCached(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let generalize = (s: Subst, ty: Type) -> Type {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if Array::length(tvars) == 0 {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = Array::slice([\n      (0, Array::slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0)\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if Array::length(bounds) != 0 {\n        Array::push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nlet rec type_implements_check_super = (e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvCached(_, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\nexport let rec type_implements_trait = (env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else {\n    let supers = trait_supers(env, trait_name)\n    let slen = Array::length(supers)\n    if slen == 0 {\n      false\n    }\n    else {\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n")

  let source_4 = ("vibe/compiler/core/dce.vibe",
"\n\n\nlet clone_arr = (arr: Array[String]) -> Array[String] {\n  Array::slice(arr, 0, Array::length(arr))\n}\n\nlet stmt_name = (stmt: Stmt) -> Option[String] {\n  match stmt {\n    SLet(_, _, name, _, _) => Some(name),\n    SLetMut(name, _, _) => Some(name),\n    _ => None\n  }\n}\n\nlet array_contains_str = (arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let rec search = (i: Int) -> Bool {\n    if i >= len {\n      false\n    }\n    else if Array::get(arr, i) == s {\n      true\n    }\n    else search(i + 1)\n  }\n  search(0)\n}\n\nlet add_ref = (out: Array[String], bound: Array[String], name: String) -> Int {\n  if not(array_contains_str(bound, name)) {\n    if not(array_contains_str(out, name)) {\n      Array::push(out, name)\n    }\n  }\n  0\n}\n\nlet rec collect_pat_bindings = (pat: Pat, bound: Array[String]) -> Int {\n  match pat {\n    PWild => 0,\n    PBind(name) => {\n      Array::push(bound, name)\n      0\n    },\n    PInt(_) => 0,\n    PString(_) => 0,\n    PBool(_) => 0,\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    POr(p1, p2) => {\n      collect_pat_bindings(p1, bound)\n      collect_pat_bindings(p2, bound)\n      0\n    }\n  }\n}\n\nlet rec collect_refs_into = (expr: Expr, bound: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name) => add_ref(out, bound, name),\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(e) => collect_refs_into(e, bound, out),\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    ECall(callee, args) => {\n      collect_refs_into(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_refs_into(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(then_e, bound, out)\n      collect_refs_into(else_e, bound, out)\n      0\n    },\n    ELet(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetRec(name, val, body) => {\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(val, bound2, out)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetMut(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EAssign(_, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ESeq(l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    EMatch(scr, arms) => {\n      collect_refs_into(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(body_expr, arms) => {\n      collect_refs_into(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(arm_body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ELoop(params, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        collect_refs_into(init, bound2, out)\n        Array::push(bound2, name)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EForIn(name, index_name, iter, body) => {\n      collect_refs_into(iter, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      match index_name {\n        Some(index_name) => Array::push(bound2, index_name),\n        None => ()\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(bound2, pname)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EDot(obj, _) => {\n      collect_refs_into(obj, bound, out)\n      0\n    },\n    ELabeledArg(_, _, e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EStringInterp(_) => 0\n  }\n}\n\nlet collect_refs = (expr: Expr, bound: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_refs_into(expr, bound, out)\n  out\n}\n\nlet is_type_or_structural = (stmt: Stmt) -> Bool {\n  match stmt {\n    SEnum(_, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SEffectDef(_, _, _, _) => true,\n    SStruct(_, _, _) => true,\n    STypeAlias(_, _, _) => true,\n    STrait(_, _, _) => true,\n    SImpl(_, _, _, _) => true,\n    SExternLet(_, _) => true,\n    SImport(_, _) => true,\n    SAliasDecl(_, _) => true,\n    STest(_, _) => true,\n    SBench(_, _) => true,\n    SExpr(_) => true,\n    SExport(_) => true,\n    SReExport(_, _) => true,\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport let dce_stmts = (stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    if not(array_contains_str(reachable, name)) {\n      Array::push(reachable, name)\n      Array::push(queue, name)\n    }\n    j = j + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  let result = Array::slice([\n    Array::get(stmts, 0)\n  ], 0, 0)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    let stmt = Array::get(stmts, m)\n    if is_type_or_structural(stmt) {\n      Array::push(result, stmt)\n    } else {\n      match stmt_name(stmt) {\n        Some(name) => if array_contains_str(reachable, name) {\n          Array::push(result, stmt)\n        },\n        None => Array::push(result, stmt)\n      }\n    }\n    m = m + 1\n  }\n  result\n}\n")

  let source_5 = ("vibe/compiler/core/index.vibe",
"export let version = \"0.1.0\"\n\n\n\n\n\n")

  let source_6 = ("vibe/compiler/ast.vibe",
"\n\n\nexport {\n  Pat, Expr, Stmt, TypeExpr\n}\n")

  let source_7 = ("vibe/compiler/syntax/token.vibe",
"\n\n\n\nexport enum Token {\n  TInt(Int);\n  TFloat(Double);\n  TString(String);\n  TIdent(String);\n  TLet;\n  TRec;\n  TMut;\n  TFn;\n  TIf;\n  TElse;\n  TMatch;\n  TDo;\n  TEnum;\n  TStruct;\n  TType;\n  TTrait;\n  TImpl;\n  TExport;\n  TTest;\n  TWhile;\n  TFor;\n  TIn;\n  TLoop;\n  TBreak;\n  TContinue;\n  TReturn;\n  TWith;\n  THandle;\n  TThrow;\n  TRaise;\n  TYield;\n  TBench;\n  TDeclare;\n  TAs;\n  TModule;\n  TSuberror;\n  TDerive;\n  TOpen;\n  TImport;\n  TPlus;\n  TMinus;\n  TStar;\n  TSlash;\n  TPercent;\n  TEqEq;\n  TNeq;\n  TLt;\n  TLte;\n  TGt;\n  TGte;\n  TAnd;\n  TOr;\n  TNot;\n  TBitAnd;\n  TBitOr;\n  TBitXor;\n  TLShift;\n  TRShift;\n  TPipeGt;\n  TArrow;\n  TThinArrow;\n  TEq;\n  TDot;\n  TColon;\n  TDoubleColon;\n  TComma;\n  TSemicolon;\n  THash;\n  TTilde;\n  TQuestion;\n  TPlusEq;\n  TMinusEq;\n  TStarEq;\n  TSlashEq;\n  TPercentEq;\n  TLParen;\n  TRParen;\n  TLBrace;\n  TRBrace;\n  TLBracket;\n  TRBracket;\n  TDotDot;\n  TDotDotDot;\n  TStringInterp(Array[String]);\n  TEof\n}\n\n\nexport let token_to_string = (t: Token) -> String {\n  match t {\n    TInt(n) => String::concat(\"TInt(\", String::concat(__to_string(n), \")\")),\n    TFloat(n) =>\n    String::concat(\"TFloat(\", String::concat(double_to_string_compiler(n), \")\")),\n    TString(s) => String::concat(\"TString(\\\"\", String::concat(s, \"\\\")\")),\n    TIdent(s) => String::concat(\"TIdent(\", String::concat(s, \")\")),\n    TLet => \"TLet\",\n    TRec => \"TRec\",\n    TMut => \"TMut\",\n    TFn => \"TFn\",\n    TIf => \"TIf\",\n    TElse => \"TElse\",\n    TMatch => \"TMatch\",\n    TDo => \"TDo\",\n    TEnum => \"TEnum\",\n    TStruct => \"TStruct\",\n    TType => \"TType\",\n    TTrait => \"TTrait\",\n    TImpl => \"TImpl\",\n    TExport => \"TExport\",\n    TTest => \"TTest\",\n    TWhile => \"TWhile\",\n    TFor => \"TFor\",\n    TIn => \"TIn\",\n    TLoop => \"TLoop\",\n    TBreak => \"TBreak\",\n    TContinue => \"TContinue\",\n    TReturn => \"TReturn\",\n    TWith => \"TWith\",\n    THandle => \"THandle\",\n    TThrow => \"TThrow\",\n    TRaise => \"TRaise\",\n    TYield => \"TYield\",\n    TBench => \"TBench\",\n    TDeclare => \"TDeclare\",\n    TAs => \"TAs\",\n    TModule => \"TModule\",\n    TSuberror => \"TSuberror\",\n    TDerive => \"TDerive\",\n    TOpen => \"TOpen\",\n    TImport => \"TImport\",\n    TPlus => \"TPlus\",\n    TMinus => \"TMinus\",\n    TStar => \"TStar\",\n    TSlash => \"TSlash\",\n    TPercent => \"TPercent\",\n    TEqEq => \"TEqEq\",\n    TNeq => \"TNeq\",\n    TLt => \"TLt\",\n    TLte => \"TLte\",\n    TGt => \"TGt\",\n    TGte => \"TGte\",\n    TAnd => \"TAnd\",\n    TOr => \"TOr\",\n    TNot => \"TNot\",\n    TBitAnd => \"TBitAnd\",\n    TBitOr => \"TBitOr\",\n    TBitXor => \"TBitXor\",\n    TLShift => \"TLShift\",\n    TRShift => \"TRShift\",\n    TPipeGt => \"TPipeGt\",\n    TArrow => \"TArrow\",\n    TThinArrow => \"TThinArrow\",\n    TEq => \"TEq\",\n    TDot => \"TDot\",\n    TColon => \"TColon\",\n    TDoubleColon => \"TDoubleColon\",\n    TComma => \"TComma\",\n    TSemicolon => \"TSemicolon\",\n    THash => \"THash\",\n    TTilde => \"TTilde\",\n    TQuestion => \"TQuestion\",\n    TPlusEq => \"TPlusEq\",\n    TMinusEq => \"TMinusEq\",\n    TStarEq => \"TStarEq\",\n    TSlashEq => \"TSlashEq\",\n    TPercentEq => \"TPercentEq\",\n    TLParen => \"TLParen\",\n    TRParen => \"TRParen\",\n    TLBrace => \"TLBrace\",\n    TRBrace => \"TRBrace\",\n    TLBracket => \"TLBracket\",\n    TRBracket => \"TRBracket\",\n    TDotDot => \"TDotDot\",\n    TDotDotDot => \"TDotDotDot\",\n    TStringInterp(_) => \"TStringInterp\",\n    TEof => \"TEof\"\n  }\n}\n")

  let source_8 = ("vibe/compiler/syntax/float_format.vibe",
"\n\n\nlet zero_pad_6 = (n: Int) -> String {\n  let s = __to_string(n)\n  let len = String::length(s)\n  if len >= 6 {\n    s\n  } else {\n    let mut out = \"\"\n    let mut i = len\n    while i < 6 {\n      out = String::concat(out, \"0\")\n      i = i + 1\n    }\n    String::concat(out, s)\n  }\n}\n\nlet trim_trailing_zeros = (s: String) -> String {\n  let mut end = String::length(s)\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\n    end = end - 1\n  }\n  if end <= 0 {\n    \"\"\n  } else {\n    s[0: end]\n  }\n}\n\nexport let double_to_string_compiler = (d: Double) -> String {\n  if d != d {\n    \"nan\"\n  } else {\n    let neg = d < 0.0\n    let abs_d = if neg {\n      0.0 - d\n    } else {\n      d\n    }\n    let int_part = Double::to_int(abs_d)\n    let frac = abs_d - Int::to_double(int_part)\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\n    let int_norm = if eq(scaled_raw, 1000000) {\n      int_part + 1\n    } else {\n      int_part\n    }\n    let frac_norm = if eq(scaled_raw, 1000000) {\n      0\n    } else {\n      scaled_raw\n    }\n    let int_s = __to_string(int_norm)\n    let frac_s = if eq(frac_norm, 0) {\n      \"\"\n    } else {\n      trim_trailing_zeros(zero_pad_6(frac_norm))\n    }\n    let body = if String::length(frac_s) == 0 {\n      int_s\n    } else {\n      String::concat(int_s, String::concat(\".\", frac_s))\n    }\n    if neg {\n      String::concat(\"-\", body)\n    } else {\n      body\n    }\n  }\n}\n")

  let source_9 = ("vibe/compiler/syntax/lexer.vibe",
"\n\n\nlet is_ws = (c: Int) -> Bool {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nlet is_alpha = (c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nlet is_digit = (c: Int) -> Bool {\n  c >= '0' && c <= '9'\n}\n\nlet is_alnum = (c: Int) -> Bool {\n  is_alpha(c) || is_digit(c)\n}\n\nlet lex_char = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = String::char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = String::char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nlet slice_eq = (source: String, start: Int, end: Int, text: String) -> Bool {\n  let len = end - start\n  let text_len = String::length(text)\n  if len != text_len {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet is_hex_digit = (c: Int) -> Bool {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nlet keyword_lookup = (source: String, start: Int, end: Int) -> Option[Token] {\n  let len = end - start\n  if len == 2 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"fn\") {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"if\") {\n        Some(TIf)\n      } else if slice_eq(source, start, end, \"in\") {\n        Some(TIn)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"do\") {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if slice_eq(source, start, end, \"as\") {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'l' {\n      if slice_eq(source, start, end, \"let\") {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"rec\") {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"mut\") {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if slice_eq(source, start, end, \"for\") {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'e' {\n      if slice_eq(source, start, end, \"else\") {\n        Some(TElse)\n      } else if slice_eq(source, start, end, \"enum\") {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"true\") {\n        Some(TIdent(\"true\"))\n      } else if slice_eq(source, start, end, \"type\") {\n        Some(TType)\n      } else if slice_eq(source, start, end, \"test\") {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"with\") {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if slice_eq(source, start, end, \"loop\") {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if slice_eq(source, start, end, \"open\") {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"impl\") {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"false\") {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"match\") {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"trait\") {\n        Some(TTrait)\n      } else if slice_eq(source, start, end, \"throw\") {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"while\") {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if slice_eq(source, start, end, \"break\") {\n        Some(TBreak)\n      } else if slice_eq(source, start, end, \"bench\") {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"raise\") {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if slice_eq(source, start, end, \"yield\") {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 's' {\n      if slice_eq(source, start, end, \"struct\") {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if slice_eq(source, start, end, \"export\") {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"return\") {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if slice_eq(source, start, end, \"handle\") {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"module\") {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"derive\") {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"import\") {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if slice_eq(source, start, end, \"declare\") {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'c' {\n      if slice_eq(source, start, end, \"continue\") {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if slice_eq(source, start, end, \"suberror\") {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nlet scan_ident_end = (s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_alnum(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet lex_ident = (s: String, len: Int, i: Int) -> (Token, Int) {\n  let end = scan_ident_end(s, len, i)\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\n    let ri_start = end + 1\n    let ri_end = scan_ident_end(s, len, ri_start)\n    (TIdent(s[ri_start: ri_end]), ri_end)\n  }\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\"' {\n    let mut ri = end + 1\n    while ri < len && String::char_code_at(s, ri) != '\"' {\n      ri = ri + 1\n    }\n    (TString(s[end + 1: ri]), if ri >= len {\n      ri\n    } else {\n      ri + 1\n    })\n  } else {\n    match keyword_lookup(s, i, end) {\n      Some(tok) => (tok, end),\n      None => (TIdent(s[i: end]), end)\n    }\n  }\n}\n\nlet scan_digits_end = (s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet scan_interp_end = (s: String, len: Int, idx: Int, depth: Int) -> Int with { Error } {\n  let mut out = idx\n  let mut current_depth = depth\n  let mut found = -1\n  while out < len && found < 0 {\n    let c = String::char_code_at(s, out)\n    if c == '{' {\n      current_depth = current_depth + 1\n    } else if c == '}' {\n      if current_depth == 1 {\n        found = out\n      } else {\n        current_depth = current_depth - 1\n      }\n    }\n    if found < 0 {\n      out = out + 1\n    }\n  }\n  if found >= 0 {\n    found\n  } else {\n    throw(\"unterminated string interpolation\")\n  }\n}\n\nlet parse_frac_digits = (s: String, len: Int, i: Int, acc: Double, scale: Double) -> (Double, Int) {\n  let mut out_i = i\n  let mut out_acc = acc\n  let mut out_scale = scale\n  let mut done = false\n  while out_i < len && !done {\n    let c = String::char_code_at(s, out_i)\n    if is_digit(c) {\n      out_acc = out_acc + Int::to_double(c - 48) / out_scale\n      out_scale = out_scale * 10.0\n      out_i = out_i + 1\n    } else {\n      done = true\n    }\n  }\n  (out_acc, out_i)\n}\n\nlet empty_string_array = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet skip_until_newline = (s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  let mut done = false\n  while out < len && !done {\n    if String::char_code_at(s, out) == '\\n' {\n      out = out + 1\n      done = true\n    } else {\n      out = out + 1\n    }\n  }\n  out\n}\n\nlet skip_ws = (s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  let mut skipping = true\n  while skipping && out < len {\n    let c = String::char_code_at(s, out)\n    if is_ws(c) {\n      out = out + 1\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\n      out = skip_until_newline(s, len, out + 2)\n    } else {\n      skipping = false\n    }\n  }\n  out\n}\n\nlet concat_string_parts = (parts: Array[String], tail: String) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(parts) {\n    out = String::concat(out, Array::get(parts, i))\n    i = i + 1\n  }\n  String::concat(out, tail)\n}\n\nlet lex_string_go = (s: String, len: Int, idx: Int, start: Int, parts_acc: Array[String], has_interp: Bool, parts: ArrayBuilder[String]) -> (Token, Int)with { Error } {\n  let mut current_idx = idx\n  let mut current_start = start\n  let mut current_parts_acc = parts_acc\n  let mut current_has_interp = has_interp\n  let mut out_tok = TEof\n  let mut out_next = -1\n  let mut done = false\n  while !done {\n    if current_idx >= len {\n      throw(\"unterminated string\")\n    }\n    let c = String::char_code_at(s, current_idx)\n    if c == '\"' {\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\n      if current_has_interp {\n        ArrayBuilder::push(parts, value)\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts))\n        out_next = current_idx + 1\n      } else {\n        out_tok = TString(value)\n        out_next = current_idx + 1\n      }\n      done = true\n    } else if c == '\\\\' {\n      let chunk = s[current_start: current_idx]\n      let next = current_idx + 1\n      if next >= len {\n        throw(\"unterminated string escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      if esc == '{' || esc == '(' {\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\n        let interp_end = if esc == '{' {\n          scan_interp_end(s, len, next + 1, 1)\n        } else {\n          let mut ie = next + 1\n          let mut depth = 1\n          while ie < len && depth > 0 {\n            let ic = String::char_code_at(s, ie)\n            if ic == '(' {\n              depth = depth + 1\n            }\n            else if ic == ')' {\n              depth = depth - 1\n            }\n            ie = ie + 1\n          }\n          ie - 1\n        }\n        let expr_src = s[next + 1: interp_end]\n        ArrayBuilder::push(parts, expr_src)\n        current_idx = interp_end + 1\n        current_start = interp_end + 1\n        current_parts_acc = empty_string_array()\n        current_has_interp = true\n      } else {\n        let escaped = if esc == '\"' {\n          \"\\\"\"\n        }\n        else if esc == '\\\\' {\n          \"\\\\\"\n        }\n        else if esc == 'n' {\n          \"\\n\"\n        }\n        else if esc == 't' {\n          \"\\t\"\n        }\n        else if esc == 'r' {\n          String::from_char_code(13)\n        }\n        else if esc == '0' {\n          String::from_char_code(0)\n        }\n        else throw(\"invalid escape sequence\")\n        Array::push(current_parts_acc, chunk)\n        Array::push(current_parts_acc, escaped)\n        current_idx = next + 1\n        current_start = next + 1\n      }\n    } else {\n      current_idx = current_idx + 1\n    }\n  }\n  (out_tok, out_next)\n}\n\nlet lex_string = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new())\n}\n\nlet scan_hex_digits_end = (s: String, len: Int, i: Int) -> Int {\n  let mut out = i\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet parse_hex_from_string = (s: String) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nlet parse_int_from_string = (s: String) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    acc = acc * 10 + (c - 48)\n    i = i + 1\n  }\n  acc\n}\n\nlet lex_decimal = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  if int_end < len && String::char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\n      let int_str = s[i: int_end]\n      let int_val = Int::to_double(parse_int_from_string(int_str))\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\n        (TFloat(int_val + frac_val), frac_end + 1)\n      } else {\n        (TFloat(int_val + frac_val), frac_end)\n      }\n    } else {\n      let int_str = s[i: int_end];\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else {\n    let int_str = s[i: int_end];\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nlet lex_number = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\n    let next_c = String::char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = s[hex_start: hex_end];\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\nexport let lex = (source: String) -> Array[Token] with { Error } {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let mut pos = skip_ws(source, len, 0)\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = if is_alpha(c) {\n        lex_ident(source, len, pos)\n      } else if is_digit(c) {\n        lex_number(source, len, pos)\n      } else if c == '\"' {\n        lex_string(source, len, pos)\n      } else if c == '+' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TPlusEq, pos + 2)\n        } else (TPlus, pos + 1)\n      } else if c == '-' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TThinArrow, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TMinusEq, pos + 2)\n        } else (TMinus, pos + 1)\n      } else if c == '*' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TStarEq, pos + 2)\n        } else (TStar, pos + 1)\n      } else if c == '/' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TSlashEq, pos + 2)\n        } else (TSlash, pos + 1)\n      } else if c == '%' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TPercentEq, pos + 2)\n        } else (TPercent, pos + 1)\n      } else if c == '=' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TEqEq, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TArrow, pos + 2)\n        } else (TEq, pos + 1)\n      } else if c == '!' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TNeq, pos + 2)\n        } else (TNot, pos + 1)\n      } else if c == '<' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TLte, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\n          (TLShift, pos + 2)\n        } else (TLt, pos + 1)\n      } else if c == '>' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TGte, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TRShift, pos + 2)\n        } else (TGt, pos + 1)\n      } else if c == '&' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\n          (TAnd, pos + 2)\n        } else (TBitAnd, pos + 1)\n      } else if c == '|' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\n          (TOr, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TPipeGt, pos + 2)\n        } else (TBitOr, pos + 1)\n      } else if c == '^' {\n        (TBitXor, pos + 1)\n      } else if c == '(' {\n        (TLParen, pos + 1)\n      } else if c == ')' {\n        (TRParen, pos + 1)\n      } else if c == '{' {\n        (TLBrace, pos + 1)\n      } else if c == '}' {\n        (TRBrace, pos + 1)\n      } else if c == '[' {\n        (TLBracket, pos + 1)\n      } else if c == ']' {\n        (TRBracket, pos + 1)\n      } else if c == ',' {\n        (TComma, pos + 1)\n      } else if c == ';' {\n        (TSemicolon, pos + 1)\n      } else if c == '.' {\n        if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\n          (TDotDotDot, pos + 3)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\n          (TDotDot, pos + 2)\n        } else (TDot, pos + 1)\n      } else if c == ':' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\n          (TDoubleColon, pos + 2)\n        } else (TColon, pos + 1)\n      } else if c == '#' {\n        (THash, pos + 1)\n      } else if c == '~' {\n        (TTilde, pos + 1)\n      } else if c == '?' {\n        (TQuestion, pos + 1)\n      } else if c == '@' {\n        let mut end = pos + 1\n        while end < len && is_alnum(String::char_code_at(source, end)) {\n          end = end + 1\n        }\n        if end > pos + 1 {\n          (TIdent(String::substring(source, pos, end)), end)\n        } else {\n          throw(\"unexpected '@' without identifier\")\n        }\n      } else if c == '\\'' {\n        lex_char(source, len, pos)\n      } else throw(String::concat(\"unexpected character: \", String::from_char_code(c)))\n      ArrayBuilder::push(b, tok)\n      pos = skip_ws(source, len, next)\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::freeze(b)\n  }\n}\n\nexport let lex_ok = (source: String) -> Bool {\n  handle {\n    let _ = lex(source)\n    true\n  } {\n    Error(_) => false\n  }\n}\n")

  let source_10 = ("vibe/compiler/syntax/parser.vibe",
"\n\n\n\n\n\nlet mode_block = 20\n\nlet empty_names = () -> Array[String] {\n  Array::slice([\n    \"_\"\n  ], 0, 0)\n}\n\nlet parse_test_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, mode_block);\n      (STest(name, body), end)\n    },\n    _ => throw(\"expected test name string\")\n  }\n}\n\nlet parse_bench_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, mode_block);\n      (SBench(name, body), end)\n    },\n    _ => throw(\"expected bench name string\")\n  }\n}\n\nlet rec parse_export_names_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        parse_export_names_rest(tokens, pos + 2, b)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in export list\")\n  }\n}\n\nlet rec parse_import_items_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (item, next) = parse_import_item(tokens, pos + 1)\n        ArrayBuilder::push(b, item)\n        parse_import_items_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in import list\")\n  }\n}\n\nlet parse_import_items = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_import_items(), pos + 1),\n    _ => {\n      let (first, next) = parse_import_item(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_import_items_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_import_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(name, items), end)\n    } else {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      match peek(tokens, bp) {\n        TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {\n          let alias_str = String::substring(alias_name, 1, String::length(alias_name))\n          (SAliasDecl(alias_str, path), bp + 1)\n        } else {\n          let br = expect_tk(tokens, bp, \"{\")\n          let (items, end) = parse_import_items(tokens, br);\n          (SImport(path, items), end)\n        },\n        _ => {\n          let br = expect_tk(tokens, bp, \"{\")\n          let (items, end) = parse_import_items(tokens, br);\n          (SImport(path, items), end)\n        }\n      }\n    },\n    _ => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(path, items), end)\n    }\n  }\n}\n\nlet rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), pos + 1),\n    _ => {\n      let (first, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_struct_fields_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (fields, end) = parse_struct_fields(tokens, br);\n      (SStruct(exported, name, fields), end)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\nlet parse_export_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TLet => parse_let_stmt(tokens, pos + 1, true),\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\n    TStruct => parse_struct_stmt(tokens, pos + 1, true),\n    TIdent(ident_name) => if ident_name == \"effect\" {\n      parse_effect_stmt(tokens, pos + 1, true)\n    } else {\n      throw(String::concat(\"unexpected token in export: \", ident_name))\n    },\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\n    TOpen => match peek(tokens, pos + 1) {\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\n      _ => throw(\"expected 'trait' after 'open'\")\n    },\n    TLBrace => match peek(tokens, pos + 1) {\n      TRBrace => (SExport(empty_names()), pos + 2),\n      TIdent(name) => {\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, name)\n        let (names, end) = parse_export_names_rest(tokens, pos + 2, b);\n        (SExport(names), end)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    _ => throw(\"unexpected after 'export': \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nlet parse_percent_symbol_name = (tokens: Array[Token], pos: Int, label: String) -> (String, Int)with { Error } {\n  let pp = expect_tk(tokens, pos, \"%\")\n  match peek(tokens, pp) {\n    TIdent(name) => (\"%\\{name}\", pp + 1),\n    _ => throw(\"expected \\{label} after '%'\")\n  }\n}\n\nlet parse_extern_let_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let lp = expect_tk(tokens, pos, \"let\")\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \"extern symbol name\")\n  let cp = expect_tk(tokens, np, \":\")\n  let (ty, end) = parse_type(tokens, cp);\n  (SExternLet(name, ty), end)\n}\n\nexport let rec parse_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let rec parse_module_body = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Stmt]) -> (Array[Stmt], Int)with { Error } {\n    match peek(tokens, pos) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, pos)\n        ArrayBuilder::push(b, stmt)\n        parse_module_body(tokens, next, b)\n      }\n    }\n  }\n  let head = peek(tokens, pos)\n  match head {\n    TLet => parse_let_stmt(tokens, pos + 1, false),\n    TExport => match peek(tokens, pos + 1) {\n      TModule => match peek(tokens, pos + 2) {\n        TIdent(name) => {\n          let br = expect_tk(tokens, pos + 3, \"{\")\n          {\n            let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());\n            (SModule(true, name, stmts), end)\n          }\n        },\n        _ => throw(\"expected module name\")\n      },\n      _ => parse_export_stmt(tokens, pos + 1)\n    },\n    TModule => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let br = expect_tk(tokens, pos + 2, \"{\")\n        {\n          let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());\n          (SModule(false, name, stmts), end)\n        }\n      },\n      _ => throw(\"expected module name\")\n    },\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\n    TStruct => parse_struct_stmt(tokens, pos + 1, false),\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\n    TTest => parse_test_stmt(tokens, pos + 1),\n    TBench => parse_bench_stmt(tokens, pos + 1),\n    TImport => parse_import_stmt(tokens, pos + 1),\n    TIdent(name) => if name == \"effect\" {\n      parse_effect_stmt(tokens, pos + 1, false)\n    } else if name == \"extern\" {\n      parse_extern_let_stmt(tokens, pos + 1)\n    } else if name == \"use\" {\n      throw(\"'use' syntax is removed; use 'import <module-ref> { ... }'\")\n    } else {\n      let (e, next) = parse_impl(tokens, pos, 0)\n      match peek(tokens, next) {\n        TEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssign(name, val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TPlusEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssignOp(name, \"+\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TMinusEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssignOp(name, \"-\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TStarEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssignOp(name, \"*\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TSlashEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssignOp(name, \"/\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        _ => (SExpr(e), next)\n      }\n    },\n    _ => {\n      let (e, next) = parse_impl(tokens, pos, 0);\n      (SExpr(e), next)\n    }\n  }\n}\n\nexport let parse_program = (tokens: Array[Token]) -> Array[Stmt] with { Error } {\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  while !is_tk(peek(tokens, pos), \"eof\") {\n    pos = skip_semi(tokens, pos)\n    if is_tk(peek(tokens, pos), \"eof\") {\n      break\n    }\n    let (stmt, next) = if is_tk(peek(tokens, pos), \"impl\") {\n      parse_impl_stmt_dispatch(tokens, pos + 1)\n    } else {\n      parse_stmt(tokens, pos)\n    }\n    ArrayBuilder::push(b, stmt)\n    pos = next\n  }\n  ArrayBuilder::freeze(b)\n}\n\n\nexport {\n  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n")

  let source_11 = ("vibe/compiler/syntax/parser_base.vibe",
"\n\n\n\nlet peek = (tokens: Array[Token], pos: Int) -> Token {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else TEof\n}\n\nlet _no_tp = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet _no_tb = () -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet mode_if = 21\n\nlet tk_name = (tok: Token) -> String {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TStringInterp(_) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TDotDot => \"..\",\n    TDotDotDot => \"...\",\n    TStringInterp(_) => \"string\",\n    TEof => \"eof\"\n  }\n}\n\nlet is_tk = (tok: Token, name: String) -> Bool {\n  tk_name(tok) == name\n}\n\nlet expect_tk = (tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  }\n  else throw(\"expected \\{expected} but got \\{tk_name(peek(tokens, pos))}\")\n}\n\nlet skip_semi = (tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nlet empty_arms = () -> Array[(Pat, Expr)] {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nlet empty_pats = () -> Array[Pat] {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nlet mode_block = 20\n\nlet mode_match = 22\n\nlet mode_while = 23\n\nlet empty_ctors = () -> Array[(String, Array[TypeExpr])] {\n  Array::slice([\n    (\"_\", Array::slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet empty_exprs = () -> Array[Expr] {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet mode_for_in = 25\n\nlet mode_handle = 24\n\nlet empty_fields = () -> Array[(String, TypeExpr)] {\n  Array::slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nlet empty_params = () -> Array[(String, Option[TypeExpr])] {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nlet rec parse_pattern = (tokens: Array[Token], pos: Int) -> (Pat, Int)with { Error } {\n  let rec parse_pat_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Pat]) -> (Array[Pat], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen = (tokens: Array[Token], pos: Int) -> (Array[Pat], Int)with { Error } {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    TFloat(_) => (PWild, pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => {\n      let next_is_lbrace = match peek(tokens, pos + 1) {\n        TLBrace => true,\n        _ => false\n      }\n      if name == \"true\" {\n        (PBool(true), pos + 1)\n      }\n      else if name == \"false\" {\n        (PBool(false), pos + 1)\n      }\n      else if name == \"_\" {\n        (PWild, pos + 1)\n      }\n      else if name == \"record\" && next_is_lbrace {\n        let mut rp = pos + 2\n        let field_pats_b = ArrayBuilder::new()\n        let mut rd = true\n        while rd {\n          match peek(tokens, rp) {\n            TRBrace => {\n              rd = false\n            },\n            TIdent(fname) => {\n              match peek(tokens, rp + 1) {\n                TColon => {\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\n                  ArrayBuilder::push(field_pats_b, fp)\n                  rp = fnext\n                },\n                TComma => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                TRBrace => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                _ => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                }\n              }\n              match peek(tokens, rp) {\n                TComma => {\n                  rp = rp + 1\n                },\n                _ => ()\n              }\n            },\n            _ => {\n              rp = rp + 1\n            }\n          }\n        }\n        let rp2 = rp + 1\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\n      }\n      else {\n        let fc = String::char_code_at(name, 0)\n        if fc >= 65 && fc <= 90 {\n          match peek(tokens, pos + 1) {\n            TLParen => {\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n              (PCtor(name, args), end)\n            },\n            TDoubleColon => match peek(tokens, pos + 2) {\n              TLBrace => {\n                let mut sp = pos + 3\n                let field_pats = ArrayBuilder::new()\n                let mut sd = true\n                while sd {\n                  match peek(tokens, sp) {\n                    TRBrace => {\n                      sd = false\n                    },\n                    TIdent(fname) => {\n                      ArrayBuilder::push(field_pats, PBind(fname))\n                      sp = sp + 1\n                      match peek(tokens, sp) {\n                        TComma => {\n                          sp = sp + 1\n                        },\n                        _ => ()\n                      }\n                    },\n                    _ => {\n                      sd = false\n                    }\n                  }\n                }\n                (PTuple(ArrayBuilder::freeze(field_pats)), sp + 1)\n              },\n              _ => (PCtor(name, empty_pats()), pos + 1)\n            },\n            _ => (PCtor(name, empty_pats()), pos + 1)\n          }\n        } else (PBind(name), pos + 1)\n      }\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => throw(\"unexpected in pattern: \\{tk_name(peek(tokens, pos))}\")\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nlet parse_impl_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"_\", empty_strings)\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TLBracket => throw(\"impl type parameters are not supported yet\")\n    ,\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, pos + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => (SImpl(empty_strings, empty_bounds, trait_name, type_name), fp + 1),\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nlet empty_type_exprs = () -> Array[TypeExpr] {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nlet parse_trait_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TColon => {\n        let rec parse_supers = (p: Int, acc: Array[String]) -> (Array[String], Int) {\n          match peek(tokens, p) {\n            TIdent(sname) => match peek(tokens, p + 1) {\n              TPlus => parse_supers(p + 2, Array::concat(acc, [\n                sname\n              ])),\n              _ => (Array::concat(acc, [\n                sname\n              ]), p + 1)\n            },\n            _ => (acc, p)\n          }\n        }\n        let (supers, np) = parse_supers(pos + 2, empty_strings);\n        (STrait(exported, name, supers), np)\n      },\n      _ => (STrait(exported, name, empty_strings), pos + 1)\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nlet is_expr_end_token = (tok: Token) -> Bool {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TStringInterp(_) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nlet is_non_pipe_infix = (tok: Token) -> Bool {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nlet parse_import_item = (tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int)with { Error } {\n  let parse_import_name = (name_pos: Int) -> ((String, Option[String]), Int)with { Error } {\n    match peek(tokens, name_pos) {\n      TIdent(name) => match peek(tokens, name_pos + 1) {\n        TAs => match peek(tokens, name_pos + 2) {\n          TIdent(alias) => ((name, Some(alias)), name_pos + 3),\n          _ => throw(\"expected alias name after 'as'\")\n        },\n        _ => ((name, None), name_pos + 1)\n      },\n      _ => throw(\"expected import item name\")\n    }\n  }\n  match peek(tokens, pos) {\n    TIdent(_) => parse_import_name(pos),\n    TType => parse_import_name(pos + 1),\n    TTrait => parse_import_name(pos + 1),\n    _ => throw(\"expected import item name\")\n  }\n}\n\nlet empty_import_items = () -> Array[(String, Option[String])] {\n  Array::slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nlet parse_binding_name = (tokens: Array[Token], pos: Int) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nlet rec collect_import_path = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, \"\\{acc}.\"),\n    TDotDot => collect_import_path(tokens, pos + 1, \"\\{acc}..\"),\n    TSlash => collect_import_path(tokens, pos + 1, \"\\{acc}/\"),\n    TIdent(name) => collect_import_path(tokens, pos + 1, \"\\{acc}\\{name}\"),\n    TMinus => collect_import_path(tokens, pos + 1, \"\\{acc}-\"),\n    TModule => collect_import_path(tokens, pos + 1, \"\\{acc}module\"),\n    TType => collect_import_path(tokens, pos + 1, \"\\{acc}type\"),\n    TMatch => collect_import_path(tokens, pos + 1, \"\\{acc}match\"),\n    TTest => collect_import_path(tokens, pos + 1, \"\\{acc}test\"),\n    _ => throw(\"unexpected token in import path: \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nlet rec collect_effect_names = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let new_acc = if String::length(acc) == 0 {\n        name\n      } else \"\\{acc}, \\{name}\"\n      match peek(tokens, pos + 1) {\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\n        TRBrace => (new_acc, pos + 2),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nlet rec parse_type_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int)with { Error } {\n  let rec type_list_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let ts = match peek(tokens, pos + 1) {\n          TIdent(_) => match peek(tokens, pos + 2) {\n            TColon => pos + 3,\n            TTilde => match peek(tokens, pos + 3) {\n              TColon => pos + 4,\n              _ => pos + 1\n            },\n            TQuestion => match peek(tokens, pos + 3) {\n              TColon => pos + 4,\n              _ => pos + 1\n            },\n            _ => pos + 1\n          },\n          _ => pos + 1\n        }\n        let (ty, next) = parse_type_impl(tokens, ts, 0)\n        ArrayBuilder::push(b, ty)\n        type_list_rest(tokens, next, b)\n      },\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  if mode == 0 {\n    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n    match peek(tokens, atom_next) {\n      TThinArrow => {\n        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n        let params = match atom_ty {\n          TyUnit => empty_type_exprs(),\n          TyTuple(elems) => elems,\n          _ => [\n            atom_ty\n          ]\n        }\n        let rn2 = match peek(tokens, rn) {\n          TWith => {\n            let p1 = rn + 1\n            match peek(tokens, p1) {\n              TLBrace => {\n                let mut p2 = p1 + 1\n                let mut done = false\n                while !done {\n                  match peek(tokens, p2) {\n                    TRBrace => {\n                      done = true\n                    },\n                    _ => {\n                      p2 = p2 + 1\n                    }\n                  }\n                }\n                p2 + 1\n              },\n              _ => rn\n            }\n          },\n          _ => rn\n        };\n        let effect_pair = match peek(tokens, rn2) {\n          TWith => {\n            let with_pos = expect_tk(tokens, rn2 + 1, \"{\")\n            let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n            (Some(effect_name_pair.0), effect_name_pair.1)\n          },\n          _ => (None, rn2)\n        }\n        (TyFn(params, ret, effect_pair.0), effect_pair.1)\n      },\n      _ => (atom_ty, atom_next)\n    }\n  } else match peek(tokens, pos) {\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (TyUnit, pos + 2),\n      _ => {\n        let ty_start = match peek(tokens, pos + 1) {\n          TIdent(_) => match peek(tokens, pos + 2) {\n            TColon => pos + 3,\n            TTilde => match peek(tokens, pos + 3) {\n              TColon => pos + 4,\n              _ => pos + 1\n            },\n            TQuestion => match peek(tokens, pos + 3) {\n              TColon => pos + 4,\n              _ => pos + 1\n            },\n            _ => pos + 1\n          },\n          _ => pos + 1\n        }\n        let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n        match peek(tokens, n1) {\n          TRParen => (first, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, first)\n            let (rest, end) = type_list_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \")\");\n            (TyTuple(rest), en)\n          },\n          _ => throw(\"expected ')' or ',' in type\")\n        }\n      }\n    },\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLBracket => {\n        let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n        match peek(tokens, n1) {\n          TRBracket => (TyApp(name, [\n            first\n          ]), n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, first)\n            let (rest, end) = type_list_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \"]\");\n            (TyApp(name, rest), en)\n          },\n          _ => throw(\"expected ']' or ',' in type application\")\n        }\n      },\n      _ => (TyName(name), pos + 1)\n    },\n    _ => throw(\"expected type but got \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nexport let parse_type = (tokens: Array[Token], pos: Int) -> (TypeExpr, Int)with { Error } {\n  parse_type_impl(tokens, pos, 0)\n}\n\nlet parse_one_param = (tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = \"\\{name}~\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TQuestion => {\n        let opt_name = \"\\{name}?\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((opt_name, Some(ty)), tp)\n          },\n          _ => ((opt_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        let tp2 = match peek(tokens, tp) {\n          TColon => {\n            let mut bp = tp + 1\n            let mut bd = true\n            while bd {\n              match peek(tokens, bp) {\n                TIdent(_) => {\n                  bp = bp + 1; match peek(tokens, bp) {\n                    TPlus => {\n                      bp = bp + 1\n                    },\n                    _ => {\n                      bd = false\n                    }\n                  }\n                },\n                _ => {\n                  bd = false\n                }\n              }\n            }\n            bp\n          },\n          _ => tp\n        }\n        ((name, Some(ty)), tp2)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => throw(\"expected parameter name\")\n  }\n}\n\nlet rec parse_param_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (p, pn) = parse_one_param(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_param_cont(tokens, pn, b)\n      }\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in param list\")\n  }\n}\n\nlet parse_param_list = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nlet parse_struct_field = (tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, pos + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nlet rec is_lambda_start_impl = (tokens: Array[Token], pos: Int, depth: Int, has_colon: Bool) -> Bool {\n  match peek(tokens, pos) {\n    TColon => if depth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => true,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)\n  }\n}\n\nlet is_lambda_start = (tokens: Array[Token], pos: Int) -> Bool {\n  is_lambda_start_impl(tokens, pos, 0, false)\n}\n\nlet rec parse_ctor_types_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nlet parse_enum_ctor = (tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nlet rec parse_enum_ctors_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in enum\")\n  }\n}\n\nlet parse_enum_ctors = (tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_enum_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let mut skip = pos + 2\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          skip\n        },\n        _ => pos + 1\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      (SEnum(exported, name, ctors), end)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nlet parse_suberror_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = ArrayBuilder::new()\n          ArrayBuilder::push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = ArrayBuilder::new()\n          ArrayBuilder::push(ctors_b, (name, args))\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nlet parse_type_alias_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let ep = expect_tk(tokens, pos + 1, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nlet parse_type_params_list = (tokens: Array[Token], pos: Int) -> (Array[String], Int)with { Error } {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_effect_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\n      }\n      let br = expect_tk(tokens, after_params, \"{\")\n      let ops_b = ArrayBuilder::new()\n      let mut p = br\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(op_name) => {\n            let (params, after_op_params) = match peek(tokens, p + 1) {\n              TLParen => {\n                let params_b = ArrayBuilder::new()\n                let mut pp = p + 2\n                match peek(tokens, pp) {\n                  TRParen => (ArrayBuilder::freeze(params_b), pp + 1),\n                  _ => {\n                    let (first_type, n1) = parse_type_impl(tokens, pp, 0)\n                    ArrayBuilder::push(params_b, first_type)\n                    pp = n1\n                    while true {\n                      match peek(tokens, pp) {\n                        TComma => {\n                          let (next_type, n2) = parse_type_impl(tokens, pp + 1, 0)\n                          ArrayBuilder::push(params_b, next_type)\n                          pp = n2\n                        },\n                        TRParen => {\n                          pp = pp + 1\n                          break\n                        },\n                        _ => throw(\"expected ',' or ')' in effect op params\")\n                      }\n                    }\n                    (ArrayBuilder::freeze(params_b), pp)\n                  }\n                }\n              },\n              _ => (ArrayBuilder::freeze(ArrayBuilder::new()), p + 1)\n            }\n            let arrow_pos = expect_tk(tokens, after_op_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected effect operation name or '}'\")\n        }\n      }\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\n    },\n    _ => throw(\"expected effect name\")\n  }\n}\n\nlet parse_impl_stmt_dispatch = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  parse_impl_stmt(tokens, pos)\n}\n\nlet rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), pos + 1),\n    _ => {\n      let (first, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_struct_fields_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (fields, end) = parse_struct_fields(tokens, br);\n      (SStruct(exported, name, fields), end)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\n\nexport {\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, peek, skip_semi, tk_name\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n")

  let source_12 = ("vibe/compiler/syntax/parser_expr.vibe",
"\n\n\n\n\n\n\nexport let parse_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (Expr, Int)with { Error } {\n  let rec parse_recur = (rtoks: Array[Token], rpos: Int, rmode: Int) -> (Expr, Int)with { Error } {\n    if rmode >= 0 && rmode <= 10 {\n      parse_infix(rtoks, rpos, rmode, rpos, parse_recur)\n    } else {\n      parse_impl_dispatch(rtoks, rpos, rmode, parse_recur)\n    }\n  }\n  parse_recur(tokens, pos, mode)\n}\n\nexport let parse = (tokens: Array[Token]) -> Expr with { Error } {\n  let (e, next) = parse_impl(tokens, 0, 0)\n  match peek(tokens, next) {\n    TEof => e,\n    _ => throw(\"unexpected after expression: \\{tk_name(peek(tokens, next))}\")\n  }\n}\n\nexport let parse_ok = (tokens: Array[Token]) -> Bool {\n  handle {\n    let _ = parse(tokens)\n    true\n  } {\n    Error(_) => false\n  }\n}\n\nexport let parse_expr = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n  parse_impl(tokens, pos, 0)\n}\n\nlet skip_generic_value_start = (tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TLBracket => match peek(tokens, pos + 1) {\n      TIdent(_) => {\n        let maybe_generic = match peek(tokens, pos + 2) {\n          TRBracket => match peek(tokens, pos + 3) {\n            TLParen => true,\n            _ => false\n          },\n          TColon => true,\n          TComma => true,\n          _ => false\n        }\n        if maybe_generic {\n          let mut scan_pos = pos + 1\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, scan_pos) {\n              TLBracket => {\n                depth = depth + 1\n              },\n              TRBracket => {\n                depth = depth - 1\n              },\n              _ => ()\n            }\n            scan_pos = scan_pos + 1\n          }\n          scan_pos\n        } else {\n          pos\n        }\n      },\n      _ => pos\n    },\n    _ => pos\n  }\n}\n\nlet parse_let_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TRec => {\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\n      let (ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0)\n          (Some(ty), tp)\n        },\n        _ => (None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let val_start_r = skip_generic_value_start(tokens, ep)\n      let val_pair = parse_impl(tokens, val_start_r, 0)\n      let val = val_pair.0\n      let val_next = val_pair.1\n      (SLet(exported, true, name, ty_opt, val), val_next)\n    },\n    TMut => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let val_pair = parse_impl(tokens, ep, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        (SLetMut(name, ty_opt, val), val_next)\n      },\n      _ => throw(\"expected name after 'let mut'\")\n    },\n    TLParen => {\n      let (pat, pat_next) = parse_pattern(tokens, pos)\n      let ep = expect_tk(tokens, pat_next, \"=\")\n      let val_pair = parse_impl(tokens, ep, 0)\n      let val = val_pair.0\n      let val_next = val_pair.1\n      (SLetPat(pat, val), val_next)\n    },\n    TIdent(_name0) => {\n      let (name, name_next) = parse_binding_name(tokens, pos)\n      let (ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0)\n          (Some(ty), tp)\n        },\n        _ => (None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let val_start = skip_generic_value_start(tokens, ep)\n      let val_pair = parse_impl(tokens, val_start, 0)\n      let val = val_pair.0\n      let val_next = val_pair.1\n      (SLet(exported, false, name, ty_opt, val), val_next)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\n\nexport {\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name\n}\n\nexport {\n  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n")

  let source_13 = ("vibe/compiler/syntax/expand_interp.vibe",
"\n\n\n\n\n\nlet rec resolve_expr = (e: Expr) -> Expr with { Error } {\n  let desugar_parts = (parts: Array[String]) -> Expr with { Error } {\n    let plen = Array::length(parts)\n    let exprs = ArrayBuilder::new()\n    let mut i = 0\n    while i < plen {\n      let lit = Array::get(parts, i)\n      if String::length(lit) > 0 {\n        ArrayBuilder::push(exprs, EString(lit))\n      }\n      if i + 1 < plen {\n        let expr_src = Array::get(parts, i + 1)\n        let expr_tokens = lex(expr_src)\n        let parsed = parse(expr_tokens)\n        let resolved = resolve_expr(parsed)\n        ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\"), [\n          resolved\n        ]))\n      }\n      i = i + 2\n    }\n    let result_arr = ArrayBuilder::freeze(exprs)\n    let result_len = Array::length(result_arr)\n    if result_len == 0 {\n      EString(\"\")\n    } else {\n      let mut result = Array::get(result_arr, 0)\n      let mut j = 1\n      while j < result_len {\n        result = ECall(EIdent(\"String::concat\"), [\n          result,\n          Array::get(result_arr, j)\n        ])\n        j = j + 1\n      }\n      result\n    }\n  }\n  let resolve_arr = (exprs: Array[Expr]) -> Array[Expr] with { Error } {\n    for ex in exprs {\n      resolve_expr(ex)\n    }\n  }\n  match e {\n    EStringInterp(parts) => desugar_parts(parts),\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EUnit => e,\n    EIdent(_) => e,\n    ETuple(elems) => ETuple(resolve_arr(elems)),\n    EArray(elems) => EArray(resolve_arr(elems)),\n    ERecord(fields) => ERecord(for f in fields {\n      let (n, v) = f; (n, resolve_expr(v))\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (n, v) = f; (n, resolve_expr(v))\n    }),\n    EIf(c, t, el) => EIf(resolve_expr(c), resolve_expr(t), resolve_expr(el)),\n    ELet(n, v, b) => ELet(n, resolve_expr(v), resolve_expr(b)),\n    ELetRec(n, v, b) => ELetRec(n, resolve_expr(v), resolve_expr(b)),\n    ELetMut(n, v, b) => ELetMut(n, resolve_expr(v), resolve_expr(b)),\n    EAssign(n, v, b) => EAssign(n, resolve_expr(v), resolve_expr(b)),\n    EAssignOp(n, op, v, b) => EAssignOp(n, op, resolve_expr(v), resolve_expr(b)),\n    ESeq(a, b) => ESeq(resolve_expr(a), resolve_expr(b)),\n    EMatch(s, arms) => EMatch(resolve_expr(s), for a in arms {\n      let (p, ex) = a; (p, resolve_expr(ex))\n    }),\n    EHandle(body, arms) => EHandle(resolve_expr(body), for a in arms {\n      let (p, ex) = a; (p, resolve_expr(ex))\n    }),\n    EWhile(c, b) => EWhile(resolve_expr(c), resolve_expr(b)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param; (name, resolve_expr(init))\n    }, resolve_expr(body)),\n    EForIn(vn, idx, it, b) => EForIn(vn, idx, resolve_expr(it), resolve_expr(b)),\n    ECall(callee, args) => ECall(resolve_expr(callee), resolve_arr(args)),\n    EBinOp(op, l, r) => EBinOp(op, resolve_expr(l), resolve_expr(r)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_expr(inner)),\n    EFn(a, b, params, ret, eff, body) => EFn(a, b, params, ret, eff, resolve_expr(body)),\n    EDot(inner, field) => EDot(resolve_expr(inner), field),\n    EThrow(inner) => EThrow(resolve_expr(inner)),\n    EBreak(opt) => match opt {\n      None => e,\n      Some(v) => EBreak(Some(resolve_expr(v)))\n    },\n    EContinue(args) => EContinue(resolve_arr(args)),\n    ELabeledArg(n, m, v) => ELabeledArg(n, m, resolve_expr(v)),\n    ESpread(inner) => ESpread(resolve_expr(inner))\n  }\n}\n\nlet resolve_stmt = (s: Stmt) -> Stmt with { Error } {\n  match s {\n    SLet(exp, is_rec, name, ty, val) => SLet(exp, is_rec, name, ty, resolve_expr(val)),\n    SLetMut(name, ty, val) => SLetMut(name, ty, resolve_expr(val)),\n    STest(name, body) => STest(name, resolve_expr(body)),\n    SBench(name, body) => SBench(name, resolve_expr(body)),\n    SExpr(e) => SExpr(resolve_expr(e)),\n    _ => s\n  }\n}\n\nexport let resolve_interp_expr = (e: Expr) -> Expr with { Error } {\n  resolve_expr(e)\n}\n\nexport let resolve_interp_stmts = (stmts: Array[Stmt]) -> Array[Stmt] with { Error } {\n  for s in stmts {\n    resolve_stmt(s)\n  }\n}\n")

  let source_14 = ("vibe/compiler/syntax/printer.vibe",
"\n\n\n\nlet join = (arr: Array[String], sep: String) -> String {\n  let len = Array::length(arr)\n  if len == 0 {\n    \"\"\n  } else {\n    let b = ArrayBuilder::new()\n    let mut i = 0\n    while i < len {\n      if i > 0 {\n        ArrayBuilder::push(b, sep)\n      }\n      ArrayBuilder::push(b, Array::get(arr, i))\n      i = i + 1\n    }\n    String::join(ArrayBuilder::freeze(b), \"\")\n  }\n}\n\nlet escape_string = (s: String) -> String {\n  let len = String::length(s)\n  let b = ArrayBuilder::new()\n  let push_chunk = (start: Int, end: Int) -> Unit {\n    if end > start {\n      ArrayBuilder::push(b, s[start: end])\n    }\n  }\n  let mut i = 0\n  let mut start = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    if c == '\"' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\"\")\n      i = i + 1\n      start = i\n    } else if c == '\\\\' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\\\")\n      i = i + 1\n      start = i\n    } else if c == '\\n' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\n\")\n      i = i + 1\n      start = i\n    } else if c == '\\t' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\t\")\n      i = i + 1\n      start = i\n    } else if c == 13 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\r\")\n      i = i + 1\n      start = i\n    } else if c == 0 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\0\")\n      i = i + 1\n      start = i\n    } else {\n      i = i + 1\n    }\n  }\n  push_chunk(start, len)\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n\nexport let rec print_pat = (p: Pat) -> String {\n  match p {\n    PWild => \"_\",\n    PBind(name) => name,\n    PInt(n) => __to_string(n),\n    PString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    PBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    PCtor(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        print_pat(arg)\n      }\n      String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n    },\n    PTuple(elems) => {\n      let parts = for elem in elems {\n        print_pat(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    },\n    POr(left, right) => String::concat(print_pat(left), String::concat(\" | \", print_pat(right)))\n  }\n}\n\nlet map_to_strings = (exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {\n  for expr in exprs {\n    f(expr)\n  }\n}\n\nexport let rec print_type_expr = (ty: TypeExpr) -> String {\n  match ty {\n    TyName(name) => name,\n    TyUnit => \"()\",\n    TyApp(name, args) => {\n      let parts = for arg in args {\n        print_type_expr(arg)\n      }\n      String::concat(name, String::concat(\"[\", String::concat(join(parts, \", \"), \"]\")))\n    },\n    TyFn(params, ret, effect_name) => {\n      let parts = for param in params {\n        print_type_expr(param)\n      }\n      let base = String::concat(\"(\", String::concat(join(parts, \", \"), String::concat(\") -> \", print_type_expr(ret))))\n      match effect_name {\n        Some(name) => String::concat(base, String::concat(\" with {\", String::concat(name, \"}\"))),\n        None => base\n      }\n    },\n    TyTuple(elems) => {\n      let parts = for elem in elems {\n        print_type_expr(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    }\n  }\n}\n\nlet print_ctor = (ctor: (String, Array[TypeExpr])) -> String {\n  let (name, args) = ctor\n  if eq(Array::length(args), 0) {\n    name\n  }\n  else {\n    let parts = for arg in args {\n      print_type_expr(arg)\n    }\n    String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n  }\n}\n\nexport let rec print_expr = (e: Expr) -> String {\n  match e {\n    EInt(n) => __to_string(n),\n    EFloat(n) => double_to_string_compiler(n),\n    EString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    EBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    EIdent(name) => name,\n    EUnit => \"()\",\n    ETuple(elems) => String::concat(\"(\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \")\")),\n    EArray(elems) => String::concat(\"[\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \"]\")),\n    ERecord(fields) => {\n      let parts = for field in fields {\n        let (name, val) = field\n        String::concat(name, String::concat(\": \", print_expr(val)))\n      }\n      String::concat(\"record { \", String::concat(join(parts, \", \"), \" }\"))\n    },\n    EIf(cond, then_e, else_e) => match else_e {\n      EUnit => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), \" }\")))),\n      _ => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), String::concat(\" } else { \", String::concat(print_expr(else_e), \" }\"))))))\n    },\n    ELet(name, val, body) => String::concat(\"{ let \", String::concat(name, String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetRec(name, val, body) => String::concat(\"{ let rec \", String::concat(name, String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetMut(name, val, body) => String::concat(\"{ let mut \", String::concat(name, String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssign(name, val, body) => String::concat(\"{ \", String::concat(name, String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssignOp(name, op, val, body) => String::concat(\"{ \", String::concat(name, String::concat(\" \", String::concat(op, String::concat(\"= \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))))),\n    ESeq(a, b) => String::concat(\"{ \", String::concat(print_expr(a), String::concat(\"; \", String::concat(print_expr(b), \" }\")))),\n    EMatch(scrutinee, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_pat(pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"match \", String::concat(print_expr(scrutinee), String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    EHandle(body, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_pat(pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"handle { \", String::concat(print_expr(body), String::concat(\" } { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    EWhile(cond, body) => String::concat(\"while \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(body), \" }\")))),\n    ELoop(params, body) => {\n      let parts = for param in params {\n        let (name, init) = param\n        String::concat(name, String::concat(\" = \", print_expr(init)))\n      }\n      String::concat(\"loop (\", String::concat(join(parts, \", \"), String::concat(\") { \", String::concat(print_expr(body), \" }\"))))\n    },\n    EForIn(value_name, index_name, iterable, body) => {\n      let binding = match index_name {\n        Some(index_name) => String::concat(index_name, String::concat(\", \", value_name)),\n        None => value_name\n      }\n      String::concat(\"for \", String::concat(binding, String::concat(\" in \", String::concat(print_expr(iterable), String::concat(\" { \", String::concat(print_expr(body), \" }\"))))))\n    },\n    ECall(callee, args) => String::concat(print_expr(callee), String::concat(\"(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\"))),\n    EBinOp(op, left, right) => String::concat(\"(\", String::concat(print_expr(left), String::concat(\" \", String::concat(op, String::concat(\" \", String::concat(print_expr(right), \")\")))))),\n    EUnaryOp(op, expr) => String::concat(\"(\", String::concat(op, String::concat(print_expr(expr), \")\"))),\n    EFn(_, _, params, ret_ty, effect, body) => {\n      let parts = for param in params {\n        let (name, ty_opt) = param\n        match ty_opt {\n          Some(ty) => String::concat(name, String::concat(\": \", print_type_expr(ty))),\n          None => name\n        }\n      }\n      let ret_str = match ret_ty {\n        Some(rt) => {\n          let eff_str = match effect {\n            Some(e) => String::concat(\" with {\", String::concat(e, \"}\")),\n            None => \"\"\n          }\n          String::concat(\") -> \", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(\" { \", String::concat(print_expr(body), \" }\")))))\n        },\n        None => String::concat(\") -> \", print_expr(body))\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), ret_str))\n    },\n    EDot(expr, field) => String::concat(print_expr(expr), String::concat(\".\", field)),\n    EThrow(e) => String::concat(\"throw(\", String::concat(print_expr(e), \")\")),\n    EBreak(opt) => match opt {\n      None => \"break\",\n      Some(v) => String::concat(\"break \", print_expr(v))\n    },\n    EContinue(args) => if eq(Array::length(args), 0) {\n      \"continue\"\n    } else String::concat(\"continue(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")),\n    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat(\"=\", print_expr(val))),\n    EMap(fields) => if eq(Array::length(fields), 0) {\n      \"map {}\"\n    } else {\n      let parts = for field in fields {\n        let (k, v) = field\n        String::concat(k, String::concat(\": \", print_expr(v)))\n      }\n      String::concat(\"map { \", String::concat(join(parts, \", \"), \" }\"))\n    },\n    ESpread(inner) => String::concat(\"...\", print_expr(inner)),\n    EStringInterp(parts) => String::concat(\"\\\"\", String::concat(join(parts, \"\"), \"\\\"\"))\n  }\n}\n\nlet print_ctor_list = (ctors: Array[(String, Array[TypeExpr])]) -> String {\n  let parts = for ctor in ctors {\n    print_ctor(ctor)\n  }\n  join(parts, \"; \")\n}\n\nexport let rec print_stmt = (s: Stmt) -> String {\n  let prefix = (exported: Bool) -> String {\n    if exported {\n      \"export \"\n    } else \"\"\n  }\n  match s {\n    SLet(exported, is_rec, name, ty_opt, val) => {\n      let p = prefix(exported)\n      let r = if is_rec {\n        \"let rec \"\n      } else \"let \"\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(p, String::concat(r, String::concat(name, String::concat(t, String::concat(\" = \", print_expr(val))))))\n    },\n    SLetMut(name, ty_opt, val) => {\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(\"let mut \", String::concat(name, String::concat(t, String::concat(\" = \", print_expr(val)))))\n    },\n    SEnum(exported, name, ctors) => String::concat(prefix(exported), String::concat(\"enum \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\"))))),\n    SSuberror(exported, name, ctors) => {\n      let p = prefix(exported)\n      if eq(Array::length(ctors), 1) {\n        let (ctor_name, ctor_args) = Array::get(ctors, 0)\n        if ctor_name == name {\n          let parts = for arg in ctor_args {\n            print_type_expr(arg)\n          }\n          String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))))\n        }\n        else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n      } else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n    },\n    SStruct(exported, name, fields) => {\n      let parts = for field in fields {\n        let (fn1, ty) = field\n        String::concat(fn1, String::concat(\": \", print_type_expr(ty)))\n      }\n      String::concat(prefix(exported), String::concat(\"struct \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"; \"), \" }\")))))\n    },\n    STypeAlias(exported, name, ty) => String::concat(prefix(exported), String::concat(\"type \", String::concat(name, String::concat(\" = \", print_type_expr(ty))))),\n    STrait(exported, name, supers) => {\n      let base = String::concat(prefix(exported), String::concat(\"trait \", name))\n      if eq(Array::length(supers), 0) {\n        base\n      }\n      else String::concat(base, String::concat(\": \", join(supers, \" + \")))\n    },\n    SImpl(tparams, _, trait_name, type_name) => {\n      let base = String::concat(\"impl \", String::concat(trait_name, String::concat(\" for \", type_name)))\n      if eq(Array::length(tparams), 0) {\n        base\n      }\n      else String::concat(\"[\", String::concat(join(tparams, \", \"), String::concat(\"] \", base)))\n    },\n    SExternLet(name, ty) => String::concat(\"extern let \", String::concat(name, String::concat(\": \", print_type_expr(ty)))),\n    SImport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"import \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    STest(name, body) => String::concat(\"test \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SBench(name, body) => String::concat(\"bench \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SExpr(e) => print_expr(e),\n    SExport(names) => String::concat(\"export { \", String::concat(join(names, \", \"), \" }\")),\n    SReExport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"export \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    SAliasDecl(alias_name, source_path) => String::concat(\"import \", String::concat(source_path, String::concat(\" @\", alias_name))),\n    SLetPat(pat, expr) => String::concat(\"let \", String::concat(print_pat(pat), String::concat(\" = \", print_expr(expr)))),\n    SModule(exported, name, stmts) => {\n      let parts = for s in stmts {\n        print_stmt(s)\n      }\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      String::concat(p, String::concat(\"module \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"\\n\"), \" }\")))))\n    },\n    SEffectDef(exported, name, type_params, ops) => {\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      let tp = if Array::length(type_params) > 0 {\n        String::concat(\"[\", String::concat(join(type_params, \", \"), \"]\"))\n      } else \"\"\n      let op_parts = for op in ops {\n        let (op_name, params, ret) = op\n        let params_str = if Array::length(params) > 0 {\n          String::concat(\"(\", String::concat(join(for pt in params {\n            print_type_expr(pt)\n          }, \", \"), \")\"))\n        } else \"\"\n        String::concat(\"  \", String::concat(op_name, String::concat(params_str, String::concat(\" -> \", print_type_expr(ret)))))\n      }\n      String::concat(p, String::concat(\"effect \", String::concat(name, String::concat(tp, String::concat(\" {\\n\", String::concat(join(op_parts, \";\\n\"), \"\\n}\"))))))\n    }\n  }\n}\n\nlet needs_program_separator = (stmt_text: String) -> Bool {\n  if String::length(stmt_text) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(stmt_text, 0)\n    c == '(' || c == '['\n  }\n}\n\nexport let print_program = (stmts: Array[Stmt]) -> String {\n  let len = Array::length(stmts)\n  let mut out = \"\"\n  let mut i = 0\n  while i < len {\n    let stmt_text = print_stmt(Array::get(stmts, i))\n    if i > 0 {\n      let sep = if needs_program_separator(stmt_text) {\n        \";\\n\"\n      } else \"\\n\"\n      out = String::concat(out, sep)\n    }\n    out = String::concat(out, stmt_text)\n    i = i + 1\n  }\n  out\n}\n")

  let source_15 = ("vibe/compiler/syntax/index.vibe",
"\n\n\n\n\n\n\n\nexport let version = \"0.1.0\"\n")

  let source_16 = ("vibe/compiler/token.vibe",
"\n\n\nexport {\n  Token, token_to_string\n}\n")

  let source_17 = ("vibe/compiler/types.vibe",
"\n\n\nexport {\n  Type, Subst, unify, TypeDef, TypeEnv, env_bind, fresh_var, occurs_in, env_lookup, generalize, instantiate, subst_apply, types_equal, env_bind_all, env_cache, find_typedef, subst_lookup, trait_supers, collect_tvars, trait_defined, type_to_string, env_lookup_flat, resolve_builtin, subst_add_bound, types_compatible, env_flat_bindings, impls_overlap_for, trait_is_subtrait, type_implements_trait\n}\n\nexport {\n  Type, Subst, unify, TypeDef, TypeEnv, env_bind, env_cache, fresh_var, occurs_in, env_lookup, generalize, instantiate, subst_apply, types_equal, env_bind_all, find_typedef, subst_lookup, trait_supers, collect_tvars, trait_defined, type_to_string, env_lookup_flat, resolve_builtin, subst_add_bound, types_compatible, env_flat_bindings, impls_overlap_for, trait_is_subtrait, type_implements_trait\n}\n")

  let source_18 = ("vibe/compiler/lexer.vibe",
"\n\n\nexport {\n  lex, lex_ok\n}\n")

  let source_19 = ("vibe/compiler/parser.vibe",
"\n\n\n\n\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n")

  let source_20 = ("vibe/compiler/printer.vibe",
"\n\n\nexport {\n  print_pat, print_expr, print_stmt, print_program, print_type_expr\n}\n")

  let source_21 = ("vibe/compiler/checker/builtins.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nexport let lookup_builtin = (name: String) -> Option[Type] {\n  let normalized = canonical_builtin_name(name)\n  match lookup_array(normalized) {\n    Some(t) => Some(t),\n    None => match lookup_fixed_array(normalized) {\n      Some(t) => Some(t),\n      None => match lookup_array_builder(normalized) {\n        Some(t) => Some(t),\n        None => match lookup_string1(normalized) {\n          Some(t) => Some(t),\n          None => match lookup_string2(normalized) {\n            Some(t) => Some(t),\n            None => match lookup_string_builder(normalized) {\n              Some(t) => Some(t),\n              None => match lookup_bytes(normalized) {\n                Some(t) => Some(t),\n                None => match lookup_map(normalized) {\n                  Some(t) => Some(t),\n                  None => match lookup_io(normalized) {\n                    Some(t) => Some(t),\n                    None => match lookup_fs(normalized) {\n                      Some(t) => Some(t),\n                      None => match lookup_net(normalized) {\n                        Some(t) => Some(t),\n                        None => lookup_misc(normalized)\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n")

  let source_22 = ("vibe/compiler/checker/builtins_fs.vibe",
"\n\n\nlet no_params = () -> Array[Type] {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet one_param = (a: Type) -> Array[Type] {\n  let arr = no_params()\n  Array::push(arr, a)\n  arr\n}\n\nlet two_params = (a: Type, b: Type) -> Array[Type] {\n  let arr = no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nlet lookup_fs_copy = (name: String) -> Option[Type] {\n  if name == \"Fs::copy\" {\n    Some(CtFn(two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_chdir = (name: String) -> Option[Type] {\n  if name == \"Fs::chdir\" {\n    Some(CtFn(one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_mkdir = (name: String) -> Option[Type] {\n  if name == \"Fs::mkdir\" {\n    Some(CtFn(one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_append = (name: String) -> Option[Type] {\n  if name == \"Fs::append\" {\n    Some(CtFn(two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_exists = (name: String) -> Option[Type] {\n  if name == \"Fs::exists\" {\n    Some(CtFn(one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_getcwd = (name: String) -> Option[Type] {\n  if name == \"Fs::getcwd\" {\n    Some(CtFn(no_params(), CtString, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_is_dir = (name: String) -> Option[Type] {\n  if name == \"Fs::is_dir\" {\n    Some(CtFn(one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_remove = (name: String) -> Option[Type] {\n  if name == \"Fs::remove\" {\n    Some(CtFn(one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_d = (name: String) -> Option[Type] {\n  match lookup_fs_remove(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_copy(name) {\n      Some(t) => Some(t),\n      None => lookup_fs_append(name)\n    }\n  }\n}\n\nlet lookup_fs_is_file = (name: String) -> Option[Type] {\n  if name == \"Fs::is_file\" {\n    Some(CtFn(one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_c = (name: String) -> Option[Type] {\n  match lookup_fs_is_file(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_mkdir(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_getcwd(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_chdir(name)\n      }\n    }\n  }\n}\n\nlet lookup_fs_readdir = (name: String) -> Option[Type] {\n  if name == \"Fs::readdir\" {\n    Some(CtFn(one_param(CtString), CtArray(CtString), Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_read_file = (name: String) -> Option[Type] {\n  if name == \"Fs::read_file\" {\n    Some(CtFn(one_param(CtString), CtString, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_read_bytes = (name: String) -> Option[Type] {\n  if name == \"Fs::read_bytes\" {\n    Some(CtFn(one_param(CtString), CtBytes, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_stat_token = (name: String) -> Option[Type] {\n  if name == \"Fs::stat_token\" {\n    Some(CtFn(one_param(CtString), CtInt, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_b = (name: String) -> Option[Type] {\n  match lookup_fs_exists(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_stat_token(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_readdir(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_is_dir(name)\n      }\n    }\n  }\n}\n\nlet lookup_fs_write_file = (name: String) -> Option[Type] {\n  if name == \"Fs::write_file\" {\n    Some(CtFn(two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_write_bytes = (name: String) -> Option[Type] {\n  if name == \"Fs::write_bytes\" {\n    Some(CtFn(two_params(CtString, CtBytes), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_a = (name: String) -> Option[Type] {\n  match lookup_fs_read_file(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_write_file(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_read_bytes(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_write_bytes(name)\n      }\n    }\n  }\n}\n\nexport let lookup_fs = (name: String) -> Option[Type] {\n  match lookup_fs_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_group_c(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_group_d(name)\n      }\n    }\n  }\n}\n")

  let source_23 = ("vibe/compiler/checker/builtins_system.vibe",
