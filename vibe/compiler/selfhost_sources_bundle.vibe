buf_push2(buf, op_block, bt_void)\\n}\\n\\nexport let emit_i32_store8 = (buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store8, align, offset)\\n}\\n\\nexport let emit_struct_get = (buf: Bytes, type_idx: Int, field_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, 251, 2, type_idx)\\n  leb128_encode_u32(buf, field_idx)\\n}\\n\\nexport let emit_struct_new = (buf: Bytes, type_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, 251, 0, type_idx)\\n}\\n\\nexport let emit_struct_set = (buf: Bytes, type_idx: Int, field_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, 251, 5, type_idx)\\n  leb128_encode_u32(buf, field_idx)\\n}\\n\\nlet op_i32_wrap_i64 = 167\\n\\nexport let emit_i32_load8_u = (buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load8_u, align, offset)\\n}\\n\\nlet op_call_indirect = 17\\n\\nexport let emit_i32_wrap_i64 = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_wrap_i64)\\n}\\n\\nexport let emit_call_indirect = (buf: Bytes, type_idx: Int) -> Unit {\\n  bytebuf_push_opcode_u32(buf, op_call_indirect, type_idx)\\n  bytebuf_push(buf, 0)\\n}\\n\\nlet op_i64_trunc_f64_s = 176\\n\\nexport let emit_f64_const_bits = (buf: Bytes, bits: Int) -> Unit {\\n  bytebuf_push9(buf, 68, bits&255, (bits>>8)&255, (bits>>16)&255, (bits>>24)&255, (bits>>32)&255, (bits>>40)&255, (bits>>48)&255, (bits>>56)&255)\\n}\\n\\nlet op_i64_extend_i32_s = 172\\n\\nexport let emit_i64_trunc_f64_s = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_trunc_f64_s)\\n}\\n\\nexport let emit_struct_type_raw = (buf: Bytes, field_types: Array[Int], field_muts: Array[Int]) -> Unit {\\n  bytebuf_push_opcode_u32(buf, 95, Array::length(field_types))\\n  let mut i = 0\\n  while i < Array::length(field_types) {\\n    bytebuf_push2(buf, Array::get(field_types, i), Array::get(field_muts, i))\\n    i = i + 1\\n  }\\n}\\n\\nlet op_f64_convert_i64_s = 185\\n\\nexport let emit_i64_extend_i32_s = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_extend_i32_s)\\n}\\n\\nexport let emit_f64_convert_i64_s = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_convert_i64_s)\\n}\\n\\nlet op_f64_reinterpret_i64 = 191\\n\\nlet op_i64_reinterpret_f64 = 189\\n\\nexport let emit_f64_reinterpret_i64 = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_f64_reinterpret_i64)\\n}\\n\\nexport let emit_i64_reinterpret_f64 = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_reinterpret_f64)\\n}\\n\\nexport let emit_table_section_funcref = (out: Bytes, num_entries: Int) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push2(content, type_funcref, 0)\\n  leb128_encode_u32(content, num_entries)\\n  bytebuf_push_section(out, sec_table, content)\\n}\\n\\nexport let emit_element_section_active = (out: Bytes, func_indices: Array[Int]) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  emit_i32_const(content, 0)\\n  emit_end(content)\\n  leb128_encode_u32(content, Array::length(func_indices))\\n  let mut i = 0\\n  while i < Array::length(func_indices) {\\n    leb128_encode_u32(content, Array::get(func_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, sec_element, content)\\n}\\n\\n\\n\\n\\n\\nlet vt_i32 = 127\\n\\nlet sec_data = 11\\n\\nlet sec_type = 1\\n\\nexport let string_to_data = (s: String) -> Bytes {\\n  let buf = bytebuf_new()\\n  let len = String::length(s)\\n  let mut i = 0\\n  while i < len {\\n    bytebuf_push(buf, String::char_code_at(s, i))\\n    i = i + 1\\n  }\\n  buf\\n}\\n\\nlet empty_int_array = () -> Array[Int] {\\n  Array::slice([\\n    0\\n  ], 0, 0)\\n}\\n\\nlet pair_int_array = (v0: Int, v1: Int) -> Array[Int] {\\n  let values = empty_int_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  values\\n}\\n\\nlet quad_int_array = (v0: Int, v1: Int, v2: Int, v3: Int) -> Array[Int] {\\n  let values = empty_int_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  Array::push(values, v2)\\n  Array::push(values, v3)\\n  values\\n}\\n\\nlet triple_int_array = (v0: Int, v1: Int, v2: Int) -> Array[Int] {\\n  let values = empty_int_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  Array::push(values, v2)\\n  values\\n}\\n\\nlet empty_bytes_array = () -> Array[Bytes] {\\n  Array::slice([\\n    bytebuf_new()\\n  ], 0, 0)\\n}\\n\\nlet pair_bytes_array = (v0: Bytes, v1: Bytes) -> Array[Bytes] {\\n  let values = empty_bytes_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  values\\n}\\n\\nlet empty_string_array = () -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet pair_string_array = (v0: String, v1: String) -> Array[String] {\\n  let values = empty_string_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  values\\n}\\n\\nexport let build_call_module = () -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section_multi(out, quad_int_array(1, 1, 2, 1))\\n  emit_function_section(out, pair_int_array(0, 1))\\n  emit_export_section_multi(out, pair_string_array(\\\"square\\\", \\\"sum_sq\\\"), pair_int_array(0, 1))\\n  let sq_body = bytebuf_new()\\n  emit_local_get(sq_body, 0)\\n  emit_local_get(sq_body, 0)\\n  emit_i64_mul(sq_body)\\n  let ss_body = bytebuf_new()\\n  emit_local_get(ss_body, 0)\\n  emit_call(ss_body, 0)\\n  emit_local_get(ss_body, 1)\\n  emit_call(ss_body, 0)\\n  emit_i64_add(ss_body)\\n  emit_code_section(out, pair_bytes_array(sq_body, ss_body))\\n  bytebuf_to_bytes(out)\\n}\\n\\nlet triple_bytes_array = (v0: Bytes, v1: Bytes, v2: Bytes) -> Array[Bytes] {\\n  let values = empty_bytes_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  Array::push(values, v2)\\n  values\\n}\\n\\nlet singleton_int_array = (v0: Int) -> Array[Int] {\\n  let values = empty_int_array()\\n  Array::push(values, v0)\\n  values\\n}\\n\\nlet triple_string_array = (v0: String, v1: String, v2: String) -> Array[String] {\\n  let values = empty_string_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  Array::push(values, v2)\\n  values\\n}\\n\\nlet singleton_bytes_array = (v0: Bytes) -> Array[Bytes] {\\n  let values = empty_bytes_array()\\n  Array::push(values, v0)\\n  values\\n}\\n\\nexport let build_add_module = () -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 2, 1)\\n  emit_function_section(out, singleton_int_array(0))\\n  emit_export_section(out, \\\"add\\\", 0)\\n  let body = bytebuf_new()\\n  emit_local_get(body, 0)\\n  emit_local_get(body, 1)\\n  emit_i64_add(body)\\n  emit_code_section(out, singleton_bytes_array(body))\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let build_factorial_module = () -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 1, 1)\\n  emit_function_section(out, singleton_int_array(0))\\n  emit_export_section(out, \\\"fact\\\", 0)\\n  let b = bytebuf_new()\\n  emit_i64_const(b, 1)\\n  emit_local_set(b, 1)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 1)\\n  emit_i64_le_s(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 0)\\n  emit_i64_mul(b)\\n  emit_local_set(b, 1)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 1)\\n  emit_i64_sub(b)\\n  emit_local_set(b, 0)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_local_get(b, 1)\\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(1))\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let build_fibonacci_module = () -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 1, 1)\\n  emit_function_section(out, singleton_int_array(0))\\n  emit_export_section(out, \\\"fib\\\", 0)\\n  let b = bytebuf_new()\\n  emit_i64_const(b, 0)\\n  emit_local_set(b, 1)\\n  emit_i64_const(b, 1)\\n  emit_local_set(b, 2)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 0)\\n  emit_i64_le_s(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 2)\\n  emit_i64_add(b)\\n  emit_local_set(b, 3)\\n  emit_local_get(b, 2)\\n  emit_local_set(b, 1)\\n  emit_local_get(b, 3)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 1)\\n  emit_i64_sub(b)\\n  emit_local_set(b, 0)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_local_get(b, 1)\\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(3))\\n  bytebuf_to_bytes(out)\\n}\\n\\nlet singleton_string_array = (v0: String) -> Array[String] {\\n  let values = empty_string_array()\\n  Array::push(values, v0)\\n  values\\n}\\n\\nexport let build_hello_module = () -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let type_content = bytebuf_new()\\n  bytebuf_push_vec_header(type_content, 2)\\n  emit_func_type_raw(type_content, quad_int_array(vt_i32, vt_i32, vt_i32, vt_i32), singleton_int_array(vt_i32))\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  bytebuf_push_section(out, sec_type, type_content)\\n  emit_import_section_func(out, \\\"wasi_snapshot_preview1\\\", \\\"fd_write\\\", 0)\\n  emit_function_section(out, singleton_int_array(1))\\n  emit_memory_section(out, 1)\\n  emit_exports_with_memory(out, singleton_string_array(\\\"_start\\\"), singleton_int_array(1), \\\"memory\\\", 0)\\n  let b = bytebuf_new()\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 8)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 4)\\n  emit_i32_const(b, 12)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 100)\\n  emit_call(b, 0)\\n  emit_drop(b)\\n  emit_code_section(out, singleton_bytes_array(b))\\n  let hello_data = bytebuf_new()\\n  bytebuf_push(hello_data, 104)\\n  bytebuf_push(hello_data, 101)\\n  bytebuf_push(hello_data, 108)\\n  bytebuf_push(hello_data, 108)\\n  bytebuf_push(hello_data, 111)\\n  bytebuf_push(hello_data, 32)\\n  bytebuf_push(hello_data, 119)\\n  bytebuf_push(hello_data, 111)\\n  bytebuf_push(hello_data, 114)\\n  bytebuf_push(hello_data, 108)\\n  bytebuf_push(hello_data, 100)\\n  bytebuf_push(hello_data, 10)\\n  emit_data_section(out, 8, hello_data)\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let build_arithmetic_module = () -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 2, 1)\\n  emit_function_section(out, triple_int_array(0, 0, 0))\\n  emit_export_section_multi(out, triple_string_array(\\\"add\\\", \\\"sub\\\", \\\"mul\\\"), triple_int_array(0, 1, 2))\\n  let add_body = bytebuf_new()\\n  emit_local_get(add_body, 0)\\n  emit_local_get(add_body, 1)\\n  emit_i64_add(add_body)\\n  let sub_body = bytebuf_new()\\n  emit_local_get(sub_body, 0)\\n  emit_local_get(sub_body, 1)\\n  emit_i64_sub(sub_body)\\n  let mul_body = bytebuf_new()\\n  emit_local_get(mul_body, 0)\\n  emit_local_get(mul_body, 1)\\n  emit_i64_mul(mul_body)\\n  emit_code_section(out, triple_bytes_array(add_body, sub_body, mul_body))\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let emit_data_section_multi = (out: Bytes, offsets: Array[Int], datas: Array[Bytes]) -> Unit {\\n  let count = Array::length(offsets)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    bytebuf_push(content, 0)\\n    emit_i32_const(content, Array::get(offsets, i))\\n    emit_end(content)\\n    let data = Array::get(datas, i)\\n    leb128_encode_u32(content, Bytes::length(data))\\n    bytebuf_push_buf(content, data)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, sec_data, content)\\n}\\n\\nexport let build_print_string_module = (msg: String) -> Bytes {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let type_content = bytebuf_new()\\n  bytebuf_push_vec_header(type_content, 2)\\n  emit_func_type_raw(type_content, quad_int_array(vt_i32, vt_i32, vt_i32, vt_i32), singleton_int_array(vt_i32))\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  bytebuf_push_section(out, sec_type, type_content)\\n  emit_import_section_func(out, \\\"wasi_snapshot_preview1\\\", \\\"fd_write\\\", 0)\\n  emit_function_section(out, singleton_int_array(1))\\n  emit_memory_section(out, 1)\\n  emit_exports_with_memory(out, singleton_string_array(\\\"_start\\\"), singleton_int_array(1), \\\"memory\\\", 0)\\n  let str_data = string_to_data(msg)\\n  let str_len = Bytes::length(str_data)\\n  let b = bytebuf_new()\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 16)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 4)\\n  emit_i32_const(b, str_len)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 8)\\n  emit_call(b, 0)\\n  emit_drop(b)\\n  emit_code_section(out, singleton_bytes_array(b))\\n  emit_data_section(out, 16, str_data)\\n  bytebuf_to_bytes(out)\\n}\\n\\n\\n\\n\\n\\n\\n\\nlet op_prefix = 252\\n\\n\\nexport let get_ebinop_lhs = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EBinOp(_, lhs, _) => lhs,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport let get_ebinop_rhs = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EBinOp(_, _, rhs) => rhs,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport let get_ecall_args = (expr: Expr) -> Array[Expr] with { Error } {\\n  match expr {\\n    ECall(_, args) => args,\\n    _ => throw(\\\"not ECall\\\")\\n  }\\n}\\n\\nexport let get_efn_params = (expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\\n  match expr {\\n    EFn(_, _, params, _, _, _) => params,\\n    _ => throw(\\\"not EFn\\\")\\n  }\\n}\\n\\nexport let get_eint_value = (expr: Expr) -> Int with { Error } {\\n  match expr {\\n    EInt(n) => n,\\n    _ => throw(\\\"not EInt\\\")\\n  }\\n}\\n\\nexport let get_eseq_first = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ESeq(first, _) => first,\\n    _ => throw(\\\"not ESeq\\\")\\n  }\\n}\\n\\nexport let get_match_arms = (expr: Expr) -> Array[(Pat, Expr)] with { Error } {\\n  match expr {\\n    EMatch(_, arms) => arms,\\n    _ => throw(\\\"get_match_arms: not an EMatch\\\")\\n  }\\n}\\n\\nexport let get_pbind_name = (p: Pat) -> String with { Error } {\\n  match p {\\n    PBind(name) => name,\\n    _ => throw(\\\"get_pbind_name: not a PBind\\\")\\n  }\\n}\\n\\nexport let get_pctor_args = (p: Pat) -> Array[Pat] with { Error } {\\n  match p {\\n    PCtor(_, args) => args,\\n    _ => throw(\\\"get_pctor_args: not a PCtor\\\")\\n  }\\n}\\n\\nexport let get_pctor_name = (p: Pat) -> String with { Error } {\\n  match p {\\n    PCtor(name, _) => name,\\n    _ => throw(\\\"get_pctor_name: not a PCtor\\\")\\n  }\\n}\\n\\nexport let get_pint_value = (p: Pat) -> Int with { Error } {\\n  match p {\\n    PInt(n) => n,\\n    _ => throw(\\\"get_pint_value: not a PInt\\\")\\n  }\\n}\\n\\nexport let get_eassign_val = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EAssign(_, val, _) => val,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport let get_ebool_value = (expr: Expr) -> Bool with { Error } {\\n  match expr {\\n    EBool(b) => b,\\n    _ => throw(\\\"not EBool\\\")\\n  }\\n}\\n\\nexport let get_eforin_body = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EForIn(_, _, _, body) => body,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport let get_eforin_iter = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EForIn(_, _, iter, _) => iter,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport let get_eforin_name = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    EForIn(name, _, _, _) => name,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport let get_eident_name = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    EIdent(name) => name,\\n    _ => throw(\\\"not EIdent\\\")\\n  }\\n}\\n\\nexport let get_eletmut_val = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELetMut(_, val, _) => val,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport let get_eletrec_val = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELetRec(_, val, _) => val,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\nexport let get_eseq_second = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ESeq(_, second) => second,\\n    _ => throw(\\\"not ESeq\\\")\\n  }\\n}\\n\\nexport let get_ethrow_expr = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EThrow(e) => e,\\n    _ => throw(\\\"not EThrow\\\")\\n  }\\n}\\n\\nexport let get_eunaryop_op = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    EUnaryOp(op, _) => op,\\n    _ => throw(\\\"not EUnaryOp\\\")\\n  }\\n}\\n\\nexport let get_ewhile_body = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EWhile(_, body) => body,\\n    _ => throw(\\\"not EWhile\\\")\\n  }\\n}\\n\\nexport let get_ewhile_cond = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EWhile(cond, _) => cond,\\n    _ => throw(\\\"not EWhile\\\")\\n  }\\n}\\n\\nexport let get_pbool_value = (p: Pat) -> Bool with { Error } {\\n  match p {\\n    PBool(v) => v,\\n    _ => throw(\\\"get_pbool_value: not a PBool\\\")\\n  }\\n}\\n\\nexport let get_ptuple_pats = (p: Pat) -> Array[Pat] with { Error } {\\n  match p {\\n    PTuple(pats) => pats,\\n    _ => throw(\\\"get_ptuple_pats: not a PTuple\\\")\\n  }\\n}\\n\\nexport let get_slet_export = (stmt: Stmt) -> Bool with { Error } {\\n  match stmt {\\n    SLet(is_export, _, _, _, _) => is_export,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\nexport let rec is_catchall_pat = (p: Pat) -> Bool {\\n  match p {\\n    PWild => true,\\n    PBind(_) => true,\\n    PTuple(pats) => {\\n      let mut i = 0\\n      let mut all_catch = true\\n      while i < Array::length(pats) {\\n        if !is_catchall_pat(Array::get(pats, i)) {\\n          all_catch = false\\n        }\\n        i = i + 1\\n      }\\n      all_catch\\n    },\\n    _ => false\\n  }\\n}\\n\\nexport let emit_assignop_op = (buf: Bytes, op: String) -> Unit with { Error } {\\n  if op == \\\"+\\\" {\\n    emit_i64_add(buf)\\n  }\\n  else if op == \\\"-\\\" {\\n    emit_i64_sub(buf)\\n  }\\n  else if op == \\\"*\\\" {\\n    emit_i64_mul(buf)\\n  }\\n  else if op == \\\"/\\\" {\\n    emit_i64_div_s(buf)\\n  }\\n  else if op == \\\"%\\\" {\\n    emit_i64_rem_s(buf)\\n  }\\n  else {\\n    throw(String::concat(\\\"unsupported assign op: \\\", op))\\n  }\\n}\\n\\nexport let emit_memory_copy = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_prefix)\\n  leb128_encode_u32(buf, 10)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n}\\n\\nexport let get_earray_elems = (expr: Expr) -> Array[Expr] with { Error } {\\n  match expr {\\n    EArray(elems) => elems,\\n    _ => throw(\\\"not EArray\\\")\\n  }\\n}\\n\\nexport let get_eassign_body = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EAssign(_, _, body) => body,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport let get_eassign_name = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    EAssign(name, _, _) => name,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport let get_eassignop_op = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    EAssignOp(_, op, _, _) => op,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport let get_ecall_callee = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ECall(callee, _) => callee,\\n    _ => throw(\\\"not ECall\\\")\\n  }\\n}\\n\\nexport let get_efloat_value = (expr: Expr) -> Double with { Error } {\\n  match expr {\\n    EFloat(v) => v,\\n    _ => throw(\\\"not EFloat\\\")\\n  }\\n}\\n\\nexport let get_eletmut_body = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELetMut(_, _, body) => body,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport let get_eletmut_name = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    ELetMut(name, _, _) => name,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport let get_eletrec_body = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELetRec(_, _, body) => body,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\nexport let get_eletrec_name = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    ELetRec(name, _, _) => name,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\nexport let get_etuple_elems = (expr: Expr) -> Array[Expr] with { Error } {\\n  match expr {\\n    ETuple(elems) => elems,\\n    _ => throw(\\\"get_etuple_elems: not an ETuple\\\")\\n  }\\n}\\n\\nexport let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {\\n  let len = Array::length(strs)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    if Array::get(strs, i) == s {\\n      found = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"string not in table: \\\", s))\\n  }\\n  found\\n}\\n\\nexport let find_catchall_idx = (arms: Array[(Pat, Expr)]) -> Int {\\n  let num = Array::length(arms)\\n  let mut idx = 0\\n  let mut result = num\\n  while idx < num {\\n    let (p, _) = Array::get(arms, idx)\\n    if is_catchall_pat(p) {\\n      result = idx\\n      idx = num\\n    } else {\\n      idx = idx + 1\\n    }\\n  }\\n  result\\n}\\n\\nexport let get_eassignop_val = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EAssignOp(_, _, val, _) => val,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport let get_estring_value = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    EString(s) => s,\\n    _ => throw(\\\"not EString\\\")\\n  }\\n}\\n\\nexport let get_eunaryop_expr = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EUnaryOp(_, e) => e,\\n    _ => throw(\\\"not EUnaryOp\\\")\\n  }\\n}\\n\\nexport let get_pstring_value = (p: Pat) -> String with { Error } {\\n  match p {\\n    PString(s) => s,\\n    _ => throw(\\\"get_pstring_value: not a PString\\\")\\n  }\\n}\\n\\nexport let array_contains_str = (arr: Array[String], s: String) -> Bool {\\n  let len = Array::length(arr)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len {\\n    if Array::get(arr, i) == s {\\n      found = true\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nexport let get_eassignop_body = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EAssignOp(_, _, _, body) => body,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport let get_eassignop_name = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    EAssignOp(name, _, _, _) => name,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport let get_match_scrutinee = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EMatch(scrutinee, _) => scrutinee,\\n    _ => throw(\\\"get_match_scrutinee: not an EMatch\\\")\\n  }\\n}\\n\\n\\n\\n\\nlet op_i64_extend_i32_u = 173\\n\\n\\n\\nexport let rec collect_strings_expr = (expr: Expr, out: Array[String]) -> Int {\\n  match expr {\\n    EString(s) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(out) {\\n        if Array::get(out, i) == s {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      if !found {\\n        Array::push(out, s)\\n      }\\n      0\\n    },\\n    EBinOp(_, lhs, rhs) => {\\n      collect_strings_expr(lhs, out)\\n      collect_strings_expr(rhs, out)\\n    },\\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\\n    EIf(cond, then_e, else_e) => {\\n      collect_strings_expr(cond, out)\\n      collect_strings_expr(then_e, out)\\n      collect_strings_expr(else_e, out)\\n    },\\n    ECall(callee, args) => {\\n      collect_strings_expr(callee, out)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_strings_expr(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELet(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ELetRec(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ELetMut(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EAssign(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EAssignOp(_, _, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ESeq(first, second) => {\\n      collect_strings_expr(first, out)\\n      collect_strings_expr(second, out)\\n    },\\n    EWhile(cond, body) => {\\n      collect_strings_expr(cond, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EForIn(_, _, iter_e, body) => {\\n      collect_strings_expr(iter_e, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ETuple(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_strings_expr(Array::get(elems, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_strings_expr(Array::get(elems, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMatch(scrutinee, arms) => {\\n      collect_strings_expr(scrutinee, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, arm_expr) = Array::get(arms, i)\\n        match pat {\\n          PString(s) => {\\n            let mut pf = false\\n            let mut pi = 0\\n            while pi < Array::length(out) {\\n              if Array::get(out, pi) == s {\\n                pf = true\\n              }\\n              pi = pi + 1\\n            }\\n            if !pf {\\n              Array::push(out, s)\\n            }\\n            0\\n          },\\n          _ => 0\\n        }\\n        collect_strings_expr(arm_expr, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\\n    EThrow(msg) => collect_strings_expr(msg, out),\\n    EStringInterp(parts) => {\\n      let mut si_p = 0\\n      while si_p < Array::length(parts) {\\n        if si_p % 2 == 0 {\\n          let part = Array::get(parts, si_p)\\n          if String::length(part) > 0 {\\n            let mut found = false\\n            let mut fi2 = 0\\n            while fi2 < Array::length(out) {\\n              if Array::get(out, fi2) == part { found = true }\\n              fi2 = fi2 + 1\\n            }\\n            if !found { Array::push(out, part) }\\n          }\\n        }\\n        si_p = si_p + 1\\n      }\\n      0\\n    },\\n    EHandle(body, arms) => {\\n      collect_strings_expr(body, out)\\n      let mut hi = 0\\n      while hi < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, hi)\\n        collect_strings_expr(arm_expr, out)\\n        hi = hi + 1\\n      }\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut mi = 0\\n      while mi < Array::length(fields) {\\n        let (key, val) = Array::get(fields, mi)\\n        let mut kf = false\\n        let mut ki = 0\\n        while ki < Array::length(out) {\\n          if Array::get(out, ki) == key { kf = true }\\n          ki = ki + 1\\n        }\\n        if !kf { Array::push(out, key) }\\n        collect_strings_expr(val, out)\\n        mi = mi + 1\\n      }\\n      0\\n    },\\n    ERecord(fields) => {\\n      let mut ri = 0\\n      while ri < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, ri)\\n        collect_strings_expr(fval, out)\\n        ri = ri + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _) => collect_strings_expr(obj, out),\\n    ELabeledArg(_, _, val) => collect_strings_expr(val, out),\\n    _ => 0\\n  }\\n}\\n\\nexport let get_func_param_names = (stmt: Stmt) -> Array[String] with { Error } {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => match expr {\\n      EFn(_, _, params, _, _, _) => {\\n        let names = Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(params) {\\n          let (pname, _) = Array::get(params, i)\\n          let plen2 = String::length(pname)\\n          let clean_name = if plen2 > 0 {\\n            let last_char = String::char_code_at(pname, plen2 - 1)\\n            if last_char == '~' || last_char == '?' {\\n              pname[0:plen2 - 1]\\n            } else pname\\n          } else pname\\n          Array::push(names, clean_name)\\n          i = i + 1\\n        }\\n        names\\n      },\\n      _ => throw(\\\"get_func_param_names: not a function\\\")\\n    },\\n    _ => throw(\\\"get_func_param_names: not a let statement\\\")\\n  }\\n}\\n\\nexport let collect_strings_stmts = (stmts: Array[Stmt]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let emit_i64_extend_i32_u = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i64_extend_i32_u)\\n}\\n\\nexport let emit_closure_resolve = (buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, 3)\\n  emit_i64_and(buf)\\n  emit_i64_const(buf, 2)\\n  emit_i64_eq(buf)\\n  emit_if_void(buf)\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, 2)\\n  emit_i64_shr_s(buf)\\n  emit_local_set(buf, slot_local)\\n  emit_i64_const(buf, 0)\\n  emit_local_set(buf, env_local)\\n  emit_else(buf)\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, -4)\\n  emit_i64_and(buf)\\n  emit_local_set(buf, env_local)\\n  emit_local_get(buf, env_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i64_extend_i32_u(buf)\\n  emit_local_set(buf, slot_local)\\n  emit_end(buf)\\n}\\n\\nexport let emit_closure_call_tail = (buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\\n  emit_local_get(buf, env_local)\\n  emit_local_get(buf, slot_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_call_indirect(buf, closure_type_base + num_args)\\n}\\n\\nlet rec collect_pattern_bindings = (pat: Pat, bindings: Array[String]) -> Int {\\n  match pat {\\n    PBind(name) => {\\n      Array::push(bindings, name); 0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        collect_pattern_bindings(Array::get(pats, i), bindings)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PCtor(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_pattern_bindings(Array::get(args, i), bindings)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(l, r) => {\\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\\n    },\\n    _ => 0\\n  }\\n}\\n\\nexport let rec collect_free_vars_expr = (expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\\n  match expr {\\n    EIdent(name) => if array_contains_str(bound, name) {\\n      0\\n    }\\n    else if array_contains_str(fn_names, name) {\\n      0\\n    }\\n    else if array_contains_str(out, name) {\\n      0\\n    }\\n    else {\\n      Array::push(out, name)\\n      0\\n    },\\n    EInt(_) => 0,\\n    EBool(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EUnit => 0,\\n    EBinOp(_, lhs, rhs) => {\\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\\n    },\\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\\n    EIf(cond, then_e, else_e) => {\\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\\n    },\\n    ECall(callee, args) => {\\n      collect_free_vars_expr(callee, bound, fn_names, out)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELet(name, value, body) => {\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ELetRec(name, value, body) => {\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ELetMut(name, value, body) => {\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    EAssign(_, value, body) => {\\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    EAssignOp(_, _, value, body) => {\\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    ESeq(first, second) => {\\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\\n    },\\n    EWhile(cond, body) => {\\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    EForIn(var_name, index_name, iter_e, body) => {\\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, var_name)\\n      match index_name {\\n        Some(index_name) => Array::push(bound, index_name),\\n        None => ()\\n      }\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ETuple(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMatch(scrutinee, arms) => {\\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (arm_pat, arm_expr) = Array::get(arms, i)\\n        let saved = Array::length(bound)\\n        collect_pattern_bindings(arm_pat, bound)\\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\\n        Array::truncate(bound, saved)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EFn(_, _, params, _, _, body) => {\\n      let saved = Array::length(bound)\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pname_raw, _) = Array::get(params, pi)\\n        let pnl = String::length(pname_raw)\\n        let pname = if pnl > 0 {\\n          let plc = String::char_code_at(pname_raw, pnl - 1)\\n          if plc == '~' || plc == '?' { pname_raw[0:pnl - 1] } else pname_raw\\n        } else pname_raw\\n        Array::push(bound, pname)\\n        pi = pi + 1\\n      }\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    EBreak(_) => 0,\\n    EContinue(_) => 0,\\n    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\\n    EHandle(body, arms) => {\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      let mut hi = 0\\n      while hi < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, hi)\\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\\n        hi = hi + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _) => collect_free_vars_expr(obj, bound, fn_names, out),\\n    ERecord(fields) => {\\n      let mut ri = 0\\n      while ri < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, ri)\\n        collect_free_vars_expr(fval, bound, fn_names, out)\\n        ri = ri + 1\\n      }\\n      0\\n    },\\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\\n    _ => 0\\n  }\\n}\\n\\nexport let collect_free_vars = (body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\\n  collect_free_vars_expr(body, bound, fn_names, out)\\n  out\\n}\\n\\nexport let rec is_mut_captured_in = (expr: Expr, name: String) -> Bool {\\n  match expr {\\n    EIdent(_) => false,\\n    EInt(_) => false,\\n    EBool(_) => false,\\n    EFloat(_) => false,\\n    EString(_) => false,\\n    EUnit => false,\\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\\n    ECall(callee, args) => if is_mut_captured_in(callee, name) {\\n      true\\n    }\\n    else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if is_mut_captured_in(Array::get(args, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELet(n, value, body) => if n == name {\\n      is_mut_captured_in(value, name)\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    ELetRec(n, value, body) => if n == name {\\n      false\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    ELetMut(n, value, body) => if n == name {\\n      is_mut_captured_in(value, name)\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\\n    ETuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if is_mut_captured_in(Array::get(elems, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if is_mut_captured_in(Array::get(elems, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\\n      true\\n    }\\n    else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, i)\\n        if is_mut_captured_in(arm_expr, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EFn(_, _, params, _, _, fn_body) => {\\n      let mut shadowed = false\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pname, _) = Array::get(params, pi)\\n        if pname == name {\\n          shadowed = true\\n        }\\n        pi = pi + 1\\n      }\\n      if shadowed {\\n        false\\n      }\\n      else {\\n        let param_names = Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n        let mut pi2 = 0\\n        while pi2 < Array::length(params) {\\n          let (pname2, _) = Array::get(params, pi2)\\n          Array::push(param_names, pname2)\\n          pi2 = pi2 + 1\\n        }\\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\\n          \\\"\\\"\\n        ], 0, 0))\\n        if array_contains_str(fv, name) {\\n          true\\n        }\\n        else {\\n          is_mut_captured_in(fn_body, name)\\n        }\\n      }\\n    },\\n    EBreak(_) => false,\\n    EContinue(_) => false,\\n    EThrow(msg) => is_mut_captured_in(msg, name),\\n    _ => false\\n  }\\n}\\n\\n\\n\\nlet op_i32_eq = 70\\nlet op_i32_ne = 71\\nlet op_i32_eqz = 69\\nlet op_i32_mul = 108\\nlet op_i32_sub = 107\\nlet op_i32_ge_u = 79\\nlet op_i32_gt_u = 75\\nlet op_i64_load = 41\\nlet op_i64_store = 55\\n\\n\\nexport struct FuncTable {\\n  names: Array[String];\\n  indices: Array[Int];\\n  params: Array[Int];\\n  returns: Array[Int];\\n  needs_env: Array[Bool]\\n}\\n\\nexport struct StrTable {\\n  strs: Array[String];\\n  offsets: Array[Int];\\n  lengths: Array[Int]\\n}\\n\\nexport struct LambdaTable {\\n  bodies: Array[Bytes];\\n  param_counts: Array[Int];\\n  captures: Array[Array[String]];\\n  meta_i32: Array[Int];\\n  meta_i64: Array[Int]\\n}\\n\\nexport struct CtorTable {\\n  names: Array[String];\\n  tags: Array[Int];\\n  field_counts: Array[Int];\\n  type_names: Array[String];\\n  struct_names: Array[String];\\n  struct_field_names: Array[Array[String]]\\n}\\n\\nexport struct CompileCtx {\\n  func_table: FuncTable;\\n  str_table: StrTable;\\n  lambda_table: LambdaTable;\\n  num_user_funcs: Int;\\n  func_offset: Int;\\n  ref_cell_names: Array[String];\\n  ctor_table: CtorTable;\\n  thunk_names: Array[String];\\n  const_int_names: Array[String];\\n  const_int_values: Array[Int]\\n}\\n\\nexport struct CompileCtxGc {\\n  func_table: FuncTable;\\n  str_table: StrTable;\\n  lambda_table: LambdaTable;\\n  num_user_funcs: Int;\\n  func_offset: Int;\\n  ref_cell_names: Array[String];\\n  ref_local_indices: Array[Int];\\n  refcell_type_idx: Int;\\n  closure_type_base: Int;\\n  ctor_table: CtorTable\\n}\\n\\n\\nexport let is_efn = (expr: Expr) -> Bool {\\n  match expr {\\n    EFn(_, _, _, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pint = (p: Pat) -> Bool {\\n  match p {\\n    PInt(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_slet = (stmt: Stmt) -> Bool {\\n  match stmt {\\n    SLet(_, _, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let expr_tag = (expr: Expr) -> Int {\\n  match expr {\\n    EInt(_) => 0,\\n    EBool(_) => 1,\\n    EFloat(_) => 2,\\n    EString(_) => 3,\\n    EIdent(_) => 4,\\n    EBinOp(_, _, _) => 5,\\n    EUnaryOp(_, _) => 6,\\n    EIf(_, _, _) => 7,\\n    ECall(_, _) => 8,\\n    ELet(_, _, _) => 9,\\n    ELetRec(_, _, _) => 10,\\n    ELetMut(_, _, _) => 11,\\n    EAssign(_, _, _) => 12,\\n    EAssignOp(_, _, _, _) => 13,\\n    ESeq(_, _) => 14,\\n    ETuple(_) => 15,\\n    EMatch(_, _) => 16,\\n    EArray(_) => 17,\\n    EForIn(_, _, _, _) => 18,\\n    EWhile(_, _) => 19,\\n    EBreak(_) => 20,\\n    EContinue(_) => 21,\\n    EUnit => 22,\\n    EThrow(_) => 23,\\n    EFn(_, _, _, _, _, _) => 24,\\n    _ => -1\\n  }\\n}\\n\\nexport let is_pbind = (p: Pat) -> Bool {\\n  match p {\\n    PBind(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pbool = (p: Pat) -> Bool {\\n  match p {\\n    PBool(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pctor = (p: Pat) -> Bool {\\n  match p {\\n    PCtor(_, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pwild = (p: Pat) -> Bool {\\n  match p {\\n    PWild => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_eident = (expr: Expr) -> Bool {\\n  match expr {\\n    EIdent(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_etuple = (expr: Expr) -> Bool {\\n  match expr {\\n    ETuple(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_ptuple = (p: Pat) -> Bool {\\n  match p {\\n    PTuple(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pstring = (p: Pat) -> Bool {\\n  match p {\\n    PString(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let emit_i32_eq = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_eq)\\n}\\n\\nexport let emit_i32_ne = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_ne)\\n}\\n\\nexport let get_arm_pat = (arm: (Pat, Expr)) -> Pat {\\n  let (p, _) = arm\\n  p\\n}\\n\\nexport let rec lookup_ctor = (ctor_names: Array[String], name: String, i: Int) -> Int {\\n  if i >= Array::length(ctor_names) {\\n    -1\\n  }\\n  else if Array::get(ctor_names, i) == name {\\n    i\\n  }\\n  else lookup_ctor(ctor_names, name, i + 1)\\n}\\n\\nexport let emit_i32_eqz = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_eqz)\\n}\\n\\nexport let emit_i32_mul = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_mul)\\n}\\n\\nexport let emit_i32_sub = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_sub)\\n}\\n\\nexport let emit_str_ref = (buf: Bytes, offset: Int, length: Int) -> Unit {\\n  emit_i64_const(buf, offset)\\n  emit_i64_const(buf, 32)\\n  emit_i64_shl(buf)\\n  emit_i64_const(buf, length)\\n  emit_i64_or(buf)\\n}\\n\\nexport let get_arm_body = (arm: (Pat, Expr)) -> Expr {\\n  let (_, b) = arm\\n  b\\n}\\n\\nexport let get_efn_body = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EFn(_, _, _, _, _, body) => body,\\n    _ => throw(\\\"not EFn\\\")\\n  }\\n}\\n\\nexport let get_eif_cond = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EIf(c, _, _) => c,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport let get_eif_else = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EIf(_, _, e) => e,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport let get_eif_then = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    EIf(_, t, _) => t,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport let get_elet_val = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELet(_, val, _) => val,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport let resolve_func = (ft: FuncTable, name: String) -> (Int, Int, Int)with { Error } {\\n  let len = Array::length(ft.names)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    if Array::get(ft.names, i) == name {\\n      found = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"undefined function: \\\", name))\\n  };\\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\\n}\\n\\nexport let emit_binop_op = (buf: Bytes, op: String) -> Unit with { Error } {\\n  if op == \\\"+\\\" {\\n    emit_i64_add(buf)\\n  }\\n  else if op == \\\"-\\\" {\\n    emit_i64_sub(buf)\\n  }\\n  else if op == \\\"*\\\" {\\n    emit_i64_mul(buf)\\n  }\\n  else if op == \\\"/\\\" {\\n    emit_i64_div_s(buf)\\n  }\\n  else if op == \\\"%\\\" {\\n    emit_i64_rem_s(buf)\\n  }\\n  else if op == \\\"&\\\" {\\n    emit_i64_and(buf)\\n  }\\n  else if op == \\\"|\\\" {\\n    emit_i64_or(buf)\\n  }\\n  else if op == \\\"^\\\" {\\n    emit_i64_xor(buf)\\n  }\\n  else if op == \\\"<<\\\" {\\n    emit_i64_shl(buf)\\n  }\\n  else if op == \\\">>\\\" {\\n    emit_i64_shr_s(buf)\\n  }\\n  else if op == \\\"==\\\" {\\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"!=\\\" {\\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"<\\\" {\\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\">\\\" {\\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"<=\\\" {\\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\">=\\\" {\\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"&&\\\" {\\n    emit_i64_and(buf)\\n  }\\n  else if op == \\\"||\\\" {\\n    emit_i64_or(buf)\\n  }\\n  else {\\n    throw(String::concat(\\\"unsupported binop: \\\", op))\\n  }\\n}\\n\\nexport let emit_i32_ge_u = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_ge_u)\\n}\\n\\nexport let emit_i32_gt_u = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, op_i32_gt_u)\\n}\\n\\nexport let emit_i64_load = (buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push(buf, op_i64_load)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\nexport let get_ebinop_op = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    EBinOp(op, _, _) => op,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport let get_elet_body = (expr: Expr) -> Expr with { Error } {\\n  match expr {\\n    ELet(_, _, body) => body,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport let get_elet_name = (expr: Expr) -> String with { Error } {\\n  match expr {\\n    ELet(name, _, _) => name,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport let get_func_body = (stmt: Stmt) -> Expr with { Error } {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => match expr {\\n      EFn(_, _, _, _, _, body) => body,\\n      _ => throw(\\\"get_func_body: not a function\\\")\\n    },\\n    _ => throw(\\\"get_func_body: not a let statement\\\")\\n  }\\n}\\n\\nexport let get_slet_expr = (stmt: Stmt) -> Expr with { Error } {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => expr,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\nexport let get_slet_name = (stmt: Stmt) -> String with { Error } {\\n  match stmt {\\n    SLet(_, _, name, _, _) => name,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\nexport let resolve_local = (names: Array[String], name: String, tag: String) -> Int with { Error } {\\n  let mut i = Array::length(names) - 1\\n  let mut result = -1\\n  while i >= 0 {\\n    if Array::get(names, i) == name {\\n      result = i\\n      i = -1\\n    } else {\\n      i = i - 1\\n    }\\n  }\\n  if result < 0 {\\n    let mut dbg = String::concat(\\\"undefined variable (local): \\\", name)\\n    dbg = String::concat(dbg, \\\" [locals: \\\")\\n    let mut di = 0\\n    let dlen = Array::length(names)\\n    while di < dlen {\\n      if di > 0 {\\n        dbg = String::concat(dbg, \\\", \\\")\\n      }\\n      dbg = String::concat(dbg, Array::get(names, di))\\n      di = di + 1\\n    }\\n    dbg = String::concat(dbg, \\\"]\\\")\\n    dbg = String::concat(dbg, \\\" @\\\")\\n    dbg = String::concat(dbg, tag)\\n    throw(dbg)\\n  }\\n  result\\n}\\n\\nexport let emit_i64_store = (buf: Bytes, align: Int, offset: Int) -> Unit {\\n  bytebuf_push(buf, op_i64_store)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\nexport let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {\\n  let len = Array::length(stmts)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SLet(_, _, sname, _, _) => if sname == name {\\n        found = i\\n        i = len\\n      },\\n      _ => ()\\n    }\\n    if found < 0 {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"function not found: \\\", name))\\n  }\\n  Array::get(stmts, found)\\n}\\n\\n\\n\\n\\n\\n\\n\\nexport let gen_eq_body = (str_eq_idx: Int) -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 1)\\n  emit_i64_eq(b)\\n  emit_if_i64(b)\\n  emit_i64_const(b, 1)\\n  emit_else(b)\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 1)\\n  emit_call(b, str_eq_idx)\\n  emit_end(b)\\n  b\\n}\\n\\n\\n\\n\\n\\n\\n\\nexport let gen_str_eq_body = () -> Bytes {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 42949672