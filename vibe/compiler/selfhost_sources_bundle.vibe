"//# Types\n\nexport enum Token {\n  TInt(Int);\n  TFloat(Double);\n  TString(String);\n  TIdent(String);\n  TLet;\n  TRec;\n  TMut;\n  TFn;\n  TIf;\n  TElse;\n  TMatch;\n  TDo;\n  TEnum;\n  TStruct;\n  TType;\n  TTrait;\n  TImpl;\n  TExport;\n  TTest;\n  TWhile;\n  TFor;\n  TIn;\n  TLoop;\n  TBreak;\n  TContinue;\n  TReturn;\n  TWith;\n  THandle;\n  TThrow;\n  TRaise;\n  TYield;\n  TBench;\n  TDeclare;\n  TAs;\n  TModule;\n  TSuberror;\n  TDerive;\n  TOpen;\n  TImport;\n  TPlus;\n  TMinus;\n  TStar;\n  TSlash;\n  TPercent;\n  TEqEq;\n  TNeq;\n  TLt;\n  TLte;\n  TGt;\n  TGte;\n  TAnd;\n  TOr;\n  TNot;\n  TBitAnd;\n  TBitOr;\n  TBitXor;\n  TLShift;\n  TRShift;\n  TPipeGt;\n  TArrow;\n  TThinArrow;\n  TEq;\n  TDot;\n  TColon;\n  TDoubleColon;\n  TComma;\n  TSemicolon;\n  THash;\n  TTilde;\n  TQuestion;\n  TPlusEq;\n  TMinusEq;\n  TStarEq;\n  TSlashEq;\n  TPercentEq;\n  TLParen;\n  TRParen;\n  TLBrace;\n  TRBrace;\n  TLBracket;\n  TRBracket;\n  TEof\n}\n\n//# Functions\n\nexport let token_to_string = (t: Token) -> String {\n  match t {\n    TInt(n) => string_concat(\"TInt(\", string_concat(__to_string(n), \")\")),\n    TFloat(n) =>\n    string_concat(\"TFloat(\", string_concat(__to_string(n), \")\")),\n    TString(s) => string_concat(\"TString(\\\"\", string_concat(s, \"\\\")\")),\n    TIdent(s) => string_concat(\"TIdent(\", string_concat(s, \")\")),\n    TLet => \"TLet\",\n    TRec => \"TRec\",\n    TMut => \"TMut\",\n    TFn => \"TFn\",\n    TIf => \"TIf\",\n    TElse => \"TElse\",\n    TMatch => \"TMatch\",\n    TDo => \"TDo\",\n    TEnum => \"TEnum\",\n    TStruct => \"TStruct\",\n    TType => \"TType\",\n    TTrait => \"TTrait\",\n    TImpl => \"TImpl\",\n    TExport => \"TExport\",\n    TTest => \"TTest\",\n    TWhile => \"TWhile\",\n    TFor => \"TFor\",\n    TIn => \"TIn\",\n    TLoop => \"TLoop\",\n    TBreak => \"TBreak\",\n    TContinue => \"TContinue\",\n    TReturn => \"TReturn\",\n    TWith => \"TWith\",\n    THandle => \"THandle\",\n    TThrow => \"TThrow\",\n    TRaise => \"TRaise\",\n    TYield => \"TYield\",\n    TBench => \"TBench\",\n    TDeclare => \"TDeclare\",\n    TAs => \"TAs\",\n    TModule => \"TModule\",\n    TSuberror => \"TSuberror\",\n    TDerive => \"TDerive\",\n    TOpen => \"TOpen\",\n    TImport => \"TImport\",\n    TPlus => \"TPlus\",\n    TMinus => \"TMinus\",\n    TStar => \"TStar\",\n    TSlash => \"TSlash\",\n    TPercent => \"TPercent\",\n    TEqEq => \"TEqEq\",\n    TNeq => \"TNeq\",\n    TLt => \"TLt\",\n    TLte => \"TLte\",\n    TGt => \"TGt\",\n    TGte => \"TGte\",\n    TAnd => \"TAnd\",\n    TOr => \"TOr\",\n    TNot => \"TNot\",\n    TBitAnd => \"TBitAnd\",\n    TBitOr => \"TBitOr\",\n    TBitXor => \"TBitXor\",\n    TLShift => \"TLShift\",\n    TRShift => \"TRShift\",\n    TPipeGt => \"TPipeGt\",\n    TArrow => \"TArrow\",\n    TThinArrow => \"TThinArrow\",\n    TEq => \"TEq\",\n    TDot => \"TDot\",\n    TColon => \"TColon\",\n    TDoubleColon => \"TDoubleColon\",\n    TComma => \"TComma\",\n    TSemicolon => \"TSemicolon\",\n    THash => \"THash\",\n    TTilde => \"TTilde\",\n    TQuestion => \"TQuestion\",\n    TPlusEq => \"TPlusEq\",\n    TMinusEq => \"TMinusEq\",\n    TStarEq => \"TStarEq\",\n    TSlashEq => \"TSlashEq\",\n    TPercentEq => \"TPercentEq\",\n    TLParen => \"TLParen\",\n    TRParen => \"TRParen\",\n    TLBrace => \"TLBrace\",\n    TRBrace => \"TRBrace\",\n    TLBracket => \"TLBracket\",\n    TRBracket => \"TRBracket\",\n    TEof => \"TEof\"\n  }\n}\n")
