  Array::push(bodies, gen_fs_write_bytes_stub_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_eq_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_string_ends_with_body(str_len_idx, str_substring_idx, str_eq_idx))\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, gen_string_last_index_of_body(str_len_idx, str_substring_idx, str_eq_idx))\n  Array::push(meta_i32, 3)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, gen_arr_push_all_body())\n  Array::push(meta_i32, 9)\n  Array::push(meta_i64, 0)\n  if num_src_pairs > 0 {\n    Array::push(bodies, gen_selfhost_sources_proper_body(num_src_pairs, str_offsets, str_lengths, src_str_base, arr_new_idx, arr_push_idx))\n    Array::push(meta_i32, 1)\n    // 1 i32 local (tuple ptr)\n    Array::push(meta_i64, 1)\n    // 1 i64 local (array ref)\n  } else {\n    Array::push(bodies, gen_selfhost_sources_stub_body(arr_new_idx))\n    Array::push(meta_i32, 0)\n    Array::push(meta_i64, 0)\n  }\n  let mut bi = 0\n  while bi < num_user_funcs {\n    let __bi_stmt = Array::get(stmts, Array::get(fn_stmt_indices, bi))\n    let __bi_expr = get_slet_expr(__bi_stmt)\n    let body_buf = bytebuf_new()\n    let local_names = Array::slice([\n      \"\"\n    ], 0, 0)\n    let fn_name_dbg = Array::get(fn_names_list, bi)\n    let compile_ctx = CompileCtx::{\n      func_table: FuncTable::{\n        names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list\n      },\n      str_table: StrTable::{\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\n      },\n      lambda_table: lt_w,\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\n      ref_cell_names: Array::slice([\n        \"\"\n      ], 0, 0),\n      ctor_table: CtorTable::{\n        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names\n      },\n      thunk_names: thunk_names_list\n    }\n    if is_efn(__bi_expr) {\n      let __bi_params = get_efn_params(__bi_expr)\n      let body = get_efn_body(__bi_expr)\n      let mut pi = 0\n      while pi < Array::length(__bi_params) {\n        let (pname, _) = Array::get(__bi_params, pi)\n        Array::push(local_names, pname)\n        pi = pi + 1\n      }\n      Array::push(local_names, \"__env\")\n      let param_count = Array::length(__bi_params) + 1\n      // includes __env\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(meta_i32, 0)\n      Array::push(meta_i64, extra)\n    } else {\n      Array::push(local_names, \"__env\")\n      let param_count = 1\n      // just __env\n      let final_nl = compile_expr(body_buf, __bi_expr, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(meta_i32, 0)\n      Array::push(meta_i64, extra)\n    }\n    bi = bi + 1\n  }\n  let num_lambdas = Array::length(lt_w.bodies)\n  let start_body = bytebuf_new()\n  let entry_func_idx = entry_user_idx + func_offset\n  let entry_params = Array::get(fn_param_counts, entry_user_idx)\n  if entry_params != 0 {\n    throw(\"WASI entry function must take 0 parameters\")\n  }\n  emit_i64_const(start_body, 0)\n  // env=0 for user func\n  emit_call(start_body, entry_func_idx)\n  emit_call(start_body, print_int_idx)\n  // __print_i64\n  Array::push(bodies, start_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let run_body = bytebuf_new()\n  emit_i64_const(run_body, 0)\n  // env=0 for user func; run returns the entry result for host-driven execution.\n  emit_call(run_body, entry_func_idx)\n  Array::push(bodies, run_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let mut li = 0\n  while li < num_lambdas {\n    Array::push(bodies, Array::get(lt_w.bodies, li))\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\n    li = li + 1\n  }\n  let mut max_closure_arity = -1\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\n    // user_params = total - 1 (env)\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  let mut uai = 0\n  while uai < num_user_funcs {\n    let upc = Array::get(fn_param_counts, uai)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai = uai + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 {\n    max_closure_arity + 1\n  } else {\n    0\n  }\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\n  emit_func_type_raw(type_content, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  // type 0: fd_write\n  emit_func_type_raw(type_content, [\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  // type 1: (i64)->()\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  // type 2: ()->()\n  emit_func_type_raw(type_content, [\n    126\n  ], [\n    126\n  ])\n  // type 3: (i64)->(i64)\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], [\n    126\n  ])\n  // type 4: (i64,i64)->(i64)\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), [\n    126\n  ])\n  // type 5: ()->(i64)\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  // type 6: (i64,i64)->()\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  // type 7: (i64,i64,i64)->()\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], [\n    126\n  ])\n  // type 8: (i64,i64,i64)->(i64)\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1\n    // N user params + 1 env\n    let ct_params = Array::slice([\n      0\n    ], 0, 0)\n    let mut cpti = 0\n    while cpti < num_params {\n      Array::push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [\n      126\n    ])\n    cti = cti + 1\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n  let import_content = bytebuf_new()\n  bytebuf_push_vec_header(import_content, num_imported_funcs)\n  emit_name(import_content, \"wasi_snapshot_preview1\")\n  emit_name(import_content, \"fd_write\")\n  bytebuf_push(import_content, 0)\n  leb128_encode_u32(import_content, 0)\n  if env_get_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"env-get\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if env_args_len_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"args-len\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  if env_args_get_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"args-get\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_read_file_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_read_file\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_exists_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_exists\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_stat_token_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_stat_token\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_write_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_write_bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  }\n  bytebuf_push_section(out, 2, import_content)\n  let func_type_indices = Array::slice([\n    0\n  ], 0, 0)\n  Array::push(func_type_indices, 1)\n  // __print_i64\n  Array::push(func_type_indices, 1)\n  // __print_str\n  Array::push(func_type_indices, 3)\n  // __str_len\n  Array::push(func_type_indices, 4)\n  // __str_eq\n  Array::push(func_type_indices, 4)\n  // __str_concat\n  Array::push(func_type_indices, 5)\n  // __arr_new\n  Array::push(func_type_indices, 3)\n  // __arr_len\n  Array::push(func_type_indices, 4)\n  // __arr_get\n  Array::push(func_type_indices, 6)\n  // __arr_push\n  Array::push(func_type_indices, 7)\n  // __arr_set\n  Array::push(func_type_indices, 3)\n  // __double_to_int\n  Array::push(func_type_indices, 3)\n  // __int_to_double\n  Array::push(func_type_indices, 4)\n  // __str_char_code_at\n  Array::push(func_type_indices, 3)\n  // __str_from_char_code\n  Array::push(func_type_indices, 8)\n  // __str_substring\n  Array::push(func_type_indices, 3)\n  // __identity (ArrayBuilder::freeze)\n  Array::push(func_type_indices, 8)\n  // __arr_slice (i64,i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __arr_concat (i64,i64) -> (i64)\n  Array::push(func_type_indices, 6)\n  // __arr_truncate (i64,i64) -> ()\n  Array::push(func_type_indices, 4)\n  // __string_join (i64,i64) -> (i64)\n  Array::push(func_type_indices, 3)\n  // __fs_read_file_stub (i64) -> (i64)\n  Array::push(func_type_indices, 3)\n  // __fs_exists_stub (i64) -> (i64)\n  Array::push(func_type_indices, 3)\n  // __fs_stat_token_stub (i64) -> (i64)\n  Array::push(func_type_indices, 6)\n  // __fs_write_bytes_stub (i64,i64) -> ()\n  Array::push(func_type_indices, 4)\n  // __eq (i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __string_ends_with (i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __string_last_index_of (i64,i64) -> (i64)\n  Array::push(func_type_indices, 6)\n  // __arr_push_all (i64,i64) -> ()\n  Array::push(func_type_indices, 5)\n  // __selfhost_sources_stub () -> (i64)\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(fn_param_counts, fti)\n    Array::push(func_type_indices, num_base_types + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)\n  // _start () -> ()\n  Array::push(func_type_indices, 5)\n  // run () -> (i64)\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, num_base_types + lam_user_params)\n    lfi = lfi + 1\n  }\n  emit_function_section(out, func_type_indices)\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n  emit_memory_section(out, 8192)\n  emit_global_section_i32_mut(out, heap_start)\n  let start_func_idx = func_offset + num_user_funcs\n  let run_func_idx = start_func_idx + 1\n  let all_export_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let all_export_indices = Array::slice([\n    0\n  ], 0, 0)\n  Array::push(all_export_names, \"_start\")\n  Array::push(all_export_indices, start_func_idx)\n  Array::push(all_export_names, \"run\")\n  Array::push(all_export_indices, run_func_idx)\n  if !array_contains_str(all_export_names, entry_name) {\n    Array::push(all_export_names, entry_name)\n    Array::push(all_export_indices, entry_func_idx)\n  }\n  let mut exi = 0\n  while exi < Array::length(export_fn_names) {\n    let ename = Array::get(export_fn_names, exi)\n    if !array_contains_str(all_export_names, ename) {\n      Array::push(all_export_names, ename)\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\n    }\n    exi = exi + 1\n  }\n  emit_exports_full(out, all_export_names, all_export_indices, \"memory\", 0, [\n    \"__heap_ptr\"\n  ], [\n    0\n  ])\n  if total_table_entries > 0 {\n    let table_func_indices = Array::slice([\n      0\n    ], 0, 0)\n    let mut tei = 0\n    while tei < num_user_funcs {\n      Array::push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      Array::push(table_func_indices, run_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    if ni32 == 0 {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 0)\n        // no locals\n      } else {\n        leb128_encode_u32(func_buf, 1)\n        // 1 group\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n        // i64\n      }\n    } else {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n        // i32\n      } else {\n        leb128_encode_u32(func_buf, 2)\n        // 2 groups\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n        // i32\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n        // i64\n      }\n    }\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    // end\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_array(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = Array::slice([\n      0\n    ], 0, 0)\n    let data_bufs = Array::slice([\n      Array::slice([\n        0\n      ], 0, 0)\n    ], 0, 0)\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  bytebuf_to_bytes(out)\n}\n\n// Backward-compatible wrapper: compile WASI module without embedded selfhost sources\nexport let compile_wasi_module_impl = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_impl(stmts, entry_name, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n}\n")

  let source_41 = ("vibe/compiler/codegen/gc/index.vibe",
"// AST-to-WASM codegen (wasm-gc backend)\n// Uses GC struct types for ref cells instead of linear memory bump allocation.\n// Closures use table-based call_indirect (same as linear memory backend).\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,\n  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,\n  leb128_encode_u32, leb128_encode_s64\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_header,\n  emit_type_section, emit_type_section_multi,\n  emit_function_section, emit_export_section, emit_export_section_multi,\n  emit_code_section, emit_code_section_with_locals,\n  emit_name, emit_func_type_raw,\n  emit_import_section_func, emit_memory_section,\n  emit_exports_with_memory, emit_data_section, emit_data_section_multi,\n  emit_local_get, emit_local_set, emit_local_tee,\n  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,\n  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,\n  emit_i64_shl, emit_i64_shr_s,\n  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,\n  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,\n  emit_i64_extend_i32_s, emit_i32_wrap_i64,\n  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,\n  emit_i32_store8, emit_i32_load8_u,\n  emit_call, emit_drop, emit_return,\n  emit_block_void, emit_block_i64, emit_loop_void,\n  emit_if_void, emit_if_i64, emit_else, emit_end,\n  emit_br, emit_br_if,\n  emit_global_section_i32_mut, emit_global_get, emit_global_set,\n  string_to_data,\n  emit_f64_const_bits, emit_f64_add, emit_f64_sub, emit_f64_mul, emit_f64_div,\n  emit_f64_eq, emit_f64_ne, emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge,\n  emit_f64_neg, emit_i64_reinterpret_f64, emit_f64_reinterpret_i64,\n  emit_i64_trunc_f64_s, emit_f64_convert_i64_s,\n  emit_call_indirect, emit_table_section_funcref, emit_element_section_active,\n  emit_struct_type_raw, emit_struct_new, emit_struct_get, emit_struct_set\n}\n\nimport ../common_base/index.vibe {\n  emit_i32_sub, emit_i32_mul, emit_i32_ne, emit_i32_eq, emit_i32_ge_u, emit_i32_eqz, emit_i64_store, emit_i64_load, resolve_local, resolve_func, FuncTable, StrTable, LambdaTable, CtorTable, CompileCtxGc, emit_str_ref, find_func_stmt, lookup_ctor, emit_binop_op\n}\n\nimport ../common_extractors/index.vibe {\n  emit_memory_copy, array_contains_str, str_table_lookup, find_catchall_idx, emit_assignop_op\n}\n\nimport ../common_analysis/index.vibe {\n  emit_i64_extend_i32_u, collect_strings_stmts, collect_free_vars, is_mut_captured_in, emit_closure_resolve, emit_closure_call_tail\n}\n\n// === Sub-compilers (GC backend) ===\n\nlet compile_call_gc = (\n  buf: Array[Int], callee: Expr, args: Array[Expr],\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  ce: (Array[Int], Expr, Array[String], Int, Int) -> Int with { Error }\n) -> Int with { Error } {\n  match callee {\n    EIdent(fname) => {\n      // Check if this is an enum constructor call\n      let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n      if ctor_lookup_idx >= 0 {\n        let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n        let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        // For structs, unwrap ERecord and reorder fields\n        let actual_args = if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ERecord(rec_fields) => {\n              let rec find_sn = (sni: Int) -> Int {\n                if sni >= Array::length(ctx.ctor_table.struct_names) { -1 }\n                else if String::equals(Array::get(ctx.ctor_table.struct_names, sni), fname) { sni }\n                else find_sn(sni + 1)\n              }\n              let sn_idx = find_sn(0)\n              if sn_idx >= 0 {\n                let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n                let ordered = Array::slice([EUnit], 0, 0)\n                let mut oi = 0\n                while oi < Array::length(def_fnames) {\n                  let target_name = Array::get(def_fnames, oi)\n                  let rec find_rf = (ri: Int) -> Expr {\n                    if ri >= Array::length(rec_fields) { EUnit }\n                    else {\n                      let (rfn, rfv) = Array::get(rec_fields, ri)\n                      if String::equals(rfn, target_name) { rfv }\n                      else find_rf(ri + 1)\n                    }\n                  }\n                  Array::push(ordered, find_rf(0))\n                  oi = oi + 1\n                }\n                ordered\n              } else { args }\n            },\n            _ => args\n          }\n        } else { args }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n      else {\n      let fn_len2 = Array::length(ctx.func_table.names)\n      let rec try_resolve = (j: Int) -> Int {\n        if j >= fn_len2 { -1 }\n        else if String::equals(Array::get(ctx.func_table.names, j), fname) { j }\n        else try_resolve(j + 1)\n      }\n      let fn_idx_in_list = try_resolve(0)\n      if fn_idx_in_list >= 0 {\n        // Direct call to known function\n        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\n        let mut nl = next_local\n        let mut ci = 0\n        while ci < Array::length(args) {\n          nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n          ci = ci + 1\n        }\n        // User funcs in GC backend have __env param for table compatibility\n        if ctx.func_offset > 0 {\n          if fidx >= ctx.func_offset {\n            emit_i64_const(buf, 0)\n          }\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        // Indirect call: fname is a local holding a closure/fn value\n        let local_idx2 = resolve_local(local_names, fname, \"gc_call\")\n        let num_args = Array::length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        Array::push(local_names, \"__fn_val\")\n        Array::push(local_names, \"__slot\")\n        Array::push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)\n        nl\n      }\n      } // close ctor_lookup else\n    },\n    _ => {\n      // Callee is an arbitrary expression\n      let num_args = Array::length(args)\n      let fn_val_local = next_local\n      let slot_local = next_local + 1\n      let env_local = next_local + 2\n      let mut nl = next_local + 3\n      Array::push(local_names, \"__fn_val\")\n      Array::push(local_names, \"__slot\")\n      Array::push(local_names, \"__env\")\n      nl = ce(buf, callee, local_names, nl, ld)\n      emit_local_set(buf, fn_val_local)\n      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n      let mut ci = 0\n      while ci < num_args {\n        nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n        ci = ci + 1\n      }\n      emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)\n      nl\n    }\n  }\n}\n\nlet compile_match_gc = (\n  buf: Array[Int], scrutinee: Expr, arms: Array[(Pat, Expr)],\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  ce: (Array[Int], Expr, Array[String], Int, Int) -> Int with { Error }\n) -> Int with { Error } {\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(arms)\n  let catchall_idx = find_catchall_idx(arms)\n  let num_cond_arms = catchall_idx\n  let mut max_nl = nl1\n  let mut ai = 0\n  while ai < num_cond_arms {\n    let (p, _) = Array::get(arms, ai)\n    match p {\n      PInt(n) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, n)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PBool(bv) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if bv { 1 } else { 0 })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PCtor(cname_cond, _) => {\n        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n        let expected_tag = if ctor_ci >= 0 { Array::get(ctx.ctor_table.tags, ctor_ci) } else { -1 }\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i32_const(buf, expected_tag)\n        emit_i32_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PString(sval) => {\n        let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n        if str_idx >= 0 {\n          emit_local_get(buf, scrut_local)\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n          emit_call(buf, 4)\n          emit_i64_const(buf, 1)\n          emit_i64_eq(buf)\n          emit_if_i64(buf)\n        }\n        0\n      },\n      _ => 0\n    }\n    let names_len_at_arm = Array::length(local_names)\n    let (p2, arm_body) = Array::get(arms, ai)\n    let ld_arm = if ld >= 0 { ld + ai + 1 } else { -1 }\n    match p2 {\n      PCtor(_, cargs_bind) => {\n        let mut cbi = 0\n        while cbi < Array::length(cargs_bind) {\n          match Array::get(cargs_bind, cbi) {\n            PBind(pname) => {\n              let fl = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi * 8)\n              emit_local_set(buf, fl)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi = cbi + 1\n        }\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n        if arm_nl > max_nl { max_nl = arm_nl }\n        0\n      },\n      _ => {\n        let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)\n        if arm_nl > max_nl { max_nl = arm_nl }\n        0\n      }\n    }\n    emit_else(buf)\n    Array::truncate(local_names, names_len_at_arm)\n    ai = ai + 1\n  }\n  let ld_catch = if ld >= 0 { ld + num_cond_arms } else { -1 }\n  let _names_len_at_catch = Array::length(local_names)\n  if catchall_idx < num_arms {\n    let (cp, cbody) = Array::get(arms, catchall_idx)\n    let catch_nl = match cp {\n      PBind(bname) => {\n        let bind_local = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, bind_local)\n        Array::push(local_names, bname)\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PCtor(_cname, cargs) => {\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          match Array::get(cargs, cbi2) {\n            PBind(pname) => {\n              let fl2 = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi2 * 8)\n              emit_local_set(buf, fl2)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PTuple(pats) => {\n        let ptr_local2 = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, ptr_local2)\n        Array::push(local_names, \"__tup_ptr2\")\n        let mut pi2 = 0\n        while pi2 < Array::length(pats) {\n          let tp = Array::get(pats, pi2)\n          match tp {\n            PBind(pname) => {\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => throw(\"unsupported pattern in tuple destructure\")\n          }\n          pi2 = pi2 + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      _ => {\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      }\n    }\n    if catch_nl > max_nl { max_nl = catch_nl }\n    0\n  } else {\n    bytebuf_push(buf, 0)  // unreachable\n    0\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  // Pad local_names to stay in sync with max_nl\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n\nlet compile_lambda_gc = (\n  buf: Array[Int], params: Array[(String, Option[TypeExpr])], fn_body: Expr,\n  local_names: Array[String], next_local: Int,\n  ctx: CompileCtxGc, ld: Int,\n  compile_fn: (Array[Int], Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }\n) -> Int with { Error } {\n  let param_names_arr = Array::slice([\"\"], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n\n  // Compile lambda body into a separate buffer\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\"\"], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n\n  // Prologue: extract captures from env\n  let lam_ref_cells = Array::slice([\"\"], 0, 0)\n  let lam_ref_local_indices = Array::slice([0], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n\n  // Compile lambda body\n  let lam_ctx = CompileCtxGc::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ref_local_indices: lam_ref_local_indices,\n    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,\n    ctor_table: ctx.ctor_table\n  }\n  let final_lam_nl = compile_fn(\n    lam_buf, fn_body, lam_locals, lam_nl,\n    lam_ctx, ld\n  )\n\n  // Record lambda AFTER body compilation (nested lambdas already added)\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let extra_lam = if final_lam_nl > (user_params + 1) { final_lam_nl - (user_params + 1) } else { 0 }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n\n  // Emit closure creation code\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot << 2) | 2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let cap_idx = resolve_local(local_names, cap_name, \"gc_cap\")\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, cap_idx)\n      emit_i64_store(buf, 3, 8 + csi * 8)\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\n// === Expression compiler (GC backend) ===\n\nlet rec compile_expr_gc = (\n  buf: Array[Int],\n  expr: Expr,\n  local_names: Array[String],\n  next_local: Int,\n  ctx: CompileCtxGc,\n  ld: Int\n) -> Int with { Error } {\n  // shorthand for recursive call\n  let ce = (b: Array[Int], e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {\n    compile_expr_gc(b, e, ln, nl, ctx, d)\n  }\n  match expr {\n    EInt(n) => {\n      emit_i64_const(buf, n)\n      next_local\n    },\n    EBool(b_val) => {\n      emit_i64_const(buf, if b_val { 1 } else { 0 })\n      next_local\n    },\n    EFloat(v) => {\n      let bits = Double::to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n    },\n    EString(s) => {\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n      next_local\n    },\n    EIdent(name) => {\n      // Try local first\n      let len = Array::length(local_names)\n      let rec try_local = (i: Int) -> Int {\n        if i < 0 { -1 }\n        else if String::equals(Array::get(local_names, i), name) { i }\n        else try_local(i - 1)\n      }\n      let local_idx = try_local(len - 1)\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          // Ref cell: local holds (ref $RefCell), read via struct.get\n          emit_local_get(buf, local_idx)\n          emit_struct_get(buf, ctx.refcell_type_idx, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        // Check if it's a 0-arg enum constructor\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n        // Check if it's a top-level function — emit as bare fn value\n        let fn_len = Array::length(ctx.func_table.names)\n        let rec try_fn = (j: Int) -> Int with { Error } {\n          if j >= fn_len { throw(String::concat(\"undefined variable: \", name)) }\n          else if String::equals(Array::get(ctx.func_table.names, j), name) { j }\n          else try_fn(j + 1)\n        }\n        let fni = try_fn(0)\n        let fidx = Array::get(ctx.func_table.indices, fni)\n        let table_slot = fidx - ctx.func_offset\n        emit_i64_const(buf, (table_slot << 2) | 2)\n        next_local\n        }\n      }\n    },\n    EBinOp(op, lhs, rhs) => {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_binop_op(buf, op)\n      nl2\n    },\n    EUnaryOp(op, operand) => {\n      if String::equals(op, \"-\") {\n        emit_i64_const(buf, 0)\n        let nl = ce(buf, operand, local_names, next_local, ld)\n        emit_i64_sub(buf)\n        nl\n      } else if String::equals(op, \"!\") {\n        let nl = ce(buf, operand, local_names, next_local, ld)\n        // Bool: true=1, false=0. Use eqz to negate.\n        emit_i64_eqz(buf)\n        emit_i64_extend_i32_s(buf)\n        nl\n      } else {\n        throw(String::concat(\"unsupported unary op: \", op))\n      }\n    },\n    EIf(cond, then_e, else_e) => {\n      // S1b: skip extend+wrap roundtrip for comparison conditions\n      let nl1 = match cond {\n        EBinOp(cop, clhs, crhs) => if String::equals(cop, \"==\") || String::equals(cop, \"!=\") || String::equals(cop, \"<\") || String::equals(cop, \">\") || String::equals(cop, \"<=\") || String::equals(cop, \">=\") {\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          if String::equals(cop, \"==\") { emit_i64_eq(buf) }\n          else if String::equals(cop, \"!=\") { emit_i64_ne(buf) }\n          else if String::equals(cop, \"<\") { emit_i64_lt_s(buf) }\n          else if String::equals(cop, \">\") { emit_i64_gt_s(buf) }\n          else if String::equals(cop, \"<=\") { emit_i64_le_s(buf) }\n          else { emit_i64_ge_s(buf) }\n          cnl2\n        } else {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        },\n        EBool(b_val) => {\n          emit_i32_const(buf, if b_val { 1 } else { 0 })\n          next_local\n        },\n        _ => {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      }\n      emit_if_i64(buf)\n      let ld_inner = if ld >= 0 { ld + 1 } else { -1 }\n      let names_len_before = Array::length(local_names)\n      let nl2 = ce(buf, then_e, local_names, nl1, ld_inner)\n      emit_else(buf)\n      Array::truncate(local_names, names_len_before)\n      let nl3 = ce(buf, else_e, local_names, nl1, ld_inner)\n      emit_end(buf)\n      let max_nl_if = if nl2 > nl3 { nl2 } else { nl3 }\n      // Pad local_names to stay in sync with max next_local\n      while Array::length(local_names) < max_nl_if {\n        Array::push(local_names, \"\")\n      }\n      max_nl_if\n    },\n    ECall(callee, args) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\n    ELet(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      let nl2 = ce(buf, body, local_names, nl, ld)\n      nl2\n    },\n    ELetRec(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      // Backpatch self-reference in closure for recursive let rec\n      match value {\n        EFn(_, _, params, _, _, fn_body) => {\n          let param_names_bp = Array::slice([\"\"], 0, 0)\n          let mut bpi = 0\n          while bpi < Array::length(params) {\n            let (pn, _) = Array::get(params, bpi)\n            Array::push(param_names_bp, pn)\n            bpi = bpi + 1\n          }\n          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n          let mut self_cap_idx = -1\n          let mut bci = 0\n          while bci < Array::length(caps) {\n            if String::equals(Array::get(caps, bci), name) {\n              self_cap_idx = bci\n            }\n            bci = bci + 1\n          }\n          if self_cap_idx >= 0 {\n            emit_local_get(buf, local_idx)\n            emit_i64_const(buf, -4)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, local_idx)\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n          }\n          0\n        },\n        _ => 0\n      }\n      let nl2 = ce(buf, body, local_names, nl, ld)\n      nl2\n    },\n    ELetMut(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if is_mut_captured_in(body, name) {\n        // Mutable captured: allocate GC ref cell via struct.new\n        Array::push(ctx.ref_cell_names, name)\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_struct_new(buf, ctx.refcell_type_idx)\n        emit_local_set(buf, local_idx)\n        Array::push(ctx.ref_local_indices, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      } else {\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_local_set(buf, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      }\n    },\n    EAssign(name, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        // Ref cell: struct.set\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    EAssignOp(name, op, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        // Ref cell: read via struct.get, compute, write via struct.set\n        emit_local_get(buf, idx)   // ref on stack (for struct.set later)\n        emit_local_get(buf, idx)   // ref on stack (for struct.get)\n        emit_struct_get(buf, ctx.refcell_type_idx, 0)  // current value\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    ESeq(first, second) => {\n      let nl = ce(buf, first, local_names, next_local, ld)\n      emit_drop(buf)\n      ce(buf, second, local_names, nl, ld)\n    },\n    ETuple(elems) => {\n      // Allocate N*8 bytes on heap, store each element as i64\n      let num_elems = Array::length(elems)\n      let alloc_size = num_elems * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__tuple_ptr\")\n      let mut nl = next_local + 1\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    },\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\n    EArray(elems) => {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    },\n    EForIn(var_name, index_name, iter_expr, body) => {\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let arr_local = next_local\n      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__for_arr\")\n      let i_local = nl1\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_local)\n      Array::push(local_names, \"__for_i\")\n      let nl2 = nl1 + 1\n      emit_block_void(buf)\n        emit_loop_void(buf)\n          emit_local_get(buf, i_local)\n          emit_local_get(buf, arr_local)\n          emit_call(buf, arr_len_idx)\n          emit_i64_ge_s(buf)\n          // S1b: i64_ge_s already leaves i32, skip extend+wrap\n          emit_br_if(buf, 1)\n          let var_local = match index_name {\n            Some(_) => nl2 + 1,\n            None => nl2\n          }\n          match index_name {\n            Some(index_name) => {\n              emit_local_get(buf, i_local)\n              emit_local_set(buf, nl2)\n              Array::push(local_names, index_name)\n            },\n            None => ()\n          }\n          emit_local_get(buf, arr_local)\n          emit_local_get(buf, i_local)\n          emit_call(buf, arr_get_idx)\n          emit_local_set(buf, var_local)\n          Array::push(local_names, var_name)\n          let nl3 = var_local + 1\n          let nl4 = ce(buf, body, local_names, nl3, ld + 1)\n          emit_drop(buf)\n          emit_local_get(buf, i_local)\n          emit_i64_const(buf, 1)\n          emit_i64_add(buf)\n          emit_local_set(buf, i_local)\n          emit_br(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl4\n    },\n    EWhile(cond, body) => {\n      emit_block_void(buf)\n        emit_loop_void(buf)\n          // S1b: skip extend+wrap for comparison conditions in while\n          let nl1 = match cond {\n            EBinOp(wcop, wlhs, wrhs) => if String::equals(wcop, \"==\") || String::equals(wcop, \"!=\") || String::equals(wcop, \"<\") || String::equals(wcop, \">\") || String::equals(wcop, \"<=\") || String::equals(wcop, \">=\") {\n              let wnl1 = ce(buf, wlhs, local_names, next_local, ld + 1)\n              let wnl2 = ce(buf, wrhs, local_names, wnl1, ld + 1)\n              if String::equals(wcop, \"==\") { emit_i64_eq(buf) }\n              else if String::equals(wcop, \"!=\") { emit_i64_ne(buf) }\n              else if String::equals(wcop, \"<\") { emit_i64_lt_s(buf) }\n              else if String::equals(wcop, \">\") { emit_i64_gt_s(buf) }\n              else if String::equals(wcop, \"<=\") { emit_i64_le_s(buf) }\n              else { emit_i64_ge_s(buf) }\n              emit_i32_eqz(buf)\n              wnl2\n            } else {\n              let wnl = ce(buf, cond, local_names, next_local, ld + 1)\n              emit_i64_eqz(buf)\n              wnl\n            },\n            _ => {\n              let wnl = ce(buf, cond, local_names, next_local, ld + 1)\n              emit_i64_eqz(buf)\n              wnl\n            }\n          }\n          emit_br_if(buf, 1)\n          let nl2 = ce(buf, body, local_names, nl1, ld + 1)\n          emit_drop(buf)\n          emit_br(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl2\n    },\n    EBreak(_) => {\n      emit_br(buf, ld + 1)\n      emit_i64_