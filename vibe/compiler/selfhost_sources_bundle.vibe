"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport ../common_base/index.vibe {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport ../common_analysis/index.vibe {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ../expr/index.vibe {\n  compile_expr\n}\n\nimport ../builtin_bodies/index.vibe {\n  gen_eq_body, gen_str_eq_body, gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_set_body, gen_str_len_body, gen_arr_push_body, gen_arr_push_all_body, gen_identity_body, gen_arr_slice_body, gen_print_i64_body, gen_print_str_body, gen_arr_concat_body, gen_str_concat_body, gen_string_join_body, gen_arr_truncate_body, gen_double_to_int_body, gen_int_to_double_body, gen_str_substring_body, gen_str_char_code_at_body, gen_string_ends_with_body, gen_fs_read_file_stub_body, gen_fs_exists_stub_body, gen_fs_stat_token_stub_body, gen_str_from_char_code_body, gen_fs_write_bytes_stub_body, gen_string_last_index_of_body, gen_selfhost_sources_stub_body, gen_selfhost_sources_proper_body\n}\n\n//# Functions\n\nlet expr_uses_builtin = (expr: Expr, fn_names: Array[String], target: String) -> Bool {\n  let free_vars = collect_free_vars(expr, Array::slice([\n    \"\"\n  ], 0, 0), fn_names)\n  array_contains_str(free_vars, target)\n}\n\nlet rec stmts_use_builtin = (stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport let compile_wasi_module_with_sources_impl = (stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\n  let fn_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let fn_param_counts = Array::slice([\n    0\n  ], 0, 0)\n  let fn_stmt_indices = Array::slice([\n    0\n  ], 0, 0)\n  let thunk_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let export_fn_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let export_fn_user_indices = Array::slice([\n    0\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_stmt_indices, i)\n      } else {\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, 0)\n        Array::push(fn_stmt_indices, i)\n        Array::push(thunk_names_list, name)\n      }\n      if is_export {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = Array::slice([\n    \"None\",\n    \"Some\"\n  ], 0, 2)\n  let ctor_tags_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_field_counts_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_type_names_list = Array::slice([\n    \"Option\",\n    \"Option\"\n  ], 0, 2)\n  let mut type_index = 1\n  // type 0 = Option\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let struct_field_names = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields) => {\n        Array::push(struct_names, sname)\n        let fnames = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if String::equals(Array::get(fn_names_list, ei), entry_name) {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 {\n    throw(String::concat(\"entry function not found: \", entry_name))\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(selfhost_srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = Array::slice([\n    0\n  ], 0, 0)\n  let str_lengths = Array::slice([\n    0\n  ], 0, 0)\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let need_env_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::get\")\n  let need_env_args_len_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_len\")\n  let need_env_args_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_get\")\n  let need_fs_read_file_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::read_file\")\n  let need_fs_exists_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::exists\")\n  let need_fs_stat_token_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::stat_token\")\n  let need_fs_write_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::write_bytes\")\n  let mut next_import_idx = 1\n  let env_get_import_idx = if need_env_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_len_import_idx = if need_env_args_len_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_get_import_idx = if need_env_args_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_exists_import_idx = if need_fs_exists_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let num_imported_funcs = next_import_idx\n  let print_int_idx = num_imported_funcs\n  let print_str_idx = print_int_idx + 1\n  let str_len_idx = print_str_idx + 1\n  let str_eq_idx = str_len_idx + 1\n  let str_concat_idx = str_eq_idx + 1\n  let arr_new_idx = str_concat_idx + 1\n  let arr_len_idx = arr_new_idx + 1\n  let arr_get_idx = arr_len_idx + 1\n  let arr_push_idx = arr_get_idx + 1\n  let arr_set_idx = arr_push_idx + 1\n  let double_to_int_idx = arr_set_idx + 1\n  let int_to_double_idx = double_to_int_idx + 1\n  let str_char_code_at_idx = int_to_double_idx + 1\n  let str_from_char_code_idx = str_char_code_at_idx + 1\n  let str_substring_idx = str_from_char_code_idx + 1\n  let identity_idx = str_substring_idx + 1\n  let arr_slice_idx = identity_idx + 1\n  let arr_concat_idx = arr_slice_idx + 1\n  let arr_truncate_idx = arr_concat_idx + 1\n  let string_join_idx = arr_truncate_idx + 1\n  let fs_read_file_stub_idx = string_join_idx + 1\n  let fs_exists_stub_idx = fs_read_file_stub_idx + 1\n  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1\n  let fs_write_bytes_stub_idx = fs_stat_token_stub_idx + 1\n  let eq_idx = fs_write_bytes_stub_idx + 1\n  let string_ends_with_idx = eq_idx + 1\n  let string_last_index_of_idx = string_ends_with_idx + 1\n  let arr_push_all_idx = string_last_index_of_idx + 1\n  let selfhost_sources_idx = arr_push_all_idx + 1\n  let env_get_idx = if env_get_import_idx >= 0 { env_get_import_idx } else { fs_read_file_stub_idx }\n  let env_args_len_idx = if env_args_len_import_idx >= 0 { env_args_len_import_idx } else { fs_exists_stub_idx }\n  let env_args_get_idx = if env_args_get_import_idx >= 0 { env_args_get_import_idx } else { fs_read_file_stub_idx }\n  let fs_read_file_idx = if fs_read_file_import_idx >= 0 { fs_read_file_import_idx } else { fs_read_file_stub_idx }\n  let fs_exists_idx = if fs_exists_import_idx >= 0 { fs_exists_import_idx } else { fs_exists_stub_idx }\n  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 { fs_stat_token_import_idx } else { fs_stat_token_stub_idx }\n  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 { fs_write_bytes_import_idx } else { fs_write_bytes_stub_idx }\n  let builtin_defs = [\n    (\"Env::get\", 1, env_get_idx, 1),\n    (\"Env::args_len\", 0, env_args_len_idx, 1),\n    (\"Env::args_get\", 1, env_args_get_idx, 1),\n    (\"Fs::read_file\", 1, fs_read_file_idx, 1),\n    (\"Fs::exists\", 1, fs_exists_idx, 1),\n    (\"Fs::stat_token\", 1, fs_stat_token_idx, 1),\n    (\"Fs::write_bytes\", 2, fs_write_bytes_idx, 0),\n    (\"print_int\", 1, print_int_idx, 0),\n    (\"print_str\", 1, print_str_idx, 0),\n    (\"String::length\", 1, str_len_idx, 1),\n    (\"String::equals\", 2, str_eq_idx, 1),\n    (\"String::concat\", 2, str_concat_idx, 1),\n    (\"array_new\", 0, arr_new_idx, 1),\n    (\"Array::length\", 1, arr_len_idx, 1),\n    (\"Array::get\", 2, arr_get_idx, 1),\n    (\"Array::push\", 2, arr_push_idx, 0),\n    (\"Array::push_all\", 2, arr_push_all_idx, 0),\n    (\"Array::set\", 3, arr_set_idx, 0),\n    (\"Double::to_int\", 1, double_to_int_idx, 1),\n    (\"Int::to_double\", 1, int_to_double_idx, 1),\n    (\"String::char_code_at\", 2, str_char_code_at_idx, 1),\n    (\"String::from_char_code\", 1, str_from_char_code_idx, 1),\n    (\"String::substring\", 3, str_substring_idx, 1),\n    (\"Array::truncate\", 2, arr_truncate_idx, 0),\n    (\"String::join\", 2, string_join_idx, 1),\n    (\"eq\", 2, eq_idx, 1),\n    (\"String::ends_with\", 2, string_ends_with_idx, 1),\n    (\"String::last_index_of\", 2, string_last_index_of_idx, 1),\n    (\"selfhost_sources\", 0, selfhost_sources_idx, 1),\n    (\"ArrayBuilder::new\", 0, arr_new_idx, 1),\n    (\"ArrayBuilder::push\", 2, arr_push_idx, 0),\n    (\"ArrayBuilder::freeze\", 1, identity_idx, 1),\n    (\"Array::slice\", 3, arr_slice_idx, 1),\n    (\"Array::concat\", 2, arr_concat_idx, 1),\n    (\"Bytes::from_array\", 1, identity_idx, 1),\n    (\"Bytes::length\", 1, arr_len_idx, 1),\n    (\"Bytes::get\", 2, arr_get_idx, 1),\n    (\"Double::to_i64_bits\", 1, identity_idx, 1)\n  ]\n  let mut max_builtin_func_idx = num_imported_funcs - 1\n  let mut builtin_idx_i = 0\n  while builtin_idx_i < Array::length(builtin_defs) {\n    let (_, _, bwasm_idx, _) = Array::get(builtin_defs, builtin_idx_i)\n    if bwasm_idx > max_builtin_func_idx {\n      max_builtin_func_idx = bwasm_idx\n    }\n    builtin_idx_i = builtin_idx_i + 1\n  }\n  let num_generated = (max_builtin_func_idx - num_imported_funcs) + 1\n  let func_offset = num_imported_funcs + num_generated\n  let mut __bi = 0\n  while __bi < Array::length(builtin_defs) {\n    let (bname, bparams, _, _) = Array::get(builtin_defs, __bi)\n    Array::push(fn_names_list, bname)\n    Array::push(fn_param_counts, bparams)\n    __bi = __bi + 1\n  }\n  let fn_indices_list = Array::slice([\n    0\n  ], 0, 0)\n  let fn_returns_list = Array::slice([\n    0\n  ], 0, 0)\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  let mut __bi2 = 0\n  while __bi2 < Array::length(builtin_defs) {\n    let (_, _, bwasm_idx, breturns) = Array::get(builtin_defs, __bi2)\n    Array::push(fn_indices_list, bwasm_idx)\n    Array::push(fn_returns_list, breturns)\n    __bi2 = __bi2 + 1\n  }\n  let num_base_types = 9\n  let lt_w = LambdaTable::{\n    bodies: Array::slice([\n      Array::slice([\n        0\n      ], 0, 0)\n    ], 0, 0),\n    param_counts: Array::slice([\n      0\n    ], 0, 0),\n    captures: Array::slice([\n      Array::slice([\n        \"\"\n      ], 0, 0)\n    ], 0, 0),\n    meta_i32: Array::slice([\n      0\n    ], 0, 0),\n    meta_i64: Array::slice([\n      0\n    ], 0, 0)\n  }\n  let bodies = Array::slice([\n    Array::slice([\n      0\n    ], 0, 0)\n  ], 0, 0)\n  let meta_i32 = Array::slice([\n    0\n  ], 0, 0)\n  let meta_i64 = Array::slice([\n    0\n  ], 0, 0)\n  Array::push(bodies, gen_print_i64_body())\n  Array::push(meta_i32, 3)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, gen_print_str_body())\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_str_len_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_str_eq_body())\n  Array::push(meta_i32, 5)\n  Array::push(meta_i64, 0)\n  Arra