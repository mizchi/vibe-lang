mit_block_i64(buf)\n    emit_loop_void(buf)\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_const(buf, 0)\n      emit_i64_store(buf, 3, 0)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    bytebuf_push(buf, 31)\n    bytebuf_push(buf, 126)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    bytebuf_push(buf, catch_tag)\n    bytebuf_push(buf, 0)\n    let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    let raw_l = Array::length(local_names)\n    if needs_op_dispatch {\n      emit_local_set(buf, raw_l)\n      Array::push(local_names, \"__eff_raw\")\n    } else if is_pctor(catch_pat) {\n      let cargs = get_pctor_args(catch_pat)\n      let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(catch_pat))\n      if decl_arity > 1 {\n        let ptr_l = Array::length(local_names)\n        emit_local_set(buf, ptr_l)\n        Array::push(local_names, \"__eff_payload\")\n        let ncargs = Array::length(cargs)\n        let mut ci = 0\n        while ci < decl_arity {\n          if ci < ncargs {\n            let cp = Array::get(cargs, ci)\n            if is_pbind(cp) {\n              let pname = get_pbind_name(cp)\n              let fl = Array::length(local_names)\n              emit_local_get(buf, ptr_l)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              } else {\n                ()\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc {\n                8 + ci * 8\n              } else {\n                ci * 8\n              })\n              emit_local_set(buf, fl)\n              Array::push(local_names, pname)\n              if ctx.enable_rc {\n                emit_rc_dup_guarded(buf, fl, ctx.rc_shadow)\n              } else {\n                ()\n              }\n            } else if is_pwild(cp) {\n              ()\n            } else {\n              throw(\"handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)\")\n            }\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n          emit_local_get(buf, ptr_l)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else {\n          ()\n        }\n      } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n        let pname = get_pbind_name(Array::get(cargs, 0))\n        let bl = Array::length(local_names)\n        emit_local_set(buf, bl)\n        Array::push(local_names, pname)\n      } else {\n        emit_drop(buf)\n      }\n    } else if is_pbind(catch_pat) {\n      let pname = get_pbind_name(catch_pat)\n      let bl = Array::length(local_names)\n      emit_local_set(buf, bl)\n      Array::push(local_names, pname)\n    } else {\n      emit_drop(buf)\n    }\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_global_set(buf, g_cur)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    bytebuf_push(buf, 31)\n    bytebuf_push(buf, 126)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    let nl2 = if needs_op_dispatch {\n      let mut max_nl = Array::length(local_names)\n      let mut di = 0\n      while di < Array::length(arms) {\n        let (apat, abody) = Array::get(arms, di)\n        let aop = if is_pctor(apat) {\n          effect_op_index(ctx.effect_op_keys, get_pctor_name(apat))\n        } else {\n          0 - 1\n        }\n        emit_global_get(buf, g_op_idx_global)\n        emit_i64_const(buf, aop)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        t6_bind_from_raw(buf, apa