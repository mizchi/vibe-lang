it_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 5)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n    emit_local_get(b, 3)\n    emit_i32_const(b, 2)\n    emit_i32_mul(b)\n    emit_local_set(b, 7)\n    emit_global_get(b, 0)\n    emit_local_tee(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    emit_local_get(b, 2)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 6)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 6)\n    emit_local_set(b, 5)\n  emit_end(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 1)\n  emit_i64_store(b, 3, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\nlet gen_arr_set_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 2)\n  emit_i64_store(b, 3, 0)\n  b\n}\n\n// Generate __str_char_code_at body: (s: i64, idx: i64) -> i64\n// locals: 0=s(i64), 1=idx(i64), 2=offset(i32)\nlet gen_str_char_code_at_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// Generate __str_from_char_code body: (code: i64) -> i64\n// locals: 0=code(i64), 1=ptr(i32)\nlet gen_str_from_char_code_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 1)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 1)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_i64_const(b, 1)\n  emit_i64_or(b)\n  b\n}\n\n// Generate __str_substring body: (s: i64, start: i64, end: i64) -> i64\n// locals: 0=s(i64), 1=start(i64), 2=end(i64), 3=old_offset(i32), 4=new_len(i32)\nlet gen_str_substring_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_sub(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_i64_or(b)\n  b\n}\n\nlet gen_double_to_int_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_i64_trunc_f64_s(b)\n  b\n}\n\nlet gen_int_to_double_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_convert_i64_s(b)\n  emit_i64_reinterpret_f64(b)\n  b\n}\n\n// Generate __identity body (func 16): (val: i64) -> i64\nlet gen_identity_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  b\n}\n\n// === WASI Module compiler (GC backend) ===\n\nexport let compile_wasi_module_gc = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  // Collect user functions\n  let fn_names_list = Array::slice([\"\"], 0, 0)\n  let fn_param_counts = Array::slice([0], 0, 0)\n\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => {\n        match expr {\n          EFn(_, _, params, _, _, _) => {\n            Array::push(fn_names_list, name)\n            Array::push(fn_param_counts, Array::length(params))\n            0\n          },\n          _ => 0\n        }\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n\n  // Collect enum variant constructors with stable type-scoped tags\n  // Tag scheme: (type_index << 16) | variant_index\n  let ctor_names_list = Array::slice([\"None\", \"Some\"], 0, 2)\n  let ctor_tags_list = Array::slice([0, 1], 0, 2)\n  let ctor_field_counts_list = Array::slice([0, 1], 0, 2)\n  let ctor_type_names_list = Array::slice([\"Option\", \"Option\"], 0, 2)\n  let mut type_index = 1  // type 0 = Option\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index << 16) | vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index << 16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n\n  // Build struct field name index tables\n  let struct_names = Array::slice([\"\"], 0, 0)\n  let struct_field_names = Array::slice([Array::slice([\"\"], 0, 0)], 0, 0)\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields) => {\n        Array::push(struct_names, sname)\n        let fnames = Array::slice([\"\"], 0, 0)\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n\n  // Find entry function\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if String::equals(Array::get(fn_names_list, ei), entry_name) {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 {\n    throw(String::concat(\"entry function not found: \", entry_name))\n  }\n\n  // String table\n  let str_strs = collect_strings_stmts(stmts)\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = Array::slice([0], 0, 0)\n  let str_lengths = Array::slice([0], 0, 0)\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n\n  // Function layout:\n  // func 0: fd_write (import)\n  // func 1-16: generated builtins (16 funcs)\n  // func 17..17+N-1: user functions\n  // func 17+N: _start\n  let num_generated = 16\n  let func_offset = 1 + num_generated  // = 17\n\n  // Builtin table: (name, param_count, wasm_func_idx, has_return)\n  let builtin_defs = [\n    (\"print_int\",           1, 1,  0),\n    (\"print_str\",           1, 2,  0),\n    (\"String::length\",       1, 3,  1),\n    (\"String::equals\",       2, 4,  1),\n    (\"String::concat\",       2, 5,  1),\n    (\"array_new\",           0, 6,  1),\n    (\"Array::length\",        1, 7,  1),\n    (\"Array::get\",           2, 8,  1),\n    (\"Array::push\",          2, 9,  0),\n    (\"Array::set\",           3, 10, 0),\n    (\"Double::to_int\",       1, 11, 1),\n    (\"Int::to_double\",       1, 12, 1),\n    (\"String::char_code_at\", 2, 13, 1),\n    (\"String::from_char_code\", 1, 14, 1),\n    (\"String::substring\",    3, 15, 1),\n    // Aliases\n    (\"ArrayBuilder::new\",       0, 6,  1),\n    (\"ArrayBuilder::push\",  2, 9,  0),\n    (\"ArrayBuilder::freeze\", 1, 16, 1)\n  ]\n  let mut __bi = 0\n  while __bi < Array::length(builtin_defs) {\n    let (bname, bparams, _, _) = Array::get(builtin_defs, __bi)\n    Array::push(fn_names_list, bname)\n    Array::push(fn_param_counts, bparams)\n    __bi = __bi + 1\n  }\n\n  // Build fn_indices and fn_returns\n  let fn_indices_list = Array::slice([0], 0, 0)\n  let fn_returns_list = Array::slice([0], 0, 0)\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  // Builtin indices and returns (from builtin_defs table)\n  let mut __bi2 = 0\n  while __bi2 < Array::length(builtin_defs) {\n    let (_, _, bwasm_idx, breturns) = Array::get(builtin_defs, __bi2)\n    Array::push(fn_indices_list, bwasm_idx)\n    Array::push(fn_returns_list, breturns)\n    __bi2 = __bi2 + 1\n  }\n\n  // === Type section ===\n  // type 0-8: base func types\n  // type 9: struct { mut i64 } -- RefCell GC type\n  // type 10+: closure call types (i64^(N+1)) -> i64\n  let refcell_type_idx = 9\n  let closure_type_base = 10\n\n  // Lambda accumulators (populated during compilation)\n  let lt_w = LambdaTable::{\n    bodies: Array::slice([Array::slice([0], 0, 0)], 0, 0),\n    param_counts: Array::slice([0], 0, 0),\n    captures: Array::slice([Array::slice([\"\"], 0, 0)], 0, 0),\n    meta_i32: Array::slice([0], 0, 0),\n    meta_i64: Array::slice([0], 0, 0)\n  }\n\n  // === Code section bodies ===\n  let bodies = Array::slice([Array::slice([0], 0, 0)], 0, 0)\n  let meta_i32 = Array::slice([0], 0, 0)\n  let meta_i64 = Array::slice([0], 0, 0)\n  // Track which user func bodies have ref locals (for mixed local declarations)\n  let user_ref_local_indices_all = Array::slice([Array::slice([0], 0, 0)], 0, 0)\n\n  // Builtin bodies\n  Array::push(bodies, gen_print_i64_body())\n  Array::push(meta_i32, 3)\n  Array::push(meta_i64, 1)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_print_str_body())\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_str_len_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_str_eq_body())\n  Array::push(meta_i32, 5)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_str_concat_body())\n  Array::push(meta_i32, 6)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_arr_new_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_arr_len_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_arr_get_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_arr_push_body())\n  Array::push(meta_i32, 6)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_arr_set_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_double_to_int_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_int_to_double_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_str_char_code_at_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_str_from_char_code_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_str_substring_body())\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  Array::push(bodies, gen_identity_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  // Compile user function bodies (with __env param for table compatibility)\n  let mut bi = 0\n  while bi < num_user_funcs {\n    let stmt = find_func_stmt(stmts, Array::get(fn_names_list, bi))\n    match stmt {\n      SLet(_, _, _, _, expr) => {\n        match expr {\n          EFn(_, _, params, _, _, body) => {\n            let body_buf = bytebuf_new()\n            let local_names = Array::slice([\"\"], 0, 0)\n            let mut ppi = 0\n            while ppi < Array::length(params) {\n              let (pname, _) = Array::get(params, ppi)\n              Array::push(local_names, pname)\n              ppi = ppi + 1\n            }\n            Array::push(local_names, \"__env\")\n            let param_count = Array::length(params) + 1  // includes __env\n            let ref_cell_names_f = Array::slice([\"\"], 0, 0)\n            let ref_local_indices_f = Array::slice([0], 0, 0)\n            let ft = FuncTable::{ names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list }\n            let st = StrTable::{ strs: str_strs, offsets: str_offsets, lengths: str_lengths }\n            let ct = CtorTable::{ names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names }\n            let func_ctx = CompileCtxGc::{\n              func_table: ft, str_table: st, lambda_table: lt_w,\n              num_user_funcs: num_user_funcs, func_offset: func_offset,\n              ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,\n              refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\n              ctor_table: ct\n            }\n            let final_nl = compile_expr_gc(\n              body_buf, body, local_names,\n              param_count,\n              func_ctx, -1\n            )\n            Array::push(bodies, body_buf)\n            let extra = if final_nl > param_count { final_nl - param_count } else { 0 }\n            Array::push(meta_i32, 0)\n            Array::push(meta_i64, extra)\n            Array::push(user_ref_local_indices_all, ref_local_indices_f)\n          },\n          _ => throw(\"expected function\")\n        }\n      },\n      _ => throw(\"expected let statement\")\n    }\n    bi = bi + 1\n  }\n\n  let num_lambdas = Array::length(lt_w.bodies)\n\n  // _start body\n  let start_body = bytebuf_new()\n  let entry_func_idx = entry_user_idx + func_offset\n  let entry_params = Array::get(fn_param_counts, entry_user_idx)\n  if entry_params != 0 {\n    throw(\"WASI entry function must take 0 parameters\")\n  }\n  emit_i64_const(start_body, 0)  // env=0 for user func\n  emit_call(start_body, entry_func_idx)\n  emit_call(start_body, 1)  // __print_i64\n  Array::push(bodies, start_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n\n  // Append lambda bodies after _start\n  let mut li = 0\n  while li < num_lambdas {\n    Array::push(bodies, Array::get(lt_w.bodies, li))\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\n    Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))\n    li = li + 1\n  }\n\n  // Determine max closure call arity\n  let mut max_closure_arity = -1\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  let mut uai2 = 0\n  while uai2 < num_user_funcs {\n    let upc = Array::get(fn_param_counts, uai2)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai2 = uai2 + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 { max_closure_arity + 1 } else { 0 }\n\n  // === Type section ===\n  let num_base_types = 10  // 0-8 func types + 9 struct\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\n\n  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])  // type 0: fd_write\n  emit_func_type_raw(type_content, [126], Array::slice([0], 0, 0))  // type 1: (i64)->()\n  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))  // type 2: ()->()\n  emit_func_type_raw(type_content, [126], [126])  // type 3: (i64)->(i64)\n  emit_func_type_raw(type_content, [126, 126], [126])  // type 4: (i64,i64)->(i64)\n  emit_func_type_raw(type_content, Array::slice([0], 0, 0), [126])  // type 5: ()->(i64)\n  emit_func_type_raw(type_content, [126, 126], Array::slice([0], 0, 0))  // type 6: (i64,i64)->()\n  emit_func_type_raw(type_content, [126, 126, 126], Array::slice([0], 0, 0))  // type 7: (i64,i64,i64)->()\n  emit_func_type_raw(type_content, [126, 126, 126], [126])  // type 8: (i64,i64,i64)->(i64)\n\n  // type 9: struct { mut i64 }\n  emit_struct_type_raw(type_content, [126], [1])\n\n  // Closure call types: (i64^(N+1)) -> i64 for N = 0..max_closure_arity\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1  // N user params + 1 env\n    let ct_params = Array::slice([0], 0, 0)\n    let mut cpti = 0\n    while cpti < num_params {\n      Array::push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [126])\n    cti = cti + 1\n  }\n\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n\n  // === Import section ===\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n\n  // === Function section ===\n  let func_type_indices = Array::slice([0], 0, 0)\n  Array::push(func_type_indices, 1)  // __print_i64\n  Array::push(func_type_indices, 1)  // __print_str\n  Array::push(func_type_indices, 3)  // __str_len\n  Array::push(func_type_indices, 4)  // __str_eq\n  Array::push(func_type_indices, 4)  // __str_concat\n  Array::push(func_type_indices, 5)  // __arr_new\n  Array::push(func_type_indices, 3)  // __arr_len\n  Array::push(func_type_indices, 4)  // __arr_get\n  Array::push(func_type_indices, 6)  // __arr_push\n  Array::push(func_type_indices, 7)  // __arr_set\n  Array::push(func_type_indices, 3)  // __double_to_int\n  Array::push(func_type_indices, 3)  // __int_to_double\n  Array::push(func_type_indices, 4)  // __str_char_code_at\n  Array::push(func_type_indices, 3)  // __str_from_char_code\n  Array::push(func_type_indices, 8)  // __str_substring\n  Array::push(func_type_indices, 3)  // __identity (ArrayBuilder::freeze)\n  // User funcs: type = closure call type for their arity (includes env)\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(fn_param_counts, fti)\n    Array::push(func_type_indices, closure_type_base + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)  // _start\n  // Lambda function type indices\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, closure_type_base + lam_user_params)\n    lfi = lfi + 1\n  }\n  emit_function_section(out, func_type_indices)\n\n  // === Table section ===\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n\n  // === Memory section ===\n  emit_memory_section(out, 1)\n\n  // === Global section: heap_ptr ===\n  emit_global_section_i32_mut(out, heap_start)\n\n  // === Export section ===\n  let start_func_idx = func_offset + num_user_funcs\n  emit_exports_with_memory(out, [\"_start\"], [start_func_idx], \"memory\", 0)\n\n  // === Element section ===\n  if total_table_entries > 0 {\n    let table_func_indices = Array::slice([0], 0, 0)\n    let mut tei = 0\n    while tei < num_user_funcs {\n      Array::push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      Array::push(table_func_indices, start_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n\n  // === Encode code section with mixed locals (i64 and ref types) ===\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    let ref_indices = Array::get(user_ref_local_indices_all, ci)\n    let num_ref_locals = Array::length(ref_indices)\n\n    if num_ref_locals == 0 {\n      if ni32 == 0 {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 0)\n        } else {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)  // i64\n        }\n      } else {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)  // i32\n        } else {\n          leb128_encode_u32(func_buf, 2)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)  // i32\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)  // i64\n        }\n      }\n    } else {\n      // Has ref locals — emit individual local declarations\n      let body_idx_in_user = ci - num_generated\n      let param_count_for_body = Array::get(fn_param_counts, body_idx_in_user) + 1  // +1 for __env\n      let num_extra = ni64\n      leb128_encode_u32(func_buf, num_extra)\n      let mut rli = 0\n      while rli < num_extra {\n        let actual_local_idx = param_count_for_body + rli\n        let mut is_ref = false\n        let mut ri = 0\n        while ri < num_ref_locals {\n          if Array::get(ref_indices, ri) == actual_local_idx {\n            is_ref = true\n          }\n          ri = ri + 1\n        }\n        leb128_encode_u32(func_buf, 1)\n        if is_ref {\n          bytebuf_push(func_buf, 100)  // 0x64 = ref\n          leb128_encode_u32(func_buf, refcell_type_idx)\n        } else {\n          bytebuf_push(func_buf, 126)  // i64\n        }\n        rli = rli + 1\n      }\n    }\n\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)  // end\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_array(code_content, func_buf)\n    ci = ci + 1\n  }\n\n  bytebuf_push_section(out, 10, code_content)\n\n  // === Data section ===\n  if num_strings > 0 {\n    let data_offsets = Array::slice([0], 0, 0)\n    let data_bufs = Array::slice([Array::slice([0], 0, 0)], 0, 0)\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n\n  bytebuf_to_bytes(out)\n}\n")

  let source_42 = ("vibe/compiler/codegen/index.vibe",
"//# Imports\n\nimport ../core/index.vibe {\n  Stmt\n}\n\nimport ./expr/index.vibe {\n  compile_module_expr\n}\n\nimport ./wasi/index.vibe {\n  compile_wasi_module_impl,\n  compile_wasi_module_with_sources_impl\n}\n\n//# Functions\n\nexport let compile_module = (stmts: Array[Stmt]) -> Bytes with { Error } {\n  compile_module_expr(stmts)\n}\n\nexport let compile_wasi_module_with_sources = (stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_impl(stmts, entry_name, selfhost_srcs)\n}\n\nexport let compile_wasi_module = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_impl(stmts, entry_name)\n}\n")

