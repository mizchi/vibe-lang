//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

import ./parser_test_support.vibe {
  parse_print
}

import ./printer.vibe {
  print_program
}

//# Misc

test "parse comparison" {
  let result = handle {
    parse_print("a == b")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(a == b)")
}

test "parse qualified import/export names" {
  // Regression: import/export lists accept qualified `Ns::member` items
  // (e.g. `Int::abs`, `JsonSchema::validate`) — used by prelude/index.vibe
  // and vibe/x/index.vibe aggregators (#492).
  let imp = handle {
    let _ = parse_program(lex("import ./x.vibe { Foo::bar, baz as qux }\n0"))
    "ok"
  } with Error {
    Throw(_) => "threw"
  }
  assert(imp == "ok")
  let exp = handle {
    let _ = parse_program(lex("export ./x.vibe { A::b }\n0"))
    "ok"
  } with Error {
    Throw(_) => "threw"
  }
  assert(exp == "ok")
}

test "parse generic impl" {
  // Regression: impl statements accept a type-parameter header with bounds
  // and a generic target type, e.g. `impl [T: Eq] Eq for Option[T]` — used by
  // vibe/prelude/option.vibe (#492).
  let ok = handle {
    let _ = parse_program(lex("trait Eq\nimpl Eq for Int\nimpl [T: Eq] Eq for Option[T]\n0"))
    "ok"
  } with Error {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "parse generic struct" {
  // Regression: struct declarations accept a type-parameter header
  // `struct Foo[T] { ... }` (and `[A, B]`) — used by vibe/prelude/string_view.vibe
  // (`struct ArrayView[T]`) (#492).
  let ok = handle {
    let _ = parse_program(lex("struct Box[T] { v: T }\nstruct Pair[A, B] { fst: A; snd: B }\n0"))
    "ok"
  } with Error {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "parse array trailing comma" {
  // Regression: array literals accept a trailing comma `[a, b,]` — used by
  // vibe/x/args/demo.vibe. Previously surfaced as a misleading
  // `unexpected token: ->` downstream parse error (#492).
  let ok = handle {
    let _ = parse_program(lex("let xs = [\"a\", \"b\", \"c\",]\nArray::length(xs)"))
    "ok"
  } with Error {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "parse tuple and call trailing comma" {
  // Regression: tuples `(a, b,)` and call argument lists `f(a, b,)` accept a
  // trailing comma — used by vibe/x/scan/scan.vibe. Previously surfaced as
  // `expected ')' or ','` (#492).
  let tup = handle {
    let _ = parse_program(lex("let t = (1, 2,)\nlet (a, b) = t\na + b"))
    "ok"
  } with Error {
    Throw(_) => "threw"
  }
  assert(tup == "ok")
  let call = handle {
    let _ = parse_program(lex("let add = (a: Int, b: Int) -> Int { a + b }\nadd(1, 2,)"))
    "ok"
  } with Error {
    Throw(_) => "threw"
  }
  assert(call == "ok")
}

test "parse generic type alias" {
  // Regression: type aliases accept a type-parameter header
  // `type Foo[T] = ...` — used by vibe/prelude/string_parser.vibe
  // (`type ParseResult[T] = Option[(T, Int)]`) (#492).
  let ok = handle {
    let _ = parse_program(lex("type ParseResult[T] = Option[(T, Int)]\ntype Pair[A, B] = (A, B)\n0"))
    "ok"
  } with Error {
    Throw(_) => "threw"
  }
  assert(ok == "ok")
}

test "parse logical" {
  let result = handle {
    parse_print("a && b || c")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "((a && b) || c)")
}

test "parse import trailing comma" {
  let ok = handle {
    let program = parse_program(lex("import ../../syntax/lexer.vibe {\n  lex,\n}"))
    print_program(program) == "import ../../syntax/lexer.vibe { lex }"
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse re-export trailing comma" {
  let ok = handle {
    let program = parse_program(lex("export ./syntax/parser.vibe {\n  parse,\n}"))
    print_program(program) == "export ./syntax/parser.vibe { parse }"
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse unary negate in expr" {
  let ok = handle {
    let _ = parse_print("1 + (-x)")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse unary not in expr" {
  let ok = handle {
    let _ = parse_print("if !done { 1 } else { 0 }")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse nested if" {
  let ok = handle {
    let _ = parse_print("if a { if b { 1 } else { 2 } } else { 3 }")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse match" {
  let ok = handle {
    let _ = parse_print("match x { 1 => a, 2 => b, _ => c }")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse tuple" {
  let result = handle {
    parse_print("(1, 2, 3)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(1, 2, 3)")
}

test "parse array" {
  let result = handle {
    parse_print("[1, 2, 3]")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "[1, 2, 3]")
}

test "parse lambda" {
  let ok = handle {
    let _ = parse_print("(x) -> x + 1")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse method call" {
  let result = handle {
    parse_print("Foo::bar(x)")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "Foo::bar(x)")
}

test "parse pipe" {
  let ok = handle {
    let _ = parse_print("x |> f |> g")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse bitwise ops" {
  let ok = handle {
    let _ = parse_print("a & b | c ^ d")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse string interp" {
  let ok = handle {
    let _ = parse_print("\"hello \\{name}\"")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse let program" {
  let ok = handle {
    let program = parse_program(lex("let x = 1\nlet y = x + 2"))
    String::length(print_program(program)) > 0
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse enum decl" {
  let ok = handle {
    let program = parse_program(lex("enum Color { Red; Green; Blue }"))
    String::length(print_program(program)) > 0
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse struct decl" {
  let ok = handle {
    let program = parse_program(lex("struct Point { x: Int; y: Int }"))
    String::length(print_program(program)) > 0
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse for in" {
  let ok = handle {
    let _ = parse_print("for x in arr { x * 2 }")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "parse handle" {
  let ok = handle {
    let _ = parse_print("handle { throw(\"err\") } with Error { Throw(msg) => msg }")
    true
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}
