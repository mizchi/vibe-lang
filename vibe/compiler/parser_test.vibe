//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

import ./parser_test_support.vibe {
  parse_print
}

import ./printer.vibe {
  print_program
}

//# Misc

test "parse comparison" {
  let result = handle {
    parse_print("a == b")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(a == b)")
}

test "parse logical" {
  let result = handle {
    parse_print("a && b || c")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(result == "((a && b) || c)")
}

test "parse import trailing comma" {
  let ok = handle {
    let program = parse_program(lex("import ../../syntax/lexer.vibe {\n  lex,\n}"))
    print_program(program) == "import ../../syntax/lexer.vibe { lex }"
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse re-export trailing comma" {
  let ok = handle {
    let program = parse_program(lex("export ./syntax/parser.vibe {\n  parse,\n}"))
    print_program(program) == "export ./syntax/parser.vibe { parse }"
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse unary negate in expr" {
  let ok = handle {
    let _ = parse_print("1 + (-x)")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse unary not in expr" {
  let ok = handle {
    let _ = parse_print("if !done { 1 } else { 0 }")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse nested if" {
  let ok = handle {
    let _ = parse_print("if a { if b { 1 } else { 2 } } else { 3 }")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse match" {
  let ok = handle {
    let _ = parse_print("match x { 1 => a, 2 => b, _ => c }")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse tuple" {
  let result = handle {
    parse_print("(1, 2, 3)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(result == "(1, 2, 3)")
}

test "parse array" {
  let result = handle {
    parse_print("[1, 2, 3]")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(result == "[1, 2, 3]")
}

test "parse lambda" {
  let ok = handle {
    let _ = parse_print("(x) -> x + 1")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse method call" {
  let result = handle {
    parse_print("Foo::bar(x)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(result == "Foo::bar(x)")
}

test "parse pipe" {
  let ok = handle {
    let _ = parse_print("x |> f |> g")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse bitwise ops" {
  let ok = handle {
    let _ = parse_print("a & b | c ^ d")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse string interp" {
  let ok = handle {
    let _ = parse_print("\"hello \\{name}\"")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse let program" {
  let ok = handle {
    let program = parse_program(lex("let x = 1\nlet y = x + 2"))
    String::length(print_program(program)) > 0
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse enum decl" {
  let ok = handle {
    let program = parse_program(lex("enum Color { Red; Green; Blue }"))
    String::length(print_program(program)) > 0
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse struct decl" {
  let ok = handle {
    let program = parse_program(lex("struct Point { x: Int; y: Int }"))
    String::length(print_program(program)) > 0
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse for in" {
  let ok = handle {
    let _ = parse_print("for x in arr { x * 2 }")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse handle" {
  let ok = handle {
    let _ = parse_print("handle { throw(\"err\") } { Error(msg) => msg }")
    true
  } {
    Error(_) => false
  }
  assert(ok)
}
