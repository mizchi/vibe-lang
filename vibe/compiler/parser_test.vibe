import ./parser_test_support.vibe {
  parse_print
}

//# Misc
test "parse comparison" {
  let result = handle {
    parse_print("a == b")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(a == b)"))
}

test "parse logical" {
  let result = handle {
    parse_print("a && b || c")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "((a && b) || c)"))
}

test "parse fn" {
  let result = handle {
    parse_print("(x) -> x")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(x) -> x"))
}

test "parse fn with type" {
  let result = handle {
    parse_print("(x: Int) -> x")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(x: Int) -> x"))
}

test "parse array" {
  let result = handle {
    parse_print("[1, 2, 3]")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "[1, 2, 3]"))
}

test "parse tuple" {
  let result = handle {
    parse_print("(1, 2)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(1, 2)"))
}

test "parse unit" {
  let result = handle {
    parse_print("()")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "()"))
}
