//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  Expr, Pat, parse, parse_expr, parse_ok
}

import ./printer.vibe {
  print_expr, print_pat
}

import ./token.vibe {
  Token
}

//# Functions

let parse_print = (src: String) -> String with { Error } {
  let tokens = lex(src)
  let expr = parse(tokens)
  print_expr(expr)
}

//# Misc

test "parse int" {
  let result = handle {
    parse_print("42")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "42"))
}

test "parse string" {
  let result = handle {
    parse_print("\"hello\"")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "\"hello\""))
}

test "parse bool true" {
  let result = handle {
    parse_print("true")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "true"))
}

test "parse bool false" {
  let result = handle {
    parse_print("false")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "false"))
}

test "parse ident" {
  let result = handle {
    parse_print("foo")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "foo"))
}

test "parse add" {
  let result = handle {
    parse_print("1 + 2")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(1 + 2)"))
}

test "parse mul" {
  let result = handle {
    parse_print("3 * 4")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(3 * 4)"))
}

test "parse precedence" {
  let result = handle {
    parse_print("1 + 2 * 3")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(1 + (2 * 3))"))
}

test "parse left assoc" {
  let result = handle {
    parse_print("1 + 2 + 3")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "((1 + 2) + 3)"))
}

test "parse parens" {
  let result = handle {
    parse_print("(1 + 2) * 3")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "((1 + 2) * 3)"))
}

test "parse unary minus" {
  let result = handle {
    parse_print("-1")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(-1)"))
}

test "parse unary not" {
  let result = handle {
    parse_print("!x")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(!x)"))
}

test "parse call" {
  let result = handle {
    parse_print("f(1, 2)")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "f(1, 2)"))
}

test "parse call no args" {
  let result = handle {
    parse_print("f()")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "f()"))
}

test "parse dot" {
  let result = handle {
    parse_print("a.b.c")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "a.b.c"))
}

test "parse pipe" {
  let result = handle {
    parse_print("x |> f |> g")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "g(f(x))"))
}

test "parse pipe with args" {
  let result = handle {
    parse_print("x |> f(1, 2)")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "f(x, 1, 2)"))
}

test "parse pipe mixed left without parens error" {
  let result = handle {
    parse_print("1 + 1 |> f")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "ERROR: cannot mix '|>' with other infix operators without explicit parentheses"))
}

test "parse pipe mixed right without parens error" {
  let result = handle {
    parse_print("x |> f + g")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "ERROR: cannot mix '|>' with other infix operators without explicit parentheses"))
}

test "parse pipe mixed with parens ok" {
  let result = handle {
    parse_print("(1 + 1) |> f")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "f((1 + 1))"))
}

test "parse comparison" {
  let result = handle {
    parse_print("a == b")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(a == b)"))
}

test "parse logical" {
  let result = handle {
    parse_print("a && b || c")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "((a && b) || c)"))
}

test "parse if" {
  let result = handle {
    parse_print("if true { 1 } else { 2 }")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "if true { 1 } else { 2 }"))
}

test "parse while" {
  let result = handle {
    parse_print("while x < 10 { x = x + 1; x }")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "while (x < 10) { x = (x + 1); x }"))
}

test "parse for in" {
  let result = handle {
    parse_print("for item in items { item }")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "for item in items { item }"))
}

test "parse handle" {
  let result = handle {
    parse_print("handle { f() } { Error(msg) => msg }")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "handle { f() } { Error(msg) => msg }"))
}

test "parse fn" {
  let result = handle {
    parse_print("(x) -> x")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(x) -> x"))
}

test "parse fn with type" {
  let result = handle {
    parse_print("(x: Int) -> x")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(x: Int) -> x"))
}

test "parse block let" {
  let result = handle {
    parse_print("{ let x = 1; x }")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "let x = 1; x"))
}

test "parse match" {
  let result = handle {
    parse_print("match x { 1 => true, _ => false }")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "match x { 1 => true, _ => false }"))
}

test "parse array" {
  let result = handle {
    parse_print("[1, 2, 3]")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "[1, 2, 3]"))
}

test "parse tuple" {
  let result = handle {
    parse_print("(1, 2)")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "(1, 2)"))
}

test "parse unit" {
  let result = handle {
    parse_print("()")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "()"))
}

test "parse complex" {
  let ok = parse_ok(lex("if x > 0 { f(x - 1) } else { 0 }"))
  assert(ok)
}

test "parse throw" {
  let result = handle {
    parse_print("throw(\"error\")")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "throw(\"error\")"))
}

test "parse break" {
  let result = handle {
    let tokens = lex("{ while true { break } }")
    let expr = parse(tokens)
    print_expr(expr)
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "while true { break }"))
}

test "parse break with value" {
  let result = handle {
    let tokens = lex("{ while true { break 42 } }")
    let expr = parse(tokens)
    print_expr(expr)
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "while true { break 42 }"))
}

test "parse continue" {
  let result = handle {
    let tokens = lex("{ while true { continue } }")
    let expr = parse(tokens)
    print_expr(expr)
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "while true { continue }"))
}

test "parse continue with args" {
  let result = handle {
    let tokens = lex("{ while true { continue(1, 2) } }")
    let expr = parse(tokens)
    print_expr(expr)
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "while true { continue(1, 2) }"))
}

test "parse else expr without braces" {
  let result = handle {
    parse_print("if true { 1 } else 2")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "if true { 1 } else { 2 }"))
}

test "parse else if else expr without braces" {
  let result = handle {
    parse_print("if x { 1 } else if y { 2 } else 3")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "if x { 1 } else { if y { 2 } else { 3 } }"))
}

test "parse else call expr without braces" {
  let result = handle {
    parse_print("if cond { x } else f(y)")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "if cond { x } else { f(y) }"))
}

test "parse let destructure tuple" {
  let result = handle {
    parse_print("{ let (a, b) = pair; a }")
  } {
    Error(e) => string_concat("ERROR: ", e)
  }
  assert(string_equals(result, "match pair { (a, b) => a }"))
}

test "parse raise error" {
  let ok = parse_ok(lex("raise \"error\""))
  assert(ok == false)
}

test "parse return error" {
  let ok = parse_ok(lex("return 1"))
  assert(ok == false)
}

test "parse do error" {
  let ok = parse_ok(lex("do { 1 }"))
  assert(ok == false)
}

test "parse loop error" {
  let ok = parse_ok(lex("loop { 1 }"))
  assert(ok == false)
}

test "parse yield error" {
  let ok = parse_ok(lex("yield 1"))
  assert(ok == false)
}

test "parse declare error" {
  let ok = parse_ok(lex("declare let x: Int"))
  assert(ok == false)
}
