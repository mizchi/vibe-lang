//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_ok
}

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse int" {
  let result = handle {
    parse_print("42")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "42"))
}

test "parse string" {
  let result = handle {
    parse_print("\"hello\"")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "\"hello\""))
}

test "parse bool true" {
  let result = handle {
    parse_print("true")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "true"))
}

test "parse bool false" {
  let result = handle {
    parse_print("false")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "false"))
}

test "parse ident" {
  let result = handle {
    parse_print("foo")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "foo"))
}

test "parse add" {
  let result = handle {
    parse_print("1 + 2")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(1 + 2)"))
}

test "parse mul" {
  let result = handle {
    parse_print("3 * 4")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(3 * 4)"))
}

test "parse precedence" {
  let result = handle {
    parse_print("1 + 2 * 3")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(1 + (2 * 3))"))
}

test "parse left assoc" {
  let result = handle {
    parse_print("1 + 2 + 3")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "((1 + 2) + 3)"))
}

test "parse parens" {
  let result = handle {
    parse_print("(1 + 2) * 3")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "((1 + 2) * 3)"))
}

test "parse unary minus" {
  let result = handle {
    parse_print("-1")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(-1)"))
}

test "parse unary not" {
  let result = handle {
    parse_print("!x")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(!x)"))
}

test "parse call" {
  let result = handle {
    parse_print("f(1, 2)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "f(1, 2)"))
}

test "parse call no args" {
  let result = handle {
    parse_print("f()")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "f()"))
}

test "parse dot" {
  let result = handle {
    parse_print("a.b.c")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "a.b.c"))
}

test "parse namespace call" {
  let result = handle {
    parse_print("String::length(s)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "String::length(s)"))
}

test "parse pipe" {
  let result = handle {
    parse_print("x |> f |> g")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "g(f(x))"))
}

test "parse pipe with args" {
  let result = handle {
    parse_print("x |> f(1, 2)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "f(x, 1, 2)"))
}

test "parse pipe mixed left without parens error" {
  let result = handle {
    parse_print("1 + 1 |> f")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "ERROR: cannot mix '|>' with other infix operators without explicit parentheses"))
}

test "parse pipe mixed right without parens error" {
  let result = handle {
    parse_print("x |> f + g")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "ERROR: cannot mix '|>' with other infix operators without explicit parentheses"))
}

test "parse pipe mixed with parens ok" {
  let result = handle {
    parse_print("(1 + 1) |> f")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "f((1 + 1))"))
}

test "parse comparison" {
  let result = handle {
    parse_print("a == b")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(a == b)"))
}

test "parse logical" {
  let result = handle {
    parse_print("a && b || c")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "((a && b) || c)"))
}

test "parse if" {
  let result = handle {
    parse_print("if true { 1 } else { 2 }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "if true { 1 } else { 2 }"))
}

test "parse while" {
  let result = handle {
    parse_print("while x < 10 { x = x + 1; x }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "while (x < 10) { { x = (x + 1); x } }"))
}

test "parse for in" {
  let result = handle {
    parse_print("for item in items { item }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "for item in items { item }"))
}

test "parse handle" {
  let result = handle {
    parse_print("handle { f() } { Error(msg) => msg }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "handle { f() } { Error(msg) => msg }"))
}

test "parse fn" {
  let result = handle {
    parse_print("(x) -> x")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(x) -> x"))
}

test "parse fn with type" {
  let result = handle {
    parse_print("(x: Int) -> x")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(x: Int) -> x"))
}

test "parse block let" {
  let result = handle {
    parse_print("{ let x = 1; x }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "{ let x = 1; x }"))
}

test "parse match" {
  let result = handle {
    parse_print("match x { 1 => true, _ => false }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "match x { 1 => true, _ => false }"))
}

test "parse array" {
  let result = handle {
    parse_print("[1, 2, 3]")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "[1, 2, 3]"))
}

test "parse tuple" {
  let result = handle {
    parse_print("(1, 2)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(1, 2)"))
}

test "parse unit" {
  let result = handle {
    parse_print("()")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "()"))
}
