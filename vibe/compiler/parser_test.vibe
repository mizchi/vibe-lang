use ./token.vibe { Token }
use ./parser.vibe { Expr, Pat, parse, parse_ok, parse_expr }
use ./printer.vibe { print_expr, print_pat }
use ./lexer.vibe { lex }

// Helper: parse source string and print result
let parse_print = (src: String) -> String with { Error } {
  let tokens = lex(src)
  let expr = parse(tokens)
  print_expr(expr)
}

test "parse int" {
  let result = handle { parse_print("42") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "42"))
}

test "parse string" {
  let result = handle { parse_print("\"hello\"") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "\"hello\""))
}

test "parse bool true" {
  let result = handle { parse_print("true") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "true"))
}

test "parse bool false" {
  let result = handle { parse_print("false") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "false"))
}

test "parse ident" {
  let result = handle { parse_print("foo") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "foo"))
}

test "parse add" {
  let result = handle { parse_print("1 + 2") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(1 + 2)"))
}

test "parse mul" {
  let result = handle { parse_print("3 * 4") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(3 * 4)"))
}

test "parse precedence" {
  let result = handle { parse_print("1 + 2 * 3") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(1 + (2 * 3))"))
}

test "parse left assoc" {
  let result = handle { parse_print("1 + 2 + 3") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "((1 + 2) + 3)"))
}

test "parse parens" {
  let result = handle { parse_print("(1 + 2) * 3") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "((1 + 2) * 3)"))
}

test "parse unary minus" {
  let result = handle { parse_print("-1") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(-1)"))
}

test "parse unary not" {
  let result = handle { parse_print("!x") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(!x)"))
}

test "parse call" {
  let result = handle { parse_print("f(1, 2)") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "f(1, 2)"))
}

test "parse call no args" {
  let result = handle { parse_print("f()") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "f()"))
}

test "parse dot" {
  let result = handle { parse_print("a.b.c") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "a.b.c"))
}

test "parse pipe" {
  let result = handle { parse_print("x |> f |> g") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "((x |> f) |> g)"))
}

test "parse comparison" {
  let result = handle { parse_print("a == b") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(a == b)"))
}

test "parse logical" {
  let result = handle { parse_print("a && b || c") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "((a && b) || c)"))
}

test "parse if" {
  let result = handle { parse_print("if true { 1 } else { 2 }") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "if true { 1 } else { 2 }"))
}

test "parse fn" {
  let result = handle { parse_print("(x) -> x") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(x) -> x"))
}

test "parse fn with type" {
  let result = handle { parse_print("(x: Int) -> x") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(x: Int) -> x"))
}

test "parse block let" {
  let result = handle { parse_print("{ let x = 1; x }") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "let x = 1; x"))
}

test "parse match" {
  let result = handle { parse_print("match x { 1 => true, _ => false }") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "match x { 1 => true, _ => false }"))
}

test "parse array" {
  let result = handle { parse_print("[1, 2, 3]") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "[1, 2, 3]"))
}

test "parse tuple" {
  let result = handle { parse_print("(1, 2)") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "(1, 2)"))
}

test "parse unit" {
  let result = handle { parse_print("()") } { Error(e) => string_concat("ERROR: ", e) }
  assert(string_equals(result, "()"))
}

test "parse complex" {
  let ok = parse_ok(lex("if x > 0 { f(x - 1) } else { 0 }"))
  assert(ok)
}
