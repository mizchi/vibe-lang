//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

import ./parser_test_support.vibe {
  parse_print
}

import ./printer.vibe {
  print_program
}

//# Misc

test "parse comparison" {
  let result = handle {
    parse_print("a == b")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(a == b)"))
}

test "parse logical" {
  let result = handle {
    parse_print("a && b || c")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "((a && b) || c)"))
}

test "parse import trailing comma" {
  let ok = handle {
    let program = parse_program(lex("import ../../syntax/lexer.vibe {\n  lex,\n}"))
    String::equals(print_program(program), "import ../../syntax/lexer.vibe { lex }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "parse re-export trailing comma" {
  let ok = handle {
    let program = parse_program(lex("export ./syntax/parser.vibe {\n  parse,\n}"))
    String::equals(print_program(program), "export ./syntax/parser.vibe { parse }")
  } {
    Error(_) => false
  }
  assert(ok)
}
