import ./bytebuf.vibe {
  bytebuf_new,
  bytebuf_push,
  bytebuf_length,
  bytebuf_to_bytes,
  bytebuf_push_section,
  leb128_encode_u32,
  leb128_encode_s32
}

test "bytebuf basic" {
  let buf = bytebuf_new()
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 255)
  bytebuf_push(buf, 42)
  assert(bytebuf_length(buf) == 3)
  let bytes = bytebuf_to_bytes(buf)
  assert(bytes_length(bytes) == 3)
  assert(bytes_get(bytes, 0) == 0)
  assert(bytes_get(bytes, 1) == 255)
  assert(bytes_get(bytes, 2) == 42)
}

test "leb128 unsigned" {
  let buf = bytebuf_new()
  leb128_encode_u32(buf, 0)
  assert(bytebuf_length(buf) == 1)
  assert(bytes_get(bytebuf_to_bytes(buf), 0) == 0)

  let buf2 = bytebuf_new()
  leb128_encode_u32(buf2, 128)
  assert(bytebuf_length(buf2) == 2)
  let b2 = bytebuf_to_bytes(buf2)
  assert(bytes_get(b2, 0) == 128)
  assert(bytes_get(b2, 1) == 1)
}

test "leb128 signed" {
  let buf = bytebuf_new()
  leb128_encode_s32(buf, 0 - 1)
  assert(bytebuf_length(buf) == 1)
  assert(bytes_get(bytebuf_to_bytes(buf), 0) == 127)
}

test "section encoding" {
  let out = bytebuf_new()
  let content = bytebuf_new()
  bytebuf_push(content, 1)
  bytebuf_push(content, 2)
  bytebuf_push(content, 3)
  bytebuf_push_section(out, 7, content)
  let bytes = bytebuf_to_bytes(out)
  assert(bytes_length(bytes) == 5)
  assert(bytes_get(bytes, 0) == 7)
  assert(bytes_get(bytes, 1) == 3)
  assert(bytes_get(bytes, 2) == 1)
}
