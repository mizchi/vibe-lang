//# Imports

import ./checker_stmt.vibe {
  check_program
}

import ./syntax / lexer.vibe {
  lex
}

import ./syntax / parser.vibe {
  parse_program
}

//# Functions

export let check_source_ok = (source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts)
    true
  } with Error {
    Throw(_) => false
  }
}

export let check_source_err = (source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts)
    false
  } with Error {
    Throw(_) => true
  }
}
