import ./eval_e2e_helpers.vibe { run_and_lookup }

test "e2e let binding" {
  assert(string_equals(run_and_lookup("let x = 42", "x"), "42"))
}

test "e2e let with expression" {
  assert(string_equals(run_and_lookup("let x = 1 + 2", "x"), "3"))
}

test "e2e function def and call" {
  let src = "let f = (x) -> x + 1\nlet result = f(5)"
  assert(string_equals(run_and_lookup(src, "result"), "6"))
}

test "e2e recursive factorial" {
  let src = "let rec fact = (n) -> if n <= 1 { 1 } else { n * fact(n - 1) }\nlet result = fact(5)"
  assert(string_equals(run_and_lookup(src, "result"), "120"))
}

test "e2e enum and match" {
  let src = "enum Opt { Some(Int); None }\nlet val = Some(99)\nlet result = match val { Some(x) => x, None => 0 }"
  assert(string_equals(run_and_lookup(src, "result"), "99"))
}

test "e2e if else" {
  let src = "let x = if true { 10 } else { 20 }"
  assert(string_equals(run_and_lookup(src, "x"), "10"))
}

test "e2e string builtin" {
  let src = "let s = string_concat(\"hello\", \" world\")\nlet n = string_length(s)"
  assert(string_equals(run_and_lookup(src, "n"), "11"))
}

test "e2e array builtin" {
  let src = "let arr = [1, 2, 3]\nlet n = array_length(arr)"
  assert(string_equals(run_and_lookup(src, "n"), "3"))
}

test "e2e while mutation" {
  let src = "let mut x = 0\nwhile x < 5 { x = x + 1 }\nlet result = x"
  assert(string_equals(run_and_lookup(src, "result"), "5"))
}

test "e2e multi stmt" {
  let src = "let a = 10\nlet b = a + 5\nlet c = b * 2"
  assert(string_equals(run_and_lookup(src, "c"), "30"))
}
