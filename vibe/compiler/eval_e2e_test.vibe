//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup
}

//# Misc

test "e2e let binding" {
  assert(run_and_lookup("let x = 42", "x") == "42")
}

test "e2e let with expression" {
  assert(run_and_lookup("let x = 1 + 2", "x") == "3")
}

test "e2e function def and call" {
  let src = "let f = (x) -> x + 1\nlet result = f(5)"
  assert(run_and_lookup(src, "result") == "6")
}

test "e2e recursive factorial" {
  let src = "let rec fact = (n) -> if n <= 1 { 1 } else { n * fact(n - 1) }\nlet result = fact(5)"
  assert(run_and_lookup(src, "result") == "120")
}

test "e2e enum and match" {
  let src = "enum Opt { Some(Int); None }\nlet val = Some(99)\nlet result = match val { Some(x) => x, None => 0 }"
  assert(run_and_lookup(src, "result") == "99")
}

test "e2e if else" {
  let src = "let x = if true { 10 } else { 20 }"
  assert(run_and_lookup(src, "x") == "10")
}

test "e2e method syntax: String::length" {
  let src = "let s = \"hello\"\nlet x = s.length()"
  assert(run_and_lookup(src, "x") == "5")
}

test "e2e method syntax: String::concat" {
  let src = "let s = \"hello\"\nlet x = s.concat(\" world\")"
  assert(run_and_lookup(src, "x") == "hello world")
}

test "e2e method syntax: Array::length" {
  let src = "let a = [1, 2, 3]\nlet x = a.length()"
  assert(run_and_lookup(src, "x") == "3")
}

test "e2e method syntax: chained" {
  let src = "let s = \"hello\"\nlet x = s.concat(\" world\").length()"
  assert(run_and_lookup(src, "x") == "11")
}

test "e2e empty map literal" {
  let src = "let m = map {}\nlet x = __to_string(m)"
  assert(run_and_lookup(src, "x") == "{}")
}

test "e2e map literal with entries" {
  let src = "let m = map { a: 1, b: 2 }\nlet x = __to_string(m)"
  assert(run_and_lookup(src, "x") == "{a: 1, b: 2}")
}

test "e2e array spread basic" {
  let src = "let a = [1, 2]\nlet b = [:.a, 3]"
  assert(run_and_lookup(src, "b") == "[1, 2, 3]")
}

test "e2e array spread prepend" {
  let src = "let a = [2, 3]\nlet b = [1, :.a]"
  assert(run_and_lookup(src, "b") == "[1, 2, 3]")
}

test "e2e array spread middle" {
  let src = "let a = [2, 3]\nlet b = [1, :.a, 4]"
  assert(run_and_lookup(src, "b") == "[1, 2, 3, 4]")
}

test "e2e array spread concat" {
  let src = "let a = [1, 2]\nlet b = [3, 4]\nlet c = [:.a, ...b]"
  assert(run_and_lookup(src, "c") == "[1, 2, 3, 4]")
}

test "e2e array spread empty" {
  let src = "let a = [1, 2, 3]\nlet b = [:.a]"
  assert(run_and_lookup(src, "b") == "[1, 2, 3]")
}

//# String interpolation e2e

test "e2e string interpolation basic" {
  let src = "let name = \"world\"\nlet result = \"hello \\{name}\""
  assert(run_and_lookup(src, "result") == "hello world")
}

test "e2e string interpolation with expression" {
  let src = "let x = 3\nlet result = \"x is \\{x + 1}\""
  assert(run_and_lookup(src, "result") == "x is 4")
}

test "e2e string interpolation multiple" {
  let src = "let a = 1\nlet b = 2\nlet result = \"\\{a} + \\{b} = \\{a + b}\""
  assert(run_and_lookup(src, "result") == "1 + 2 = 3")
}

test "e2e string interpolation no interp" {
  let src = "let result = \"plain string\""
  assert(run_and_lookup(src, "result") == "plain string")
}

//# Is expression e2e

test "e2e is expression bool true" {
  let src = "enum Color { Red; Blue }\nlet v = Red\nlet result = v is Red"
  assert(run_and_lookup(src, "result") == "true")
}

test "e2e is expression bool false" {
  let src = "enum Color { Red; Blue }\nlet v = Blue\nlet result = v is Red"
  assert(run_and_lookup(src, "result") == "false")
}

test "e2e is expression if binding" {
  let src = "enum Box { Val(Int); Empty }\nlet v = Val(42)\nlet result = if v is Val(x) { x + 1 } else { 0 }"
  assert(run_and_lookup(src, "result") == "43")
}

test "e2e is expression if binding no match" {
  let src = "enum Box { Val(Int); Empty }\nlet v = Empty\nlet result = if v is Val(x) { x + 1 } else { 0 }"
  assert(run_and_lookup(src, "result") == "0")
}

test "e2e while loop with mutable" {
  let src = "let f = () -> {\n  let mut i = 0\n  let mut sum = 0\n  while i < 5 {\n    sum = sum + i\n    i = i + 1\n  }\n  sum\n}\nlet result = f()"
  assert(run_and_lookup(src, "result") == "10")
}

test "e2e for-in loop" {
  let src = "let items = [10, 20, 30]\nlet doubled = for x in items { x * 2 }\nlet result = Array::get(doubled, 1)"
  assert(run_and_lookup(src, "result") == "40")
}

test "e2e nested match" {
  let src = "enum Tree { Leaf(Int); Node(Tree, Tree) }\nlet rec sum = (t: Tree) -> Int {\n  match t {\n    Leaf(n) => n,\n    Node(l, r) => sum(l) + sum(r)\n  }\n}\nlet result = sum(Node(Leaf(1), Node(Leaf(2), Leaf(3))))"
  assert(run_and_lookup(src, "result") == "6")
}

test "e2e tuple destructure" {
  let src = "let (a, b) = (10, 20)\nlet result = a + b"
  assert(run_and_lookup(src, "result") == "30")
}

test "e2e handle throw" {
  let src = "let fail = () -> Int with { Error } { throw(\"oops\") }\nlet result = handle { fail() } { Error(msg) => String::length(msg) }"
  assert(run_and_lookup(src, "result") == "4")
}

test "e2e string operations" {
  let src = "let s = \"hello world\"\nlet result = String::length(s)"
  assert(run_and_lookup(src, "result") == "11")
}

test "e2e string char_code_at" {
  let src = "let result = String::char_code_at(\"ABC\", 0)"
  assert(run_and_lookup(src, "result") == "65")
}

test "e2e string substring" {
  let src = "let s = \"hello\"\nlet result = s[1:3]"
  assert(run_and_lookup(src, "result") == "\"el\"")
}

test "e2e comparison operators" {
  let src = "let a = 5 > 3\nlet b = 2 >= 2\nlet c = 1 < 0\nlet result = if a && b && not(c) { 1 } else { 0 }"
  assert(run_and_lookup(src, "result") == "1")
}

test "e2e bitwise ops" {
  let src = "let result = (0xFF & 0x0F) | 0x30"
  assert(run_and_lookup(src, "result") == "63")
}

test "e2e pipe operator" {
  let src = "let double = (x: Int) -> Int { x * 2 }\nlet result = 5 |> double"
  assert(run_and_lookup(src, "result") == "10")
}

test "e2e closure capture" {
  let src = "let base = 100\nlet add_base = (x: Int) -> Int { x + base }\nlet result = add_base(42)"
  assert(run_and_lookup(src, "result") == "142")
}

test "e2e break with value" {
  let src = "let f = () -> {\n  while true {\n    break 42\n  }\n}\nlet result = f()"
  assert(run_and_lookup(src, "result") == "42")
}

test "e2e continue in loop" {
  let src = "let f = () -> {\n  let mut sum = 0\n  let mut i = 0\n  while i < 10 {\n    i = i + 1\n    if i % 2 == 0 { continue }\n    sum = sum + i\n  }\n  sum\n}\nlet result = f()"
  assert(run_and_lookup(src, "result") == "25")
}

test "e2e hex literal" {
  let src = "let result = 0xFF"
  assert(run_and_lookup(src, "result") == "255")
}

test "e2e negative number" {
  let src = "let result = -42"
  assert(run_and_lookup(src, "result") == "-42")
}

test "e2e string equality" {
  let src = "let result = if \"hello\" == \"hello\" { 1 } else { 0 }"
  assert(run_and_lookup(src, "result") == "1")
}

test "e2e string inequality" {
  let src = "let result = if \"a\" != \"b\" { 1 } else { 0 }"
  assert(run_and_lookup(src, "result") == "1")
}

test "e2e double arithmetic" {
  let src = "let result = Double::to_int(3.14 * 2.0)"
  assert(run_and_lookup(src, "result") == "6")
}

test "e2e array builder" {
  let src = "let b = ArrayBuilder::new()\nArrayBuilder::push(b, 10)\nArrayBuilder::push(b, 20)\nlet arr = ArrayBuilder::freeze(b)\nlet result = Array::length(arr)"
  assert(run_and_lookup(src, "result") == "2")
}

test "e2e map builder" {
  let src = "let b = MapBuilder::new()\nMapBuilder::set(b, \"x\", 1)\nMapBuilder::set(b, \"y\", 2)\nlet m = MapBuilder::freeze(b)\nlet result = Map::get(m, \"x\") + Map::get(m, \"y\")"
  assert(run_and_lookup(src, "result") == "3")
}

test "e2e struct fields" {
  let src = "struct Point { x: Int; y: Int }\nlet p = Point::{ x: 3, y: 4 }\nlet result = p.x + p.y"
  assert(run_and_lookup(src, "result") == "7")
}

test "e2e let rec mutual" {
  let src = "let rec sum_to = (n: Int) -> Int {\n  if n <= 0 { 0 } else { n + sum_to(n - 1) }\n}\nlet result = sum_to(5)"
  assert(run_and_lookup(src, "result") == "15")
}

test "e2e wildcard pattern" {
  let src = "enum V { A(Int); B(String); C }\nlet f = (v: V) -> Int {\n  match v { A(n) => n, _ => 0 }\n}\nlet result = f(A(42)) + f(B(\"x\")) + f(C)"
  assert(run_and_lookup(src, "result") == "42")
}

test "e2e multi-arm match" {
  let src = "let classify = (n: Int) -> String {\n  match n {\n    0 => \"zero\",\n    1 => \"one\",\n    2 => \"two\",\n    _ => \"other\"\n  }\n}\nlet result = classify(1)"
  assert(run_and_lookup(src, "result") == "\"one\"")
}
