//# Imports

import ./checker_stmt.vibe {
  check_program
}

import ./eval_loader.vibe {
  contains_str
}

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

import ./path.vibe {
  dir_of, resolve_path
}

import ./ripple {
  RippleDb, ripple_eval_count, ripple_get_fingerprint, ripple_get_source, ripple_new, ripple_record_eval, ripple_set_source
}

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

//# Types

export enum TypeDb {
  TypeDb(RippleDb)
}

//# Functions

export let db_new = () -> TypeDb {
  TypeDb(ripple_new())
}

let empty_stack = () -> Array[String] {
  array_slice([
    ""
  ], 0, 0)
}

export let db_set_source = (db: TypeDb, path: String, source: String) -> TypeDb {
  match db {
    TypeDb(rdb) => TypeDb(ripple_set_source(rdb, path, source))
  }
}

let empty_dep_fps = () -> Array[(String, String)] {
  array_slice([
    ("", "")
  ], 0, 0)
}

let build_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {
  let len = array_length(dep_fps)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    }
    else {
      let (dep_path, dep_fp) = array_get(dep_fps, i)
      let next = string_concat(acc, string_concat("|", string_concat(dep_path, string_concat("=", dep_fp))))
      go(i + 1, next)
    }
  }
  go(0, source)
}

export let db_typecheck_count = (db: TypeDb) -> Int {
  match db {
    TypeDb(rdb) => ripple_eval_count(rdb)
  }
}

let add_dep = (acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {
  if string_length(raw_path) == 0 {
    acc
  } else {
    let resolved = resolve_path(base_dir, raw_path)
    if contains_str(acc, resolved) {
      acc
    } else {
      array_concat(acc, [resolved])
    }
  }
}

let collect_import_deps = (source: String, base_dir: String) -> Array[String] with { Error } {
  let stmts = parse_program(lex(source))
  let len = array_length(stmts)
  let rec go = (i: Int, acc: Array[String]) -> Array[String] {
    if i >= len {
      acc
    } else {
      let next = match array_get(stmts, i) {
        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),
        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, empty_stack())
}

let rec ensure_fingerprint = (db: RippleDb, path: String, stack: Array[String]) -> (String, RippleDb)with { Error } {
  if contains_str(stack, path) {
    throw(string_concat("type_db: import cycle detected at ", path))
  } else {
    match ripple_get_source(db, path) {
      None => (string_concat("missing:", path), db),
      Some(source) => {
        let deps = collect_import_deps(source, dir_of(path))
        let dlen = array_length(deps)
        let next_stack = array_concat(stack, [
          path
        ])
        let rec resolve_deps = (i: Int, dep_acc: Array[(String, String)], dep_db: RippleDb) -> (Array[(String, String)], RippleDb)with { Error } {
          if i >= dlen {
            (dep_acc, dep_db)
          } else {
            let dep_path = array_get(deps, i)
            let (dep_fp, next_db) = ensure_fingerprint(dep_db, dep_path, next_stack)
            resolve_deps(i + 1, array_concat(dep_acc, [
              (dep_path, dep_fp)
            ]), next_db)
          }
        }
        let (dep_fps, db_after_deps) = resolve_deps(0, empty_dep_fps(), db)
        let fingerprint = build_fingerprint(source, dep_fps)
        match ripple_get_fingerprint(db_after_deps, path) {
          Some(cached_fp) => if string_equals(cached_fp, fingerprint) {
            (fingerprint, db_after_deps)
          } else {
            let _ = check_program(parse_program(lex(source)))
            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)
            (fingerprint, next_db)
          }
          ,
          None => {
            let _ = check_program(parse_program(lex(source)))
            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)
            (fingerprint, next_db)
          }
        }
      }
    }
  }
}

export let db_typecheck = (db: TypeDb, path: String) -> TypeDb with { Error } {
  match db {
    TypeDb(rdb) => {
      let (_, next_rdb) = ensure_fingerprint(rdb, path, empty_stack())
      match ripple_get_source(next_rdb, path) {
        None => TypeDb(next_rdb),
        Some(source) => {
          let _ = check_program(parse_program(lex(source)))
          TypeDb(next_rdb)
        }
      }
    }
  }
}
