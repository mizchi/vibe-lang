//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./checker_stmt.vibe {
  check_program, check_program_with_env
}

import ./eval_loader.vibe {
  contains_str
}

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

import ./ripple/index.vibe {
  RippleDb, ripple_eval_count, ripple_get_fingerprint, ripple_get_source, ripple_new, ripple_record_eval, ripple_set_source
}

import ./types.vibe {
  Type, TypeEnv, env_bind, env_flat_bindings, env_lookup_flat
}

//# Types

export enum TypeDb {
  TypeDb(RippleDb, Array[(String, TypeEnv)])
}

//# Functions

let dir_of = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  } else {
    String::substring(file_path, 0, idx)
  }
}

let resolve_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  if len >= 3 {
    if String::equals(String::substring(raw_path, 0, 3), "../") {
      let rest = String::substring(raw_path, 3, len)
      let parent = dir_of(base_dir)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if String::equals(parent, "") {
        resolved
      } else {
        String::concat(parent, String::concat("/", resolved))
      }
    } else if String::equals(String::substring(raw_path, 0, 2), "./") {
      let rest = String::substring(raw_path, 2, len)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if String::equals(base_dir, "") {
        resolved
      } else {
        String::concat(base_dir, String::concat("/", resolved))
      }
    } else {
      raw_path
    }
  } else if len >= 2 {
    if String::equals(String::substring(raw_path, 0, 2), "./") {
      let rest = String::substring(raw_path, 2, len)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if String::equals(base_dir, "") {
        resolved
      } else {
        String::concat(base_dir, String::concat("/", resolved))
      }
    } else {
      raw_path
    }
  } else {
    raw_path
  }
}

let add_dep = (acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {
  if String::length(raw_path) == 0 {
    acc
  } else {
    let resolved = resolve_path(base_dir, raw_path)
    if contains_str(acc, resolved) {
      acc
    } else {
      Array::concat(acc, [
        resolved
      ])
    }
  }
}

let empty_stack = () -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

export let db_set_source = (db: TypeDb, path: String, source: String) -> TypeDb {
  match db {
    TypeDb(rdb, cache) => TypeDb(ripple_set_source(rdb, path, source), cache)
  }
}

let empty_dep_fps = () -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

let empty_env_cache = () -> Array[(String, TypeEnv)] {
  Array::slice([
    ("", EnvEmpty)
  ], 0, 0)
}

export let db_new = () -> TypeDb {
  TypeDb(ripple_new(), empty_env_cache())
}

let lookup_env_cache = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let rec go = (i: Int) -> Option[TypeEnv] {
    if i >= len {
      None
    } else {
      let (p, env) = Array::get(cache, i)
      if String::equals(p, path) {
        Some(env)
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

export let db_check_env = (db: TypeDb, path: String) -> Option[TypeEnv] {
  match db {
    TypeDb(_, cache) => lookup_env_cache(cache, path)
  }
}

let build_import_env = (stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {
  let len = Array::length(stmts)
  let rec go = (i: Int, acc: TypeEnv) -> TypeEnv {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, names) => {
          let resolved = resolve_path(base_dir, raw_path)
          let dep_env = match lookup_env_cache(cache, resolved) {
            Some(e) => e,
            None => EnvEmpty
          }
          let dep_bindings = env_flat_bindings(dep_env)
          let nlen = Array::length(names)
          let rec bind_names = (j: Int, nacc: TypeEnv) -> TypeEnv {
            if j >= nlen {
              nacc
            } else {
              let (name, alias) = Array::get(names, j)
              let bound_name = match alias {
                Some(a) => a,
                None => name
              }
              let ty = match env_lookup_flat(dep_bindings, name) {
                Some(t) => t,
                None => CtUnknown
              }
              bind_names(j + 1, env_bind(nacc, bound_name, ty))
            }
          }
          bind_names(0, acc)
        },
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, EnvEmpty)
}

let upsert_env_cache = (cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {
  let len = Array::length(cache)
  let rec build = (i: Int, acc: Array[(String, TypeEnv)]) -> Array[(String, TypeEnv)] {
    if i >= len {
      acc
    } else {
      let (p, e) = Array::get(cache, i)
      if String::equals(p, path) {
        build(i + 1, acc)
      } else {
        build(i + 1, Array::concat(acc, [
          (p, e)
        ]))
      }
    }
  }
  Array::concat(build(0, empty_env_cache()), [
    (path, env)
  ])
}

let build_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {
  let len = Array::length(dep_fps)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    }
    else {
      let (dep_path, dep_fp) = Array::get(dep_fps, i)
      let next = String::concat(acc, String::concat("|", String::concat(dep_path, String::concat("=", dep_fp))))
      go(i + 1, next)
    }
  }
  go(0, source)
}

export let db_typecheck_count = (db: TypeDb) -> Int {
  match db {
    TypeDb(rdb, _) => ripple_eval_count(rdb)
  }
}

let collect_import_deps = (source: String, base_dir: String) -> Array[String] with { Error } {
  let stmts = parse_program(lex(source))
  let len = Array::length(stmts)
  let rec go = (i: Int, acc: Array[String]) -> Array[String] {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),
        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, empty_stack())
}

let rec ensure_fingerprint = (db: RippleDb, cache: Array[(String, TypeEnv)], path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)])with { Error } {
  if contains_str(stack, path) {
    throw(String::concat("type_db: import cycle detected at ", path))
  } else {
    match ripple_get_source(db, path) {
      None => (String::concat("missing:", path), db, cache),
      Some(source) => {
        let deps = collect_import_deps(source, dir_of(path))
        let dlen = Array::length(deps)
        let next_stack = Array::concat(stack, [
          path
        ])
        let rec resolve_deps = (i: Int, dep_acc: Array[(String, String)], dep_db: RippleDb, dep_cache: Array[(String, TypeEnv)]) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)])with { Error } {
          if i >= dlen {
            (dep_acc, dep_db, dep_cache)
          } else {
            let dep_path = Array::get(deps, i)
            let (dep_fp, next_db, next_cache) = ensure_fingerprint(dep_db, dep_cache, dep_path, next_stack)
            resolve_deps(i + 1, Array::concat(dep_acc, [
              (dep_path, dep_fp)
            ]), next_db, next_cache)
          }
        }
        let (dep_fps, db_after_deps, cache_after_deps) = resolve_deps(0, empty_dep_fps(), db, cache)
        let fingerprint = build_fingerprint(source, dep_fps)
        match ripple_get_fingerprint(db_after_deps, path) {
          Some(cached_fp) => if String::equals(cached_fp, fingerprint) {
            (fingerprint, db_after_deps, cache_after_deps)
          } else {
            let stmts = parse_program(lex(source))
            let import_env = build_import_env(stmts, dir_of(path), cache_after_deps)
            let checked_env = check_program_with_env(stmts, import_env)
            let next_cache = upsert_env_cache(cache_after_deps, path, checked_env)
            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)
            (fingerprint, next_db, next_cache)
          }
          ,
          None => {
            let stmts = parse_program(lex(source))
            let import_env = build_import_env(stmts, dir_of(path), cache_after_deps)
            let checked_env = check_program_with_env(stmts, import_env)
            let next_cache = upsert_env_cache(cache_after_deps, path, checked_env)
            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)
            (fingerprint, next_db, next_cache)
          }
        }
      }
    }
  }
}

export let db_typecheck = (db: TypeDb, path: String) -> TypeDb with { Error } {
  match db {
    TypeDb(rdb, cache) => {
      let (_, next_rdb, next_cache) = ensure_fingerprint(rdb, cache, path, empty_stack())
      TypeDb(next_rdb, next_cache)
    }
  }
}
