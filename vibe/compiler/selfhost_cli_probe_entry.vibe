//# Imports

import ./entry / source_compile / wasi_only {
  compile_source_wasi_only
}

import ../cli/selfhost.vibe {
  read_arg
}

import ./selfhost_cli_support.vibe {
  build_linked_debug_entry, compile_debug_library, compile_release_file
}

//# Functions

export let probe_arg0_len: () -> Int = () -> {
  String::length(read_arg(0))
}

export let probe_arg1_len: () -> Int = () -> {
  String::length(read_arg(1))
}

export let probe_arg2_len: () -> Int = () -> {
  String::length(read_arg(2))
}

export let probe_arg3_len: () -> Int = () -> {
  String::length(read_arg(3))
}

export let probe_args_len: () -> Int = () -> {
  perform Env::ArgsLen
}

export let probe_source_len: () -> Int with { Error, Fs, Env } = () -> {
  let source = perform Fs::ReadFile(read_arg(0))
  String::length(source)
}

export let probe_compile_len: () -> Int with { Error, Fs, Env } = () -> {
  let source = perform Fs::ReadFile(read_arg(0))
  let bytes = compile_source_wasi_only(source, read_arg(2))
  Bytes::length(bytes)
}

export let probe_compile_file_len: () -> Int with { Error, Fs, Env } = () -> {
  let bytes = compile_release_file(read_arg(0), read_arg(2))
  Bytes::length(bytes)
}

export let probe_compile_library_len: () -> Int with { Error, Fs, Env } = () -> {
  let bytes = compile_debug_library(read_arg(0))
  Bytes::length(bytes)
}

export let probe_compile_linked_file_len: () -> Int with { Error, Fs, Env } = () -> {
  let (bytes, _) = build_linked_debug_entry(read_arg(0), read_arg(2))
  Bytes::length(bytes)
}
