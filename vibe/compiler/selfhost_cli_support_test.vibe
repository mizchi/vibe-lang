//# Imports

import ./selfhost_cli_support.vibe {
  compile_release_file_mode
}

//# Functions

let string_to_bytes: (String) -> Bytes = (s) -> {
  let out = Array::slice([
    0
  ], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

let assert_wasm_magic: (Bytes) -> Unit = (bytes) -> {
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

//# Misc

test "selfhost cli support dispatches mvp through pruned compile path" {
  let main_path = "/tmp/vibe_selfhost_cli_support_mode_main.vibe"
  let source = "let unused: () -> Int = () -> { 0 }\nlet answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let bytes_no_dce = compile_release_file_mode(main_path, "answer", "no-dce")
  let bytes_mvp = compile_release_file_mode(main_path, "answer", "mvp")
  assert_wasm_magic(bytes_no_dce)
  assert_wasm_magic(bytes_mvp)
  assert(Bytes::length(bytes_mvp) < Bytes::length(bytes_no_dce))
}
