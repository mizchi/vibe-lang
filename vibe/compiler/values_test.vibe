//# Imports

import ./values.vibe {
  ValEnv, Value, val_env_bind, val_env_bind_all, val_env_lookup, value_to_string, values_equal
}

//# Misc

test "lookup found" {
  let env = VEnvBind("x", VInt(42), VEnvEmpty)
  match val_env_lookup(env, "x") {
    Some(v) => assert_true(values_equal(v, VInt(42))),
    None => assert_true(false)
  }
}

test "lookup not found" {
  match val_env_lookup(VEnvEmpty, "x") {
    Some(_) => assert_true(false),
    None => assert_true(true)
  }
}

test "lookup shadow" {
  let env = VEnvBind("x", VInt(99), VEnvBind("x", VInt(1), VEnvEmpty))
  match val_env_lookup(env, "x") {
    Some(v) => assert_true(values_equal(v, VInt(99))),
    None => assert_true(false)
  }
}

test "bind_all" {
  let bindings = [
    ("a", VInt(1)),
    ("b", VInt(2))
  ]
  let env = val_env_bind_all(VEnvEmpty, bindings)
  match val_env_lookup(env, "a") {
    Some(v) => assert_true(values_equal(v, VInt(1))),
    None => assert_true(false)
  }
  match val_env_lookup(env, "b") {
    Some(v) => assert_true(values_equal(v, VInt(2))),
    None => assert_true(false)
  }
}

test "value_to_string primitives" {
  assert_eq(value_to_string(VInt(42)), "42")
  assert_eq(value_to_string(VString("hello")), "hello")
  assert_eq(value_to_string(VBool(true)), "true")
  assert_eq(value_to_string(VBool(false)), "false")
  assert_eq(value_to_string(VUnit), "()")
}

test "value_to_string composite" {
  assert_eq(value_to_string(VTuple([
    VInt(1),
    VInt(2)
  ])), "(1, 2)")
  assert_eq(value_to_string(VArray([
    VInt(1),
    VInt(2)
  ])), "[1, 2]")
  assert_eq(value_to_string(VCtor("Some", [
    VInt(42)
  ])), "Some(42)")
  assert_eq(value_to_string(VCtor("None", Array::slice([
    VUnit
  ], 0, 0))), "None")
}

test "value_to_string record" {
  let rec_val = VRecord([
    ("x", VInt(1)),
    ("y", VInt(2))
  ])
  assert_eq(value_to_string(rec_val), "{x: 1, y: 2}")
}

test "values_equal" {
  assert_true(values_equal(VInt(42), VInt(42)))
  assert_true(not(values_equal(VInt(42), VInt(43))))
  assert_true(values_equal(VString("hi"), VString("hi")))
  assert_true(values_equal(VBool(true), VBool(true)))
  assert_true(not(values_equal(VBool(true), VBool(false))))
}

test "values_equal distinguishes tags with same text" {
  assert_true(not(values_equal(VInt(1), VString("1"))))
  assert_true(not(values_equal(VBool(true), VString("true"))))
  assert_true(not(values_equal(VUnit, VString("()"))))
}

test "values_equal compares nested structures structurally" {
  assert_true(values_equal(VArray([
    VInt(1),
    VTuple([
      VString("x"),
      VBool(true)
    ])
  ]), VArray([
    VInt(1),
    VTuple([
      VString("x"),
      VBool(true)
    ])
  ])))
  assert_true(values_equal(VRecord([
    ("x", VInt(1)),
    ("y", VArray([
      VInt(2),
      VInt(3)
    ]))
  ]), VRecord([
    ("x", VInt(1)),
    ("y", VArray([
      VInt(2),
      VInt(3)
    ]))
  ])))
  assert_true(values_equal(VBreak(VInt(42)), VBreak(VInt(42))))
  assert_true(values_equal(VContinue([
    VInt(1),
    VString("x")
  ]), VContinue([
    VInt(1),
    VString("x")
  ])))
  assert_true(not(values_equal(VContinue([
    VInt(1)
  ]), VContinue([
    VInt(2)
  ]))))
}

test "values_equal never treats functions as equal" {
  let empty_pairs = Array::slice([
    ("", VUnit)
  ], 0, 0)
  let empty_params = Array::slice([
    ""
  ], 0, 0)
  assert_true(not(values_equal(VFn(empty_pairs, empty_params, 0, None), VFn(empty_pairs, empty_params, 0, None))))
}
