//# Imports

import ./values.vibe {
  ValEnv, Value, val_env_bind, val_env_bind_all, val_env_lookup, value_to_string, values_equal
}

//# Misc

test "lookup found" {
  let env = VEnvBind("x", VInt(42), VEnvEmpty)
  match val_env_lookup(env, "x") {
    Some(v) => assert(values_equal(v, VInt(42))),
    None => assert(false)
  }
}

test "lookup not found" {
  match val_env_lookup(VEnvEmpty, "x") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "lookup shadow" {
  let env = VEnvBind("x", VInt(99), VEnvBind("x", VInt(1), VEnvEmpty))
  match val_env_lookup(env, "x") {
    Some(v) => assert(values_equal(v, VInt(99))),
    None => assert(false)
  }
}

test "bind_all" {
  let bindings = [
    ("a", VInt(1)),
    ("b", VInt(2))
  ]
  let env = val_env_bind_all(VEnvEmpty, bindings)
  match val_env_lookup(env, "a") {
    Some(v) => assert(values_equal(v, VInt(1))),
    None => assert(false)
  }
  match val_env_lookup(env, "b") {
    Some(v) => assert(values_equal(v, VInt(2))),
    None => assert(false)
  }
}

test "value_to_string primitives" {
  assert(String::equals(value_to_string(VInt(42)), "42"))
  assert(String::equals(value_to_string(VString("hello")), "hello"))
  assert(String::equals(value_to_string(VBool(true)), "true"))
  assert(String::equals(value_to_string(VBool(false)), "false"))
  assert(String::equals(value_to_string(VUnit), "()"))
}

test "value_to_string composite" {
  assert(String::equals(value_to_string(VTuple([
    VInt(1),
    VInt(2)
  ])), "(1, 2)"))
  assert(String::equals(value_to_string(VArray([
    VInt(1),
    VInt(2)
  ])), "[1, 2]"))
  assert(String::equals(value_to_string(VCtor("Some", [
    VInt(42)
  ])), "Some(42)"))
  assert(String::equals(value_to_string(VCtor("None", Array::slice([
    VUnit
  ], 0, 0))), "None"))
}

test "value_to_string record" {
  let rec_val = VRecord([
    ("x", VInt(1)),
    ("y", VInt(2))
  ])
  assert(String::equals(value_to_string(rec_val), "{x: 1, y: 2}"))
}

test "values_equal" {
  assert(values_equal(VInt(42), VInt(42)))
  assert(not(values_equal(VInt(42), VInt(43))))
  assert(values_equal(VString("hi"), VString("hi")))
  assert(values_equal(VBool(true), VBool(true)))
  assert(not(values_equal(VBool(true), VBool(false))))
}
