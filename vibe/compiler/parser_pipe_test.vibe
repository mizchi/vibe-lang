//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse pipe" {
  let result = handle {
    parse_print("x |> f |> g")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "g(f(x))"))
}

test "parse pipe with args" {
  let result = handle {
    parse_print("x |> f(1, 2)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "f(x, 1, 2)"))
}

test "parse pipe mixed left without parens error" {
  let result = handle {
    parse_print("1 + 1 |> f")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "ERROR: cannot mix '|>' with other infix operators without explicit parentheses"))
}

test "parse pipe mixed right without parens error" {
  let result = handle {
    parse_print("x |> f + g")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "ERROR: cannot mix '|>' with other infix operators without explicit parentheses"))
}

test "parse pipe mixed with parens ok" {
  let result = handle {
    parse_print("(1 + 1) |> f")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "f((1 + 1))"))
}
