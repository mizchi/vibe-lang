//# Imports

import ./types.vibe {
  Type, types_equal
}

//# Misc

test "types wrapper preserves nullary constructors" {
  let value: Type = CtInt
  match value {
    CtInt => assert(true),
    _ => assert(false)
  }
}

test "types wrapper preserves unary constructors" {
  let value: Type = CtArray(CtString)
  match value {
    CtArray(elem) => assert(types_equal(elem, CtString)),
    _ => assert(false)
  }
}
