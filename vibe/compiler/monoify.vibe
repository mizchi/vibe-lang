//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

//# Helpers

let empty_exprs = () -> Array[Expr] {
  array_slice([EUnit], 0, 0)
}

let empty_expr_arrays = () -> Array[Array[Expr]] {
  array_slice([empty_exprs()], 0, 0)
}

//# Functions

export let is_generic_fn = (expr: Expr) -> Bool {
  match expr {
    EFn(type_params, _bounds, _params, _ret_ty, _effect, _body) =>
      if eq(array_length(type_params), 0) { false }
      else { true },
    _ => false
  }
}

let rec collect_call_sites_expr = (expr: Expr, fn_name: String) -> Array[Array[Expr]] {
  match expr {
    ECall(callee, args) => {
      let self_results = match callee {
        EIdent(name) =>
          if string_equals(name, fn_name) { [args] }
          else { empty_expr_arrays() },
        _ => empty_expr_arrays()
      }
      let callee_results = collect_call_sites_expr(callee, fn_name)
      let mut args_results = empty_expr_arrays()
      let mut ai = 0
      while ai < array_length(args) {
        args_results = array_concat(args_results, collect_call_sites_expr(array_get(args, ai), fn_name))
        ai = ai + 1
      }
      array_concat(array_concat(self_results, callee_results), args_results)
    },
    EInt(_) => empty_expr_arrays(),
    EFloat(_) => empty_expr_arrays(),
    EString(_) => empty_expr_arrays(),
    EBool(_) => empty_expr_arrays(),
    EIdent(_) => empty_expr_arrays(),
    EUnit => empty_expr_arrays(),
    EBreak(_) => empty_expr_arrays(),
    EContinue(_) => empty_expr_arrays(),
    ETuple(elems) => {
      let mut tr = empty_expr_arrays()
      let mut ti = 0
      while ti < array_length(elems) {
        tr = array_concat(tr, collect_call_sites_expr(array_get(elems, ti), fn_name))
        ti = ti + 1
      }
      tr
    },
    EArray(elems) => {
      let mut ar = empty_expr_arrays()
      let mut ari = 0
      while ari < array_length(elems) {
        ar = array_concat(ar, collect_call_sites_expr(array_get(elems, ari), fn_name))
        ari = ari + 1
      }
      ar
    },
    ERecord(fields) => {
      let mut result = empty_expr_arrays()
      let mut i = 0
      while i < array_length(fields) {
        let (_key, val) = array_get(fields, i)
        result = array_concat(result, collect_call_sites_expr(val, fn_name))
        i = i + 1
      }
      result
    },
    EIf(cond, then_br, else_br) => {
      let r1 = collect_call_sites_expr(cond, fn_name)
      let r2 = collect_call_sites_expr(then_br, fn_name)
      let r3 = collect_call_sites_expr(else_br, fn_name)
      array_concat(array_concat(r1, r2), r3)
    },
    ELet(_name, val, body) => {
      let r1 = collect_call_sites_expr(val, fn_name)
      let r2 = collect_call_sites_expr(body, fn_name)
      array_concat(r1, r2)
    },
    ELetRec(_name, val, body) => {
      let r1 = collect_call_sites_expr(val, fn_name)
      let r2 = collect_call_sites_expr(body, fn_name)
      array_concat(r1, r2)
    },
    ELetMut(_name, val, body) => {
      let r1 = collect_call_sites_expr(val, fn_name)
      let r2 = collect_call_sites_expr(body, fn_name)
      array_concat(r1, r2)
    },
    EAssign(_name, val, body) => {
      let r1 = collect_call_sites_expr(val, fn_name)
      let r2 = collect_call_sites_expr(body, fn_name)
      array_concat(r1, r2)
    },
    EAssignOp(_name, _op, val, body) => {
      let r1 = collect_call_sites_expr(val, fn_name)
      let r2 = collect_call_sites_expr(body, fn_name)
      array_concat(r1, r2)
    },
    ESeq(a, b) => {
      let r1 = collect_call_sites_expr(a, fn_name)
      let r2 = collect_call_sites_expr(b, fn_name)
      array_concat(r1, r2)
    },
    EMatch(scrutinee, arms) => {
      let r1 = collect_call_sites_expr(scrutinee, fn_name)
      let mut result = r1
      let mut i = 0
      while i < array_length(arms) {
        let (_arm_pat, arm_body) = array_get(arms, i)
        result = array_concat(result, collect_call_sites_expr(arm_body, fn_name))
        i = i + 1
      }
      result
    },
    EHandle(body, arms) => {
      let r1 = collect_call_sites_expr(body, fn_name)
      let mut result = r1
      let mut i = 0
      while i < array_length(arms) {
        let (_arm_pat, arm_body) = array_get(arms, i)
        result = array_concat(result, collect_call_sites_expr(arm_body, fn_name))
        i = i + 1
      }
      result
    },
    EWhile(cond, body) => {
      let r1 = collect_call_sites_expr(cond, fn_name)
      let r2 = collect_call_sites_expr(body, fn_name)
      array_concat(r1, r2)
    },
    EForIn(_name, iter, body) => {
      let r1 = collect_call_sites_expr(iter, fn_name)
      let r2 = collect_call_sites_expr(body, fn_name)
      array_concat(r1, r2)
    },
    EBinOp(_op, lhs, rhs) => {
      let r1 = collect_call_sites_expr(lhs, fn_name)
      let r2 = collect_call_sites_expr(rhs, fn_name)
      array_concat(r1, r2)
    },
    EUnaryOp(_op, operand) => collect_call_sites_expr(operand, fn_name),
    EFn(_tp, _bounds, _params, _ret, _eff, body) =>
      collect_call_sites_expr(body, fn_name),
    EDot(e, _field) => collect_call_sites_expr(e, fn_name),
    ELabeledArg(_label, _name, e) => collect_call_sites_expr(e, fn_name),
    EThrow(e) => collect_call_sites_expr(e, fn_name)
  }
}

export let collect_call_sites = (expr: Expr, fn_name: String) -> Array[Array[Expr]] {
  collect_call_sites_expr(expr, fn_name)
}

let collect_call_sites_from_stmt = (stmt: Stmt, fn_name: String) -> Array[Array[Expr]] {
  match stmt {
    SLet(_exported, _is_rec, _name, _ty, body) =>
      collect_call_sites_expr(body, fn_name),
    SLetMut(_name, _ty, body) =>
      collect_call_sites_expr(body, fn_name),
    STest(_name, body) =>
      collect_call_sites_expr(body, fn_name),
    SExpr(body) =>
      collect_call_sites_expr(body, fn_name),
    _ => empty_expr_arrays()
  }
}

export let collect_call_sites_stmts = (stmts: Array[Stmt], fn_name: String) -> Array[Array[Expr]] {
  let mut result = empty_expr_arrays()
  let mut i = 0
  while i < array_length(stmts) {
    result = array_concat(result, collect_call_sites_from_stmt(array_get(stmts, i), fn_name))
    i = i + 1
  }
  result
}

let empty_string_int_pairs = () -> Array[(String, Int)] {
  array_slice([("", 0)], 0, 0)
}

export let collect_generic_fns = (stmts: Array[Stmt]) -> Array[(String, Int)] {
  let result = empty_string_int_pairs()
  let mut i = 0
  while i < array_length(stmts) {
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(_exported, _is_rec, name, _ty, body) =>
        match body {
          EFn(type_params, _bounds, _params, _ret, _eff, _fn_body) =>
            if array_length(type_params) > 0 {
              array_push(result, (name, array_length(type_params)))
              result
            }
            else { result },
          _ => result
        },
      _ => result
    }
    i = i + 1
  }
  result
}

export let mono_name = (base: String, suffix: String) -> String {
  string_concat(string_concat(base, "$"), suffix)
}

export let count_instantiations = (stmts: Array[Stmt], fn_name: String) -> Int {
  let sites = collect_call_sites_stmts(stmts, fn_name)
  array_length(sites)
}
