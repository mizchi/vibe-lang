//# Imports

import ./core {
  Expr, Pat, Stmt
}

import ./eval_stmt.vibe {
  eval_with_imports_lookup
}

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

//# Functions

let dir_of = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  } else {
    file_path[0..idx]
  }
}

let empty_strings = () -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

let string_array_eq = (a: Array[String], b: Array[String]) -> Bool {
  let len = Array::length(a)
  if len != Array::length(b) {
    false
  } else {
    let rec go = (i: Int) -> Bool {
      if i >= len {
        true
      } else if Array::get(a, i) == Array::get(b, i) {
        go(i + 1)
      } else false
    }
    go(0)
  }
}

let rewrite_last_stmt_binding = (stmts: Array[Stmt], name: String) -> Array[Stmt] {
  let len = Array::length(stmts)
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < len {
    let stmt = Array::get(stmts, i)
    if i + 1 == len {
      match stmt {
        SExpr(expr) => ArrayBuilder::push(out, SLet(false, false, name, None, expr)),
        _ => ArrayBuilder::push(out, stmt)
      }
    } else {
      ArrayBuilder::push(out, stmt)
    }
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

let eval_last = (path: String, main_source: String, sources: Array[(String, String)]) -> String with { Error } {
  let stmts = parse_program(lex(main_source))
  eval_with_imports_lookup(rewrite_last_stmt_binding(stmts, "__fixture_last"), sources, dir_of(path), "__fixture_last")
}

let rec collect_expr_shell_effects = (expr: Expr) -> Array[String] {
  let rec collect_expr_array = (items: Array[Expr]) -> Array[String] {
    let out = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(items) {
      let nested = collect_expr_shell_effects(Array::get(items, i))
      let mut j = 0
      while j < Array::length(nested) {
        ArrayBuilder::push(out, Array::get(nested, j))
        j = j + 1
      }
      i = i + 1
    }
    ArrayBuilder::freeze(out)
  }
  let rec collect_arm_array = (arms: Array[(Pat, Expr)]) -> Array[String] {
    let out = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(arms) {
      let (_, body) = Array::get(arms, i)
      let nested = collect_expr_shell_effects(body)
      let mut j = 0
      while j < Array::length(nested) {
        ArrayBuilder::push(out, Array::get(nested, j))
        j = j + 1
      }
      i = i + 1
    }
    ArrayBuilder::freeze(out)
  }
  match expr {
    EInt(_) => empty_strings(),
    EFloat(_) => empty_strings(),
    EString(_) => empty_strings(),
    EBool(_) => empty_strings(),
    EIdent(_) => empty_strings(),
    EUnit => empty_strings(),
    ETuple(items) => collect_expr_array(items),
    EArray(items) => collect_expr_array(items),
    ERecord(fields) => {
      let exprs = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(fields) {
        let (_, field_expr) = Array::get(fields, i)
        ArrayBuilder::push(exprs, field_expr)
        i = i + 1
      }
      collect_expr_array(ArrayBuilder::freeze(exprs))
    },
    EIf(cond, then_expr, else_expr) => Array::concat(collect_expr_shell_effects(cond), Array::concat(collect_expr_shell_effects(then_expr), collect_expr_shell_effects(else_expr))),
    ELet(_, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    ELetRec(_, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    ELetMut(_, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    EAssign(_, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    EAssignOp(_, _, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    ESeq(left, right) => Array::concat(collect_expr_shell_effects(left), collect_expr_shell_effects(right)),
    EMatch(target, arms) => Array::concat(collect_expr_shell_effects(target), collect_arm_array(arms)),
    EHandle(target, arms) => Array::concat(collect_expr_shell_effects(target), collect_arm_array(arms)),
    EWhile(cond, body) => Array::concat(collect_expr_shell_effects(cond), collect_expr_shell_effects(body)),
    ELoop(params, body) => {
      let init_exprs = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        ArrayBuilder::push(init_exprs, init)
        i = i + 1
      }
      Array::concat(collect_expr_array(ArrayBuilder::freeze(init_exprs)), collect_expr_shell_effects(body))
    },
    EForIn(_, _, iter_expr, body) => Array::concat(collect_expr_shell_effects(iter_expr), collect_expr_shell_effects(body)),
    ECall(callee, args) => {
      let arg_effects = collect_expr_array(args)
      let call_effects = match callee {
        EIdent(name) => if name == "sh" && Array::length(args) == 1 {
          match Array::get(args, 0) {
            EString(cmd) => [
              String::concat(String::concat("ShellExec(\"", cmd), "\")")
            ],
            _ => empty_strings()
          }
        } else {
          empty_strings()
        },
        _ => empty_strings()
      }
      Array::concat(collect_expr_shell_effects(callee), Array::concat(arg_effects, call_effects))
    },
    EBinOp(_, left, right) => Array::concat(collect_expr_shell_effects(left), collect_expr_shell_effects(right)),
    EUnaryOp(_, inner) => collect_expr_shell_effects(inner),
    EFn(_, _, _, _, _, _) => empty_strings(),
    EDot(inner, _) => collect_expr_shell_effects(inner),
    ELabeledArg(_, _, inner) => collect_expr_shell_effects(inner),
    EThrow(inner) => collect_expr_shell_effects(inner),
    EBreak(Some(inner)) => collect_expr_shell_effects(inner),
    EBreak(None) => empty_strings(),
    EContinue(items) => collect_expr_array(items),
    EMap(fields) => {
      let exprs = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(fields) {
        let (_, field_expr) = Array::get(fields, i)
        ArrayBuilder::push(exprs, field_expr)
        i = i + 1
      }
      collect_expr_array(ArrayBuilder::freeze(exprs))
    },
    ESpread(inner) => collect_expr_shell_effects(inner),
    EStringInterp(_) => empty_strings()
  }
}

let collect_stmt_shell_effects = (stmts: Array[Stmt]) -> Array[String] {
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    let nested = match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => collect_expr_shell_effects(expr),
      SLetMut(_, _, expr) => collect_expr_shell_effects(expr),
      STest(_, expr) => collect_expr_shell_effects(expr),
      SBench(_, expr) => collect_expr_shell_effects(expr),
      SExpr(expr) => collect_expr_shell_effects(expr),
      SModule(_, _, body) => collect_stmt_shell_effects(body),
      _ => empty_strings()
    }
    let mut j = 0
    while j < Array::length(nested) {
      ArrayBuilder::push(out, Array::get(nested, j))
      j = j + 1
    }
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

export let assert_preloaded_fixture_success = (path: String, main_source: String, sources: Array[(String, String)], expected_last: String, expected_effects: Option[Array[String]]) -> Unit with { Error } {
  let actual_last = eval_last(path, main_source, sources)
  if not(actual_last == expected_last) {
    throw(String::concat(String::concat("last mismatch: expected ", expected_last), String::concat(", got ", actual_last)))
  }
  match expected_effects {
    Some(expect) => {
      let actual = collect_stmt_shell_effects(parse_program(lex(main_source)))
      if not(string_array_eq(actual, expect)) {
        throw(String::concat("effects mismatch in ", path))
      }
    },
    None => ()
  }
}
