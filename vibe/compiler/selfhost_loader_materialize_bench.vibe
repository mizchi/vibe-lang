//# Imports

import ./loader_hotspot_probe.vibe {
  load_selfhost_loader_hotspot_fixture,
  load_selfhost_loader_hotspot_indexed_fixture,
  probe_loader_manifest_groups_indexed_encoded_with_source_index,
  probe_loader_manifest_groups_linear_encoded,
  probe_loader_manifest_list_filter_source_indexed_count,
  probe_loader_manifest_list_filter_linear_count
}

import ./loader/manifest_sources.vibe {
  build_manifest_path_index,
  build_manifest_source_index
}

//# Misc

let empty_source_pairs: Array[(String, String)] = Array::slice([("", "")], 0, 0)
let empty_paths: Array[String] = Array::slice([""], 0, 0)
let empty_source_index = build_manifest_source_index(empty_source_pairs)
let empty_path_index = build_manifest_path_index(empty_paths)

let selfhost_base_dir: Array[String] = [""]
let selfhost_manifest_rows: Array[Array[(String, String)]] = [empty_source_pairs]
let selfhost_preloaded_sources: Array[Array[(String, String)]] = [empty_source_pairs]
let selfhost_needed_sources: Array[Array[(String, String)]] = [empty_source_pairs]
let selfhost_needed_paths: Array[Array[String]] = [empty_paths]

let selfhost_indexed_needed_paths: Array[Array[String]] = [empty_paths]
let selfhost_preloaded_source_index: Array[Map[String, String]] = [empty_source_index]
let selfhost_needed_source_index: Array[Map[String, String]] = [empty_source_index]
let _selfhost_needed_path_index: Array[Map[String, Bool]] = [empty_path_index]

let bench_setup: () -> Int with { Error, Fs } = () -> {
  let (
    base_dir,
    manifest_rows,
    preloaded_sources,
    needed_sources,
    needed_paths
  ) = load_selfhost_loader_hotspot_fixture()
  selfhost_base_dir[0] = base_dir
  selfhost_manifest_rows[0] = manifest_rows
  selfhost_preloaded_sources[0] = preloaded_sources
  selfhost_needed_sources[0] = needed_sources
  selfhost_needed_paths[0] = needed_paths

  let (
    _indexed_base_dir,
    _indexed_manifest_rows,
    _indexed_preloaded_sources,
    _indexed_needed_sources,
    indexed_needed_paths,
    preloaded_source_index,
    needed_path_index,
    needed_source_index
  ) = load_selfhost_loader_hotspot_indexed_fixture()
  selfhost_indexed_needed_paths[0] = indexed_needed_paths
  selfhost_preloaded_source_index[0] = preloaded_source_index
  _selfhost_needed_path_index[0] = needed_path_index
  selfhost_needed_source_index[0] = needed_source_index
  0
}

bench "selfhost/loader_manifest_list_filter_linear" {
  let _ = probe_loader_manifest_list_filter_linear_count(
    selfhost_preloaded_sources[0],
    selfhost_needed_paths[0]
  )
}

bench "selfhost/loader_manifest_list_filter_indexed" {
  let _ = probe_loader_manifest_list_filter_source_indexed_count(
    selfhost_indexed_needed_paths[0],
    selfhost_preloaded_source_index[0]
  )
}

bench "selfhost/loader_manifest_groups_linear" {
  let _ = probe_loader_manifest_groups_linear_encoded(
    selfhost_base_dir[0],
    selfhost_manifest_rows[0],
    selfhost_needed_sources[0]
  )
}

bench "selfhost/loader_manifest_groups_indexed" {
  let _ = probe_loader_manifest_groups_indexed_encoded_with_source_index(
    selfhost_base_dir[0],
    selfhost_manifest_rows[0],
    selfhost_needed_source_index[0]
  )
}
