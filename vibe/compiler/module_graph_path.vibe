//# Functions

export let dir_of_path = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  } else if idx == 0 {
    "/"
  } else {
    file_path[0: idx]
  }
}

export let contains_name = (items: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

export let contains_path = (visited: Array[String], path: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(visited) && !found {
    if Array::get(visited, i) == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

export let normalize_path = (path: String) -> String {
  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47
  let mut parts = Array::slice([
    ""
  ], 0, 0)
  let len = String::length(path)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_sep = if i == len {
      true
    } else {
      String::char_code_at(path, i) == 47
    }
    if at_sep {
      let part = path[start: i]
      let skip_part = if String::length(part) == 0 {
        true
      } else {
        part == "."
      }
      if skip_part {
        ()
      } else if part == ".." {
        // O(1) truncate vs. previous O(N) copy of `parts[0:N-1]` into a
        // fresh Array.
        if Array::length(parts) > 0 {
          Array::truncate(parts, Array::length(parts) - 1)
        }
      } else {
        Array::push(parts, part)
      }
      start = i + 1
    }
    i = i + 1
  }
  // Build the joined output via StringBuilder. The previous code did
  // `out = String::concat(out, ...)` in a loop, which is O(N²) over the
  // segment count because each concat allocates and copies the growing
  // string. Same shape as the StringBuilder migrations issue #366
  // tracks for the rest of selfhost.
  let buf = StringBuilder::new()
  if is_absolute {
    StringBuilder::push(buf, "/")
  }
  let mut pi = 0
  while pi < Array::length(parts) {
    if pi > 0 {
      StringBuilder::push(buf, "/")
    }
    StringBuilder::push(buf, Array::get(parts, pi))
    pi = pi + 1
  }
  StringBuilder::freeze(buf)
}

export let get_export_name = (items: Array[(String, Option[String])], name: String) -> String {
  let mut result = name
  let mut i = 0
  while i < Array::length(items) {
    let (iname, irename) = Array::get(items, i)
    if iname == name {
      match irename {
        Some(alias) => {
          result = alias
        },
        None => ()
      }
    }
    i = i + 1
  }
  result
}

let join_relative_path = (base_dir: String, raw_path: String) -> String {
  if base_dir == "" || base_dir == "/" {
    String::concat(base_dir, raw_path)
  } else {
    String::concat(base_dir, String::concat("/", raw_path))
  }
}

export let path_to_module_name = (path: String) -> String {
  let len = String::length(path)
  let mut last_slash = -1
  let mut i = 0
  while i < len {
    if String::char_code_at(path, i) == 47 {
      last_slash = i
    }
    i = i + 1
  }
  let base = if last_slash >= 0 {
    path[last_slash + 1: len]
  } else {
    path
  }
  let base_len = String::length(base)
  if String::ends_with(base, ".vibe") {
    base[0: base_len - 5]
  } else {
    base
  }
}

export let path_has_relative_prefix = (raw_path: String, len: Int) -> Bool {
  if len >= 2 {
    if raw_path[0: 2] == "./" {
      true
    } else if len >= 3 {
      raw_path[0: 3] == "../"
    } else {
      false
    }
  } else {
    false
  }
}

export let resolve_import_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    join_relative_path(base_dir, raw_path)
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    normalized
  } else {
    String::concat(normalized, ".vibe")
  }
}

export let resolve_import_path_candidates = (base_dir: String, raw_path: String) -> Array[String] {
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    join_relative_path(base_dir, raw_path)
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    [
      normalized
    ]
  } else {
    [
      String::concat(normalized, ".vibe"),
      String::concat(normalized, "/index.vibe")
    ]
  }
}
