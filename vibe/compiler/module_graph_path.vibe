//# Functions

export let dir_of_path: (String) -> String = (file_path) -> {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  } else if idx == 0 {
    "/"
  } else {
    file_path[0: idx]
  }
}

// Linear membership scan used by `resolve_reexport_chain` to filter
// re-exported names. Bounded per-module, not whole-program: `items`
// (`wanted_names`) is a single re-export selection (typically 1-5 names)
// and it is scanned once per pub statement of one source file. The
// original O(N^2)-accumulator survey (#366) classified this as "small N,
// refactor pointless" and #533 re-confirms it. A `Map[String, Bool]`
// would NOT help: the selfhost runtime emits `Map::has_key` as a linear
// search (#395, closed not-planned). See
// bench/selfhost_perf/README.md ("String-keyed lookup" postmortem).
export let contains_name: (Array[String], String) -> Bool = (items, name) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

// Linear membership scan used by `collect_direct_dep_paths` to dedup the
// direct dependency paths of one entry file. Bounded by that file's
// unique imports (≈5-30), so the dedup is O(D^2) with small D (≤ ~900
// ops, per #366's survey). NOTE: the whole-graph visited/scheduled sets
// that used to route through this helper (merge recursion, FS collect,
// manifest worklists) moved to the bucketed `path_set` below (#533);
// only genuinely small, per-module dedups should keep using this. Kept
// linear deliberately for those (#533):
//   - `Map[String, Bool]` is a no-op — the selfhost runtime emits
//     `Map::has_key`/`Map::get` as linear searches (#395 not-planned).
//   - A sort+merge dedup is UNSAFE: the resulting `dep_paths` order is
//     preserved into `linked_imports`, which the linked codegen turns
//     into wasm import-section indices (see
//     vibe/compiler/codegen/wasi/linked_compile.vibe). Reordering would
//     change the emitted binary, breaking reproducibility/parity.
// First-occurrence insertion order must therefore be preserved.
export let contains_path: (Array[String], String) -> Bool = (visited, path) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(visited) && !found {
    if Array::get(visited, i) == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

// #533: mutable bucketed string set for whole-graph membership tests.
//
// The per-module `contains_name` / `contains_path` scans above are fine
// (small bounded N — see the notes on each), but the graph-traversal
// dedup sites (`collect_sources_rec`, `collect_merged_stmts_recursive`,
// the manifest worklist loops) test membership against a set that grows
// to ALL modules, once per import edge — O(edges × modules) string
// compares, plus O(modules²) entry copying where the set was a
// `Map[String, Bool]` (the runtime `Map::set` copies the whole map per
// insert; `Map::has_key` is a linear scan — #395, closed not-planned).
//
// This set is plain `Array[Array[String]]` buckets + `Array::push`, so
// it relies on nothing but O(1)-amortized array ops: membership and
// insert are O(len(path)) hash + a short bucket scan, independent of
// module count. Insert-only; iteration order is NOT meaningful — callers
// that need ordered output must keep their own insertion-ordered array
// (see the reorder hazard on `contains_path` above).
let path_set_bucket_count = 64

let path_set_hash: (String) -> Int = (s) -> {
  let len = String::length(s)
  let mut h = 5381
  let mut i = 0
  while i < len {
    // djb2-xor, masked to 30 bits so `h * 33` stays far below the 61-bit
    // tagged-int range.
    h = ((h * 33) ^ String::char_code_at(s, i)) & 0x3FFFFFFF
    i = i + 1
  }
  h
}

export let path_set_new: () -> Array[Array[String]] = () -> {
  let buckets = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let mut i = 0
  while i < path_set_bucket_count {
    Array::push(buckets, Array::slice([
      ""
    ], 0, 0))
    i = i + 1
  }
  buckets
}

export let path_set_contains: (Array[Array[String]], String) -> Bool = (set, path) -> {
  let bucket = Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1))
  let mut i = 0
  let mut found = false
  while i < Array::length(bucket) && !found {
    if Array::get(bucket, i) == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

// No membership check: callers gate on `path_set_contains` first (every
// site below is check-then-add), so adding unconditionally here avoids a
// second hash walk.
export let path_set_add: (Array[Array[String]], String) -> Unit = (set, path) -> {
  Array::push(Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1)), path)
}

export let normalize_path: (String) -> String = (path) -> {
  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47
  let mut parts = Array::slice([
    ""
  ], 0, 0)
  let len = String::length(path)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_sep = if i == len {
      true
    } else {
      String::char_code_at(path, i) == 47
    }
    if at_sep {
      let part = path[start: i]
      let skip_part = if String::length(part) == 0 {
        true
      } else {
        part == "."
      }
      if skip_part {
        ()
      } else if part == ".." {
        // O(1) truncate vs. previous O(N) copy of `parts[0:N-1]` into a
        // fresh Array.
        if Array::length(parts) > 0 {
          Array::truncate(parts, Array::length(parts) - 1)
        }
      } else {
        Array::push(parts, part)
      }
      start = i + 1
    }
    i = i + 1
  }
  // Build the joined output via StringBuilder. The previous code did
  // `out = String::concat(out, ...)` in a loop, which is O(N²) over the
  // segment count because each concat allocates and copies the growing
  // string. Same shape as the StringBuilder migrations issue #366
  // tracks for the rest of selfhost.
  let buf = StringBuilder::new()
  if is_absolute {
    StringBuilder::push(buf, "/")
  }
  let mut pi = 0
  while pi < Array::length(parts) {
    if pi > 0 {
      StringBuilder::push(buf, "/")
    }
    StringBuilder::push(buf, Array::get(parts, pi))
    pi = pi + 1
  }
  StringBuilder::freeze(buf)
}

export let get_export_name: (Array[(String, Option[String])], String) -> String = (items, name) -> {
  let mut result = name
  let mut i = 0
  while i < Array::length(items) {
    let (iname, irename) = Array::get(items, i)
    if iname == name {
      match irename {
        Some(alias) => {
          result = alias
        },
        None => ()
      }
    }
    i = i + 1
  }
  result
}

let join_relative_path: (String, String) -> String = (base_dir, raw_path) -> {
  if base_dir == "" || base_dir == "/" {
    String::concat(base_dir, raw_path)
  } else {
    String::concat(base_dir, String::concat("/", raw_path))
  }
}

export let path_to_module_name: (String) -> String = (path) -> {
  let len = String::length(path)
  let mut last_slash = -1
  let mut i = 0
  while i < len {
    if String::char_code_at(path, i) == 47 {
      last_slash = i
    }
    i = i + 1
  }
  let base = if last_slash >= 0 {
    path[last_slash + 1: len]
  } else {
    path
  }
  let base_len = String::length(base)
  if String::ends_with(base, ".vibe") {
    base[0: base_len - 5]
  } else {
    base
  }
}

export let path_has_relative_prefix: (String, Int) -> Bool = (raw_path, len) -> {
  if len >= 2 {
    if raw_path[0: 2] == "./" {
      true
    } else if len >= 3 {
      raw_path[0: 3] == "../"
    } else {
      false
    }
  } else {
    false
  }
}

export let resolve_import_path: (String, String) -> String = (base_dir, raw_path) -> {
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    join_relative_path(base_dir, raw_path)
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    normalized
  } else {
    String::concat(normalized, ".vibe")
  }
}

export let resolve_import_path_candidates: (String, String) -> Array[String] = (base_dir, raw_path) -> {
  // #730 (ADR-0063 §5/§6): `@scope/name` package refs resolve to the
  // workspace store, laid out BY NAME and verified BY HASH against the
  // importer's require pin (verification happens in the loader; this
  // function stays pure). Root-relative, independent of base_dir.
  if String::starts_with(raw_path, "@") {
    return [
      String::concat(".vibe/store/", String::concat(raw_path, "/index.vibei"))
    ]
  } else ()
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    join_relative_path(base_dir, raw_path)
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    [
      normalized
    ]
  } else {
    // #729: a bare (directory-style) import may target a contract package —
    // `<dir>/index.vibei` is probed between the plain-file and index.vibe
    // forms. Existence-probing resolvers pick it up when present; index-0
    // stays the plain-file form so no-match fallbacks are unchanged.
    [
      String::concat(normalized, ".vibe"),
      String::concat(normalized, "/index.vibei"),
      String::concat(normalized, "/index.vibe")
    ]
  }
}
