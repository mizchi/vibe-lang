//# `vibe normalize` engine (selfhost vertical slice, #594)
//#
//# A canonicalizing source transform built on the compiler's own AST. The first
//# slice implements the structural pipeline:
//#
//#   parse -> flatten modules (`module m { let f }` => `let m::f`)
//#         -> dead-code elimination from exported roots
//#         -> drop redundant aggregate `export { .. }` statements
//#         -> categorize into Imports / Types / Functions / Tests sections
//#         -> render via the AST printer with section headers + blank lines
//#
//# Deferred to follow-ups (the host engine is ~6.6k lines): inline/const fold,
//# inferred type annotations, decl-separator / labeled-arg quickfixes, and
//# semver dependency `latest` resolution.

//# Imports

import ../contract/index.vibe {
  extract_require_pins
}

import ../core/ast.vibe {
  Stmt, TypeExpr, Expr, Pat
}

import ../core/dce.vibe {
  dce_stmts
}

import ../syntax/index.vibe {
  Token, lex, parse_program, print_stmt
}

import ../syntax/import_alias_rewrite.vibe {
  rewrite_import_alias_expr
}

//# Module flattening

let empty_stmts: () -> Array[Stmt] = () -> {
  Array::slice([
    SExport([])
  ], 0, 0)
}

let empty_strs: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

// Prefix a binding name with the enclosing module path (`math` + `helper` =>
// `math::helper`). Empty prefix leaves the name unchanged.
let join_module_name: (String, String) -> String = (prefix, name) -> {
  if prefix == "" {
    name
  } else {
    String::concat(prefix, String::concat("::", name))
  }
}

// Alias map (short name -> `prefix::name`) for the value members of a module
// body, so intra-module references can be qualified to match the renamed decls.
let rec module_value_aliases: (Array[Stmt], String, Array[(String, String)]) -> Int = (body, prefix, out) -> {
  let mut i = 0
  while i < Array::length(body) {
    match Array::get(body, i) {
      SLet(_, _, name, _, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SLetMut(name, _, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SExternLet(name, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SModule(_, inner, inner_body) => {
        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)
        0
      },
      _ => 0
    }
    i = i + 1
  }
  0
}

// Flatten a (DCE'd) module body to top-level decls: rename each value binding to
// `prefix::name` AND qualify intra-module value references in its body, so the
// flattened source typechecks without the enclosing module scope (a sibling call
// `helper()` becomes `m::helper()`, matching the renamed `let m::helper`).
let rec flatten_module_body: (Array[Stmt], String, Array[(String, String)], Array[Stmt]) -> Int = (body, prefix, aliases, out) -> {
  let mut i = 0
  while i < Array::length(body) {
    match Array::get(body, i) {
      SLet(exp, is_rec, name, ty, b) => {
        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))
        0
      },
      SLetMut(name, ty, b) => {
        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))
        0
      },
      SExternLet(name, ty) => {
        Array::push(out, SExternLet(join_module_name(prefix, name), ty))
        0
      },
      SModule(_, inner, inner_body) => {
        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), aliases, out)
        0
      },
      other => {
        Array::push(out, other)
        0
      }
    }
    i = i + 1
  }
  0
}

let is_module_stmt: (Stmt) -> Bool = (stmt) -> {
  match stmt {
    SModule(_, _, _) => true,
    _ => false
  }
}

//# Exported roots for DCE

// Roots for top-level DCE: exported value bindings, plus any already
// module-qualified binding (a `m::f` name). Flattening renames a kept module
// member to `m::f` while leaving its body referencing the short `f`, so a
// second normalize pass must not drop those by name — keeping all `::` names
// (module members are live by construction) makes normalize idempotent.
let exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let roots = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, _, name, _, _) => if exp || String::contains(name, "::") {
        Array::push(roots, name)
      },
      SLetMut(name, _, _) => if String::contains(name, "::") {
        Array::push(roots, name)
      },
      // Aggregate `export { a, b }` also marks an exported API; without this a
      // file whose only export is `export { run }` would DCE everything away.
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          Array::push(roots, Array::get(names, j))
          j = j + 1
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  roots
}

// Names that an aggregate `export { .. }` re-exports (the renderer drops the
// `SExport` statement, so the underlying bindings must be promoted to keep the
// public API).
let aggregate_export_names: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let names = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SExport(exported) => {
        let mut j = 0
        while j < Array::length(exported) {
          Array::push(names, Array::get(exported, j))
          j = j + 1
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  names
}

let str_array_has: (Array[String], String) -> Bool = (arr, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) && !found {
    if Array::get(arr, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let promote_aggregate_exports: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, agg) -> {
  let result = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    let promoted = match stmt {
      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {
        SLet(true, is_rec, name, ty, body)
      } else {
        stmt
      },
      _ => stmt
    }
    Array::push(result, promoted)
    i = i + 1
  }
  result
}

//# Type-alias DCE: drop non-exported aliases whose name is never referenced.

let rec collect_type_names_into: (TypeExpr, Array[String]) -> Int = (ty, out) -> {
  match ty {
    TyName(n) => {
      Array::push(out, n)
      0
    },
    TyApp(n, args) => {
      Array::push(out, n)
      let mut i = 0
      while i < Array::length(args) {
        let _ = collect_type_names_into(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let _ = collect_type_names_into(Array::get(params, i), out)
        i = i + 1
      }
      let _ = collect_type_names_into(ret, out)
      0
    },
    TyTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        let _ = collect_type_names_into(Array::get(items, i), out)
        i = i + 1
      }
      0
    },
    TyUnit => 0
  }
}

let collect_opt_type_into: (Option[TypeExpr], Array[String]) -> Int = (ty_opt, out) -> {
  match ty_opt {
    Some(ty) => collect_type_names_into(ty, out),
    None => 0
  }
}

// Collect every type-name referenced by a statement.
let collect_stmt_type_refs_into: (Stmt, Array[String]) -> Int = (stmt, out) -> {
  match stmt {
    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),
    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),
    SExternLet(_, ty) => collect_type_names_into(ty, out),
    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),
    SStruct(_, _, fields, _, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fty) = Array::get(fields, i)
        let _ = collect_type_names_into(fty, out)
        i = i + 1
      }
      0
    },
    SEnum(_, _, _, ctors, _) => {
      let mut i = 0
      while i < Array::length(ctors) {
        let (_, args) = Array::get(ctors, i)
        let mut j = 0
        while j < Array::length(args) {
          let _ = collect_type_names_into(Array::get(args, j), out)
          j = j + 1
        }
        i = i + 1
      }
      0
    },
    SImpl(_, _, _, type_name) => {
      Array::push(out, type_name)
      0
    },
    _ => 0
  }
}


let drop_unused_type_aliases: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let referenced = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)
    i = i + 1
  }
  let result = empty_stmts()
  let mut k = 0
  while k < Array::length(stmts) {
    let stmt = Array::get(stmts, k)
    let keep = match stmt {
      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),
      _ => true
    }
    if keep {
      Array::push(result, stmt)
    }
    k = k + 1
  }
  result
}

//# Categorize + render

// 0 = import, 1 = type/structural, 2 = function/value, 3 = test/bench,
// 9 = drop (aggregate export / bare expression).
let stmt_section: (Stmt) -> Int = (stmt) -> {
  match stmt {
    SImport(_, _) => 0,
    SReExport(_, _) => 0,
    SAliasDecl(_, _) => 0,
    SEnum(_, _, _, _, _) => 1,
    SSuberror(_, _, _) => 1,
    SStruct(_, _, _, _, _) => 1,
    STypeAlias(_, _, _, _) => 1,
    STrait(_, _, _, _, _) => 1,
    SImpl(_, _, _, _) => 1,
    SEffectDef(_, _, _, _) => 1,
    SExternLet(_, _) => 1,
    SLet(_, _, _, _, _) => 2,
    SLetMut(_, _, _) => 2,
    SLetPat(_, _) => 2,
    STest(_, _) => 3,
    SBench(_, _) => 3,
    SExport(_) => 9,
    SExpr(_) => 9,
    _ => 9
  }
}

let section_header: (Int) -> String = (section) -> {
  if section == 0 {
    "//# Imports"
  } else if section == 1 {
    "//# Types"
  } else if section == 2 {
    "//# Functions"
  } else {
    "//# Tests"
  }
}

// Render all statements in one section (already filtered) joined by blank lines,
// prefixed by the section header. Returns "" when the section is empty.
let render_section: (Array[Stmt], Int) -> String = (stmts, section) -> {
  let parts = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if stmt_section(stmt) == section {
      Array::push(parts, print_stmt(stmt))
    }
    i = i + 1
  }
  if Array::length(parts) == 0 {
    ""
  } else {
    let body = String::join(parts, "\n\n")
    String::concat(section_header(section), String::concat("\n\n", body))
  }
}

//# Lambda-annotation hoisting

let normalize_empty_type_exprs: () -> Array[TypeExpr] = () -> {
  Array::slice([
    TyUnit
  ], 0, 0)
}

let all_params_typed: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {
  let mut i = 0
  let mut ok = true
  while i < Array::length(params) {
    let (_, ty_opt) = Array::get(params, i)
    match ty_opt {
      Some(_) => 0,
      None => {
        ok = false
        0
      }
    }
    i = i + 1
  }
  ok
}

let param_type_list: (Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] = (params) -> {
  let out = normalize_empty_type_exprs()
  let mut i = 0
  while i < Array::length(params) {
    let (_, ty_opt) = Array::get(params, i)
    match ty_opt {
      Some(ty) => Array::push(out, ty),
      None => 0
    }
    i = i + 1
  }
  out
}

let strip_param_types: (Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (params) -> {
  let out = Array::slice([
    ("", None)
  ], 0, 0)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    Array::push(out, (name, None))
    i = i + 1
  }
  out
}

// Canonicalize an old-syntax lambda binding `let f = (x: T) -> R { body }` to
// the annotated form `let f: (T) -> R = (x) -> { body }`: move the parameter
// types + return type into a `TyFn` let-annotation and strip them from the
// lambda. Only when the let has no annotation yet, the value is a return-type
// annotated lambda, and every parameter carries a type (full type recoverable).
let hoist_lambda_let: (Stmt) -> Stmt = (stmt) -> {
  match stmt {
    SLet(exp, is_rec, name, ty, value) => match ty {
      Some(_) => stmt,
      None => match value {
        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {
          None => stmt,
          // Skip generic lambdas: their `[T]` type params scope the lambda, not
          // the let annotation, so hoisting `[T](x: T) -> T` to `: (T) -> T =
          // [T](x) -> {...}` would leave `T` unbound in the annotation and the
          // normalized output would not compile.
          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {
            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))
          } else {
            stmt
          }
        },
        _ => stmt
      }
    },
    _ => stmt
  }
}

let hoist_lambda_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))
    i = i + 1
  }
  out
}

//# Constant folding

// Fold a binary op on two int literals. Only the closed arithmetic ops `+ - *`,
// which are total and wrap identically at compile time and runtime (both use
// 62-bit Int), so folding is semantics-preserving. `/` and `%` are skipped
// (a literal `x / 0` must keep trapping at runtime, not at fold time).
let fold_int_binop: (String, Int, Int) -> Option[Int] = (op, a, b) -> {
  if op == "+" {
    Some(a + b)
  } else if op == "-" {
    Some(a - b)
  } else if op == "*" {
    Some(a * b)
  } else {
    None
  }
}

let rec fold_expr: (Expr) -> Expr = (expr) -> {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      fold_expr(it)
    }),
    EArray(items) => EArray(for it in items {
      fold_expr(it)
    }),
    ERecord(fields) => ERecord(for f in fields {
      let (n, v) = f
      (n, fold_expr(v))
    }),
    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),
    ELet(n, v, b) => ELet(n, fold_expr(v), fold_expr(b)),
    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),
    ELetMut(n, v, b) => ELetMut(n, fold_expr(v), fold_expr(b)),
    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),
    EAssignOp(op, n, v, b) => EAssignOp(op, n, fold_expr(v), fold_expr(b)),
    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),
    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {
      let (p, e) = a
      (p, fold_expr(e))
    }),
    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {
      let (p, e) = a
      (p, fold_expr(e))
    }),
    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),
    ELoop(params, b) => ELoop(for pr in params {
      let (n, init) = pr
      (n, fold_expr(init))
    }, fold_expr(b)),
    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),
    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {
      fold_expr(a)
    }, off),
    EBinOp(op, l, r) => {
      let fl = fold_expr(l)
      let fr = fold_expr(r)
      match fl {
        EInt(a) => match fr {
          EInt(b) => match fold_int_binop(op, a, b) {
            Some(v) => EInt(v),
            None => EBinOp(op, fl, fr)
          },
          _ => EBinOp(op, fl, fr)
        },
        _ => EBinOp(op, fl, fr)
      }
    },
    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),
    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),
    EDot(e, field, off) => EDot(fold_expr(e), field, off),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),
    EThrow(e) => EThrow(fold_expr(e)),
    EReturn(e) => EReturn(fold_expr(e)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(fold_expr(v))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      fold_expr(a)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, fold_expr(v))
    }),
    ESpread(e) => ESpread(fold_expr(e))
  }
}

// #703 follow-up: lift a temporary (non-variable) match scrutinee into a `let`
// so the Perceus RC pass — which attributes drops to NAMED bindings — gives it
// a scope-end drop. `match <e> { arms }` -> `let __m_scrut_N = <e> in match
// __m_scrut_N { arms }` when `<e>` is not already an identifier. Without a
// binding the fresh owned heap value the scrutinee produces (`match foo() {
// .. }`, `match Some(x) { .. }`) is never dropped and leaks under RC.
//
// #708: the lift name MUST be unique per lift site (the `_N` suffix, from a
// counter cell threaded through every recursive call). A single non-unique
// name shared by every lift in a function is not just an RC-drop-scheduling
// hazard (the original #708 fix) — when two lifts NEST (a match whose
// scrutinee is itself a non-identifier match, e.g. `let (a,b) = match
// <call> { .. }`, which the parser also desugars through a match-over-a-
// match), the OUTER lift's own body-compile resolves the identifier by
// searching local slots most-recent-first. Since the INNER lift (compiled
// while evaluating the outer lift's OWN value) pushes the identical name
// *after* the outer one, that search finds the inner (already out-of-scope)
// binding instead of the outer one it meant to reference — reading whatever
// unrelated heap object the inner scrutinee held (e.g. a `Token`) as if it
// were the outer's freshly-built tuple, and misinterpreting its raw memory
// as tuple fields. This produced garbage values (not a crash) for a `let
// (a,b,c,d) = match <call> {..}` pattern local's fields — confirmed via a
// minimal repro and fixed by this uniqueness change (see #708 follow-up
// investigation notes). Modeled on fold_expr's complete walk; only the
// EMatch case differs. EHandle is left as-is (effect handlers are not the
// same ownership shape). Pure rewrite (aside from the counter cell) —
// applied to each function body before build_perceus_plan so the plan and
// codegen agree; running it on the non-RC backend would be harmless but it is
// gated at the call site to keep that backend byte-identical.
// #712: RC codegen's per-function bookkeeping (CompileCtx's `heap_binding_names`,
// `rc_drop_names`, `rc_alias_dup_names`, `rc_dup_names`, `loop_borrowed_names`,
// etc., and the Perceus plan itself) all key on the bare identifier NAME, not
// binding identity. When an inner scope shadows an outer binding of the same
// name (`let x = ...; { let x = ...; f(x) }`, or a `while` loop body rebinding
// a name the loop already loop-borrows), those name-keyed lookups cannot tell
// the two `x`s apart -- an action meant for one binding can fire at the other's
// site instead (spurious/missing rc_dup, premature/missing rc_drop).
//
// Rather than retrofit every name-keyed consumer with binding identity (a
// larger, more invasive change -- see #712), this eliminates the ambiguity at
// the source: alpha-rename every binding that shadows an enclosing one to a
// fresh, globally-unique name before the Perceus plan is built, so no two live
// bindings in one function ever share a name. Modeled on lift_match_scrutinees
// (#708) -- same shared-counter-cell technique for uniqueness, same complete
// per-Expr-variant walk. Unshadowed bindings (the vast majority) are left with
// their original name (so debugging/argument-inspection output is unaffected
// outside the rare shadowing case). Pure rewrite; gated at the call site to
// keep the non-RC backend byte-identical.
let fresh_shadow_name: (Array[Int], String) -> String = (counter, name) -> {
  let n = Array::get(counter, 0)
  Array::set(counter, 0, n + 1)
  String::concat(String::concat("__shadow_", __to_string(n)), String::concat("_", name))
}

// Renamed reference for `name` under `env`, or `name` unchanged if it is not a
// tracked (shadowed-or-not) binding -- i.e. a free variable / global / builtin.
let uq_lookup: (Map[String, String], String) -> String = (env, name) -> {
  if Map::has_key(env, name) {
    Map::get(env, name)
  } else {
    name
  }
}

// #715: has `name` been bound ANYWHERE in this function already (including a
// sibling scope that has since closed)? `seen` is a shared mutable array, one
// per top-level function, appended by uq_bind_name's first-binder path.
let uq_seen_contains: (Array[String], String) -> Bool = (seen, name) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(seen) {
    if Array::get(seen, i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// Introduce binding `name` into `env`. If `name` is already tracked (bound by
// an enclosing scope, shadowed or not), this occurrence shadows it: mint a
// fresh unique name and map `name` to it for the extent of the inner scope.
//
// #715: ALSO rename when `name` was bound anywhere EARLIER in this same
// function, even in an already-closed sibling scope (two match arms both
// declaring `let resolved = ...`). The Perceus plan's actions and codegen's
// bookkeeping (rc_drop_names / rc_dup_names / heap_binding_names) are flat,
// name-keyed, whole-function lists, so two same-named sibling bindings
// receive each other's planned dups/drops -- confirmed as the #715 checker
// crash: check_expr declares `let resolved` in four sibling scopes; a
// scope-end PaDrop planned for one fired at another whose reference had
// already been consumed through resolve_tparams_in, freeing the block a
// still-live tuple pointed at (use-after-free at the `pt` destructure dup).
//
// Otherwise this is the first binder for `name` in this function; keep it
// as-is but still record the identity mapping, so a DEEPER shadow of the same
// name is detected against this occurrence.
let uq_bind_name: (String, Map[String, String], Array[Int], Array[String]) -> (String, Map[String, String]) = (name, env, counter, seen) -> {
  // A labeled/optional param (`a~`/`a?`) is declared with its suffix but its
  // body references use the STRIPPED name, so this env (keyed by the declared
  // name) never rewrites those references anyway -- renaming the declaration
  // alone would orphan them. Leave such params untouched (status quo).
  let nlen = String::length(name)
  let lastc = if nlen > 0 {
    String::char_code_at(name, nlen - 1)
  } else {
    0
  }
  if lastc == '~' || lastc == '?' {
    (name, env)
  } else if Map::has_key(env, name) || uq_seen_contains(seen, name) {
    let fresh = fresh_shadow_name(counter, name)
    (fresh, Map::set(env, name, fresh))
  } else {
    Array::push(seen, name)
    (name, Map::set(env, name, name))
  }
}

let rec uq_pat_names: (Pat, Array[String]) -> Unit = (pat, out) -> {
  match pat {
    PBind(name) => Array::push(out, name),
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        uq_pat_names(Array::get(args, i), out)
        i = i + 1
      }
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        uq_pat_names(Array::get(pats, i), out)
        i = i + 1
      }
    },
    POr(l, _r) => uq_pat_names(l, out),
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        uq_pat_names(fp, out)
        i = i + 1
      }
    },
    PInt(_) => (),
    PFloat(_) => (),
    PString(_) => (),
    PBool(_) => (),
    PWild => ()
  }
}

let rec uq_pat_rewrite: (Pat, Map[String, String]) -> Pat = (pat, env) -> {
  match pat {
    PBind(name) => PBind(uq_lookup(env, name)),
    PCtor(name, args) => PCtor(name, for a in args {
      uq_pat_rewrite(a, env)
    }),
    PTuple(pats) => PTuple(for a in pats {
      uq_pat_rewrite(a, env)
    }),
    POr(l, r) => POr(uq_pat_rewrite(l, env), uq_pat_rewrite(r, env)),
    PStruct(name, fields) => PStruct(name, for f in fields {
      let (fname, fp) = f
      (fname, uq_pat_rewrite(fp, env))
    }),
    _ => pat
  }
}

// Binds every name in `pat` (shadow-checked against `env`) and returns the
// rewritten pattern together with the extended env for the pattern's own
// scope (the arm body).
let uq_bind_pat: (Pat, Map[String, String], Array[Int], Array[String]) -> (Pat, Map[String, String]) = (pat, env, counter, seen) -> {
  let names: Array[String] = [
  ]
  uq_pat_names(pat, names)
  let mut env2 = env
  let mut i = 0
  while i < Array::length(names) {
    let (_, env3) = uq_bind_name(Array::get(names, i), env2, counter, seen)
    env2 = env3
    i = i + 1
  }
  (uq_pat_rewrite(pat, env2), env2)
}

export let rec uniquify_shadowed_bindings: (Expr, Map[String, String], Array[Int], Array[String]) -> Expr = (expr, env, counter, seen) -> {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(name, off) => EIdent(uq_lookup(env, name), off),
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      uniquify_shadowed_bindings(it, env, counter, seen)
    }),
    EArray(items) => EArray(for it in items {
      uniquify_shadowed_bindings(it, env, counter, seen)
    }),
    ERecord(fields) => ERecord(for f in fields {
      let (n, v) = f
      (n, uniquify_shadowed_bindings(v, env, counter, seen))
    }),
    EIf(c, t, e) => EIf(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(t, env, counter, seen), uniquify_shadowed_bindings(e, env, counter, seen)),
    ELet(n, v, b) => {
      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)
      let (n2, env2) = uq_bind_name(n, env, counter, seen)
      ELet(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))
    },
    ELetRec(n, v, b) => {
      let (n2, env2) = uq_bind_name(n, env, counter, seen)
      let v2 = uniquify_shadowed_bindings(v, env2, counter, seen)
      ELetRec(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))
    },
    ELetMut(n, v, b) => {
      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)
      let (n2, env2) = uq_bind_name(n, env, counter, seen)
      ELetMut(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))
    },
    EAssign(n, v, b) => EAssign(uq_lookup(env, n), uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),
    EAssignOp(n, op, v, b) => EAssignOp(uq_lookup(env, n), op, uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),
    ESeq(a, b) => ESeq(uniquify_shadowed_bindings(a, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),
    EMatch(s, arms) => EMatch(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {
      let (p, e) = a
      let (p2, env2) = uq_bind_pat(p, env, counter, seen)
      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))
    }),
    EHandle(s, arms) => EHandle(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {
      let (p, e) = a
      let (p2, env2) = uq_bind_pat(p, env, counter, seen)
      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))
    }),
    EWhile(c, b) => EWhile(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),
    ELoop(params, b) => {
      let mut env2 = env
      let zipped: Array[(String, Expr)] = [
      ]
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, init) = Array::get(params, pi)
        let init2 = uniquify_shadowed_bindings(init, env, counter, seen)
        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)
        env2 = envN
        Array::push(zipped, (pn2, init2))
        pi = pi + 1
      }
      ELoop(zipped, uniquify_shadowed_bindings(b, env2, counter, seen))
    },
    EForIn(n, idx, it, b) => {
      let it2 = uniquify_shadowed_bindings(it, env, counter, seen)
      let (n2, env2) = uq_bind_name(n, env, counter, seen)
      let (idx2, env3) = match idx {
        Some(iname) => {
          let (iname2, envI) = uq_bind_name(iname, env2, counter, seen)
          (Some(iname2), envI)
        },
        None => (None, env2)
      }
      EForIn(n2, idx2, it2, uniquify_shadowed_bindings(b, env3, counter, seen))
    },
    ECall(callee, args, off) => ECall(uniquify_shadowed_bindings(callee, env, counter, seen), for a in args {
      uniquify_shadowed_bindings(a, env, counter, seen)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, uniquify_shadowed_bindings(l, env, counter, seen), uniquify_shadowed_bindings(r, env, counter, seen)),
    EUnaryOp(op, e) => EUnaryOp(op, uniquify_shadowed_bindings(e, env, counter, seen)),
    EFn(tp, bounds, params, ret, eff, body) => {
      let mut env2 = env
      let params2: Array[(String, Option[TypeExpr])] = [
      ]
      let mut fi = 0
      while fi < Array::length(params) {
        let (pn, pty) = Array::get(params, fi)
        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)
        env2 = envN
        Array::push(params2, (pn2, pty))
        fi = fi + 1
      }
      EFn(tp, bounds, params2, ret, eff, uniquify_shadowed_bindings(body, env2, counter, seen))
    },
    EDot(e, field, off) => EDot(uniquify_shadowed_bindings(e, env, counter, seen), field, off),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, uniquify_shadowed_bindings(v, env, counter, seen)),
    EThrow(e) => EThrow(uniquify_shadowed_bindings(e, env, counter, seen)),
    EReturn(e) => EReturn(uniquify_shadowed_bindings(e, env, counter, seen)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(uniquify_shadowed_bindings(v, env, counter, seen))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      uniquify_shadowed_bindings(a, env, counter, seen)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, uniquify_shadowed_bindings(v, env, counter, seen))
    }),
    ESpread(e) => ESpread(uniquify_shadowed_bindings(e, env, counter, seen))
  }
}

let fresh_m_scrut_name: (Array[Int]) -> String = (counter) -> {
  let n = Array::get(counter, 0)
  Array::set(counter, 0, n + 1)
  String::concat("__m_scrut_", __to_string(n))
}

export let rec lift_match_scrutinees: (Expr, Array[Int]) -> Expr = (expr, counter) -> {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      lift_match_scrutinees(it, counter)
    }),
    EArray(items) => EArray(for it in items {
      lift_match_scrutinees(it, counter)
    }),
    ERecord(fields) => ERecord(for f in fields {
      let (n, v) = f
      (n, lift_match_scrutinees(v, counter))
    }),
    EIf(c, t, e) => EIf(lift_match_scrutinees(c, counter), lift_match_scrutinees(t, counter), lift_match_scrutinees(e, counter)),
    ELet(n, v, b) => ELet(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),
    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),
    ELetMut(n, v, b) => ELetMut(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),
    EAssign(n, v, b) => EAssign(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),
    EAssignOp(op, n, v, b) => EAssignOp(op, n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),
    ESeq(a, b) => ESeq(lift_match_scrutinees(a, counter), lift_match_scrutinees(b, counter)),
    EMatch(s, arms) => {
      let lifted_arms = for a in arms {
        let (p, e) = a
        (p, lift_match_scrutinees(e, counter))
      }
      let ls = lift_match_scrutinees(s, counter)
      match ls {
        EIdent(_, _) => EMatch(ls, lifted_arms),
        _ => {
          let fresh = fresh_m_scrut_name(counter)
          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms))
        }
      }
    },
    EHandle(s, arms) => EHandle(lift_match_scrutinees(s, counter), for a in arms {
      let (p, e) = a
      (p, lift_match_scrutinees(e, counter))
    }),
    EWhile(c, b) => EWhile(lift_match_scrutinees(c, counter), lift_match_scrutinees(b, counter)),
    ELoop(params, b) => ELoop(for pr in params {
      let (n, init) = pr
      (n, lift_match_scrutinees(init, counter))
    }, lift_match_scrutinees(b, counter)),
    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees(it, counter), lift_match_scrutinees(b, counter)),
    ECall(callee, args, off) => ECall(lift_match_scrutinees(callee, counter), for a in args {
      lift_match_scrutinees(a, counter)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, lift_match_scrutinees(l, counter), lift_match_scrutinees(r, counter)),
    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees(e, counter)),
    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees(body, counter)),
    EDot(e, field, off) => EDot(lift_match_scrutinees(e, counter), field, off),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees(v, counter)),
    EThrow(e) => EThrow(lift_match_scrutinees(e, counter)),
    EReturn(e) => EReturn(lift_match_scrutinees(e, counter)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(lift_match_scrutinees(v, counter))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      lift_match_scrutinees(a, counter)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, lift_match_scrutinees(v, counter))
    }),
    ESpread(e) => ESpread(lift_match_scrutinees(e, counter))
  }
}

let fold_stmt: (Stmt) -> Stmt = (stmt) -> {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),
    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),
    STest(n, body) => STest(n, fold_expr(body)),
    SBench(n, body) => SBench(n, fold_expr(body)),
    SExpr(e) => SExpr(fold_expr(e)),
    SLetPat(p, body) => SLetPat(p, fold_expr(body)),
    _ => stmt
  }
}

let fold_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, fold_stmt(Array::get(stmts, i)))
    i = i + 1
  }
  out
}

//# Literal type annotation

// The type of a value binding whose initializer is a literal of an obvious
// type. Only these self-evident cases are annotated; anything needing real
// inference (a call result, an identifier, arithmetic over non-literals) is
// left unannotated so normalize never asserts a type it cannot prove.
let literal_type: (Expr) -> Option[TypeExpr] = (e) -> {
  match e {
    EInt(_) => Some(TyName("Int")),
    EBool(_) => Some(TyName("Bool")),
    EString(_) => Some(TyName("String")),
    EFloat(_) => Some(TyName("Double")),
    _ => None
  }
}

// Add `: T` to an un-annotated `let x = <literal>` (runs after folding, so e.g.
// `let answer = 40 + 2` -> `let answer = 42` -> `let answer: Int = 42`). Lambda
// values are handled by hoisting, not here (a literal is never an `EFn`).
let annotate_literal_let: (Stmt) -> Stmt = (stmt) -> {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => match ty {
      Some(_) => stmt,
      None => match literal_type(body) {
        Some(t) => SLet(exp, is_rec, name, Some(t), body),
        None => stmt
      }
    },
    _ => stmt
  }
}

let annotate_literal_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, annotate_literal_let(Array::get(stmts, i)))
    i = i + 1
  }
  out
}

// DCE is name-based, so it must run while module members still carry their
// short names (a body says `helper()`, not `math::helper()`). We therefore DCE
// each scope before flattening renames its bindings:
//   - top-level non-module decls are DCE'd against the exported top-level roots;
//   - each module body is DCE'd against its own exported members, then renamed.
export let normalize_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let nonmods = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if !is_module_stmt(stmt) {
      Array::push(nonmods, stmt)
    }
    i = i + 1
  }
  let result = empty_stmts()
  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))
  Array::push_all(result, live_top)
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SModule(_, name, body) => {
        let live_body = dce_stmts(body, exported_value_names(body))
        let aliases = Array::slice([
          ("", "")
        ], 0, 0)
        let _ = module_value_aliases(live_body, name, aliases)
        let _ = flatten_module_body(live_body, name, aliases, result)
        0
      },
      _ => 0
    }
    m = m + 1
  }
  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))
  hoist_lambda_lets(annotate_literal_lets(fold_stmts(drop_unused_type_aliases(promoted))))
}

export let normalize_source: (String) -> String with { Error } = (src) -> {
  // #730 (D-3): require pin lines are a leading directive, not statement
  // grammar — extract them, normalize the remainder, and re-emit them in
  // canonical single-space form above the output. Pin FILLING is the
  // Fs-mode wrapper's job (VIBE_FILL_PINS); this pure engine re-emits
  // pinned and unpinned lines as they are.
  let (req_pins, src_wo_requires) = extract_require_pins(src)
  // #cfg guard: parse_program DROPS inactive #cfg statements, so formatting
  // a #cfg-bearing source would silently delete the disabled code from the
  // re-printed output. Refuse instead.
  let toks_cfg = lex(src_wo_requires)
  let mut ci = 0
  while ci < Array::length(toks_cfg) {
    match Array::get(toks_cfg, ci) {
      THash => throw("cannot normalize a source containing #cfg directives"),
      // #727 guard: `fn` desugars to SLet + EFn at parse time, so re-printing
      // would rewrite fn statements into let-form (and drop `where` clauses,
      // which the Phase A parser skips). Refuse until printer support lands
      // with the fmt migration (ADR-0064 Phase E/G).
      TIdent(tn) => if tn == "fn" {
        throw("cannot normalize a source containing fn statements yet (#727)")
      } else {
        ()
      },
      _ => ()
    }
    ci = ci + 1
  }
  let stmts = parse_program(toks_cfg)
  let kept = normalize_stmts(stmts)
  let sections = empty_strs()
  if Array::length(req_pins) > 0 {
    let req_lines = empty_strs()
    let mut ri = 0
    while ri < Array::length(req_pins) {
      let (rname, rver, rpin) = Array::get(req_pins, ri)
      if rpin == "" {
        Array::push(req_lines, "require \{rname} \{rver}")
      } else {
        Array::push(req_lines, "require \{rname} \{rver} = #\{rpin}")
      }
      ri = ri + 1
    }
    Array::push(sections, String::join(req_lines, "\n"))
  } else ()
  let mut s = 0
  while s <= 3 {
    let rendered = render_section(kept, s)
    if rendered != "" {
      Array::push(sections, rendered)
    }
    s = s + 1
  }
  String::concat(String::join(sections, "\n\n"), "\n")
}
