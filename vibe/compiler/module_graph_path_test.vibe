//# Imports

import ./module_graph_path.vibe {
  parse_vibe_lib_roots, resolve_import_path_candidates
}

//# Misc

test "parse_vibe_lib_roots: VIBE_LIB wins and splits on ':' (#751)" {
  let roots = parse_vibe_lib_roots("/a/lib:/b/vendor/", "/home/u/.vibe", "/home/u")
  assert_eq(Array::length(roots), 2)
  assert(Array::get(roots, 0) == "/a/lib")
  // trailing slash stripped
  assert(Array::get(roots, 1) == "/b/vendor")
}

test "parse_vibe_lib_roots: empty segments dropped (#751)" {
  let roots = parse_vibe_lib_roots("::/x::", "", "")
  assert_eq(Array::length(roots), 1)
  assert(Array::get(roots, 0) == "/x")
}

test "parse_vibe_lib_roots: VIBE_HOME then HOME defaults (#751)" {
  let home_roots = parse_vibe_lib_roots("", "/opt/vibe/", "/home/u")
  assert_eq(Array::length(home_roots), 1)
  assert(Array::get(home_roots, 0) == "/opt/vibe/lib")
  let fallback = parse_vibe_lib_roots("", "", "/home/u")
  assert_eq(Array::length(fallback), 1)
  assert(Array::get(fallback, 0) == "/home/u/.vibe/lib")
  let none = parse_vibe_lib_roots("", "", "")
  assert_eq(Array::length(none), 0)
}

test "@scope candidates: store first, workspace lib/ second (#751)" {
  // external roots (candidates 2..) depend on the process environment, so
  // only the fixed prefix is asserted here; the env-dependent tail is
  // covered by gate 6i.
  let cands = resolve_import_path_candidates("vibe/compiler", "@scope/name")
  assert(Array::length(cands) >= 2)
  assert(Array::get(cands, 0) == ".vibe/store/@scope/name/index.vibei")
  assert(Array::get(cands, 1) == "lib/@scope/name/index.vibei")
}
