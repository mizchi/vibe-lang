//# Functions

let zero_pad_6 = (n: Int) -> String {
  let s = __to_string(n)
  let len = string_length(s)
  if len >= 6 {
    s
  } else {
    let mut out = ""
    let mut i = len
    while i < 6 {
      out = string_concat(out, "0")
      i = i + 1
    }
    string_concat(out, s)
  }
}

let trim_trailing_zeros = (s: String) -> String {
  let mut end = string_length(s)
  while end > 0 && string_char_code_at(s, end - 1) == 48 {
    end = end - 1
  }
  if end <= 0 {
    ""
  } else {
    string_substring(s, 0, end)
  }
}

export let double_to_string_compiler = (d: Double) -> String {
  if d != d {
    "nan"
  } else {
    let neg = d < 0.0
    let abs_d = if neg {
      0.0 - d
    } else {
      d
    }
    let int_part = double_to_int(abs_d)
    let frac = abs_d - int_to_double(int_part)
    let scaled_raw = double_to_int(frac * 1000000.0 + 0.5)
    let int_norm = if eq(scaled_raw, 1000000) {
      int_part + 1
    } else {
      int_part
    }
    let frac_norm = if eq(scaled_raw, 1000000) {
      0
    } else {
      scaled_raw
    }
    let int_s = __to_string(int_norm)
    let frac_s = if eq(frac_norm, 0) {
      ""
    } else {
      trim_trailing_zeros(zero_pad_6(frac_norm))
    }
    let body = if string_length(frac_s) == 0 {
      int_s
    } else {
      string_concat(int_s, string_concat(".", frac_s))
    }
    if neg {
      string_concat("-", body)
    } else {
      body
    }
  }
}
