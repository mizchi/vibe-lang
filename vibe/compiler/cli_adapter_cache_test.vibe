//# Imports

import ./selfhost_cli_adapter_bundle.vibe {
  selfhost_cli_adapter_source_groups,
  selfhost_cli_adapter_sources
}

//# Tests

test "selfhost cli adapter bundle exposes embedded closure" {
  assert(Array::length(selfhost_cli_adapter_sources()) == 23)
}

test "selfhost cli adapter bundle preserves grouped layers" {
  assert(Array::length(selfhost_cli_adapter_source_groups()) == 5)
}
