//# Imports

import ./selfhost_cli_adapter_bundle.vibe {
  selfhost_cli_adapter_merged_source, selfhost_cli_adapter_module_source, selfhost_cli_adapter_source_groups, selfhost_cli_adapter_sources
}

//# Misc

test "selfhost cli adapter bundle exposes embedded closure" {
  assert(Array::length(selfhost_cli_adapter_sources()) > 50)
}

test "selfhost cli adapter bundle preserves grouped layers" {
  // The bundle's group count grows as new selfhost layers (e.g. types,
  // codegen) are added; assert a lower bound rather than an exact match
  // so the test does not break every time a layer is split.
  assert(Array::length(selfhost_cli_adapter_source_groups()) >= 5)
}

test "selfhost cli adapter merged source is embedded" {
  let merged_source = selfhost_cli_adapter_merged_source()
  assert(String::length(merged_source) > 0)
}

test "selfhost cli adapter module source is embedded" {
  let merged_source = selfhost_cli_adapter_merged_source()
  let module_source = selfhost_cli_adapter_module_source()
  assert(String::length(module_source) > 0)
  // The module-only slice is at most as large as the merged bundle.
  // It used to be strictly smaller, but DCE rooted at `cli_main` keeps
  // everything in practice because cli_main transitively references
  // every helper, so we relax to `<=`.
  assert(String::length(module_source) <= String::length(merged_source))
}
