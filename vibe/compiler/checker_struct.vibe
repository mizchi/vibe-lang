//# Imports

import ./ast.vibe {
  TypeExpr
}

import ./types.vibe {
  Type, TypeDef, find_typedef
}

//# Functions

let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    "_placeholder"
  ], 0, 0)
}

let array_has_string: (Array[String], String, Int) -> Bool = (arr, val, i) -> {
  if i >= Array::length(arr) {
    false
  } else if Array::get(arr, i) == val {
    true
  } else {
    array_has_string(arr, val, i + 1)
  }
}

let get_struct_fields: (Array[TypeDef], String) -> Option[Array[(String, Type)]] = (defs, struct_name) -> {
  match find_typedef(defs, struct_name) {
    Some(td) => match td {
      TDStruct(_, fields) => Some(fields),
      TDEnum(_, _) => None,
      TDAlias(_, _) => None
    },
    None => None
  }
}

export let check_struct_arity: (Array[TypeDef], String, Int) -> Bool = (defs, struct_name, num_args) -> {
  match get_struct_fields(defs, struct_name) {
    Some(fields) => eq(Array::length(fields), num_args),
    None => true
  }
}

export let check_record_fields: (Array[TypeDef], String, Array[String]) -> Array[String] = (defs, struct_name, field_names) -> {
  let unknown = empty_strings()
  match get_struct_fields(defs, struct_name) {
    Some(fields) => {
      let def_names = empty_strings()
      let flen = Array::length(fields)
      let mut fi = 0
      while fi < flen {
        let (name, _) = Array::get(fields, fi)
        Array::push(def_names, name)
        fi = fi + 1
      }
      let nlen = Array::length(field_names)
      let mut ni = 0
      while ni < nlen {
        let fn_name = Array::get(field_names, ni)
        if not(array_has_string(def_names, fn_name, 0)) {
          Array::push(unknown, fn_name)
        }
        ni = ni + 1
      }
      unknown
    },
    None => unknown
  }
}

export let lookup_struct_field: (Array[TypeDef], String, String) -> Type = (defs, struct_name, field_name) -> {
  match get_struct_fields(defs, struct_name) {
    Some(fields) => {
      let len = Array::length(fields)
      let mut i = 0
      let mut result = CtUnknown
      while i < len {
        let (name, ty) = Array::get(fields, i)
        if name == field_name {
          result = ty
          i = len
        } else {
          i = i + 1
        }
      }
      result
    },
    None => CtUnknown
  }
}

export let check_missing_fields: (Array[TypeDef], String, Array[String]) -> Array[String] = (defs, struct_name, provided_names) -> {
  let missing = empty_strings()
  match get_struct_fields(defs, struct_name) {
    Some(fields) => {
      let flen = Array::length(fields)
      let mut fi = 0
      while fi < flen {
        let (name, _) = Array::get(fields, fi)
        if not(array_has_string(provided_names, name, 0)) {
          Array::push(missing, name)
        }
        fi = fi + 1
      }
      missing
    },
    None => missing
  }
}

export let check_duplicate_fields: (Array[(String, Type)]) -> Array[String] = (fields) -> {
  let seen = empty_strings()
  let dupes = empty_strings()
  let len = Array::length(fields)
  let mut i = 0
  while i < len {
    let (name, _) = Array::get(fields, i)
    if array_has_string(seen, name, 0) {
      if not(array_has_string(dupes, name, 0)) {
        Array::push(dupes, name)
      }
    } else {
      Array::push(seen, name)
    }
    i = i + 1
  }
  dupes
}
