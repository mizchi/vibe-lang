//# Imports

import ./printer_test_support.vibe {
  roundtrip
}

//# Literal/primitive roundtrip tests

test "roundtrip int" {
  let ok = handle {
    roundtrip("42")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip string" {
  let ok = handle {
    roundtrip("\"hello\"")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip bool" {
  let ok = handle {
    roundtrip("true")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip ident" {
  let ok = handle {
    roundtrip("foo")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip unary" {
  let ok = handle {
    roundtrip("-1")
  } {
    Error(_) => false
  }
  assert(ok)
}
