import ./builtins_extended.vibe {
  lookup_numeric,
  lookup_json,
  lookup_char,
  lookup_threads,
  lookup_string_extra,
  lookup_array_extra,
  lookup_wasm_ops,
  lookup_extended
}

import ./types.vibe {
  Type
}

let is_some = (opt: Option[Type]) -> Bool {
  match opt {
    Some(_) => true,
    None => false
  }
}

let is_none = (opt: Option[Type]) -> Bool {
  match opt {
    Some(_) => false,
    None => true
  }
}

test "lookup_numeric parse_int" {
  assert(is_some(lookup_numeric("parse_int")))
}

test "lookup_numeric int_abs" {
  let result = lookup_numeric("int_abs")
  assert(is_some(result))
}

test "lookup_numeric unknown" {
  assert(is_none(lookup_numeric("unknown")))
}

test "lookup_json to_json" {
  assert(is_some(lookup_json("to_json")))
}

test "lookup_json json_get" {
  assert(is_some(lookup_json("json_get")))
}

test "lookup_json json_keys" {
  assert(is_some(lookup_json("json_keys")))
}

test "lookup_char char_to_int" {
  assert(is_some(lookup_char("char_to_int")))
}

test "lookup_threads threads_spawn" {
  assert(is_some(lookup_threads("threads_spawn")))
}

test "lookup_string_extra string_join" {
  assert(is_some(lookup_string_extra("string_join")))
}

test "lookup_string_extra string_split" {
  assert(is_some(lookup_string_extra("string_split")))
}

test "lookup_array_extra array_truncate" {
  assert(is_some(lookup_array_extra("array_truncate")))
}

test "lookup_wasm_ops i32_eq" {
  assert(is_some(lookup_wasm_ops("i32_eq")))
}

test "lookup_extended parse_int via chain" {
  assert(is_some(lookup_extended("parse_int")))
}

test "lookup_extended json_get via chain" {
  assert(is_some(lookup_extended("json_get")))
}

test "lookup_extended unknown_fn" {
  assert(is_none(lookup_extended("unknown_fn")))
}
