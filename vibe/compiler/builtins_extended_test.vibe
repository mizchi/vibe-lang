//# Imports

import ./builtins_extended.vibe {
  lookup_array_extra, lookup_char, lookup_extended, lookup_json, lookup_numeric, lookup_string_extra, lookup_threads, lookup_wasm_ops
}

import ./types.vibe {
  Type
}

//# Functions

let is_none = (opt: Option[Type]) -> Bool {
  match opt {
    Some(_) => false,
    None => true
  }
}

let is_some = (opt: Option[Type]) -> Bool {
  match opt {
    Some(_) => true,
    None => false
  }
}

//# Misc

test "lookup_numeric Int::parse" {
  assert(is_some(lookup_numeric("Int::parse")))
}

test "lookup_numeric Int::abs" {
  let result = lookup_numeric("Int::abs")
  assert(is_some(result))
}

test "lookup_numeric unknown" {
  assert(is_none(lookup_numeric("unknown")))
}

test "lookup_json Json::stringify" {
  assert(is_some(lookup_json("Json::stringify")))
}

test "lookup_json Json::get" {
  assert(is_some(lookup_json("Json::get")))
}

test "lookup_json Json::keys" {
  assert(is_some(lookup_json("Json::keys")))
}

test "lookup_char Char::to_int" {
  assert(is_some(lookup_char("Char::to_int")))
}

test "lookup_threads Threads::spawn" {
  assert(is_some(lookup_threads("Threads::spawn")))
}

test "lookup_string_extra String::join" {
  assert(is_some(lookup_string_extra("String::join")))
}

test "lookup_string_extra String::split" {
  assert(is_some(lookup_string_extra("String::split")))
}

test "lookup_array_extra Array::truncate" {
  assert(is_some(lookup_array_extra("Array::truncate")))
}

test "lookup_wasm_ops i32_eq" {
  assert(is_some(lookup_wasm_ops("i32_eq")))
}

test "lookup_extended Int::parse via chain" {
  assert(is_some(lookup_extended("Int::parse")))
}

test "lookup_extended Json::get via chain" {
  assert(is_some(lookup_extended("Json::get")))
}

test "lookup_extended unknown_fn" {
  assert(is_none(lookup_extended("unknown_fn")))
}
