//# Imports

import ./ast.vibe {
  Expr
}

import ./checker.vibe {
  check_expr
}

import ./types.vibe {
  Subst, Type, TypeDef, TypeEnv
}

//# Functions

export let no_tp = Array::slice([
  ""
], 0, 0)

export let no_tb = Array::slice([
  ("", no_tp)
], 0, 0)

let empty_defs = () -> Array[TypeDef] {
  Array::slice([
    TDAlias("_dummy", CtUnit)
  ], 0, 0)
}

export let check = (expr: Expr, env: TypeEnv) -> Type {
  let (ty, _, _) = check_expr(expr, env, empty_defs(), SubstEmpty, 0)
  ty
}
