//# Imports

import ./ast.vibe {
  Expr
}

import ./checker.vibe {
  check_expr
}

import ./types.vibe {
  Subst, Type, TypeDef, TypeEnv, subst_apply
}

//# Functions

export let no_tp = Array::slice([
  ""
], 0, 0)

export let no_tb = Array::slice([
  ("", no_tp)
], 0, 0)

let empty_defs: () -> Array[TypeDef] = () -> {
  Array::slice([
    TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
  ], 0, 0)
}

export let check: (Expr, TypeEnv) -> Type with { Error } = (expr, env) -> {
  let errors = Array::slice([
    ""
  ], 0, 0)
  match check_expr(expr, env, empty_defs(), SubstEmpty, 0, errors, Array::slice([(0, CtUnit)], 0, 0)) {
    (ty, s, _) => if Array::length(errors) > 0 {
      throw(Array::get(errors, 0))
    } else {
      subst_apply(s, ty)
    }
    ,
    _ => CtUnknown
  }
}
