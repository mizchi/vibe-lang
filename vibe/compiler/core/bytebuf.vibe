//# Functions

export let bytebuf_new = () -> Array[Int] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

export let bytebuf_push = (buf: Array[Int], byte: Int) -> Unit {
  Array::push(buf, byte)
}

export let bytebuf_length = (buf: Array[Int]) -> Int {
  Array::length(buf)
}

export let bytebuf_to_bytes = (buf: Array[Int]) -> Bytes {
  Bytes::from_array(buf)
}

export let leb128_encode_s32 = (buf: Array[Int], value: Int) -> Unit {
  if value >= 0 && value < 64 {
    Array::push(buf, value)
  } else if value >= -64 && value < 0 {
    Array::push(buf, value & 127)
  } else if value >= 0 && value < 8192 {
    bytebuf_push2(buf, (value & 127) | 128, (value >> 7) & 127)
  } else if value >= -8192 && value < -64 {
    bytebuf_push2(buf, (value & 127) | 128, (value >> 7) & 127)
  } else {
    let mut v = value
    let mut more = true
    while more {
      let byte = v&127
      v = v>>7
      if (v == 0) && ((byte&64) == 0) {
        Array::push(buf, byte)
        more = false
      } else {
        if (v == 0 - 1) && ((byte&64) != 0) {
          Array::push(buf, byte)
          more = false
        } else {
          Array::push(buf, byte|128)
        }
      }
    }
  }
}

export let leb128_encode_s64 = (buf: Array[Int], value: Int) -> Unit {
  leb128_encode_s32(buf, value)
}

export let leb128_encode_u32 = (buf: Array[Int], value: Int) -> Unit {
  if value < 128 {
    Array::push(buf, value)
  } else if value < 16384 {
    bytebuf_push2(buf, (value & 127) | 128, (value >> 7) & 127)
  } else {
    let mut v = value
    let mut more = true
    while more {
      let byte = v&127
      v = (v>>7)&((1<<25) - 1)
      if v == 0 {
        Array::push(buf, byte)
        more = false
      } else {
        Array::push(buf, byte|128)
      }
    }
  }
}

export let bytebuf_push_array = (dst: Array[Int], src: Array[Int]) -> Unit {
  Array::push_all(dst, src)
}

export let bytebuf_push_bytes = (buf: Array[Int], bytes: Bytes) -> Unit {
  let blen = Bytes::length(bytes)
  let mut i = 0
  while i < blen {
    bytebuf_push(buf, bytes[i])
    i = i + 1
  }
}

export let bytebuf_push_section = (out: Array[Int], section_id: Int, content: Array[Int]) -> Unit {
  bytebuf_push(out, section_id)
  leb128_encode_u32(out, bytebuf_length(content))
  bytebuf_push_buf(out, content)
}

export let bytebuf_push_vec_header = (buf: Array[Int], count: Int) -> Unit {
  leb128_encode_u32(buf, count)
}

export let bytebuf_push_buf = (dst: Array[Int], src: Array[Int]) -> Unit {
  Array::push_all(dst, src)
}

export let bytebuf_push2 = (buf: Array[Int], b1: Int, b2: Int) -> Unit {
  bytebuf_push(buf, b1)
  bytebuf_push(buf, b2)
}

export let bytebuf_push3 = (buf: Array[Int], b1: Int, b2: Int, b3: Int) -> Unit {
  bytebuf_push(buf, b1)
  bytebuf_push(buf, b2)
  bytebuf_push(buf, b3)
}

export let bytebuf_push_opcode_u32 = (buf: Array[Int], opcode: Int, value: Int) -> Unit {
  if value < 128 {
    bytebuf_push2(buf, opcode, value)
  } else if value < 16384 {
    bytebuf_push3(buf, opcode, (value & 127) | 128, (value >> 7) & 127)
  } else {
    bytebuf_push(buf, opcode)
    leb128_encode_u32(buf, value)
  }
}

export let bytebuf_push_opcode_s64 = (buf: Array[Int], opcode: Int, value: Int) -> Unit {
  if value >= 0 && value < 64 {
    bytebuf_push2(buf, opcode, value)
  } else if value >= -64 && value < 0 {
    bytebuf_push2(buf, opcode, value & 127)
  } else {
    bytebuf_push(buf, opcode)
    leb128_encode_s32(buf, value)
  }
}

export let bytebuf_push_opcode_u32_u32 = (buf: Array[Int], opcode: Int, a: Int, b: Int) -> Unit {
  if a < 128 && b < 128 {
    bytebuf_push3(buf, opcode, a, b)
  } else {
    bytebuf_push(buf, opcode)
    leb128_encode_u32(buf, a)
    leb128_encode_u32(buf, b)
  }
}

export let bytebuf_push_string = (buf: Array[Int], s: String) -> Unit {
  let slen = String::length(s)
  leb128_encode_u32(buf, slen)
  let mut i = 0
  while i < slen {
    bytebuf_push(buf, String::char_code_at(s, i))
    i = i + 1
  }
}

export let bytebuf_push9 = (buf: Array[Int], b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int, b8: Int, b9: Int) -> Unit {
  bytebuf_push(buf, b1)
  bytebuf_push(buf, b2)
  bytebuf_push(buf, b3)
  bytebuf_push(buf, b4)
  bytebuf_push(buf, b5)
  bytebuf_push(buf, b6)
  bytebuf_push(buf, b7)
  bytebuf_push(buf, b8)
  bytebuf_push(buf, b9)
}
