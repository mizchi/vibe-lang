//# Types

export enum Type {
  CtInt;
  CtDouble;
  CtBool;
  CtString;
  CtChar;
  CtUnit;
  CtTuple(Array[Type]);
  CtArray(Type);
  CtOption(Type);
  CtFn(Array[Type], Type, Bool);
  CtEnum(String);
  CtStruct(String);
  CtBytes;
  CtNamed(String, Array[Type]);
  CtVar(Int);
  CtForAll(Array[Int], Array[(Int, Array[String])], Type);
  CtUnknown
}

export enum TypeDef {
  TDEnum(String, Array[(String, Array[Type])]);
  TDStruct(String, Array[(String, Type)]);
  TDAlias(String, Type)
}

export enum TypeEnv {
  EnvEmpty;
  EnvBind(String, Type, TypeEnv);
  EnvTraitDef(String, Array[String], Bool, TypeEnv);
  EnvTraitImpl(String, Type, TypeEnv);
  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);
  EnvCached(Map[String, Type], TypeEnv)
}

export enum Subst {
  SubstEmpty;
  SubstBind(Int, Type, Subst);
  SubstBound(Int, Array[String], Subst);
  SubstCached(Map[String, Type], Map[String, Array[String]], Subst)
}

//# Functions

export let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {
  EnvBind(name, ty, env)
}

export let fresh_var = (c: Int) -> (Type, Int) {
  (CtVar(c), c + 1)
}

export let rec occurs_in = (id: Int, ty: Type) -> Bool {
  match ty {
    CtVar(vid) => (id == vid),
    CtFn(params, ret, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) {
        if occurs_in(id, Array::get(params, i)) {
          found = true
          i = Array::length(params)
        } else {
          i = i + 1
        }
      }
      found || occurs_in(id, ret)
    },
    CtArray(elem) => occurs_in(id, elem),
    CtOption(elem) => occurs_in(id, elem),
    CtTuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if occurs_in(id, Array::get(elems, i)) {
          found = true
          i = Array::length(elems)
        } else {
          i = i + 1
        }
      }
      found
    },
    CtForAll(_, _, body) => occurs_in(id, body),
    _ => false
  }
}

export let env_lookup = (env: TypeEnv, name: String) -> Option[Type] {
  let mut cur = env
  let mut result : Option[Type] = None
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => { done = true },
      EnvBind(n, ty, rest) => if n == name {
        result = Some(ty)
        done = true
      } else {
        cur = rest
      },
      EnvTraitDef(_, _, _, rest) => { cur = rest },
      EnvTraitImpl(_, _, rest) => { cur = rest },
      EnvTraitImplGen(_, _, _, _, rest) => { cur = rest },
      EnvCached(cache, rest) => if Map::has_key(cache, name) {
        result = Some(Map::get(cache, name))
        done = true
      } else {
        cur = rest
      }
    }
  }
  result
}

export let env_cache = (env: TypeEnv) -> TypeEnv {
  // Collect names and types in parallel arrays (inner→outer order)
  let names = ArrayBuilder::new()
  let types = ArrayBuilder::new()
  let mut cur = env
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => { done = true },
      EnvBind(n, ty, rest) => {
        ArrayBuilder::push(names, n)
        ArrayBuilder::push(types, ty)
        cur = rest
      },
      EnvTraitDef(_, _, _, rest) => { cur = rest },
      EnvTraitImpl(_, _, rest) => { cur = rest },
      EnvTraitImplGen(_, _, _, _, rest) => { cur = rest },
      EnvCached(_, rest) => { cur = rest }
    }
  }
  // Build map from outermost to innermost so inner values overwrite outer
  let na = ArrayBuilder::freeze(names)
  let ta = ArrayBuilder::freeze(types)
  let cache = MapBuilder::new()
  let len = Array::length(na)
  let mut i = len - 1
  while i >= 0 {
    MapBuilder::set(cache, Array::get(na, i), Array::get(ta, i))
    i = i - 1
  }
  EnvCached(MapBuilder::freeze(cache), env)
}

let empty_env_bindings = () -> Array[(String, Type)] {
  Array::slice([
    ("", CtUnknown)
  ], 0, 0)
}

export let env_flat_bindings = (env: TypeEnv) -> Array[(String, Type)] {
  let out = empty_env_bindings()
  let mut cur = env
  let mut done = false
  while (!(done)) {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(name, ty, rest) => {
        Array::push(out, (name, ty))
        cur = rest
      },
      EnvTraitDef(_, _, _, rest) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvCached(_, rest) => {
        cur = rest
      }
    }
  }
  out
}

export let env_lookup_flat = (bindings: Array[(String, Type)], name: String) -> Option[Type] {
  let len = Array::length(bindings)
  let mut i = 0
  let mut result = None
  let mut done = false
  while (!(done)) {
    if i >= len {
      done = true
    } else {
      let (n, ty) = Array::get(bindings, i)
      if n == name {
        result = Some(ty)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

let join_types = (arr: Array[String], sep: String) -> String {
  let len = Array::length(arr)
  let mut i = 0
  let mut acc = ""
  while (!(i >= len)) {
    let s = if i > 0 {
      "\{acc}\{sep}\{Array::get(arr, i)}"
    } else Array::get(arr, i)
    acc = s
    i = i + 1
  }
  acc
}

let empty_type_args = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let string_array_equal = (left: Array[String], right: Array[String]) -> Bool {
  let len = Array::length(left)
  let mut i = 0
  let mut result = true
  let mut done = false
  while (!(done)) {
    if i >= len {
      done = true
    } else if (!(Array::get(left, i) == Array::get(right, i))) {
      result = false
      done = true
    } else {
      i = i + 1
    }
  }
  result
}

export let rec types_equal = (a: Type, b: Type) -> Bool {
  match a {
    CtInt => match b {
      CtInt => true,
      _ => false
    },
    CtDouble => match b {
      CtDouble => true,
      _ => false
    },
    CtBool => match b {
      CtBool => true,
      _ => false
    },
    CtString => match b {
      CtString => true,
      _ => false
    },
    CtChar => match b {
      CtChar => true,
      _ => false
    },
    CtUnit => match b {
      CtUnit => true,
      _ => false
    },
    CtBytes => match b {
      CtBytes => true,
      _ => false
    },
    CtUnknown => match b {
      CtUnknown => true,
      _ => false
    },
    CtVar(aid) => match b {
      CtVar(bid) => (aid == bid),
      _ => false
    },
    CtArray(aelem) => match b {
      CtArray(belem) => types_equal(aelem, belem),
      _ => false
    },
    CtOption(aelem) => match b {
      CtOption(belem) => types_equal(aelem, belem),
      _ => false
    },
    CtEnum(aname) => match b {
      CtEnum(bname) => aname == bname,
      _ => false
    },
    CtStruct(aname) => match b {
      CtStruct(bname) => aname == bname,
      _ => false
    },
    CtNamed(aname, aargs) => match b {
      CtNamed(bname, bargs) =>
      if (!(aname == bname)) {
        false
      } else if (Array::length(aargs) != Array::length(bargs)) {
        false
      } else {
        let tae_len = Array::length(aargs)
        let mut tae_i = 0
        let mut tae_result = true
        let mut tae_done = false
        while (!(tae_done)) {
          if tae_i >= tae_len {
            tae_done = true
          } else if (!(types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)))) {
            tae_result = false
            tae_done = true
          } else {
            tae_i = tae_i + 1
          }
        }
        tae_result
      },
      _ => false
    },
    CtTuple(aelems) => match b {
      CtTuple(belems) =>
      if (Array::length(aelems) != Array::length(belems)) {
        false
      } else {
        let tae_len2 = Array::length(aelems)
        let mut tae_i2 = 0
        let mut tae_result2 = true
        let mut tae_done2 = false
        while (!(tae_done2)) {
          if tae_i2 >= tae_len2 {
            tae_done2 = true
          } else if (!(types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)))) {
            tae_result2 = false
            tae_done2 = true
          } else {
            tae_i2 = tae_i2 + 1
          }
        }
        tae_result2
      },
      _ => false
    },
    CtFn(aparams, aret, ahas_error) => match b {
      CtFn(bparams, bret, bhas_error) =>
      if (Array::length(aparams) != Array::length(bparams)) {
        false
      } else if ahas_error {
        if (!(bhas_error)) {
          false
        } else {
          let tae_len3 = Array::length(aparams)
          let mut tae_i3 = 0
          let mut tae_result3 = true
          let mut tae_done3 = false
          while (!(tae_done3)) {
            if tae_i3 >= tae_len3 {
              tae_done3 = true
            } else if (!(types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)))) {
              tae_result3 = false
              tae_done3 = true
            } else {
              tae_i3 = tae_i3 + 1
            }
          }
          if (!(tae_result3)) {
            false
          } else {
            types_equal(aret, bret)
          }
        }
      } else if bhas_error {
        false
      } else {
        let tae_len4 = Array::length(aparams)
        let mut tae_i4 = 0
        let mut tae_result4 = true
        let mut tae_done4 = false
        while (!(tae_done4)) {
          if tae_i4 >= tae_len4 {
            tae_done4 = true
          } else if (!(types_equal(Array::get(aparams, tae_i4), Array::get(bparams, tae_i4)))) {
            tae_result4 = false
            tae_done4 = true
          } else {
            tae_i4 = tae_i4 + 1
          }
        }
        if (!(tae_result4)) {
          false
        } else {
          types_equal(aret, bret)
        }
      },
      _ => false
    },
    CtForAll(avars, abounds, abody) => match b {
      CtForAll(bvars, bbounds, bbody) => {
        if (Array::length(avars) != Array::length(bvars)) {
          false
        } else if (Array::length(abounds) != Array::length(bbounds)) {
          false
        } else {
          // inline var_list_equal
          let vlen = Array::length(avars)
          let mut vi = 0
          let mut vresult = true
          let mut vdone = false
          while (!(vdone)) {
            if vi >= vlen {
              vdone = true
            } else if (Array::get(avars, vi) != Array::get(bvars, vi)) {
              vresult = false
              vdone = true
            } else {
              vi = vi + 1
            }
          }
          if (!(vresult)) {
            false
          } else {
            // inline forall_bounds_equal
            let fbe_len = Array::length(abounds)
            let mut fbe_i = 0
            let mut fbe_result = true
            let mut fbe_done = false
            while (!(fbe_done)) {
              if fbe_i >= fbe_len {
                fbe_done = true
              } else {
                let (lvar, lbounds) = Array::get(abounds, fbe_i)
                let (rvar, rbounds) = Array::get(bbounds, fbe_i)
                if (lvar != rvar) {
                  fbe_result = false
                  fbe_done = true
                } else if (Array::length(lbounds) != Array::length(rbounds)) {
                  fbe_result = false
                  fbe_done = true
                } else if (!(string_array_equal(lbounds, rbounds))) {
                  fbe_result = false
                  fbe_done = true
                } else {
                  fbe_i = fbe_i + 1
                }
              }
            }
            if (!(fbe_result)) {
              false
            } else {
              types_equal(abody, bbody)
            }
          }
        }
      },
      _ => false
    }
  }
}

export let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {
  let len = Array::length(bindings)
  let mut i = 0
  let mut acc = env
  while (!(i >= len)) {
    let (name, ty) = Array::get(bindings, i)
    acc = EnvBind(name, ty, acc)
    i = i + 1
  }
  acc
}

export let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {
  let len = Array::length(defs)
  let mut i = 0
  let mut result = None
  let mut done = false
  while (!(done)) {
    if i >= len {
      done = true
    } else {
      let d = Array::get(defs, i)
      let dname = match d {
        TDEnum(n, _) => n,
        TDStruct(n, _) => n,
        TDAlias(n, _) => n
      }
      if dname == name {
        result = Some(d)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

let subst_bounds = (s: Subst, id: Int) -> Array[String] {
  let empty = Array::slice([
    ""
  ], 0, 0)
  let mut cur = s
  let mut out = empty
  let mut done = false
  while (!(done)) {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(bid, bounds, rest) => {
        if (bid == id) {
          out = bounds
          done = true
        } else {
          cur = rest
        }
      },
      SubstCached(_, bounds_cache, rest) => {
        let key = __to_string(id)
        if Map::has_key(bounds_cache, key) {
          out = Map::get(bounds_cache, key)
          done = true
        } else {
          cur = rest
        }
      }
    }
  }
  out
}

let rec int_bounds_has_id = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {
  if i >= Array::length(pairs) {
    false
  } else {
    let (pid, _) = Array::get(pairs, i)
    if (pid == id) {
      true
    } else {
      int_bounds_has_id(pairs, id, i + 1)
    }
  }
}

let rec int_bounds_lookup = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {
  if i >= Array::length(pairs) {
    Array::slice([
      ""
    ], 0, 0)
  } else {
    let (pid, bounds) = Array::get(pairs, i)
    if (pid == id) {
      bounds
    } else {
      int_bounds_lookup(pairs, id, i + 1)
    }
  }
}

let collect_subst_bounds_pairs = (s: Subst) -> Array[(Int, Array[String])] {
  let out = Array::slice([
    (0, Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let mut cur = s
  let mut done = false
  while (!(done)) {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(id, bounds, rest) => {
        if (!(int_bounds_has_id(out, id, 0))) {
          Array::push(out, (id, bounds))
        }
        cur = rest
      },
      SubstCached(_, _, rest) => {
        cur = rest
      }
    }
  }
  out
}

let rec int_int_lookup_or = (pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {
  if i >= Array::length(pairs) {
    fallback
  } else {
    let (k, v) = Array::get(pairs, i)
    if (k == key) {
      v
    } else {
      int_int_lookup_or(pairs, key, fallback, i + 1)
    }
  }
}

export let subst_lookup = (s: Subst, id: Int) -> Option[Type] {
  let mut cur = s
  let mut out = None
  let mut done = false
  let key = __to_string(id)
  while (!(done)) {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(i, ty, rest) => {
        if (i == id) {
          out = Some(ty)
          done = true
        } else {
          cur = rest
        }
      },
      SubstBound(_, _, rest) => {
        cur = rest
      },
      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {
        out = Some(Map::get(cache, key))
        done = true
      } else {
        cur = rest
      }
    }
  }
  out
}

let int_array_has = (arr: Array[Int], v: Int) -> Bool {
  let slen = Array::length(arr)
  let mut si = 0
  let mut sfound = false
  let mut sdone = false
  while (!(sdone)) {
    if si >= slen {
      sdone = true
    } else if (Array::get(arr, si) == v) {
      sfound = true
      sdone = true
    } else {
      si = si + 1
    }
  }
  sfound
}

export let rec subst_apply = (s: Subst, ty: Type) -> Type {
  match ty {
    // Fast path: concrete types have no type variables
    CtInt => ty,
    CtBool => ty,
    CtString => ty,
    CtUnit => ty,
    CtDouble => ty,
    CtChar => ty,
    CtBytes => ty,
    CtUnknown => ty,
    CtVar(_) => {
      let mut cur = ty
      let mut out = ty
      let mut done = false
      let mut seen = Array::slice([
        0
      ], 0, 0)
      while (!(done)) {
        match cur {
          CtVar(vid) => if int_array_has(seen, vid) {
            out = cur
            done = true
          } else {
            Array::push(seen, vid)
            match subst_lookup(s, vid) {
              Some(next) => {
                cur = next
                out = next
              },
              None => {
                out = cur
                done = true
              }
            }
          }
          ,
          _ => {
            out = subst_apply(s, cur)
            done = true
          }
        }
      }
      out
    },
    CtFn(params, ret, he) => {
      let rp = for p in params {
        subst_apply(s, p)
      }
      CtFn(rp, subst_apply(s, ret), he)
    },
    CtArray(elem) => CtArray(subst_apply(s, elem)),
    CtOption(elem) => CtOption(subst_apply(s, elem)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_apply(s, e)
    }),
    CtForAll(_, _, _) => ty,
    _ => ty
  }
}

export let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {
  let ta = subst_apply(s, a)
  let tb = subst_apply(s, b)
  if types_equal(ta, tb) {
    Some(s)
  }
  else match ta {
    CtVar(id) => if occurs_in(id, tb) {
      None
    } else Some(SubstBind(id, tb, s)),
    _ => match tb {
      CtVar(id) => if occurs_in(id, ta) {
        None
      } else Some(SubstBind(id, ta, s)),
      _ => match ta {
        CtUnknown => Some(s),
        _ => match tb {
          CtUnknown => Some(s),
          _ => match ta {
            CtForAll(_, _, body_a) => match tb {
              CtForAll(_, _, body_b) => unify(body_a, body_b, s),
              _ => unify(body_a, tb, s)
            },
            _ => match tb {
              CtForAll(_, _, body_b) => unify(ta, body_b, s),
              _ => match ta {
                CtArray(ea) => match tb {
                  CtArray(eb) => unify(ea, eb, s),
                  _ => None
                },
                CtOption(ea) => match tb {
                  CtOption(eb) => unify(ea, eb, s),
                  _ => None
                },
                CtFn(pa, ra, _) => match tb {
                  CtFn(pb, rb, _) => if (Array::length(pa) != Array::length(pb)) {
                    None
                  }
                  else {
                    let ul_len = Array::length(pa)
                    let mut ul_i = 0
                    let mut ul_acc = s
                    let mut ul_result = Some(s)
                    let mut ul_done = false
                    while (!(ul_done)) {
                      if ul_i >= ul_len {
                        ul_result = Some(ul_acc)
                        ul_done = true
                      } else {
                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {
                          Some(s2) => {
                            ul_acc = s2
                            ul_i = ul_i + 1
                          },
                          None => {
                            ul_result = None
                            ul_done = true
                          }
                        }
                      }
                    }
                    match ul_result {
                      Some(s2) => unify(ra, rb, s2),
                      None => None
                    }
                  }
                  ,
                  _ => None
                },
                CtTuple(ea) => match tb {
                  CtTuple(eb) => if (Array::length(ea) != Array::length(eb)) {
                    None
                  }
                  else {
                    let ul_len2 = Array::length(ea)
                    let mut ul_i2 = 0
                    let mut ul_acc2 = s
                    let mut ul_result2 = Some(s)
                    let mut ul_done2 = false
                    while (!(ul_done2)) {
                      if ul_i2 >= ul_len2 {
                        ul_result2 = Some(ul_acc2)
                        ul_done2 = true
                      } else {
                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {
                          Some(s2) => {
                            ul_acc2 = s2
                            ul_i2 = ul_i2 + 1
                          },
                          None => {
                            ul_result2 = None
                            ul_done2 = true
                          }
                        }
                      }
                    }
                    ul_result2
                  }
                  ,
                  _ => None
                },
                CtEnum(a_name) => match tb {
                  CtEnum(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  _ => None
                },
                CtStruct(a_name) => match tb {
                  CtStruct(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  _ => None
                },
                CtNamed(a_name, a_args) => match tb {
                  CtNamed(b_name, b_args) => if (!(a_name == b_name)) {
                    None
                  }
                  else if (Array::length(a_args) != Array::length(b_args)) {
                    None
                  }
                  else {
                    let ul_len3 = Array::length(a_args)
                    let mut ul_i3 = 0
                    let mut ul_acc3 = s
                    let mut ul_result3 = Some(s)
                    let mut ul_done3 = false
                    while (!(ul_done3)) {
                      if ul_i3 >= ul_len3 {
                        ul_result3 = Some(ul_acc3)
                        ul_done3 = true
                      } else {
                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {
                          Some(s2) => {
                            ul_acc3 = s2
                            ul_i3 = ul_i3 + 1
                          },
                          None => {
                            ul_result3 = None
                            ul_done3 = true
                          }
                        }
                      }
                    }
                    ul_result3
                  }
                  ,
                  _ => None
                },
                _ => None
              }
            }
          }
        }
      }
    }
  }
}

export let rec trait_supers = (env: TypeEnv, name: String) -> Array[String] {
  let empty = Array::slice([
    ""
  ], 0, 0)
  match env {
    EnvEmpty => empty,
    EnvBind(_, _, rest) => trait_supers(rest, name),
    EnvTraitDef(tname, supers, _, rest) => if tname == name {
      supers
    } else trait_supers(rest, name),
    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),
    EnvCached(_, rest) => trait_supers(rest, name)
  }
}

let rec array_has_int = (arr: Array[Int], val: Int, i: Int) -> Bool {
  if i >= Array::length(arr) {
    false
  }
  else if (Array::get(arr, i) == val) {
    true
  }
  else array_has_int(arr, val, i + 1)
}

let rec collect_tvars_walk = (t: Type, out: Array[Int]) -> Int {
  match t {
    CtVar(id) => {
      if (!(array_has_int(out, id, 0))) {
        Array::push(out, id)
      }
      0
    },
    CtFn(params, ret, _) => {
      for p in params {
        let _ = collect_tvars_walk(p, out)
      }
      collect_tvars_walk(ret, out)
    },
    CtArray(elem) => collect_tvars_walk(elem, out),
    CtOption(elem) => collect_tvars_walk(elem, out),
    CtTuple(elems) => {
      for e in elems {
        let _ = collect_tvars_walk(e, out)
      }
      0
    },
    CtForAll(_, _, body) => collect_tvars_walk(body, out),
    _ => 0
  }
}

export let collect_tvars = (ty: Type) -> Array[Int] {
  let out = Array::slice([
    0
  ], 0, 0)
  let _ = collect_tvars_walk(ty, out)
  out
}

export let generalize = (s: Subst, ty: Type) -> Type {
  let resolved = subst_apply(s, ty)
  let tvars = collect_tvars(resolved)
  if (Array::length(tvars) == 0) {
    resolved
  }
  else {
    let bounds_pairs = collect_subst_bounds_pairs(s)
    let var_bounds = Array::slice([
      (0, Array::slice([
        ""
      ], 0, 0))
    ], 0, 0)
    for vid in tvars {
      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)
      if (Array::length(bounds) != 0) {
        Array::push(var_bounds, (vid, bounds))
      }
    }
    CtForAll(tvars, var_bounds, resolved)
  }
}

export let rec trait_defined = (env: TypeEnv, name: String) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => trait_defined(rest, name),
    EnvTraitDef(tname, _, _, rest) => if tname == name {
      true
    } else trait_defined(rest, name),
    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),
    EnvCached(_, rest) => trait_defined(rest, name)
  }
}

export let rec type_to_string = (ty: Type) -> String {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "()",
    CtBytes => "Bytes",
    CtVar(id) => "?t\{id}",
    CtForAll(vars, _, body) => {
      let vlen = Array::length(vars)
      let mut vi = 0
      let mut vacc = ""
      while (!(vi >= vlen)) {
        let v = "?t\{Array::get(vars, vi)}"
        let next = if vi > 0 {
          "\{vacc} \{v}"
        } else v
        vacc = next
        vi = vi + 1
      }
      "forall \{vacc}. \{type_to_string(body)}"
    },
    CtUnknown => "?",
    CtArray(elem) => "Array[\{type_to_string(elem)}]",
    CtOption(elem) => "Option[\{type_to_string(elem)}]",
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, args) => if (Array::length(args) == 0) {
      name
    } else {
      let parts = for arg in args {
        type_to_string(arg)
      }
      "\{name}[\{join_types(parts, ", ")}]"
    }
    ,
    CtTuple(elems) => {
      let parts = for e in elems {
        type_to_string(e)
      }
      "(\{join_types(parts, ", ")})"
    },
    CtFn(params, ret, has_error) => {
      let parts = for p in params {
        type_to_string(p)
      }
      let base = "(\{join_types(parts, ", ")}) -> \{type_to_string(ret)}"
      if has_error {
        "\{base} with {Error}"
      } else base
    }
  }
}

export let resolve_builtin = (name: String) -> Option[Type] {
  if name == "Int" || name == "i32" {
    Some(CtInt)
  }
  else if name == "Double" || name == "f64" {
    Some(CtDouble)
  }
  else if name == "Bool" {
    Some(CtBool)
  }
  else if name == "String" {
    Some(CtString)
  }
  else if name == "Char" {
    Some(CtChar)
  }
  else if name == "Unit" {
    Some(CtUnit)
  }
  else if name == "Bytes" {
    Some(CtBytes)
  }
  else if name == "i64"
    || name == "u8"
    || name == "u16"
    || name == "u32"
    || name == "u64"
    || name == "i16"
    || name == "v128" {
    Some(CtNamed(name, empty_type_args()))
  }
  else None
}

export let subst_add_bound = (s: Subst, id: Int, bounds: Array[String]) -> Subst {
  SubstBound(id, bounds, s)
}

let empty_var_bounds = () -> Array[(Int, Array[String])] {
  Array::slice([
    (0, Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
}

export let instantiate = (ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {
  match ty {
    CtForAll(bound_vars, var_bounds, body) => {
      let blen = Array::length(bound_vars)
      let id_map = Array::slice([
        (0, 0)
      ], 0, 0)
      let mut bi = 0
      let mut bacc = SubstEmpty
      let mut bnc = c
      while (!(bi >= blen)) {
        let old_id = Array::get(bound_vars, bi)
        Array::push(id_map, (old_id, bnc))
        bacc = SubstBind(old_id, CtVar(bnc), bacc)
        bnc = bnc + 1
        bi = bi + 1
      }
      let inst_s = bacc
      let id_map2 = id_map
      let c1 = bnc
      // Remap var_bounds: old_id -> new_id
      let new_bounds = Array::slice([
        (0, Array::slice([
          ""
        ], 0, 0))
      ], 0, 0)
      for var_bound in var_bounds {
        let (old_id, bounds) = var_bound
        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)
        Array::push(new_bounds, (new_id, bounds))
      };
      (subst_apply(inst_s, body), c1, new_bounds)
    },
    _ => (ty, c, empty_var_bounds())
  }
}

export let types_compatible = (expected: Type, actual: Type) -> Bool {
  match expected {
    CtUnknown => true,
    _ => match actual {
      CtUnknown => true,
      _ => types_equal(expected, actual)
    }
  }
}

export let rec impls_overlap_for = (env: TypeEnv, trait_name: String, new_target: Type) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvTraitImpl(tname, target, rest) => if tname == trait_name {
      if types_equal(target, new_target) {
        true
      }
      else impls_overlap_for(rest, trait_name, new_target)
    } else impls_overlap_for(rest, trait_name, new_target)
    ,
    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvCached(_, rest) => impls_overlap_for(rest, trait_name, new_target)
  }
}

export let rec trait_is_subtrait = (env: TypeEnv, sub: String, super_name: String) -> Bool {
  // DFS: sub's supers include super_name, or any of sub's supers is a subtrait of super_name
  if sub == super_name {
    true
  }
  else {
    let supers = trait_supers(env, sub)
    let slen = Array::length(supers)
    let mut si = 0
    let mut sresult = false
    let mut sdone = false
    while (!(sdone)) {
      if si >= slen {
        sdone = true
      } else {
        let s = Array::get(supers, si)
        if s == super_name {
          sresult = true
          sdone = true
        } else if trait_is_subtrait(env, s, super_name) {
          sresult = true
          sdone = true
        } else {
          si = si + 1
        }
      }
    }
    sresult
  }
}

let rec type_implements_check_super = (e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {
  match e2 {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),
    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),
    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {
      if trait_is_subtrait(full_env, tname, trait_name) {
        true
      }
      else type_implements_check_super(rest, full_env, trait_name, resolved)
    } else type_implements_check_super(rest, full_env, trait_name, resolved)
    ,
    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),
    EnvCached(_, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)
  }
}

let rec type_implements_check_env = (e: TypeEnv, trait_name: String, resolved: Type) -> Bool {
  match e {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),
    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),
    EnvTraitImpl(tname, target, rest) => if tname == trait_name {
      if types_equal(target, resolved) {
        true
      }
      else type_implements_check_env(rest, trait_name, resolved)
    } else type_implements_check_env(rest, trait_name, resolved)
    ,
    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),
    EnvCached(_, rest) => type_implements_check_env(rest, trait_name, resolved)
  }
}

export let rec type_implements_trait = (env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {
  let resolved = subst_apply(s, ty)
  if type_implements_check_env(env, trait_name, resolved) {
    true
  }
  else {
    // Check supertrait: if trait_name has subtrait impls
    let supers = trait_supers(env, trait_name)
    let slen = Array::length(supers)
    if (slen == 0) {
      false
    }
    else {
      // Type implements trait_name if it implements all supers? No — reversed:
      // If T implements sub-trait B where B: A, then T also implements A
      // So check all traits that the type implements and see if any is a subtrait of trait_name
      type_implements_check_super(env, env, trait_name, resolved)
    }
  }
}
