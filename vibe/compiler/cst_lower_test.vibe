  let node = CNode(NForInExpr, [
    CToken(TFor),
    CToken(TIdent("x")),
    CToken(TIn),
    CNode(NIdentExpr, [
      CToken(TIdent("xs"))
    ]),
    CNode(NIntExpr, [
      CToken(TInt(0))
    ])
  ])
  match lower_expr(node) {
    EForIn(name, _, _) => assert(name == "x"),
