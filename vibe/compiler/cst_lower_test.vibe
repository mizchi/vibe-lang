      CToken(TInt(1))
    ])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "-"),
    _ => assert(false)
  }
}

test "lower EUnaryOp not" {
  let node = CNode(NUnaryOpExpr, [
    CToken(TNot),
    CNode(NBoolExpr, [
      CToken(TIdent("true"))
    ])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "!"),
    _ => assert(false)
  }
}

test "lower ECall" {
  let node = CNode(NCallExpr, [
    CNode(NIdentExpr, [
      CToken(TIdent("f"))
    ]),
    CToken(TLParen),
    CNode(NIntExpr, [
      CToken(TInt(1))
    ]),
    CToken(TRParen)
  ])
  match lower_expr(node) {
    ECall(callee, args) => {
      match callee {
        EIdent(n) => assert(n == "f"),
        _ => assert(false)
      }
      assert(Array::length(args) == 1)
    },
    _ => assert(false)
  }
}

test "lower EDot" {
  let node = CNode(NDotExpr, [
    CNode(NIdentExpr, [
      CToken(TIdent("obj"))
    ]),
    CToken(TDot),
    CToken(TIdent("field"))
  ])
  match lower_expr(node) {
    EDot(_, name) => assert(name == "field"),
    _ => assert(false)
  }
}

test "lower EMatch" {
  let node = CNode(NMatchExpr, [
    CToken(TMatch),
    CNode(NIdentExpr, [
      CToken(TIdent("x"))
    ]),
    CToken(TLBrace),
    CNode(NMatchArm, [
      CNode(NIntPat, [
        CToken(TInt(1))
      ]),
      CToken(TArrow),
      CNode(NStringExpr, [
        CToken(TString("one"))
      ])
    ]),
    CToken(TComma),
    CNode(NMatchArm, [
      CNode(NWildPat, [
        CToken(TIdent("_"))
      ]),
      CToken(TArrow),
      CNode(NStringExpr, [
        CToken(TString("other"))
      ])
    ]),
    CToken(TRBrace)
  ])
  match lower_expr(node) {
    EMatch(_, arms) => assert(Array::length(arms) == 2),
    _ => assert(false)
  }
}

test "lower EWhile" {
  let node = CNode(NWhileExpr, [
