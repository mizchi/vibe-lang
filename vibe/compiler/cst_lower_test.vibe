test "lower SLet" {
  let node = CNode(NLetStmt, [
    CToken(TLet),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [
      CToken(TInt(42))
    ])
  ])
  match lower_stmt(node) {
    SLet(exported, is_rec, name, _, _) => {
      assert(exported == false)
      assert(is_rec == false)
      assert(name == "x")
    },
    _ => assert(false)
  }
}

test "lower SLet exported rec" {
  let node = CNode(NLetStmt, [
    CToken(TExport),
    CToken(TLet),
    CToken(TRec),
    CToken(TIdent("f")),
    CToken(TEq),
    CNode(NIdentExpr, [
      CToken(TIdent("f"))
    ])
  ])
  match lower_stmt(node) {
    SLet(exported, is_rec, name, _, _) => {
      assert(exported == true)
      assert(is_rec == true)
      assert(name == "f")
    },
    _ => assert(false)
  }
}

test "lower SLetMut" {
  let node = CNode(NLetMutStmt, [
    CToken(TLet),
