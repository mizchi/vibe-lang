  match lower_expr(node) {
    ERecord(fields) => assert(Array::length(fields) == 1)
    ,
    _ => assert(false)
  }
}

test "lower EIf" {
  let node = CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [
      CToken(TIdent("true"))
    ]),
    CNode(NIntExpr, [
      CToken(TInt(1))
    ]),
    CToken(TElse),
    CNode(NIntExpr, [
      CToken(TInt(2))
    ])
  ])
  match lower_expr(node) {
    EIf(_, _, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EIf no else" {
  let node = CNode(NIfExpr, [
    CToken(TIf),
