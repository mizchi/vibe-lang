//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./cst.vibe {
  CstChild, NodeKind, cst_child_nodes, cst_children, cst_filter, cst_find, cst_find_token, cst_kind, cst_tokens, node_kind_eq, node_kind_tag
}

import ./lower.vibe {
  lower_expr, lower_pat, lower_source_file, lower_stmt, lower_type
}

import ./token.vibe {
  Token
}

//# Misc

test "node_kind_tag returns distinct values" {
  assert(node_kind_tag(NSourceFile) == 0)
  assert(node_kind_tag(NLetStmt) == 1)
  assert(node_kind_tag(NIntExpr) == 20)
  assert(node_kind_tag(NError) == 99)
}

test "node_kind_eq same" {
  assert(node_kind_eq(NIntExpr, NIntExpr))
  assert(node_kind_eq(NError, NError))
}

test "node_kind_eq different" {
  assert(node_kind_eq(NIntExpr, NStringExpr) == false)
}

test "cst_kind CNode" {
  let n = CNode(NIntExpr, [
    CToken(TInt(42))
  ])
  assert(node_kind_eq(cst_kind(n), NIntExpr))
}

test "cst_kind CToken returns NError" {
  assert(node_kind_eq(cst_kind(CToken(TInt(1))), NError))
}

test "cst_kind CError returns NError" {
  assert(node_kind_eq(cst_kind(CError("oops")), NError))
}

test "cst_children CNode" {
  let kids = [
    CToken(TInt(1)),
    CToken(TInt(2))
  ]
  let n = CNode(NTupleExpr, kids)
  assert(Array::length(cst_children(n)) == 2)
}

test "cst_children CToken returns empty" {
  assert(Array::length(cst_children(CToken(TInt(1)))) == 0)
}

test "cst_find finds matching kind" {
  let children = [
    CToken(TLet),
    CNode(NIntExpr, [
      CToken(TInt(42))
    ]),
    CNode(NStringExpr, [
      CToken(TString("hi"))
    ])
  ]
  match cst_find(children, NIntExpr, 0) {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "cst_find returns None for missing kind" {
  let children = [
    CToken(TLet),
    CNode(NIntExpr, [
      CToken(TInt(1))
    ])
  ]
  match cst_find(children, NStringExpr, 0) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "cst_find_token returns first token" {
  let children = [
    CNode(NIntExpr, [
      CToken(TInt(0))
    ]),
    CToken(TLet),
    CToken(TInt(1))
  ]
  match cst_find_token(children, 0) {
    Some(TLet) => assert(true),
    _ => assert(false)
  }
}

test "cst_filter collects matching nodes" {
  let children = [
    CNode(NIntExpr, [
      CToken(TInt(1))
    ]),
    CToken(TComma),
    CNode(NIntExpr, [
      CToken(TInt(2))
    ]),
    CNode(NStringExpr, [
      CToken(TString("x"))
    ])
  ]
  let ints = cst_filter(children, NIntExpr)
  assert(Array::length(ints) == 2)
}

test "cst_child_nodes skips tokens" {
  let children = [
    CToken(TLParen),
    CNode(NIntExpr, [
      CToken(TInt(1))
    ]),
    CToken(TComma),
    CNode(NIntExpr, [
      CToken(TInt(2))
    ]),
    CToken(TRParen)
  ]
  let nodes = cst_child_nodes(children)
  assert(Array::length(nodes) == 2)
}

test "cst_tokens skips nodes" {
  let children = [
    CToken(TLParen),
    CNode(NIntExpr, [
      CToken(TInt(1))
    ]),
    CToken(TRParen)
  ]
  let toks = cst_tokens(children)
  assert(Array::length(toks) == 2)
}

test "lower PWild" {
  let node = CNode(NWildPat, [
    CToken(TIdent("_"))
  ])
  match lower_pat(node) {
    PWild => assert(true),
    _ => assert(false)
  }
}

test "lower PBind" {
  let node = CNode(NBindPat, [
    CToken(TIdent("x"))
  ])
  match lower_pat(node) {
    PBind(name) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower PInt" {
  let node = CNode(NIntPat, [
    CToken(TInt(42))
  ])
  match lower_pat(node) {
    PInt(n) => assert(n == 42),
    _ => assert(false)
  }
}

test "lower PString" {
  let node = CNode(NStringPat, [
    CToken(TString("hello"))
  ])
  match lower_pat(node) {
    PString(s) => assert(s == "hello"),
    _ => assert(false)
  }
}

test "lower PBool true" {
  let node = CNode(NBoolPat, [
    CToken(TIdent("true"))
  ])
  match lower_pat(node) {
    PBool(b) => assert(b == true),
    _ => assert(false)
  }
}

test "lower PBool false" {
  let node = CNode(NBoolPat, [
    CToken(TIdent("false"))
  ])
  match lower_pat(node) {
    PBool(b) => assert(b == false),
    _ => assert(false)
  }
}

test "lower PTuple" {
  let node = CNode(NTuplePat, [
    CToken(TLParen),
    CNode(NBindPat, [
      CToken(TIdent("a"))
    ]),
    CToken(TComma),
    CNode(NBindPat, [
      CToken(TIdent("b"))
    ]),
    CToken(TRParen)
  ])
  match lower_pat(node) {
    PTuple(pats) => assert(Array::length(pats) == 2),
    _ => assert(false)
  }
}

test "lower PCtor no args" {
  let node = CNode(NCtorPat, [
    CToken(TIdent("None"))
  ])
  match lower_pat(node) {
    PCtor(name, args) => {
      assert(name == "None")
      assert(Array::length(args) == 0)
    },
    _ => assert(false)
  }
}

test "lower PCtor with args" {
  let node = CNode(NCtorPat, [
    CToken(TIdent("Some")),
    CToken(TLParen),
    CNode(NBindPat, [
      CToken(TIdent("x"))
    ]),
    CToken(TRParen)
  ])
  match lower_pat(node) {
    PCtor(name, args) => {
      assert(name == "Some")
      assert(Array::length(args) == 1)
    },
    _ => assert(false)
  }
}

test "lower POr" {
  let node = CNode(NOrPat, [
    CNode(NIntPat, [
      CToken(TInt(1))
    ]),
    CToken(TBitOr),
    CNode(NIntPat, [
      CToken(TInt(2))
    ])
  ])
  match lower_pat(node) {
    POr(_, _) => assert(true),
    _ => assert(false)
  }
}

test "lower TyName" {
  let node = CNode(NNameType, [
    CToken(TIdent("Int"))
  ])
  match lower_type(node) {
    TyName(name) => assert(name == "Int"),
    _ => assert(false)
  }
}

test "lower TyUnit" {
  let node = CNode(NUnitType, [
    CToken(TLParen),
    CToken(TRParen)
  ])
  match lower_type(node) {
    TyUnit => assert(true),
    _ => assert(false)
  }
}

test "lower TyTuple" {
  let node = CNode(NTupleType, [
    CToken(TLParen),
    CNode(NNameType, [
      CToken(TIdent("Int"))
    ]),
    CToken(TComma),
    CNode(NNameType, [
      CToken(TIdent("String"))
    ]),
    CToken(TRParen)
  ])
  match lower_type(node) {
    TyTuple(elems) => assert(Array::length(elems) == 2),
    _ => assert(false)
  }
}

test "lower TyFn" {
  let node = CNode(NFnType, [
    CToken(TLParen),
    CNode(NNameType, [
      CToken(TIdent("Int"))
    ]),
    CToken(TRParen),
    CToken(TThinArrow),
    CNode(NNameType, [
      CToken(TIdent("String"))
    ])
  ])
  match lower_type(node) {
    TyFn(params, ret) => {
      assert(Array::length(params) == 1)
      match ret {
        TyName(n) => assert(n == "String"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

