}

test "lower SEnum" {
  let node = CNode(NEnumStmt, [
    CToken(TExport),
    CToken(TEnum),
    CToken(TIdent("Color")),
    CToken(TLBrace),
    CNode(NEnumVariant, [
      CToken(TIdent("Red"))
    ]),
    CToken(TSemicolon),
    CNode(NEnumVariant, [
      CToken(TIdent("Blue"))
    ]),
    CToken(TRBrace)
  ])
  match lower_stmt(node) {
    SEnum(exported, name, variants) => {
      assert(exported == true)
      assert(name == "Color")
      assert(Array::length(variants) == 2)
    },
    _ => assert(false)
  }
}

test "lower SStruct" {
  let node = CNode(NStructStmt, [
    CToken(TStruct),
    CToken(TIdent("Point")),
    CToken(TLBrace),
    CNode(NStructField, [
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NNameType, [
        CToken(TIdent("Int"))
      ])
    ]),
    CToken(TSemicolon),
    CNode(NStructField, [
      CToken(TIdent("y")),
      CToken(TColon),
      CNode(NNameType, [
        CToken(TIdent("Int"))
      ])
    ]),
    CToken(TRBrace)
  ])
  match lower_stmt(node) {
    SStruct(exported, name, fields) => {
      assert(exported == false)
      assert(name == "Point")
      assert(Array::length(fields) == 2)
    },
    _ => assert(false)
  }
}

