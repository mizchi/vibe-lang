//# Imports

import ./checker_error.vibe {
  CheckError, add_error, format_errors, new_errors
}

//# Functions

let string_eq_chars = (left: String, right: String) -> Bool {
  let len = String::length(left)
  if len != String::length(right) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while ok && i < len {
      ok = String::char_code_at(left, i) == String::char_code_at(right, i)
      i = i + 1
    }
    ok
  }
}

let format_errors_order_ok = () -> Bool {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("alpha"))
  add_error(errors, CETypeMismatch("Bool", "Int"))
  add_error(errors, CEDuplicateDecl("gamma"))
  let msg = format_errors(errors)
  string_eq_chars(msg, "unbound variable: alpha\ntype mismatch: expected Bool, got Int\nduplicate declaration: gamma")
}

let format_errors_multiple_ok = () -> Bool {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("x"))
  add_error(errors, CENotCallable("42"))
  add_error(errors, CEDuplicateDecl("foo"))
  let msg = format_errors(errors)
  string_eq_chars(msg, "unbound variable: x\nnot callable: 42\nduplicate declaration: foo")
}

let format_errors_all_types_ok = () -> Bool {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("v"))
  add_error(errors, CETypeMismatch("A", "B"))
  add_error(errors, CEArityMismatch("h", 3, 1))
  add_error(errors, CENotCallable("lit"))
  add_error(errors, CEUnknownField("T", "f"))
  add_error(errors, CEUnknownCtor("C"))
  add_error(errors, CEDuplicateDecl("d"))
  let msg = format_errors(errors)
  string_eq_chars(msg, "unbound variable: v\ntype mismatch: expected A, got B\narity mismatch: h expects 3 args, got 1\nnot callable: lit\nunknown field f on T\nunknown constructor: C\nduplicate declaration: d")
}

//# Misc

test "format_errors multiple joined with newlines" {
  assert(format_errors_multiple_ok())
}

test "format_errors preserves order" {
  assert(format_errors_order_ok())
}

test "format_errors with all error types" {
  assert(format_errors_all_types_ok())
}
