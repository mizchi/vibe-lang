//# Imports

import ./compiler.vibe {
  compile_source, compile_with_modules
}

import ./module_loader.vibe {
  collect_merged_stmts
}

import ./selfhost_sources_bundle.vibe {
  selfhost_sources
}

import ./codegen.vibe {
  compile_wasi_module
}

import ./ast.vibe {
  Stmt
}

//# Tests

test "S5: single-file compile via selfhost" {
  let bytes = compile_source("let add = (a: Int, b: Int) -> Int { a + b }")
  assert(Bytes::length(bytes) > 0)
}

test "S5: selfhost_sources bundle loads" {
  let sources = selfhost_sources()
  assert(Array::length(sources) == 29)
}

test "S5: collect_merged_stmts from bundle" {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  assert(Array::length(merged) > 100)
}

test "S5: compile merged stmts to WASM" {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  let bytes = compile_wasi_module(merged, "run")
  // WASM magic number check
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)  // 'a'
  assert(Bytes::get(bytes, 2) == 115) // 's'
  assert(Bytes::get(bytes, 3) == 109) // 'm'
  assert(Bytes::length(bytes) > 1000)
}

test "S5: check WASM output size (~385KB)" {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  let bytes = compile_wasi_module(merged, "run")
  let len = Bytes::length(bytes)
  // Selfhost compiler compiles to ~385KB WASM
  assert(len > 300000)
  assert(len < 500000)
}

test "S5: compile with selfbuild_entry entry" {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  let bytes = compile_wasi_module(merged, "selfbuild_entry")
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
  assert(Bytes::length(bytes) > 300000)
}

test "S5: write stage2.wasm via selfbuild" {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  let bytes = compile_wasi_module(merged, "selfbuild_entry")
  Fs::write_bytes("_build/bench/selfhost_wasi_selfbuild/index_stage2.wasm", bytes)
  assert(Bytes::length(bytes) > 300000)
}

test "S5: deterministic output (two compiles match)" {
  let sources = selfhost_sources()
  let merged1 = collect_merged_stmts(sources)
  let bytes1 = compile_wasi_module(merged1, "run")
  let merged2 = collect_merged_stmts(sources)
  let bytes2 = compile_wasi_module(merged2, "run")
  assert(Bytes::length(bytes1) == Bytes::length(bytes2))
  // Compare first 100 bytes for determinism
  let mut i = 0
  while i < 100 {
    assert(Bytes::get(bytes1, i) == Bytes::get(bytes2, i))
    i = i + 1
  }
}
