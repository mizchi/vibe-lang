import ./coverage_selfhost_suite_lib.vibe {
  CoverageCaseInput,
  build_suite_report_from_json_texts,
  build_summary_text,
  evaluate_kpi,
  parse_line_list,
  suite_report_json
}

import ../shell/index.vibe {
  cat, env_or, join_str, print, println, trim, write_file
}

let parse_rate_env = (name : String) -> Option[Double] with { Env, Error } {
  let raw = trim(env_or(name, ""))
  if string_length(raw) == 0 {
    None
  } else {
    let value = handle {
      parse_double(raw)
    } {
      Error(_) =>
        throw(
          string_concat(
            string_concat("invalid value for ", name),
            string_concat(": ", raw)
          )
        )
    }
    if value < 0.0 || value > 100.0 {
      throw(
        string_concat(
          string_concat("invalid value for ", name),
          string_concat(": ", raw)
        )
      )
    } else Some(value)
  }
}

let load_inputs = (report_paths : Array[String]) -> Array[CoverageCaseInput] with { Fs } {
  let b = array_builder()
  let mut i = 0
  while i < array_length(report_paths) {
    let report_path = array_get(report_paths, i)
    array_builder_push(b, CoverageCaseInput::{
      report_path: report_path,
      report_json: cat(report_path)
    })
    i = i + 1
  }
  array_builder_freeze(b)
}

let run = () -> Unit with { Env, Fs, Stdout, Error } {
  let list_path = trim(env_or("VIBE_SELFHOST_SUITE_REPORT_LIST", ""))
  if string_length(list_path) == 0 {
    throw("missing VIBE_SELFHOST_SUITE_REPORT_LIST")
  }
  let report_json_path = trim(env_or("VIBE_SELFHOST_SUITE_REPORT_JSON", ""))
  let summary_path = trim(env_or("VIBE_SELFHOST_SUITE_SUMMARY", ""))
  let report_paths = parse_line_list(cat(list_path))
  if array_length(report_paths) == 0 {
    throw(string_concat("no report paths in list: ", list_path))
  }

  let min_point_rate = parse_rate_env("VIBE_SELFHOST_SUITE_MIN_POINT_RATE")
  let min_line_rate = parse_rate_env("VIBE_SELFHOST_SUITE_MIN_LINE_RATE")
  let min_branch_rate = parse_rate_env("VIBE_SELFHOST_SUITE_MIN_BRANCH_RATE")

  let report = build_suite_report_from_json_texts(load_inputs(report_paths))
  let kpi = evaluate_kpi(report, min_point_rate, min_line_rate, min_branch_rate)
  let summary = build_summary_text(report, kpi)

  if string_length(report_json_path) > 0 {
    write_file(
      report_json_path,
      string_concat(suite_report_json(report, kpi), "\n")
    )
  }
  if string_length(summary_path) > 0 {
    write_file(summary_path, summary)
  }
  print(summary)

  if not(kpi.ok) {
    throw(
      string_concat(
        "coverage KPI failed: ",
        join_str(kpi.failures, "; ")
      )
    )
  }
}

test "coverage selfhost suite run" {
  handle {
    run()
  } {
    Error(msg) => {
      throw(string_concat("[coverage_selfhost_suite] ", msg))
    }
  }
}
