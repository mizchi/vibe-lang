//# Imports

import ./coverage_selfhost_suite_lib.vibe {
  CoverageCaseInput, build_suite_report_from_json_texts, build_summary_text, evaluate_kpi, parse_line_list, suite_report_json
}

//# Functions

export let parse_line_list_export = parse_line_list

//# Misc

test "coverage selfhost suite run" {
  let list_env = Env::get("VIBE_SELFHOST_SUITE_REPORT_LIST")
  let list_path = String::trim(if String::length(list_env) == 0 { "" } else { list_env })
  if String::length(list_path) == 0 {
    assert(false)
  }
  let rjp_env = Env::get("VIBE_SELFHOST_SUITE_REPORT_JSON")
  let report_json_path = String::trim(if String::length(rjp_env) == 0 { "" } else { rjp_env })
  let sp_env = Env::get("VIBE_SELFHOST_SUITE_SUMMARY")
  let summary_path = String::trim(if String::length(sp_env) == 0 { "" } else { sp_env })
  let report_paths = parse_line_list(Fs::read_file(list_path))
  if Array::length(report_paths) == 0 {
    assert(false)
  }
  let min_point_rate = Double::parse(String::trim(Env::get("VIBE_SELFHOST_SUITE_MIN_POINT_RATE")))
  let min_line_rate = Double::parse(String::trim(Env::get("VIBE_SELFHOST_SUITE_MIN_LINE_RATE")))
  let min_branch_rate = Double::parse(String::trim(Env::get("VIBE_SELFHOST_SUITE_MIN_BRANCH_RATE")))
  let b = ArrayBuilder::new()
  let mut idx = 0
  while idx < Array::length(report_paths) {
    let report_path = Array::get(report_paths, idx)
    ArrayBuilder::push(b, CoverageCaseInput::{
      report_path: report_path, report_json: Fs::read_file(report_path)
    })
    idx = idx + 1
  }
  let inputs = ArrayBuilder::freeze(b)
  let report = build_suite_report_from_json_texts(inputs)
  let kpi = evaluate_kpi(report, min_point_rate, min_line_rate, min_branch_rate)
  let summary = build_summary_text(report, kpi)
  if String::length(report_json_path) > 0 {
    // suite_report_json uses stringify() which creates O(n) intermediate strings via
    // String::concat chains. In the bump-allocator runtime, these are never freed,
    // causing heap exhaustion for reports with many coverage points.
    // TODO: implement streaming JSON write via WASI output-stream (ADR-0035 P0)
    Fs::write_file(report_json_path, "{}\n")
  }
  if String::length(summary_path) > 0 {
    Fs::write_file(summary_path, summary)
  }
  Fs::write_file("/tmp/vibe_coverage_summary.txt", summary)
  assert(kpi.ok)
}
