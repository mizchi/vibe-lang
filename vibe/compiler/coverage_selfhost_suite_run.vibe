//# Imports

// Use Fs:: and Env:: builtins directly for compiled backend compatibility
// (perform-based shell wrappers are not supported in compiled test backend)

import ./coverage_selfhost_suite_lib.vibe {
  CoverageCaseInput, build_suite_report_from_json_texts, build_summary_text, evaluate_kpi, parse_line_list, suite_report_json
}

//# Functions

let env_or_default = (name: String, fallback: String) -> String {
  match Env::get(name) {
    "" => fallback,
    v => v
  }
}

let join_failures = (arr: Array[String], sep: String) -> String {
  let mut result = ""
  let mut i = 0
  while i < Array::length(arr) {
    if i > 0 { result = String::concat(result, sep) }
    result = String::concat(result, Array::get(arr, i))
    i = i + 1
  }
  result
}

let load_inputs = (report_paths: Array[String]) -> Array[CoverageCaseInput] {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(report_paths) {
    let report_path = Array::get(report_paths, i)
    ArrayBuilder::push(b, CoverageCaseInput::{
      report_path: report_path, report_json: Fs::read_file(report_path)
    })
    i = i + 1
  }
  ArrayBuilder::freeze(b)
}

let parse_rate_env = (name: String) -> Option[Double] with { Error } {
  let raw = String::trim(env_or_default(name, ""))
  if String::length(raw) == 0 {
    None
  } else {
    let value = match Double::parse(raw) {
      Some(v) => v,
      None =>
      throw(String::concat(String::concat("invalid value for ", name), String::concat(": ", raw)))
    }
    if value < 0.0 || value > 100.0 {
      throw(String::concat(String::concat("invalid value for ", name), String::concat(": ", raw)))
    } else Some(value)
  }
}

let run = () -> Unit with { Error } {
  let list_path = String::trim(env_or_default("VIBE_SELFHOST_SUITE_REPORT_LIST", ""))
  if String::length(list_path) == 0 {
    throw("missing VIBE_SELFHOST_SUITE_REPORT_LIST")
  }
  let report_json_path = String::trim(env_or_default("VIBE_SELFHOST_SUITE_REPORT_JSON", ""))
  let summary_path = String::trim(env_or_default("VIBE_SELFHOST_SUITE_SUMMARY", ""))
  let report_paths = parse_line_list(Fs::read_file(list_path))
  if Array::length(report_paths) == 0 {
    throw(String::concat("no report paths in list: ", list_path))
  }
  let min_point_rate = parse_rate_env("VIBE_SELFHOST_SUITE_MIN_POINT_RATE")
  let min_line_rate = parse_rate_env("VIBE_SELFHOST_SUITE_MIN_LINE_RATE")
  let min_branch_rate = parse_rate_env("VIBE_SELFHOST_SUITE_MIN_BRANCH_RATE")
  let report = build_suite_report_from_json_texts(load_inputs(report_paths))
  let kpi = evaluate_kpi(report, min_point_rate, min_line_rate, min_branch_rate)
  let summary = build_summary_text(report, kpi)
  if String::length(report_json_path) > 0 {
    Fs::write_file(report_json_path, String::concat(suite_report_json(report, kpi), "\n"))
  }
  if String::length(summary_path) > 0 {
    Fs::write_file(summary_path, summary)
  }
  // Print summary to a temp file (stdout not available in compiled backend)
  Fs::write_file("/tmp/vibe_coverage_summary.txt", summary)
  if not(kpi.ok) {
    throw(String::concat("coverage KPI failed: ", join_failures(kpi.failures, "; ")))
  }
}

//# Misc

test "coverage selfhost suite run" {
  handle {
    run()
  } {
    Error(msg) => throw(String::concat("[coverage_selfhost_suite] ", msg))
  }
}
