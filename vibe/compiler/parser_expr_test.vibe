//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse int" {
  let result = handle {
    parse_print("42")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "42")
}

test "parse string" {
  let result = handle {
    parse_print("\"hello\"")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "\"hello\"")
}

test "parse bool true" {
  let result = handle {
    parse_print("true")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "true")
}

test "parse bool false" {
  let result = handle {
    parse_print("false")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "false")
}

test "parse ident" {
  let result = handle {
    parse_print("foo")
  } with Error {
    Throw(e) => String::concat("ERROR: ", e)
  }
  assert(result == "foo")
}
