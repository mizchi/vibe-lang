//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse int" {
  let result = handle {
    parse_print("42")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "42"))
}

test "parse string" {
  let result = handle {
    parse_print("\"hello\"")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "\"hello\""))
}

test "parse bool true" {
  let result = handle {
    parse_print("true")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "true"))
}

test "parse bool false" {
  let result = handle {
    parse_print("false")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "false"))
}

test "parse ident" {
  let result = handle {
    parse_print("foo")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "foo"))
}

test "parse call" {
  let result = handle {
    parse_print("f(1, 2)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "f(1, 2)"))
}

test "parse call no args" {
  let result = handle {
    parse_print("f()")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "f()"))
}

test "parse dot" {
  let result = handle {
    parse_print("a.b.c")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "a.b.c"))
}

test "parse namespace call" {
  let result = handle {
    parse_print("String::length(s)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "String::length(s)"))
}
