export let selfbuild_probe_deep_if = () -> Int with { Error } {
  let c = 40
  let result = if c == 43 {
    1
  }
  else if c == 45 {
    2
  }
  else if c == 42 {
    3
  }
  else if c == 47 {
    4
  }
  else if c == 37 {
    5
  }
  else if c == 61 {
    6
  }
  else if c == 33 {
    7
  }
  else if c == 60 {
    8
  }
  else if c == 62 {
    9
  }
  else if c == 38 {
    10
  }
  else if c == 124 {
    11
  }
  else if c == 94 {
    12
  }
  else if c == 40 {
    13
  }
  else if c == 41 {
    14
  }
  else if c == 123 {
    15
  }
  else 0
  result
}

let probe_compile_source_len = (source: String, entry_name: String) -> Int with { Error } {
