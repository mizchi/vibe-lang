//# Functions

let string_to_bytes = (s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

let probe_lex_source = (source: String) -> Int with { Error } {
  Array::length(lex(source))
}

let probe_check_source = (source: String) -> Int with { Error } {
  let stmts = parse_program(lex(source))
  let _ = check_program(stmts)
  1
}

let probe_parse_source = (source: String) -> Int with { Error } {
