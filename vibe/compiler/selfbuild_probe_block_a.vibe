let find_unexpected_control_char = (source: String) -> Int {
  let len = String::length(source)
  let mut i = 0
  let mut result = -1
  while i < len && result < 0 {
    let c = String::char_code_at(source, i)
    let allowed = c == 9 || c == 10 || c == 13 || c >= 32
    if !allowed {
      result = i * 1000 + c
    }
    i = i + 1
  }
  result
}

let probe_selfhost_source_control = (path: String) -> Int with { Error } {
  let sources = selfhost_sources()
  if Array::length(sources) == 0 {
    throw("selfhost_sources is empty (stub)")
  }
  let source = lookup_selfhost_source(sources, path)
  find_unexpected_control_char(source)
}

let selfbuild_probe_compile_first = (n: Int) -> Int with { Error } {
  let sources = selfhost_sources()
  let first = Array::slice(sources, 0, n)
  let merged = collect_merged_stmts(first)
  let entry_tokens = lex("export let __probe_entry = () -> Int { 0 }")
  let entry_stmts = parse_program(entry_tokens)
  let mut j = 0
  while j < Array::length(entry_stmts) {
    Array::push(merged, Array::get(entry_stmts, j))
    j = j + 1
  }
  let bytes = compile_wasi_module(merged, "__probe_entry")
  Bytes::length(bytes)
}

let load_cli_adapter_merged_source = () -> String with { Error } {
