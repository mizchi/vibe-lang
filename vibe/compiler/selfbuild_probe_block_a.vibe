export let selfbuild_probe_library_compile = () -> Int with { Error } {
  let source = String::concat("export let add = (a: Int, b: Int) -> Int { a + b }\n", "export let mul = (a: Int, b: Int) -> Int { a * b }")
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  let no_srcs = Array::slice([
    ("", "")
  ], 0, 0)
  let no_linked = Array::slice([
    ("", "", 0, 0)
  ], 0, 0)
  let bytes = compile_wasi_module_linked_impl(stmts, "_start", no_srcs, no_linked, true)
  Bytes::length(bytes)
}

let probe_parse_stmt_progress_source = (source: String) -> Int with { Error } {
  let tokens = lex(source)
  let mut pos = 0
  let mut stmt_index = 0
  let mut result = -1
  let mut done = false
  while !done {
    if pos >= Array::length(tokens) {
      result = stmt_index * 100000 + pos
      done = true
    } else {
      match Array::get(tokens, pos) {
        TEof => {
          result = stmt_index * 100000 + pos
          done = true
        },
        _ => handle {
          let (_, next) = parse_stmt(tokens, pos)
          pos = next
          stmt_index = stmt_index + 1
        } {
          Error(_) => {
            result = stmt_index * 100000 + pos
            done = true
          }
        }
      }
    }
  }
  result
}

