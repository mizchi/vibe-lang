let probe_prepare_source = (main_source: String, main_path: String) -> Int with { Error } {
  let sources = selfhost_sources()
  if Array::length(sources) == 0 {
    throw("selfhost_sources is empty (stub)")
  }
  let prepared = prepare_modules_cached(db_new(), main_path, main_source, sources)
  db_typecheck_count(prepared)
}

let remove_file_if_exists = (path: String) -> Unit {
  if perform Fs::Exists(path) {
    perform Fs::Remove(path)
  } else {
    ()
  }
}

export let selfbuild_probe_check = () -> Int with { Error } {
  let tokens = lex("let add = (a: Int, b: Int) -> Int { a + b }")
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  1
}

let lookup_selfhost_source = (sources: Array[(String, String)], path: String) -> String with { Error } {
  let mut i = 0
  let mut found = false
  let mut result = ""
  while i < Array::length(sources) && !found {
    let (candidate_path, source) = Array::get(sources, i)
    if candidate_path == path {
      result = source
      found = true
    }
    i = i + 1
  }
  if found {
    result
  } else {
    throw(String::concat("selfhost source not found: ", path))
  }
}

let probe_parse_import_stmt = (source: String) -> Int with { Error } {
  let tokens = lex(source)
  let (_, next) = parse_stmt(tokens, 0)
  next
}

