//# Imports

import ../../core/index.vibe {
  Expr, Pat, Stmt, TypeExpr,
  bytebuf_push, leb128_encode_u32
}

import ../wasm_emit/index.vibe {
  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_xor, emit_if_void, emit_local_get, emit_local_set
}

//# Types

// Function registry: groups parallel arrays for function metadata
export struct FuncTable {
  names: Array[String];
  indices: Array[Int];
  params: Array[Int];
  returns: Array[Int]
}

// String table: groups string data with their WASM data segment offsets/lengths
export struct StrTable {
  strs: Array[String];
  offsets: Array[Int];
  lengths: Array[Int]
}

// Lambda accumulator: collects compiled lambda bodies and metadata
export struct LambdaTable {
  bodies: Array[Array[Int]];
  param_counts: Array[Int];
  captures: Array[Array[String]];
  meta_i32: Array[Int];
  meta_i64: Array[Int]
}

// Constructor/struct registry: enum variant + struct constructors
export struct CtorTable {
  names: Array[String];
  tags: Array[Int];
  field_counts: Array[Int];
  type_names: Array[String];
  struct_names: Array[String];
  struct_field_names: Array[Array[String]]
}

// Compilation context: all shared state for compile_expr
export struct CompileCtx {
  func_table: FuncTable;
  func_name_map: Map[String, Int];
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ctor_table: CtorTable;
  thunk_names: Array[String]
}

// GC backend compilation context (extends CompileCtx with GC-specific fields)
export struct CompileCtxGc {
  func_table: FuncTable;
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ref_local_indices: Array[Int];
  refcell_type_idx: Int;
  closure_type_base: Int;
  ctor_table: CtorTable
}

//# Functions

export let is_efn = (expr: Expr) -> Bool {
  match expr {
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}

export let is_pint = (p: Pat) -> Bool {
  match p {
    PInt(_) => true,
    _ => false
  }
}

// === Stmt extractors ===
export let is_slet = (stmt: Stmt) -> Bool {
  match stmt {
    SLet(_, _, _, _, _) => true,
    _ => false
  }
}

// Expr tag: returns a numeric tag for dispatch without match in let rec
// 0=EInt, 1=EBool, 2=EFloat, 3=EString, 4=EIdent, 5=EBinOp, 6=EUnaryOp,
// 7=EIf, 8=ECall, 9=ELet, 10=ELetRec, 11=ELetMut, 12=EAssign, 13=EAssignOp,
// 14=ESeq, 15=ETuple, 16=EMatch, 17=EArray, 18=EForIn, 19=EWhile,
// 20=EBreak, 21=EContinue, 22=EUnit, 23=EThrow, 24=EFn, -1=unknown
export let expr_tag = (expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EBool(_) => 1,
    EFloat(_) => 2,
    EString(_) => 3,
    EIdent(_) => 4,
    EBinOp(_, _, _) => 5,
    EUnaryOp(_, _) => 6,
    EIf(_, _, _) => 7,
    ECall(_, _) => 8,
    ELet(_, _, _) => 9,
    ELetRec(_, _, _) => 10,
    ELetMut(_, _, _) => 11,
    EAssign(_, _, _) => 12,
    EAssignOp(_, _, _, _) => 13,
    ESeq(_, _) => 14,
    ETuple(_) => 15,
    EMatch(_, _) => 16,
    EArray(_) => 17,
    EForIn(_, _, _, _) => 18,
    EWhile(_, _) => 19,
    EBreak(_) => 20,
    EContinue(_) => 21,
    EUnit => 22,
    EThrow(_) => 23,
    EFn(_, _, _, _, _, _) => 24,
    _ => -1
  }
}

export let is_pbind = (p: Pat) -> Bool {
  match p {
    PBind(_) => true,
    _ => false
  }
}

export let is_pbool = (p: Pat) -> Bool {
  match p {
    PBool(_) => true,
    _ => false
  }
}

export let is_pctor = (p: Pat) -> Bool {
  match p {
    PCtor(_, _) => true,
    _ => false
  }
}

export let is_pwild = (p: Pat) -> Bool {
  match p {
    PWild => true,
    _ => false
  }
}

// Expr type checks (only those needed inside match arms)
export let is_eident = (expr: Expr) -> Bool {
  match expr {
    EIdent(_) => true,
    _ => false
  }
}

// Check if expr is an ETuple
export let is_etuple = (expr: Expr) -> Bool {
  match expr {
    ETuple(_) => true,
    _ => false
  }
}

// Check pattern type
export let is_ptuple = (p: Pat) -> Bool {
  match p {
    PTuple(_) => true,
    _ => false
  }
}

export let is_pstring = (p: Pat) -> Bool {
  match p {
    PString(_) => true,
    _ => false
  }
}

export let emit_i32_eq = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 70)
  // 0x46
}

export let emit_i32_ne = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 71)
  // 0x47
}

// Extract pattern from match arm pair
export let get_arm_pat = (arm: (Pat, Expr)) -> Pat {
  let (p, _) = arm
  p
}

// Returns index into ctor_names array, or -1 if not found
export let rec lookup_ctor = (ctor_names: Array[String], name: String, i: Int) -> Int {
  if i >= Array::length(ctor_names) {
    -1
  }
  else if Array::get(ctor_names, i) == name {
    i
  }
  else lookup_ctor(ctor_names, name, i + 1)
}

export let emit_i32_eqz = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 69)
  // 0x45
}

export let emit_i32_mul = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 108)
  // 0x6C
}

export let emit_i32_sub = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 107)
  // 0x6B
}

export let emit_str_ref = (buf: Array[Int], offset: Int, length: Int) -> Unit {
  emit_i64_const(buf, offset)
  emit_i64_const(buf, 32)
  emit_i64_shl(buf)
  emit_i64_const(buf, length)
  emit_i64_or(buf)
}

// Extract body from match arm pair
export let get_arm_body = (arm: (Pat, Expr)) -> Expr {
  let (_, b) = arm
  b
}

export let get_efn_body = (expr: Expr) -> Expr with { Error } {
  match expr {
    EFn(_, _, _, _, _, body) => body,
    _ => throw("not EFn")
  }
}

export let get_eif_cond = (expr: Expr) -> Expr with { Error } {
  match expr {
    EIf(c, _, _) => c,
    _ => throw("not EIf")
  }
}

export let get_eif_else = (expr: Expr) -> Expr with { Error } {
  match expr {
    EIf(_, _, e) => e,
    _ => throw("not EIf")
  }
}

export let get_eif_then = (expr: Expr) -> Expr with { Error } {
  match expr {
    EIf(_, t, _) => t,
    _ => throw("not EIf")
  }
}

export let get_elet_val = (expr: Expr) -> Expr with { Error } {
  match expr {
    ELet(_, val, _) => val,
    _ => throw("not ELet")
  }
}

// Resolve function: returns (func_index, param_count, has_return)
export let build_func_name_map = (ft: FuncTable) -> Map[String, Int] {
  let b = MapBuilder::new()
  let len = Array::length(ft.names)
  let mut i = 0
  while i < len {
    MapBuilder::set(b, Array::get(ft.names, i), i)
    i = i + 1
  }
  MapBuilder::freeze(b)
}

export let resolve_func = (ft: FuncTable, name: String) -> (Int, Int, Int) with { Error } {
  let len = Array::length(ft.names)
  let mut i = 0
  let mut found = -1
  while i < len {
    if Array::get(ft.names, i) == name {
      found = i
      i = len
    } else {
      i = i + 1
    }
  }
  if found < 0 {
    throw("undefined function: \{name}")
  };
  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))
}

export let resolve_func_fast = (ft: FuncTable, name_map: Map[String, Int], name: String) -> (Int, Int, Int) with { Error } {
  if map_has(name_map, name) {
    let found = Map::get(name_map, name)
    (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))
  } else {
    throw("undefined function: \{name}")
  }
}

// Emit WASM instruction for a binary operator
export let emit_binop_op = (buf: Array[Int], op: String) -> Unit with { Error } {
  if op == "+" {
    emit_i64_add(buf)
  }
  else if op == "-" {
    emit_i64_sub(buf)
  }
  else if op == "*" {
    emit_i64_mul(buf)
  }
  else if op == "/" {
    emit_i64_div_s(buf)
  }
  else if op == "%" {
    emit_i64_rem_s(buf)
  }
  else if op == "&" {
    emit_i64_and(buf)
  }
  else if op == "|" {
    emit_i64_or(buf)
  }
  else if op == "^" {
    emit_i64_xor(buf)
  }
  else if op == "<<" {
    emit_i64_shl(buf)
  }
  else if op == ">>" {
    emit_i64_shr_s(buf)
  }
  else if op == "==" {
    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "!=" {
    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "<" {
    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == ">" {
    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "<=" {
    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == ">=" {
    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "&&" {
    emit_i64_and(buf)
  }
  else if op == "||" {
    emit_i64_or(buf)
  }
  else {
    throw("unsupported binop: \{op}")
  }
}

export let emit_i32_ge_u = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 79)
  // 0x4F
}

export let emit_i32_gt_u = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 75)
  // 0x4B
}

export let emit_i64_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 41)
  // 0x29
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let get_ebinop_op = (expr: Expr) -> String with { Error } {
  match expr {
    EBinOp(op, _, _) => op,
    _ => throw("not EBinOp")
  }
}

export let get_elet_body = (expr: Expr) -> Expr with { Error } {
  match expr {
    ELet(_, _, body) => body,
    _ => throw("not ELet")
  }
}

export let get_elet_name = (expr: Expr) -> String with { Error } {
  match expr {
    ELet(name, _, _) => name,
    _ => throw("not ELet")
  }
}

// Extract function body from SLet(_, _, _, _, EFn(_, _, _, _, _, body))
export let get_func_body = (stmt: Stmt) -> Expr with { Error } {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, _, _, _, body) => body,
      _ => throw("get_func_body: not a function")
    },
    _ => throw("get_func_body: not a let statement")
  }
}

export let get_slet_expr = (stmt: Stmt) -> Expr with { Error } {
  match stmt {
    SLet(_, _, _, _, expr) => expr,
    _ => throw("not SLet")
  }
}

export let get_slet_name = (stmt: Stmt) -> String with { Error } {
  match stmt {
    SLet(_, _, name, _, _) => name,
    _ => throw("not SLet")
  }
}

export let resolve_local = (names: Array[String], name: String, tag: String) -> Int with { Error } {
  let mut i = Array::length(names) - 1
  let mut result = -1
  while i >= 0 {
    if Array::get(names, i) == name {
      result = i
      i = -1
    } else {
      i = i - 1
    }
  }
  if result < 0 {
    let mut dbg = "undefined variable (local): \{name}"
    dbg = "\{dbg} [locals: "
    let mut di = 0
    let dlen = Array::length(names)
    while di < dlen {
      if di > 0 {
        dbg = "\{dbg}, "
      }
      dbg = "\{dbg}\{Array::get(names, di)}"
      di = di + 1
    }
    dbg = "\{dbg}]"
    dbg = "\{dbg} @"
    dbg = "\{dbg}\{tag}"
    throw(dbg)
  }
  result
}

export let emit_i64_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 55)
  // 0x37
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

// Find the SLet statement for a given function name
export let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {
  let len = Array::length(stmts)
  let mut i = 0
  let mut found = -1
  while i < len {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, sname, _, _) => if sname == name {
        found = i
        i = len
      }
      ,
      _ => ()
    }
    if found < 0 {
      i = i + 1
    }
  }
  if found < 0 {
    throw("function not found: \{name}")
  }
  Array::get(stmts, found)
}
