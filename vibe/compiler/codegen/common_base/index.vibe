//# Imports

import ../../core/index.vibe {
  Expr, Pat, Stmt, TypeExpr,
  bytebuf_push, leb128_encode_u32
}

import ../wasm_emit/index.vibe {
  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_xor, emit_if_void, emit_local_get, emit_local_set
}

// WASM opcodes (local constants for readability)
let op_i32_eq = 70
let op_i32_ne = 71
let op_i32_eqz = 69
let op_i32_mul = 108
let op_i32_sub = 107
let op_i32_ge_u = 79
let op_i32_gt_u = 75
let op_i64_load = 41
let op_i64_store = 55

//# Types

// Function registry: groups parallel arrays for function metadata
export struct FuncTable {
  names: Array[String];
  indices: Array[Int];
  params: Array[Int];
  returns: Array[Int];
  needs_env: Array[Bool]
}

// String table: groups string data with their WASM data segment offsets/lengths
export struct StrTable {
  strs: Array[String];
  offsets: Array[Int];
  lengths: Array[Int]
}

// Lambda accumulator: collects compiled lambda bodies and metadata
export struct LambdaTable {
  bodies: Array[Bytes];
  param_counts: Array[Int];
  captures: Array[Array[String]];
  meta_i32: Array[Int];
  meta_i64: Array[Int]
}

// Constructor/struct registry: enum variant + struct constructors
export struct CtorTable {
  names: Array[String];
  tags: Array[Int];
  field_counts: Array[Int];
  type_names: Array[String];
  struct_names: Array[String];
  struct_field_names: Array[Array[String]]
}

// Compilation context: all shared state for compile_expr
export struct CompileCtx {
  func_table: FuncTable;
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ctor_table: CtorTable;
  thunk_names: Array[String];
  const_int_names: Array[String];
  const_int_values: Array[Int];
  // Perceus RC mode (docs/spec/selfhost-rc-port.md). When true, heap objects
  // carry a uniform `[type_id@0][length@4][payload@8...]` header so the (future)
  // RC drop helper can dispatch and recurse. Default false: layout unchanged.
  // Threaded as a parameter on the WASI compile path (a module-level flag is
  // not usable: a getter capturing it is `missing closure env` in the native
  // CLI codegen, and a cross-module `let` reference is `unknown name`).
  enable_rc: Bool;
  // RC: names of `let` bindings whose value the Perceus analysis says to drop
  // at scope end (computed per function from build_perceus_plan). compile_expr
  // emits an rc_drop for a tuple binding whose name appears here.
  rc_drop_names: Array[String];
  // RC: alias bindings (`let a = t`) whose source `t` is multiply-used, so the
  // alias takes a duplicated reference — compile_expr emits an rc_dup of the
  // source at the alias `let`. (PaAliasDup from the Perceus plan.)
  rc_alias_dup_names: Array[String];
  // RC: bindings known at codegen time to hold a heap object (bound to a
  // tuple/record/enum literal, or an alias of such). Built as `let`s compile.
  // Gates rc_dup / rc_drop so we never touch a non-heap (e.g. Int-returning
  // call) binding the static Perceus `scalar` flag over-approximates as heap.
  heap_binding_names: Array[String];
  // RC: wasm function index of the generic recursive `__rc_drop` helper
  // (ADR-0055 Stage 3), or -1 when unavailable (non-RC, or the legacy inline
  // drop). When >= 0, scope-end drops emit a `call` to it so nested heap is
  // reclaimed to arbitrary depth.
  rc_drop_func_idx: Int;
  // RC: wasm function index of the free-list search allocator `__rc_alloc`
  // (ADR-0055 Stage 4), or -1 when unavailable (non-RC). When >= 0, heap-object
  // construction calls it with the block size so an exact-fit free block is found
  // anywhere in the free-list (not just the head), eliminating the size-ordering
  // fragmentation a head-only check leaves when interleaved sizes are freed.
  rc_alloc_func_idx: Int;
  // RC: names of `let` bindings the Perceus plan marks with a non-alias `PaDup`
  // (a heap value used in more than one *owning* position, e.g. `let u = (t, t)`
  // dups `t`). One entry per dup (so a name's multiplicity = its dup budget).
  // compile_expr emits that many guarded rc_dups at the binding site, giving the
  // block the extra references its container/owning uses consume — without this
  // the recursive drop visits the shared child more times than it has refs.
  // (ADR-0055 Stage 4.)
  rc_dup_names: Array[String];
  // Blocker-3 (ADR-0055): append-only log of `slot*2 + flag` entries (flag 1 =
  // a `let`/`let mut` binding whose value is statically floatish; flag 0 = a
  // non-float rebind overriding a previously-float slot). The MOST RECENT entry
  // for a local slot wins, so `expr_is_floatish` can recognise a *variable*
  // holding a float (`let x = 1.5; x + y` takes the f64 path) while a shadowing
  // rebind of another type — nested block or if/match branch reusing the slot —
  // is classified by its own binding. Append-only (not truncated) because the
  // wasm-gc backend cannot truncate a struct-field array; the log only grows for
  // float-related bindings, which are rare. Still a syntactic over-
  // approximation (the AST is untyped): float function params / lambda-captured
  // floats are not tracked.
  float_local_slots: Array[Int]
}

// GC backend compilation context (extends CompileCtx with GC-specific fields)
export struct CompileCtxGc {
  func_table: FuncTable;
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ref_local_indices: Array[Int];
  refcell_type_idx: Int;
  closure_type_base: Int;
  ctor_table: CtorTable
}

//# Functions

export let is_efn: (Expr) -> Bool = (expr) -> {
  match expr {
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}

export let is_pint: (Pat) -> Bool = (p) -> {
  match p {
    PInt(_) => true,
    _ => false
  }
}

// === Stmt extractors ===
export let is_slet: (Stmt) -> Bool = (stmt) -> {
  match stmt {
    SLet(_, _, _, _, _) => true,
    _ => false
  }
}

// Expr tag: returns a numeric tag for dispatch without match in let rec
// 0=EInt, 1=EBool, 2=EFloat, 3=EString, 4=EIdent, 5=EBinOp, 6=EUnaryOp,
// 7=EIf, 8=ECall, 9=ELet, 10=ELetRec, 11=ELetMut, 12=EAssign, 13=EAssignOp,
// 14=ESeq, 15=ETuple, 16=EMatch, 17=EArray, 18=EForIn, 19=EWhile,
// 20=EBreak, 21=EContinue, 22=EUnit, 23=EThrow, 24=EFn, 25=ELoop, 26=EReturn, -1=unknown
export let expr_tag: (Expr) -> Int = (expr) -> {
  match expr {
    EInt(_) => 0,
    EBool(_) => 1,
    EFloat(_) => 2,
    EString(_) => 3,
    EIdent(_) => 4,
    EBinOp(_, _, _) => 5,
    EUnaryOp(_, _) => 6,
    EIf(_, _, _) => 7,
    ECall(_, _) => 8,
    ELet(_, _, _) => 9,
    ELetRec(_, _, _) => 10,
    ELetMut(_, _, _) => 11,
    EAssign(_, _, _) => 12,
    EAssignOp(_, _, _, _) => 13,
    ESeq(_, _) => 14,
    ETuple(_) => 15,
    EMatch(_, _) => 16,
    EArray(_) => 17,
    EForIn(_, _, _, _) => 18,
    EWhile(_, _) => 19,
    EBreak(_) => 20,
    EContinue(_) => 21,
    EUnit => 22,
    EThrow(_) => 23,
    EFn(_, _, _, _, _, _) => 24,
    ELoop(_, _) => 25,
    EReturn(_) => 26,
    _ => -1
  }
}

export let is_pbind: (Pat) -> Bool = (p) -> {
  match p {
    PBind(_) => true,
    _ => false
  }
}

export let is_pbool: (Pat) -> Bool = (p) -> {
  match p {
    PBool(_) => true,
    _ => false
  }
}

export let is_pctor: (Pat) -> Bool = (p) -> {
  match p {
    PCtor(_, _) => true,
    _ => false
  }
}

export let is_pwild: (Pat) -> Bool = (p) -> {
  match p {
    PWild => true,
    _ => false
  }
}

// Expr type checks (only those needed inside match arms)
export let is_eident: (Expr) -> Bool = (expr) -> {
  match expr {
    EIdent(_) => true,
    _ => false
  }
}

// Check if expr is an ETuple
export let is_etuple: (Expr) -> Bool = (expr) -> {
  match expr {
    ETuple(_) => true,
    _ => false
  }
}

// Check if expr is an ERecord (struct/record literal). Records are tagged
// (`ptr | 1`), unlike tuples, so RC drop must untag before touching the header.
export let is_erecord: (Expr) -> Bool = (expr) -> {
  match expr {
    ERecord(_) => true,
    _ => false
  }
}

// Check if expr is an EArray (array literal). Under RC the array object is
// inline-allocated with the same layout as a tuple (untagged raw pointer,
// value = block+8), so it drops like a tuple (tagged=false).
export let is_earray: (Expr) -> Bool = (expr) -> {
  match expr {
    EArray(_) => true,
    _ => false
  }
}

// Check pattern type
export let is_ptuple: (Pat) -> Bool = (p) -> {
  match p {
    PTuple(_) => true,
    _ => false
  }
}

export let is_pstring: (Pat) -> Bool = (p) -> {
  match p {
    PString(_) => true,
    _ => false
  }
}

export let emit_i32_eq: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_eq)
}

export let emit_i32_ne: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_ne)
}

// Extract pattern from match arm pair
export let get_arm_pat: ((Pat, Expr)) -> Pat = (arm) -> {
  let (p, _) = arm
  p
}

// Returns index into ctor_names array, or -1 if not found
export let rec lookup_ctor: (Array[String], String, Int) -> Int = (ctor_names, name, i) -> {
  if i >= Array::length(ctor_names) {
    -1
  }
  else if Array::get(ctor_names, i) == name {
    i
  }
  else lookup_ctor(ctor_names, name, i + 1)
}

// Is `value` an enum/struct constructor application (`A(...)`)? Such values are
// heap-allocated and tagged (`ptr | 1`), so under RC they are dropped like
// records (untag first). A bare nullary ctor parsed as an EIdent is not matched
// here (it carries no payload and is a conservative leak at worst).
export let is_ctor_call: (Expr, CtorTable) -> Bool = (value, ct) -> {
  match value {
    ECall(callee, _) => match callee {
      EIdent(nm) => lookup_ctor(ct.names, nm, 0) >= 0,
      _ => false
    },
    _ => false
  }
}

export let emit_i32_eqz: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_eqz)
}

export let emit_i32_mul: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_mul)
}

export let emit_i32_sub: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_sub)
}

export let emit_str_ref: (Bytes, Int, Int) -> Unit = (buf, offset, length) -> {
  emit_i64_const(buf, offset)
  emit_i64_const(buf, 32)
  emit_i64_shl(buf)
  emit_i64_const(buf, length)
  emit_i64_or(buf)
}

// Extract body from match arm pair
export let get_arm_body: ((Pat, Expr)) -> Expr = (arm) -> {
  let (_, b) = arm
  b
}

export let get_efn_body: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EFn(_, _, _, _, _, body) => body,
    _ => throw("not EFn")
  }
}

export let get_eif_cond: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EIf(c, _, _) => c,
    _ => throw("not EIf")
  }
}

export let get_eif_else: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EIf(_, _, e) => e,
    _ => throw("not EIf")
  }
}

export let get_eif_then: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EIf(_, t, _) => t,
    _ => throw("not EIf")
  }
}

export let get_elet_val: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    ELet(_, val, _) => val,
    _ => throw("not ELet")
  }
}

// Resolve function: returns (func_index, param_count, has_return)
export let resolve_func: (FuncTable, String) -> (Int, Int, Int) with { Error } = (ft, name) -> {
  let len = Array::length(ft.names)
  let mut i = 0
  let mut found = -1
  while i < len {
    if Array::get(ft.names, i) == name {
      found = i
      i = len
    } else {
      i = i + 1
    }
  }
  if found < 0 {
    throw(String::concat("undefined function: ", name))
  };
  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))
}

// Emit WASM instruction for a binary operator
export let emit_binop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {
  if op == "+" {
    emit_i64_add(buf)
  }
  else if op == "-" {
    emit_i64_sub(buf)
  }
  else if op == "*" {
    emit_i64_mul(buf)
  }
  else if op == "/" {
    emit_i64_div_s(buf)
  }
  else if op == "%" {
    emit_i64_rem_s(buf)
  }
  else if op == "&" {
    emit_i64_and(buf)
  }
  else if op == "|" {
    emit_i64_or(buf)
  }
  else if op == "^" {
    emit_i64_xor(buf)
  }
  else if op == "<<" {
    emit_i64_shl(buf)
  }
  else if op == ">>" {
    emit_i64_shr_s(buf)
  }
  else if op == "==" {
    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "!=" {
    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "<" {
    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == ">" {
    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "<=" {
    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == ">=" {
    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "&&" {
    emit_i64_and(buf)
  }
  else if op == "||" {
    emit_i64_or(buf)
  }
  else {
    throw(String::concat("unsupported binop: ", op))
  }
}

export let emit_i32_ge_u: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_ge_u)
}

export let emit_i32_gt_u: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_gt_u)
}

export let emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {
  bytebuf_push(buf, op_i64_load)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let get_ebinop_op: (Expr) -> String with { Error } = (expr) -> {
  match expr {
    EBinOp(op, _, _) => op,
    _ => throw("not EBinOp")
  }
}

export let get_elet_body: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    ELet(_, _, body) => body,
    _ => throw("not ELet")
  }
}

export let get_elet_name: (Expr) -> String with { Error } = (expr) -> {
  match expr {
    ELet(name, _, _) => name,
    _ => throw("not ELet")
  }
}

// Extract function body from SLet(_, _, _, _, EFn(_, _, _, _, _, body))
export let get_func_body: (Stmt) -> Expr with { Error } = (stmt) -> {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, _, _, _, body) => body,
      _ => throw("get_func_body: not a function")
    },
    _ => throw("get_func_body: not a let statement")
  }
}

export let get_slet_expr: (Stmt) -> Expr with { Error } = (stmt) -> {
  match stmt {
    SLet(_, _, _, _, expr) => expr,
    _ => throw("not SLet")
  }
}

export let get_slet_name: (Stmt) -> String with { Error } = (stmt) -> {
  match stmt {
    SLet(_, _, name, _, _) => name,
    _ => throw("not SLet")
  }
}

// The declared type annotation of an SLet (`let f: T = ...`), or None.
// ADR-0055 Stage 4: a top-level fn's parameter types live on its signature, not
// on the lambda params, so owned-param drops read them from here.
export let get_slet_type: (Stmt) -> Option[TypeExpr] = (stmt) -> {
  match stmt {
    SLet(_, _, _, ty, _) => ty,
    _ => None
  }
}

// Extract a function signature's parameter types: Some(arg_types) when `ty` is a
// function type `(A, B, ...) -> R`, else None.
export let fn_type_param_types: (Option[TypeExpr]) -> Option[Array[TypeExpr]] = (ty) -> {
  match ty {
    Some(t) =>
      match t {
        TyFn(args, _, _) => Some(args),
        _ => None
      },
    None => None
  }
}

export let resolve_local: (Array[String], String, String) -> Int with { Error } = (names, name, tag) -> {
  let mut i = Array::length(names) - 1
  let mut result = -1
  while i >= 0 {
    if Array::get(names, i) == name {
      result = i
      i = -1
    } else {
      i = i - 1
    }
  }
  if result < 0 {
    // O(N) via StringBuilder. Previously, each `String::concat(dbg, ..)`
    // copied the entire growing prefix — total O(N^2) chars copied for
    // a module with N locals.
    let sb = StringBuilder::new()
    StringBuilder::push(sb, "undefined variable (local): ")
    StringBuilder::push(sb, name)
    StringBuilder::push(sb, " [locals: ")
    let mut di = 0
    let dlen = Array::length(names)
    while di < dlen {
      if di > 0 {
        StringBuilder::push(sb, ", ")
      }
      StringBuilder::push(sb, Array::get(names, di))
      di = di + 1
    }
    StringBuilder::push(sb, "] @")
    StringBuilder::push(sb, tag)
    throw(StringBuilder::freeze(sb))
  }
  result
}

export let emit_i64_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {
  bytebuf_push(buf, op_i64_store)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

// Find the SLet statement for a given function name
export let find_func_stmt: (Array[Stmt], String) -> Stmt with { Error } = (stmts, name) -> {
  let len = Array::length(stmts)
  let mut i = 0
  let mut found = -1
  while i < len {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, sname, _, _) => if sname == name {
        found = i
        i = len
      },
      _ => ()
    }
    if found < 0 {
      i = i + 1
    }
  }
  if found < 0 {
    throw(String::concat("function not found: ", name))
  }
  Array::get(stmts, found)
}
