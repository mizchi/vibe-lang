import ../../core/index.vibe {
  Stmt
}

import ../common_base/index.vibe {
  DbgProv
}

// Straight to the defining file (#726): the old ./linked_impl.vibe middleman
// was a chained re-export the FS merge does not resolve transitively -- and it
// never re-exported compile_wasi_module_rc_shadow_impl at all (the flat
// bundle's first-match hid that).
export ./linked_compile.vibe {
  compile_wasi_module_with_sources_impl,
  compile_wasi_module_with_sources_coverage_impl,
  compile_wasi_module_with_sources_trace_impl,
  compile_wasi_module_with_sources_break_impl,
  compile_wasi_module_linked_impl,
  compile_wasi_module_rc_impl,
  compile_wasi_module_rc_shadow_impl
}

export let compile_wasi_module_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_with_sources_impl(stmts, entry_name, Array::slice([
    ("", "")
  ], 0, 0))
}

export let compile_wasi_module_coverage_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_with_sources_coverage_impl(stmts, entry_name, Array::slice([
    ("", "")
  ], 0, 0))
}

export let compile_wasi_module_trace_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_with_sources_trace_impl(stmts, entry_name, Array::slice([
    ("", "")
  ], 0, 0))
}

export let compile_wasi_module_break_impl: (Array[Stmt], String, DbgProv) -> Bytes with { Error } = (stmts, entry_name, prov) -> {
  compile_wasi_module_with_sources_break_impl(stmts, entry_name, Array::slice([
    ("", "")
  ], 0, 0), prov)
}
