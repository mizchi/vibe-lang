import ../../core/index.vibe {
  Stmt
}

import ./linked_impl.vibe {
  compile_wasi_module_with_sources_impl as linked_compile_wasi_module_with_sources_impl,
  compile_wasi_module_linked_impl as linked_compile_wasi_module_linked_impl
}

export let compile_wasi_module_with_sources_impl = (stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {
  linked_compile_wasi_module_with_sources_impl(stmts, entry_name, selfhost_srcs)
}

export let compile_wasi_module_linked_impl = (stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool) -> Bytes with { Error } {
  linked_compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, linked_imports, library_mode)
}

export let compile_wasi_module_impl = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {
  linked_compile_wasi_module_with_sources_impl(stmts, entry_name, Array::slice([
    ("", "")
  ], 0, 0))
}
