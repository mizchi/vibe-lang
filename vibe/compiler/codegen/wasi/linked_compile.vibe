//# Functions

export let compile_wasi_module_linked_impl = (stmts_raw: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool) -> Bytes with { Error } {
  // Lower `ELoop(params, body)` → `ELetMut + EWhile` (see
  // ../lower_loop.vibe) so that downstream codegen only sees the
  // while/letmut/break/continue forms it knows how to emit. The parser
  // now preserves `ELoop` as a structural node for print_expr
  // roundtrip (see parser_loop_test.vibe).
  let stmts = lower_loop_stmts(stmts_raw)
  let fn_names_list = Array::slice([
    ""
  ], 0, 0)
  let fn_param_counts = Array::slice([
    0
  ], 0, 0)
  let fn_needs_env_list = Array::slice([
    true
  ], 0, 0)
  let fn_stmt_indices = Array::slice([
    0
  ], 0, 0)
  let thunk_names_list = Array::slice([
    ""
  ], 0, 0)
  let const_int_names_list = Array::slice([
    ""
  ], 0, 0)
  let const_int_values_list = Array::slice([
    0
  ], 0, 0)
  let export_fn_names = Array::slice([
    ""
  ], 0, 0)
  let export_fn_user_indices = Array::slice([
    0
  ], 0, 0)
  let test_fn_names = Array::slice([
    ""
  ], 0, 0)
  let empty_tp = Array::slice([
    ""
  ], 0, 0)
  let empty_bounds = Array::slice([
    ("", Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let empty_params = Array::slice([
    ("", None)
  ], 0, 0)
  let mut pi = 0
  while pi < Array::length(stmts) {
    match Array::get(stmts, pi) {
      STest(tname, tbody) => {
        let test_fn = String::concat("__test_", tname)
        Array::push(test_fn_names, test_fn)
        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))
      },
      SBench(bname, bbody) => {
        let bench_fn = String::concat("__bench_", bname)
        Array::push(test_fn_names, bench_fn)
        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))
      },
      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {
        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {
          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))
        }
        ,
        _ => ()
      },
      _ => ()
    }
    pi = pi + 1
  }
  if Array::length(test_fn_names) > 0 {
    let mut has_entry = false
    let mut ei = 0
    while ei < Array::length(stmts) {
      match Array::get(stmts, ei) {
        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {
          has_entry = true
        },
        _ => ()
      }
      ei = ei + 1
    }
    if !has_entry {
      ()
    }
  }
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if is_slet(stmt) {
      let name = get_slet_name(stmt)
      let expr = get_slet_expr(stmt)
      let is_export = get_slet_export(stmt)
      let user_idx = Array::length(fn_names_list)
      if is_efn(expr) {
        let params = get_efn_params(expr)
        Array::push(fn_names_list, name)
        Array::push(fn_param_counts, Array::length(params))
        Array::push(fn_needs_env_list, true)
        Array::push(fn_stmt_indices, i)
      } else {
        if (expr_tag(expr) == 0) && !is_export {
          Array::push(const_int_names_list, name)
          Array::push(const_int_values_list, get_eint_value(expr))
        } else {
          Array::push(fn_names_list, name)
          Array::push(fn_param_counts, 0)
          Array::push(fn_needs_env_list, true)
          Array::push(fn_stmt_indices, i)
          Array::push(thunk_names_list, name)
        }
      }
      if is_export || library_mode {
        Array::push(export_fn_names, name)
        Array::push(export_fn_user_indices, user_idx)
      }
    }
    i = i + 1
  }
  let ctor_names_list = Array::slice([
    "None",
    "Some"
  ], 0, 2)
  let ctor_tags_list = Array::slice([
    0,
    1
  ], 0, 2)
  let ctor_field_counts_list = Array::slice([
    0,
    1
  ], 0, 2)
  let ctor_type_names_list = Array::slice([
    "Option",
    "Option"
  ], 0, 2)
  let mut type_index = 1
  let mut ei2 = 0
  while ei2 < Array::length(stmts) {
    match Array::get(stmts, ei2) {
      SEnum(_, ename, variants) => {
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index<<16)|vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          vi = vi + 1
        }
        0
      },
      SStruct(_, sname, sfields) => {
        type_index = type_index + 1
        Array::push(ctor_names_list, sname)
        Array::push(ctor_tags_list, type_index<<16)
        Array::push(ctor_field_counts_list, Array::length(sfields))
        Array::push(ctor_type_names_list, sname)
        0
      },
      _ => 0
    }
    ei2 = ei2 + 1
  }
  let struct_names = Array::slice([
    ""
  ], 0, 0)
  let struct_field_names = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SStruct(_, sname, sfields) => {
        Array::push(struct_names, sname)
        let fnames = Array::slice([
          ""
        ], 0, 0)
        let mut sfi = 0
        while sfi < Array::length(sfields) {
          let (fname, _) = Array::get(sfields, sfi)
          Array::push(fnames, fname)
          sfi = sfi + 1
        }
        Array::push(struct_field_names, fnames)
        ()
      },
      _ => ()
    }
    si = si + 1
  }
  let num_user_funcs = Array::length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if Array::get(fn_names_list, ei) == entry_name {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  let str_strs = collect_strings_stmts(stmts)
  // NOTE: No dedup — the O(n^2) dedup uses ~1.8GB of MoonBit RC overhead.
  // Duplicate strings waste ~50KB in the output WASM data section.
  let src_str_base = Array::length(str_strs)
  let num_src_pairs = Array::length(selfhost_srcs)
  let mut __src_i = 0
  while __src_i < num_src_pairs {
    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)
    Array::push(str_strs, __src_path)
    Array::push(str_strs, __src_content)
    __src_i = __src_i + 1
  }
  let num_strings = Array::length(str_strs)
  let data_base = 64
  let str_offsets = Array::slice([
    0
  ], 0, 0)
  let str_lengths = Array::slice([
    0
  ], 0, 0)
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = Array::get(str_strs, si)
    let slen = String::length(s)
    Array::push(str_offsets, str_pos)
    Array::push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }
  let heap_start = ((str_pos + 7) / 8) * 8
  let need_env_get_builtin = stmts_use_builtin(stmts, fn_names_list, "Env::get")
  let need_env_args_len_builtin = stmts_use_builtin(stmts, fn_names_list, "Env::args_len")
  let need_env_args_get_builtin = stmts_use_builtin(stmts, fn_names_list, "Env::args_get")
  let need_fs_read_file_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::read_file")
  let need_fs_exists_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::exists")
  let need_fs_stat_token_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::stat_token")
  let need_fs_write_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::write_bytes")
  let need_fs_write_file_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::write_file")
  let need_fs_readdir_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::readdir")
  let need_fs_getcwd_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::getcwd")
  let need_fs_chdir_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::chdir")
  let need_fs_is_dir_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::is_dir")
  let need_fs_is_file_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::is_file")
  let need_fs_mkdir_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::mkdir")
  let need_fs_copy_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::copy")
  let need_fs_remove_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::remove")
  let need_fs_append_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::append")
  let need_fs_read_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::read_bytes")
  let mut next_import_idx = 1
  let env_get_import_idx = if need_env_get_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let env_args_len_import_idx = if need_env_args_len_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let env_args_get_import_idx = if need_env_args_get_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_read_file_import_idx = if need_fs_read_file_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_exists_import_idx = if need_fs_exists_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_write_file_import_idx = if need_fs_write_file_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_readdir_import_idx = if need_fs_readdir_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_getcwd_import_idx = if need_fs_getcwd_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_chdir_import_idx = if need_fs_chdir_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_is_dir_import_idx = if need_fs_is_dir_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_is_file_import_idx = if need_fs_is_file_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_mkdir_import_idx = if need_fs_mkdir_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_copy_import_idx = if need_fs_copy_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_remove_import_idx = if need_fs_remove_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_append_import_idx = if need_fs_append_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_read_bytes_import_idx = if need_fs_read_bytes_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let linked_import_indices = Array::slice([
    0
  ], 0, 0)
  let linked_import_names = Array::slice([
    ""
  ], 0, 0)
  let mut li_i = 0
  while li_i < Array::length(linked_imports) {
    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)
    Array::push(linked_import_indices, next_import_idx)
    Array::push(linked_import_names, lfn_name)
    next_import_idx = next_import_idx + 1
    li_i = li_i + 1
  }
  let num_imported_funcs = next_import_idx
  let print_int_idx = num_imported_funcs
  let print_str_idx = print_int_idx + 1
  let str_len_idx = print_str_idx + 1
  let str_eq_idx = str_len_idx + 1
  let str_concat_idx = str_eq_idx + 1
  let arr_new_idx = str_concat_idx + 1
  let arr_len_idx = arr_new_idx + 1
  let arr_get_idx = arr_len_idx + 1
  let arr_push_idx = arr_get_idx + 1
  let arr_set_idx = arr_push_idx + 1
  let double_to_int_idx = arr_set_idx + 1
  let int_to_double_idx = double_to_int_idx + 1
  let str_char_code_at_idx = int_to_double_idx + 1
  let str_from_char_code_idx = str_char_code_at_idx + 1
  let str_substring_idx = str_from_char_code_idx + 1
  let identity_idx = str_substring_idx + 1
  let arr_slice_idx = identity_idx + 1
  let arr_concat_idx = arr_slice_idx + 1
  let arr_truncate_idx = arr_concat_idx + 1
  let string_join_idx = arr_truncate_idx + 1
  let fs_read_file_stub_idx = string_join_idx + 1
  let fs_exists_stub_idx = fs_read_file_stub_idx + 1
  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1
  let fs_write_bytes_stub_idx = fs_stat_token_stub_idx + 1
  let eq_idx = fs_write_bytes_stub_idx + 1
  let string_ends_with_idx = eq_idx + 1
  let string_last_index_of_idx = string_ends_with_idx + 1
  let arr_push_all_idx = string_last_index_of_idx + 1
  let string_index_of_idx = arr_push_all_idx + 1
  let string_contains_idx = string_index_of_idx + 1
  let string_starts_with_idx = string_contains_idx + 1
  let string_split_idx = string_starts_with_idx + 1
  let string_trim_idx = string_split_idx + 1
  let selfhost_sources_idx = string_trim_idx + 1
  let bytes_new_idx = selfhost_sources_idx + 1
  let bytes_len_idx = bytes_new_idx + 1
  let bytes_get_idx = bytes_len_idx + 1
  let bytes_set_idx = bytes_get_idx + 1
  let bytes_push_idx = bytes_set_idx + 1
  let bytes_append_idx = bytes_push_idx + 1
  let bytes_concat_idx = bytes_append_idx + 1
  let bytes_slice_idx = bytes_concat_idx + 1
  let bytes_from_array_idx = bytes_slice_idx + 1
  let bytes_to_array_idx = bytes_from_array_idx + 1
  let env_get_idx = if env_get_import_idx >= 0 {
    env_get_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let env_args_len_idx = if env_args_len_import_idx >= 0 {
    env_args_len_import_idx
  } else {
    fs_exists_stub_idx
  }
  let env_args_get_idx = if env_args_get_import_idx >= 0 {
    env_args_get_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let fs_read_file_idx = if fs_read_file_import_idx >= 0 {
    fs_read_file_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let fs_exists_idx = if fs_exists_import_idx >= 0 {
    fs_exists_import_idx
  } else {
    fs_exists_stub_idx
  }
  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 {
    fs_stat_token_import_idx
  } else {
    fs_stat_token_stub_idx
  }
  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 {
    fs_write_bytes_import_idx
  } else {
