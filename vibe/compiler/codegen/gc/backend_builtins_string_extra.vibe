export let gen_str_char_code_at_body = () -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  b
}

export let gen_str_from_char_code_body = () -> Bytes {
  let b = bytebuf_new()
  emit_global_get(b, 0)
  emit_local_tee(b, 1)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 1)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 1)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_i64_const(b, 1)
  emit_i64_or(b)
  b
}

export let gen_str_substring_body = () -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i64_sub(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}
