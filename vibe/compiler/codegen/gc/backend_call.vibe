//# Functions

let compile_call_gc: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, callee, args, local_names, next_local, ctx, ld, ce) -> {
  match callee {
    EIdent(fname) => {
      let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)
      if ctor_lookup_idx >= 0 {
        let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)
        let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)
        let obj_size = 8 + fc * 8
        let ptr_local = next_local
        Array::push(local_names, "__ctor_ptr")
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, ptr_local)
        emit_global_get(buf, 0)
        emit_i32_const(buf, obj_size)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, tag)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, fc)
        emit_i32_store(buf, 2, 4)
        let actual_args = if Array::length(args) == 1 {
          match Array::get(args, 0) {
            ERecord(rec_fields) => {
              let rec find_sn: (Int) -> Int = (sni) -> {
                if sni >= Array::length(ctx.ctor_table.struct_names) {
                  -1
                }
                else if Array::get(ctx.ctor_table.struct_names, sni) == fname {
                  sni
                }
                else find_sn(sni + 1)
              }
              let sn_idx = find_sn(0)
              if sn_idx >= 0 {
                let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)
                let ordered = Array::slice([
                  EUnit
                ], 0, 0)
                let mut oi = 0
                while oi < Array::length(def_fnames) {
                  let target_name = Array::get(def_fnames, oi)
                  let rec find_rf: (Int) -> Expr = (ri) -> {
                    if ri >= Array::length(rec_fields) {
                      EUnit
                    }
                    else {
                      let (rfn, rfv) = Array::get(rec_fields, ri)
                      if rfn == target_name {
                        rfv
                      }
                      else find_rf(ri + 1)
                    }
                  }
                  Array::push(ordered, find_rf(0))
                  oi = oi + 1
                }
                ordered
              } else {
                args
              }
            },
            _ => args
          }
        } else {
          args
        }
        let mut nl_c = next_local + 1
        let mut fi_c = 0
        while fi_c < Array::length(actual_args) {
          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)
          let val_local = nl_c
          Array::push(local_names, "__ctor_val")
          emit_local_set(buf, val_local)
          nl_c = nl_c + 1
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 8 + fi_c * 8)
          fi_c = fi_c + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_c
      }
      else if fname == "__slice" {
        let (ss_idx, _, _) = resolve_func(ctx.func_table, "String::substring")
        let (bs_idx, _, _) = resolve_func(ctx.func_table, "Bytes::slice")
        let (as_idx, _, _) = resolve_func(ctx.func_table, "Array::slice")
        let obj_local = next_local
        let start_local = next_local + 1
        let end_local = next_local + 2
        let ptr_local = next_local + 3
        let cap_local = next_local + 4
        Array::push(local_names, "__slice_obj")
        Array::push(local_names, "__slice_start")
        Array::push(local_names, "__slice_end")
        Array::push(local_names, "__slice_ptr")
        Array::push(local_names, "__slice_cap")
        let mut nl = next_local + 5
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_local_set(buf, obj_local)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        emit_local_set(buf, start_local)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
        emit_local_set(buf, end_local)
        emit_local_get(buf, obj_local)
        emit_i64_const(buf, 32)
        emit_i64_shr_s(buf)
        emit_i64_eqz(buf)
        emit_if_i64(buf)
        emit_local_get(buf, obj_local)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, cap_local)
        emit_local_get(buf, cap_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 2147483647)
        emit_i32_gt_u(buf)
        emit_if_i64(buf)
        emit_local_get(buf, obj_local)
        emit_local_get(buf, start_local)
        emit_local_get(buf, end_local)
        emit_call(buf, bs_idx)
        emit_else(buf)
        emit_local_get(buf, obj_local)
        emit_local_get(buf, start_local)
        emit_local_get(buf, end_local)
        emit_call(buf, as_idx)
        emit_end(buf)
        emit_else(buf)
        emit_local_get(buf, obj_local)
        emit_local_get(buf, start_local)
        emit_local_get(buf, end_local)
        emit_call(buf, ss_idx)
        emit_end(buf)
        nl
      }
      else if fname == "__index" {
        let (sg_idx, _, _) = resolve_func(ctx.func_table, "String::char_code_at")
        let (bg_idx, _, _) = resolve_func(ctx.func_table, "Bytes::get")
        let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
        let obj_local = next_local
        let idx_local = next_local + 1
        let ptr_local = next_local + 2
        let cap_local = next_local + 3
        Array::push(local_names, "__index_obj")
        Array::push(local_names, "__index_idx")
        Array::push(local_names, "__index_ptr")
        Array::push(local_names, "__index_cap")
        let mut nl = next_local + 4
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_local_set(buf, obj_local)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        emit_local_set(buf, idx_local)
        emit_local_get(buf, obj_local)
        emit_i64_const(buf, 32)
        emit_i64_shr_s(buf)
        emit_i64_eqz(buf)
        emit_if_i64(buf)
        emit_local_get(buf, obj_local)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, cap_local)
        emit_local_get(buf, cap_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 2147483647)
        emit_i32_gt_u(buf)
        emit_if_i64(buf)
        emit_local_get(buf, obj_local)
        emit_local_get(buf, idx_local)
        emit_call(buf, bg_idx)
        emit_else(buf)
        emit_local_get(buf, obj_local)
        emit_local_get(buf, idx_local)
        emit_call(buf, ag_idx)
        emit_end(buf)
        emit_else(buf)
        emit_local_get(buf, obj_local)
        emit_local_get(buf, idx_local)
        emit_call(buf, sg_idx)
        emit_end(buf)
        nl
      }
      else if fname == "__set_field" {
        let field = get_estring_value(Array::get(args, 1))
        let fc = String::char_code_at(field, 0)
        let is_numeric = fc >= 48 && fc <= 57
        let field_idx = if is_numeric {
          let mut vi = 0
          let mut vp = 0
          while vp < String::length(field) {
            vi = vi * 10 + (String::char_code_at(field, vp) - 48)
            vp = vp + 1
          }
          vi
        } else {
          let mut si_search = 0
          let mut found = -1
          while si_search < Array::length(ctx.ctor_table.struct_names) {
            let fnames = Array::get(ctx.ctor_table.struct_field_names, si_search)
            let mut fi = 0
            while fi < Array::length(fnames) {
              if Array::get(fnames, fi) == field {
                found = fi
                fi = Array::length(fnames)
              } else {
                fi = fi + 1
              }
            }
            if found >= 0 {
              si_search = Array::length(ctx.ctor_table.struct_names)
            } else {
              si_search = si_search + 1
            }
          }
          if found < 0 {
            throw(String::concat("unknown struct field: ", field))
          }
          found
        }
        let mut nl = next_local
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
        let store_off = if is_numeric {
          field_idx * 8
        } else {
          8 + field_idx * 8
        }
        emit_i64_store(buf, 3, store_off)
        emit_i64_const(buf, 1)
        nl
      }
      else if fname == "__len" {
        let (sl_idx, _, _) = resolve_func(ctx.func_table, "String::length")
        let (bl_idx, _, _) = resolve_func(ctx.func_table, "Bytes::length")
        let (al_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
        let obj_local = next_local
        let ptr_local = next_local + 1
        let cap_local = next_local + 2
        Array::push(local_names, "__len_obj")
        Array::push(local_names, "__len_ptr")
        Array::push(local_names, "__len_cap")
        let mut nl = next_local + 3
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_local_set(buf, obj_local)
        emit_local_get(buf, obj_local)
        emit_i64_const(buf, 32)
        emit_i64_shr_s(buf)
        emit_i64_eqz(buf)
        emit_if_i64(buf)
        emit_local_get(buf, obj_local)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, cap_local)
        emit_local_get(buf, cap_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 2147483647)
        emit_i32_gt_u(buf)
        emit_if_i64(buf)
        emit_local_get(buf, obj_local)
        emit_call(buf, bl_idx)
        emit_else(buf)
        emit_local_get(buf, obj_local)
        emit_call(buf, al_idx)
        emit_end(buf)
        emit_else(buf)
        emit_local_get(buf, obj_local)
        emit_call(buf, sl_idx)
        emit_end(buf)
        nl
      }
      else if fname == "Array::slice" {
        let (an_idx, _, _) = resolve_func(ctx.func_table, "array_new")
        let (ap_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
        let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
        let arr_local = next_local
        let start_local = next_local + 1
        let end_local = next_local + 2
        let new_arr_local = next_local + 3
        let i_local = next_local + 4
        Array::push(local_names, "__slice_arr")
        Array::push(local_names, "__slice_start")
        Array::push(local_names, "__slice_end")
        Array::push(local_names, "__slice_new")
        Array::push(local_names, "__slice_i")
        let mut nl = next_local + 5
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_local_set(buf, arr_local)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        emit_local_set(buf, start_local)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
        emit_local_set(buf, end_local)
        emit_call(buf, an_idx)
        emit_local_set(buf, new_arr_local)
        emit_local_get(buf, start_local)
        emit_local_set(buf, i_local)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, i_local)
        emit_local_get(buf, end_local)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        emit_local_get(buf, new_arr_local)
        emit_local_get(buf, arr_local)
        emit_local_get(buf, i_local)
        emit_call(buf, ag_idx)
        emit_call(buf, ap_idx)
        emit_local_get(buf, i_local)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, i_local)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_local_get(buf, new_arr_local)
        nl
      }
      else if fname == "Array::concat" {
        let (an_idx, _, _) = resolve_func(ctx.func_table, "array_new")
        let (ap_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
        let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
        let (al_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
        let a_local = next_local
        let b_local = next_local + 1
        let new_arr_local = next_local + 2
        let i_local = next_local + 3
        let len_local = next_local + 4
        Array::push(local_names, "__concat_a")
        Array::push(local_names, "__concat_b")
        Array::push(local_names, "__concat_new")
        Array::push(local_names, "__concat_i")
        Array::push(local_names, "__concat_len")
        let mut nl = next_local + 5
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_local_set(buf, a_local)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        emit_local_set(buf, b_local)
        emit_call(buf, an_idx)
        emit_local_set(buf, new_arr_local)
        emit_i64_const(buf, 0)
        emit_local_set(buf, i_local)
        emit_local_get(buf, a_local)
        emit_call(buf, al_idx)
        emit_local_set(buf, len_local)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, i_local)
        emit_local_get(buf, len_local)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        emit_local_get(buf, new_arr_local)
        emit_local_get(buf, a_local)
        emit_local_get(buf, i_local)
        emit_call(buf, ag_idx)
        emit_call(buf, ap_idx)
        emit_local_get(buf, i_local)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, i_local)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_i64_const(buf, 0)
        emit_local_set(buf, i_local)
        emit_local_get(buf, b_local)
        emit_call(buf, al_idx)
        emit_local_set(buf, len_local)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, i_local)
        emit_local_get(buf, len_local)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        emit_local_get(buf, new_arr_local)
        emit_local_get(buf, b_local)
        emit_local_get(buf, i_local)
        emit_call(buf, ag_idx)
        emit_call(buf, ap_idx)
        emit_local_get(buf, i_local)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, i_local)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_local_get(buf, new_arr_local)
        nl
      }
      else if fname == "Array::truncate" {
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        emit_drop(buf)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        emit_drop(buf)
        emit_i64_const(buf, 0)
        nl
      }
      else if fname == "Array::push_all" {
        let (ap_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
        let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
        let (al_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
        let dst_local = next_local
        let src_local = next_local + 1
        let i_local = next_local + 2
        let len_local = next_local + 3
        Array::push(local_names, "__pushall_dst")
        Array::push(local_names, "__pushall_src")
        Array::push(local_names, "__pushall_i")
        Array::push(local_names, "__pushall_len")
        let mut nl = next_local + 4
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_local_set(buf, dst_local)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        emit_local_set(buf, src_local)
        emit_i64_const(buf, 0)
        emit_local_set(buf, i_local)
        emit_local_get(buf, src_local)
        emit_call(buf, al_idx)
        emit_local_set(buf, len_local)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, i_local)
        emit_local_get(buf, len_local)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        emit_local_get(buf, dst_local)
        emit_local_get(buf, src_local)
        emit_local_get(buf, i_local)
        emit_call(buf, ag_idx)
        emit_call(buf, ap_idx)
        emit_local_get(buf, i_local)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, i_local)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_i64_const(buf, 0)
        nl
      }
      else if fname == "eq" {
        // Content-based equality: i64_eq fast path, then str_eq fallback
        let (str_eq_idx, _, _) = resolve_func(ctx.func_table, "String::equals")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        let eq_a = nl
        let eq_b = nl + 1
        Array::push(local_names, "__eq_a")
        Array::push(local_names, "__eq_b")
        emit_local_set(buf, eq_b)
        emit_local_set(buf, eq_a)
        emit_local_get(buf, eq_a)
        emit_local_get(buf, eq_b)
        emit_i64_eq(buf)
        emit_if_i64(buf)
        emit_i64_const(buf, 1)
        emit_else(buf)
        emit_local_get(buf, eq_a)
        emit_local_get(buf, eq_b)
        emit_call(buf, str_eq_idx)
        emit_end(buf)
        nl + 2
      }
      else if fname == "not" {
        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        emit_i64_eqz(buf)
        emit_i64_extend_i32_u(buf)
        nl
      }
      else if fname == "Double::to_i64_bits" || fname == "Double::from_i64_bits" {
        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl
      }
      else if fname == "__to_string" {
        let (ts_idx, _, _) = resolve_func(ctx.func_table, "__to_string")
        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        emit_call(buf, ts_idx)
        nl
      }
      else if fname == "MapBuilder::new" {
        // Allocate 520 bytes (header 8 + 32 entries * 16 bytes)
        let ptr_l = next_local
        Array::push(local_names, "__mb_ptr")
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, ptr_l)
        emit_global_get(buf, 0)
        emit_i32_const(buf, 520)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        // Store count = 0
        emit_local_get(buf, ptr_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 0)
        emit_i32_store(buf, 2, 0)
        // Store capacity = 32
        emit_local_get(buf, ptr_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 32)
        emit_i32_store(buf, 2, 4)
        emit_local_get(buf, ptr_l)
        next_local + 1
      }
      else if fname == "MapBuilder::set" {
        let (eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
        let mb_l = nl
        let mk_l = nl + 1
        let mv_l = nl + 2
        let mc_l = nl + 3
        let mi_l = nl + 4
        let found_l = nl + 5
        Array::push(local_names, "__mbs_map")
        Array::push(local_names, "__mbs_key")
        Array::push(local_names, "__mbs_val")
        Array::push(local_names, "__mbs_cnt")
        Array::push(local_names, "__mbs_i")
        Array::push(local_names, "__mbs_found")
        emit_local_set(buf, mv_l)
        emit_local_set(buf, mk_l)
        emit_local_set(buf, mb_l)
        // Load count
        emit_local_get(buf, mb_l)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, mc_l)
        // Search for existing key
        emit_i64_const(buf, 0)
        emit_local_set(buf, mi_l)
        emit_i64_const(buf, 0)
        emit_local_set(buf, found_l)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, mi_l)
        emit_local_get(buf, mc_l)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        // Compare key at entry[i]
        emit_local_get(buf, mb_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, mi_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_i64_load(buf, 3, 8)
        emit_local_get(buf, mk_l)
        emit_call(buf, eq_fi)
        emit_i32_wrap_i64(buf)
        emit_if_void(buf)
        // Found: update value in place
        emit_local_get(buf, mb_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, mi_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_local_get(buf, mv_l)
        emit_i64_store(buf, 3, 16)
        emit_i64_const(buf, 1)
        emit_local_set(buf, found_l)
        emit_br(buf, 2)
        emit_end(buf)
        emit_local_get(buf, mi_l)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, mi_l)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        // If not found, append new entry
        emit_local_get(buf, found_l)
        emit_i64_eqz(buf)
        emit_if_void(buf)
        // Store key at entry[count].key (offset 8)
        emit_local_get(buf, mb_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, mc_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_local_get(buf, mk_l)
        emit_i64_store(buf, 3, 8)
        // Store value at entry[count].value (offset 16)
        emit_local_get(buf, mb_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, mc_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_local_get(buf, mv_l)
        emit_i64_store(buf, 3, 16)
        // Increment count
        emit_local_get(buf, mb_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, mc_l)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_i32_wrap_i64(buf)
        emit_i32_store(buf, 2, 0)
        emit_end(buf)
        emit_i64_const(buf, 0)
        nl + 6
      }
      else if fname == "MapBuilder::freeze" {
        ce(buf, Array::get(args, 0), local_names, next_local, ld)
      }
      else if fname == "Map::get" {
        let (eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        let map_l = nl
        let key_l = nl + 1
        let cnt_l = nl + 2
        let idx_l = nl + 3
        Array::push(local_names, "__mg_map")
        Array::push(local_names, "__mg_key")
        Array::push(local_names, "__mg_cnt")
        Array::push(local_names, "__mg_i")
        emit_local_set(buf, key_l)
        emit_local_set(buf, map_l)
        // Load count
        emit_local_get(buf, map_l)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, cnt_l)
        emit_i64_const(buf, 0)
        emit_local_set(buf, idx_l)
        // block $result : i64
        emit_block_i64(buf)
        emit_block_void(buf)
        emit_loop_void(buf)
        // if i >= count: break
        emit_local_get(buf, idx_l)
        emit_local_get(buf, cnt_l)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        // Load key at entry[i]
        emit_local_get(buf, map_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, idx_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_i64_load(buf, 3, 8)
        emit_local_get(buf, key_l)
        emit_call(buf, eq_fi)
        emit_i32_wrap_i64(buf)
        emit_if_void(buf)
        // Found: load value and break
        emit_local_get(buf, map_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, idx_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_i64_load(buf, 3, 16)
        emit_br(buf, 3)
        emit_end(buf)
        // i++
        emit_local_get(buf, idx_l)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, idx_l)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        // Not found: return 0
        emit_i64_const(buf, 0)
        emit_end(buf)
        nl + 4
      }
      else if fname == "Map::has_key" || fname == "map_has" {
        let (eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        let map_l = nl
        let key_l = nl + 1
        let cnt_l = nl + 2
        let idx_l = nl + 3
        Array::push(local_names, "__hk_map")
        Array::push(local_names, "__hk_key")
        Array::push(local_names, "__hk_cnt")
        Array::push(local_names, "__hk_i")
        emit_local_set(buf, key_l)
        emit_local_set(buf, map_l)
        emit_local_get(buf, map_l)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, cnt_l)
        emit_i64_const(buf, 0)
        emit_local_set(buf, idx_l)
        emit_block_i64(buf)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, idx_l)
        emit_local_get(buf, cnt_l)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        emit_local_get(buf, map_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, idx_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_i64_load(buf, 3, 8)
        emit_local_get(buf, key_l)
        emit_call(buf, eq_fi)
        emit_i32_wrap_i64(buf)
        emit_if_void(buf)
        emit_i64_const(buf, 1)
        emit_br(buf, 3)
        emit_end(buf)
        emit_local_get(buf, idx_l)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, idx_l)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_i64_const(buf, 0)
        emit_end(buf)
        nl + 4
      }
      else if fname == "Map::keys" {
        let (arr_new_fi, _, _) = resolve_func(ctx.func_table, "array_new")
        let (arr_push_fi, _, _) = resolve_func(ctx.func_table, "Array::push")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        let map_l = nl
        let res_l = nl + 1
        let cnt_l = nl + 2
        let i_l = nl + 3
        Array::push(local_names, "__keys_map")
        Array::push(local_names, "__keys_res")
        Array::push(local_names, "__keys_cnt")
        Array::push(local_names, "__keys_i")
        emit_local_set(buf, map_l)
        emit_call(buf, arr_new_fi)
        emit_local_set(buf, res_l)
        emit_local_get(buf, map_l)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, cnt_l)
        emit_i64_const(buf, 0)
        emit_local_set(buf, i_l)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, i_l)
        emit_local_get(buf, cnt_l)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        emit_local_get(buf, res_l)
        emit_local_get(buf, map_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, i_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_i64_load(buf, 3, 8)
        emit_call(buf, arr_push_fi)
        emit_local_get(buf, i_l)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, i_l)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_local_get(buf, res_l)
        nl + 4
      }
      else if fname == "String::join" || fname == "String::ends_with" || fname == "String::last_index_of" || fname == "String::starts_with" || fname == "String::contains" || fname == "String::index_of" || fname == "FixedArray::make" || fname == "FixedArray::length" || fname == "FixedArray::get" || fname == "FixedArray::set" || fname == "FixedArray::unsafe_set" || fname == "FixedArray::blit" || fname == "StringBuilder::new" || fname == "StringBuilder::push" || fname == "StringBuilder::freeze" || fname == "assert" || fname == "assert_true" || fname == "assert_eq" || fname == "println" || fname == "print" {
        throw(String::concat("GC codegen: unimplemented builtin: ", fname))
      }
      else {
        let fn_len2 = Array::length(ctx.func_table.names)
        let mut fn_idx_in_list = -1
        let mut __fi = 0
        while __fi < fn_len2 {
          if Array::get(ctx.func_table.names, __fi) == fname {
            fn_idx_in_list = __fi
            __fi = fn_len2
          } else {
            __fi = __fi + 1
          }
        }
        if fn_idx_in_list >= 0 {
          let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)
          let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)
          let mut nl = next_local
          let mut ci = 0
          while ci < Array::length(args) {
            nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
            ci = ci + 1
          }
          if ctx.func_offset > 0 {
            if fidx >= ctx.func_offset {
              emit_i64_const(buf, 0)
            }
          }
          emit_call(buf, fidx)
          if has_ret == 0 {
            emit_i64_const(buf, 0)
          }
          nl
        } else {
          let local_idx2 = resolve_local(local_names, fname, "gc_call")
          let num_args = Array::length(args)
          let fn_val_local = next_local
          let slot_local = next_local + 1
          let env_local = next_local + 2
          let mut nl = next_local + 3
          Array::push(local_names, "__fn_val")
          Array::push(local_names, "__slot")
          Array::push(local_names, "__env")
          emit_local_get(buf, local_idx2)
          emit_local_set(buf, fn_val_local)
          emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
          let mut ci = 0
          while ci < num_args {
            nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
            ci = ci + 1
          }
          emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)
          nl
        }
      }
    },
    _ => {
      let num_args = Array::length(args)
      let fn_val_local = next_local
      let slot_local = next_local + 1
      let env_local = next_local + 2
      let mut nl = next_local + 3
      Array::push(local_names, "__fn_val")
      Array::push(local_names, "__slot")
      Array::push(local_names, "__env")
      nl = ce(buf, callee, local_names, nl, ld)
      emit_local_set(buf, fn_val_local)
      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
      let mut ci = 0
      while ci < num_args {
        nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
        ci = ci + 1
      }
      emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)
      nl
    }
  }
}

//# Misc

export {
  compile_call_gc
}
