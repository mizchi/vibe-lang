        emit_i32_wrap_i64(buf)
        emit_local_get(buf, mc_l)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_add(buf)
        emit_local_get(buf, mk_l)
        emit_i64_store(buf, 3, 8)
