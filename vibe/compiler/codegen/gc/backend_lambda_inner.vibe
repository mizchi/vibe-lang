//# Imports

import .. / .. / core {
  Expr, TypeExpr, bytebuf_new
}

import .. / common_base {
  CompileCtxGc, emit_i64_load
}

import .. / common_extractors {
  array_contains_str
}

import .. / wasm_emit {
  emit_i32_wrap_i64, emit_local_get, emit_local_set
}

import ./backend_lambda_ctx.vibe {
  make_lambda_ctx_gc
}

import ./backend_lambda_sig.vibe {
  CompileLambdaGcFn
}

//# Functions

export let compile_lambda_inner_gc = (params: Array[(String, Option[TypeExpr])], fn_body: Expr, captures: Array[String], user_params: Int, ctx: CompileCtxGc, compile_fn: CompileLambdaGcFn, ld: Int) -> (Bytes, Int)with { Error } {
  let lam_buf = bytebuf_new()
  let lam_locals = Array::slice([
    ""
  ], 0, 0)
  let mut lpi = 0
  while lpi < user_params {
    let (lpname, _) = Array::get(params, lpi)
    Array::push(lam_locals, lpname)
    lpi = lpi + 1
  }
  Array::push(lam_locals, "__env")
  let env_param_idx = user_params
  let lam_nl_start = user_params + 1
  let lam_ref_cells = Array::slice([
    ""
  ], 0, 0)
  let lam_ref_local_indices = Array::slice([
    0
  ], 0, 0)
  let num_captures = Array::length(captures)
  let mut ci3 = 0
  let mut lam_nl = lam_nl_start
  while ci3 < num_captures {
    let cap_local = lam_nl
    let cap_name = Array::get(captures, ci3)
    emit_local_get(lam_buf, env_param_idx)
    emit_i32_wrap_i64(lam_buf)
    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)
    emit_local_set(lam_buf, cap_local)
    Array::push(lam_locals, cap_name)
    if array_contains_str(ctx.ref_cell_names, cap_name) {
      Array::push(lam_ref_cells, cap_name)
    }
    lam_nl = lam_nl + 1
    ci3 = ci3 + 1
  }
  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)
  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)
  (lam_buf, final_lam_nl)
}
