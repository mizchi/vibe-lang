//# Imports

import .. / common_base {
  CompileCtxGc, LambdaTable
}

//# Functions

export let record_lambda_meta_gc: (CompileCtxGc, Bytes, Int, Array[String], Int) -> Int = (ctx, lam_buf, user_params, captures, final_lam_nl) -> {
  let lambda_table = ctx.lambda_table
  let lambda_idx = Array::length(lambda_table.bodies)
  Array::push(lambda_table.bodies, lam_buf)
  Array::push(lambda_table.param_counts, user_params + 1)
  Array::push(lambda_table.captures, captures)
  let mut extra_lam = 0
  let min_lam_nl = user_params + 1
  if final_lam_nl > min_lam_nl {
    extra_lam = final_lam_nl - min_lam_nl
  }
  Array::push(lambda_table.meta_i32, 0)
  Array::push(lambda_table.meta_i64, extra_lam)
  lambda_idx
}
