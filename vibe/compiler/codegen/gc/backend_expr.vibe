//# Functions

// #672 (wasm-gc port): structural `==`/`!=` for aggregate operands. The gc
// backend stores tuples/structs/ctors in linear memory with the SAME layout as
// the linear backend (tuple element i at ptr+i*8, value = raw pointer; ctor
// value = ptr|1, tag i32 at +0, field i at +8+i*8), so the structural compare
// logic is identical to compile_expr.vibe. Without this, `==` on aggregates
// compiled to a raw pointer i64.eq and was always false for distinct-but-equal
// values (the same silent miscompile #672 fixed on the linear backend). The gc
// `eq` builtin is inlined (no callable function to target), so scalar element
// comparison is inlined here too (i64.eq fast path, String::equals fallback).

// Tracker index for a local SLOT (scan from the end so a shadowing rebind wins).
let agg_tuple_index_of_slot_gc: (CompileCtxGc, Int) -> Int = (ctx, slot) -> {
  let n = Array::length(ctx.agg_tuple_slots)
  let mut i = n - 1
  let mut found = 0 - 1
  while i >= 0 {
    if found < 0 && Array::get(ctx.agg_tuple_slots, i) == slot {
      found = i
    } else {
      ()
    }
    i = i - 1
  }
  found
}

// Tracker index of an `EIdent` operand (name -> local slot -> index), or -1.
let eident_tuple_index_gc: (CompileCtxGc, Array[String], Expr) -> Int = (ctx, local_names, e) -> {
  if is_eident(e) {
    let name = get_eident_name(e)
    let ln = Array::length(local_names)
    let mut i = ln - 1
    let mut slot = 0 - 1
    while i >= 0 {
      if slot < 0 && Array::get(local_names, i) == name {
        slot = i
      } else {
        ()
      }
      i = i - 1
    }
    if slot >= 0 {
      agg_tuple_index_of_slot_gc(ctx, slot)
    } else {
      0 - 1
    }
  } else {
    0 - 1
  }
}

// Tracker index of a tracked aggregate operand in `lhs == rhs` (either side), -1.
let both_var_agg_index_gc: (CompileCtxGc, Array[String], Expr, Expr) -> Int = (ctx, local_names, lhs, rhs) -> {
  let la = eident_tuple_index_gc(ctx, local_names, lhs)
  if la != 0 - 1 {
    la
  } else {
    eident_tuple_index_gc(ctx, local_names, rhs)
  }
}

// Two scalar i64 operands are on the stack (a pushed first, then b). Replace
// them with a content-equality i64 0/1: i64.eq fast path, else String::equals
// (mirrors the inlined gc `eq` builtin). Spills to two fresh locals; returns the
// new high-water next_local.
let emit_scalar_eq_gc: (Bytes, Array[String], Int, CompileCtxGc) -> Int with { Error } = (buf, local_names, nl0, ctx) -> {
  let (str_eq_idx, _, _) = resolve_func(ctx.func_table, "String::equals")
  let a = nl0
  Array::push(local_names, "__sea")
  let b = nl0 + 1
  Array::push(local_names, "__seb")
  emit_local_set(buf, b)
  emit_local_set(buf, a)
  emit_local_get(buf, a)
  emit_local_get(buf, b)
  emit_i64_eq(buf)
  emit_if_i64(buf)
  emit_i64_const(buf, 1)
  emit_else(buf)
  emit_local_get(buf, a)
  emit_local_get(buf, b)
  emit_call(buf, str_eq_idx)
  emit_end(buf)
  nl0 + 2
}

// Recursive structural equality driven by a SHAPE expression (a tuple or ctor
// literal). The two values are in local slots `asl`/`bsl` (pointers for
// aggregates). Leaves a single i64 0/1 on the stack; returns the high-water
// next_local. Aggregate elements recurse; scalar elements use emit_scalar_eq_gc.
let rec emit_eq_shaped_slots_gc: (Bytes, Expr, Int, Int, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, shape, asl, bsl, local_names, nl0, ctx, ld, ce) -> {
  if is_etuple(shape) {
    let elems = get_etuple_elems(shape)
    let num = Array::length(elems)
    emit_i64_const(buf, 1)
    let mut nl = nl0
    let mut i = 0
    while i < num {
      let el = Array::get(elems, i)
      if is_etuple(el) || is_ctor_call(el, ctx.ctor_table) {
        let na = nl
        Array::push(local_names, "__rsa")
        let nb = nl + 1
        Array::push(local_names, "__rsb")
        emit_local_get(buf, asl)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, i * 8)
        emit_local_set(buf, na)
        emit_local_get(buf, bsl)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, i * 8)
        emit_local_set(buf, nb)
        nl = emit_eq_shaped_slots_gc(buf, el, na, nb, local_names, nl + 2, ctx, ld, ce)
        emit_i64_and(buf)
      } else {
        emit_local_get(buf, asl)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, i * 8)
        emit_local_get(buf, bsl)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, i * 8)
        nl = emit_scalar_eq_gc(buf, local_names, nl, ctx)
        emit_i64_and(buf)
      }
      i = i + 1
    }
    nl
  } else if is_ctor_call(shape, ctx.ctor_table) {
    let args = get_ecall_args(shape)
    let fc = Array::length(args)
    let ap = nl0
    Array::push(local_names, "__rca")
    let bp = nl0 + 1
    Array::push(local_names, "__rcb")
    emit_local_get(buf, asl)
    emit_i64_const(buf, 0 - 2)
    emit_i64_and(buf)
    emit_local_set(buf, ap)
    emit_local_get(buf, bsl)
    emit_i64_const(buf, 0 - 2)
    emit_i64_and(buf)
    emit_local_set(buf, bp)
    emit_local_get(buf, ap)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_local_get(buf, bp)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i32_eq(buf)
    emit_if_i64(buf)
    emit_i64_const(buf, 1)
    let mut nl = nl0 + 2
    let mut i = 0
    while i < fc {
      let el = Array::get(args, i)
      if is_etuple(el) || is_ctor_call(el, ctx.ctor_table) {
        let na = nl
        Array::push(local_names, "__rfa")
        let nb = nl + 1
        Array::push(local_names, "__rfb")
        emit_local_get(buf, ap)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + i * 8)
        emit_local_set(buf, na)
        emit_local_get(buf, bp)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + i * 8)
        emit_local_set(buf, nb)
        nl = emit_eq_shaped_slots_gc(buf, el, na, nb, local_names, nl + 2, ctx, ld, ce)
        emit_i64_and(buf)
      } else {
        emit_local_get(buf, ap)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + i * 8)
        emit_local_get(buf, bp)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + i * 8)
        nl = emit_scalar_eq_gc(buf, local_names, nl, ctx)
        emit_i64_and(buf)
      }
      i = i + 1
    }
    emit_else(buf)
    emit_i64_const(buf, 0)
    emit_end(buf)
    nl
  } else {
    emit_local_get(buf, asl)
    emit_local_get(buf, bsl)
    emit_scalar_eq_gc(buf, local_names, nl0, ctx)
  }
}

// Top-level wrapper: evaluate `lhs`/`rhs` into pointer locals, then structurally
// compare them per `shape` (a tuple/ctor literal). Used by the literal `==` path
// and the both-non-literal path (shape from the tracked binding).
let emit_eq_shaped_gc: (Bytes, Expr, Expr, Expr, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, shape, lhs, rhs, local_names, next_local, ctx, ld, ce) -> {
  let aptr = next_local
  Array::push(local_names, "__seqa")
  let bptr = next_local + 1
  Array::push(local_names, "__seqb")
  let nl1 = ce(buf, lhs, local_names, next_local + 2, ld)
  emit_local_set(buf, aptr)
  let nl2 = ce(buf, rhs, local_names, nl1, ld)
  emit_local_set(buf, bptr)
  emit_eq_shaped_slots_gc(buf, shape, aptr, bptr, local_names, nl2, ctx, ld, ce)
}

// Nullary constructor equality (`Red == Red`): gc heap-allocates nullary ctors
// (value = ptr|1, tag i32 at +0), so a raw pointer compare is wrong — untag both
// and compare the runtime tags. Leaves i64 0/1.
let emit_nullary_ctor_eq_gc: (Bytes, Expr, Expr, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, local_names, next_local, ctx, ld, ce) -> {
  let aptr = next_local
  Array::push(local_names, "__ceqa")
  let bptr = next_local + 1
  Array::push(local_names, "__ceqb")
  let nl1 = ce(buf, lhs, local_names, next_local + 2, ld)
  emit_i64_const(buf, 0 - 2)
  emit_i64_and(buf)
  emit_local_set(buf, aptr)
  let nl2 = ce(buf, rhs, local_names, nl1, ld)
  emit_i64_const(buf, 0 - 2)
  emit_i64_and(buf)
  emit_local_set(buf, bptr)
  emit_local_get(buf, aptr)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_local_get(buf, bptr)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_eq(buf)
  emit_i64_extend_i32_s(buf)
  nl2
}

// Emit the equality test for `lhs == rhs`, leaving a raw i64 0/1 (1 = equal).
// Routes through the structural comparators when an operand is a tuple / ctor
// literal or a tracked aggregate variable; else the scalar `==` (i64.eq +
// String::equals fallback, via emit_binop_op). Every gc `==`/`!=` site calls
// this so structural equality is consistent.
let emit_eq_value_gc: (Bytes, Expr, Expr, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, local_names, next_local, ctx, ld, ce) -> {
  if is_etuple(lhs) || is_etuple(rhs) {
    let tlit = if is_etuple(lhs) {
      lhs
    } else {
      rhs
    }
    emit_eq_shaped_gc(buf, tlit, lhs, rhs, local_names, next_local, ctx, ld, ce)
  } else if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) || is_ctor_call(rhs, ctx.ctor_table) || is_nullary_ctor_ident(rhs, ctx.ctor_table) {
    let clit = if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) {
      lhs
    } else {
      rhs
    }
    if is_ctor_call(clit, ctx.ctor_table) {
      emit_eq_shaped_gc(buf, clit, lhs, rhs, local_names, next_local, ctx, ld, ce)
    } else {
      emit_nullary_ctor_eq_gc(buf, lhs, rhs, local_names, next_local, ctx, ld, ce)
    }
  } else {
    let idx = both_var_agg_index_gc(ctx, local_names, lhs, rhs)
    if idx >= 0 {
      emit_eq_shaped_gc(buf, Array::get(ctx.agg_tuple_exprs, idx), lhs, rhs, local_names, next_local, ctx, ld, ce)
    } else {
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      emit_binop_op(buf, "==")
      nl2
    }
  }
}

let rec compile_expr_gc: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {
  let ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error } = (b, e, ln, nl, d) -> {
    compile_expr_gc(b, e, ln, nl, ctx, d)
  }
  match expr {
    EInt(n) => {
      emit_i64_const(buf, n)
      next_local
    },
    EBool(b_val) => {
      emit_i64_const(buf, if b_val {
        1
      } else {
        0
      })
      next_local
    },
    EFloat(v) => {
      let bits = Double::to_i64_bits(v)
      emit_f64_const_bits(buf, bits)
      emit_i64_reinterpret_f64(buf)
      next_local
    },
    EString(s) => {
      let idx = str_table_lookup(ctx.str_table.strs, s)
      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))
      next_local
    },
    EIdent(name, _) => {
      let len = Array::length(local_names)
      let rec try_local: (Int) -> Int = (i) -> {
        if i < 0 {
          -1
        }
        else if Array::get(local_names, i) == name {
          i
        }
        else try_local(i - 1)
      }
      let local_idx = try_local(len - 1)
      if local_idx >= 0 {
        if array_contains_str(ctx.ref_cell_names, name) {
          emit_local_get(buf, local_idx)
          emit_struct_get(buf, ctx.refcell_type_idx, 0)
        } else {
          emit_local_get(buf, local_idx)
        }
        next_local
      } else {
        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)
        if ctor_idx >= 0 {
          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)
          let ptr_l = next_local
          Array::push(local_names, "__ctor_ptr")
          emit_global_get(buf, 0)
          emit_i64_extend_i32_u(buf)
          emit_local_set(buf, ptr_l)
          emit_global_get(buf, 0)
          emit_i32_const(buf, 8)
          emit_i32_add(buf)
          emit_global_set(buf, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, tag_c)
          emit_i32_store(buf, 2, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, 0)
          emit_i32_store(buf, 2, 4)
          emit_local_get(buf, ptr_l)
          emit_i64_const(buf, 1)
          emit_i64_or(buf)
          next_local + 1
        } else {
          let fn_len = Array::length(ctx.func_table.names)
          let mut fni = -1
          let mut __fj = 0
          while __fj < fn_len {
            if Array::get(ctx.func_table.names, __fj) == name {
              fni = __fj
              __fj = fn_len
            } else {
              __fj = __fj + 1
            }
          }
          if fni < 0 {
            throw(String::concat("undefined variable: ", name))
          }
          let fidx = Array::get(ctx.func_table.indices, fni)
          let table_slot = fidx - ctx.func_offset
          emit_i64_const(buf, (table_slot<<2)|2)
          next_local
        }
      }
    },
    EBinOp(op, lhs, rhs) => if op == "==" {
      // #672: structural equality for aggregate operands (else scalar i64.eq).
      emit_eq_value_gc(buf, lhs, rhs, local_names, next_local, ctx, ld, ce)
    } else if op == "!=" {
      let nle = emit_eq_value_gc(buf, lhs, rhs, local_names, next_local, ctx, ld, ce)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      nle
    } else {
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      emit_binop_op(buf, op)
      nl2
    },
    EUnaryOp(op, operand) => if op == "-" {
      emit_i64_const(buf, 0)
      let nl = ce(buf, operand, local_names, next_local, ld)
      emit_i64_sub(buf)
      nl
    } else if op == "!" {
      let nl = ce(buf, operand, local_names, next_local, ld)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      nl
    } else {
      throw(String::concat("unsupported unary op: ", op))
    }
    ,
    EIf(cond, then_e, else_e) => {
      let nl1 = match cond {
        EBinOp(cop, clhs, crhs) => if cop == "==" {
          // #672: structural equality in an `if` condition.
          let cnl = emit_eq_value_gc(buf, clhs, crhs, local_names, next_local, ctx, ld, ce)
          emit_i32_wrap_i64(buf)
          cnl
        } else if cop == "!=" {
          let cnl = emit_eq_value_gc(buf, clhs, crhs, local_names, next_local, ctx, ld, ce)
          emit_i32_wrap_i64(buf)
          emit_i32_eqz(buf)
          cnl
        } else if cop == "<" || cop == ">" || cop == "<=" || cop == ">=" {
          let cnl1 = ce(buf, clhs, local_names, next_local, ld)
          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)
          if cop == "<" {
            emit_i64_lt_s(buf)
          }
          else if cop == ">" {
            emit_i64_gt_s(buf)
          }
          else if cop == "<=" {
            emit_i64_le_s(buf)
          }
          else {
            emit_i64_ge_s(buf)
          }
          cnl2
        } else {
          let cnl = ce(buf, cond, local_names, next_local, ld)
          emit_i32_wrap_i64(buf)
          cnl
        },
        EBool(b_val) => {
          emit_i32_const(buf, if b_val {
            1
          } else {
            0
          })
          next_local
        },
        _ => {
          let cnl = ce(buf, cond, local_names, next_local, ld)
          emit_i32_wrap_i64(buf)
          cnl
        }
      }
      emit_if_i64(buf)
      let ld_inner = if ld >= 0 {
        ld + 1
      } else {
        -1
      }
      let names_len_before = Array::length(local_names)
      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)
      emit_else(buf)
      Array::truncate(local_names, names_len_before)
      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)
      emit_end(buf)
      Array::truncate(local_names, names_len_before)
      let max_nl = if nl_then > nl_else {
        nl_then
      } else {
        nl_else
      }
      while Array::length(local_names) < max_nl {
        Array::push(local_names, "")
      }
      max_nl
    },
    ECall(callee, args, _) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),
    ELet(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      // #672: record an aggregate `let x = <tuple/payload-ctor literal>` binding's
      // slot + the literal shape, so a later `x == y` (neither operand a literal)
      // can drive the recursive structural compare. Nullary ctors are left
      // untracked (mirrors the linear backend).
      if is_etuple(value) {
        Array::push(ctx.agg_tuple_slots, local_idx)
        Array::push(ctx.agg_tuple_exprs, value)
      } else if is_ctor_call(value, ctx.ctor_table) {
        if Array::length(get_ecall_args(value)) > 0 {
          Array::push(ctx.agg_tuple_slots, local_idx)
          Array::push(ctx.agg_tuple_exprs, value)
        } else {
          ()
        }
      } else {
        ()
      }
      ce(buf, body, local_names, nl, ld)
    },
    ELetRec(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      match value {
        EFn(_, _, params, _, _, fn_body) => {
          let param_names_bp = Array::slice([
            ""
          ], 0, 0)
          let mut bpi = 0
          while bpi < Array::length(params) {
            let (pn, _) = Array::get(params, bpi)
            Array::push(param_names_bp, pn)
            bpi = bpi + 1
          }
          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))
          let mut self_cap_idx = -1
          let mut bci = 0
          while bci < Array::length(caps) {
            if Array::get(caps, bci) == name {
              self_cap_idx = bci
            }
            bci = bci + 1
          }
          if self_cap_idx >= 0 {
            emit_local_get(buf, local_idx)
            emit_i64_const(buf, -4)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_local_get(buf, local_idx)
            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
          }
          0
        },
        _ => 0
      }
      ce(buf, body, local_names, nl, ld)
    },
    ELetMut(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      if is_mut_captured_in(body, name) {
        Array::push(ctx.ref_cell_names, name)
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_struct_new(buf, ctx.refcell_type_idx)
        emit_local_set(buf, local_idx)
        Array::push(ctx.ref_local_indices, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      } else {
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_local_set(buf, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      }
    },
    EAssign(name, value, body) => {
      let idx = resolve_local(local_names, name, "gc_var")
      if array_contains_str(ctx.ref_cell_names, name) {
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_struct_set(buf, ctx.refcell_type_idx, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    EAssignOp(name, op, value, body) => {
      let idx = resolve_local(local_names, name, "gc_var")
      if array_contains_str(ctx.ref_cell_names, name) {
        emit_local_get(buf, idx)
        emit_local_get(buf, idx)
        emit_struct_get(buf, ctx.refcell_type_idx, 0)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_struct_set(buf, ctx.refcell_type_idx, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    ESeq(first, second) => {
      let nl_s = ce(buf, first, local_names, next_local, ld)
      emit_drop(buf)
      ce(buf, second, local_names, nl_s, ld)
    },
    ETuple(elems) => {
      let num_elems = Array::length(elems)
      let alloc_size = num_elems * 8
      let ptr_local = next_local
      Array::push(local_names, "__tuple_ptr")
      let mut nl = next_local + 1
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      emit_local_get(buf, ptr_local)
      nl
    },
    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),
    EArray(elems) => {
      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, "array_new")
      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
      let arr_local = next_local
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < Array::length(elems) {
        emit_local_get(buf, arr_local)
        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
    },
    EForIn(var_name, index_name, iter_expr, body) => {
      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
      let arr_local = next_local
      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "__for_arr")
      let i_local = nl1
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_local)
      Array::push(local_names, "__for_i")
      let nl2 = nl1 + 1
      emit_block_void(buf)
      emit_loop_void(buf)
      emit_local_get(buf, i_local)
      emit_local_get(buf, arr_local)
      emit_call(buf, arr_len_idx)
      emit_i64_ge_s(buf)
      emit_br_if(buf, 1)
      let var_local = match index_name {
        Some(_) => nl2 + 1,
        None => nl2
      }
      match index_name {
        Some(index_name) => {
          emit_local_get(buf, i_local)
          emit_local_set(buf, nl2)
          Array::push(local_names, index_name)
        },
        None => ()
      }
      emit_local_get(buf, arr_local)
      emit_local_get(buf, i_local)
      emit_call(buf, arr_get_idx)
      emit_local_set(buf, var_local)
      Array::push(local_names, var_name)
      let nl3 = var_local + 1
      let nl4 = ce(buf, body, local_names, nl3, ld + 1)
      emit_drop(buf)
      emit_local_get(buf, i_local)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_local_set(buf, i_local)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl4
    },
    EWhile(cond, body) => {
      emit_block_void(buf)
      emit_loop_void(buf)
      let nl1 = match cond {
        EBinOp(wcop, wlhs, wrhs) => if wcop == "==" {
          // #672: structural equality in a `while` condition. The br_if break
          // condition is "cond is false", i.e. not-equal.
          let wnl = emit_eq_value_gc(buf, wlhs, wrhs, local_names, next_local, ctx, ld + 1, ce)
          emit_i32_wrap_i64(buf)
          emit_i32_eqz(buf)
          wnl
        } else if wcop == "!=" {
          // break when equal.
          let wnl = emit_eq_value_gc(buf, wlhs, wrhs, local_names, next_local, ctx, ld + 1, ce)
          emit_i32_wrap_i64(buf)
          wnl
        } else if wcop == "<" || wcop == ">" || wcop == "<=" || wcop == ">=" {
          let wnl1 = ce(buf, wlhs, local_names, next_local, ld + 1)
          let wnl2 = ce(buf, wrhs, local_names, wnl1, ld + 1)
          if wcop == "<" {
            emit_i64_lt_s(buf)
          }
          else if wcop == ">" {
            emit_i64_gt_s(buf)
          }
          else if wcop == "<=" {
            emit_i64_le_s(buf)
          }
          else {
            emit_i64_ge_s(buf)
          }
          emit_i32_eqz(buf)
          wnl2
        } else {
          let wnl = ce(buf, cond, local_names, next_local, ld + 1)
          emit_i64_eqz(buf)
          wnl
        },
        _ => {
          let wnl = ce(buf, cond, local_names, next_local, ld + 1)
          emit_i64_eqz(buf)
          wnl
        }
      }
      emit_br_if(buf, 1)
      let nl2 = ce(buf, body, local_names, nl1, ld + 1)
      emit_drop(buf)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl2
    },
    EBreak(_) => {
      emit_br(buf, ld + 1)
      emit_i64_const(buf, 0)
      next_local
    },
    EContinue(_) => {
      emit_br(buf, ld)
      emit_i64_const(buf, 0)
      next_local
    },
    EUnit => {
      emit_i64_const(buf, 0)
      next_local
    },
    EReturn(ret_expr) => {
      let nl = ce(buf, ret_expr, local_names, next_local, ld)
      emit_return(buf)
      nl
    },
    EFn(_, _, params, _, _, fn_body) =>
    compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),
    EDot(obj, field, _) => {
      let rec find_struct_field_idx: (Int) -> Int = (si2) -> {
        if si2 >= Array::length(ctx.ctor_table.struct_names) {
          -1
        }
        else {
          let fnames = Array::get(ctx.ctor_table.struct_field_names, si2)
          let rec find_f: (Int) -> Int = (fi) -> {
            if fi >= Array::length(fnames) {
              -1
            }
            else if Array::get(fnames, fi) == field {
              fi
            }
            else find_f(fi + 1)
          }
          let idx = find_f(0)
          if idx >= 0 {
            idx
          }
          else find_struct_field_idx(si2 + 1)
        }
      }
      let field_idx = find_struct_field_idx(0)
      if field_idx < 0 {
        throw(String::concat("unknown struct field: ", field))
      }
      let nl1 = ce(buf, obj, local_names, next_local, ld)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 8 + field_idx * 8)
      nl1
    },
    ERecord(fields) => {
      let flen = Array::length(fields)
      let obj_size = 8 + flen * 8
      let ptr_local = next_local
      Array::push(local_names, "__rec_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 0)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, flen)
      emit_i32_store(buf, 2, 4)
      let mut nl_r = next_local + 1
      let mut ri = 0
      while ri < flen {
        let (_, fexpr) = Array::get(fields, ri)
        nl_r = ce(buf, fexpr, local_names, nl_r, ld)
        let val_local = nl_r
        Array::push(local_names, "__rec_val")
        emit_local_set(buf, val_local)
        nl_r = nl_r + 1
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + ri * 8)
        ri = ri + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl_r
    },
    EHandle(body, _) => ce(buf, body, local_names, next_local, ld),
    EStringInterp(_) => throw("GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)"),
    _ => throw("unsupported expression in gc codegen")
  }
}

//# Misc

export {
  compile_expr_gc
}
