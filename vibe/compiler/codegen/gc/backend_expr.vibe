// AST-to-WASM codegen (wasm-gc backend)
// Uses GC struct types for ref cells instead of linear memory bump allocation.
// Closures use table-based call_indirect (same as linear memory backend).

import ../../core/index.vibe {
  Expr, Pat, Stmt, TypeExpr,
  bytebuf_new, bytebuf_push, bytebuf_length,
  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,
  leb128_encode_u32, leb128_encode_s64
}

import ../wasm_emit/index.vibe {
  emit_header,
  emit_type_section, emit_type_section_multi,
  emit_function_section, emit_export_section, emit_export_section_multi,
  emit_code_section, emit_code_section_with_locals,
  emit_name, emit_func_type_raw,
  emit_import_section_func, emit_memory_section,
  emit_exports_with_memory, emit_data_section, emit_data_section_multi,
  emit_local_get, emit_local_set, emit_local_tee,
  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,
  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,
  emit_i64_shl, emit_i64_shr_s,
  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,
  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,
  emit_i64_extend_i32_s, emit_i32_wrap_i64,
  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,
  emit_i32_store8, emit_i32_load8_u,
  emit_call, emit_drop, emit_return,
  emit_block_void, emit_block_i64, emit_loop_void,
  emit_if_void, emit_if_i64, emit_else, emit_end,
  emit_br, emit_br_if,
  emit_global_section_i32_mut, emit_global_get, emit_global_set,
  string_to_data,
  emit_f64_const_bits, emit_f64_add, emit_f64_sub, emit_f64_mul, emit_f64_div,
  emit_f64_eq, emit_f64_ne, emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge,
  emit_f64_neg, emit_i64_reinterpret_f64, emit_f64_reinterpret_i64,
  emit_i64_trunc_f64_s, emit_f64_convert_i64_s,
  emit_call_indirect, emit_table_section_funcref, emit_element_section_active,
  emit_struct_type_raw, emit_struct_new, emit_struct_get, emit_struct_set
}

import ../common_base/index.vibe {
  emit_i32_sub, emit_i32_mul, emit_i32_ne, emit_i32_eq, emit_i32_ge_u, emit_i32_eqz, emit_i64_store, emit_i64_load, resolve_local, resolve_func, FuncTable, StrTable, LambdaTable, CtorTable, CompileCtxGc, emit_str_ref, find_func_stmt, lookup_ctor, emit_binop_op
}

import ../common_extractors/index.vibe {
  emit_memory_copy, array_contains_str, str_table_lookup, find_catchall_idx, emit_assignop_op
}

import ../common_analysis/index.vibe {
  emit_i64_extend_i32_u, collect_strings_stmts, collect_free_vars, is_mut_captured_in, emit_closure_resolve, emit_closure_call_tail
}

import ./backend_builtins.vibe {
  gen_print_i64_body, gen_print_str_body, gen_str_len_body, gen_str_eq_body,
  gen_str_concat_body, gen_arr_new_body, gen_arr_len_body, gen_arr_get_body,
  gen_arr_push_body, gen_arr_set_body, gen_str_char_code_at_body,
  gen_str_from_char_code_body, gen_str_substring_body, gen_double_to_int_body,
  gen_int_to_double_body, gen_identity_body
}

import ./backend_call.vibe {
  compile_call_gc
}

import ./backend_match.vibe {
  compile_match_gc
}

import ./backend_lambda_body.vibe {
  compile_lambda_gc
}

// === Expression compiler (GC backend) ===

let rec compile_expr_gc = (
  buf: Bytes,
  expr: Expr,
  local_names: Array[String],
  next_local: Int,
  ctx: CompileCtxGc,
  ld: Int
) -> Int with { Error } {
  // shorthand for recursive call
  let ce = (b: Bytes, e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {
    compile_expr_gc(b, e, ln, nl, ctx, d)
  }
  match expr {
    EInt(n) => {
      emit_i64_const(buf, n)
      next_local
    },
    EBool(b_val) => {
      emit_i64_const(buf, if b_val { 1 } else { 0 })
      next_local
    },
    EFloat(v) => {
      let bits = Double::to_i64_bits(v)
      emit_f64_const_bits(buf, bits)
      emit_i64_reinterpret_f64(buf)
      next_local
    },
    EString(s) => {
      let idx = str_table_lookup(ctx.str_table.strs, s)
      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))
      next_local
    },
    EIdent(name) => {
      // Try local first
      let len = Array::length(local_names)
      let rec try_local = (i: Int) -> Int {
        if i < 0 { -1 }
        else if Array::get(local_names, i) == name { i }
        else try_local(i - 1)
      }
      let local_idx = try_local(len - 1)
      if local_idx >= 0 {
        if array_contains_str(ctx.ref_cell_names, name) {
          // Ref cell: local holds (ref $RefCell), read via struct.get
          emit_local_get(buf, local_idx)
          emit_struct_get(buf, ctx.refcell_type_idx, 0)
        } else {
          emit_local_get(buf, local_idx)
        }
        next_local
      } else {
        // Check if it's a 0-arg enum constructor
        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)
        if ctor_idx >= 0 {
          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)
          let ptr_l = next_local
          Array::push(local_names, "__ctor_ptr")
          emit_global_get(buf, 0)
          emit_i64_extend_i32_u(buf)
          emit_local_set(buf, ptr_l)
          emit_global_get(buf, 0)
          emit_i32_const(buf, 8)
          emit_i32_add(buf)
          emit_global_set(buf, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, tag_c)
          emit_i32_store(buf, 2, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, 0)
          emit_i32_store(buf, 2, 4)
          emit_local_get(buf, ptr_l)
          emit_i64_const(buf, 1)
          emit_i64_or(buf)
          next_local + 1
        } else {
        // Check if it's a top-level function — emit as bare fn value
        let fn_len = Array::length(ctx.func_table.names)
        let mut fni = -1
        let mut __fj = 0
        while __fj < fn_len {
          if Array::get(ctx.func_table.names, __fj) == name {
            fni = __fj
            __fj = fn_len
          } else {
            __fj = __fj + 1
          }
        }
        if fni < 0 { throw(String::concat("undefined variable: ", name)) }
        let fidx = Array::get(ctx.func_table.indices, fni)
        let table_slot = fidx - ctx.func_offset
        emit_i64_const(buf, (table_slot << 2) | 2)
        next_local
        }
      }
    },
    EBinOp(op, lhs, rhs) => {
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      emit_binop_op(buf, op)
      nl2
    },
    EUnaryOp(op, operand) => {
      if op == "-" {
        emit_i64_const(buf, 0)
        let nl = ce(buf, operand, local_names, next_local, ld)
        emit_i64_sub(buf)
        nl
      } else if op == "!" {
        let nl = ce(buf, operand, local_names, next_local, ld)
        // Bool: true=1, false=0. Use eqz to negate.
        emit_i64_eqz(buf)
        emit_i64_extend_i32_s(buf)
        nl
      } else {
        throw(String::concat("unsupported unary op: ", op))
      }
    },
    EIf(cond, then_e, else_e) => {
      let nl1 = match cond {
        EBinOp(cop, clhs, crhs) => if cop == "==" || cop == "!=" || cop == "<" || cop == ">" || cop == "<=" || cop == ">=" {
          let cnl1 = ce(buf, clhs, local_names, next_local, ld)
          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)
          if cop == "==" { emit_i64_eq(buf) }
          else if cop == "!=" { emit_i64_ne(buf) }
          else if cop == "<" { emit_i64_lt_s(buf) }
          else if cop == ">" { emit_i64_gt_s(buf) }
          else if cop == "<=" { emit_i64_le_s(buf) }
          else { emit_i64_ge_s(buf) }
          cnl2
        } else {
          let cnl = ce(buf, cond, local_names, next_local, ld)
          emit_i32_wrap_i64(buf)
          cnl
        },
        EBool(b_val) => {
          emit_i32_const(buf, if b_val { 1 } else { 0 })
          next_local
        },
        _ => {
          let cnl = ce(buf, cond, local_names, next_local, ld)
          emit_i32_wrap_i64(buf)
          cnl
        }
      }
      emit_if_i64(buf)
      let ld_inner = if ld >= 0 { ld + 1 } else { -1 }
      let names_len_before = Array::length(local_names)
      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)
      emit_else(buf)
      Array::truncate(local_names, names_len_before)
      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)
      emit_end(buf)
      Array::truncate(local_names, names_len_before)
      let max_nl = if nl_then > nl_else { nl_then } else { nl_else }
      while Array::length(local_names) < max_nl {
        Array::push(local_names, "")
      }
      max_nl
    },
    ECall(callee, args) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),
    ELet(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      ce(buf, body, local_names, nl, ld)
    },
    ELetRec(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      // Backpatch self-reference in closure for recursive let rec
      match value {
        EFn(_, _, params, _, _, fn_body) => {
          let param_names_bp = Array::slice([""], 0, 0)
          let mut bpi = 0
          while bpi < Array::length(params) {
            let (pn, _) = Array::get(params, bpi)
            Array::push(param_names_bp, pn)
            bpi = bpi + 1
          }
          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))
          let mut self_cap_idx = -1
          let mut bci = 0
          while bci < Array::length(caps) {
            if Array::get(caps, bci) == name {
              self_cap_idx = bci
            }
            bci = bci + 1
          }
          if self_cap_idx >= 0 {
            emit_local_get(buf, local_idx)
            emit_i64_const(buf, -4)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_local_get(buf, local_idx)
            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
          }
          0
        },
        _ => 0
      }
      ce(buf, body, local_names, nl, ld)
    },
    ELetMut(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      if is_mut_captured_in(body, name) {
        // Mutable captured: allocate GC ref cell via struct.new
        Array::push(ctx.ref_cell_names, name)
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_struct_new(buf, ctx.refcell_type_idx)
        emit_local_set(buf, local_idx)
        Array::push(ctx.ref_local_indices, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      } else {
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_local_set(buf, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      }
    },
    EAssign(name, value, body) => {
      let idx = resolve_local(local_names, name, "gc_var")
      if array_contains_str(ctx.ref_cell_names, name) {
        // Ref cell: struct.set
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_struct_set(buf, ctx.refcell_type_idx, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    EAssignOp(name, op, value, body) => {
      let idx = resolve_local(local_names, name, "gc_var")
      if array_contains_str(ctx.ref_cell_names, name) {
        // Ref cell: read via struct.get, compute, write via struct.set
        emit_local_get(buf, idx)   // ref on stack (for struct.set later)
        emit_local_get(buf, idx)   // ref on stack (for struct.get)
        emit_struct_get(buf, ctx.refcell_type_idx, 0)  // current value
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_struct_set(buf, ctx.refcell_type_idx, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    ESeq(first, second) => {
      let nl_s = ce(buf, first, local_names, next_local, ld)
      emit_drop(buf)
      ce(buf, second, local_names, nl_s, ld)
    },
    ETuple(elems) => {
      // Allocate N*8 bytes on heap, store each element as i64
      let num_elems = Array::length(elems)
      let alloc_size = num_elems * 8
      let ptr_local = next_local
      Array::push(local_names, "__tuple_ptr")
      let mut nl = next_local + 1
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      emit_local_get(buf, ptr_local)
      nl
    },
    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),
    EArray(elems) => {
      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, "array_new")
      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
      let arr_local = next_local
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < Array::length(elems) {
        emit_local_get(buf, arr_local)
        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
    },
    EForIn(var_name, index_name, iter_expr, body) => {
      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
      let arr_local = next_local
      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "__for_arr")
      let i_local = nl1
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_local)
      Array::push(local_names, "__for_i")
      let nl2 = nl1 + 1
      emit_block_void(buf)
        emit_loop_void(buf)
          emit_local_get(buf, i_local)
          emit_local_get(buf, arr_local)
          emit_call(buf, arr_len_idx)
          emit_i64_ge_s(buf)
          // S1b: i64_ge_s already leaves i32, skip extend+wrap
          emit_br_if(buf, 1)
          let var_local = match index_name {
            Some(_) => nl2 + 1,
            None => nl2
          }
          match index_name {
            Some(index_name) => {
              emit_local_get(buf, i_local)
              emit_local_set(buf, nl2)
              Array::push(local_names, index_name)
            },
            None => ()
          }
          emit_local_get(buf, arr_local)
          emit_local_get(buf, i_local)
          emit_call(buf, arr_get_idx)
          emit_local_set(buf, var_local)
          Array::push(local_names, var_name)
          let nl3 = var_local + 1
          let nl4 = ce(buf, body, local_names, nl3, ld + 1)
          emit_drop(buf)
          emit_local_get(buf, i_local)
          emit_i64_const(buf, 1)
          emit_i64_add(buf)
          emit_local_set(buf, i_local)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl4
    },
    EWhile(cond, body) => {
      emit_block_void(buf)
        emit_loop_void(buf)
          // S1b: skip extend+wrap for comparison conditions in while
          let nl1 = match cond {
            EBinOp(wcop, wlhs, wrhs) => if wcop == "==" || wcop == "!=" || wcop == "<" || wcop == ">" || wcop == "<=" || wcop == ">=" {
              let wnl1 = ce(buf, wlhs, local_names, next_local, ld + 1)
              let wnl2 = ce(buf, wrhs, local_names, wnl1, ld + 1)
              if wcop == "==" { emit_i64_eq(buf) }
              else if wcop == "!=" { emit_i64_ne(buf) }
              else if wcop == "<" { emit_i64_lt_s(buf) }
              else if wcop == ">" { emit_i64_gt_s(buf) }
              else if wcop == "<=" { emit_i64_le_s(buf) }
              else { emit_i64_ge_s(buf) }
              emit_i32_eqz(buf)
              wnl2
            } else {
              let wnl = ce(buf, cond, local_names, next_local, ld + 1)
              emit_i64_eqz(buf)
              wnl
            },
            _ => {
              let wnl = ce(buf, cond, local_names, next_local, ld + 1)
              emit_i64_eqz(buf)
              wnl
            }
          }
          emit_br_if(buf, 1)
          let nl2 = ce(buf, body, local_names, nl1, ld + 1)
          emit_drop(buf)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl2
    },
    EBreak(_) => {
      emit_br(buf, ld + 1)
      emit_i64_const(buf, 0)
      next_local
    },
    EContinue(_) => {
      emit_br(buf, ld)
      emit_i64_const(buf, 0)
      next_local
    },
    EUnit => {
      emit_i64_const(buf, 0)
      next_local
    },
    EThrow(msg_expr) => {
      let nl = ce(buf, msg_expr, local_names, next_local, ld)
      emit_drop(buf)
      bytebuf_push(buf, 0)  // unreachable
      nl
    },
    EFn(_, _, params, _, _, fn_body) =>
      compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),
    EDot(obj, field) => {
      // Struct field access: find field index from ctx.ctor_table.struct_field_names
      let rec find_struct_field_idx = (si2: Int) -> Int {
        if si2 >= Array::length(ctx.ctor_table.struct_names) { -1 }
        else {
          let fnames = Array::get(ctx.ctor_table.struct_field_names, si2)
          let rec find_f = (fi: Int) -> Int {
            if fi >= Array::length(fnames) { -1 }
            else if Array::get(fnames, fi) == field { fi }
            else find_f(fi + 1)
          }
          let idx = find_f(0)
          if idx >= 0 { idx }
          else find_struct_field_idx(si2 + 1)
        }
      }
      let field_idx = find_struct_field_idx(0)
      if field_idx < 0 {
        throw(String::concat("unknown struct field: ", field))
      }
      let nl1 = ce(buf, obj, local_names, next_local, ld)
      // Untag: ptr & ~1
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      // Load field at offset 8 + field_idx * 8
      emit_i64_load(buf, 3, 8 + field_idx * 8)
      nl1
    },
    ERecord(fields) => {
      // Record literal: heap alloc [tag_i32 | field_count_i32 | fields:.]
      let flen = Array::length(fields)
      let obj_size = 8 + flen * 8
      let ptr_local = next_local
      Array::push(local_names, "__rec_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 0)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, flen)
      emit_i32_store(buf, 2, 4)
      let mut nl_r = next_local + 1
      let mut ri = 0
      while ri < flen {
        let (_, fexpr) = Array::get(fields, ri)
        nl_r = ce(buf, fexpr, local_names, nl_r, ld)
        let val_local = nl_r
        Array::push(local_names, "__rec_val")
        emit_local_set(buf, val_local)
        nl_r = nl_r + 1
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + ri * 8)
        ri = ri + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl_r
    },
    EHandle(body, _) => ce(buf, body, local_names, next_local, ld),
    EStringInterp(_) => throw("GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)"),
    _ => throw("unsupported expression in gc codegen")
  }
}

export {
