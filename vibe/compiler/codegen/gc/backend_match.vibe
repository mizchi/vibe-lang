//# Functions

// The storage index of struct field `field`, mirroring the field-access lookup
// in backend_expr (search the struct-field-name matrix; first struct that
// declares the field wins). A struct lays its fields out like a constructor —
// field i at `8 + i*8`, pointer tag-cleared — so the offset is `8 + index*8`,
// identical to what `obj.field` reads.
let field_index_in_gc: (Array[String], String) -> Int = (fnames, field) -> {
  let mut fi = 0
  let mut found = -1
  while fi < Array::length(fnames) {
    if Array::get(fnames, fi) == field {
      found = fi
      fi = Array::length(fnames)
    } else {
      fi = fi + 1
    }
  }
  found
}

// The index of `field` WITHIN the struct named `sname`. The matched struct name
// MUST drive the lookup: two structs can share a field name at different
// positions (`A { x; y }` vs `B { y; x }`), so a name-agnostic scan binds the
// wrong offset. Falls back to a global first-match scan only when `sname` is
// absent from the table.
let struct_field_index_gc: (CompileCtxGc, String, String) -> Int with { Error } = (ctx, sname, field) -> {
  let names = ctx.ctor_table.struct_names
  let mut si = 0
  let mut sidx = -1
  while si < Array::length(names) {
    if Array::get(names, si) == sname {
      sidx = si
      si = Array::length(names)
    } else {
      si = si + 1
    }
  }
  if sidx >= 0 {
    let found = field_index_in_gc(Array::get(ctx.ctor_table.struct_field_names, sidx), field)
    if found < 0 {
      throw(String::concat(String::concat(String::concat("unknown field `", field), "` in struct "), sname))
    } else {
      found
    }
  } else {
    let mut gsi = 0
    let mut gfound = -1
    while gsi < Array::length(names) {
      let f = field_index_in_gc(Array::get(ctx.ctor_table.struct_field_names, gsi), field)
      if f >= 0 {
        gfound = f
        gsi = Array::length(names)
      } else {
        gsi = gsi + 1
      }
    }
    if gfound < 0 {
      throw(String::concat("unknown struct field in pattern: ", field))
    } else {
      gfound
    }
  }
}

let compile_match_gc: (Bytes, Expr, Array[(Pat, Expr)], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, scrutinee, arms, local_names, next_local, ctx, ld, ce) -> {
  let scrut_local = next_local
  Array::push(local_names, "__match_scrut")
  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)
  emit_local_set(buf, scrut_local)
  let num_arms = Array::length(arms)
  let catchall_idx = find_catchall_idx(arms)
  let num_cond_arms = catchall_idx
  let mut max_nl = nl1
  let mut ai = 0
  while ai < num_cond_arms {
    let (p, _) = Array::get(arms, ai)
    match p {
      PInt(n) => {
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, n)
        emit_i64_eq(buf)
        emit_if_i64(buf)
        0
      },
      PBool(bv) => {
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, if bv {
          1
        } else {
          0
        })
        emit_i64_eq(buf)
        emit_if_i64(buf)
        0
      },
      PCtor(cname_cond, _) => {
        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)
        let expected_tag = if ctor_ci >= 0 {
          Array::get(ctx.ctor_table.tags, ctor_ci)
        } else {
          -1
        }
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i32_const(buf, expected_tag)
        emit_i32_eq(buf)
        emit_if_i64(buf)
        0
      },
      PString(sval) => {
        let str_idx = str_table_lookup(ctx.str_table.strs, sval)
        if str_idx >= 0 {
          emit_local_get(buf, scrut_local)
          emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))
          emit_call(buf, 4)
          emit_i64_const(buf, 1)
          emit_i64_eq(buf)
          emit_if_i64(buf)
        }
        0
      },
      _ => 0
    }
    let names_len_at_arm = Array::length(local_names)
    let (p2, arm_body) = Array::get(arms, ai)
    let ld_arm = if ld >= 0 {
      ld + ai + 1
    } else {
      -1
    }
    match p2 {
      PCtor(_, cargs_bind) => {
        let mut cbi = 0
        while cbi < Array::length(cargs_bind) {
          match Array::get(cargs_bind, cbi) {
            PBind(pname) => {
              let fl = Array::length(local_names)
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + cbi * 8)
              emit_local_set(buf, fl)
              Array::push(local_names, pname)
              0
            },
            PWild => 0,
            _ => 0
          }
          cbi = cbi + 1
        }
        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)
        if arm_nl > max_nl {
          max_nl = arm_nl
        }
        0
      },
      PTuple(tpats) => {
        let mut tbi = 0
        while tbi < Array::length(tpats) {
          match Array::get(tpats, tbi) {
            PBind(tname) => {
              let tl = Array::length(local_names)
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + tbi * 8)
              emit_local_set(buf, tl)
              Array::push(local_names, tname)
              0
            },
            PWild => 0,
            _ => 0
          }
          tbi = tbi + 1
        }
        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)
        if arm_nl > max_nl {
          max_nl = arm_nl
        }
        0
      },
      PBind(bname_arm) => {
        let bl = Array::length(local_names)
        emit_local_get(buf, scrut_local)
        emit_local_set(buf, bl)
        Array::push(local_names, bname_arm)
        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)
        if arm_nl > max_nl {
          max_nl = arm_nl
        }
        0
      },
      _ => {
        let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)
        if arm_nl > max_nl {
          max_nl = arm_nl
        }
        0
      }
    }
    emit_else(buf)
    Array::truncate(local_names, names_len_at_arm)
    ai = ai + 1
  }
  let ld_catch = if ld >= 0 {
    ld + num_cond_arms
  } else {
    -1
  }
  let _names_len_at_catch = Array::length(local_names)
  if catchall_idx < num_arms {
    let (cp, cbody) = Array::get(arms, catchall_idx)
    let catch_nl = match cp {
      PBind(bname) => {
        let bind_local = Array::length(local_names)
        emit_local_get(buf, scrut_local)
        emit_local_set(buf, bind_local)
        Array::push(local_names, bname)
        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
      },
      PCtor(_cname, cargs) => {
        let mut cbi2 = 0
        while cbi2 < Array::length(cargs) {
          match Array::get(cargs, cbi2) {
            PBind(pname) => {
              let fl2 = Array::length(local_names)
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + cbi2 * 8)
              emit_local_set(buf, fl2)
              Array::push(local_names, pname)
              0
            },
            PWild => 0,
            _ => 0
          }
          cbi2 = cbi2 + 1
        }
        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
      },
      PTuple(pats) => {
        let ptr_local2 = Array::length(local_names)
        emit_local_get(buf, scrut_local)
        emit_local_set(buf, ptr_local2)
        Array::push(local_names, "__tup_ptr2")
        let mut pi2 = 0
        while pi2 < Array::length(pats) {
          let tp = Array::get(pats, pi2)
          match tp {
            PBind(pname) => {
              let field_l = Array::length(local_names)
              emit_local_get(buf, ptr_local2)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, pi2 * 8)
              emit_local_set(buf, field_l)
              Array::push(local_names, pname)
              0
            },
            PWild => 0,
            _ => throw("unsupported pattern in tuple destructure")
          }
          pi2 = pi2 + 1
        }
        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
      },
      PStruct(__sname, sfields) => {
        // An irrefutable struct pattern `S::{ x, y }` as the catch-all arm: bind
        // every field by NAME from the scrutinee struct pointer (offset from the
        // field-name table, so pattern order is independent of declaration).
        let sp_ptr = Array::length(local_names)
        emit_local_get(buf, scrut_local)
        emit_local_set(buf, sp_ptr)
        Array::push(local_names, "__struct_ptr")
        let mut sfi = 0
        while sfi < Array::length(sfields) {
          let (fname, subpat) = Array::get(sfields, sfi)
          match subpat {
            PBind(pname) => {
              let off = 8 + struct_field_index_gc(ctx, __sname, fname) * 8
              let fl = Array::length(local_names)
              emit_local_get(buf, sp_ptr)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, off)
              emit_local_set(buf, fl)
              Array::push(local_names, pname)
              0
            },
            PWild => 0,
            _ => 0
          }
          sfi = sfi + 1
        }
        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
      },
      _ => ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
    }
    if catch_nl > max_nl {
      max_nl = catch_nl
    }
    0
  } else {
    bytebuf_push(buf, 0)
    0
  }
  let mut ci2 = 0
  while ci2 < num_cond_arms {
    emit_end(buf)
    ci2 = ci2 + 1
  }
  while Array::length(local_names) < max_nl {
    Array::push(local_names, "")
  }
  max_nl
}

