//# Imports

import .. / .. / core {
  Expr, TypeExpr
}

import .. / common_analysis {
  collect_free_vars
}

import .. / common_base {
  CompileCtxGc, CtorTable, FuncTable
}

//# Functions

export let collect_lambda_captures_gc: (Array[(String, Option[TypeExpr])], Expr, CompileCtxGc) -> (Array[String], Int, Int) = (params, fn_body, ctx) -> {
  let param_names_arr = Array::slice([
    ""
  ], 0, 0)
  let func_table = ctx.func_table
  let ctor_table = ctx.ctor_table
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, _) = Array::get(params, pi)
    Array::push(param_names_arr, pname)
    pi = pi + 1
  }
  let fn_and_ctor = Array::concat(func_table.names, ctor_table.names)
  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)
  let num_captures = Array::length(captures)
  let user_params = Array::length(params)
  (captures, num_captures, user_params)
}
