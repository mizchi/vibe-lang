//# Imports

import .. / common_base {
  CompileCtxGc
}

//# Functions

let make_lambda_ctx_gc: (CompileCtxGc, Array[String], Array[Int]) -> CompileCtxGc = (ctx, ref_cell_names, ref_local_indices) -> {
  CompileCtxGc::{
    func_table: ctx.func_table, str_table: ctx.str_table,
    lambda_table: ctx.lambda_table,
    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,
    ref_cell_names: ref_cell_names, ref_local_indices: ref_local_indices,
    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,
    ctor_table: ctx.ctor_table
  }
}

//# Misc

export {
  make_lambda_ctx_gc
}
