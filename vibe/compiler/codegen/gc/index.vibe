// AST-to-WASM codegen (wasm-gc backend)
// Uses GC struct types for ref cells instead of linear memory bump allocation.
// Closures use table-based call_indirect (same as linear memory backend).

import ../../core/index.vibe {
  Expr, Pat, Stmt, TypeExpr,
  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,
  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,
  leb128_encode_u32, leb128_encode_s64
}

import ../wasm_emit/index.vibe {
  emit_header,
  emit_type_section, emit_type_section_multi,
  emit_function_section, emit_export_section, emit_export_section_multi,
  emit_code_section, emit_code_section_with_locals,
  emit_name, emit_func_type_raw,
  emit_import_section_func, emit_memory_section,
  emit_exports_with_memory, emit_data_section, emit_data_section_multi,
  emit_local_get, emit_local_set, emit_local_tee,
  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,
  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,
  emit_i64_shl, emit_i64_shr_s,
  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,
  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,
  emit_i64_extend_i32_s, emit_i32_wrap_i64,
  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,
  emit_i32_store8, emit_i32_load8_u,
  emit_call, emit_drop, emit_return,
  emit_block_void, emit_block_i64, emit_loop_void,
  emit_if_void, emit_if_i64, emit_else, emit_end,
  emit_br, emit_br_if,
  emit_global_section_i32_mut, emit_global_get, emit_global_set,
  string_to_data,
  emit_f64_const_bits, emit_f64_add, emit_f64_sub, emit_f64_mul, emit_f64_div,
  emit_f64_eq, emit_f64_ne, emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge,
  emit_f64_neg, emit_i64_reinterpret_f64, emit_f64_reinterpret_i64,
  emit_i64_trunc_f64_s, emit_f64_convert_i64_s,
  emit_call_indirect, emit_table_section_funcref, emit_element_section_active,
  emit_struct_type_raw, emit_struct_new, emit_struct_get, emit_struct_set
}

import ../common_base/index.vibe {
  emit_i32_sub, emit_i32_mul, emit_i32_ne, emit_i32_eq, emit_i32_ge_u, emit_i32_eqz, emit_i64_store, emit_i64_load, resolve_local, resolve_func, FuncTable, StrTable, LambdaTable, CtorTable, CompileCtxGc, emit_str_ref, find_func_stmt, lookup_ctor, emit_binop_op
}

import ../common_extractors/index.vibe {
  emit_memory_copy, array_contains_str, str_table_lookup, find_catchall_idx, emit_assignop_op
}

import ../common_analysis/index.vibe {
  emit_i64_extend_i32_u, collect_strings_stmts, collect_free_vars, is_mut_captured_in, emit_closure_resolve, emit_closure_call_tail
}

// === Sub-compilers (GC backend) ===

let compile_call_gc = (
  buf: Array[Int], callee: Expr, args: Array[Expr],
  local_names: Array[String], next_local: Int,
  ctx: CompileCtxGc, ld: Int,
  ce: (Array[Int], Expr, Array[String], Int, Int) -> Int with { Error }
) -> Int with { Error } {
  match callee {
    EIdent(fname) => {
      // Check if this is an enum constructor call
      let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)
      if ctor_lookup_idx >= 0 {
        let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)
        let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)
        let obj_size = 8 + fc * 8
        let ptr_local = next_local
        Array::push(local_names, "__ctor_ptr")
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, ptr_local)
        emit_global_get(buf, 0)
        emit_i32_const(buf, obj_size)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, tag)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, fc)
        emit_i32_store(buf, 2, 4)
        // For structs, unwrap ERecord and reorder fields
        let actual_args = if Array::length(args) == 1 {
          match Array::get(args, 0) {
            ERecord(rec_fields) => {
              let rec find_sn = (sni: Int) -> Int {
                if sni >= Array::length(ctx.ctor_table.struct_names) { -1 }
                else if Array::get(ctx.ctor_table.struct_names, sni) == fname { sni }
                else find_sn(sni + 1)
              }
              let sn_idx = find_sn(0)
              if sn_idx >= 0 {
                let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)
                let ordered = Array::slice([EUnit], 0, 0)
                let mut oi = 0
                while oi < Array::length(def_fnames) {
                  let target_name = Array::get(def_fnames, oi)
                  let rec find_rf = (ri: Int) -> Expr {
                    if ri >= Array::length(rec_fields) { EUnit }
                    else {
                      let (rfn, rfv) = Array::get(rec_fields, ri)
                      if rfn == target_name { rfv }
                      else find_rf(ri + 1)
                    }
                  }
                  Array::push(ordered, find_rf(0))
                  oi = oi + 1
                }
                ordered
              } else { args }
            },
            _ => args
          }
        } else { args }
        let mut nl_c = next_local + 1
        let mut fi_c = 0
        while fi_c < Array::length(actual_args) {
          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)
          let val_local = nl_c
          Array::push(local_names, "__ctor_val")
          emit_local_set(buf, val_local)
          nl_c = nl_c + 1
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 8 + fi_c * 8)
          fi_c = fi_c + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_c
      }
      else {
      let fn_len2 = Array::length(ctx.func_table.names)
      let rec try_resolve = (j: Int) -> Int {
        if j >= fn_len2 { -1 }
        else if Array::get(ctx.func_table.names, j) == fname { j }
        else try_resolve(j + 1)
      }
      let fn_idx_in_list = try_resolve(0)
      if fn_idx_in_list >= 0 {
        // Direct call to known function
        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)
        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)
        let mut nl = next_local
        let mut ci = 0
        while ci < Array::length(args) {
          nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
          ci = ci + 1
        }
        // User funcs in GC backend have __env param for table compatibility
        if ctx.func_offset > 0 {
          if fidx >= ctx.func_offset {
            emit_i64_const(buf, 0)
          }
        }
        emit_call(buf, fidx)
        if has_ret == 0 {
          emit_i64_const(buf, 0)
        }
        nl
      } else {
        // Indirect call: fname is a local holding a closure/fn value
        let local_idx2 = resolve_local(local_names, fname, "gc_call")
        let num_args = Array::length(args)
        let fn_val_local = next_local
        let slot_local = next_local + 1
        let env_local = next_local + 2
        let mut nl = next_local + 3
        Array::push(local_names, "__fn_val")
        Array::push(local_names, "__slot")
        Array::push(local_names, "__env")
        emit_local_get(buf, local_idx2)
        emit_local_set(buf, fn_val_local)
        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
        let mut ci = 0
        while ci < num_args {
          nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
          ci = ci + 1
        }
        emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)
        nl
      }
      } // close ctor_lookup else
    },
    _ => {
      // Callee is an arbitrary expression
      let num_args = Array::length(args)
      let fn_val_local = next_local
      let slot_local = next_local + 1
      let env_local = next_local + 2
      let mut nl = next_local + 3
      Array::push(local_names, "__fn_val")
      Array::push(local_names, "__slot")
      Array::push(local_names, "__env")
      nl = ce(buf, callee, local_names, nl, ld)
      emit_local_set(buf, fn_val_local)
      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
      let mut ci = 0
      while ci < num_args {
        nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
        ci = ci + 1
      }
      emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)
      nl
    }
  }
}

let compile_match_gc = (
  buf: Array[Int], scrutinee: Expr, arms: Array[(Pat, Expr)],
  local_names: Array[String], next_local: Int,
  ctx: CompileCtxGc, ld: Int,
  ce: (Array[Int], Expr, Array[String], Int, Int) -> Int with { Error }
) -> Int with { Error } {
  let scrut_local = next_local
  Array::push(local_names, "__match_scrut")
  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)
  emit_local_set(buf, scrut_local)
  let num_arms = Array::length(arms)
  let catchall_idx = find_catchall_idx(arms)
  let num_cond_arms = catchall_idx
  let mut max_nl = nl1
  let mut ai = 0
  while ai < num_cond_arms {
    let (p, _) = Array::get(arms, ai)
    match p {
      PInt(n) => {
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, n)
        emit_i64_eq(buf)
        emit_if_i64(buf)
        0
      },
      PBool(bv) => {
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, if bv { 1 } else { 0 })
        emit_i64_eq(buf)
        emit_if_i64(buf)
        0
      },
      PCtor(cname_cond, _) => {
        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)
        let expected_tag = if ctor_ci >= 0 { Array::get(ctx.ctor_table.tags, ctor_ci) } else { -1 }
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i32_const(buf, expected_tag)
        emit_i32_eq(buf)
        emit_if_i64(buf)
        0
      },
      PString(sval) => {
        let str_idx = str_table_lookup(ctx.str_table.strs, sval)
        if str_idx >= 0 {
          emit_local_get(buf, scrut_local)
          emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))
          emit_call(buf, 4)
          emit_i64_const(buf, 1)
          emit_i64_eq(buf)
          emit_if_i64(buf)
        }
        0
      },
      _ => 0
    }
    let names_len_at_arm = Array::length(local_names)
    let (p2, arm_body) = Array::get(arms, ai)
    let ld_arm = if ld >= 0 { ld + ai + 1 } else { -1 }
    match p2 {
      PCtor(_, cargs_bind) => {
        let mut cbi = 0
        while cbi < Array::length(cargs_bind) {
          match Array::get(cargs_bind, cbi) {
            PBind(pname) => {
              let fl = Array::length(local_names)
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + cbi * 8)
              emit_local_set(buf, fl)
              Array::push(local_names, pname)
              0
            },
            PWild => 0,
            _ => 0
          }
          cbi = cbi + 1
        }
        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)
        if arm_nl > max_nl { max_nl = arm_nl }
        0
      },
      _ => {
        let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)
        if arm_nl > max_nl { max_nl = arm_nl }
        0
      }
    }
    emit_else(buf)
    Array::truncate(local_names, names_len_at_arm)
    ai = ai + 1
  }
  let ld_catch = if ld >= 0 { ld + num_cond_arms } else { -1 }
  let _names_len_at_catch = Array::length(local_names)
  if catchall_idx < num_arms {
    let (cp, cbody) = Array::get(arms, catchall_idx)
    let catch_nl = match cp {
      PBind(bname) => {
        let bind_local = Array::length(local_names)
        emit_local_get(buf, scrut_local)
        emit_local_set(buf, bind_local)
        Array::push(local_names, bname)
        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
      },
      PCtor(_cname, cargs) => {
        let mut cbi2 = 0
        while cbi2 < Array::length(cargs) {
          match Array::get(cargs, cbi2) {
            PBind(pname) => {
              let fl2 = Array::length(local_names)
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + cbi2 * 8)
              emit_local_set(buf, fl2)
              Array::push(local_names, pname)
              0
            },
            PWild => 0,
            _ => 0
          }
          cbi2 = cbi2 + 1
        }
        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
      },
      PTuple(pats) => {
        let ptr_local2 = Array::length(local_names)
        emit_local_get(buf, scrut_local)
        emit_local_set(buf, ptr_local2)
        Array::push(local_names, "__tup_ptr2")
        let mut pi2 = 0
        while pi2 < Array::length(pats) {
          let tp = Array::get(pats, pi2)
          match tp {
            PBind(pname) => {
              let field_l = Array::length(local_names)
              emit_local_get(buf, ptr_local2)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, pi2 * 8)
              emit_local_set(buf, field_l)
              Array::push(local_names, pname)
              0
            },
            PWild => 0,
            _ => throw("unsupported pattern in tuple destructure")
          }
          pi2 = pi2 + 1
        }
        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
      },
      _ => {
        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
      }
    }
    if catch_nl > max_nl { max_nl = catch_nl }
    0
  } else {
    bytebuf_push(buf, 0)  // unreachable
    0
  }
  let mut ci2 = 0
  while ci2 < num_cond_arms {
    emit_end(buf)
    ci2 = ci2 + 1
  }
  // Pad local_names to stay in sync with max_nl
  while Array::length(local_names) < max_nl {
    Array::push(local_names, "")
  }
  max_nl
}

let compile_lambda_gc = (
  buf: Array[Int], params: Array[(String, Option[TypeExpr])], fn_body: Expr,
  local_names: Array[String], next_local: Int,
  ctx: CompileCtxGc, ld: Int,
  compile_fn: (Array[Int], Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }
) -> Int with { Error } {
  let param_names_arr = Array::slice([""], 0, 0)
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, _) = Array::get(params, pi)
    Array::push(param_names_arr, pname)
    pi = pi + 1
  }
  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)
  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)
  let num_captures = Array::length(captures)
  let user_params = Array::length(params)

  // Compile lambda body into a separate buffer
  let lam_buf = bytebuf_new()
  let lam_locals = Array::slice([""], 0, 0)
  let mut lpi = 0
  while lpi < user_params {
    let (lpname, _) = Array::get(params, lpi)
    Array::push(lam_locals, lpname)
    lpi = lpi + 1
  }
  Array::push(lam_locals, "__env")
  let env_param_idx = user_params
  let lam_nl_start = user_params + 1

  // Prologue: extract captures from env
  let lam_ref_cells = Array::slice([""], 0, 0)
  let lam_ref_local_indices = Array::slice([0], 0, 0)
  let mut ci3 = 0
  let mut lam_nl = lam_nl_start
  while ci3 < num_captures {
    let cap_local = lam_nl
    let cap_name = Array::get(captures, ci3)
    emit_local_get(lam_buf, env_param_idx)
    emit_i32_wrap_i64(lam_buf)
    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)
    emit_local_set(lam_buf, cap_local)
    Array::push(lam_locals, cap_name)
    if array_contains_str(ctx.ref_cell_names, cap_name) {
      Array::push(lam_ref_cells, cap_name)
    }
    lam_nl = lam_nl + 1
    ci3 = ci3 + 1
  }

  // Compile lambda body
  let lam_ctx = CompileCtxGc::{
    func_table: ctx.func_table, str_table: ctx.str_table,
    lambda_table: ctx.lambda_table,
    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,
    ref_cell_names: lam_ref_cells, ref_local_indices: lam_ref_local_indices,
    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,
    ctor_table: ctx.ctor_table
  }
  let final_lam_nl = compile_fn(
    lam_buf, fn_body, lam_locals, lam_nl,
    lam_ctx, ld
  )

  // Record lambda AFTER body compilation (nested lambdas already added)
  let lambda_idx = Array::length(ctx.lambda_table.bodies)
  Array::push(ctx.lambda_table.bodies, lam_buf)
  Array::push(ctx.lambda_table.param_counts, user_params + 1)
  Array::push(ctx.lambda_table.captures, captures)
  let extra_lam = if final_lam_nl > (user_params + 1) { final_lam_nl - (user_params + 1) } else { 0 }
  Array::push(ctx.lambda_table.meta_i32, 0)
  Array::push(ctx.lambda_table.meta_i64, extra_lam)

  // Emit closure creation code
  let table_slot = ctx.num_user_funcs + lambda_idx
  if num_captures == 0 {
    emit_i64_const(buf, (table_slot << 2) | 2)
    next_local
  } else {
    let alloc_size = 8 + num_captures * 8
    let ptr_local = next_local
    let nl2 = next_local + 1
    Array::push(local_names, "__closure_ptr")
    emit_global_get(buf, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_tee(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, alloc_size)
    emit_i32_add(buf)
    emit_global_set(buf, 0)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, table_slot)
    emit_i32_store(buf, 2, 0)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, num_captures)
    emit_i32_store(buf, 2, 4)
    let mut csi = 0
    while csi < num_captures {
      let cap_name = Array::get(captures, csi)
      let cap_idx = resolve_local(local_names, cap_name, "gc_cap")
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cap_idx)
      emit_i64_store(buf, 3, 8 + csi * 8)
      csi = csi + 1
    }
    emit_local_get(buf, ptr_local)
    emit_i64_const(buf, 1)
    emit_i64_or(buf)
    nl2
  }
}

// === Expression compiler (GC backend) ===

let rec compile_expr_gc = (
  buf: Array[Int],
  expr: Expr,
  local_names: Array[String],
  next_local: Int,
  ctx: CompileCtxGc,
  ld: Int
) -> Int with { Error } {
  // shorthand for recursive call
  let ce = (b: Array[Int], e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {
    compile_expr_gc(b, e, ln, nl, ctx, d)
  }
  match expr {
    EInt(n) => {
      emit_i64_const(buf, n)
      next_local
    },
    EBool(b_val) => {
      emit_i64_const(buf, if b_val { 1 } else { 0 })
      next_local
    },
    EFloat(v) => {
      let bits = Double::to_i64_bits(v)
      emit_f64_const_bits(buf, bits)
      emit_i64_reinterpret_f64(buf)
      next_local
    },
    EString(s) => {
      let idx = str_table_lookup(ctx.str_table.strs, s)
      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))
      next_local
    },
    EIdent(name) => {
      // Try local first
      let len = Array::length(local_names)
      let rec try_local = (i: Int) -> Int {
        if i < 0 { -1 }
        else if Array::get(local_names, i) == name { i }
        else try_local(i - 1)
      }
      let local_idx = try_local(len - 1)
      if local_idx >= 0 {
        if array_contains_str(ctx.ref_cell_names, name) {
          // Ref cell: local holds (ref $RefCell), read via struct.get
          emit_local_get(buf, local_idx)
          emit_struct_get(buf, ctx.refcell_type_idx, 0)
        } else {
          emit_local_get(buf, local_idx)
        }
        next_local
      } else {
        // Check if it's a 0-arg enum constructor
        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)
        if ctor_idx >= 0 {
          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)
          let ptr_l = next_local
          Array::push(local_names, "__ctor_ptr")
          emit_global_get(buf, 0)
          emit_i64_extend_i32_u(buf)
          emit_local_set(buf, ptr_l)
          emit_global_get(buf, 0)
          emit_i32_const(buf, 8)
          emit_i32_add(buf)
          emit_global_set(buf, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, tag_c)
          emit_i32_store(buf, 2, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, 0)
          emit_i32_store(buf, 2, 4)
          emit_local_get(buf, ptr_l)
          emit_i64_const(buf, 1)
          emit_i64_or(buf)
          next_local + 1
        } else {
        // Check if it's a top-level function — emit as bare fn value
        let fn_len = Array::length(ctx.func_table.names)
        let rec try_fn = (j: Int) -> Int with { Error } {
          if j >= fn_len { throw("undefined variable: \{name}") }
          else if Array::get(ctx.func_table.names, j) == name { j }
          else try_fn(j + 1)
        }
        let fni = try_fn(0)
        let fidx = Array::get(ctx.func_table.indices, fni)
        let table_slot = fidx - ctx.func_offset
        emit_i64_const(buf, (table_slot << 2) | 2)
        next_local
        }
      }
    },
    EBinOp(op, lhs, rhs) => {
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      emit_binop_op(buf, op)
      nl2
    },
    EUnaryOp(op, operand) => {
      if op == "-" {
        emit_i64_const(buf, 0)
        let nl = ce(buf, operand, local_names, next_local, ld)
        emit_i64_sub(buf)
        nl
      } else if op == "!" {
        let nl = ce(buf, operand, local_names, next_local, ld)
        // Bool: true=1, false=0. Use eqz to negate.
        emit_i64_eqz(buf)
        emit_i64_extend_i32_s(buf)
        nl
      } else {
        throw("unsupported unary op: \{op}")
      }
    },
    EIf(cond, then_e, else_e) => {
      // S1b: skip extend+wrap roundtrip for comparison conditions
      let nl1 = match cond {
        EBinOp(cop, clhs, crhs) => if cop == "==" || cop == "!=" || cop == "<" || cop == ">" || cop == "<=" || cop == ">=" {
          let cnl1 = ce(buf, clhs, local_names, next_local, ld)
          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)
          if cop == "==" { emit_i64_eq(buf) }
          else if cop == "!=" { emit_i64_ne(buf) }
          else if cop == "<" { emit_i64_lt_s(buf) }
          else if cop == ">" { emit_i64_gt_s(buf) }
          else if cop == "<=" { emit_i64_le_s(buf) }
          else { emit_i64_ge_s(buf) }
          cnl2
        } else {
          let cnl = ce(buf, cond, local_names, next_local, ld)
          emit_i32_wrap_i64(buf)
          cnl
        },
        EBool(b_val) => {
          emit_i32_const(buf, if b_val { 1 } else { 0 })
          next_local
        },
        _ => {
          let cnl = ce(buf, cond, local_names, next_local, ld)
          emit_i32_wrap_i64(buf)
          cnl
        }
      }
      emit_if_i64(buf)
      let ld_inner = if ld >= 0 { ld + 1 } else { -1 }
      let names_len_before = Array::length(local_names)
      let nl2 = ce(buf, then_e, local_names, nl1, ld_inner)
      emit_else(buf)
      Array::truncate(local_names, names_len_before)
      let nl3 = ce(buf, else_e, local_names, nl1, ld_inner)
      emit_end(buf)
      let max_nl_if = if nl2 > nl3 { nl2 } else { nl3 }
      // Pad local_names to stay in sync with max next_local
      while Array::length(local_names) < max_nl_if {
        Array::push(local_names, "")
      }
      max_nl_if
    },
    ECall(callee, args) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),
    ELet(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
    },
    ELetRec(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      // Backpatch self-reference in closure for recursive let rec
      match value {
        EFn(_, _, params, _, _, fn_body) => {
          let param_names_bp = Array::slice([""], 0, 0)
          let mut bpi = 0
          while bpi < Array::length(params) {
            let (pn, _) = Array::get(params, bpi)
            Array::push(param_names_bp, pn)
            bpi = bpi + 1
          }
          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))
          let mut self_cap_idx = -1
          let mut bci = 0
          while bci < Array::length(caps) {
            if Array::get(caps, bci) == name {
              self_cap_idx = bci
            }
            bci = bci + 1
          }
          if self_cap_idx >= 0 {
            emit_local_get(buf, local_idx)
            emit_i64_const(buf, -4)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_local_get(buf, local_idx)
            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
          }
          0
        },
        _ => 0
      }
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
    },
    ELetMut(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      if is_mut_captured_in(body, name) {
        // Mutable captured: allocate GC ref cell via struct.new
        Array::push(ctx.ref_cell_names, name)
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_struct_new(buf, ctx.refcell_type_idx)
        emit_local_set(buf, local_idx)
        Array::push(ctx.ref_local_indices, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      } else {
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_local_set(buf, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      }
    },
    EAssign(name, value, body) => {
      let idx = resolve_local(local_names, name, "gc_var")
      if array_contains_str(ctx.ref_cell_names, name) {
        // Ref cell: struct.set
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_struct_set(buf, ctx.refcell_type_idx, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    EAssignOp(name, op, value, body) => {
      let idx = resolve_local(local_names, name, "gc_var")
      if array_contains_str(ctx.ref_cell_names, name) {
        // Ref cell: read via struct.get, compute, write via struct.set
        emit_local_get(buf, idx)   // ref on stack (for struct.set later)
        emit_local_get(buf, idx)   // ref on stack (for struct.get)
        emit_struct_get(buf, ctx.refcell_type_idx, 0)  // current value
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_struct_set(buf, ctx.refcell_type_idx, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    ESeq(first, second) => {
      let nl = ce(buf, first, local_names, next_local, ld)
      emit_drop(buf)
      ce(buf, second, local_names, nl, ld)
    },
    ETuple(elems) => {
      // Allocate N*8 bytes on heap, store each element as i64
      let num_elems = Array::length(elems)
      let alloc_size = num_elems * 8
      let ptr_local = next_local
      Array::push(local_names, "__tuple_ptr")
      let mut nl = next_local + 1
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      emit_local_get(buf, ptr_local)
      nl
    },
    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),
    EArray(elems) => {
      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, "array_new")
      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
      let arr_local = next_local
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < Array::length(elems) {
        emit_local_get(buf, arr_local)
        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
    },
    EForIn(var_name, index_name, iter_expr, body) => {
      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
      let arr_local = next_local
      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "__for_arr")
      let i_local = nl1
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_local)
      Array::push(local_names, "__for_i")
      let nl2 = nl1 + 1
      emit_block_void(buf)
        emit_loop_void(buf)
          emit_local_get(buf, i_local)
          emit_local_get(buf, arr_local)
          emit_call(buf, arr_len_idx)
          emit_i64_ge_s(buf)
          // S1b: i64_ge_s already leaves i32, skip extend+wrap
          emit_br_if(buf, 1)
          let var_local = match index_name {
            Some(_) => nl2 + 1,
            None => nl2
          }
          match index_name {
            Some(index_name) => {
              emit_local_get(buf, i_local)
              emit_local_set(buf, nl2)
              Array::push(local_names, index_name)
            },
            None => ()
          }
          emit_local_get(buf, arr_local)
          emit_local_get(buf, i_local)
          emit_call(buf, arr_get_idx)
          emit_local_set(buf, var_local)
          Array::push(local_names, var_name)
          let nl3 = var_local + 1
          let nl4 = ce(buf, body, local_names, nl3, ld + 1)
          emit_drop(buf)
          emit_local_get(buf, i_local)
          emit_i64_const(buf, 1)
          emit_i64_add(buf)
          emit_local_set(buf, i_local)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl4
    },
    EWhile(cond, body) => {
      emit_block_void(buf)
        emit_loop_void(buf)
          // S1b: skip extend+wrap for comparison conditions in while
          let nl1 = match cond {
            EBinOp(wcop, wlhs, wrhs) => if wcop == "==" || wcop == "!=" || wcop == "<" || wcop == ">" || wcop == "<=" || wcop == ">=" {
              let wnl1 = ce(buf, wlhs, local_names, next_local, ld + 1)
              let wnl2 = ce(buf, wrhs, local_names, wnl1, ld + 1)
              if wcop == "==" { emit_i64_eq(buf) }
              else if wcop == "!=" { emit_i64_ne(buf) }
              else if wcop == "<" { emit_i64_lt_s(buf) }
              else if wcop == ">" { emit_i64_gt_s(buf) }
              else if wcop == "<=" { emit_i64_le_s(buf) }
              else { emit_i64_ge_s(buf) }
              emit_i32_eqz(buf)
              wnl2
            } else {
              let wnl = ce(buf, cond, local_names, next_local, ld + 1)
              emit_i64_eqz(buf)
              wnl
            },
            _ => {
              let wnl = ce(buf, cond, local_names, next_local, ld + 1)
              emit_i64_eqz(buf)
              wnl
            }
          }
          emit_br_if(buf, 1)
          let nl2 = ce(buf, body, local_names, nl1, ld + 1)
          emit_drop(buf)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl2
    },
    EBreak(_) => {
      emit_br(buf, ld + 1)
      emit_i64_const(buf, 0)
      next_local
    },
    EContinue(_) => {
      emit_br(buf, ld)
      emit_i64_const(buf, 0)
      next_local
    },
    EUnit => {
      emit_i64_const(buf, 0)
      next_local
    },
    EThrow(msg_expr) => {
      let nl = ce(buf, msg_expr, local_names, next_local, ld)
      emit_drop(buf)
      bytebuf_push(buf, 0)  // unreachable
      nl
    },
    EFn(_, _, params, _, _, fn_body) =>
      compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),
    EDot(obj, field) => {
      // Struct field access: find field index from ctx.ctor_table.struct_field_names
      let rec find_struct_field_idx = (si2: Int) -> Int {
        if si2 >= Array::length(ctx.ctor_table.struct_names) { -1 }
        else {
          let fnames = Array::get(ctx.ctor_table.struct_field_names, si2)
          let rec find_f = (fi: Int) -> Int {
            if fi >= Array::length(fnames) { -1 }
            else if Array::get(fnames, fi) == field { fi }
            else find_f(fi + 1)
          }
          let idx = find_f(0)
          if idx >= 0 { idx }
          else find_struct_field_idx(si2 + 1)
        }
      }
      let field_idx = find_struct_field_idx(0)
      if field_idx < 0 {
        throw("unknown struct field: \{field}")
      }
      let nl1 = ce(buf, obj, local_names, next_local, ld)
      // Untag: ptr & ~1
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      // Load field at offset 8 + field_idx * 8
      emit_i64_load(buf, 3, 8 + field_idx * 8)
      nl1
    },
    ERecord(fields) => {
      // Record literal: heap alloc [tag_i32 | field_count_i32 | fields...]
      let flen = Array::length(fields)
      let obj_size = 8 + flen * 8
      let ptr_local = next_local
      Array::push(local_names, "__rec_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 0)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, flen)
      emit_i32_store(buf, 2, 4)
      let mut nl_r = next_local + 1
      let mut ri = 0
      while ri < flen {
        let (_, fexpr) = Array::get(fields, ri)
        nl_r = ce(buf, fexpr, local_names, nl_r, ld)
        let val_local = nl_r
        Array::push(local_names, "__rec_val")
        emit_local_set(buf, val_local)
        nl_r = nl_r + 1
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + ri * 8)
        ri = ri + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl_r
    },
    _ => throw("unsupported expression in gc codegen")
  }
}

// === Builtin generators (copied from codegen.vibe) ===

let gen_print_i64_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
    emit_i64_const(b, 0)
    emit_local_get(b, 0)
    emit_i64_sub(b)
  emit_else(b)
    emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 48)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
    emit_loop_void(b)
      emit_local_get(b, 4)
      emit_i64_eqz(b)
      emit_br_if(b, 1)
      emit_local_get(b, 4)
      emit_i64_const(b, 10)
      emit_i64_rem_s(b)
      emit_i32_wrap_i64(b)
      emit_local_set(b, 3)
      emit_local_get(b, 2)
      emit_local_get(b, 3)
      emit_i32_const(b, 48)
      emit_i32_add(b)
      emit_i32_store8(b, 0, 0)
      emit_local_get(b, 2)
      emit_i32_const(b, 1)
      emit_i32_sub(b)
      emit_local_set(b, 2)
      emit_local_get(b, 4)
      emit_i64_const(b, 10)
      emit_i64_div_s(b)
      emit_local_set(b, 4)
      emit_br(b, 0)
    emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 45)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

let gen_print_str_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_i32_const(b, 0)
  emit_local_get(b, 1)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_local_get(b, 2)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

let gen_str_len_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  b
}

let gen_str_eq_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_ne(b)
  emit_if_i64(b)
    emit_i64_const(b, 0)
  emit_else(b)
    emit_local_get(b, 0)
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 4)
    emit_local_get(b, 1)
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 5)
    emit_i32_const(b, 0)
    emit_local_set(b, 6)
    emit_block_i64(b)
      emit_block_void(b)
        emit_loop_void(b)
          emit_local_get(b, 6)
          emit_local_get(b, 2)
          emit_i32_ge_u(b)
          emit_br_if(b, 1)
          emit_local_get(b, 4)
          emit_local_get(b, 6)
          emit_i32_add(b)
          emit_i32_load8_u(b, 0, 0)
          emit_local_get(b, 5)
          emit_local_get(b, 6)
          emit_i32_add(b)
          emit_i32_load8_u(b, 0, 0)
          emit_i32_ne(b)
          emit_if_void(b)
            emit_i64_const(b, 0)
            emit_br(b, 3)
          emit_end(b)
          emit_local_get(b, 6)
          emit_i32_const(b, 1)
          emit_i32_add(b)
          emit_local_set(b, 6)
          emit_br(b, 0)
        emit_end(b)
      emit_end(b)
      emit_i64_const(b, 1)
    emit_end(b)
  emit_end(b)
  b
}

let gen_str_concat_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_local_get(b, 2)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_add(b)
  emit_local_get(b, 5)
  emit_local_get(b, 3)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

let gen_arr_new_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_global_get(b, 0)
  emit_local_tee(b, 0)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 0)
  emit_i64_extend_i32_u(b)
  b
}

let gen_arr_len_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  b
}

let gen_arr_get_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_i64_load(b, 3, 0)
  b
}

let gen_arr_push_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 5)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_if_void(b)
    emit_local_get(b, 3)
    emit_i32_const(b, 2)
    emit_i32_mul(b)
    emit_local_set(b, 7)
    emit_global_get(b, 0)
    emit_local_tee(b, 6)
    emit_local_get(b, 7)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_add(b)
    emit_global_set(b, 0)
    emit_local_get(b, 6)
    emit_local_get(b, 5)
    emit_local_get(b, 4)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_memory_copy(b)
    emit_local_get(b, 2)
    emit_local_get(b, 7)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 2)
    emit_local_get(b, 6)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 6)
    emit_local_set(b, 5)
  emit_end(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 1)
  emit_i64_store(b, 3, 0)
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 4)
  b
}

let gen_arr_set_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 2)
  emit_i64_store(b, 3, 0)
  b
}

// Generate __str_char_code_at body: (s: i64, idx: i64) -> i64
// locals: 0=s(i64), 1=idx(i64), 2=offset(i32)
let gen_str_char_code_at_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  b
}

// Generate __str_from_char_code body: (code: i64) -> i64
// locals: 0=code(i64), 1=ptr(i32)
let gen_str_from_char_code_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_global_get(b, 0)
  emit_local_tee(b, 1)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 1)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 1)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_i64_const(b, 1)
  emit_i64_or(b)
  b
}

// Generate __str_substring body: (s: i64, start: i64, end: i64) -> i64
// locals: 0=s(i64), 1=start(i64), 2=end(i64), 3=old_offset(i32), 4=new_len(i32)
let gen_str_substring_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i64_sub(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

let gen_double_to_int_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_i64_trunc_f64_s(b)
  b
}

let gen_int_to_double_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_f64_convert_i64_s(b)
  emit_i64_reinterpret_f64(b)
  b
}

// Generate __identity body (func 16): (val: i64) -> i64
let gen_identity_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  b
}

// === WASI Module compiler (GC backend) ===

export let compile_wasi_module_gc = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {
  // Collect user functions
  let fn_names_list = Array::slice([""], 0, 0)
  let fn_param_counts = Array::slice([0], 0, 0)

  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, name, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, _) => {
            Array::push(fn_names_list, name)
            Array::push(fn_param_counts, Array::length(params))
            0
          },
          _ => 0
        }
      },
      _ => 0
    }
    i = i + 1
  }

  // Collect enum variant constructors with stable type-scoped tags
  // Tag scheme: (type_index << 16) | variant_index
  let ctor_names_list = Array::slice(["None", "Some"], 0, 2)
  let ctor_tags_list = Array::slice([0, 1], 0, 2)
  let ctor_field_counts_list = Array::slice([0, 1], 0, 2)
  let ctor_type_names_list = Array::slice(["Option", "Option"], 0, 2)
  let mut type_index = 1  // type 0 = Option
  let mut ei2 = 0
  while ei2 < Array::length(stmts) {
    match Array::get(stmts, ei2) {
      SEnum(_, ename, variants) => {
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index << 16) | vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          vi = vi + 1
        }
        0
      },
      SStruct(_, sname, sfields) => {
        type_index = type_index + 1
        Array::push(ctor_names_list, sname)
        Array::push(ctor_tags_list, type_index << 16)
        Array::push(ctor_field_counts_list, Array::length(sfields))
        Array::push(ctor_type_names_list, sname)
        0
      },
      _ => 0
    }
    ei2 = ei2 + 1
  }

  // Build struct field name index tables
  let struct_names = Array::slice([""], 0, 0)
  let struct_field_names = Array::slice([Array::slice([""], 0, 0)], 0, 0)
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SStruct(_, sname, sfields) => {
        Array::push(struct_names, sname)
        let fnames = Array::slice([""], 0, 0)
        let mut sfi = 0
        while sfi < Array::length(sfields) {
          let (fname, _) = Array::get(sfields, sfi)
          Array::push(fnames, fname)
          sfi = sfi + 1
        }
        Array::push(struct_field_names, fnames)
        ()
      },
      _ => ()
    }
    si = si + 1
  }

  let num_user_funcs = Array::length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }

  // Find entry function
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if Array::get(fn_names_list, ei) == entry_name {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  if entry_user_idx < 0 {
    throw("entry function not found: \{entry_name}")
  }

  // String table
  let str_strs = collect_strings_stmts(stmts)
  let num_strings = Array::length(str_strs)
  let data_base = 64
  let str_offsets = Array::slice([0], 0, 0)
  let str_lengths = Array::slice([0], 0, 0)
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = Array::get(str_strs, si)
    let slen = String::length(s)
    Array::push(str_offsets, str_pos)
    Array::push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }
  let heap_start = ((str_pos + 7) / 8) * 8

  // Function layout:
  // func 0: fd_write (import)
  // func 1-16: generated builtins (16 funcs)
  // func 17..17+N-1: user functions
  // func 17+N: _start
  let num_generated = 16
  let func_offset = 1 + num_generated  // = 17

  // Builtin table: (name, param_count, wasm_func_idx, has_return)
  let builtin_defs = [
    ("print_int",           1, 1,  0),
    ("print_str",           1, 2,  0),
    ("String::length",       1, 3,  1),
    ("String::equals",       2, 4,  1),
    ("String::concat",       2, 5,  1),
    ("array_new",           0, 6,  1),
    ("Array::length",        1, 7,  1),
    ("Array::get",           2, 8,  1),
    ("Array::push",          2, 9,  0),
    ("Array::set",           3, 10, 0),
    ("Double::to_int",       1, 11, 1),
    ("Int::to_double",       1, 12, 1),
    ("String::char_code_at", 2, 13, 1),
    ("String::from_char_code", 1, 14, 1),
    ("String::substring",    3, 15, 1),
    // Aliases
    ("ArrayBuilder::new",       0, 6,  1),
    ("ArrayBuilder::push",  2, 9,  0),
    ("ArrayBuilder::freeze", 1, 16, 1)
  ]
  let mut __bi = 0
  while __bi < Array::length(builtin_defs) {
    let (bname, bparams, _, _) = Array::get(builtin_defs, __bi)
    Array::push(fn_names_list, bname)
    Array::push(fn_param_counts, bparams)
    __bi = __bi + 1
  }

  // Build fn_indices and fn_returns
  let fn_indices_list = Array::slice([0], 0, 0)
  let fn_returns_list = Array::slice([0], 0, 0)
  let mut fi = 0
  while fi < num_user_funcs {
    Array::push(fn_indices_list, fi + func_offset)
    Array::push(fn_returns_list, 1)
    fi = fi + 1
  }
  // Builtin indices and returns (from builtin_defs table)
  let mut __bi2 = 0
  while __bi2 < Array::length(builtin_defs) {
    let (_, _, bwasm_idx, breturns) = Array::get(builtin_defs, __bi2)
    Array::push(fn_indices_list, bwasm_idx)
    Array::push(fn_returns_list, breturns)
    __bi2 = __bi2 + 1
  }

  // === Type section ===
  // type 0-8: base func types
  // type 9: struct { mut i64 } -- RefCell GC type
  // type 10+: closure call types (i64^(N+1)) -> i64
  let refcell_type_idx = 9
  let closure_type_base = 10

  // Lambda accumulators (populated during compilation)
  let lt_w = LambdaTable::{
    bodies: Array::slice([Array::slice([0], 0, 0)], 0, 0),
    param_counts: Array::slice([0], 0, 0),
    captures: Array::slice([Array::slice([""], 0, 0)], 0, 0),
    meta_i32: Array::slice([0], 0, 0),
    meta_i64: Array::slice([0], 0, 0)
  }

  // === Code section bodies ===
  let bodies = Array::slice([Array::slice([0], 0, 0)], 0, 0)
  let meta_i32 = Array::slice([0], 0, 0)
  let meta_i64 = Array::slice([0], 0, 0)
  // Track which user func bodies have ref locals (for mixed local declarations)
  let user_ref_local_indices_all = Array::slice([Array::slice([0], 0, 0)], 0, 0)

  // Builtin bodies
  Array::push(bodies, gen_print_i64_body())
  Array::push(meta_i32, 3)
  Array::push(meta_i64, 1)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_print_str_body())
  Array::push(meta_i32, 2)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_str_len_body())
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_str_eq_body())
  Array::push(meta_i32, 5)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_str_concat_body())
  Array::push(meta_i32, 6)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_arr_new_body())
  Array::push(meta_i32, 1)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_arr_len_body())
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_arr_get_body())
  Array::push(meta_i32, 1)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_arr_push_body())
  Array::push(meta_i32, 6)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_arr_set_body())
  Array::push(meta_i32, 1)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_double_to_int_body())
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_int_to_double_body())
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_str_char_code_at_body())
  Array::push(meta_i32, 1)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_str_from_char_code_body())
  Array::push(meta_i32, 1)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_str_substring_body())
  Array::push(meta_i32, 2)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  Array::push(bodies, gen_identity_body())
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  // Compile user function bodies (with __env param for table compatibility)
  let mut bi = 0
  while bi < num_user_funcs {
    let stmt = find_func_stmt(stmts, Array::get(fn_names_list, bi))
    match stmt {
      SLet(_, _, _, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, body) => {
            let body_buf = bytebuf_new()
            let local_names = Array::slice([""], 0, 0)
            let mut ppi = 0
            while ppi < Array::length(params) {
              let (pname, _) = Array::get(params, ppi)
              Array::push(local_names, pname)
              ppi = ppi + 1
            }
            Array::push(local_names, "__env")
            let param_count = Array::length(params) + 1  // includes __env
            let ref_cell_names_f = Array::slice([""], 0, 0)
            let ref_local_indices_f = Array::slice([0], 0, 0)
            let ft = FuncTable::{ names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list }
            let st = StrTable::{ strs: str_strs, offsets: str_offsets, lengths: str_lengths }
            let ct = CtorTable::{ names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names }
            let func_ctx = CompileCtxGc::{
              func_table: ft, str_table: st, lambda_table: lt_w,
              num_user_funcs: num_user_funcs, func_offset: func_offset,
              ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,
              refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,
              ctor_table: ct
            }
            let final_nl = compile_expr_gc(
              body_buf, body, local_names,
              param_count,
              func_ctx, -1
            )
            Array::push(bodies, body_buf)
            let extra = if final_nl > param_count { final_nl - param_count } else { 0 }
            Array::push(meta_i32, 0)
            Array::push(meta_i64, extra)
            Array::push(user_ref_local_indices_all, ref_local_indices_f)
          },
          _ => throw("expected function")
        }
      },
      _ => throw("expected let statement")
    }
    bi = bi + 1
  }

  let num_lambdas = Array::length(lt_w.bodies)

  // _start body
  let start_body = bytebuf_new()
  let entry_func_idx = entry_user_idx + func_offset
  let entry_params = Array::get(fn_param_counts, entry_user_idx)
  if entry_params != 0 {
    throw("WASI entry function must take 0 parameters")
  }
  emit_i64_const(start_body, 0)  // env=0 for user func
  emit_call(start_body, entry_func_idx)
  emit_call(start_body, 1)  // __print_i64
  Array::push(bodies, start_body)
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))

  // Append lambda bodies after _start
  let mut li = 0
  while li < num_lambdas {
    Array::push(bodies, Array::get(lt_w.bodies, li))
    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))
    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))
    Array::push(user_ref_local_indices_all, Array::slice([0], 0, 0))
    li = li + 1
  }

  // Determine max closure call arity
  let mut max_closure_arity = -1
  let mut lai = 0
  while lai < num_lambdas {
    let lpc = Array::get(lt_w.param_counts, lai) - 1
    if lpc > max_closure_arity {
      max_closure_arity = lpc
    }
    lai = lai + 1
  }
  let mut uai2 = 0
  while uai2 < num_user_funcs {
    let upc = Array::get(fn_param_counts, uai2)
    if upc > max_closure_arity {
      max_closure_arity = upc
    }
    uai2 = uai2 + 1
  }
  let num_closure_types = if max_closure_arity >= 0 { max_closure_arity + 1 } else { 0 }

  // === Type section ===
  let num_base_types = 10  // 0-8 func types + 9 struct
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)

  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])  // type 0: fd_write
  emit_func_type_raw(type_content, [126], Array::slice([0], 0, 0))  // type 1: (i64)->()
  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))  // type 2: ()->()
  emit_func_type_raw(type_content, [126], [126])  // type 3: (i64)->(i64)
  emit_func_type_raw(type_content, [126, 126], [126])  // type 4: (i64,i64)->(i64)
  emit_func_type_raw(type_content, Array::slice([0], 0, 0), [126])  // type 5: ()->(i64)
  emit_func_type_raw(type_content, [126, 126], Array::slice([0], 0, 0))  // type 6: (i64,i64)->()
  emit_func_type_raw(type_content, [126, 126, 126], Array::slice([0], 0, 0))  // type 7: (i64,i64,i64)->()
  emit_func_type_raw(type_content, [126, 126, 126], [126])  // type 8: (i64,i64,i64)->(i64)

  // type 9: struct { mut i64 }
  emit_struct_type_raw(type_content, [126], [1])

  // Closure call types: (i64^(N+1)) -> i64 for N = 0..max_closure_arity
  let mut cti = 0
  while cti < num_closure_types {
    let num_params = cti + 1  // N user params + 1 env
    let ct_params = Array::slice([0], 0, 0)
    let mut cpti = 0
    while cpti < num_params {
      Array::push(ct_params, 126)
      cpti = cpti + 1
    }
    emit_func_type_raw(type_content, ct_params, [126])
    cti = cti + 1
  }

  let out = bytebuf_new()
  emit_header(out)
  bytebuf_push_section(out, 1, type_content)

  // === Import section ===
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)

  // === Function section ===
  let func_type_indices = Array::slice([0], 0, 0)
  Array::push(func_type_indices, 1)  // __print_i64
  Array::push(func_type_indices, 1)  // __print_str
  Array::push(func_type_indices, 3)  // __str_len
  Array::push(func_type_indices, 4)  // __str_eq
  Array::push(func_type_indices, 4)  // __str_concat
  Array::push(func_type_indices, 5)  // __arr_new
  Array::push(func_type_indices, 3)  // __arr_len
  Array::push(func_type_indices, 4)  // __arr_get
  Array::push(func_type_indices, 6)  // __arr_push
  Array::push(func_type_indices, 7)  // __arr_set
  Array::push(func_type_indices, 3)  // __double_to_int
  Array::push(func_type_indices, 3)  // __int_to_double
  Array::push(func_type_indices, 4)  // __str_char_code_at
  Array::push(func_type_indices, 3)  // __str_from_char_code
  Array::push(func_type_indices, 8)  // __str_substring
  Array::push(func_type_indices, 3)  // __identity (ArrayBuilder::freeze)
  // User funcs: type = closure call type for their arity (includes env)
  let mut fti = 0
  while fti < num_user_funcs {
    let upc = Array::get(fn_param_counts, fti)
    Array::push(func_type_indices, closure_type_base + upc)
    fti = fti + 1
  }
  Array::push(func_type_indices, 2)  // _start
  // Lambda function type indices
  let mut lfi = 0
  while lfi < num_lambdas {
    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1
    Array::push(func_type_indices, closure_type_base + lam_user_params)
    lfi = lfi + 1
  }
  emit_function_section(out, func_type_indices)

  // === Table section ===
  let total_table_entries = num_user_funcs + num_lambdas
  if total_table_entries > 0 {
    emit_table_section_funcref(out, total_table_entries)
  }

  // === Memory section ===
  emit_memory_section(out, 1)

  // === Global section: heap_ptr ===
  emit_global_section_i32_mut(out, heap_start)

  // === Export section ===
  let start_func_idx = func_offset + num_user_funcs
  emit_exports_with_memory(out, ["_start"], [start_func_idx], "memory", 0)

  // === Element section ===
  if total_table_entries > 0 {
    let table_func_indices = Array::slice([0], 0, 0)
    let mut tei = 0
    while tei < num_user_funcs {
      Array::push(table_func_indices, func_offset + tei)
      tei = tei + 1
    }
    let mut tej = 0
    while tej < num_lambdas {
      Array::push(table_func_indices, start_func_idx + 1 + tej)
      tej = tej + 1
    }
    emit_element_section_active(out, table_func_indices)
  }

  // === Encode code section with mixed locals (i64 and ref types) ===
  let code_content = bytebuf_new()
  bytebuf_push_vec_header(code_content, Array::length(bodies))

  let mut ci = 0
  while ci < Array::length(bodies) {
    let body = Array::get(bodies, ci)
    let func_buf = bytebuf_new()
    let ni32 = Array::get(meta_i32, ci)
    let ni64 = Array::get(meta_i64, ci)
    let ref_indices = Array::get(user_ref_local_indices_all, ci)
    let num_ref_locals = Array::length(ref_indices)

    if num_ref_locals == 0 {
      if ni32 == 0 {
        if ni64 == 0 {
          leb128_encode_u32(func_buf, 0)
        } else {
          leb128_encode_u32(func_buf, 1)
          leb128_encode_u32(func_buf, ni64)
          bytebuf_push(func_buf, 126)  // i64
        }
      } else {
        if ni64 == 0 {
          leb128_encode_u32(func_buf, 1)
          leb128_encode_u32(func_buf, ni32)
          bytebuf_push(func_buf, 127)  // i32
        } else {
          leb128_encode_u32(func_buf, 2)
          leb128_encode_u32(func_buf, ni32)
          bytebuf_push(func_buf, 127)  // i32
          leb128_encode_u32(func_buf, ni64)
          bytebuf_push(func_buf, 126)  // i64
        }
      }
    } else {
      // Has ref locals — emit individual local declarations
      let body_idx_in_user = ci - num_generated
      let param_count_for_body = Array::get(fn_param_counts, body_idx_in_user) + 1  // +1 for __env
      let num_extra = ni64
      leb128_encode_u32(func_buf, num_extra)
      let mut rli = 0
      while rli < num_extra {
        let actual_local_idx = param_count_for_body + rli
        let mut is_ref = false
        let mut ri = 0
        while ri < num_ref_locals {
          if Array::get(ref_indices, ri) == actual_local_idx {
            is_ref = true
          }
          ri = ri + 1
        }
        leb128_encode_u32(func_buf, 1)
        if is_ref {
          bytebuf_push(func_buf, 100)  // 0x64 = ref
          leb128_encode_u32(func_buf, refcell_type_idx)
        } else {
          bytebuf_push(func_buf, 126)  // i64
        }
        rli = rli + 1
      }
    }

    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, 11)  // end
    leb128_encode_u32(code_content, bytebuf_length(func_buf))
    bytebuf_push_array(code_content, func_buf)
    ci = ci + 1
  }

  bytebuf_push_section(out, 10, code_content)

  // === Data section ===
  if num_strings > 0 {
    let data_offsets = Array::slice([0], 0, 0)
    let data_bufs = Array::slice([Array::slice([0], 0, 0)], 0, 0)
    let mut di = 0
    while di < num_strings {
      Array::push(data_offsets, Array::get(str_offsets, di))
      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))
      di = di + 1
    }
    emit_data_section_multi(out, data_offsets, data_bufs)
  }

  bytebuf_to_bytes(out)
}
