// --- Sorted index for O(log n) string lookup ---

// Compare two strings lexicographically. Returns <0, 0, or >0.
export let string_compare = (a: String, b: String) -> Int {
  let la = String::length(a)
  let lb = String::length(b)
  let min_len = if la < lb { la } else { lb }
  let mut i = 0
  let mut result = 0
  let mut done = false
  while i < min_len && !done {
    let ca = String::char_code_at(a, i)
    let cb = String::char_code_at(b, i)
    if ca != cb {
      result = ca - cb
      done = true
    }
    i = i + 1
  }
  if !done {
    result = la - lb
  }
  result
}

// Build a sorted index: returns Array[(String, Int)] sorted by string.
// Each entry is (name, original_index). Uses insertion sort (simple,
// no temporary arrays, avoids MoonBit RC overhead from merge sort).
export let build_sorted_index = (names: Array[String]) -> Array[(String, Int)] {
  let len = Array::length(names)
  let idx = Array::slice([("", 0)], 0, 0)
  let mut i = 0
  while i < len {
    Array::push(idx, (Array::get(names, i), i))
    i = i + 1
  }
  // Insertion sort — O(n^2) but no temp allocations, fast for n < 3000
  let mut si = 1
  while si < len {
    let key = Array::get(idx, si)
    let (ks, _) = key
    let mut j = si - 1
    let mut done = false
    while j >= 0 && !done {
      let (js, _) = Array::get(idx, j)
      if string_compare(js, ks) > 0 {
        Array::set(idx, j + 1, Array::get(idx, j))
        j = j - 1
      } else {
        done = true
      }
    }
    Array::set(idx, j + 1, key)
    si = si + 1
  }
  idx
}

// Binary search in a sorted (String, Int) array. Returns the Int value or -1.
export let sorted_index_lookup = (sorted: Array[(String, Int)], name: String) -> Int {
  let len = Array::length(sorted)
  let mut lo = 0
  let mut hi = len
  let mut result = -1
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let (s, _) = Array::get(sorted, mid)
    let cmp = string_compare(name, s)
    if cmp == 0 {
      let (_, idx) = Array::get(sorted, mid)
      result = idx
      lo = hi
    } else if cmp < 0 {
      hi = mid
    } else {
      lo = mid + 1
    }
  }
  result
}

// Build hash-bucket lookup index: Array[Array[(String, Int)]] with num_bk buckets.
// Bucket key = string length mod num_bk. Much less memory overhead than sorted index
// because no sorting pass or large temporary arrays are needed.
export let build_lookup_buckets = (names: Array[String], num_bk: Int) -> Array[Array[(String, Int)]] {
  let buckets = Array::slice([Array::slice([("", 0)], 0, 0)], 0, 0)
  let mut bi = 0
  while bi < num_bk {
    Array::push(buckets, Array::slice([("", 0)], 0, 0))
    bi = bi + 1
  }
  let len = Array::length(names)
  let mut i = 0
  while i < len {
    let s = Array::get(names, i)
    let slen = String::length(s)
    let bk_idx = if slen < num_bk { slen } else { slen - (slen / num_bk) * num_bk }
    Array::push(Array::get(buckets, bk_idx), (s, i))
    i = i + 1
  }
  buckets
}
