export let array_contains_str = (arr: Array[String], s: String) -> Bool {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len {
    if Array::get(arr, i) == s {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

