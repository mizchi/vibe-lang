export let get_slet_export: (Stmt) -> Bool with { Error } = (stmt) -> {
  match stmt {
    SLet(is_export, _, _, _, _) => is_export,
    _ => throw("not SLet")
  }
}

// Check if a pattern is unconditionally matching (catch-all)
export let rec is_catchall_pat: (Pat) -> Bool = (p) -> {
  match p {
    PWild => true,
    PBind(_) => true,
    PTuple(pats) => {
      // PTuple is catch-all only if ALL sub-patterns are catch-all
      let mut i = 0
      let mut all_catch = true
      while i < Array::length(pats) {
        if !is_catchall_pat(Array::get(pats, i)) {
          all_catch = false
        }
        i = i + 1
      }
      all_catch
    },
    _ => false
  }
}

// Emit WASM instruction for an assign operator (+=, -=, etc.)
export let emit_assignop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {
  if op == "+" {
    emit_i64_add(buf)
  }
  else if op == "-" {
    emit_i64_sub(buf)
  }
  else if op == "*" {
    emit_i64_mul(buf)
  }
  else if op == "/" {
    emit_i64_div_s(buf)
  }
  else if op == "%" {
    emit_i64_rem_s(buf)
  }
  else {
    throw(String::concat("unsupported assign op: ", op))
  }
}

export let emit_memory_copy: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_prefix)
  leb128_encode_u32(buf, 10)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
}

