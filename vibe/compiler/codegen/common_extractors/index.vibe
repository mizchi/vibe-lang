export let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {
  let len = Array::length(strs)
  let mut i = 0
  let mut found = -1
  while i < len {
    if Array::get(strs, i) == s {
      found = i
      i = len
    } else {
      i = i + 1
    }
  }
  if found < 0 {
    throw(String::concat("string not in table: ", s))
  }
  found
}

// O(log n) version using sorted_index from StrTable
export let str_table_lookup_sorted = (sorted: Array[(String, Int)], strs: Array[String], s: String) -> Int with { Error } {
  let found = if Array::length(sorted) > 0 {
    sorted_index_lookup(sorted, s)
  } else {
    str_table_lookup(strs, s)
  }
  if found < 0 {
    throw(String::concat("string not in table: ", s))
  }
  found
}

export let str_table_lookup_fast = (buckets: Array[Array[(String, Int)]], s: String) -> Int with { Error } {
  let slen = String::length(s)
  let num_buckets = Array::length(buckets)
  let bucket_idx = if slen < num_buckets { slen } else { slen - (slen / num_buckets) * num_buckets }
  let bucket = Array::get(buckets, bucket_idx)
  let blen = Array::length(bucket)
  let mut i = 0
  let mut found = -1
  while i < blen {
    let (bs, bi) = Array::get(bucket, i)
    if bs == s {
      found = bi
      i = blen
    } else {
      i = i + 1
    }
  }
  if found < 0 {
    throw(String::concat("string not in table: ", s))
  }
  found
}

// Find the index of the first catch-all pattern in match arms
// Returns num_arms if no catch-all found
export let find_catchall_idx = (arms: Array[(Pat, Expr)]) -> Int {
  let num = Array::length(arms)
  let mut idx = 0
  let mut result = num
  while idx < num {
    let (p, _) = Array::get(arms, idx)
    if is_catchall_pat(p) {
      result = idx
      idx = num
    } else {
      idx = idx + 1
    }
  }
  result
}

