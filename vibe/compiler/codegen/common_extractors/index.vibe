//# Functions

export let get_ebinop_lhs = (expr: Expr) -> Expr with { Error } {
  match expr {
    EBinOp(_, lhs, _) => lhs,
    _ => throw("not EBinOp")
  }
}

export let get_ebinop_rhs = (expr: Expr) -> Expr with { Error } {
  match expr {
    EBinOp(_, _, rhs) => rhs,
    _ => throw("not EBinOp")
  }
}

