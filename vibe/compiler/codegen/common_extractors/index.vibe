  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub
}

let op_prefix = 252

//# Functions

export let get_ebinop_lhs: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EBinOp(_, lhs, _) => lhs,
    _ => throw("not EBinOp")
  }
}

export let get_ebinop_rhs: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EBinOp(_, _, rhs) => rhs,
    _ => throw("not EBinOp")
  }
}

