//# Imports

import ../core/index.vibe {
  Stmt
}

import ./expr/index.vibe {
  compile_module_expr
}

import ./wasi/index.vibe {
  compile_wasi_module_impl,
  compile_wasi_module_coverage_impl,
  compile_wasi_module_trace_impl,
  compile_wasi_module_break_impl,
  compile_wasi_module_with_sources_impl,
  compile_wasi_module_rc_impl
}

//# Functions

export let compile_module: (Array[Stmt]) -> Bytes with { Error } = (stmts) -> {
  compile_module_expr(stmts)
}

export let compile_wasi_module_with_sources: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {
  compile_wasi_module_with_sources_impl(stmts, entry_name, selfhost_srcs)
}

export let compile_wasi_module: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_impl(stmts, entry_name)
}

// Coverage variant (#cov): function-level hit instrumentation + `vibe_cov`
// custom section. Used by the coverage self-compile entry.
export let compile_wasi_module_coverage: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_coverage_impl(stmts, entry_name)
}

// Trace variant (debugger / DAP P1 groundwork): function-call execution-trace
// instrumentation + `vibe.trace` custom section. Used by the FS-compile trace
// entry under VIBE_DEBUG=1.
export let compile_wasi_module_trace: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_trace_impl(stmts, entry_name)
}

// Break variant (debugger / DAP P1): `vibe::dbg_break` host-hook instrumentation
// at each user function entry. Used by the FS-compile break entry under
// VIBE_DEBUG_BREAK=1.
export let compile_wasi_module_break: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_break_impl(stmts, entry_name)
}

// RC-mode variant (uniform object header); see compile_wasi_module_rc_impl.
export let compile_wasi_module_rc: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_rc_impl(stmts, entry_name)
}
