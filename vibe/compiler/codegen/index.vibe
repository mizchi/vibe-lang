//# Imports

import ../core/index.vibe {
  Stmt
}

import ./expr/index.vibe {
  compile_module_expr
}

import ./wasi/index.vibe {
  compile_wasi_module_impl,
  compile_wasi_module_with_sources_impl
}

//# Functions

export let compile_module = (stmts: Array[Stmt]) -> Bytes with { Error } {
  compile_module_expr(stmts)
}

export let compile_wasi_module_with_sources = (stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {
  compile_wasi_module_with_sources_impl(stmts, entry_name, selfhost_srcs)
}

export let compile_wasi_module = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {
  compile_wasi_module_impl(stmts, entry_name)
}
