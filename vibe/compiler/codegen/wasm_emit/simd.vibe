import ../../core/index.vibe {
  bytebuf_new, bytebuf_push, bytebuf_push2,
  leb128_encode_u32
}

///|

// SIMD prefix byte: 0xFD = 253
let simd_prefix = 253

///|

// Helper: emit SIMD prefix + LEB128-encoded opcode
let emit_simd_op = (buf: Bytes, opcode: Int) -> Unit {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, opcode)
}

///|

// v128.const: 0xFD 0x0C + 16 immediate bytes
export let emit_v128_const = (buf: Bytes, bytes: Array[Int]) -> Unit {
  emit_simd_op(buf, 12)
  let mut i = 0
  while i < 16 {
    if i < Array::length(bytes) {
      bytebuf_push(buf, Array::get(bytes, i))
    } else {
      bytebuf_push(buf, 0)
    }
    i = i + 1
  }
}

///|

// i8x16.splat: 0xFD 0x17
export let emit_i8x16_splat = (buf: Bytes) -> Unit {
  emit_simd_op(buf, 23)
}

///|

// i8x16.eq: 0xFD 0x23
export let emit_i8x16_eq = (buf: Bytes) -> Unit {
  emit_simd_op(buf, 35)
}

///|

// v128.any_true: 0xFD 0x53
export let emit_v128_any_true = (buf: Bytes) -> Unit {
  emit_simd_op(buf, 83)
}

///|

// v128.load: 0xFD 0x00 + memarg(align, offset)
export let emit_v128_load = (buf: Bytes, align: Int, offset: Int) -> Unit {
  emit_simd_op(buf, 0)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

///|

// i8x16.swizzle: 0xFD 0x0E
export let emit_i8x16_swizzle = (buf: Bytes) -> Unit {
  emit_simd_op(buf, 14)
}

///|

// v128.store: 0xFD 0x0B + memarg(align, offset)
export let emit_v128_store = (buf: Bytes, align: Int, offset: Int) -> Unit {
  emit_simd_op(buf, 11)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

///|

// v128.not: 0xFD 0x4D
export let emit_v128_not = (buf: Bytes) -> Unit {
  emit_simd_op(buf, 77)
}

///|

// v128.and: 0xFD 0x4E
export let emit_v128_and = (buf: Bytes) -> Unit {
  emit_simd_op(buf, 78)
}

///|

// i8x16.sub: 0xFD 0x71
export let emit_i8x16_sub = (buf: Bytes) -> Unit {
  emit_simd_op(buf, 113)
}

///|

// i8x16.min_u: 0xFD 0x77
export let emit_i8x16_min_u = (buf: Bytes) -> Unit {
  emit_simd_op(buf, 119)
}
