//# Imports

import .. / .. / core {
  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32
}

//# Functions

export let emit_func_type = (buf: Bytes, param_count: Int, result_count: Int) -> Unit {
  bytebuf_push(buf, 96)
  leb128_encode_u32(buf, param_count)
  let mut i = 0
  while i < param_count {
    bytebuf_push(buf, 126)
    i = i + 1
  }
  leb128_encode_u32(buf, result_count)
  let mut j = 0
  while j < result_count {
    bytebuf_push(buf, 126)
    j = j + 1
  }
}

export let emit_type_section_multi = (out: Bytes, type_defs: Array[Int]) -> Unit {
  let count = Array::length(type_defs) / 2
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))
    i = i + 1
  }
  bytebuf_push_section(out, 1, content)
}

export let emit_type_section = (out: Bytes, param_count: Int, result_count: Int) -> Unit {
  let type_defs = Array::slice([
    0
  ], 0, 0)
  Array::push(type_defs, param_count)
  Array::push(type_defs, result_count)
  emit_type_section_multi(out, type_defs)
}
