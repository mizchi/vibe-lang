// WASM binary emitter — generates minimal valid .wasm modules
// Uses bytebuf.vibe for byte-level binary construction

import ../../core/index.vibe {
  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes,
  bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header,
  leb128_encode_u32, leb128_encode_s64,
  bytebuf_push2, bytebuf_push3, bytebuf_push9,
  bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32,
  bytebuf_push_string
}

// WASM Opcodes
let op_block = 2
let op_loop = 3
let op_if = 4
let op_else = 5
let op_end = 11
let op_br = 12
let op_br_if = 13
let op_return = 15
let op_call = 16
let op_call_indirect = 17
let op_drop = 26
let bt_void = 64
let bt_i64 = 126
let op_local_get = 32
let op_local_set = 33
let op_local_tee = 34
let op_global_get = 35
let op_global_set = 36
let op_i32_load = 40
let op_i64_load = 41
let op_i32_load8_u = 45
let op_i32_store = 54
let op_i64_store = 55
let op_i32_store8 = 58
let op_i32_const = 65
let op_i64_const = 66
let op_i32_eqz = 69
let op_i32_eq = 70
let op_i32_ne = 71
let op_i32_gt_u = 75
let op_i32_ge_u = 79
let op_i32_add = 106
let op_i32_sub = 107
let op_i32_mul = 108
let op_i64_eqz = 80
let op_i64_eq = 81
let op_i64_ne = 82
let op_i64_lt_s = 83
let op_i64_gt_s = 85
let op_i64_le_s = 87
let op_i64_ge_s = 89
let op_i64_add = 124
let op_i64_sub = 125
let op_i64_mul = 126
let op_i64_div_s = 127
let op_i64_rem_s = 129
let op_i64_and = 131
let op_i64_or = 132
let op_i64_xor = 133
let op_i64_shl = 134
let op_i64_shr_s = 135
let op_i32_wrap_i64 = 167
let op_i64_extend_i32_s = 172
let op_i64_extend_i32_u = 173
let op_i64_trunc_f64_s = 176
let op_f64_convert_i64_s = 185
let op_i64_reinterpret_f64 = 189
let op_f64_reinterpret_i64 = 191
let op_f64_eq = 97
let op_f64_ne = 98
let op_f64_lt = 99
let op_f64_gt = 100
let op_f64_le = 101
let op_f64_ge = 102
let op_f64_neg = 154
let op_f64_add = 160
let op_f64_sub = 161
let op_f64_mul = 162
let op_f64_div = 163
let op_prefix = 252
let type_func = 96
let type_funcref = 112
let vt_i32 = 127
let vt_i64 = 126
let sec_type = 1
let sec_import = 2
let sec_function = 3
let sec_table = 4
let sec_memory = 5
let sec_global = 6
let sec_export = 7
let sec_element = 9
let sec_code = 10
let sec_data = 11
let export_func = 0
let export_memory = 2

// === Emit helpers ===

// Emit WASM magic number and version
export let emit_header = (buf: Array[Int]) -> Unit {
  // \0asm + version 1 (8 bytes via two push3 + push2)
  bytebuf_push3(buf, 0, 97, 115)
  bytebuf_push3(buf, 109, 1, 0)
  bytebuf_push2(buf, 0, 0)
}

// Encode a function type: (i64 x param_count) -> (i64 x result_count)
export let emit_func_type = (buf: Array[Int], param_count: Int, result_count: Int) -> Unit {
  bytebuf_push(buf, type_func)
  leb128_encode_u32(buf, param_count)
  let mut i = 0
  while i < param_count {
    bytebuf_push(buf, vt_i64)
    i = i + 1
  }
  leb128_encode_u32(buf, result_count)
  let mut j = 0
  while j < result_count {
    bytebuf_push(buf, vt_i64)
    j = j + 1
  }
}

// Emit type section with multiple function types
// type_defs: flat array of [param_count, result_count, param_count, result_count, :.]
export let emit_type_section_multi = (out: Array[Int], type_defs: Array[Int]) -> Unit {
  let count = Array::length(type_defs) / 2
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))
    i = i + 1
  }
  bytebuf_push_section(out, sec_type, content)
}

// Emit type section with a single function type (convenience)
export let emit_type_section = (out: Array[Int], param_count: Int, result_count: Int) -> Unit {
  emit_type_section_multi(out, [param_count, result_count])
}

// Emit function section — maps function indices to type indices
export let emit_function_section = (out: Array[Int], type_indices: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(type_indices))
  let mut i = 0
  while i < Array::length(type_indices) {
    leb128_encode_u32(content, Array::get(type_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, sec_function, content)
}

// Helper: emit a name string (length-prefixed ASCII)
export let emit_name = (buf: Array[Int], name: String) -> Unit {
  bytebuf_push_string(buf, name)
}

// Emit export section with multiple exports
// names: array of export names, func_indices: matching array of function indices
export let emit_export_section_multi = (out: Array[Int], names: Array[String], func_indices: Array[Int]) -> Unit {
  let count = Array::length(names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_name(content, Array::get(names, i))
    bytebuf_push(content, export_func)
    leb128_encode_u32(content, Array::get(func_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, sec_export, content)
}

// Emit export section — single export (convenience)
export let emit_export_section = (out: Array[Int], name: String, func_idx: Int) -> Unit {
  emit_export_section_multi(out, [name], [func_idx])
}

// Emit memory section: 1 memory with min pages, no max
export let emit_memory_section = (out: Array[Int], min_pages: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 memory
  bytebuf_push(content, 0)  // limits: no max
  leb128_encode_u32(content, min_pages)
  bytebuf_push_section(out, sec_memory, content)
}

// Emit a code section with function bodies
// Each body is pre-encoded instructions (without end opcode)
export let emit_code_section = (out: Array[Int], bodies: Array[Array[Int]]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, i)
    let func_buf = bytebuf_new()
    leb128_encode_u32(func_buf, 0)  // 0 local declarations
    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, op_end)
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_array(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, sec_code, content)
}

// Emit code section with local declarations
// local_decls: array of [count, valtype] pairs per function (flat)
// For now: emit one block of count locals of type i64
export let emit_code_section_with_locals = (out: Array[Int], bodies: Array[Array[Int]], local_counts: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, i)
    let num_locals = Array::get(local_counts, i)
    let func_buf = bytebuf_new()
    if num_locals == 0 {
      leb128_encode_u32(func_buf, 0)  // 0 local decl blocks
    } else {
      leb128_encode_u32(func_buf, 1)  // 1 local decl block
      leb128_encode_u32(func_buf, num_locals)
      bytebuf_push(func_buf, vt_i64)
    }
    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, op_end)
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_array(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, sec_code, content)
}

// === Instruction emitters ===

export let emit_local_get = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_local_get, idx)
}

export let emit_local_set = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_local_set, idx)
}

export let emit_local_tee = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_local_tee, idx)
}

export let emit_i64_const = (buf: Array[Int], value: Int) -> Unit {
  bytebuf_push_opcode_s64(buf, op_i64_const, value)
}

export let emit_i64_add = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_add)
}

export let emit_i64_sub = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_sub)
}

export let emit_i64_mul = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_mul)
}

export let emit_i64_div_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_div_s)
}

export let emit_i64_rem_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_rem_s)
}

export let emit_i64_and = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_and)
}

export let emit_i64_or = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_or)
}

export let emit_i64_xor = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_xor)
}

export let emit_i64_shl = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_shl)
}

export let emit_i64_shr_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_shr_s)
}

export let emit_i64_eq = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_eq)
}

export let emit_i64_ne = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_ne)
}

export let emit_i64_lt_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_lt_s)
}

export let emit_i64_gt_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_gt_s)
}

export let emit_i64_le_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_le_s)
}

export let emit_i64_ge_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_ge_s)
}

export let emit_i64_eqz = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_eqz)
}

export let emit_call = (buf: Array[Int], func_idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_call, func_idx)
}

export let emit_drop = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_drop)
}

export let emit_return = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_return)
}

// Control flow: block types
// 0x40 = void block, 0x7E = i64 block
export let emit_block_void = (buf: Array[Int]) -> Unit {
  bytebuf_push2(buf, op_block, bt_void)
}

export let emit_block_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push2(buf, op_block, bt_i64)
}

export let emit_loop_void = (buf: Array[Int]) -> Unit {
  bytebuf_push2(buf, op_loop, bt_void)
}

export let emit_if_void = (buf: Array[Int]) -> Unit {
  bytebuf_push2(buf, op_if, bt_void)
}

export let emit_if_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push2(buf, op_if, bt_i64)
}

export let emit_else = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_else)
}

export let emit_end = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_end)
}

export let emit_br = (buf: Array[Int], label: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_br, label)
}

export let emit_br_if = (buf: Array[Int], label: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_br_if, label)
}

// i64.extend_i32_s — extend i32 comparison result to i64
export let emit_i64_extend_i32_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_extend_i32_s)
}

// i32.wrap_i64 — truncate i64 to i32
export let emit_i32_wrap_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i32_wrap_i64)
}

// === i32 instructions (needed for WASI APIs) ===

export let emit_i32_const = (buf: Array[Int], value: Int) -> Unit {
  bytebuf_push_opcode_s64(buf, op_i32_const, value)
}

export let emit_i32_add = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i32_add)
}

export let emit_i32_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push_opcode_u32_u32(buf, op_i32_store, align, offset)
}

export let emit_i32_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push_opcode_u32_u32(buf, op_i32_load, align, offset)
}

export let emit_i32_store8 = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push_opcode_u32_u32(buf, op_i32_store8, align, offset)
}

export let emit_i32_load8_u = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push_opcode_u32_u32(buf, op_i32_load8_u, align, offset)
}

// === Section emitters: Import, Data, Global ===

// Emit raw func type with explicit valtype arrays
// param_types/result_types: arrays of valtype ints (126=i64, 127=i32)
export let emit_func_type_raw = (buf: Array[Int], param_types: Array[Int], result_types: Array[Int]) -> Unit {
  bytebuf_push(buf, type_func)
  leb128_encode_u32(buf, Array::length(param_types))
  let mut i = 0
  while i < Array::length(param_types) {
    bytebuf_push(buf, Array::get(param_types, i))
    i = i + 1
  }
  leb128_encode_u32(buf, Array::length(result_types))
  let mut j = 0
  while j < Array::length(result_types) {
    bytebuf_push(buf, Array::get(result_types, j))
    j = j + 1
  }
}

// Emit import section: import a function
// module_name, field_name: import path, type_idx: type index
export let emit_import_section_func = (out: Array[Int], module_name: String, field_name: String, type_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 import
  emit_name(content, module_name)
  emit_name(content, field_name)
  bytebuf_push(content, export_func)  // import kind: function
  leb128_encode_u32(content, type_idx)
  bytebuf_push_section(out, sec_import, content)
}

// Emit data section: place byte data at a memory offset
// segments: array of [offset, data_buf] pairs
export let emit_data_section = (out: Array[Int], offset: Int, data: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 data segment
  // Active data segment: memory index 0
  bytebuf_push(content, 0)  // flags: active, memory 0
  // Offset expression: i32.const <offset>, end
  emit_i32_const(content, offset)
  emit_end(content)
  // Data bytes
  leb128_encode_u32(content, Array::length(data))
  bytebuf_push_array(content, data)
  bytebuf_push_section(out, sec_data, content)
}

// Emit global section: one mutable i32 global with initial value
export let emit_global_section_i32_mut = (out: Array[Int], init_value: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 global
  bytebuf_push2(content, vt_i32, 1)  // mutable
  emit_i32_const(content, init_value)
  emit_end(content)
  bytebuf_push_section(out, sec_global, content)
}

export let emit_global_get = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_global_get, idx)
}

export let emit_global_set = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_global_set, idx)
}

// Emit export for memory
export let emit_export_memory = (out: Array[Int], name: String, mem_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  emit_name(content, name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, sec_export, content)
}

// Emit combined export section: functions + optional memory
export let emit_exports_with_memory = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {
  let count = Array::length(fn_names) + 1
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  // Function exports
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(content, Array::get(fn_names, i))
    bytebuf_push(content, export_func)
    leb128_encode_u32(content, Array::get(fn_indices, i))
    i = i + 1
  }
  // Memory export
  emit_name(content, mem_name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, sec_export, content)
}

// Emit export section with functions, memory, and globals
// Export kinds: 0=func, 1=table, 2=memory, 3=global
export let emit_exports_full = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {
  let count = Array::length(fn_names) + 1 + Array::length(global_names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  // Function exports
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(content, Array::get(fn_names, i))
    bytebuf_push(content, export_func)
    leb128_encode_u32(content, Array::get(fn_indices, i))
    i = i + 1
  }
  // Memory export
  emit_name(content, mem_name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  // Global exports
  let mut gi = 0
  while gi < Array::length(global_names) {
    emit_name(content, Array::get(global_names, gi))
    bytebuf_push(content, 3)  // export kind: global
    leb128_encode_u32(content, Array::get(global_indices, gi))
    gi = gi + 1
  }
  bytebuf_push_section(out, sec_export, content)
}

// === High-level: build a complete module ===

// Build a minimal WASM module with one exported function: add(i64, i64) -> i64
export let build_add_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 2, 1)
  emit_function_section(out, [0])
  emit_export_section(out, "add", 0)
  let body = bytebuf_new()
  emit_local_get(body, 0)
  emit_local_get(body, 1)
  emit_i64_add(body)
  emit_code_section(out, [body])
  bytebuf_to_bytes(out)
}

// Build a module with internal call: square(x) = x*x, sum_sq(a,b) = square(a) + square(b)
export let build_call_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // 2 types: type0 = (i64) -> (i64), type1 = (i64, i64) -> (i64)
  emit_type_section_multi(out, [1, 1, 2, 1])

  // 2 functions: func0=square(type0), func1=sum_sq(type1)
  emit_function_section(out, [0, 1])

  // export both
  emit_export_section_multi(out, ["square", "sum_sq"], [0, 1])

  // square: x * x
  let sq_body = bytebuf_new()
  emit_local_get(sq_body, 0)
  emit_local_get(sq_body, 0)
  emit_i64_mul(sq_body)

  // sum_sq: square(a) + square(b)
  let ss_body = bytebuf_new()
  emit_local_get(ss_body, 0)
  emit_call(ss_body, 0)  // call square
  emit_local_get(ss_body, 1)
  emit_call(ss_body, 0)  // call square
  emit_i64_add(ss_body)

  emit_code_section(out, [sq_body, ss_body])
  bytebuf_to_bytes(out)
}

// Build a module with add, sub, mul exported (all using same type: (i64, i64) -> i64)
export let build_arithmetic_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // 1 type: (i64, i64) -> (i64)
  emit_type_section(out, 2, 1)

  // 3 functions, all type 0
  emit_function_section(out, [0, 0, 0])

  // 3 exports
  emit_export_section_multi(out, ["add", "sub", "mul"], [0, 1, 2])

  // 3 function bodies
  let add_body = bytebuf_new()
  emit_local_get(add_body, 0)
  emit_local_get(add_body, 1)
  emit_i64_add(add_body)

  let sub_body = bytebuf_new()
  emit_local_get(sub_body, 0)
  emit_local_get(sub_body, 1)
  emit_i64_sub(sub_body)

  let mul_body = bytebuf_new()
  emit_local_get(mul_body, 0)
  emit_local_get(mul_body, 1)
  emit_i64_mul(mul_body)

  emit_code_section(out, [add_body, sub_body, mul_body])
  bytebuf_to_bytes(out)
}

// Build fibonacci module: fib(n) iterative
// params: n (local 0)
// locals: a (local 1), b (local 2), tmp (local 3)
// Algorithm: a=0, b=1, while(n>0) { tmp=a+b; a=b; b=tmp; n=n-1 }; return a
export let build_fibonacci_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // type0: (i64) -> (i64)
  emit_type_section(out, 1, 1)
  emit_function_section(out, [0])
  emit_export_section(out, "fib", 0)

  let b = bytebuf_new()
  // local 0 = n (param), locals 1=a, 2=b, 3=tmp

  // a = 0
  emit_i64_const(b, 0)
  emit_local_set(b, 1)
  // b = 1
  emit_i64_const(b, 1)
  emit_local_set(b, 2)

  // block $break
  emit_block_void(b)
    // loop $continue
    emit_loop_void(b)
      // if n <= 0, break
      emit_local_get(b, 0)
      emit_i64_const(b, 0)
      emit_i64_le_s(b)
      emit_br_if(b, 1)  // br $break (label 1 = outer block)

      // tmp = a + b
      emit_local_get(b, 1)
      emit_local_get(b, 2)
      emit_i64_add(b)
      emit_local_set(b, 3)
      // a = b
      emit_local_get(b, 2)
      emit_local_set(b, 1)
      // b = tmp
      emit_local_get(b, 3)
      emit_local_set(b, 2)
      // n = n - 1
      emit_local_get(b, 0)
      emit_i64_const(b, 1)
      emit_i64_sub(b)
      emit_local_set(b, 0)

      // br $continue (label 0 = loop)
      emit_br(b, 0)
    emit_end(b)  // end loop
  emit_end(b)    // end block

  // return a
  emit_local_get(b, 1)

  emit_code_section_with_locals(out, [b], [3])
  bytebuf_to_bytes(out)
}

// Build factorial module: fact(n) iterative
// params: n (local 0), locals: result (local 1)
// Algorithm: result=1, while(n>1) { result=result*n; n=n-1 }; return result
export let build_factorial_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  emit_type_section(out, 1, 1)
  emit_function_section(out, [0])
  emit_export_section(out, "fact", 0)

  let b = bytebuf_new()
  // result = 1
  emit_i64_const(b, 1)
  emit_local_set(b, 1)

  // block $break
  emit_block_void(b)
    // loop $continue
    emit_loop_void(b)
      // if n <= 1, break
      emit_local_get(b, 0)
      emit_i64_const(b, 1)
      emit_i64_le_s(b)
      emit_br_if(b, 1)

      // result = result * n
      emit_local_get(b, 1)
      emit_local_get(b, 0)
      emit_i64_mul(b)
      emit_local_set(b, 1)

      // n = n - 1
      emit_local_get(b, 0)
      emit_i64_const(b, 1)
      emit_i64_sub(b)
      emit_local_set(b, 0)

      emit_br(b, 0)
    emit_end(b)
  emit_end(b)

  // return result
  emit_local_get(b, 1)

  emit_code_section_with_locals(out, [b], [1])
  bytebuf_to_bytes(out)
}

// Build a WASI hello world module
// Imports fd_write from wasi_snapshot_preview1, writes "hello world\n" to stdout
export let build_hello_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // Type section:
  //   type0: fd_write(i32, i32, i32, i32) -> i32
  //   type1: _start() -> void
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [vt_i32, vt_i32, vt_i32, vt_i32], [vt_i32])
  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))
  bytebuf_push_section(out, sec_type, type_content)

  // Import section: fd_write from wasi_snapshot_preview1 (func index 0)
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)

  // Function section: _start is func index 1 (after 1 import), type 1
  emit_function_section(out, [1])

  // Memory section: 1 page
  emit_memory_section(out, 1)

  // Export section: _start + memory
  emit_exports_with_memory(out, ["_start"], [1], "memory", 0)

  // Code section: _start body (must come before data section)
  // Setup iovec at memory[0]: {ptr=8, len=12}
  // Then call fd_write(1, 0, 1, 100)
  //   fd=1 (stdout), iovs_ptr=0, iovs_count=1, nwritten_ptr=100
  let b = bytebuf_new()

  // mem[0] = 8 (iovec.buf pointer)
  emit_i32_const(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)

  // mem[4] = 12 (iovec.buf_len)
  emit_i32_const(b, 4)
  emit_i32_const(b, 12)
  emit_i32_store(b, 2, 0)

  // call fd_write(1, 0, 1, 100)
  emit_i32_const(b, 1)    // fd = stdout
  emit_i32_const(b, 0)    // iovs ptr
  emit_i32_const(b, 1)    // iovs count
  emit_i32_const(b, 100)  // nwritten ptr
  emit_call(b, 0)         // call fd_write (import index 0)
  emit_drop(b)            // discard return value

  emit_code_section(out, [b])

  // Data section: "hello world\n" at offset 8
  let hello_data = bytebuf_new()
  bytebuf_push(hello_data, 104)  // h
  bytebuf_push(hello_data, 101)  // e
  bytebuf_push(hello_data, 108)  // l
  bytebuf_push(hello_data, 108)  // l
  bytebuf_push(hello_data, 111)  // o
  bytebuf_push(hello_data, 32)   // ' '
  bytebuf_push(hello_data, 119)  // w
  bytebuf_push(hello_data, 111)  // o
  bytebuf_push(hello_data, 114)  // r
  bytebuf_push(hello_data, 108)  // l
  bytebuf_push(hello_data, 100)  // d
  bytebuf_push(hello_data, 10)   // \n
  emit_data_section(out, 8, hello_data)

  bytebuf_to_bytes(out)
}

// === String data helpers ===

// Convert a string to a byte array (ASCII only)
export let string_to_data = (s: String) -> Array[Int] {
  let buf = bytebuf_new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    bytebuf_push(buf, String::char_code_at(s, i))
    i = i + 1
  }
  buf
}

// Emit data section with multiple segments
export let emit_data_section_multi = (out: Array[Int], offsets: Array[Int], datas: Array[Array[Int]]) -> Unit {
  let count = Array::length(offsets)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    bytebuf_push(content, 0)  // active, memory 0
    emit_i32_const(content, Array::get(offsets, i))
    emit_end(content)
    let data = Array::get(datas, i)
    leb128_encode_u32(content, Array::length(data))
    bytebuf_push_array(content, data)
    i = i + 1
  }
  bytebuf_push_section(out, sec_data, content)
}

// Build a WASI module that prints a custom string
export let build_print_string_module = (msg: String) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // Types: fd_write(i32,i32,i32,i32)->i32, _start()->void
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [vt_i32, vt_i32, vt_i32, vt_i32], [vt_i32])
  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))
  bytebuf_push_section(out, sec_type, type_content)

  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)
  emit_function_section(out, [1])
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, ["_start"], [1], "memory", 0)

  // String data at offset 16 (leave 0-15 for iovec + nwritten)
  let str_data = string_to_data(msg)
  let str_len = Array::length(str_data)

  // Code: setup iovec and call fd_write
  let b = bytebuf_new()
  // iovec[0].buf = 16
  emit_i32_const(b, 0)
  emit_i32_const(b, 16)
  emit_i32_store(b, 2, 0)
  // iovec[0].len = str_len
  emit_i32_const(b, 4)
  emit_i32_const(b, str_len)
  emit_i32_store(b, 2, 0)
  // fd_write(stdout=1, iovs=0, count=1, nwritten=8)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)

  emit_code_section(out, [b])
  emit_data_section(out, 16, str_data)
  bytebuf_to_bytes(out)
}

// === f64 instructions ===

// f64.const — emit raw i64 bits as f64 constant
// Caller provides the raw i64 bits (from Double::to_i64_bits builtin)
export let emit_f64_const_bits = (buf: Array[Int], bits: Int) -> Unit {
  bytebuf_push9(buf, 68,
    bits & 255, (bits >> 8) & 255, (bits >> 16) & 255, (bits >> 24) & 255,
    (bits >> 32) & 255, (bits >> 40) & 255, (bits >> 48) & 255, (bits >> 56) & 255)
}

export let emit_f64_add = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_add)
}

export let emit_f64_sub = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_sub)
}

export let emit_f64_mul = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_mul)
}

export let emit_f64_div = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_div)
}

export let emit_f64_eq = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_eq)
}

export let emit_f64_ne = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_ne)
}

export let emit_f64_lt = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_lt)
}

export let emit_f64_gt = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_gt)
}

export let emit_f64_le = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_le)
}

export let emit_f64_ge = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_ge)
}

export let emit_f64_neg = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_neg)
}

// i64.reinterpret_f64 — reinterpret f64 bits as i64
export let emit_i64_reinterpret_f64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_reinterpret_f64)
}

// f64.reinterpret_i64 — reinterpret i64 bits as f64
export let emit_f64_reinterpret_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_reinterpret_i64)
}

// i64.trunc_f64_s — truncate f64 to signed i64
export let emit_i64_trunc_f64_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_i64_trunc_f64_s)
}

// f64.convert_i64_s — convert signed i64 to f64
export let emit_f64_convert_i64_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, op_f64_convert_i64_s)
}

// === Table and indirect call support ===

// call_indirect: opcode 0x11 + type_idx (LEB128) + table 0x00
export let emit_call_indirect = (buf: Array[Int], type_idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_call_indirect, type_idx)
  bytebuf_push(buf, 0)   // table index 0
}

// Emit table section (section 4): 1 funcref table with min=num_entries, no max
export let emit_table_section_funcref = (out: Array[Int], num_entries: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 table
  bytebuf_push2(content, type_funcref, 0)  // limits: no max
  leb128_encode_u32(content, num_entries)
  bytebuf_push_section(out, sec_table, content)
}

// Emit element section (section 9): active segment for table 0 at offset 0
// func_indices: array of function indices to place in table
export let emit_element_section_active = (out: Array[Int], func_indices: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 segment
  bytebuf_push(content, 0)  // flags: active, table 0
  // Offset expression: i32.const 0, end
  emit_i32_const(content, 0)
  emit_end(content)
  // Function indices
  leb128_encode_u32(content, Array::length(func_indices))
  let mut i = 0
  while i < Array::length(func_indices) {
    leb128_encode_u32(content, Array::get(func_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, sec_element, content)
}

// === GC instructions ===

// Emit a struct type definition: struct { field_types[i] with field_muts[i] }
// field_types: valtype bytes (0x7E=i64, 0x7F=i32, etc.)
// field_muts: 0x00=const, 0x01=mut
export let emit_struct_type_raw = (buf: Array[Int], field_types: Array[Int], field_muts: Array[Int]) -> Unit {
  bytebuf_push_opcode_u32(buf, 95, Array::length(field_types))
  let mut i = 0
  while i < Array::length(field_types) {
    bytebuf_push2(buf, Array::get(field_types, i), Array::get(field_muts, i))
    i = i + 1
  }
}

// struct.new $type — create a new struct (values on stack)
export let emit_struct_new = (buf: Array[Int], type_idx: Int) -> Unit {
  bytebuf_push_opcode_u32_u32(buf, 251, 0, type_idx)
}

// struct.get $type $field — read a struct field
export let emit_struct_get = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {
  bytebuf_push_opcode_u32_u32(buf, 251, 2, type_idx)
  leb128_encode_u32(buf, field_idx)
}

// struct.set $type $field — write a struct field
export let emit_struct_set = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {
  bytebuf_push_opcode_u32_u32(buf, 251, 5, type_idx)
  leb128_encode_u32(buf, field_idx)
}

// ref.func $func — get a typed function reference
export let emit_ref_func = (buf: Array[Int], func_idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, 210, func_idx)
}

// call_ref $type — call a function reference
export let emit_call_ref = (buf: Array[Int], type_idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, 20, type_idx)
}

// ref.null $heaptype — push a null reference
export let emit_ref_null = (buf: Array[Int], heap_type_byte: Int) -> Unit {
  bytebuf_push2(buf, 208, heap_type_byte)
}
