//# Functions

export let compile_match: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, ce) -> {
  let __match_scrutinee = get_match_scrutinee(expr)
  let __match_arms = get_match_arms(expr)
  let scrut_local = next_local
  Array::push(local_names, "__match_scrut")
  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)
  emit_local_set(buf, scrut_local)
  let num_arms = Array::length(__match_arms)
  let catchall_idx = find_catchall_idx(__match_arms)
  let num_cond_arms = catchall_idx
  let mut ai = 0
  let mut max_nl = nl1
  let names_len_at_match = Array::length(local_names)
  // #613 follow-up: discriminate literal sub-patterns at EVERY nesting level,
  // not just the top constructor-argument level. `load_field` is a thunk that
  // pushes the (tagged) value at this position; for each literal anywhere in the
  // sub-pattern tree we AND-in a field-vs-literal test. Without recursing,
  // `N(W(false), n)` matched `N(W(true), _)` (nested ctor only tag-tested) and
  // `T((false, n))` matched `T((true, _))` (tuple sub-patterns not tested at
  // all) — silent wrong results. An accumulator i32 always exists on the stack
  // before this runs (the enclosing ctor tag test), so every test ANDs (113).
  let rec emit_sub_tests: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {
    if is_pint(sp) {
      load_field()
      emit_i64_const(buf, get_pint_value(sp))
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      emit_i64_eq(buf)
      bytebuf_push(buf, 113)
    } else if is_pbool(sp) {
      load_field()
      emit_i64_const(buf, if get_pbool_value(sp) {
        1
      } else {
        0
      })
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      emit_i64_eq(buf)
      bytebuf_push(buf, 113)
    } else if is_pstring(sp) {
      let __sv = get_pstring_value(sp)
      let __si = str_table_lookup(ctx.str_table.strs, __sv)
      if __si >= 0 {
        let (__seq_fi, _, _) = resolve_func(ctx.func_table, "eq")
        load_field()
        emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))
        emit_call(buf, __seq_fi)
        emit_i32_wrap_i64(buf)
        bytebuf_push(buf, 113)
      }
    } else if is_pctor(sp) {
      let __ncname = get_pctor_name(sp)
      let __nci = lookup_ctor(ctx.ctor_table.names, __ncname, 0)
      let __ntag = if __nci >= 0 {
        Array::get(ctx.ctor_table.tags, __nci)
      } else {
        -1
      }
      load_field()
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 0)
      emit_i32_const(buf, __ntag)
      emit_i32_eq(buf)
      bytebuf_push(buf, 113)
      let __nargs = get_pctor_args(sp)
      let mut __nk = 0
      while __nk < Array::length(__nargs) {
        let __nkk = __nk
        let __nload: () -> Unit = () -> {
          load_field()
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + __nkk * 8)
        }
        emit_sub_tests(Array::get(__nargs, __nkk), __nload)
        __nk = __nk + 1
      }
    } else if is_ptuple(sp) {
      let __tpats = get_ptuple_pats(sp)
      let mut __tk = 0
      while __tk < Array::length(__tpats) {
        let __tkk = __tk
        let __tload: () -> Unit = () -> {
          load_field()
          if ctx.enable_rc {
            emit_i64_const(buf, -2)
            emit_i64_and(buf)
          }
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, if ctx.enable_rc {
            8 + __tkk * 8
          } else {
            __tkk * 8
          })
        }
        emit_sub_tests(Array::get(__tpats, __tkk), __tload)
        __tk = __tk + 1
      }
    } else {
      ()
    }
  }
  while ai < num_cond_arms {
    Array::truncate(local_names, names_len_at_match)
    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)
    let __cond_done = if is_pint(__cond_p) {
      emit_local_get(buf, scrut_local)
      emit_i64_const(buf, get_pint_value(__cond_p))
      // ADR-0055 Stage 1: scrutinee is a tagged int; tag the literal to match.
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      emit_i64_eq(buf)
      emit_if_i64(buf)
      0
    } else {
      if is_pbool(__cond_p) {
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, if get_pbool_value(__cond_p) {
          if ctx.enable_rc { 2 } else { 1 }
        } else {
          0
        })
        emit_i64_eq(buf)
        emit_if_i64(buf)
        0
      } else {
        if is_pctor(__cond_p) {
          let cname_cond = get_pctor_name(__cond_p)
          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)
          let expected_tag = if ctor_ci >= 0 {
            Array::get(ctx.ctor_table.tags, ctor_ci)
          } else {
            -1
          }
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf, 2, 0)
          emit_i32_const(buf, expected_tag)
          emit_i32_eq(buf)
          // #603/#608/#613: the tag test alone is not enough — literal
          // sub-patterns must be checked at EVERY nesting level, else
          // `I(1)`/`I("x")` match `I(2)`/`I("y")`, nested `N(W(false),_)` matches
          // `N(W(true),_)`, and tuple `T((false,_))` matches `T((true,_))`. AND-in
          // a recursive field-vs-literal test per constructor argument. Bindings
          // and wildcards add no test. This bug silently broke
          // `match stmt { SEnum(false, ...) => ... }` in the compiler's own
          // namespace pass, mis-namespacing exported enums.
          let __cargs_cond = get_pctor_args(__cond_p)
          let mut __ck = 0
          while __ck < Array::length(__cargs_cond) {
            let __ckk = __ck
            let __cload: () -> Unit = () -> {
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + __ckk * 8)
            }
            emit_sub_tests(Array::get(__cargs_cond, __ckk), __cload)
            __ck = __ck + 1
          }
          emit_if_i64(buf)
          0
        } else {
          if is_pstring(__cond_p) {
            let sval = get_pstring_value(__cond_p)
            let str_idx = str_table_lookup(ctx.str_table.strs, sval)
            if str_idx >= 0 {
              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
              emit_local_get(buf, scrut_local)
              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))
              emit_call(buf, str_eq_fi)
              emit_i32_wrap_i64(buf)
              emit_if_i64(buf)
            }
            0
          } else {
            let rec emit_or_check: (Pat) -> Unit = (pat) -> {
              match pat {
                POr(left, right) => {
                  emit_or_check(left)
                  emit_or_check(right)
                  bytebuf_push(buf, 114)
                },
                PInt(n) => {
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, n)
                  if ctx.enable_rc {
                    emit_i64_const(buf, 1)
                    emit_i64_shl(buf)
                  }
                  emit_i64_eq(buf)
                },
                PCtor(cname, cargs) => {
                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)
                  let ctag = if ci >= 0 {
                    Array::get(ctx.ctor_table.tags, ci)
                  } else {
                    -1
                  }
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, -2)
                  emit_i64_and(buf)
                  emit_i32_wrap_i64(buf)
                  emit_i32_load(buf, 2, 0)
                  emit_i32_const(buf, ctag)
                  emit_i32_eq(buf)
                  if Array::length(cargs) == 1 {
                    match Array::get(cargs, 0) {
                      PInt(n) => {
                        emit_local_get(buf, scrut_local)
                        emit_i64_const(buf, -2)
                        emit_i64_and(buf)
                        emit_i32_wrap_i64(buf)
                        emit_i64_load(buf, 3, 8)
                        emit_i64_const(buf, n)
                        if ctx.enable_rc {
                          emit_i64_const(buf, 1)
                          emit_i64_shl(buf)
                        }
                        emit_i64_eq(buf)
                        bytebuf_push(buf, 113)
                      },
                      _ => ()
                    }
                  }
                },
                _ => emit_i32_const(buf, 1)
              }
            }
            emit_or_check(__cond_p)
            emit_if_i64(buf)
            0
          }
        }
      }
    }
    // #cov branch: this conditional arm was taken (start of the if-then block).
    cov_emit_branch(buf, ctx.cov)
    let ld_arm = if ld >= 0 {
      ld + ai + 1
    } else {
      -1
    }
    let arm_nl = if is_pctor(__cond_p) {
      let cargs_bind = get_pctor_args(__cond_p)
      let mut cbi = 0
      while cbi < Array::length(cargs_bind) {
        let __sub_p = Array::get(cargs_bind, cbi)
        if is_pbind(__sub_p) {
          let pname = get_pbind_name(__sub_p)
          let fl = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + cbi * 8)
          emit_local_set(buf, fl)
          Array::push(local_names, pname)
        } else if is_ptuple(__sub_p) {
          let tpats = get_ptuple_pats(__sub_p)
          let tup_local = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + cbi * 8)
          emit_local_set(buf, tup_local)
          Array::push(local_names, "__ctor_tup")
          let mut ti = 0
          while ti < Array::length(tpats) {
            let tp = Array::get(tpats, ti)
            if is_pbind(tp) {
              let tpname = get_pbind_name(tp)
              let tfl = Array::length(local_names)
              emit_local_get(buf, tup_local)
              if ctx.enable_rc {
                emit_i64_const(buf, -2)
                emit_i64_and(buf)
              }
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + ti * 8 } else { ti * 8 })
              emit_local_set(buf, tfl)
              Array::push(local_names, tpname)
            }
            ti = ti + 1
          }
        } else if is_pctor(__sub_p) {
          // #608: bind the fields of a nested constructor sub-pattern (e.g. `x`
          // in `Some(x)`). Without this the inner binding is never emitted and
          // any use of it in the arm body traps codegen (resolve_local fails).
          // Load field cbi (the nested ctor, a tagged pointer), then load each
          // PBind sub-field at the nested ctor's own layout (clear tag, 8+j*8).
          let __nargs = get_pctor_args(__sub_p)
          let __ntmp = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + cbi * 8)
          emit_local_set(buf, __ntmp)
          Array::push(local_names, "__ctor_nested")
          let mut __nj = 0
          while __nj < Array::length(__nargs) {
            let __np = Array::get(__nargs, __nj)
            if is_pbind(__np) {
              let __npname = get_pbind_name(__np)
              let __nfl = Array::length(local_names)
              emit_local_get(buf, __ntmp)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + __nj * 8)
              emit_local_set(buf, __nfl)
              Array::push(local_names, __npname)
            }
            __nj = __nj + 1
          }
        }
        cbi = cbi + 1
      }
      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)
    } else {
      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)
    }
    if arm_nl > max_nl {
      max_nl = arm_nl
    }
    emit_else(buf)
    ai = ai + 1
  }
  Array::truncate(local_names, names_len_at_match)
  let ld_catch = if ld >= 0 {
    ld + num_cond_arms
  } else {
    -1
  }
  let catch_nl = if catchall_idx < num_arms {
    let __catch_arm = Array::get(__match_arms, catchall_idx)
    let (__catch_p, __catch_body) = __catch_arm
    0
    // #cov branch: the catch-all (none of the conditional arms matched). Only a
    // real decision point when there is at least one conditional arm.
    if num_cond_arms > 0 {
      cov_emit_branch(buf, ctx.cov)
    } else {
      ()
    }
    if is_pbind(__catch_p) {
      let bname = get_pbind_name(__catch_p)
      let bind_local = Array::length(local_names)
      emit_local_get(buf, scrut_local)
      emit_local_set(buf, bind_local)
      Array::push(local_names, bname)
      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
    } else {
      if is_pctor(__catch_p) {
        let cargs = get_pctor_args(__catch_p)
        let mut cbi2 = 0
        while cbi2 < Array::length(cargs) {
          let __sub_p2 = Array::get(cargs, cbi2)
          if is_pbind(__sub_p2) {
            let pname = get_pbind_name(__sub_p2)
            let fl2 = Array::length(local_names)
            emit_local_get(buf, scrut_local)
            emit_i64_const(buf, -2)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_i64_load(buf, 3, 8 + cbi2 * 8)
            emit_local_set(buf, fl2)
            Array::push(local_names, pname)
          }
          cbi2 = cbi2 + 1
        }
        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
      } else {
        if is_ptuple(__catch_p) {
          let pats = get_ptuple_pats(__catch_p)
          let ptr_local2 = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_local_set(buf, ptr_local2)
          Array::push(local_names, "__tup_ptr2")
          let mut pi2 = 0
          while pi2 < Array::length(pats) {
            let __tp = Array::get(pats, pi2)
            if is_pbind(__tp) {
              let pname = get_pbind_name(__tp)
              let field_l = Array::length(local_names)
              emit_local_get(buf, ptr_local2)
              if ctx.enable_rc {
                emit_i64_const(buf, -2)
                emit_i64_and(buf)
              }
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + pi2 * 8 } else { pi2 * 8 })
              emit_local_set(buf, field_l)
              Array::push(local_names, pname)
              0
            } else if is_ptuple(__tp) {
              let sub_pats = get_ptuple_pats(__tp)
              let sub_ptr = Array::length(local_names)
              emit_local_get(buf, ptr_local2)
              if ctx.enable_rc {
                emit_i64_const(buf, -2)
                emit_i64_and(buf)
              }
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + pi2 * 8 } else { pi2 * 8 })
              emit_local_set(buf, sub_ptr)
              Array::push(local_names, "__sub_tup")
              let mut si3 = 0
              while si3 < Array::length(sub_pats) {
                let sp = Array::get(sub_pats, si3)
                if is_pbind(sp) {
                  let spname = get_pbind_name(sp)
                  let sfl = Array::length(local_names)
                  emit_local_get(buf, sub_ptr)
                  if ctx.enable_rc {
                    emit_i64_const(buf, -2)
                    emit_i64_and(buf)
                  }
                  emit_i32_wrap_i64(buf)
                  emit_i64_load(buf, 3, if ctx.enable_rc { 8 + si3 * 8 } else { si3 * 8 })
                  emit_local_set(buf, sfl)
                  Array::push(local_names, spname)
                }
                si3 = si3 + 1
              }
              0
            } else {
              if is_pwild(__tp) {
                0
              } else {
                throw("unsupported pattern in tuple destructure")
              }
            }
            pi2 = pi2 + 1
          }
          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
        } else {
          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
        }
      }
    }
  } else {
    bytebuf_push(buf, 0)
    0
  }
  if catch_nl > max_nl {
    max_nl = catch_nl
  }
  let mut ci2 = 0
  while ci2 < num_cond_arms {
    emit_end(buf)
    ci2 = ci2 + 1
  }
  while Array::length(local_names) < max_nl {
    Array::push(local_names, "")
  }
  max_nl
}
