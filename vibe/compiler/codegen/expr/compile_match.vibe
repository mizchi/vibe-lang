//# Functions

// #613 follow-up: bind every `PBind` reachable under a container pattern
// (tuple or constructor) at ANY nesting depth, skipping literal / wildcard
// sub-patterns. `base_local` holds the (possibly tagged) pointer to the
// container whose fields hold the sub-pattern values. `is_ctor_layout`
// selects the field layout: a constructor stores its tag at offset 0 and
// fields at `8 + i*8` with the pointer always tag-cleared; a tuple stores
// fields at `8 + i*8` (RC, tagged) or `i*8` (non-RC, untagged). Used for
// conditional match arms whose top pattern is a bare tuple with literal
// siblings (`(false, n) => ..`), where the binding pass previously emitted
// nothing and any use of `n` trapped codegen with "undefined variable".
let md_emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 1)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 32)
  emit_i64_shr_s(buf)
  emit_i64_eqz(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
  emit_end(buf)
}

// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept in
// sync with is_borrow_arg0_call in perceus/index.vibe.
let md_is_borrow_arg0_call: (String) -> Bool = (f) -> {
  f == "__index" || f == "Array::get" || f == "Array::length" || f == "Array::set" || f == "Array::push" || f == "ArrayBuilder::push" || f == "MapBuilder::set" || f == "Map::get" || f == "Map::keys" || f == "Map::has_key" || f == "Map::set"
}

// Does `name` appear in a CONSUMING (owning) position anywhere in `e`? A matched
// heap field only needs its #702 dup when it is consumed; a field used only in
// borrow positions (or not at all) must NOT be dup'd or its reference leaks
// (#703). Every bare occurrence of `name` counts as a consume EXCEPT a direct
// `EIdent(name)` passed as arg0 of a borrow-arg0 builtin. This MUST enumerate
// every Expr variant (modeled on fold_expr): skipping recursion into any child
// could miss a real consume and wrongly suppress the dup -> double free. The
// default is therefore "consumed" (a safe over-dup / over-keep); shadowing a
// binding named `name` only over-counts, which is also safe.
let rec md_consumes: (Expr, String) -> Bool = (e, name) -> {
  match e {
    EInt(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EBool(_) => false,
    EUnit => false,
    EStringInterp(_) => false,
    EIdent(n, _) => n == name,
    ETuple(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) {
        if md_consumes(Array::get(items, i), name) { found = true } else { () }
        i = i + 1
      }
      found
    },
    EArray(items) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(items) {
        if md_consumes(Array::get(items, i), name) { found = true } else { () }
        i = i + 1
      }
      found
    },
    ERecord(fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if md_consumes(v, name) { found = true } else { () }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if md_consumes(v, name) { found = true } else { () }
        i = i + 1
      }
      found
    },
    EIf(c, t, el) => md_consumes(c, name) || md_consumes(t, name) || md_consumes(el, name),
    ELet(_, v, b) => md_consumes(v, name) || md_consumes(b, name),
    ELetRec(_, v, b) => md_consumes(v, name) || md_consumes(b, name),
    ELetMut(_, v, b) => md_consumes(v, name) || md_consumes(b, name),
    EAssign(_, v, b) => md_consumes(v, name) || md_consumes(b, name),
    EAssignOp(_, _, v, b) => md_consumes(v, name) || md_consumes(b, name),
    ESeq(a, b) => md_consumes(a, name) || md_consumes(b, name),
    EMatch(s, arms) => {
      let mut found = md_consumes(s, name)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, v) = Array::get(arms, i)
        if md_consumes(v, name) { found = true } else { () }
        i = i + 1
      }
      found
    },
    EHandle(s, arms) => {
      let mut found = md_consumes(s, name)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, v) = Array::get(arms, i)
        if md_consumes(v, name) { found = true } else { () }
        i = i + 1
      }
      found
    },
    EWhile(c, b) => md_consumes(c, name) || md_consumes(b, name),
    ELoop(params, b) => {
      let mut found = md_consumes(b, name)
      let mut i = 0
      while i < Array::length(params) {
        let (_, v) = Array::get(params, i)
        if md_consumes(v, name) { found = true } else { () }
        i = i + 1
      }
      found
    },
    EForIn(_, _, it, b) => md_consumes(it, name) || md_consumes(b, name),
    ECall(callee, args, _) => {
      let borrow0 = match callee {
        EIdent(f, _) => md_is_borrow_arg0_call(f),
        _ => false
      }
      let start = if borrow0 && Array::length(args) >= 1 {
        // arg0 is a borrow position: a bare `EIdent(name)` there does not
        // consume, but a sub-expression that mentions name still does.
        1
      } else {
        0
      }
      let head = if start == 1 {
        match Array::get(args, 0) {
          EIdent(_, _) => false,
          _ => md_consumes(Array::get(args, 0), name)
        }
      } else {
        false
      }
      let mut found = md_consumes(callee, name) || head
      let mut ri = start
      while ri < Array::length(args) {
        if md_consumes(Array::get(args, ri), name) { found = true } else { () }
        ri = ri + 1
      }
      found
    },
    EBinOp(_, l, r) => md_consumes(l, name) || md_consumes(r, name),
    EUnaryOp(_, x) => md_consumes(x, name),
    EFn(_, _, _, _, _, body) => md_consumes(body, name),
    EDot(x, _, _) => md_consumes(x, name),
    ELabeledArg(_, _, v) => md_consumes(v, name),
    EThrow(x) => md_consumes(x, name),
    EReturn(x) => md_consumes(x, name),
    EBreak(opt) => match opt {
      Some(v) => md_consumes(v, name),
      None => false
    },
    EContinue(args) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(args) {
        if md_consumes(Array::get(args, i), name) { found = true } else { () }
        i = i + 1
      }
      found
    },
    ESpread(x) => md_consumes(x, name)
  }
}

let rec bind_match_pat: (Bytes, Int, Pat, Bool, Array[String], CompileCtx) -> Unit = (buf, base_local, container_pat, is_ctor_layout, local_names, ctx) -> {
  let elems = if is_ctor_layout {
    get_pctor_args(container_pat)
  } else {
    get_ptuple_pats(container_pat)
  }
  let mut i = 0
  while i < Array::length(elems) {
    let ep = Array::get(elems, i)
    let off = if is_ctor_layout {
      8 + i * 8
    } else if ctx.enable_rc {
      8 + i * 8
    } else {
      i * 8
    }
    let clear_tag = is_ctor_layout || ctx.enable_rc
    if is_pbind(ep) {
      let nm = get_pbind_name(ep)
      let fl = Array::length(local_names)
      emit_local_get(buf, base_local)
      if clear_tag {
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
      } else {
        ()
      }
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, off)
      emit_local_set(buf, fl)
      Array::push(local_names, nm)
    } else if is_ptuple(ep) {
      let sl = Array::length(local_names)
      emit_local_get(buf, base_local)
      if clear_tag {
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
      } else {
        ()
      }
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, off)
      emit_local_set(buf, sl)
      Array::push(local_names, "__bind_sub")
      bind_match_pat(buf, sl, ep, false, local_names, ctx)
    } else if is_pctor(ep) {
      let sl = Array::length(local_names)
      emit_local_get(buf, base_local)
      if clear_tag {
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
      } else {
        ()
      }
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, off)
      emit_local_set(buf, sl)
      Array::push(local_names, "__bind_sub")
      bind_match_pat(buf, sl, ep, true, local_names, ctx)
    } else {
      ()
    }
    i = i + 1
  }
}

// The index of `field` WITHIN the struct named `sname`. A struct value lays its
// fields out exactly like a constructor — tag/header at 0, field i at `8 + i*8`,
// pointer tag-cleared — so the offset is `8 + index*8`, identical to what
// `obj.field` reads. The matched struct name MUST drive the lookup: two structs
// can share a field name at different positions (`A { x; y }` vs `B { y; x }`),
// so a name-agnostic "first struct that declares the field" scan binds the wrong
// offset. Only when `sname` is not in the table do we fall back to that scan.
let find_struct_index: (CompileCtx, String) -> Int = (ctx, sname) -> {
  let names = ctx.ctor_table.struct_names
  let mut si = 0
  let mut sidx = -1
  while si < Array::length(names) {
    if Array::get(names, si) == sname {
      sidx = si
      si = Array::length(names)
    } else {
      si = si + 1
    }
  }
  sidx
}

let field_index_in: (Array[String], String) -> Int = (fnames, field) -> {
  let mut fi = 0
  let mut found = -1
  while fi < Array::length(fnames) {
    if Array::get(fnames, fi) == field {
      found = fi
      fi = Array::length(fnames)
    } else {
      fi = fi + 1
    }
  }
  found
}

let struct_field_index: (CompileCtx, String, String) -> Int with { Error } = (ctx, sname, field) -> {
  let sidx = find_struct_index(ctx, sname)
  if sidx >= 0 {
    let found = field_index_in(Array::get(ctx.ctor_table.struct_field_names, sidx), field)
    if found < 0 {
      throw(String::concat(String::concat(String::concat("unknown field `", field), "` in struct "), sname))
    } else {
      found
    }
  } else {
    // `sname` not found in the struct table: fall back to the legacy global
    // first-match scan so unqualified / synthetic names still resolve.
    let names = ctx.ctor_table.struct_names
    let mut gsi = 0
    let mut gfound = -1
    while gsi < Array::length(names) {
      let f = field_index_in(Array::get(ctx.ctor_table.struct_field_names, gsi), field)
      if f >= 0 {
        gfound = f
        gsi = Array::length(names)
      } else {
        gsi = gsi + 1
      }
    }
    if gfound < 0 {
      throw(String::concat("unknown struct field in pattern: ", field))
    } else {
      gfound
    }
  }
}

// Bind every variable in a struct pattern `S::{ f1: p1, f2: p2, ... }` whose
// value is the (tagged) struct pointer in `base_local`. Each field is loaded by
// NAME (offset `8 + struct_field_index*8`), then its sub-pattern is bound:
// a `PBind` becomes a local; a tuple/constructor sub-pattern recurses through
// the positional `bind_match_pat`; a nested struct recurses here. Literal /
// wildcard sub-patterns bind nothing (a struct pattern with a literal field is
// refutable and is not routed here — see `is_catchall_pat`).
let rec bind_struct_pat: (Bytes, Int, String, Array[(String, Pat)], Array[String], CompileCtx) -> Unit with { Error } = (buf, base_local, sname, fields, local_names, ctx) -> {
  let mut i = 0
  while i < Array::length(fields) {
    let (fname, subpat) = Array::get(fields, i)
    let off = 8 + struct_field_index(ctx, sname, fname) * 8
    if is_pbind(subpat) {
      let nm = get_pbind_name(subpat)
      let fl = Array::length(local_names)
      emit_local_get(buf, base_local)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, off)
      emit_local_set(buf, fl)
      Array::push(local_names, nm)
    } else if is_ptuple(subpat) {
      let sl = Array::length(local_names)
      emit_local_get(buf, base_local)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, off)
      emit_local_set(buf, sl)
      Array::push(local_names, "__bind_sub")
      bind_match_pat(buf, sl, subpat, false, local_names, ctx)
    } else if is_pctor(subpat) {
      let sl = Array::length(local_names)
      emit_local_get(buf, base_local)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, off)
      emit_local_set(buf, sl)
      Array::push(local_names, "__bind_sub")
      bind_match_pat(buf, sl, subpat, true, local_names, ctx)
    } else {
      match subpat {
        PStruct(__sname, sfields) => {
          let sl = Array::length(local_names)
          emit_local_get(buf, base_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, off)
          emit_local_set(buf, sl)
          Array::push(local_names, "__bind_sub")
          bind_struct_pat(buf, sl, __sname, sfields, local_names, ctx)
        },
        _ => ()
      }
    }
    i = i + 1
  }
}

export let compile_match: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, ce) -> {
  let __match_scrutinee = get_match_scrutinee(expr)
  let __match_arms = get_match_arms(expr)
  let scrut_local = next_local
  Array::push(local_names, "__match_scrut")
  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)
  emit_local_set(buf, scrut_local)
  let num_arms = Array::length(__match_arms)
  let catchall_idx = find_catchall_idx(__match_arms)
  let num_cond_arms = catchall_idx
  let mut ai = 0
  let mut max_nl = nl1
  let names_len_at_match = Array::length(local_names)
  // #613 follow-up: discriminate literal sub-patterns at EVERY nesting level,
  // not just the top constructor-argument level. `load_field` is a thunk that
  // pushes the (tagged) value at this position. `emit_pat_test` emits a single
  // i32 boolean ("does the value at this position match `sp`?") with NO trailing
  // AND, recursing through ctor args, tuple elements, and or-branches. Without
  // recursing, `N(W(false), n)` matched `N(W(true), _)`, `T((false, n))` matched
  // `T((true, _))`, and or-branches `(1, _) | (2, _)` / `"a" | "b"` matched
  // anything — silent wrong results. Bindings/wildcards always match (push 1).
  let rec emit_pat_test: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {
    match sp {
      POr(__l, __r) => {
        // (left matches) OR (right matches) at this same position.
        emit_pat_test(__l, load_field)
        emit_pat_test(__r, load_field)
        bytebuf_push(buf, 114)
      },
      _ => {
        if is_pint(sp) {
          load_field()
          emit_i64_const(buf, get_pint_value(sp))
          if ctx.enable_rc {
            emit_i64_const(buf, 1)
            emit_i64_shl(buf)
          }
          emit_i64_eq(buf)
        } else if is_pbool(sp) {
          load_field()
          emit_i64_const(buf, if get_pbool_value(sp) {
            1
          } else {
            0
          })
          if ctx.enable_rc {
            emit_i64_const(buf, 1)
            emit_i64_shl(buf)
          }
          emit_i64_eq(buf)
        } else if is_pstring(sp) {
          let __sv = get_pstring_value(sp)
          let __si = str_table_lookup(ctx.str_table.strs, __sv)
          if __si >= 0 {
            let (__seq_fi, _, _) = resolve_func(ctx.func_table, "eq")
            load_field()
            emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))
            emit_call(buf, __seq_fi)
            emit_i32_wrap_i64(buf)
          } else {
            // String literal absent from the table: conservatively match (the
            // prior behavior emitted no test at all).
            emit_i32_const(buf, 1)
          }
        } else if is_pctor(sp) {
          let __ncname = get_pctor_name(sp)
          let __nci = lookup_ctor(ctx.ctor_table.names, __ncname, 0)
          let __ntag = if __nci >= 0 {
            Array::get(ctx.ctor_table.tags, __nci)
          } else {
            -1
          }
          load_field()
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf, 2, 0)
          emit_i32_const(buf, __ntag)
          emit_i32_eq(buf)
          let __nargs = get_pctor_args(sp)
          let mut __nk = 0
          while __nk < Array::length(__nargs) {
            let __nkk = __nk
            let __nload: () -> Unit = () -> {
              load_field()
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + __nkk * 8)
            }
            emit_pat_test(Array::get(__nargs, __nkk), __nload)
            bytebuf_push(buf, 113)
            __nk = __nk + 1
          }
        } else if is_ptuple(sp) {
          emit_i32_const(buf, 1)
          let __tpats = get_ptuple_pats(sp)
          let mut __tk = 0
          while __tk < Array::length(__tpats) {
            let __tkk = __tk
            let __tload: () -> Unit = () -> {
              load_field()
              if ctx.enable_rc {
                emit_i64_const(buf, -2)
                emit_i64_and(buf)
              }
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, if ctx.enable_rc {
                8 + __tkk * 8
              } else {
                __tkk * 8
              })
            }
            emit_pat_test(Array::get(__tpats, __tkk), __tload)
            bytebuf_push(buf, 113)
            __tk = __tk + 1
          }
        } else {
          // PBind / PWild: always matches.
          emit_i32_const(buf, 1)
        }
      }
    }
  }
  // AND a position's match test onto the accumulator already on the stack.
  // Bindings/wildcards add no constraint, so they emit nothing (keeping the
  // accumulator untouched) rather than `const 1; and`.
  let emit_sub_tests: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {
    if is_pbind(sp) || is_pwild(sp) {
      ()
    } else {
      emit_pat_test(sp, load_field)
      bytebuf_push(buf, 113)
    }
  }
  while ai < num_cond_arms {
    Array::truncate(local_names, names_len_at_match)
    // #678: a previous arm may have logged integral slots >= names_len_at_match
    // that this arm's pattern binders (non-`let`, so they log nothing) reuse;
    // drop them so a string bound there is not misread as int by `==`.
    int_log_reset_above(ctx, names_len_at_match)
    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)
    let __cond_done = if is_pint(__cond_p) {
      emit_local_get(buf, scrut_local)
      emit_i64_const(buf, get_pint_value(__cond_p))
      // ADR-0055 Stage 1: scrutinee is a tagged int; tag the literal to match.
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      emit_i64_eq(buf)
      emit_if_i64(buf)
      0
    } else {
      if is_pbool(__cond_p) {
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, if get_pbool_value(__cond_p) {
          if ctx.enable_rc { 2 } else { 1 }
        } else {
          0
        })
        emit_i64_eq(buf)
        emit_if_i64(buf)
        0
      } else {
        if is_pctor(__cond_p) {
          let cname_cond = get_pctor_name(__cond_p)
          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)
          let expected_tag = if ctor_ci >= 0 {
            Array::get(ctx.ctor_table.tags, ctor_ci)
          } else {
            -1
          }
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf, 2, 0)
          emit_i32_const(buf, expected_tag)
          emit_i32_eq(buf)
          // #603/#608/#613: the tag test alone is not enough — literal
          // sub-patterns must be checked at EVERY nesting level, else
          // `I(1)`/`I("x")` match `I(2)`/`I("y")`, nested `N(W(false),_)` matches
          // `N(W(true),_)`, and tuple `T((false,_))` matches `T((true,_))`. AND-in
          // a recursive field-vs-literal test per constructor argument. Bindings
          // and wildcards add no test. This bug silently broke
          // `match stmt { SEnum(false, ...) => ... }` in the compiler's own
          // namespace pass, mis-namespacing exported enums.
          let __cargs_cond = get_pctor_args(__cond_p)
          let mut __ck = 0
          while __ck < Array::length(__cargs_cond) {
            let __ckk = __ck
            let __cload: () -> Unit = () -> {
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + __ckk * 8)
            }
            emit_sub_tests(Array::get(__cargs_cond, __ckk), __cload)
            __ck = __ck + 1
          }
          emit_if_i64(buf)
          0
        } else {
          if is_pstring(__cond_p) {
            let sval = get_pstring_value(__cond_p)
            let str_idx = str_table_lookup(ctx.str_table.strs, sval)
            if str_idx >= 0 {
              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
              emit_local_get(buf, scrut_local)
              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))
              emit_call(buf, str_eq_fi)
              emit_i32_wrap_i64(buf)
              emit_if_i64(buf)
            }
            0
          } else if is_ptuple(__cond_p) {
            // A bare tuple cond pattern (`(false, n) => ..`) has no tag to test;
            // previously it fell through to `emit_or_check`'s `_ => const 1`,
            // making the arm UNCONDITIONALLY match — `(false, n)` matched
            // `(true, 5)` (silent wrong result, the #613 unsoundness for bare
            // tuples). Start from a `true` accumulator and AND-in a recursive
            // field-vs-literal test for every literal element (binds/wildcards
            // add no test, so an all-bind tuple stays always-true).
            emit_i32_const(buf, 1)
            let __tpats_cond = get_ptuple_pats(__cond_p)
            let mut __tck = 0
            while __tck < Array::length(__tpats_cond) {
              let __tckk = __tck
              let __tcload: () -> Unit = () -> {
                emit_local_get(buf, scrut_local)
                if ctx.enable_rc {
                  emit_i64_const(buf, -2)
                  emit_i64_and(buf)
                } else {
                  ()
                }
                emit_i32_wrap_i64(buf)
                emit_i64_load(buf, 3, if ctx.enable_rc {
                  8 + __tckk * 8
                } else {
                  __tckk * 8
                })
              }
              emit_sub_tests(Array::get(__tpats_cond, __tckk), __tcload)
              __tck = __tck + 1
            }
            emit_if_i64(buf)
            0
          } else {
            let rec emit_or_check: (Pat) -> Unit = (pat) -> {
              match pat {
                POr(left, right) => {
                  emit_or_check(left)
                  emit_or_check(right)
                  bytebuf_push(buf, 114)
                },
                PInt(n) => {
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, n)
                  if ctx.enable_rc {
                    emit_i64_const(buf, 1)
                    emit_i64_shl(buf)
                  }
                  emit_i64_eq(buf)
                },
                PCtor(cname, cargs) => {
                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)
                  let ctag = if ci >= 0 {
                    Array::get(ctx.ctor_table.tags, ci)
                  } else {
                    -1
                  }
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, -2)
                  emit_i64_and(buf)
                  emit_i32_wrap_i64(buf)
                  emit_i32_load(buf, 2, 0)
                  emit_i32_const(buf, ctag)
                  emit_i32_eq(buf)
                  if Array::length(cargs) == 1 {
                    match Array::get(cargs, 0) {
                      PInt(n) => {
                        emit_local_get(buf, scrut_local)
                        emit_i64_const(buf, -2)
                        emit_i64_and(buf)
                        emit_i32_wrap_i64(buf)
                        emit_i64_load(buf, 3, 8)
                        emit_i64_const(buf, n)
                        if ctx.enable_rc {
                          emit_i64_const(buf, 1)
                          emit_i64_shl(buf)
                        }
                        emit_i64_eq(buf)
                        bytebuf_push(buf, 113)
                      },
                      _ => ()
                    }
                  }
                },
                PBool(b) => {
                  // An or-branch boolean literal (`true | ..`) previously fell
                  // through to `_ => const 1` (always-true), so `"a"|"b"` /
                  // `(1,_)|(2,_)` / bool ors silently matched everything.
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, if b {
                    if ctx.enable_rc { 2 } else { 1 }
                  } else {
                    0
                  })
                  emit_i64_eq(buf)
                },
                PString(sv) => {
                  let __si = str_table_lookup(ctx.str_table.strs, sv)
                  if __si >= 0 {
                    let (__eqfi, _, _) = resolve_func(ctx.func_table, "eq")
                    emit_local_get(buf, scrut_local)
                    emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))
                    emit_call(buf, __eqfi)
                    emit_i32_wrap_i64(buf)
                  } else {
                    emit_i32_const(buf, 1)
                  }
                },
                PTuple(tpats) => {
                  // A tuple or-branch (`(1, _) | (2, _)`): no tag to test, so
                  // start from `true` and AND-in a field-vs-literal test for
                  // every literal element (binds/wildcards add none).
                  emit_i32_const(buf, 1)
                  let mut __ok = 0
                  while __ok < Array::length(tpats) {
                    let __okk = __ok
                    let __oload: () -> Unit = () -> {
                      emit_local_get(buf, scrut_local)
                      if ctx.enable_rc {
                        emit_i64_const(buf, -2)
                        emit_i64_and(buf)
                      } else {
                        ()
                      }
                      emit_i32_wrap_i64(buf)
                      emit_i64_load(buf, 3, if ctx.enable_rc {
                        8 + __okk * 8
                      } else {
                        __okk * 8
                      })
                    }
                    emit_sub_tests(Array::get(tpats, __okk), __oload)
                    __ok = __ok + 1
                  }
                },
                _ => emit_i32_const(buf, 1)
              }
            }
            emit_or_check(__cond_p)
            emit_if_i64(buf)
            0
          }
        }
      }
    }
    // #cov branch: this conditional arm was taken (start of the if-then block).
    cov_emit_branch(buf, ctx.cov)
    let ld_arm = if ld >= 0 {
      ld + ai + 1
    } else {
      -1
    }
    let arm_nl = if is_pctor(__cond_p) {
      let cargs_bind = get_pctor_args(__cond_p)
      // #703: the #702 dup of a matched heap field is only balanced when the
      // field is CONSUMED in the arm body (passed to an owning position). A
      // field that is unused, or used only in borrow positions (e.g. only as the
      // borrowed arg0 of Array::get/length), is reclaimed by the scrutinee's
      // recursive drop — dup'ing it there leaks one reference per match. Gate the
      // dup on `md_consumes` (conservative: any non-borrow occurrence counts, so
      // a genuine consume can never be mis-skipped into a double-free).
      let mut cbi = 0
      while cbi < Array::length(cargs_bind) {
        let __sub_p = Array::get(cargs_bind, cbi)
        if is_pbind(__sub_p) {
          let pname = get_pbind_name(__sub_p)
          let fl = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + cbi * 8)
          emit_local_set(buf, fl)
          // #702 Blocker B: a matched ctor field is a borrowed view sharing the
          // scrutinee's refcount. Dup it so consuming the binding (e.g. passing
          // it to a fn that drops it) and the scrutinee's own recursive drop
          // don't free the same block twice (double-free -> trap). Scalar fields
          // are even, so __rc_drop's odd-check makes the dup a no-op for them.
          if ctx.enable_rc && md_consumes(__arm_body, pname) {
            md_emit_rc_dup_guarded(buf, fl)
          } else {
            ()
          }
          Array::push(local_names, pname)
        } else if is_ptuple(__sub_p) {
          let tpats = get_ptuple_pats(__sub_p)
          let tup_local = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + cbi * 8)
          emit_local_set(buf, tup_local)
          Array::push(local_names, "__ctor_tup")
          let mut ti = 0
          while ti < Array::length(tpats) {
            let tp = Array::get(tpats, ti)
            if is_pbind(tp) {
              let tpname = get_pbind_name(tp)
              let tfl = Array::length(local_names)
              emit_local_get(buf, tup_local)
              if ctx.enable_rc {
                emit_i64_const(buf, -2)
                emit_i64_and(buf)
              }
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + ti * 8 } else { ti * 8 })
              emit_local_set(buf, tfl)
              if ctx.enable_rc && md_consumes(__arm_body, tpname) {
                md_emit_rc_dup_guarded(buf, tfl)
              } else {
                ()
              }
              Array::push(local_names, tpname)
            }
            ti = ti + 1
          }
        } else if is_pctor(__sub_p) {
          // #608: bind the fields of a nested constructor sub-pattern (e.g. `x`
          // in `Some(x)`). Without this the inner binding is never emitted and
          // any use of it in the arm body traps codegen (resolve_local fails).
          // Load field cbi (the nested ctor, a tagged pointer), then load each
          // PBind sub-field at the nested ctor's own layout (clear tag, 8+j*8).
          let __nargs = get_pctor_args(__sub_p)
          let __ntmp = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + cbi * 8)
          emit_local_set(buf, __ntmp)
          Array::push(local_names, "__ctor_nested")
          let mut __nj = 0
          while __nj < Array::length(__nargs) {
            let __np = Array::get(__nargs, __nj)
            if is_pbind(__np) {
              let __npname = get_pbind_name(__np)
              let __nfl = Array::length(local_names)
              emit_local_get(buf, __ntmp)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + __nj * 8)
              emit_local_set(buf, __nfl)
              if ctx.enable_rc && md_consumes(__arm_body, __npname) {
                md_emit_rc_dup_guarded(buf, __nfl)
              } else {
                ()
              }
              Array::push(local_names, __npname)
            }
            __nj = __nj + 1
          }
        }
        cbi = cbi + 1
      }
      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)
    } else if is_ptuple(__cond_p) {
      // A bare tuple arm pattern with literal siblings (`(false, n) => ..`):
      // discrimination already tested the literals above, but the binding pass
      // emitted nothing here, so `n` was undefined. Load the scrutinee tuple
      // pointer and bind every reachable PBind (skipping literals/wildcards).
      let tup_ptr = Array::length(local_names)
      emit_local_get(buf, scrut_local)
      emit_local_set(buf, tup_ptr)
      Array::push(local_names, "__cond_tup")
      bind_match_pat(buf, tup_ptr, __cond_p, false, local_names, ctx)
      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)
    } else {
      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)
    }
    if arm_nl > max_nl {
      max_nl = arm_nl
    }
    emit_else(buf)
    ai = ai + 1
  }
  Array::truncate(local_names, names_len_at_match)
  // #678: same prune before the catch-all arm's pattern binders reuse the slots.
  int_log_reset_above(ctx, names_len_at_match)
  let ld_catch = if ld >= 0 {
    ld + num_cond_arms
  } else {
    -1
  }
  let catch_nl = if catchall_idx < num_arms {
    let __catch_arm = Array::get(__match_arms, catchall_idx)
    let (__catch_p, __catch_body) = __catch_arm
    0
    // #cov branch: the catch-all (none of the conditional arms matched). Only a
    // real decision point when there is at least one conditional arm.
    if num_cond_arms > 0 {
      cov_emit_branch(buf, ctx.cov)
    } else {
      ()
    }
    if is_pbind(__catch_p) {
      let bname = get_pbind_name(__catch_p)
      let bind_local = Array::length(local_names)
      emit_local_get(buf, scrut_local)
      emit_local_set(buf, bind_local)
      Array::push(local_names, bname)
      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
    } else {
      if is_pctor(__catch_p) {
        let cargs = get_pctor_args(__catch_p)
        let mut cbi2 = 0
        while cbi2 < Array::length(cargs) {
          let __sub_p2 = Array::get(cargs, cbi2)
          if is_pbind(__sub_p2) {
            let pname = get_pbind_name(__sub_p2)
            let fl2 = Array::length(local_names)
            emit_local_get(buf, scrut_local)
            emit_i64_const(buf, -2)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_i64_load(buf, 3, 8 + cbi2 * 8)
            emit_local_set(buf, fl2)
            Array::push(local_names, pname)
          }
          cbi2 = cbi2 + 1
        }
        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
      } else {
        if is_ptuple(__catch_p) {
          let pats = get_ptuple_pats(__catch_p)
          let ptr_local2 = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_local_set(buf, ptr_local2)
          Array::push(local_names, "__tup_ptr2")
          let mut pi2 = 0
          while pi2 < Array::length(pats) {
            let __tp = Array::get(pats, pi2)
            if is_pbind(__tp) {
              let pname = get_pbind_name(__tp)
              let field_l = Array::length(local_names)
              emit_local_get(buf, ptr_local2)
              if ctx.enable_rc {
                emit_i64_const(buf, -2)
                emit_i64_and(buf)
              }
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + pi2 * 8 } else { pi2 * 8 })
              emit_local_set(buf, field_l)
              Array::push(local_names, pname)
              0
            } else if is_ptuple(__tp) {
              let sub_pats = get_ptuple_pats(__tp)
              let sub_ptr = Array::length(local_names)
              emit_local_get(buf, ptr_local2)
              if ctx.enable_rc {
                emit_i64_const(buf, -2)
                emit_i64_and(buf)
              }
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + pi2 * 8 } else { pi2 * 8 })
              emit_local_set(buf, sub_ptr)
              Array::push(local_names, "__sub_tup")
              let mut si3 = 0
              while si3 < Array::length(sub_pats) {
                let sp = Array::get(sub_pats, si3)
                if is_pbind(sp) {
                  let spname = get_pbind_name(sp)
                  let sfl = Array::length(local_names)
                  emit_local_get(buf, sub_ptr)
                  if ctx.enable_rc {
                    emit_i64_const(buf, -2)
                    emit_i64_and(buf)
                  }
                  emit_i32_wrap_i64(buf)
                  emit_i64_load(buf, 3, if ctx.enable_rc { 8 + si3 * 8 } else { si3 * 8 })
                  emit_local_set(buf, sfl)
                  Array::push(local_names, spname)
                }
                si3 = si3 + 1
              }
              0
            } else {
              if is_pwild(__tp) {
                0
              } else {
                throw("unsupported pattern in tuple destructure")
              }
            }
            pi2 = pi2 + 1
          }
          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
        } else {
          match __catch_p {
            PStruct(__sname, __sfields) => {
              // An irrefutable struct pattern `S::{ x, y }` as the catch-all arm:
              // bind every field by name from the scrutinee struct pointer.
              let __sp_ptr = Array::length(local_names)
              emit_local_get(buf, scrut_local)
              emit_local_set(buf, __sp_ptr)
              Array::push(local_names, "__struct_ptr")
              bind_struct_pat(buf, __sp_ptr, __sname, __sfields, local_names, ctx)
              ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
            },
            _ => ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
          }
        }
      }
    }
  } else {
    bytebuf_push(buf, 0)
    0
  }
  if catch_nl > max_nl {
    max_nl = catch_nl
  }
  let mut ci2 = 0
  while ci2 < num_cond_arms {
    emit_end(buf)
    ci2 = ci2 + 1
  }
  while Array::length(local_names) < max_nl {
    Array::push(local_names, "")
  }
  max_nl
}
