  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data
}

//# Functions

export let compile_match = (buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {
  let __match_scrutinee = get_match_scrutinee(expr)
  let __match_arms = get_match_arms(expr)
  let scrut_local = next_local
  Array::push(local_names, "__match_scrut")
  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)
  emit_local_set(buf, scrut_local)
  let num_arms = Array::length(__match_arms)
  let catchall_idx = find_catchall_idx(__match_arms)
  let num_cond_arms = catchall_idx
  let mut ai = 0
  let mut max_nl = nl1
  let names_len_at_match = Array::length(local_names)
  while ai < num_cond_arms {
    Array::truncate(local_names, names_len_at_match)
    let __cond_p = get_arm_pat(Array::get(__match_arms, ai))
    let __cond_done = if is_pint(__cond_p) {
      emit_local_get(buf, scrut_local)
      emit_i64_const(buf, get_pint_value(__cond_p))
      emit_i64_eq(buf)
      emit_if_i64(buf)
      0
    } else {
      if is_pbool(__cond_p) {
        emit_local_get(buf, scrut_local)
        emit_i64_const(buf, if get_pbool_value(__cond_p) {
          1
        } else {
          0
        })
        emit_i64_eq(buf)
        emit_if_i64(buf)
        0
      } else {
        if is_pctor(__cond_p) {
          let cname_cond = get_pctor_name(__cond_p)
          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)
          let expected_tag = if ctor_ci >= 0 {
            Array::get(ctx.ctor_table.tags, ctor_ci)
          } else {
            -1
          }
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf, 2, 0)
          emit_i32_const(buf, expected_tag)
          emit_i32_eq(buf)
          emit_if_i64(buf)
          0
        } else {
          if is_pstring(__cond_p) {
            let sval = get_pstring_value(__cond_p)
            let str_idx = str_table_lookup(ctx.str_table.strs, sval)
            if str_idx >= 0 {
              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
              emit_local_get(buf, scrut_local)
              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))
              emit_call(buf, str_eq_fi)
              emit_i32_wrap_i64(buf)
              emit_if_i64(buf)
            }
            0
          } else {
            // POr or unknown: flatten POr into multiple i64_eq checks with i32.or
            // POr(PInt(1), POr(PInt(2), PInt(3))) -> scrut==1 || scrut==2 || scrut==3
            let rec emit_or_check = (pat: Pat) -> Unit {
              match pat {
                POr(left, right) => {
                  emit_or_check(left)
                  emit_or_check(right)
                  bytebuf_push(buf, 114)
                },
                PInt(n) => {
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, n)
                  emit_i64_eq(buf)
                },
                PCtor(cname, cargs) => {
                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)
                  let ctag = if ci >= 0 { Array::get(ctx.ctor_table.tags, ci) } else { -1 }
                  // Tag check
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, -2)
                  emit_i64_and(buf)
                  emit_i32_wrap_i64(buf)
                  emit_i32_load(buf, 2, 0)
                  emit_i32_const(buf, ctag)
                  emit_i32_eq(buf)
                  // If has PInt arg, also check field value
                  if Array::length(cargs) == 1 {
                    match Array::get(cargs, 0) {
                      PInt(n) => {
                        emit_local_get(buf, scrut_local)
                        emit_i64_const(buf, -2)
                        emit_i64_and(buf)
                        emit_i32_wrap_i64(buf)
                        emit_i64_load(buf, 3, 8)
                        emit_i64_const(buf, n)
                        emit_i64_eq(buf)
                        bytebuf_push(buf, 113)
                      },
                      _ => ()
                    }
                  }
                },
                _ => {
                  emit_i32_const(buf, 1)
                }
              }
            }
            emit_or_check(__cond_p)
            emit_if_i64(buf)
            0
          }
        }
      }
    }
    let __arm_body = get_arm_body(Array::get(__match_arms, ai))
    let ld_arm = if ld >= 0 {
      ld + ai + 1
    } else {
      -1
    }
    let arm_nl = if is_pctor(__cond_p) {
      let cargs_bind = get_pctor_args(__cond_p)
      let mut cbi = 0
      while cbi < Array::length(cargs_bind) {
        let __sub_p = Array::get(cargs_bind, cbi)
        if is_pbind(__sub_p) {
          let pname = get_pbind_name(__sub_p)
          let fl = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + cbi * 8)
          emit_local_set(buf, fl)
          Array::push(local_names, pname)
        } else if is_ptuple(__sub_p) {
          let tpats = get_ptuple_pats(__sub_p)
          let tup_local = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + cbi * 8)
          emit_local_set(buf, tup_local)
          Array::push(local_names, "__ctor_tup")
          let mut ti = 0
          while ti < Array::length(tpats) {
            let tp = Array::get(tpats, ti)
            if is_pbind(tp) {
              let tpname = get_pbind_name(tp)
              let tfl = Array::length(local_names)
              emit_local_get(buf, tup_local)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, ti * 8)
              emit_local_set(buf, tfl)
              Array::push(local_names, tpname)
            }
            ti = ti + 1
          }
        }
        cbi = cbi + 1
      }
      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)
    } else {
      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)
    }
    if arm_nl > max_nl {
      max_nl = arm_nl
    }
    emit_else(buf)
    ai = ai + 1
  }
  Array::truncate(local_names, names_len_at_match)
  let ld_catch = if ld >= 0 {
    ld + num_cond_arms
  } else {
    -1
  }
  let catch_nl = if catchall_idx < num_arms {
    let __catch_arm = Array::get(__match_arms, catchall_idx)
    let __catch_p = get_arm_pat(__catch_arm)
    let __catch_body = get_arm_body(__catch_arm)
    0
    if is_pbind(__catch_p) {
      let bname = get_pbind_name(__catch_p)
      let bind_local = Array::length(local_names)
      emit_local_get(buf, scrut_local)
      emit_local_set(buf, bind_local)
      Array::push(local_names, bname)
      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
    } else {
      if is_pctor(__catch_p) {
        let cargs = get_pctor_args(__catch_p)
        let mut cbi2 = 0
        while cbi2 < Array::length(cargs) {
          let __sub_p2 = Array::get(cargs, cbi2)
          if is_pbind(__sub_p2) {
            let pname = get_pbind_name(__sub_p2)
            let fl2 = Array::length(local_names)
            emit_local_get(buf, scrut_local)
            emit_i64_const(buf, -2)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_i64_load(buf, 3, 8 + cbi2 * 8)
            emit_local_set(buf, fl2)
            Array::push(local_names, pname)
          }
          cbi2 = cbi2 + 1
        }
        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
      } else {
        if is_ptuple(__catch_p) {
          let pats = get_ptuple_pats(__catch_p)
          let ptr_local2 = Array::length(local_names)
          emit_local_get(buf, scrut_local)
          emit_local_set(buf, ptr_local2)
          Array::push(local_names, "__tup_ptr2")
          let mut pi2 = 0
          while pi2 < Array::length(pats) {
            let __tp = Array::get(pats, pi2)
            if is_pbind(__tp) {
              let pname = get_pbind_name(__tp)
              let field_l = Array::length(local_names)
              emit_local_get(buf, ptr_local2)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, pi2 * 8)
              emit_local_set(buf, field_l)
              Array::push(local_names, pname)
              0
            } else if is_ptuple(__tp) {
              // Nested tuple: load sub-tuple pointer, then bind fields
              let sub_pats = get_ptuple_pats(__tp)
              let sub_ptr = Array::length(local_names)
              emit_local_get(buf, ptr_local2)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, pi2 * 8)
              emit_local_set(buf, sub_ptr)
              Array::push(local_names, "__sub_tup")
              let mut si3 = 0
              while si3 < Array::length(sub_pats) {
                let sp = Array::get(sub_pats, si3)
                if is_pbind(sp) {
                  let spname = get_pbind_name(sp)
                  let sfl = Array::length(local_names)
                  emit_local_get(buf, sub_ptr)
                  emit_i32_wrap_i64(buf)
                  emit_i64_load(buf, 3, si3 * 8)
                  emit_local_set(buf, sfl)
                  Array::push(local_names, spname)
                }
                si3 = si3 + 1
              }
              0
            } else {
              if is_pwild(__tp) {
                0
              } else {
                throw("unsupported pattern in tuple destructure")
              }
            }
            pi2 = pi2 + 1
          }
          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
        } else {
          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
        }
      }
    }
  } else {
    bytebuf_push(buf, 0)
    0
  }
  if catch_nl > max_nl {
    max_nl = catch_nl
  }
  let mut ci2 = 0
  while ci2 < num_cond_arms {
    emit_end(buf)
    ci2 = ci2 + 1
  }
  while Array::length(local_names) < max_nl {
    Array::push(local_names, "")
  }
  max_nl
}
