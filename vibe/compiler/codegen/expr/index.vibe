  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in
}

import ../wasm_emit/index.vibe {
  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data
}

//# Functions

let compile_call = (buf: Array[Int], callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {
  if is_eident(callee) {
    let fname = get_eident_name(callee)
    let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)
    if ctor_lookup_idx >= 0 {
      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)
      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)
      let obj_size = 8 + fc * 8
      let ptr_local = next_local
      Array::push(local_names, "__ctor_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, tag)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, fc)
      emit_i32_store(buf, 2, 4)
      let actual_args = if Array::length(args) == 1 {
        match Array::get(args, 0) {
          ERecord(rec_fields) => {
            let mut si2 = 0
            let mut sn_idx = -1
            while si2 < Array::length(ctx.ctor_table.struct_names) {
              if Array::get(ctx.ctor_table.struct_names, si2) == fname {
                sn_idx = si2
                si2 = Array::length(ctx.ctor_table.struct_names)
              } else {
                si2 = si2 + 1
              }
            }
            if sn_idx >= 0 {
              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)
              let ordered = Array::slice([
                EUnit
              ], 0, 0)
              let mut oi = 0
              while oi < Array::length(def_fnames) {
                let target_name = Array::get(def_fnames, oi)
                let mut ri = 0
                let mut found_rfv = EUnit
                while ri < Array::length(rec_fields) {
                  let (rfn, rfv) = Array::get(rec_fields, ri)
                  if rfn == target_name {
                    found_rfv = rfv
                    ri = Array::length(rec_fields)
                  } else {
                    ri = ri + 1
                  }
                }
                Array::push(ordered, found_rfv)
                oi = oi + 1
              }
              ordered
            } else {
              args
            }
          },
          _ => args
        }
      } else {
        args
      }
      let mut nl_c = next_local + 1
      let mut fi_c = 0
      while fi_c < Array::length(actual_args) {
        nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)
        let val_local = nl_c
        Array::push(local_names, "__ctor_val")
        emit_local_set(buf, val_local)
        nl_c = nl_c + 1
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + fi_c * 8)
        fi_c = fi_c + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl_c
    }
    else if fname == "Bytes::from_array" {
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if fname == "Bytes::length" {
      let (al_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_call(buf, al_idx)
      nl
    }
    else if fname == "Bytes::get" {
      let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_call(buf, ag_idx)
      nl
    }
    else if fname == "eq" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_eq(buf)
      emit_i64_extend_i32_s(buf)
      nl
    }
    else if fname == "not" {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      nl
    }
    else if fname == "add" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_add(buf)
      nl
    }
    else if fname == "sub" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_sub(buf)
      nl
    }
    else if fname == "mul" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_mul(buf)
      nl
    }
    else if fname == "lt" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_lt_s(buf)
      emit_i64_extend_i32_s(buf)
      nl
    }
    else if fname == "perform" {
      // Algebraic effect: check resume override, else throw
      // global 1 = __resume_value (i64, 0 = no resume)
      let mut nl = next_local
      emit_global_get(buf, 1)
      emit_i64_const(buf, 0)
      emit_i64_ne(buf)
      emit_if_i64(buf)
      // Resume override present: return it and clear
      emit_global_get(buf, 1)
      emit_i64_const(buf, 0)
      emit_global_set(buf, 1)
      emit_else(buf)
      // No override: compile argument and throw
      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
      bytebuf_push(buf, 8)
      bytebuf_push(buf, 0)
      emit_end(buf)
      nl
    }
    else if fname == "path" {
      // path(x) returns x as-is (string identity)
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if fname == "__to_string" {
      // __to_string(val) → String: if val is already a string (high bits set), return as-is
      // Otherwise convert int to string on heap
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      let val_l = nl
      let neg_l = nl + 1
      let cur_l = nl + 2
      let abs_l = nl + 3
      let hp_l = nl + 4
      let len_l = nl + 5
      Array::push(local_names, "__ts_val")
      Array::push(local_names, "__ts_neg")
      Array::push(local_names, "__ts_cur")
      Array::push(local_names, "__ts_abs")
      Array::push(local_names, "__ts_hp")
      Array::push(local_names, "__ts_len")
      emit_local_set(buf, val_l)
      // Check if string: unsigned shift high 32 bits, check 0 < high < heap_ptr
      // Uses abs_l as temp (not yet used at this point)
      emit_block_i64(buf)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 32)
      bytebuf_push(buf, 136)
      emit_local_tee(buf, abs_l)
      emit_i64_const(buf, 0)
      emit_i64_gt_s(buf)
      emit_local_get(buf, abs_l)
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_i64_lt_s(buf)
      bytebuf_push(buf, 113)
      emit_if_void(buf)
      emit_local_get(buf, val_l)
      emit_br(buf, 1)
      emit_end(buf)
      // cursor = 46 (i64)
      emit_i64_const(buf, 46)
      emit_local_set(buf, cur_l)
      // is_neg = val < 0
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_i64_extend_i32_s(buf)
      emit_local_set(buf, neg_l)
      // abs = neg ? -val : val
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_if_i64(buf)
      emit_i64_const(buf, 0)
      emit_local_get(buf, val_l)
      emit_i64_sub(buf)
      emit_else(buf)
      emit_local_get(buf, val_l)
      emit_end(buf)
      emit_local_set(buf, abs_l)
      // if abs == 0: write '0'
      emit_local_get(buf, abs_l)
      emit_i64_eqz(buf)
      emit_if_void(buf)
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 48)
      emit_i32_store8(buf, 0, 0)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      emit_end(buf)
      // digit loop
      emit_block_void(buf)
      emit_loop_void(buf)
      emit_local_get(buf, abs_l)
      emit_i64_eqz(buf)
      emit_br_if(buf, 1)
      // digit = abs % 10
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, abs_l)
      emit_i64_const(buf, 10)
      emit_i64_rem_s(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 48)
      emit_i32_add(buf)
      emit_i32_store8(buf, 0, 0)
      // cursor--
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      // abs = abs / 10
      emit_local_get(buf, abs_l)
      emit_i64_const(buf, 10)
      emit_i64_div_s(buf)
      emit_local_set(buf, abs_l)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      // if neg: write '-'
      emit_local_get(buf, neg_l)
      emit_i32_wrap_i64(buf)
      emit_if_void(buf)
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 45)
      emit_i32_store8(buf, 0, 0)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      emit_end(buf)
      // heap_ptr = global 0 (i32), extend to i64
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, hp_l)
      // len = 46 - cursor (both i64)
      emit_i64_const(buf, 46)
      emit_local_get(buf, cur_l)
      emit_i64_sub(buf)
      emit_local_set(buf, len_l)
      // memory.copy(heap_ptr_i32, (cursor+1)_i32, len_i32)
      emit_local_get(buf, hp_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, len_l)
      emit_i32_wrap_i64(buf)
      emit_memory_copy(buf)
      // advance heap_ptr: global 0 = hp + ((len + 7) & ~7)
      emit_local_get(buf, hp_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, len_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 7)
      emit_i32_add(buf)
      emit_i32_const(buf, -8)
      bytebuf_push(buf, 113)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      // return (heap_ptr << 32) | len
      emit_local_get(buf, hp_l)
      emit_i64_const(buf, 32)
      emit_i64_shl(buf)
      emit_local_get(buf, len_l)
      emit_i64_or(buf)
      emit_end(buf)
      nl + 6
    }
    else if fname == "Int::to_double" || fname == "Int::to_float" || fname == "Float::to_int" || fname == "Float::to_double" || fname == "Double::to_int" || fname == "Double::to_float" {
      // Type conversion stub: return argument as-is (all values are i64 tagged)
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if fname == "resume" {
      // Algebraic effect resume: set global override and throw tag 1 (resume tag)
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_global_set(buf, 1)
      emit_i64_const(buf, 0)
      bytebuf_push(buf, 8)
      bytebuf_push(buf, 1)
      nl
    }
    else if fname == "assert" {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i32_wrap_i64(buf)
      emit_if_void(buf)
      emit_else(buf)
      bytebuf_push(buf, 0)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl
    }
    else if fname == "Double::to_i64_bits" {
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if fname == "String::ends_with" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_call(buf, 29)
      nl
    }
    else if fname == "String::last_index_of" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_call(buf, 30)
      nl
    }
    else if fname == "__slice" {
      // __slice(container, start, end) → String::substring fallback
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
      let (ss_idx, _, _) = resolve_func(ctx.func_table, "String::substring")
      emit_call(buf, ss_idx)
      nl
    }
    else if fname == "Array::map" || fname == "map" {
      // Array::map(arr, fn) → new array with fn applied to each element
      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, "array_new")
      let (arr_len_fi, _, _) = resolve_func(ctx.func_table, "Array::length")
      let (arr_get_fi, _, _) = resolve_func(ctx.func_table, "Array::get")
      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, "Array::push")
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      let arr_l = nl
      let fn_l = nl + 1
      let res_l = nl + 2
      let len_l = nl + 3
      let i_l = nl + 4
      let slot_l = nl + 5
      let env_l = nl + 6
      let elem_l = nl + 7
      Array::push(local_names, "__map_arr")
      Array::push(local_names, "__map_fn")
      Array::push(local_names, "__map_res")
      Array::push(local_names, "__map_len")
      Array::push(local_names, "__map_i")
      Array::push(local_names, "__map_slot")
      Array::push(local_names, "__map_env")
      Array::push(local_names, "__map_elem")
      emit_local_set(buf, fn_l)
      emit_local_set(buf, arr_l)
      emit_call(buf, arr_new_fi)
      emit_local_set(buf, res_l)
      emit_local_get(buf, arr_l)
      emit_call(buf, arr_len_fi)
      emit_local_set(buf, len_l)
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_l)
      emit_closure_resolve(buf, fn_l, slot_l, env_l)
      emit_block_void(buf)
      emit_loop_void(buf)
      emit_local_get(buf, i_l)
      emit_local_get(buf, len_l)
      emit_i64_ge_s(buf)
      emit_br_if(buf, 1)
      // elem = arr[i]
      emit_local_get(buf, arr_l)
      emit_local_get(buf, i_l)
      emit_call(buf, arr_get_fi)
      emit_local_set(buf, elem_l)
      // result = fn(elem)
      emit_local_get(buf, elem_l)
      emit_closure_call_tail(buf, env_l, slot_l, 9, 1)
      emit_local_set(buf, elem_l)
      // push result
      emit_local_get(buf, res_l)
      emit_local_get(buf, elem_l)
      emit_call(buf, arr_push_fi)
      emit_local_get(buf, i_l)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_local_set(buf, i_l)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_local_get(buf, res_l)
      nl + 8
    }
    else if fname == "Array::fold" {
      // Array::fold(arr, init, fn) → fold left
      let (arr_len_fi, _, _) = resolve_func(ctx.func_table, "Array::length")
      let (arr_get_fi, _, _) = resolve_func(ctx.func_table, "Array::get")
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
      let arr_l = nl
      let acc_l = nl + 1
      let fn_l = nl + 2
      let len_l = nl + 3
      let i_l = nl + 4
      let slot_l = nl + 5
      let env_l = nl + 6
      Array::push(local_names, "__fold_arr")
      Array::push(local_names, "__fold_acc")
      Array::push(local_names, "__fold_fn")
      Array::push(local_names, "__fold_len")
      Array::push(local_names, "__fold_i")
      Array::push(local_names, "__fold_slot")
      Array::push(local_names, "__fold_env")
      emit_local_set(buf, fn_l)
      emit_local_set(buf, acc_l)
      emit_local_set(buf, arr_l)
      emit_local_get(buf, arr_l)
      emit_call(buf, arr_len_fi)
      emit_local_set(buf, len_l)
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_l)
      emit_closure_resolve(buf, fn_l, slot_l, env_l)
      emit_block_void(buf)
      emit_loop_void(buf)
