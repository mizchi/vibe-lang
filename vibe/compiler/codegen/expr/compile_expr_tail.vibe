//# Functions

// Blocker-3 (ADR-0055): is local slot `slot` currently bound to a float?
// float_local_slots is an append-only log of `slot*2 + flag` entries (flag 1 =
// float, 0 = a non-float rebind that overrides a previously-float slot). The
// MOST RECENT entry for a slot wins, mirroring local_names' most-recent-slot
// resolution — so a shadowing rebind (nested block, or an if/match branch
// reusing the slot) is classified by its own binding, not a stale one. Kept as
// an append-only log (no Array::truncate) because the wasm-gc backend cannot
// truncate a struct-field array; the log only grows for float-related bindings,
// which are rare, so scans stay short.
let slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {
  let arr = ctx.float_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 2 == slot {
      result = (entry % 2) == 1
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

// Blocker-3 (ADR-0055): does `e` statically evaluate to an f64 bit pattern?
// Syntactic over-approximation (the AST is untyped): float literals, float
// arithmetic / comparison over floatish operands, float-producing conversions,
// and — crucially — a *variable* bound to a floatish value (tracked in
// ctx.float_local_slots as `let`s compile). This lets `let x = 1.5; x + y`
// take the f64 path. Shared by compile_expr (binop/unary instruction choice)
// and the `let` handler below (which populates float_local_slots).
export let rec expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {
  let tag = expr_tag(e)
  if tag == 2 {
    true
  } else if tag == 4 {
    // Resolve the identifier to its local slot (most-recent binding wins, like
    // the EIdent codegen) and report float-ness by slot membership. Slot-keyed
    // (not name-keyed) so a shadowing same-name binding of another type is not
    // misclassified; float_local_slots is truncated with local_names at scope
    // boundaries so reused slots across sibling scopes don't leak float-ness.
    let nm = get_eident_name(e)
    let len = Array::length(local_names)
    let mut i = len - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      slot_is_floatish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "<" || op == ">" || op == "<=" || op == ">=" {
      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 6 {
    let op = get_eunaryop_op(e)
    if op == "-" {
      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 8 {
    let callee = get_ecall_callee(e)
    if is_eident(callee) {
      let fname = get_eident_name(callee)
      fname == "Int::to_double" || fname == "Int::to_float" || fname == "Float::to_double" || fname == "Double::to_float" || fname == "Double::from_i64_bits"
    } else {
      false
    }
  } else {
    false
  }
}

// Push the untagged value pointer (as i32) held in `local_idx`. Records are
// tagged (`ptr | 1`) so their low bit is cleared first; tuples are raw.
let emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {
  emit_local_get(buf, local_idx)
  if tagged {
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
  } else {
    ()
  }
  emit_i32_wrap_i64(buf)
}

// Emit a non-recursive rc_drop of a heap value held in `local_idx`: decrement
// rc_count (at value-4) and, at zero, push the block onto the free-list head
// (global 2), reusing the rc slot as the next pointer. The free-list head holds
// the (untagged) value pointer, matching the allocator in compile_expr_tail2 /
// compile_expr_tail4. (docs/spec/selfhost-rc-port.md)
let emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_sub(buf)
  emit_i32_store(buf, 2, 0)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  // ADR-0055 Stage 2c: the rc_count word's high byte holds a drop-class id, so
  // test the low 24 bits (rc) for zero by `* 256` (shifts the class byte out of
  // the 32-bit word) before `eqz`.
  emit_i32_const(buf, 256)
  emit_i32_mul(buf)
  emit_i32_eqz(buf)
  emit_if_void(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_global_get(buf, 2)
  emit_i32_store(buf, 2, 0)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_global_set(buf, 2)
  emit_end(buf)
}

// Emit rc_dup: increment the reference count (at value-4) of a heap object held
// in `local_idx`. Used for an alias `let a = t` whose source `t` is multiply
// used, so the alias takes its own owned reference. (docs/spec/selfhost-rc-port.md)
let emit_rc_dup_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
}

// ADR-0055 Stage 4: a runtime-guarded rc_dup of the value held in `local_idx`.
// Unlike emit_rc_dup_local it first tests the low bit, so it is a no-op on an
// even (scalar) value — the projected field whose heap-ness is unknown at
// codegen time (Blocker 3). Used to give an escaping projection its own owned
// reference before the source container is recursively dropped.
let emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 1)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  // odd: also require high 32 bits == 0 (a real heap block address, not a
  // string/bytes fat pointer whose data offset sits in the high 32 bits).
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 32)
  emit_i64_shr_s(buf)
  emit_i64_eqz(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
  emit_end(buf)
}

// Whether `e` is a field/index projection (EDot). A let bound to one aliases a
// field of another container (ADR-0055 Stage 4).
let is_edot: (Expr) -> Bool = (e) -> {
  match e {
    EDot(_, _) => true,
    _ => false
  }
}

// The root identifier of a projection chain (EDot(...EDot(EIdent(root))...)), or
// "" if `e` is not a projection.
let rec proj_root_ident: (Expr) -> String = (e) -> {
  match e {
    EDot(obj, _) => proj_root_ident(obj),
    EIdent(nm) => nm,
    _ => ""
  }
}

// If the *tail* (result) expression of a scope is a projection chain, return its
// root identifier; otherwise "". Follows let/seq/assign wrappers to the tail.
// (ADR-0055 Stage 4: an escaping projection rooted at a dropped binding aliases
// a field the recursive rc_drop would free — it must be dup'd.)
let rec scope_tail_proj_root: (Expr) -> String = (e) -> {
  match e {
    ELet(_, _, b) => scope_tail_proj_root(b),
    ELetMut(_, _, b) => scope_tail_proj_root(b),
    ELetRec(_, _, b) => scope_tail_proj_root(b),
    ESeq(_, b) => scope_tail_proj_root(b),
    EAssign(_, _, b) => scope_tail_proj_root(b),
    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),
    EDot(obj, _) => proj_root_ident(obj),
    _ => ""
  }
}

// ADR-0055 Stage 4: does the assignment RHS reference `name`? If so, dropping
// the old value of `name` before evaluating the RHS would be a use-after-free
// (`b = b.0`, `b = f(b)`), so the reassignment drop is suppressed for these.
let assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {
  let empty1 = Array::slice([
    ""
  ], 0, 0)
  let empty2 = Array::slice([
    ""
  ], 0, 0)
  array_contains_str(collect_free_vars(value, empty1, empty2), name)
}

// ADR-0055 Stage 4 (reassign-self reclamation): is every mention of `name` in
// `e` confined to a position that does NOT carry one of `name`'s heap fields
// verbatim into the result through a nested constructor/call? A mention is safe
// when it is (a) a bare carry — `name` itself or a pure projection rooted at
// `name` (the field is duplicated before the old block is dropped), or (b)
// consumed by arithmetic into a fresh scalar. Any OTHER carry (a nested
// tuple/array literal, a constructor, or a call that may take ownership of
// `name`) could alias a heap field the recursive drop frees — reject it and keep
// the old, safe leak. (Array indexing lowers to a `__index`/`Array::get` call,
// so EDot here is only a static tuple/record field projection.)
let rec reassign_carry_safe: (Expr, String) -> Bool = (e, name) -> {
  if !assign_value_mentions(e, name) {
    true
  } else {
    match e {
      EIdent(_) => true,
      EDot(_, _) => proj_root_ident(e) == name,
      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),
      EUnaryOp(_, x) => reassign_carry_safe(x, name),
      _ => false
    }
  }
}

// ADR-0055 Stage 4: may `name = value` (where `value` mentions `name`) be
// reclaimed by the reassign-self path? Restricted to a tuple literal every
// element of which is a safe carry — then the old block can be dropped after the
// new tuple is built, with carried fields pre-dup'd to survive.
let reassign_self_reusable: (Expr, String) -> Bool with { Error } = (value, name) -> {
  if is_etuple(value) {
    let elems = get_etuple_elems(value)
    let mut i = 0
    let mut ok = true
    while i < Array::length(elems) {
      if !reassign_carry_safe(Array::get(elems, i), name) {
        ok = false
      } else {
        ()
      }
      i = i + 1
    }
    ok
  } else {
    false
  }
}

// ADR-0055 Stage 4: does this EFn capture any free variable? A capturing closure
// is a headered RC env block (compile_lambda) under RC, so its binding must be
// classified heap and dropped at scope end (recursively freeing heap captures).
// A capture-less closure is an immediate value (not heap).
let efn_is_capturing: (Expr, CompileCtx) -> Bool with { Error } = (value, ctx) -> {
  let params = get_efn_params(value)
  let pnames = Array::slice([
    ""
  ], 0, 0)
  let mut pi = 0
  while pi < Array::length(params) {
    let (pn, _) = Array::get(params, pi)
    Array::push(pnames, pn)
    pi = pi + 1
  }
  let caps = collect_free_vars(get_efn_body(value), pnames, Array::concat(ctx.func_table.names, ctx.ctor_table.names))
  Array::length(caps) > 0
}

export let compile_expr_tail: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {
  let __tag = expr_tag(expr)
  if __tag == 9 {
    let name = get_elet_name(expr)
    let value = get_elet_val(expr)
    let body = get_elet_body(expr)
    let local_idx = next_local
    Array::push(local_names, name)
    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
    emit_local_set(buf, local_idx)
    // Blocker-3: log this binding's float-ness by slot so a later `name + ...`
    // is recognised as float arithmetic. Push a float marker; if a non-float
    // rebind shadows a previously-float slot (branch slot reuse), push an
    // override so the stale float entry no longer wins. Independent of RC.
    let val_is_float = expr_is_floatish(value, local_names, ctx)
    if val_is_float {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    // RC: classify the bound value's heap-ness. rc_kind 0 = not (known) heap,
    // 1 = heap tuple (raw pointer), 2 = heap tagged (record/enum, or an alias of
    // any heap kind — the `& -2` untag is a no-op on 8-aligned tuple pointers so
    // it is safe for aliases of any kind). A binding is registered in
    // heap_binding_names so a later alias `let a = <this>` can be dup'd/dropped,
    // and so that drops never touch a non-heap binding the static Perceus
    // `scalar` flag over-approximates as heap. (docs/spec/selfhost-rc-port.md)
    let mut rc_kind = 0
    if ctx.enable_rc {
      if val_is_float {
        // ADR-0055 Stage 2: a float is heap-boxed (odd pointer), so its binding
        // is droppable / dup-able like any heap value. (A float *comparison*
        // result is an even bool — rc_dup/rc_drop are guarded no-ops on even
        // values, so classifying it heap here is harmless.)
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_etuple(value) {
        // ADR-0055 Stage 2: tuples are now odd pointers, so the drop must untag
        // (& -2) — same as records/enums (rc_kind 2 / tagged=true).
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_earray(value) {
        // ADR-0055 Stage 2b: arrays are now odd pointers; drop must untag.
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_erecord(value) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_ctor_call(value, ctx.ctor_table) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_eident(value) {
        let src = get_eident_name(value)
        if array_contains_str(ctx.heap_binding_names, src) {
          rc_kind = 2
          Array::push(ctx.heap_binding_names, name)
          // Alias of a multiply-used source: take a duplicated reference.
          if array_contains_str(ctx.rc_alias_dup_names, name) {
            emit_rc_dup_local(buf, local_idx, true)
          } else {
            ()
          }
        } else {
          ()
        }
      } else if expr_tag(value) == 8 {
        // ADR-0055 Stage 4: a call result is an OWNED heap value — the callee
        // returns its reference (a fresh allocation, an arg whose ownership was
        // transferred in under the owning-argument convention, or an escaping
        // projection the callee already dup'd). Classify it as droppable so the
        // scope-end drop the analysis already planned (every binding gets
        // remaining >= 1) actually fires, closing the `let p = f(...)` leak. The
        // runtime-guarded __rc_drop is a no-op on a scalar result, so an
        // Int-returning call costs nothing. EXCEPTION: a builtin that returns a
        // BORROW of a still-live container (Array::get / __index) yields an
        // element the container still owns — dropping it would double-free.
        let callee = get_ecall_callee(value)
        let is_borrow_ret = if is_eident(callee) {
          let cn = get_eident_name(callee)
          cn == "Array::get" || cn == "__index" || cn == "Map::get"
        } else {
          false
        }
        if is_borrow_ret {
          ()
        } else {
          rc_kind = 2
          Array::push(ctx.heap_binding_names, name)
        }
      } else if is_edot(value) {
        // ADR-0055 Stage 4: a projection bound to a let (`let a = t.0`) aliases a
        // field of another container. The Perceus analysis treats it as a
        // binding that owns one reference (remaining >= 1) and drops it at scope
        // end — but `t.0` does not actually take a reference. Give it one with a
        // guarded dup (a no-op on a scalar/string field): now if `a` escapes it
        // survives the container's recursive drop, and if it does not, its
        // analysis-planned drop balances the dup.
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
        emit_rc_dup_guarded(buf, local_idx)
      } else if is_efn(value) && efn_is_capturing(value, ctx) {
        // ADR-0055 Stage 4: a capturing closure is a headered RC env block — its
        // binding is droppable so the env (and its recursively-dropped heap
        // captures) is reclaimed at scope end.
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else {
        ()
      }
    } else {
      ()
    }
    // ADR-0055 Stage 4: emit the non-alias `PaDup` budget for this binding — one
    // guarded rc_dup per plan PaDup(name). A heap value used in N owning
    // positions (e.g. `let u = (t, t)` uses `t` twice) needs N-1 extra refs so
    // each owning consumer's (recursive) drop is balanced; the analysis records
    // exactly N-1 PaDup(name). Placement is occurrence-agnostic (all uses share
    // the same block), so emitting them here at the binding is equivalent and
    // can only raise the refcount — at worst a leak, never a premature free.
    if ctx.enable_rc && rc_kind > 0 {
      let mut dbi = 0
      while dbi < Array::length(ctx.rc_dup_names) {
        if Array::get(ctx.rc_dup_names, dbi) == name {
          emit_rc_dup_guarded(buf, local_idx)
        } else {
          ()
        }
        dbi = dbi + 1
      }
    } else {
      ()
    }
    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
    // RC: drop a heap binding the Perceus plan marks for scope-end drop. rc_count
    // at value-4 is decremented and, at zero, the block is pushed onto the
    // free-list head (global 2). The body result is already on the stack and
    // untouched. (docs/spec/selfhost-rc-port.md)
    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {
      // ADR-0055 Stage 4: if the scope result is a projection rooted at THIS
      // dropped binding (e.g. `let t = (...); t.0`), the result aliases a field
      // the recursive drop would free — use-after-free. Save the result, dup it
      // (runtime-guarded, so a scalar field is a no-op), drop, then restore.
      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {
        emit_local_set(buf, nl2)
        emit_rc_dup_guarded(buf, nl2)
        emit_local_get(buf, local_idx)
        emit_call(buf, ctx.rc_drop_func_idx)
        emit_local_get(buf, nl2)
        nl2 + 1
      } else {
        if ctx.rc_drop_func_idx >= 0 {
          // ADR-0055 Stage 3: route the scope-end drop through the recursive
          // helper so nested heap fields are reclaimed to arbitrary depth. The
          // helper untags and classifies the value itself.
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else if rc_kind == 1 {
          emit_rc_drop_local(buf, local_idx, false)
        } else {
          emit_rc_drop_local(buf, local_idx, true)
        }
        nl2
      }
    } else {
      nl2
    }
  } else if __tag == 10 {
    let name = get_eletrec_name(expr)
    let value = get_eletrec_val(expr)
    let body = get_eletrec_body(expr)
    let local_idx = next_local
    Array::push(local_names, name)
    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
    emit_local_set(buf, local_idx)
    if is_efn(value) {
      let params = get_efn_params(value)
      let fn_body = get_efn_body(value)
      let param_names_bp = Array::slice([
        ""
      ], 0, 0)
      let mut bpi = 0
      while bpi < Array::length(params) {
        let (pn, _) = Array::get(params, bpi)
        Array::push(param_names_bp, pn)
        bpi = bpi + 1
      }
      let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))
      let mut self_cap_idx = -1
      let mut bci = 0
      while bci < Array::length(caps) {
        if Array::get(caps, bci) == name {
          self_cap_idx = bci
        }
        bci = bci + 1
      }
      if self_cap_idx >= 0 {
        emit_local_get(buf, local_idx)
        emit_i64_const(buf, -4)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, local_idx)
        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
      }
      0
    } else {
      0
    }
    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
    nl2
  } else if __tag == 11 {
    let name = get_eletmut_name(expr)
    let value = get_eletmut_val(expr)
    let body = get_eletmut_body(expr)
    let local_idx = next_local
    Array::push(local_names, name)
    // Blocker-3: a mut binding has one type (stable across reassignments), so
    // classify float-ness from its initializer (covers both the ref-cell and
    // plain-local branches below). Same slot-log scheme as `let`.
    if expr_is_floatish(value, local_names, ctx) {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    if is_mut_captured_in(body, name) {
      Array::push(ctx.ref_cell_names, name)
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, local_idx)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 8)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_local_get(buf, local_idx)
      emit_i32_wrap_i64(buf)
      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
      emit_i64_store(buf, 3, 0)
      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
      nl2
    } else {
      // ADR-0055 Stage 4: classify the mut binding's heap-ness from its
      // initializer (a binding has one type, so this is stable across
      // reassignments). Registering it in heap_binding_names lets `EAssign` drop
      // the OLD value before overwriting (otherwise each `b = <heap>` leaks the
      // previous block — a per-iteration leak in a loop).
      if ctx.enable_rc && (is_etuple(value) || is_earray(value) || is_erecord(value) || is_ctor_call(value, ctx.ctor_table) || expr_is_floatish(value, local_names, ctx)) {
        // ADR-0055 Stage 2: a float mut holds a heap-boxed value; classify it
        // heap so EAssign drops the old box on reassignment and the final value
        // is dropped at scope end.
        Array::push(ctx.heap_binding_names, name)
      } else {
        ()
      }
      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
      emit_local_set(buf, local_idx)
      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
      // ADR-0055 Stage 4: drop the mut binding's FINAL value at scope end (the
      // per-iteration reassignment drop only reclaims overwritten values; the
      // last one still owns a reference). Same projection-rooted-at-name tail
      // guard as `let`: if the scope result aliases a field of this binding, dup
      // it before the recursive drop frees the container.
      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {
        if scope_tail_proj_root(body) == name {
          emit_local_set(buf, nl2)
          emit_rc_dup_guarded(buf, nl2)
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
          emit_local_get(buf, nl2)
          nl2 + 1
        } else {
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
          nl2
        }
      } else {
        nl2
      }
    }
  } else if __tag == 12 {
    let name = get_eassign_name(expr)
    let value = get_eassign_val(expr)
    let body = get_eassign_body(expr)
    let idx = resolve_local(local_names, name, "assign")
    if array_contains_str(ctx.ref_cell_names, name) {
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_i64_store(buf, 3, 0)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else {
      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)
      let is_self = assign_value_mentions(value, name)
      if is_heap_mut && is_self && reassign_self_reusable(value, name) {
        // ADR-0055 Stage 4 (reassign-self reclamation): `b = (.. b ..)` cannot
        // drop the old block first (the RHS reads it), so it used to keep the old
        // block as a per-iteration leak. Instead: pre-dup each top-level heap
        // field carried verbatim from the old block (a guarded dup — a no-op on
        // a scalar/string), build the new tuple (still reading the old block),
        // store it, THEN recursively drop the old block. The dup of each carried
        // field exactly balances the dec rc_drop applies to it (both use the same
        // odd + high32==0 heap test), so carried fields survive while the rest of
        // the old block is reclaimed.
        let old_temp = next_local
        let scratch = next_local + 1
        let base = next_local + 2
        emit_local_get(buf, idx)
        emit_local_set(buf, old_temp)
        let elems = get_etuple_elems(value)
        let mut ei = 0
        while ei < Array::length(elems) {
          let elem = Array::get(elems, ei)
          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {
            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)
            emit_local_set(buf, scratch)
            emit_rc_dup_guarded(buf, scratch)
          } else {
            ()
          }
          ei = ei + 1
        }
        let nl = compile_expr(buf, value, local_names, base, ctx, ld)
        emit_local_set(buf, idx)
        emit_local_get(buf, old_temp)
        emit_call(buf, ctx.rc_drop_func_idx)
        compile_expr(buf, body, local_names, nl, ctx, ld)
      } else {
        // ADR-0055 Stage 4: drop the OLD value before overwriting a heap mut
        // binding (Perceus assignment rule). Without this, `b = <heap>` in a loop
        // leaks the previous block every iteration. The drop is guarded by
        // __rc_drop (a no-op on a scalar/string), and a dec (not an unconditional
        // free), so an aliased old value (rc > 1 via PaAliasDup) is safe.
        // SAFETY: skip the drop when the RHS references `name` (e.g. `b = b.0` or
        // `b = f(b)`) and is not handled by the reassign-self path above —
        // dropping first would free a block the new value derives from
        // (use-after-free). Those keep the old, safe leak.
        if is_heap_mut && !is_self {
          emit_local_get(buf, idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else {
          ()
        }
        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
        emit_local_set(buf, idx)
        compile_expr(buf, body, local_names, nl, ctx, ld)
      }
    }
  } else if __tag == 13 {
    let name = get_eassignop_name(expr)
    let op = get_eassignop_op(expr)
    let value = get_eassignop_val(expr)
    let body = get_eassignop_body(expr)
    let idx = resolve_local(local_names, name, "assignop")
    if array_contains_str(ctx.ref_cell_names, name) {
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 0)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_assignop_op(buf, op)
      emit_i64_store(buf, 3, 0)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else {
      emit_local_get(buf, idx)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_assignop_op(buf, op)
      emit_local_set(buf, idx)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    }
  } else if __tag == 14 {
    let first = get_eseq_first(expr)
    let second = get_eseq_second(expr)
    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)
    emit_drop(buf)
    compile_expr(buf, second, local_names, nl, ctx, ld)
  } else {
    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}
