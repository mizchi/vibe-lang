        // int like `1 << 40` has a zero low word and an in-bounds high word, so
        // it would be misread as an empty string). Force the integer path with
        // a false (i32) condition — the heuristic below also yields an i32 bool.
        emit_i32_const(buf, 0)
      } else {
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 32)
      bytebuf_push(buf, 136)
      emit_local_tee(buf, abs_l)
      emit_i64_const(buf, 64)
      emit_i64_ge_s(buf)
      emit_local_get(buf, abs_l)
      // #606: a string is represented as (ptr << 32) | len, and `__to_string`
      // returns the value unchanged when it looks like a string pointer. A
      // string can live anywhere in linear memory — including the static data
      // section (token / literal strings), whose offset is ABOVE the heap bump
      // pointer during early compilation. The old bound `ptr < heap_ptr`
      // (global 0) misclassified such strings as ints and stringified their raw
      // i64, leaking a heap pointer (e.g. labeled param `x~` printed as
      // `1285664100319233~`). Use the full linear-memory size (memory.size
      // pages * 65536) as the upper bound so any in-bounds pointer is
      // recognized; a small int still has a zero high word and takes the int
      // path below.
      bytebuf_push(buf, 63)
      bytebuf_push(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_i64_const(buf, 65536)
      emit_i64_mul(buf)
      emit_i64_lt_s(buf)
      bytebuf_push(buf, 113)
      // #664: ALSO require the candidate string to FIT in linear memory:
      // ptr + len <= memory_size. The `ptr < memory_size` bound above is not
      // enough — a large integer (e.g. a 61-bit `Fs::stat_token`) whose HIGH
      // word happens to land below memory_size is otherwise misread as a string
      // pointer, and its LOW word becomes a multi-gigabyte "length". The next
      // `String::concat` then `memory.copy`s that bogus length and traps with
      // "memory access out of bounds" (the #664 crash, triggered during the
      // persistent-sources-cache write `__to_string(Fs::stat_token(path))`). A
      // real string always satisfies ptr + len <= memory_size, so adding this
      // bound keeps genuine strings on the identity path while routing such
      // large integers back to the integer-stringify path below.
      emit_local_get(buf, abs_l)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 4294967295)
      emit_i64_and(buf)
      emit_i64_add(buf)
      bytebuf_push(buf, 63)
      bytebuf_push(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_i64_const(buf, 65536)
      emit_i64_mul(buf)
      emit_i64_le_s(buf)
      bytebuf_push(buf, 113)
      }
      emit_if_void(buf)
      emit_local_get(buf, val_l)
      emit_br(buf, 1)
      emit_end(buf)
      // Under RC a scalar Int is tagged `n << 1` (low bit 0 marks a non-heap
      // value; see `Int::to_double` / `Double::to_int` which shift to/from this
      // form). Arithmetic stays in tagged space and compares correctly, but the
      // digit loop below renders the RAW i64 — so without untagging it prints
      // `2n` (e.g. 42 -> "84"). Recover the logical value with an arithmetic
      // (sign-preserving) shift right by 1. Strings already returned above via
      // the `br`, so this only touches the integer path.
      if ctx.enable_rc {
        emit_local_get(buf, val_l)
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        emit_local_set(buf, val_l)
      }
      emit_i64_const(buf, 46)
      emit_local_set(buf, cur_l)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_i64_extend_i32_s(buf)
      emit_local_set(buf, neg_l)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_if_i64(buf)
      emit_i64_const(buf, 0)
      emit_local_get(buf, val_l)
      emit_i64_sub(buf)
      emit_else(buf)
      emit_local_get(buf, val_l)
      emit_end(buf)
      emit_local_set(buf, abs_l)
      emit_local_get(buf, abs_l)
      emit_i64_eqz(buf)
      emit_if_void(buf)
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 48)
      emit_i32_store8(buf, 0, 0)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      emit_end(buf)
      emit_block_void(buf)
      emit_loop_void(buf)
      emit_local_get(buf, abs_l)
      emit_i64_eqz(buf)
      emit_br_if(buf, 1)
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, abs_l)
      emit_i64_const(buf, 10)
      emit_i64_rem_s(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 48)
      emit_i32_add(buf)
      emit_i32_store8(buf, 0, 0)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      emit_local_get(buf, abs_l)
      emit_i64_const(buf, 10)
      emit_i64_div_s(buf)
      emit_local_set(buf, abs_l)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_local_get(buf, neg_l)
      emit_i32_wrap_i64(buf)
      emit_if_void(buf)
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 45)
      emit_i32_store8(buf, 0, 0)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      emit_end(buf)
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, hp_l)
      emit_i64_const(buf, 46)
      emit_local_get(buf, cur_l)
      emit_i64_sub(buf)
      emit_local_set(buf, len_l)
      emit_local_get(buf, hp_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, len_l)
      emit_i32_wrap_i64(buf)
      emit_memory_copy(buf)
      emit_local_get(buf, hp_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, len_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 7)
      emit_i32_add(buf)
      emit_i32_const(buf, -8)
      bytebuf_push(buf, 113)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, hp_l)
      emit_i64_const(buf, 32)
      emit_i64_shl(buf)
      emit_local_get(buf, len_l)
      emit_i64_or(buf)
      emit_end(buf)
      nl + 6
    }
    else if fname == "Double::to_int" || fname == "Float::to_int" {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      if ctx.enable_rc {
