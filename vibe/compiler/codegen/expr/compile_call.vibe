      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl + 2
    }
    else if !prefer_bound_call && (fname == "v128_eq_i8x16" || fname == "v128_le_u_i8x16" || fname == "v128_ge_u_i8x16" || fname == "v128_and" || fname == "v128_or") {
      // Binary (V128, V128) -> V128. Load both operands from their boxes, emit
      // the op, box the result.
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      let b_l = nl
      let a_l = nl + 1
      let box_l = nl + 2
      Array::push(local_names, "__v128_b")
      Array::push(local_names, "__v128_a")
      Array::push(local_names, "__v128_box")
      emit_local_set(buf, b_l)
      emit_local_set(buf, a_l)
      // box-alloc 16
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, box_l)
      emit_global_get(buf, 0)
      emit_i32_const(buf, 16)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      // box.store(op(load(a), load(b)))
      emit_local_get(buf, box_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, a_l)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      emit_local_get(buf, b_l)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      if fname == "v128_eq_i8x16" {
        emit_i8x16_eq(buf)
      } else if fname == "v128_le_u_i8x16" {
        emit_i8x16_le_u(buf)
      } else if fname == "v128_ge_u_i8x16" {
        emit_i8x16_ge_u(buf)
      } else if fname == "v128_and" {
        emit_v128_and(buf)
      } else {
        emit_v128_or(buf)
      }
      emit_v128_store(buf, 0, 0)
      emit_local_get(buf, box_l)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl + 3
    }
    else if !prefer_bound_call && fname == "v128_not" {
      // v128_not(v) -> V128.
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      let v_l = nl
      let box_l = nl + 1
      Array::push(local_names, "__v128_v")
      Array::push(local_names, "__v128_box")
      emit_local_set(buf, v_l)
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, box_l)
      emit_global_get(buf, 0)
      emit_i32_const(buf, 16)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, box_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, v_l)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      emit_v128_not(buf)
      emit_v128_store(buf, 0, 0)
      emit_local_get(buf, box_l)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl + 2
    }
    else if !prefer_bound_call && fname == "v128_bitmask_i8x16" {
      // v128_bitmask_i8x16(v) -> Int. i8x16.bitmask -> i32; zero-extend to i64.
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      emit_i8x16_bitmask(buf)
      emit_i64_extend_i32_u(buf)
      // #705: under RC an Int is a tagged scalar (n << 1, see eq/not above);
      // the bump backend leaves it raw, so only shift under RC.
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      } else {
        ()
      }
      nl
    }
    else if !prefer_bound_call && (fname == "v128_any_true" || fname == "v128_all_true_i8x16") {
      // (V128) -> Bool. emit op (-> i32 bool), sign-extend to the i64 Bool value.
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      if fname == "v128_any_true" {
        emit_v128_any_true(buf)
      } else {
        emit_i8x16_all_true(buf)
      }
      emit_i64_extend_i32_s(buf)
      // #705: under RC a Bool is tagged (true = 1<<1, see eq/not above); the
      // bump backend leaves it raw 0/1, so only shift under RC.
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      } else {
        ()
      }
      nl
    }
    else if !prefer_bound_call && fname == "perform" {
      let mut nl = next_local
      let g_rbuf = if ctx.enable_rc {
        5
      } else {
        4
      }
      let op_expr = Array::get(args, 0)
      let op_head = if is_eident(op_expr) {
        get_eident_name(op_expr)
      } else if expr_tag(op_expr) == 8 {
        let op_callee = get_ecall_callee(op_expr)
        if is_eident(op_callee) {
          get_eident_name(op_callee)
        } else {
          ""
        }
      } else {
        ""
      }
      let eff_tag = effect_name_to_tag(ctx.effect_names, op_head)
      // #553: per-effect region stride; MUST match eff_reserve in
      // linked_compile.vibe and compile_expr_tail6.vibe.
      let eff_off = (eff_tag - 3) * 131072
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 0)
      emit_global_set(buf, 1)
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_global_get(buf, 1)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_i64_store(buf, 3, 0)
      emit_global_get(buf, 1)
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 8)
      emit_i64_lt_s(buf)
      emit_if_i64(buf)
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_global_get(buf, 1)
      emit_i64_const(buf, 8)
      emit_i64_mul(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 16)
      emit_else(buf)
      // #665: record which operation is unwinding (stack-neutral global set).
      let g_op_idx_global = if ctx.enable_rc {
        6
      } else {
        5
      }
      emit_i64_const(buf, effect_op_index(ctx.effect_op_keys, op_head))
      emit_global_set(buf, g_op_idx_global)
      let op_canon = canonical_builtin_name(op_head)
      let __ft_len = Array::length(ctx.func_table.names)
      let mut op_is_builtin = false
      let mut __op_i = 0
      while __op_i < __ft_len {
        if Array::get(ctx.func_table.names, __op_i) == op_canon {
          op_is_builtin = true
          __op_i = __ft_len
        } else {
          __op_i = __op_i + 1
        }
      }
      if op_is_builtin {
        nl = ce(buf, op_expr, local_names, nl, ctx, ld)
      } else if expr_tag(op_expr) == 8 {
        let op_args = get_ecall_args(op_expr)
        if Array::length(op_args) > 1 {
          // Multi-value payload (#548): pack all op args into a tuple (one heap
          // ref threaded as the single thrown value); the handler arm pattern
          // destructures it element-by-element in compile_expr_tail6.
          nl = ce(buf, ETuple(op_args), local_names, nl, ctx, ld)
        } else if Array::length(op_args) > 0 {
          nl = ce(buf, Array::get(op_args, 0), local_names, nl, ctx, ld)
        } else {
          emit_i64_const(buf, 0)
        }
      } else {
        emit_i64_const(buf, 0)
      }
      bytebuf_push(buf, 8)
      bytebuf_push(buf, eff_tag)
      emit_end(buf)
      nl
    }
    else if !prefer_bound_call && fname == "path" {
