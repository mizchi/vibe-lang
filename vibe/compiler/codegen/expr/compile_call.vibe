        ECall(EIdent("String::from_char_code", -1), [
          ECall(EIdent("Array::get", -1), [
            EIdent("__ts_arr", -1),
            EIdent("__ts_i", -1)
          ], -1)
        ], -1)
      ], -1), EAssign("__ts_i", ECall(EIdent("add", -1), [
        EIdent("__ts_i", -1),
        EInt(1)
      ], -1), EUnit))
      let synth = ELet("__ts_arr", bs_expr, ELetMut("__ts_parts", EArray(Array::slice([
        EUnit
      ], 0, 0)), ELetMut("__ts_i", EInt(0), ESeq(EWhile(ECall(EIdent("lt", -1), [
        EIdent("__ts_i", -1),
        ECall(EIdent("Array::length", -1), [
          EIdent("__ts_arr", -1)
        ], -1)
      ], -1), ts_body), ECall(EIdent("String::join", -1), [
        EIdent("__ts_parts", -1),
        EString("")
      ], -1)))))
      ce(buf, synth, local_names, next_local, ctx, ld)
