//# Functions

export let compile_call: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, callee, args, local_names, next_local, ctx, ld, ce) -> {
  if is_eident(callee) {
    let fname = canonical_builtin_name(get_eident_name(callee))
    let fn_len2 = Array::length(ctx.func_table.names)
    let mut fn_idx_in_list = -1
    let mut __tr_j = 0
    while __tr_j < fn_len2 {
      if Array::get(ctx.func_table.names, __tr_j) == fname {
        fn_idx_in_list = __tr_j
        __tr_j = fn_len2
      } else {
        __tr_j = __tr_j + 1
      }
    }
    let mut local_idx_hint = -1
    let mut li = Array::length(local_names) - 1
    while li >= 0 {
      if Array::get(local_names, li) == fname {
        local_idx_hint = li
        li = -1
      } else {
        li = li - 1
      }
    }
    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0
    let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)
    if ctor_lookup_idx >= 0 {
      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)
      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)
      let ptr_local = next_local
      Array::push(local_names, "__ctor_ptr")
      let actual_args = if Array::length(args) == 1 {
        match Array::get(args, 0) {
          ERecord(rec_fields) => {
            let mut si2 = 0
            let mut sn_idx = -1
            while si2 < Array::length(ctx.ctor_table.struct_names) {
              if Array::get(ctx.ctor_table.struct_names, si2) == fname {
                sn_idx = si2
                si2 = Array::length(ctx.ctor_table.struct_names)
              } else {
                si2 = si2 + 1
              }
            }
            if sn_idx >= 0 {
              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)
              let ordered = Array::slice([
                EUnit
              ], 0, 0)
              let mut oi = 0
              while oi < Array::length(def_fnames) {
                let target_name = Array::get(def_fnames, oi)
                let mut ri = 0
                let mut found_rfv = EUnit
                while ri < Array::length(rec_fields) {
                  let (rfn, rfv) = Array::get(rec_fields, ri)
                  if rfn == target_name {
                    found_rfv = rfv
                    ri = Array::length(rec_fields)
                  } else {
                    ri = ri + 1
                  }
                }
                Array::push(ordered, found_rfv)
                oi = oi + 1
              }
              ordered
            } else {
              args
            }
          },
          _ => args
        }
      } else {
        args
      }
      if ctx.enable_rc {
        let total = 16 + fc * 8
        emit_i64_const(buf, total)
        emit_call(buf, ctx.rc_alloc_func_idx)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, total)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store(buf, 2, 4)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store8(buf, 0, 7)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, tag)
        emit_i32_store(buf, 2, 8)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, fc)
        emit_i32_store(buf, 2, 12)
        let mut nl_c = next_local + 1
        let mut fi_c = 0
        while fi_c < Array::length(actual_args) {
          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)
          let val_local = nl_c
          Array::push(local_names, "__ctor_val")
          emit_local_set(buf, val_local)
          nl_c = nl_c + 1
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 16 + fi_c * 8)
          fi_c = fi_c + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 8)
        emit_i64_add(buf)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_c
      } else {
        let obj_size = 8 + fc * 8
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, ptr_local)
        emit_global_get(buf, 0)
        emit_i32_const(buf, obj_size)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_heap_grow_after_heap_set(buf, ctx)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, tag)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, fc)
        emit_i32_store(buf, 2, 4)
        let mut nl_c = next_local + 1
        let mut fi_c = 0
        while fi_c < Array::length(actual_args) {
          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)
          let val_local = nl_c
          Array::push(local_names, "__ctor_val")
          emit_local_set(buf, val_local)
          nl_c = nl_c + 1
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 8 + fi_c * 8)
          fi_c = fi_c + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_c
      }
    }
    else if !prefer_bound_call && fname == "eq" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_eq(buf)
      emit_i64_extend_i32_s(buf)
      nl
    }
    else if !prefer_bound_call && fname == "not" {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      nl
    }
    else if !prefer_bound_call && fname == "add" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_add(buf)
      nl
    }
    else if !prefer_bound_call && fname == "sub" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_sub(buf)
      nl
    }
    else if !prefer_bound_call && fname == "mul" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_mul(buf)
      nl
    }
    else if !prefer_bound_call && fname == "lt" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_lt_s(buf)
      emit_i64_extend_i32_s(buf)
      nl
    }
    else if !prefer_bound_call && fname == "perform" {
      let mut nl = next_local
      let g_rbuf = if ctx.enable_rc {
        5
      } else {
        4
      }
      let op_expr = Array::get(args, 0)
      let op_head = if is_eident(op_expr) {
        get_eident_name(op_expr)
      } else if expr_tag(op_expr) == 8 {
        let op_callee = get_ecall_callee(op_expr)
        if is_eident(op_callee) {
          get_eident_name(op_callee)
        } else {
          ""
        }
      } else {
        ""
      }
      let eff_tag = effect_name_to_tag(ctx.effect_names, op_head)
      let eff_off = (eff_tag - 3) * 8192
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 0)
      emit_global_set(buf, 1)
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_global_get(buf, 1)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_i64_store(buf, 3, 0)
      emit_global_get(buf, 1)
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 8)
      emit_i64_lt_s(buf)
      emit_if_i64(buf)
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_global_get(buf, 1)
      emit_i64_const(buf, 8)
      emit_i64_mul(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 16)
      emit_else(buf)
      let op_canon = canonical_builtin_name(op_head)
      let __ft_len = Array::length(ctx.func_table.names)
      let mut op_is_builtin = false
      let mut __op_i = 0
      while __op_i < __ft_len {
        if Array::get(ctx.func_table.names, __op_i) == op_canon {
          op_is_builtin = true
          __op_i = __ft_len
        } else {
          __op_i = __op_i + 1
        }
      }
      if op_is_builtin {
        nl = ce(buf, op_expr, local_names, nl, ctx, ld)
      } else if expr_tag(op_expr) == 8 {
        let op_args = get_ecall_args(op_expr)
        if Array::length(op_args) > 1 {
          // User effect ops thread only a single thrown payload, so extra args
          // would be silently dropped. Reject arity > 1 with a clear error
          // (#548); builtins are handled by the op_is_builtin branch above.
          throw("perform: effect operations with more than one argument are not supported yet (see #548); pack the values into a single argument")
        } else if Array::length(op_args) > 0 {
          nl = ce(buf, Array::get(op_args, 0), local_names, nl, ctx, ld)
        } else {
          emit_i64_const(buf, 0)
        }
      } else {
        emit_i64_const(buf, 0)
      }
      bytebuf_push(buf, 8)
      bytebuf_push(buf, eff_tag)
      emit_end(buf)
      nl
    }
    else if !prefer_bound_call && fname == "path" {
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "__float_bits" {
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "__to_string" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      let val_l = nl
      let neg_l = nl + 1
      let cur_l = nl + 2
      let abs_l = nl + 3
      let hp_l = nl + 4
      let len_l = nl + 5
      Array::push(local_names, "__ts_val")
      Array::push(local_names, "__ts_neg")
      Array::push(local_names, "__ts_cur")
      Array::push(local_names, "__ts_abs")
      Array::push(local_names, "__ts_hp")
      Array::push(local_names, "__ts_len")
      emit_local_set(buf, val_l)
      emit_block_i64(buf)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 32)
      bytebuf_push(buf, 136)
      emit_local_tee(buf, abs_l)
      emit_i64_const(buf, 0)
      emit_i64_gt_s(buf)
      emit_local_get(buf, abs_l)
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_i64_lt_s(buf)
      bytebuf_push(buf, 113)
      emit_if_void(buf)
      emit_local_get(buf, val_l)
      emit_br(buf, 1)
      emit_end(buf)
      emit_i64_const(buf, 46)
      emit_local_set(buf, cur_l)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_i64_extend_i32_s(buf)
      emit_local_set(buf, neg_l)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_if_i64(buf)
      emit_i64_const(buf, 0)
      emit_local_get(buf, val_l)
      emit_i64_sub(buf)
      emit_else(buf)
      emit_local_get(buf, val_l)
      emit_end(buf)
      emit_local_set(buf, abs_l)
      emit_local_get(buf, abs_l)
      emit_i64_eqz(buf)
      emit_if_void(buf)
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 48)
      emit_i32_store8(buf, 0, 0)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      emit_end(buf)
      emit_block_void(buf)
      emit_loop_void(buf)
      emit_local_get(buf, abs_l)
      emit_i64_eqz(buf)
      emit_br_if(buf, 1)
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, abs_l)
      emit_i64_const(buf, 10)
      emit_i64_rem_s(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 48)
      emit_i32_add(buf)
      emit_i32_store8(buf, 0, 0)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      emit_local_get(buf, abs_l)
      emit_i64_const(buf, 10)
      emit_i64_div_s(buf)
      emit_local_set(buf, abs_l)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_local_get(buf, neg_l)
      emit_i32_wrap_i64(buf)
      emit_if_void(buf)
      emit_local_get(buf, cur_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 45)
      emit_i32_store8(buf, 0, 0)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_sub(buf)
      emit_local_set(buf, cur_l)
      emit_end(buf)
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, hp_l)
      emit_i64_const(buf, 46)
      emit_local_get(buf, cur_l)
      emit_i64_sub(buf)
      emit_local_set(buf, len_l)
      emit_local_get(buf, hp_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cur_l)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, len_l)
      emit_i32_wrap_i64(buf)
      emit_memory_copy(buf)
      emit_local_get(buf, hp_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, len_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 7)
      emit_i32_add(buf)
      emit_i32_const(buf, -8)
      bytebuf_push(buf, 113)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, hp_l)
      emit_i64_const(buf, 32)
      emit_i64_shl(buf)
      emit_local_get(buf, len_l)
      emit_i64_or(buf)
      emit_end(buf)
      nl + 6
    }
    else if fname == "Double::to_int" || fname == "Float::to_int" {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      if ctx.enable_rc {
        emit_unbox_float(buf)
      }
      emit_f64_reinterpret_i64(buf)
      emit_i64_trunc_f64_s(buf)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      nl
    }
    else if fname == "Int::to_double" || fname == "Int::to_float" {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
      }
      emit_f64_convert_i64_s(buf)
      emit_i64_reinterpret_f64(buf)
      if ctx.enable_rc {
        Array::push(local_names, "__fbits")
        Array::push(local_names, "__fbox")
        emit_box_float(buf, ctx, nl, nl + 1)
        nl + 2
      } else {
        nl
      }
    }
    else if fname == "Float::to_double" || fname == "Double::to_float" {
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "resume" {
      let g_cur = if ctx.enable_rc {
        3
      } else {
        2
      }
      emit_global_get(buf, g_cur)
      emit_i32_wrap_i64(buf)
      emit_global_get(buf, g_cur)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 8)
      emit_i64_const(buf, 8)
      emit_i64_mul(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_add(buf)
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_store(buf, 3, 16)
      emit_global_get(buf, g_cur)
      emit_i32_wrap_i64(buf)
      emit_global_get(buf, g_cur)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 8)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
