      let loop_body = ESeq(ECall(EIdent("Array::push", -1), [
        EIdent("__tb_arr", -1),
        ECall(EIdent("String::char_code_at", -1), [
          EIdent("__tb_s", -1),
          EIdent("__tb_i", -1)
        ], -1)
      ], -1), EAssign("__tb_i", ECall(EIdent("add", -1), [
        EIdent("__tb_i", -1),
        EInt(1)
      ], -1), EUnit))
      let synth = ELet("__tb_s", s_expr, ELetMut("__tb_arr", EArray(Array::slice([
        EUnit
      ], 0, 0)), ELetMut("__tb_i", EInt(0), ESeq(EWhile(ECall(EIdent("lt", -1), [
        EIdent("__tb_i", -1),
        ECall(EIdent("String::length", -1), [
          EIdent("__tb_s", -1)
        ], -1)
      ], -1), loop_body), EIdent("__tb_arr", -1)))))
