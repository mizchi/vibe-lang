//# Functions

// ADR-0055 Stage 4: a runtime-guarded rc_dup of the value in `local_idx` — a
// no-op on an even (scalar) value or a string/bytes fat pointer (high 32 bits
// set). Replica of compile_expr_tail's emit_rc_dup_guarded (avoids a circular
// import: the tail chain calls compile_lambda).
let lam_emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 1)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 32)
  emit_i64_shr_s(buf)
  emit_i64_eqz(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
  emit_end(buf)
}

export let compile_lambda: (Bytes, Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, params, fn_body, local_names, next_local, ctx, ld, compile_fn) -> {
  let param_names_arr = Array::slice([
    ""
  ], 0, 0)
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, _) = Array::get(params, pi)
    Array::push(param_names_arr, pname)
    pi = pi + 1
  }
  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)
  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)
  let num_captures = Array::length(captures)
  let user_params = Array::length(params)
  let lam_buf = bytebuf_new()
  let lam_locals = Array::slice([
    ""
  ], 0, 0)
  let mut lpi = 0
  while lpi < user_params {
    let (lpname_raw, _) = Array::get(params, lpi)
    let lpnlen = String::length(lpname_raw)
    let lpname = if lpnlen > 0 {
      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)
      if lpc == '~' {
        lpname_raw[0: lpnlen - 1]
      } else if lpc == '?' {
        lpname_raw[0: lpnlen - 1]
      } else {
        lpname_raw
      }
    } else lpname_raw
    Array::push(lam_locals, lpname)
    lpi = lpi + 1
  }
  Array::push(lam_locals, "__env")
  let env_param_idx = user_params
  let lam_nl_start = user_params + 1
  let lam_ref_cells = Array::slice([
    ""
  ], 0, 0)
  let mut ci3 = 0
  let mut lam_nl = lam_nl_start
  while ci3 < num_captures {
    let cap_local = lam_nl
    let cap_name = Array::get(captures, ci3)
    emit_local_get(lam_buf, env_param_idx)
    emit_i32_wrap_i64(lam_buf)
    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)
    emit_local_set(lam_buf, cap_local)
    Array::push(lam_locals, cap_name)
    if array_contains_str(ctx.ref_cell_names, cap_name) {
      Array::push(lam_ref_cells, cap_name)
    }
    lam_nl = lam_nl + 1
    ci3 = ci3 + 1
  }
  // RC: a lambda body has its own scope, so run the Perceus analysis on it and
  // give the lambda ctx its own drop set (otherwise per-iteration tuples in a
  // callback / returned closure leak). ADR-0055 Stage 4 (owned-vs-borrowed): the
  // analysis also declares the parameters as owned bindings, so a heap param used
  // only by borrows is dropped at the body tail rather than leaked.
  // norm_params = params with the labeled-arg `~`/`?` suffix stripped, matching
  // how the body references them (and how lam_locals were named).
  let norm_params = Array::slice(params, 0, 0)
  let mut npi = 0
  while npi < Array::length(params) {
    let (rawn, pty) = Array::get(params, npi)
    let rnlen = String::length(rawn)
    let sn = if rnlen > 0 {
      let lc = String::char_code_at(rawn, rnlen - 1)
      if lc == '~' || lc == '?' {
        rawn[0: rnlen - 1]
      } else {
        rawn
      }
    } else {
      rawn
    }
    Array::push(norm_params, (sn, pty))
    npi = npi + 1
  }
  let lam_drops = Array::slice([
    ""
  ], 0, 0)
  let lam_alias_dups = Array::slice([
    ""
  ], 0, 0)
  let lam_dups = Array::slice([
    ""
  ], 0, 0)
  let lam_heap_params = Array::slice([
    ""
  ], 0, 0)
  if ctx.enable_rc {
    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body)
    let mut ldi = 0
    while ldi < Array::length(lam_plan) {
      let lpa = Array::get(lam_plan, ldi)
      if pa_is_drop(lpa) {
        Array::push(lam_drops, lpa.name)
      } else if pa_is_alias_dup(lpa) {
        Array::push(lam_alias_dups, lpa.name)
      } else if pa_is_dup(lpa) {
        Array::push(lam_dups, lpa.name)
      } else {
        ()
      }
      ldi = ldi + 1
    }
    let mut hpi = 0
    while hpi < Array::length(norm_params) {
      let (hpn, hpt) = Array::get(norm_params, hpi)
      if type_expr_is_heap(hpt) {
        Array::push(lam_heap_params, hpn)
      } else {
        ()
      }
      hpi = hpi + 1
    }
  }
  let lam_ctx = CompileCtx::{
    func_table: ctx.func_table, str_table: ctx.str_table,
    lambda_table: ctx.lambda_table,
    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,
    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,
    thunk_names: ctx.thunk_names,
    const_int_names: ctx.const_int_names,
    const_int_values: ctx.const_int_values,
    enable_rc: ctx.enable_rc,
    rc_drop_names: lam_drops,
    rc_alias_dup_names: lam_alias_dups,
    heap_binding_names: lam_heap_params,
    rc_drop_func_idx: ctx.rc_drop_func_idx,
    rc_alloc_func_idx: ctx.rc_alloc_func_idx,
    rc_dup_names: lam_dups,
    // Fresh scope: the lambda's own `let`s repopulate this; parent float locals
    // are not in scope here (captures are reached via the env, not by name).
    float_binding_names: Array::slice([""], 0, 0)
  }
  // ADR-0055 Stage 4: emit the owning-use dup budget for heap params at function
  // entry (one guarded rc_dup per plan PaDup(param)) — a param used in N owning
  // positions needs N-1 extra refs. Param i lives at local index i.
  if ctx.enable_rc {
    let mut dpi = 0
    while dpi < Array::length(norm_params) {
      let (dpn, dpt) = Array::get(norm_params, dpi)
      if type_expr_is_heap(dpt) {
        let mut dcount = 0
        let mut dqi = 0
        while dqi < Array::length(lam_dups) {
          if Array::get(lam_dups, dqi) == dpn {
            dcount = dcount + 1
          } else {
            ()
          }
          dqi = dqi + 1
        }
        let mut de = 0
        while de < dcount {
          lam_emit_rc_dup_guarded(lam_buf, dpi)
          de = de + 1
        }
      } else {
        ()
      }
      dpi = dpi + 1
    }
  } else {
    ()
  }
  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)
  // ADR-0055 Stage 4: drop owned heap params (borrow-only / unused, hence in the
  // plan's drop set) at the body tail. The body result is on the stack. If that
  // result is a projection rooted at one of the dropped params, dup it first
  // (the recursive drop would otherwise free the field it aliases — use-after
  // -free); the guarded dup is a no-op on a scalar result.
  let mut tail_lam_nl = final_lam_nl
  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {
    let tail_root = scope_tail_proj_root(fn_body)
    let mut need_dup = false
    let mut ti = 0
    while ti < Array::length(norm_params) {
      let (tpn, tpt) = Array::get(norm_params, ti)
      if type_expr_is_heap(tpt) && array_contains_str(lam_drops, tpn) && tpn == tail_root {
        need_dup = true
      } else {
        ()
      }
      ti = ti + 1
    }
    let rtemp = final_lam_nl
    if need_dup {
      emit_local_set(lam_buf, rtemp)
      lam_emit_rc_dup_guarded(lam_buf, rtemp)
      tail_lam_nl = final_lam_nl + 1
    } else {
      ()
    }
    let mut tj = 0
    while tj < Array::length(norm_params) {
      let (dpn2, dpt2) = Array::get(norm_params, tj)
      if type_expr_is_heap(dpt2) && array_contains_str(lam_drops, dpn2) {
        emit_local_get(lam_buf, tj)
        emit_call(lam_buf, ctx.rc_drop_func_idx)
      } else {
        ()
      }
      tj = tj + 1
    }
    if need_dup {
      emit_local_get(lam_buf, rtemp)
    } else {
      ()
    }
  } else {
    ()
  }
  let lambda_idx = Array::length(ctx.lambda_table.bodies)
  Array::push(ctx.lambda_table.bodies, lam_buf)
  Array::push(ctx.lambda_table.param_counts, user_params + 1)
  Array::push(ctx.lambda_table.captures, captures)
  let mut extra_lam = 0
  let min_lam_nl = user_params + 1
  if tail_lam_nl > min_lam_nl {
    extra_lam = tail_lam_nl - min_lam_nl
  }
  Array::push(ctx.lambda_table.meta_i32, 0)
  Array::push(ctx.lambda_table.meta_i64, extra_lam)
  let table_slot = ctx.num_user_funcs + lambda_idx
  if num_captures == 0 {
    emit_i64_const(buf, (table_slot<<2)|2)
    next_local
  } else {
    let ptr_local = next_local
    let nl2 = next_local + 1
    Array::push(local_names, "__closure_ptr")
    // ADR-0055 Stage 4: under RC the closure env is a headered, drop-class-1
    // (field-vector) block allocated via __rc_alloc, so it is reclaimed and its
    // heap captures recursively dropped (otherwise a closure capturing a tuple
    // leaks). The value points at block_start+8 (past the 8-byte header), so the
    // call path's value-relative offsets (slot@value+0, captures@value+8) and the
    // `& -4`/`& -2` untags line up exactly as in the unheadered default layout.
    // Default path stays a raw bump alloc (value = block_start | 1).
    let cap_off = if ctx.enable_rc {
      16
    } else {
      8
    }
    if ctx.enable_rc {
      let total = 16 + num_captures * 8
      emit_i64_const(buf, total)
      emit_call(buf, ctx.rc_alloc_func_idx)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, total)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store(buf, 2, 4)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store8(buf, 0, 7)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, table_slot)
      emit_i32_store(buf, 2, 8)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, num_captures)
      emit_i32_store(buf, 2, 12)
    } else {
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 8 + num_captures * 8)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, table_slot)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, num_captures)
      emit_i32_store(buf, 2, 4)
    }
    let mut csi = 0
    while csi < num_captures {
      let cap_name = Array::get(captures, csi)
      let mut __cap_resolve = -1
      let mut __cri = Array::length(local_names) - 1
      while __cri >= 0 {
        if Array::get(local_names, __cri) == cap_name {
          __cap_resolve = __cri
          __cri = -1
        } else {
          __cri = __cri - 1
        }
      }
      if __cap_resolve >= 0 {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, __cap_resolve)
        emit_i64_store(buf, 3, cap_off + csi * 8)
      } else {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i64_const(buf, 0)
        emit_i64_store(buf, 3, cap_off + csi * 8)
      }
      csi = csi + 1
    }
    if ctx.enable_rc {
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 8)
      emit_i64_add(buf)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
    } else {
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
    }
    nl2
  }
}
