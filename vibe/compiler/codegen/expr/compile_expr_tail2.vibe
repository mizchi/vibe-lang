//# Functions

export let compile_expr_tail2: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {
  let __tag = expr_tag(expr)
  if __tag == 15 {
    let __tuple_elems = get_etuple_elems(expr)
    let num_elems = Array::length(__tuple_elems)
    let ptr_local = next_local
    Array::push(local_names, "__tuple_ptr")
    let mut nl = next_local + 1
    if ctx.enable_rc {
      // RC layout (docs/spec/selfhost-rc-port.md):
      //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]
      // The tuple value is block_start+8 (points at type_id), so the live header
      // is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0][length@ptr+4] and the
      // payload stays at ptr+8 (field access is unchanged). ptr_local holds
      // block_start. type_id 3 = tuple.
      let total = 16 + num_elems * 8
      // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc) —
      // exact-fit reuse anywhere in the list, else bump. Replaces the inline
      // head-only check, which fragmented when interleaved sizes were freed.
      emit_i64_const(buf, total)
      emit_call(buf, ctx.rc_alloc_func_idx)
      emit_local_set(buf, ptr_local)
      // header words at block_start
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, total)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store(buf, 2, 4)
      // ADR-0055 Stage 2c/3: uniform drop-class byte in the rc_count word's high
      // byte (block+7 = value-1). rc stays in the low 24 bits, so dec (full-word
      // -1) and the `*256 == 0` zero-test ignore this byte. 1 = field-vector
      // ([?@value+0][count@value+4][fields@value+8+i*8]) — the generic recursive
      // rc_drop loops `count` fields. (docs/spec/selfhost-uniform-value-repr.md)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store8(buf, 0, 7)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 3)
      emit_i32_store(buf, 2, 8)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, num_elems)
      emit_i32_store(buf, 2, 12)
      let mut tri = 0
      while tri < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = compile_expr(buf, Array::get(__tuple_elems, tri), local_names, nl, ctx, ld)
        emit_i64_store(buf, 3, 16 + tri * 8)
        tri = tri + 1
      }
      // tuple value = (block_start + 8) | 1 (ADR-0055 Stage 2: all heap pointers
      // are odd so a generic recursive rc_drop can classify fields by `& 1`).
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 8)
      emit_i64_add(buf)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl
    } else {
      let alloc_size = num_elems * 8
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      emit_local_get(buf, ptr_local)
      nl
    }
  } else if __tag == 16 {
    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  } else if __tag == 17 {
    let elems = get_earray_elems(expr)
    let n_elems = Array::length(elems)
    if ctx.enable_rc {
      // RC array literal: inline-allocate the array object with the tuple-style
      // RC layout so it drops like a tuple (value = block+8, untagged). Object
      // layout at the value pointer matches the array runtime
      // (`[capacity@0][length@4][data_ptr@8][inline_data@12...]`); data_ptr points
      // at the inline buffer (value+12). capacity defaults to 8 (as array_new)
      // but is sized up for larger literals so all elements fit inline.
      // The header behind is [alloc_size@-8][rc_count@-4]; the array runtime
      // (Array::get / length / push) reads value+0/+4/+8, unchanged.
      // (docs/spec/selfhost-rc-port.md)
      let cap = if n_elems > 8 {
        n_elems
      } else {
        8
      }
      let total = 20 + cap * 8
      let ptr_local = next_local
      Array::push(local_names, "__arr_ptr")
      let mut nl = next_local + 1
      // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc).
      emit_i64_const(buf, total)
      emit_call(buf, ctx.rc_alloc_func_idx)
      emit_local_set(buf, ptr_local)
      // header at block_start
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, total)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store(buf, 2, 4)
      // ADR-0055 Stage 2c/3: drop-class byte (block+7). 5 = array — value+0 is
      // capacity (not a count) and elements live behind data_ptr@value+8, so the
      // recursive rc_drop must use the array path, not the field-vector loop.
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 5)
      emit_i32_store8(buf, 0, 7)
      // array object at block_start+8 = value: capacity, length, data_ptr
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, cap)
      emit_i32_store(buf, 2, 8)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, n_elems)
      emit_i32_store(buf, 2, 12)
      // data_ptr = value + 12 = block_start + 20 (inline buffer)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 20)
      emit_i32_add(buf)
      emit_i32_store(buf, 2, 16)
      // store elements at block_start + 20 + i*8
      let mut ai = 0
      while ai < n_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = compile_expr(buf, Array::get(elems, ai), local_names, nl, ctx, ld)
        emit_i64_store(buf, 3, 20 + ai * 8)
        ai = ai + 1
      }
      // array value = (block_start + 8) | 1 (ADR-0055 Stage 2b: odd heap pointer)
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 8)
      emit_i64_add(buf)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl
    } else {
      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, "array_new")
      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
      let arr_local = next_local
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < Array::length(elems) {
        emit_local_get(buf, arr_local)
        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
    }
  } else if __tag == 18 {
    let names_len_at_forin = Array::length(local_names)
    let var_name = get_eforin_name(expr)
    let iter_expr = get_eforin_iter(expr)
    let body = get_eforin_body(expr)
    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, "array_new")
    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, "Array::length")
    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, "Array::get")
    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, "Array::push")
    let result_local = next_local
    let arr_local = next_local + 1
    let i_local = next_local + 2
    Array::push(local_names, "__forin_res")
    Array::push(local_names, "__forin_arr")
    Array::push(local_names, "__forin_i")
    emit_call(buf, arr_new_fi)
    emit_local_set(buf, result_local)
    let nl1 = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)
    emit_local_set(buf, arr_local)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_local)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_local)
    emit_local_get(buf, arr_local)
    emit_call(buf, arr_len_fi)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    // Indexed `for i, x in arr`: bind the loop counter to the user index name
    // before the value var (gc backend parity — backend_expr.vibe). The counter
    // `i_local` is a raw i64; under RC ints are `value << 1`, so shift to match
    // the user-visible Int representation (same as EInt codegen).
    let index_name = get_eforin_index(expr)
    let var_local = match index_name {
      Some(idx_name) => {
        emit_local_get(buf, i_local)
        if ctx.enable_rc {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        }
        emit_local_set(buf, nl1)
        Array::push(local_names, idx_name)
        nl1 + 1
      },
      None => nl1
    }
    emit_local_get(buf, arr_local)
    emit_local_get(buf, i_local)
    emit_call(buf, arr_get_fi)
    emit_local_set(buf, var_local)
    Array::push(local_names, var_name)
    let nl2 = var_local + 1
    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, ld + 1)
    let body_val = nl3
    Array::push(local_names, "__forin_val")
    emit_local_set(buf, body_val)
    emit_local_get(buf, result_local)
    emit_local_get(buf, body_val)
    emit_call(buf, arr_push_fi)
    emit_local_get(buf, i_local)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_local)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf, result_local)
    // Restore the outer scope. The loop's internal bindings (result/arr/i, the
    // optional index name, the value name, and the body temp) must not leak into
    // later identifier lookups, which scan local_names from the end and would
    // otherwise resolve a shadowed outer var to a stale loop slot. Mirror
    // compile_match: truncate back to the entry length, then pad with placeholders
    // up to the high-water local count so slot numbering is preserved.
    let final_nl = nl3 + 1
    Array::truncate(local_names, names_len_at_forin)
    while Array::length(local_names) < final_nl {
      Array::push(local_names, "")
    }
    final_nl
  } else {
    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}
