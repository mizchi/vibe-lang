//# Functions

// eq(a, b): first try i64 bitwise eq, then fall back to String::equals
export let gen_eq_body = (str_eq_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_i64_eq(b)
  emit_if_i64(b)
  emit_i64_const(b, 1)
  emit_else(b)
  // Fallback: try string equality
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_end(b)
  b
}
