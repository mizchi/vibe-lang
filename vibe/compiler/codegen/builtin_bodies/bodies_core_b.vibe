export let gen_print_i64_body: () -> Bytes = () -> {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_local_get(b, 0)
  emit_i64_sub(b)
  emit_else(b)
  emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 48)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_rem_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_const(b, 48)
  emit_i32_add(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_div_s(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 45)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

export let gen_print_str_body: () -> Bytes = () -> {
