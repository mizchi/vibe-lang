let static_arr_get_body_bytes = Bytes::from_array([32, 0, 167, 40, 2, 8, 33, 2, 32, 2, 32, 1, 167, 65, 3, 116, 106, 41, 3, 0])
let static_arr_len_body_bytes = Bytes::from_array([32, 0, 167, 40, 2, 4, 173])
let static_arr_new_body_bytes = Bytes::from_array([35, 0, 34, 0, 65, 204, 0, 106, 36, 0, 32, 0, 65, 8, 54, 2, 0, 32, 0, 65, 0, 54, 2, 4, 32, 0, 32, 0, 65, 12, 106, 54, 2, 8, 32, 0, 173])
