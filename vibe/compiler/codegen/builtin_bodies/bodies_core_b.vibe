export let gen_str_char_code_at_body: (Bool) -> Bytes = (enable_rc) -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  // ADR-0055 Stage 1: the index argument is a tagged int (idx<<1) under RC;
  // untag it before using it as a byte offset.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: the char code is a count entering the value world; tag it.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

export let gen_string_ends_with_body: (Bool, Int, Int, Int) -> Bytes = (enable_rc, str_len_idx, str_substring_idx, str_eq_idx) -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  // ADR-0055: String::length is value-world (tagged) under RC; untag to a raw
  // length. `substring` stays raw, so its args are passed raw as before.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_end(b)
  b
}

