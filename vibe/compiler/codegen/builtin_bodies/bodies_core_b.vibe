// String::index_of(haystack, needle) -> Int (-1 if not found)
// Forward scan version of last_index_of
export let gen_string_index_of_body = (str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes {
  let b = bytebuf_new()
  // local 2 = len_haystack, local 3 = len_needle, local 4 = i, local 5 = sub
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  // i32.gt_u
  emit_if_i64(b)
  emit_i64_const(b, -1)
  emit_else(b)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  // local 2 = max_offset
  emit_block_i64(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  // i32.gt_u (if i > max_offset, break)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_local_set(b, 5)
  emit_local_get(b, 5)
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_i32_wrap_i64(b)
  emit_if_void(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_br(b, 3)
  emit_end(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_i64_const(b, -1)
  emit_end(b)
  emit_end(b)
  b
}

// String::contains(haystack, needle) -> Bool
// Delegates to index_of >= 0
export let gen_string_contains_body = (string_index_of_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_call(b, string_index_of_idx)
  emit_i64_const(b, 0)
  emit_i64_ge_s(b)
  emit_i64_extend_i32_u(b)
  b
}

// String::starts_with(s, prefix) -> Bool
// Delegates to substring + equals
export let gen_string_starts_with_body = (str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes {
  let b = bytebuf_new()
  // local 2 = len_s, local 3 = len_prefix, local 4 = sub
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  // i32.gt_u
  emit_if_i64(b)
  emit_i64_const(b, 0)
  // false
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_end(b)
  b
}

// String::split(s, sep) -> Array[String]
// Uses arr_new, arr_push, str_len, str_substring, string_index_of
export let gen_string_split_body = (arr_new_idx: Int, arr_push_idx: Int, str_len_idx: Int, str_substring_idx: Int, string_index_of_idx: Int) -> Bytes {
  let b = bytebuf_new()
  // locals: 0=s(i64), 1=sep(i64), 2=s_len(i32), 3=sep_len(i32), 4=start(i32), 5=idx(i32), 6=arr(i64)
  emit_call(b, arr_new_idx)
  emit_local_set(b, 6)
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  // loop
  emit_block_void(b)
  emit_loop_void(b)
  // idx = index_of(substring(s, start, s_len), sep)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_local_get(b, 1)
  emit_call(b, string_index_of_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  // if idx < 0, break
  emit_local_get(b, 5)
  emit_i32_const(b, 0)
  bytebuf_push(b, 72)
  // i32.lt_s
  emit_br_if(b, 1)
  // push substring(s, start, start + idx)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  // start = start + idx + sep_len
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // push remaining: substring(s, start, s_len)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 6)
  b
}

// String::trim(s) -> String
// Scans whitespace from both ends, returns substring
export let gen_string_trim_body = (str_len_idx: Int, str_char_code_at_idx: Int, str_substring_idx: Int) -> Bytes {
  let b = bytebuf_new()
  // locals: 0=s, 1=len, 2=start, 3=end
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_i32_const(b, 0)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_local_set(b, 3)
  // scan start forward while whitespace
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_char_code_at_idx)
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 4)
  // check if whitespace: 32=' ', 9=tab, 10=lf, 13=cr
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  // i32.or
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  // i32.or
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  // i32.or
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 2)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // scan end backward while whitespace
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 76)
  // i32.le_u
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_char_code_at_idx)
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 4)
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // return substring(s, start, end)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  b
}

export let gen_selfhost_sources_proper_body = (num_sources: Int, str_offsets: Array[Int], str_lengths: Array[Int], src_str_base: Int, arr_new_idx: Int, arr_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, arr_new_idx)
  // arr_new -> i64
  emit_local_set(b, 1)
  // local 1 (i64) = array
  let mut si = 0
  while si < num_sources {
    let path_idx = src_str_base + si * 2
    let content_idx = src_str_base + si * 2 + 1
    let path_off = Array::get(str_offsets, path_idx)
    let path_len = Array::get(str_lengths, path_idx)
    let content_off = Array::get(str_offsets, content_idx)
    let content_len = Array::get(str_lengths, content_idx)
    emit_global_get(b, 0)
    // heap_ptr (i32)
    emit_local_tee(b, 0)
    // local 0 (i32) = tuple_ptr
    emit_i32_const(b, 16)
    emit_i32_add(b)
    emit_global_set(b, 0)
    // heap_ptr += 16
    emit_local_get(b, 0)
    let path_ref = (path_off<<32)|path_len
    emit_i64_const(b, path_ref)
    emit_i64_store(b, 3, 0)
    emit_local_get(b, 0)
    let content_ref = (content_off<<32)|content_len
    emit_i64_const(b, content_ref)
    emit_i64_store(b, 3, 8)
    emit_local_get(b, 1)
    // array ref (i64)
    emit_local_get(b, 0)
    // tuple_ptr (i32)
    emit_i64_extend_i32_u(b)
    // extend to i64
    emit_call(b, arr_push_idx)
    // arr_push(i64, i64)
    si = si + 1
  }
  emit_local_get(b, 1)
  b
}
