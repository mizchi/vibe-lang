}

export let gen_arr_truncate_body: (Bool) -> Bytes = (enable_rc) -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  // ADR-0055: untag the odd array pointer under RC.
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_get(b, 1)
  // ADR-0055: the new length arrives tagged; untag before storing.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_store(b, 2, 4)
  b
}

export let gen_string_split_body: (Bool, Int, Int, Int, Int, Int) -> Bytes = (enable_rc, arr_new_idx, arr_push_idx, str_len_idx, str_substring_idx, string_index_of_idx) -> {
  let b = bytebuf_new()
  emit_call(b, arr_new_idx)
  emit_local_set(b, 6)
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_local_get(b, 1)
  emit_call(b, string_index_of_idx)
  // ADR-0055: String::index_of returns a tagged index under RC; untag for use.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 5)
  emit_i32_const(b, 0)
  bytebuf_push(b, 72)
  emit_br_if(b, 1)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 6)
  b
}

