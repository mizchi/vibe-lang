export let gen_string_last_index_of_body: (Bool, Int, Int, Int) -> Bytes = (enable_rc, str_len_idx, str_substring_idx, str_eq_idx) -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
