}

export let gen_arr_concat_body: () -> Bytes = () -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 6)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 7)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_global_get(b, 0)
  emit_local_tee(b, 9)
  emit_i32_const(b, 12)
  emit_local_get(b, 8)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 9)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_local_set(b, 10)
  emit_local_get(b, 9)
  emit_local_get(b, 10)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 10)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_memory_copy(b)
  emit_local_get(b, 10)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_local_get(b, 7)
  emit_local_get(b, 5)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_memory_copy(b)
  emit_local_get(b, 9)
  emit_i64_extend_i32_u(b)
