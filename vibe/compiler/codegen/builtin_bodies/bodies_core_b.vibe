}

export let gen_str_concat_body: () -> Bytes = () -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_local_get(b, 2)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_add(b)
  emit_local_get(b, 5)
  emit_local_get(b, 3)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

export let gen_string_join_body: (Int, Int, Int) -> Bytes = (arr_len_idx, arr_get_idx, str_concat_idx) -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, arr_len_idx)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_i32_eqz(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_call(b, arr_get_idx)
  emit_local_set(b, 4)
  emit_i32_const(b, 1)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_call(b, str_concat_idx)
  emit_local_set(b, 4)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  emit_call(b, arr_get_idx)
  emit_local_set(b, 5)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_call(b, str_concat_idx)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 4)
  emit_end(b)
  b
}

export let gen_string_trim_body: (Bool, Int, Int, Int) -> Bytes = (enable_rc, str_len_idx, str_char_code_at_idx, str_substring_idx) -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_i32_const(b, 0)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  // ADR-0055: char_code_at is value-world under RC — tag the index it consumes.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_char_code_at_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 4)
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 2)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 76)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_char_code_at_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 4)
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  emit_call(b, str_substring_idx)
  b
}

let static_eq_body_bytes = Bytes::from_array([
