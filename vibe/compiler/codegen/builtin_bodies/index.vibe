export let gen_string_ends_with_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, 9)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, 9)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  // i32.gt_u
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  emit_call(b, 21)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_call(b, 10)
  emit_end(b)
  b
}

