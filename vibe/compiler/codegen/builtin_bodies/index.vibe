}

export let gen_arr_concat_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 6)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 7)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_global_get(b, 0)
  emit_local_tee(b, 9)
  emit_i32_const(b, 12)
  emit_local_get(b, 8)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl
  emit_i32_add(b)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 9)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_local_set(b, 10)
  emit_local_get(b, 9)
  emit_local_get(b, 10)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 10)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl
  emit_memory_copy(b)
  emit_local_get(b, 10)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 7)
  emit_local_get(b, 5)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl
  emit_memory_copy(b)
  emit_local_get(b, 9)
  emit_i64_extend_i32_u(b)
  b
}

export let gen_str_concat_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 6)
  // dest
  emit_local_get(b, 4)
  // src
  emit_local_get(b, 2)
  // len
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_add(b)
  // dest = new_ptr + len_a
  emit_local_get(b, 5)
  // src
  emit_local_get(b, 3)
  // len
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

export let gen_string_join_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, 13)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_i32_eqz(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_call(b, 14)
  emit_local_set(b, 4)
  emit_i32_const(b, 1)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_call(b, 11)
  emit_local_set(b, 4)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  emit_call(b, 14)
  emit_local_set(b, 5)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_call(b, 11)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  // end loop
  emit_end(b)
  // end block
  emit_local_get(b, 4)
  emit_end(b)
  // end if
  b
}

export let gen_arr_truncate_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_store(b, 2, 4)
  b
}

