//# Functions

export let gen_eq_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_i64_eq(b)
  emit_i64_extend_i32_u(b)
  b
}


export let gen_str_eq_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_ne(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_i32_const(b, 0)
  emit_local_set(b, 6)
  emit_block_i64(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  // break to inner block_void
  emit_local_get(b, 4)
  emit_local_get(b, 6)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_local_get(b, 5)
  emit_local_get(b, 6)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_i64_const(b, 0)
  // false
  emit_br(b, 3)
  // break to block_i64 with false
  emit_end(b)
  emit_local_get(b, 6)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 6)
  emit_br(b, 0)
  // continue loop
  emit_end(b)
  emit_end(b)
  emit_i64_const(b, 1)
  emit_end(b)
  emit_end(b)
  b
}

export let gen_arr_get_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // 0x74 i32.shl
  emit_i32_add(b)
  emit_i64_load(b, 3, 0)
  b
}

export let gen_arr_len_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  // header[4] = length
  emit_i64_extend_i32_u(b)
  b
}

export let gen_arr_new_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_global_get(b, 0)
  emit_local_tee(b, 0)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 0)
  emit_i64_extend_i32_u(b)
  b
}

export let gen_arr_set_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 2)
  emit_i64_store(b, 3, 0)
  b
}

export let gen_str_len_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  // 0xFFFFFFFF
  emit_i64_and(b)
  b
}

export let gen_arr_push_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 5)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_if_void(b)
  emit_local_get(b, 3)
  emit_i32_const(b, 2)
  emit_i32_mul(b)
  emit_local_set(b, 7)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_const(b, 8)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_local_get(b, 6)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_const(b, 8)
  emit_i32_mul(b)
  emit_memory_copy(b)
  emit_local_get(b, 2)
  emit_local_get(b, 7)
  emit_i32_store(b, 2, 0)
  // cap = new_cap
  emit_local_get(b, 2)
  emit_local_get(b, 6)
  emit_i32_store(b, 2, 8)
  // data_ptr = new_data
  emit_local_get(b, 6)
  emit_local_set(b, 5)
  emit_end(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 1)
  emit_i64_store(b, 3, 0)
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 4)
  b
}

export let gen_identity_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  b
}

export let gen_arr_slice_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 4)
  emit_local_get(b, 2)
  emit_i32_wrap_i64(b)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_sub(b)
  emit_local_set(b, 5)
  emit_local_get(b, 5)
  emit_i32_const(b, 8)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_i32_const(b, 12)
  emit_local_get(b, 8)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl (cap * 8)
  emit_i32_add(b)
  // 12 + cap * 8
  emit_i32_add(b)
  // heap_ptr + alloc_size
  emit_global_set(b, 0)
  emit_local_get(b, 6)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 6)
  emit_local_get(b, 5)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 6)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_local_get(b, 6)
  emit_local_get(b, 7)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 7)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 5)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  // i32.shl
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  b
}

export let gen_print_i64_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_local_get(b, 0)
  emit_i64_sub(b)
  emit_else(b)
  emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 48)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_rem_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_const(b, 48)
  emit_i32_add(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_div_s(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 45)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

export let gen_print_str_body = () -> Array[Int] {
  let b = bytebuf_new()
