export let gen_string_last_index_of_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, 9)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, 9)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  // i32.gt_u
  emit_if_i64(b)
  emit_i64_const(b, -1)
  emit_else(b)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_local_set(b, 4)
  emit_block_i64(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 0)
  bytebuf_push(b, 72)
  // i32.lt_s
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_call(b, 21)
  emit_local_set(b, 5)
  emit_local_get(b, 5)
  emit_local_get(b, 1)
  emit_call(b, 10)
  emit_i32_wrap_i64(b)
  emit_if_void(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_br(b, 3)
  // br $found (past block $notfound + loop + if)
  emit_end(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  // end loop
  emit_end(b)
  // end block $notfound
  emit_i64_const(b, -1)
  emit_end(b)
  // end block $found
  emit_end(b)
  // end if
  b
}

export let gen_selfhost_sources_stub_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_call(b, 12)
  b
}

export let gen_selfhost_sources_proper_body = (num_sources: Int, str_offsets: Array[Int], str_lengths: Array[Int], src_str_base: Int) -> Array[Int] {
  let b = bytebuf_new()
  emit_call(b, 12)
  // arr_new -> i64
  emit_local_set(b, 1)
  // local 1 (i64) = array
  let mut si = 0
  while si < num_sources {
    let path_idx = src_str_base + si * 2
    let content_idx = src_str_base + si * 2 + 1
    let path_off = Array::get(str_offsets, path_idx)
    let path_len = Array::get(str_lengths, path_idx)
    let content_off = Array::get(str_offsets, content_idx)
    let content_len = Array::get(str_lengths, content_idx)
    emit_global_get(b, 0)
    // heap_ptr (i32)
    emit_local_tee(b, 0)
    // local 0 (i32) = tuple_ptr
    emit_i32_const(b, 16)
    emit_i32_add(b)
    emit_global_set(b, 0)
    // heap_ptr += 16
    emit_local_get(b, 0)
    let path_ref = (path_off<<32)|path_len
    emit_i64_const(b, path_ref)
    emit_i64_store(b, 3, 0)
    emit_local_get(b, 0)
    let content_ref = (content_off<<32)|content_len
    emit_i64_const(b, content_ref)
    emit_i64_store(b, 3, 8)
    emit_local_get(b, 1)
    // array ref (i64)
    emit_local_get(b, 0)
    // tuple_ptr (i32)
    emit_i64_extend_i32_u(b)
    // extend to i64
    emit_call(b, 15)
    // arr_push(i64, i64)
    si = si + 1
  }
  emit_local_get(b, 1)
  b
}
