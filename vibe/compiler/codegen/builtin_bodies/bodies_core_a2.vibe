export let gen_bytes_blit_body = (bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 2)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_call(b, bytes_get_idx)
  emit_call(b, bytes_push_idx)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  b
}

