// Full selfhost compiler self-compilation.
// This file is in the selfhost_sources_manifest.tsv so it gets included
// in the selfhost bundle for bootstrap compilation.

//# Imports

import ./selfhost_sources_bundle.vibe {
  selfhost_sources
}

import ./module_loader.vibe {
  collect_merged_stmts
}

import ./codegen.vibe {
  compile_wasi_module_with_sources
}

import ./core/ast.vibe {
  Stmt
}

//# Functions

// Essential exports for the self-compiled compiler.
let essential_export_names = () -> Array[String] {
  [
    "selfbuild_compile_stage2",
    "selfbuild_compile_full",
    "selfbuild_entry",
    "version"
  ]
}

// Strip non-essential exports: demote exported let-bindings to internal,
// and remove SExport blocks. Only keep functions in the essential list.
let strip_non_essential_exports = (stmts: Array[Stmt], keep: Array[String]) -> Array[Stmt] {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(true, is_rec, name, ann, expr) => {
        let mut found = false
        let mut ki = 0
        while ki < Array::length(keep) {
          if Array::get(keep, ki) == name {
            found = true
            ki = Array::length(keep)
          } else {
            ki = ki + 1
          }
        }
        if !found {
          Array::set(stmts, i, SLet(false, is_rec, name, ann, expr))
        }
      },
      SExport(_) => Array::set(stmts, i, SExport(Array::slice([""], 0, 0))),
      _ => ()
    }
    i = i + 1
  }
  stmts
}

// Filter out heavy non-essential modules to reduce compilation size.
let filter_sources = (sources: Array[(String, String)]) -> Array[(String, String)] {
  let out = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    let skip = String::contains(path, "cli_adapter_bundle")
      || String::contains(path, "cli_adapter.vibe")
      || String::contains(path, "entry/")
      || String::contains(path, "cli_cache")
      || String::contains(path, "coverage")
      || String::contains(path, "selfbuild_probe")
      || String::contains(path, "selfhost_slim")
      || String::ends_with(path, "compiler/index.vibe")
      || String::ends_with(path, "compiler.vibe")
      || String::contains(path, "cache_probe")
    if !skip {
      Array::push(out, Array::get(sources, i))
    }
    i = i + 1
  }
  out
}

// Compile the selfhost compiler from embedded sources.
// Uses source filtering and export stripping to reduce compilation
// memory usage. The output WASM embeds ALL source strings (including
// filtered-out files) so it can produce a full compiler in stage 2.
//
// NOTE: Currently blocked by MoonBit RC runtime signed i32 heap limit
// (>2GB needed for ~1200 functions). Use VIBE_EXTRA_MEM_PAGES env var
// to provide headroom for the MoonBit unchecked allocation boundary bug.
export let selfbuild_compile_full = () -> Bytes with { Error } {
  let sources = selfhost_sources()
  // Filter out heavy non-essential modules (cli_adapter_bundle, entry/,
  // etc.) to reduce compilation memory.  The FULL source list is still
  // passed as the third argument so the output WASM embeds all strings
  // and a stage-2 compiler can self-compile without filesystem access.
  let filtered = filter_sources(sources)
  let merged = collect_merged_stmts(filtered)
  let keep = essential_export_names()
  strip_non_essential_exports(merged, keep)
  compile_wasi_module_with_sources(merged, "selfbuild_compile_full", sources)
}
