// Full selfhost compiler self-compilation.
// This file is NOT in the selfhost_sources_manifest.tsv — it is only
// compiled by the host compiler (stage0). Stage1.wasm therefore
// exports selfbuild_compile_full, but stage2 (produced by selfhost)
// does not.

//# Imports

import ./selfhost_sources_bundle.vibe {
  selfhost_sources
}

import ./module_loader.vibe {
  collect_merged_stmts
}

import ./codegen.vibe {
  compile_wasi_module_with_sources
}

//# Functions

// Compile the entire selfhost compiler from embedded sources.
// The resulting WASM embeds the selfhost source strings so that
// its selfhost_sources() function returns the same source set.
export let selfbuild_compile_full = () -> Bytes with { Error } {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  compile_wasi_module_with_sources(merged, "selfbuild_compile_full", sources)
}
