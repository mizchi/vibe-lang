//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_ok
}

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse complex" {
  let ok = parse_ok(lex("if x > 0 { f(x - 1) } else { 0 }"))
  assert(ok)
}

test "parse throw" {
  let result = handle {
    parse_print("throw(\"error\")")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "throw(\"error\")"))
}

test "parse break" {
  let result = handle {
    parse_print("{ while true { break } }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "while true { break }"))
}

test "parse break with value" {
  let result = handle {
    parse_print("{ while true { break 42 } }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "while true { break 42 }"))
}

test "parse continue" {
  let result = handle {
    parse_print("{ while true { continue } }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "while true { continue }"))
}

test "parse continue with args" {
  let result = handle {
    parse_print("{ while true { continue(1, 2) } }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "while true { continue(1, 2) }"))
}

test "parse else expr without braces" {
  let result = handle {
    parse_print("if true { 1 } else 2")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "if true { 1 } else { 2 }"))
}

test "parse else if else expr without braces" {
  let result = handle {
    parse_print("if x { 1 } else if y { 2 } else 3")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "if x { 1 } else { if y { 2 } else { 3 } }"))
}

test "parse else call expr without braces" {
  let result = handle {
    parse_print("if cond { x } else f(y)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "if cond { x } else { f(y) }"))
}

test "parse let destructure tuple" {
  let result = handle {
    parse_print("{ let (a, b) = pair; a }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "match pair { (a, b) => a }"))
}

test "parse nested tuple destructure keeps final body in last arm" {
  let result = handle {
    parse_print("{ let cond = expr; let then_e = env; let else_e = defs; let (_, s1, c1) = f(cond, env, defs, s, c - 1); let (tt, s2, c2) = f(then_e, env, defs, s1, c1); let (_, s3, c3) = f(else_e, env, defs, s2, c2); (tt, s3, c3) }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(result, "match f(else_e, env, defs, s2, c2) { (_, s3, c3) => (tt, s3, c3) }"))
}

test "parse nested tuple destructure with newlines keeps final body in last arm" {
  let src = "{\n  let cond = expr\n  let then_e = env\n  let else_e = defs\n  let (_, s1, c1) = f(cond, env, defs, s, c - 1)\n  let (tt, s2, c2) = f(then_e, env, defs, s1, c1)\n  let (_, s3, c3) = f(else_e, env, defs, s2, c2)\n  (tt, s3, c3)\n}"
  let result = handle {
    parse_print(src)
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::contains(result, "match f(else_e, env, defs, s2, c2) { (_, s3, c3) => (tt, s3, c3) }"))
}

test "parse raise error" {
  let ok = parse_ok(lex("raise \"error\""))
  assert(ok == false)
}

test "parse return error" {
  let ok = parse_ok(lex("return 1"))
  assert(ok == false)
}

test "parse do error" {
  let ok = parse_ok(lex("do { 1 }"))
  assert(ok == false)
}

test "parse loop error" {
  let ok = parse_ok(lex("loop { 1 }"))
  assert(ok == false)
}

test "parse yield error" {
  let ok = parse_ok(lex("yield 1"))
  assert(ok == false)
}

test "parse declare error" {
  let ok = parse_ok(lex("declare let x: Int"))
  assert(ok == false)
}
