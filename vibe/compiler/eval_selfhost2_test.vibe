//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup, run_with_imports
}

//# Misc

test "selfhost: 3-file mini eval" {
  let sources = [
    ("main.vibe", "import ./i.vibe { ev }\nimport ./a.vibe { E, N, A }\nlet result = ev(A(N(3), N(4)))"),
    ("a.vibe", "export enum E { N(Int); A(E, E) }"),
    ("i.vibe", "import ./a.vibe { E, N, A }\nexport let rec ev = (e: E) -> Int {\n  match e { N(n) => n, A(l, r) => ev(l) + ev(r) }\n}")
  ]
  assert(string_equals(run_with_imports(sources, "main.vibe", "result"), "7"))
}

test "selfhost: for-in map" {
  let src = "let doubled = for x in [1, 2, 3] { x * 2 }\nlet result = array_get(doubled, 1)"
  assert(string_equals(run_and_lookup(src, "result"), "4"))
}

test "selfhost: throw/handle basic" {
  let src = "let result = handle { throw(\"oops\") } { Error(msg) => msg }"
  assert(string_equals(run_and_lookup(src, "result"), "oops"))
}

test "selfhost: handle no-throw passthrough" {
  let src = "let result = handle { 42 } { Error(_) => 0 }"
  assert(string_equals(run_and_lookup(src, "result"), "42"))
}

test "selfhost: throw in function" {
  let src = "let fail = (msg: String) -> Int with {Error} { throw(msg) }\nlet result = handle { fail(\"bad\") } { Error(msg) => msg }"
  assert(string_equals(run_and_lookup(src, "result"), "bad"))
}

test "selfhost: array_builder eval" {
  let src = "let b = array_builder()\narray_builder_push(b, 10)\narray_builder_push(b, 20)\nlet result = array_builder_freeze(b)"
  assert(string_equals(run_and_lookup(src, "result"), "[10, 20]"))
}

test "selfhost: array_builder in loop" {
  let src = "let b = array_builder()\nlet mut i = 0\nwhile i < 3 { array_builder_push(b, i); i = i + 1 }\nlet result = array_builder_freeze(b)"
  assert(string_equals(run_and_lookup(src, "result"), "[0, 1, 2]"))
}

test "selfhost: throw + array_builder combined" {
  let src = "let result = handle { let b = array_builder(); array_builder_push(b, 1); array_builder_push(b, 2); array_builder_freeze(b) } { Error(_) => [99] }"
  assert(string_equals(run_and_lookup(src, "result"), "[1, 2]"))
}
