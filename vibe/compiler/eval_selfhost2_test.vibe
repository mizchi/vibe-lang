//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup, run_with_imports
}

//# Misc

test "selfhost: 3-file mini eval" {
  let sources = [
    ("main.vibe", "import ./i.vibe { ev }\nimport ./a.vibe { E, N, A }\nlet result = ev(A(N(3), N(4)))"),
    ("a.vibe", "export enum E { N(Int); A(E, E) }"),
    ("i.vibe", "import ./a.vibe { E, N, A }\nexport let rec ev = (e: E) -> Int {\n  match e { N(n) => n, A(l, r) => ev(l) + ev(r) }\n}")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "7"))
}

test "selfhost: for-in map" {
  let src = "let doubled = for x in [1, 2, 3] { x * 2 }\nlet result = Array::get(doubled, 1)"
  assert(String::equals(run_and_lookup(src, "result"), "4"))
}

test "selfhost: throw/handle basic" {
  let src = "let result = handle { throw(\"oops\") } { Error(msg) => msg }"
  assert(String::equals(run_and_lookup(src, "result"), "oops"))
}

test "selfhost: handle no-throw passthrough" {
  let src = "let result = handle { 42 } { Error(_) => 0 }"
  assert(String::equals(run_and_lookup(src, "result"), "42"))
}

test "selfhost: throw in function" {
  let src = "let fail = (msg: String) -> Int with {Error} { throw(msg) }\nlet result = handle { fail(\"bad\") } { Error(msg) => msg }"
  assert(String::equals(run_and_lookup(src, "result"), "bad"))
}
