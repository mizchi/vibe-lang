//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup, run_with_imports
}

//# Misc

test "selfhost: 3-file mini eval" {
  let sources = [
    ("main.vibe", "import ./i.vibe { ev }\nimport ./a.vibe { E, N, A }\nlet result = ev(A(N(3), N(4)))"),
    ("a.vibe", "export enum E { N(Int); A(E, E) }"),
    ("i.vibe", "import ./a.vibe { E, N, A }\nexport let rec ev = (e: E) -> Int {\n  match e { N(n) => n, A(l, r) => ev(l) + ev(r) }\n}")
  ]
  assert(run_with_imports(sources, "main.vibe", "result") == "7")
}

test "selfhost: for-in map" {
  let src = "let doubled = for x in [1, 2, 3] { x * 2 }\nlet result = Array::get(doubled, 1)"
  assert(run_and_lookup(src, "result") == "4")
}

test "selfhost: for-in accumulate with mutation" {
  let src = "let doubled = for x in [1, 2, 3] { x * 2 }\nlet sum = { let mut s = 0; for x in doubled { s = s + x }; s }"
  assert(run_and_lookup(src, "sum") == "12")
}

test "selfhost: for-in break keeps partial array" {
  let src = "let result = for x in [1, 2, 3, 4, 5] {\n  if x == 4 { break } else { }\n  x * 10\n}"
  assert(run_and_lookup(src, "result") == "[10, 20, 30]")
}

test "selfhost: for-in loop variable does not leak" {
  let src = "let x = 99\nlet result = for x in [1, 2, 3] { x * 2 }\nx"
  assert(run_and_lookup(src, "x") == "99")
}

test "selfhost: for-in index" {
  let src = "let result = for i, x in [10, 20, 30] { i + x }"
  assert(run_and_lookup(src, "result") == "[10, 21, 32]")
}

test "selfhost: throw/handle basic" {
  let src = "let result = handle { throw(\"oops\") } { Error(msg) => msg }"
  assert(run_and_lookup(src, "result") == "oops")
}

test "selfhost: handle no-throw passthrough" {
  let src = "let result = handle { 42 } { Error(_) => 0 }"
  assert(run_and_lookup(src, "result") == "42")
}

test "selfhost: throw in function" {
  let src = "let fail = (msg: String) -> Int with {Error} { throw(msg) }\nlet result = handle { fail(\"bad\") } { Error(msg) => msg }"
  assert(run_and_lookup(src, "result") == "bad")
}

test "selfhost: import transitive" {
  let sources = [
    ("main.vibe", "import ./b.vibe { val_from_c }\nlet result = val_from_c"),
    ("b.vibe", "import ./c.vibe { base }\nexport let val_from_c = base + 10"),
    ("c.vibe", "export let base = 5")
  ]
  assert(run_with_imports(sources, "main.vibe", "result") == "15")
}

test "selfhost: import enum export" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { Some, None }\nlet result = Some(42)"),
    ("lib.vibe", "export enum MyOpt { Some(Int); None }")
  ]
  assert(run_with_imports(sources, "main.vibe", "result") == "Some(42)")
}

test "selfhost: import non-exported not visible" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { secret }\nlet result = secret"),
    ("lib.vibe", "let secret = 123\nexport let public_val = 1")
  ]
  assert(run_with_imports(sources, "main.vibe", "result") == "()")
}

test "selfhost: ArrayBuilder::new eval" {
  let src = "let b = ArrayBuilder::new()\nArrayBuilder::push(b, 10)\nArrayBuilder::push(b, 20)\nlet result = ArrayBuilder::freeze(b)"
  assert(run_and_lookup(src, "result") == "[10, 20]")
}

test "selfhost: throw + ArrayBuilder::new combined" {
  let src = "let result = handle { let b = ArrayBuilder::new(); ArrayBuilder::push(b, 1); ArrayBuilder::push(b, 2); ArrayBuilder::freeze(b) } { Error(_) => [99] }"
  assert(run_and_lookup(src, "result") == "[1, 2]")
}
