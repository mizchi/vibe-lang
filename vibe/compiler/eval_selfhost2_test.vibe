import ./eval_e2e_helpers.vibe { run_and_lookup, run_with_imports }

test "selfhost: 3-file mini eval" {
  let sources = [
    ("main.vibe", "import ./i.vibe { ev }\nimport ./a.vibe { E, N, A }\nlet result = ev(A(N(3), N(4)))"),
    ("a.vibe", "export enum E { N(Int); A(E, E) }"),
    ("i.vibe", "import ./a.vibe { E, N, A }\nexport let rec ev = (e: E) -> Int {\n  match e { N(n) => n, A(l, r) => ev(l) + ev(r) }\n}")
  ]
  assert(string_equals(run_with_imports(sources, "main.vibe", "result"), "7"))
}

test "selfhost: for-in map" {
  let src = "let doubled = for x in [1, 2, 3] { x * 2 }\nlet result = array_get(doubled, 1)"
  assert(string_equals(run_and_lookup(src, "result"), "4"))
}
