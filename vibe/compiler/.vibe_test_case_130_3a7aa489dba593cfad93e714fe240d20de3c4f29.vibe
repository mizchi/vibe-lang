//# Imports

import ./checker_stmt.vibe {
  check_program
}

import ./syntax / lexer.vibe {
  lex
}

import ./syntax / parser.vibe {
  parse_program
}

//# Functions

let __vibe_compiled_test_case = () -> Int with { Error, Fs, Process, Env, Stdout, Stdin, Net, Async, Threads, Llm } {
  let check_source_ok = (source: String) -> Bool {
    handle {
      let tokens = lex(source)
      let stmts = parse_program(tokens)
      let _env = check_program(stmts)
      true
    } {
      Error(_) => false
    }
  }
  let check_source_err = (source: String) -> Bool {
    handle {
      let tokens = lex(source)
      let stmts = parse_program(tokens)
      let _env = check_program(stmts)
      false
    } {
      Error(_) => true
    }
  }
  assert(check_source_ok("match true { true => 1, false => 0 }"))
  0
}

__vibe_compiled_test_case()
