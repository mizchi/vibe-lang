//# Imports

import ./coverage_selfhost_suite_lib.vibe {
  CoverageCaseInput, SuiteReport, build_suite_report_from_json_texts, evaluate_kpi
}

//# Functions

let sample_report_union = () -> SuiteReport with { Error } {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "a.report.json", report_json: "{\"entry_path\":\"vibe/compiler/lexer_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":99,\"point_hit\":1,\"line_total\":1,\"line_hit\":1,\"branch_total\":99,\"branch_hit\":1},\"points\":[{\"kind\":\"branch_if_then\",\"line\":10,\"span\":{\"start\":100,\"end\":120},\"range\":{\"start\":{\"line\":9,\"character\":0},\"end\":{\"line\":9,\"character\":20}},\"hit\":false},{\"kind\":\"branch_if_then\",\"line\":10,\"span\":{\"start\":100,\"end\":120},\"range\":{\"start\":{\"line\":9,\"character\":0},\"end\":{\"line\":9,\"character\":20}},\"hit\":true},{\"kind\":\"line\",\"line\":11,\"span\":{\"start\":121,\"end\":140},\"range\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":19}},\"hit\":true}],\"lines\":[{\"line\":1,\"hit\":true,\"excluded\":false}]}"
    },
    CoverageCaseInput::{
      report_path: "b.report.json", report_json: "{\"entry_path\":\"vibe/compiler/lexer_test.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":77,\"point_hit\":0,\"line_total\":1,\"line_hit\":1,\"branch_total\":77,\"branch_hit\":0},\"points\":[{\"kind\":\"branch_if_then\",\"line\":10,\"span\":{\"start\":100,\"end\":120},\"range\":{\"start\":{\"line\":9,\"character\":0},\"end\":{\"line\":9,\"character\":20}},\"hit\":false},{\"kind\":\"line\",\"line\":11,\"span\":{\"start\":121,\"end\":140},\"range\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":19}},\"hit\":false},{\"kind\":\"branch_if_else\",\"line\":12,\"span\":{\"start\":141,\"end\":160},\"range\":{\"start\":{\"line\":11,\"character\":0},\"end\":{\"line\":11,\"character\":19}},\"hit\":true}],\"lines\":[{\"line\":2,\"hit\":true,\"excluded\":false}]}"
    }
  ])
}

let sample_report_aggregate = () -> SuiteReport with { Error } {
  build_suite_report_from_json_texts([
    CoverageCaseInput::{
      report_path: "a.report.json", report_json: "{\"entry_path\":\"vibe/compiler/selfhost_coverage_run.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":200,\"point_hit\":60,\"line_total\":30,\"line_hit\":30,\"branch_total\":120,\"branch_hit\":40},\"lines\":[{\"line\":1,\"hit\":true,\"excluded\":false},{\"line\":2,\"hit\":true,\"excluded\":false}]}"
    },
    CoverageCaseInput::{
      report_path: "b.report.json", report_json: "{\"entry_path\":\"vibe/compiler/index.vibe\",\"execution\":{\"ok\":true,\"error\":\"\"},\"stats\":{\"point_total\":100,\"point_hit\":10,\"line_total\":20,\"line_hit\":10,\"branch_total\":80,\"branch_hit\":8},\"lines\":[{\"line\":1,\"hit\":false,\"excluded\":false},{\"line\":2,\"hit\":false,\"excluded\":true}]}"
    }
  ])
}

//# Misc

test "aggregate case_count" {
  let report = sample_report_aggregate()
  assert(eq(report.case_count, 2))
}

test "aggregate trap_case_count" {
  let report = sample_report_aggregate()
  assert(eq(report.trap_case_count, 0))
}

test "aggregate point_total" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.point_total, 300))
}

test "aggregate point_hit" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.point_hit, 70))
}

test "aggregate line_total" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.line_total, 3))
}

test "aggregate line_hit" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.line_hit, 2))
}

test "aggregate branch_total" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.branch_total, 200))
}

test "aggregate branch_hit" {
  let report = sample_report_aggregate()
  assert(eq(report.stats.branch_hit, 48))
}

test "aggregate kpi pass" {
  let report = sample_report_aggregate()
  let pass_kpi = evaluate_kpi(report, Some(20.0), Some(60.0), Some(20.0))
  assert(pass_kpi.ok)
}

test "aggregate kpi fail" {
  let report = sample_report_aggregate()
  let fail_kpi = evaluate_kpi(report, Some(30.0), Some(70.0), Some(30.0))
  assert(not(fail_kpi.ok))
  assert(eq(Array::length(fail_kpi.failures), 3))
}

test "union point_total" {
  let report = sample_report_union()
  assert(eq(report.stats.point_total, 3))
}

test "union point_hit" {
  let report = sample_report_union()
  assert(eq(report.stats.point_hit, 3))
}

test "union branch_total" {
  let report = sample_report_union()
  assert(eq(report.stats.branch_total, 2))
}

test "union branch_hit" {
  let report = sample_report_union()
  assert(eq(report.stats.branch_hit, 2))
}

test "union line_total" {
  let report = sample_report_union()
  assert(eq(report.stats.line_total, 2))
}

test "union line_hit" {
  let report = sample_report_union()
  assert(eq(report.stats.line_hit, 2))
}
