//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

let join = (arr: Array[String], sep: String) -> String {
  let len = Array::length(arr)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    } else {
      let s = if i > 0 {
        "\{acc}\{sep}\{Array::get(arr, i)}"
      } else Array::get(arr, i)
      go(i + 1, s)
    }
  }
  go(0, "")
}

export let rec print_pat = (p: Pat) -> String {
  match p {
    PWild => "_",
    PBind(name) => name,
    PInt(n) => __to_string(n),
    PString(s) => "\"\{s}\"",
    PBool(b) => if b {
      "true"
    } else "false",
    PCtor(name, args) => if Array::length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        print_pat(arg)
      }
      "\{name}(\{join(parts, ", ")})"
    },
    PTuple(elems) => {
      let parts = for elem in elems {
        print_pat(elem)
      }
      "(\{join(parts, ", ")})"
    },
    POr(left, right) => "\{print_pat(left)} | \{print_pat(right)}"
  }
}

let map_to_strings = (exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {
  for expr in exprs {
    f(expr)
  }
}

export let rec print_type_expr = (ty: TypeExpr) -> String {
  match ty {
    TyName(name) => name,
    TyUnit => "()",
    TyApp(name, args) => {
      let parts = for arg in args {
        print_type_expr(arg)
      }
      "\{name}[\{join(parts, ", ")}]"
    },
    TyFn(params, ret) => {
      let parts = for param in params {
        print_type_expr(param)
      }
      "(\{join(parts, ", ")}) -> \{print_type_expr(ret)}"
    },
    TyTuple(elems) => {
      let parts = for elem in elems {
        print_type_expr(elem)
      }
      "(\{join(parts, ", ")})"
    }
  }
}

export let rec print_expr = (e: Expr) -> String {
  match e {
    EInt(n) => __to_string(n),
    EFloat(n) => __to_string(n),
    EString(s) => "\"\{s}\"",
    EBool(b) => if b {
      "true"
    } else "false",
    EIdent(name) => name,
    EUnit => "()",
    ETuple(elems) => "(\{join(map_to_strings(elems, print_expr), ", ")})",
    EArray(elems) => "[\{join(map_to_strings(elems, print_expr), ", ")}]",
    ERecord(fields) => {
      let parts = for field in fields {
        let (name, val) = field
        "\{name}: \{print_expr(val)}"
      }
      "{ \{join(parts, ", ")} }"
    },
    EIf(cond, then_e, else_e) => "if \{print_expr(cond)} { \{print_expr(then_e)} } else { \{print_expr(else_e)} }",
    ELet(name, val, body) => "let \{name} = \{print_expr(val)}; \{print_expr(body)}",
    ELetRec(name, val, body) => "let rec \{name} = \{print_expr(val)}; \{print_expr(body)}",
    ELetMut(name, val, body) => "let mut \{name} = \{print_expr(val)}; \{print_expr(body)}",
    EAssign(name, val, body) => "\{name} = \{print_expr(val)}; \{print_expr(body)}",
    EAssignOp(name, op, val, body) => "\{name} \{op}= \{print_expr(val)}; \{print_expr(body)}",
    ESeq(a, b) => "\{print_expr(a)}; \{print_expr(b)}",
    EMatch(scrutinee, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        "\{print_pat(pat)} => \{print_expr(expr)}"
      }
      "match \{print_expr(scrutinee)} { \{join(parts, ", ")} }"
    },
    EHandle(body, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        "\{print_pat(pat)} => \{print_expr(expr)}"
      }
      "handle { \{print_expr(body)} } { \{join(parts, ", ")} }"
    },
    EWhile(cond, body) => "while \{print_expr(cond)} { \{print_expr(body)} }",
    EForIn(name, index_name, iterable, body) => "for \{match index_name {
      Some(index_name) => String::concat(index_name, String::concat(", ", name))}\{None => name
    }, String::concat(" in ", String::concat(print_expr(iterable), String::concat(" { ", String::concat(print_expr(body), " }"))))}",
    ECall(callee, args) => "\{print_expr(callee)}(\{join(map_to_strings(args, print_expr), ", ")})",
    EBinOp(op, left, right) => "(\{print_expr(left)} \{op} \{print_expr(right)})",
    EUnaryOp(op, expr) => "(\{op}\{print_expr(expr)})",
    EFn(_, _, params, ret_ty, effect, body) => {
      let parts = for param in params {
        let (name, ty_opt) = param
        match ty_opt {
          Some(ty) => "\{name}: \{print_type_expr(ty)}",
          None => name
        }
      }
      let ret_str = match ret_ty {
        Some(rt) => {
          let eff_str = match effect {
            Some(e) => " with {\{e}}",
            None => ""
          }
          ") -> \{print_type_expr(rt)}\{eff_str} { \{print_expr(body)} }"
        },
        None => ") -> \{print_expr(body)}"
      }
      "(\{join(parts, ", ")}\{ret_str}"
    },
    EDot(expr, field) => "\{print_expr(expr)}.\{field}",
    ELabeledArg(name, modifier, val) => "\{name}=\{print_expr(val)}",
    EMap(fields) => {
      let parts = for field in fields {
        let (name, val) = field
        "\{name}: \{print_expr(val)}"
      }
      "Map { \{join(parts, ", ")} }"
    },
    ESpread(e) => "...\{print_expr(e)}",
    EStringInterp(parts) => "\"\{join(parts, "")}\""
  }
}

export let rec print_stmt = (s: Stmt) -> String {
  let prefix = (exported: Bool) -> String {
    if exported {
      "export "
    } else ""
  }
  match s {
    SLet(exported, is_rec, name, ty_opt, val) => {
      let p = prefix(exported)
      let r = if is_rec {
        "let rec "
      } else "let "
      let t = match ty_opt {
        Some(ty) => ": \{print_type_expr(ty)}",
        None => ""
      }
      "\{p}\{r}\{name}\{t} = \{print_expr(val)}"
    },
    SLetMut(name, ty_opt, val) => {
      let t = match ty_opt {
        Some(ty) => ": \{print_type_expr(ty)}",
        None => ""
      }
      "let mut \{name}\{t} = \{print_expr(val)}"
    },
    SEnum(exported, name, ctors) => "enum",
    SSuberror(exported, name, ctors) => "suberror",
    SStruct(exported, name, fields) => "struct",
    STypeAlias(exported, name, ty) => "type",
    STrait(exported, name, _) => "\{prefix(exported)}trait \{name}",
    SImpl(_, _, trait_name, type_name) => "impl \{trait_name} for \{type_name}",
    SExternLet(name, ty) => "extern let \{name}: \{print_type_expr(ty)}",
    SImport(path, items) => "import",
    STest(name, body) => "test \"\{name}\" { \{print_expr(body)} }",
    SBench(name, body) => "bench \"\{name}\" { \{print_expr(body)} }",
    SExpr(e) => print_expr(e),
    SExport(names) => "export",
    SReExport(path, items) => "re-export",
    SModule(exported, name, stmts) => {
      let parts = for s in stmts {
        print_stmt(s)
      }
      let p = if exported {
        "export "
      } else ""
      "\{p}module \{name} { \{join(parts, "\n")} }"
    }
  }
}
