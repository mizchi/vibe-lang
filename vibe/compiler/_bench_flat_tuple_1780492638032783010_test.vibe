import ./codegen_test_support.vibe { compile_wasi, compile_wasi_rc }
import ./core/polyfill.vibe { __to_string }
let emit: () -> Int with { Error, Fs } = () -> {
  let n = 1000000
  let src = "let main: () -> Int = () -> {\n  let mut s = 0\n  let mut i = 0\n  while i < " + __to_string(n) + " {\n    let t = (i, i + 1)\n    s = s + t.0\n    i = i + 1\n  }\n  s\n}"
  Fs::write_bytes("/tmp/_bench_flat_tuple_1780492638032783010_d.wasm", compile_wasi(src, "main"))
  Fs::write_bytes("/tmp/_bench_flat_tuple_1780492638032783010_r.wasm", compile_wasi_rc(src, "main"))
  0
}
test "emit" { emit(); assert(true) }
