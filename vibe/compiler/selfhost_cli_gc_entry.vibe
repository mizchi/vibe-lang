//# Imports

import ./entry / source_compile / gc_only {
  compile_source_gc_only
}

//# Functions

let read_arg = (index: Int) -> String with { Env } {
  if Env::args_len() > index {
    Env::args_get(index)
  } else {
    ""
  }
}

let cli_main = () -> Int with { Error, Fs, Env } {
  let input_path = read_arg(0)
  let output_path = read_arg(1)
  let entry_name = read_arg(2)
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else if entry_name == "" {
    1
  }
  else {
    let source = Fs::read_file(input_path)
    let bytes = compile_source_gc_only(source, entry_name)
    Fs::write_bytes(output_path, bytes)
    0
  }
}

cli_main()
