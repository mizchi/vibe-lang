//# Imports

import ../core/ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

let empty_aliases: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}

let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let empty_import_refs: () -> Array[(String, String, String)] = () -> {
  Array::slice([
    ("", "", "")
  ], 0, 0)
}

let string_array_contains: (Array[String], String) -> Bool = (items, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let import_ref_array_contains_local: (Array[(String, String, String)], String) -> Bool = (items, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let (_, _, local) = Array::get(items, i)
    if local == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let import_ref_has_other_path_for_original: (Array[(String, String, String)], String, String) -> Bool = (items, raw_path, original) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let (other_path, other_original, _) = Array::get(items, i)
    if other_original == original && other_path != raw_path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let lookup_alias: (Array[(String, String)], String) -> Option[String] = (aliases, name) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if alias == name {
      found = Some(original)
      i = Array::length(aliases)
    } else {
      i = i + 1
    }
  }
  found
}

let alias_map_without_name: (Array[(String, String)], String) -> Array[(String, String)] = (aliases, name) -> {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if alias != name {
      Array::push(out, (alias, original))
    }
    i = i + 1
  }
  out
}

let alias_map_without_names: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (aliases, names) -> {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if !string_array_contains(names, alias) {
      Array::push(out, (alias, original))
    }
    i = i + 1
  }
  out
}

let rec pat_binds_name: (Pat, String) -> Bool = (pat, name) -> {
  match pat {
    PBind(bound) => bound == name,
    PCtor(_, pats) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(pats) && !found {
        if pat_binds_name(Array::get(pats, i), name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    PTuple(pats) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(pats) && !found {
        if pat_binds_name(Array::get(pats, i), name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    POr(left, right) => pat_binds_name(left, name) || pat_binds_name(right, name),
    PStruct(_, fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) && !found {
        let (_, field_pat) = Array::get(fields, i)
        if pat_binds_name(field_pat, name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    _ => false
  }
}

let alias_map_without_pat: (Array[(String, String)], Pat) -> Array[(String, String)] = (aliases, pat) -> {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if !pat_binds_name(pat, alias) {
      Array::push(out, (alias, original))
    }
    i = i + 1
  }
  out
}

let param_binds_name: (Array[(String, Option[TypeExpr])], String) -> Bool = (params, name) -> {
  let mut found = false
  let mut i = 0
  while i < Array::length(params) && !found {
    let (param_name, _) = Array::get(params, i)
    if param_name == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let alias_map_without_params: (Array[(String, String)], Array[(String, Option[TypeExpr])]) -> Array[(String, String)] = (aliases, params) -> {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if !param_binds_name(params, alias) {
      Array::push(out, (alias, original))
    }
    i = i + 1
  }
  out
}

export let rec rewrite_import_alias_expr: (Expr, Array[(String, String)]) -> Expr = (expr, aliases) -> {
  match expr {
    EIdent(name) => match lookup_alias(aliases, name) {
      Some(original) => EIdent(original),
      None => expr
    },
    ETuple(items) => ETuple(for item in items {
      rewrite_import_alias_expr(item, aliases)
    }),
    EArray(items) => EArray(for item in items {
      rewrite_import_alias_expr(item, aliases)
    }),
    ERecord(fields) => ERecord(for field in fields {
      let (name, value) = field
      (name, rewrite_import_alias_expr(value, aliases))
    }),
    EIf(cond, then_expr, else_expr) => EIf(
      rewrite_import_alias_expr(cond, aliases),
      rewrite_import_alias_expr(then_expr, aliases),
      rewrite_import_alias_expr(else_expr, aliases)
    ),
    ELet(name, value, body) => ELet(
      name,
      rewrite_import_alias_expr(value, aliases),
      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))
    ),
    ELetRec(name, value, body) => {
      let body_aliases = alias_map_without_name(aliases, name)
      ELetRec(
        name,
        rewrite_import_alias_expr(value, body_aliases),
        rewrite_import_alias_expr(body, body_aliases)
      )
    },
    ELetMut(name, value, body) => ELetMut(
      name,
      rewrite_import_alias_expr(value, aliases),
      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))
    ),
    EAssign(name, value, body) => EAssign(
      name,
      rewrite_import_alias_expr(value, aliases),
      rewrite_import_alias_expr(body, aliases)
    ),
    EAssignOp(name, op, value, body) => EAssignOp(
      name,
      op,
      rewrite_import_alias_expr(value, aliases),
      rewrite_import_alias_expr(body, aliases)
    ),
    ESeq(left, right) => ESeq(
      rewrite_import_alias_expr(left, aliases),
      rewrite_import_alias_expr(right, aliases)
    ),
    EMatch(scrutinee, arms) => EMatch(rewrite_import_alias_expr(scrutinee, aliases), for arm in arms {
      let (pat, body) = arm
      (pat, rewrite_import_alias_expr(body, alias_map_without_pat(aliases, pat)))
    }),
    EHandle(body, arms) => EHandle(rewrite_import_alias_expr(body, aliases), for arm in arms {
      let (pat, arm_body) = arm
      (pat, rewrite_import_alias_expr(arm_body, alias_map_without_pat(aliases, pat)))
    }),
    EWhile(cond, body) => EWhile(
      rewrite_import_alias_expr(cond, aliases),
      rewrite_import_alias_expr(body, aliases)
    ),
    ELoop(params, body) => {
      let out_params = for param in params {
        let (name, init) = param
        (name, rewrite_import_alias_expr(init, aliases))
      }
      let mut body_aliases = aliases
      let mut i = 0
      while i < Array::length(params) {
        let (name, _) = Array::get(params, i)
        body_aliases = alias_map_without_name(body_aliases, name)
        i = i + 1
      }
      ELoop(out_params, rewrite_import_alias_expr(body, body_aliases))
    },
    EForIn(name, index_name, iter, body) => {
      let body_aliases = match index_name {
        Some(index_name) => alias_map_without_name(alias_map_without_name(aliases, name), index_name),
        None => alias_map_without_name(aliases, name)
      }
      EForIn(
        name,
        index_name,
        rewrite_import_alias_expr(iter, aliases),
        rewrite_import_alias_expr(body, body_aliases)
      )
    },
    ECall(callee, args) => ECall(rewrite_import_alias_expr(callee, aliases), for arg in args {
      rewrite_import_alias_expr(arg, aliases)
    }),
    EBinOp(op, left, right) => EBinOp(
      op,
      rewrite_import_alias_expr(left, aliases),
      rewrite_import_alias_expr(right, aliases)
    ),
    EUnaryOp(op, value) => EUnaryOp(op, rewrite_import_alias_expr(value, aliases)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(
      type_params,
      bounds,
      params,
      ret_ty,
      effect,
      rewrite_import_alias_expr(body, alias_map_without_params(aliases, params))
    ),
    EDot(obj, field) => EDot(rewrite_import_alias_expr(obj, aliases), field),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_import_alias_expr(body, aliases)),
    EThrow(value) => EThrow(rewrite_import_alias_expr(value, aliases)),
    EReturn(value) => EReturn(rewrite_import_alias_expr(value, aliases)),
    EBreak(value) => match value {
      Some(value) => EBreak(Some(rewrite_import_alias_expr(value, aliases))),
      None => expr
    },
    EContinue(values) => EContinue(for value in values {
      rewrite_import_alias_expr(value, aliases)
    }),
    EMap(fields) => EMap(for field in fields {
      let (name, value) = field
      (name, rewrite_import_alias_expr(value, aliases))
    }),
    ESpread(value) => ESpread(rewrite_import_alias_expr(value, aliases)),
    _ => expr
  }
}

export let collect_import_aliases: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {
  let aliases = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let (original, alias_opt) = Array::get(items, j)
          match alias_opt {
            Some(alias) => if alias != original {
              Array::push(aliases, (alias, original))
            },
            None => ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  aliases
}

let collect_import_refs: (Array[Stmt]) -> Array[(String, String, String)] = (stmts) -> {
  let refs = empty_import_refs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let (original, alias_opt) = Array::get(items, j)
          let local = match alias_opt {
            Some(alias) => alias,
            None => original
          }
          Array::push(refs, (raw_path, original, local))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  refs
}

export let collect_import_alias_collision_refs: (Array[Stmt]) -> Array[(String, String, String)] = (stmts) -> {
  let refs = collect_import_refs(stmts)
  let out = empty_import_refs()
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if import_ref_has_other_path_for_original(refs, raw_path, original) && !import_ref_array_contains_local(out, local) {
      Array::push(out, (raw_path, original, local))
    }
    i = i + 1
  }
  out
}

export let collect_import_alias_collision_locals: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let refs = collect_import_alias_collision_refs(stmts)
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(refs) {
    let (_, _, local) = Array::get(refs, i)
    if !string_array_contains(out, local) {
      Array::push(out, local)
    }
    i = i + 1
  }
  out
}

export let rec rewrite_import_alias_stmt: (Stmt, Array[(String, String)]) -> Stmt = (stmt, aliases) -> {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(
      exported,
      is_rec,
      name,
      ty,
      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))
    ),
    SLetMut(name, ty, body) => SLetMut(
      name,
      ty,
      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))
    ),
    STest(name, body) => STest(name, rewrite_import_alias_expr(body, aliases)),
    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, aliases)),
    SExpr(body) => SExpr(rewrite_import_alias_expr(body, aliases)),
    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, aliases)),
    SModule(exported, name, stmts) => {
      let module_aliases = collect_import_aliases(stmts)
      SModule(exported, name, for inner_stmt in stmts {
        rewrite_import_alias_stmt(inner_stmt, module_aliases)
      })
    },
    _ => stmt
  }
}

export let append_import_alias_rewritten_non_import_stmts: (Array[Stmt], Array[Stmt]) -> Unit = (merged, stmts) -> {
  append_import_alias_rewritten_non_import_stmts_skipping(merged, stmts, empty_strings())
}

export let append_import_alias_rewritten_non_import_stmts_skipping: (Array[Stmt], Array[Stmt], Array[String]) -> Unit = (merged, stmts, skipped_locals) -> {
  let aliases = alias_map_without_names(collect_import_aliases(stmts), skipped_locals)
  let should_rewrite = Array::length(aliases) > 0
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(_, _) => (),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, aliases)),
      _ => if should_rewrite {
        Array::push(merged, rewrite_import_alias_stmt(stmt, aliases))
      } else {
        Array::push(merged, stmt)
      }
    }
    i = i + 1
  }
}

export let rewrite_imported_value_stmt_to_local: (Stmt, String, String) -> Option[Stmt] = (stmt, original, local) -> {
  let aliases = Array::slice([
    (original, local)
  ], 0, 1)
  let rewrite_value: (Expr) -> Expr = (expr) -> {
    if original == local {
      expr
    } else {
      rewrite_import_alias_expr(expr, aliases)
    }
  }
  match stmt {
    SLet(_, is_rec, name, ty, body) => if name == original {
      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))
    } else {
      None
    },
    SLetMut(name, ty, body) => if name == original {
      Some(SLetMut(local, ty, rewrite_value(body)))
    } else {
      None
    },
    _ => None
  }
}

let sanitize_namespace_char: (Int) -> String = (code) -> {
  if (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_' {
    String::from_char_code(code)
  } else {
    "_"
  }
}

let sanitize_namespace_path: (String) -> String = (path) -> {
  let mut out = ""
  let mut i = 0
  while i < String::length(path) {
    out = String::concat(out, sanitize_namespace_char(String::char_code_at(path, i)))
    i = i + 1
  }
  out
}

let namespace_private_name: (String, String) -> String = (path, name) -> {
  String::concat(name, String::concat("_dep_", sanitize_namespace_path(path)))
}

let collect_exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(true, _, name, _, _) => if !string_array_contains(names, name) {
        Array::push(names, name)
      },
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, j)
          if !string_array_contains(names, name) {
            Array::push(names, name)
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  names
}

let collect_private_value_renames: (String, Array[Stmt]) -> Array[(String, String)] = (path, stmts) -> {
  let exported = collect_exported_value_names(stmts)
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(false, _, name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name(path, name)))
      },
      SLetMut(name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name(path, name)))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}

let rec rewrite_private_type_expr: (TypeExpr, Array[(String, String)]) -> TypeExpr = (ty, renames) -> {
  match ty {
    TyName(name) => match lookup_alias(renames, name) {
      Some(renamed) => TyName(renamed),
      None => ty
    },
    TyApp(name, args) => {
      let next_name = match lookup_alias(renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      TyApp(next_name, for arg in args {
        rewrite_private_type_expr(arg, renames)
      })
    },
    TyFn(params, ret, effect_name) => TyFn(
      for param in params {
        rewrite_private_type_expr(param, renames)
      },
      rewrite_private_type_expr(ret, renames),
      effect_name
    ),
    TyTuple(items) => TyTuple(for item in items {
      rewrite_private_type_expr(item, renames)
    }),
    TyUnit => ty
  }
}

let rewrite_private_type_opt: (Option[TypeExpr], Array[(String, String)]) -> Option[TypeExpr] = (ty, renames) -> {
  match ty {
    Some(inner) => Some(rewrite_private_type_expr(inner, renames)),
    None => None
  }
}

let rewrite_private_params: (Array[(String, Option[TypeExpr])], Array[(String, String)]) -> Array[(String, Option[TypeExpr])] = (params, type_renames) -> {
  for param in params {
    let (name, ty) = param
    (name, rewrite_private_type_opt(ty, type_renames))
  }
}

let rec rewrite_private_type_ctor_pat: (Pat, Array[(String, String)], Array[(String, String)]) -> Pat = (pat, type_renames, ctor_renames) -> {
  match pat {
    PCtor(name, pats) => {
      let next_name = match lookup_alias(ctor_renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      PCtor(next_name, for item in pats {
        rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)
      })
    },
    PTuple(pats) => PTuple(for item in pats {
      rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)
    }),
    POr(left, right) => POr(
      rewrite_private_type_ctor_pat(left, type_renames, ctor_renames),
      rewrite_private_type_ctor_pat(right, type_renames, ctor_renames)
    ),
    PStruct(name, fields) => {
      let next_name = match lookup_alias(type_renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      PStruct(next_name, for field in fields {
        let (field_name, field_pat) = field
        (field_name, rewrite_private_type_ctor_pat(field_pat, type_renames, ctor_renames))
      })
    },
    _ => pat
  }
}

let rec rewrite_private_type_ctor_expr: (Expr, Array[(String, String)], Array[(String, String)]) -> Expr = (expr, type_renames, ctor_renames) -> {
  match expr {
    EIdent(name) => match lookup_alias(ctor_renames, name) {
      Some(renamed) => EIdent(renamed),
      None => expr
    },
    ETuple(items) => ETuple(for item in items {
      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)
    }),
    EArray(items) => EArray(for item in items {
      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)
    }),
    ERecord(fields) => ERecord(for field in fields {
      let (name, value) = field
      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))
    }),
    EIf(cond, then_expr, else_expr) => EIf(
      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(then_expr, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(else_expr, type_renames, ctor_renames)
    ),
    ELet(name, value, body) => ELet(
      name,
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))
    ),
    ELetRec(name, value, body) => {
      let body_ctors = alias_map_without_name(ctor_renames, name)
      ELetRec(
        name,
        rewrite_private_type_ctor_expr(value, type_renames, body_ctors),
        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)
      )
    },
    ELetMut(name, value, body) => ELetMut(
      name,
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))
    ),
    EAssign(name, value, body) => EAssign(
      name,
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)
    ),
    EAssignOp(name, op, value, body) => EAssignOp(
      name,
      op,
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)
    ),
    ESeq(left, right) => ESeq(
      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)
    ),
    EMatch(scrutinee, arms) => EMatch(
      rewrite_private_type_ctor_expr(scrutinee, type_renames, ctor_renames),
      for arm in arms {
        let (pat, body) = arm
        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
        (next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
      }
    ),
    EHandle(body, arms) => EHandle(
      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames),
      for arm in arms {
        let (pat, arm_body) = arm
        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
        (next_pat, rewrite_private_type_ctor_expr(arm_body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
      }
    ),
    EWhile(cond, body) => EWhile(
      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)
    ),
    ELoop(params, body) => {
      let out_params = for param in params {
        let (name, init) = param
        (name, rewrite_private_type_ctor_expr(init, type_renames, ctor_renames))
      }
      let mut body_ctors = ctor_renames
      let mut i = 0
      while i < Array::length(params) {
        let (name, _) = Array::get(params, i)
        body_ctors = alias_map_without_name(body_ctors, name)
        i = i + 1
      }
      ELoop(out_params, rewrite_private_type_ctor_expr(body, type_renames, body_ctors))
    },
    EForIn(name, index_name, iter, body) => {
      let body_ctors = match index_name {
        Some(index_name) => alias_map_without_name(alias_map_without_name(ctor_renames, name), index_name),
        None => alias_map_without_name(ctor_renames, name)
      }
      EForIn(
        name,
        index_name,
        rewrite_private_type_ctor_expr(iter, type_renames, ctor_renames),
        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)
      )
    },
    ECall(callee, args) => ECall(
      rewrite_private_type_ctor_expr(callee, type_renames, ctor_renames),
      for arg in args {
        rewrite_private_type_ctor_expr(arg, type_renames, ctor_renames)
      }
    ),
    EBinOp(op, left, right) => EBinOp(
      op,
      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)
    ),
    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(
      type_params,
      bounds,
      rewrite_private_params(params, type_renames),
      rewrite_private_type_opt(ret_ty, type_renames),
      effect,
      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_params(ctor_renames, params))
    ),
    EDot(obj, field) => EDot(rewrite_private_type_ctor_expr(obj, type_renames, ctor_renames), field),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    EThrow(value) => EThrow(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EBreak(value) => match value {
      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))),
      None => expr
    },
    EContinue(values) => EContinue(for value in values {
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)
    }),
    EMap(fields) => EMap(for field in fields {
      let (name, value) = field
      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))
    }),
    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    _ => expr
  }
}

let collect_private_type_renames: (String, Array[Stmt]) -> Array[(String, String)] = (path, stmts) -> {
  let exported = collect_exported_value_names(stmts)
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name(path, name)))
      },
      SStruct(false, name, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name(path, name)))
      },
      STypeAlias(false, name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name(path, name)))
      },
      SSuberror(false, name, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name(path, name)))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}

let collect_private_ctor_renames: (String, Array[Stmt], Array[(String, String)]) -> Array[(String, String)] = (path, stmts, type_renames) -> {
  let exported = collect_exported_value_names(stmts)
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, type_name, _, ctors) => if !string_array_contains(exported, type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, j)
          Array::push(renames, (ctor_name, namespace_private_name(path, ctor_name)))
          j = j + 1
        }
      },
      SSuberror(false, type_name, ctors) => if !string_array_contains(exported, type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, j)
          Array::push(renames, (ctor_name, namespace_private_name(path, ctor_name)))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  type_renames
  renames
}

let namespace_private_type_ctor_stmt: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(
      exported,
      is_rec,
      name,
      rewrite_private_type_opt(ty, type_renames),
      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))
    ),
    SLetMut(name, ty, body) => SLetMut(
      name,
      rewrite_private_type_opt(ty, type_renames),
      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))
    ),
    SEnum(exported, name, params, ctors) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SEnum(exported, next_name, params, for ctor in ctors {
        let (ctor_name, args) = ctor
        let next_ctor = if exported {
          ctor_name
        } else {
          match lookup_alias(ctor_renames, ctor_name) {
            Some(renamed) => renamed,
            None => ctor_name
          }
        }
        (next_ctor, for arg in args {
          rewrite_private_type_expr(arg, type_renames)
        })
      })
    },
    SSuberror(exported, name, ctors) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SSuberror(exported, next_name, for ctor in ctors {
        let (ctor_name, args) = ctor
        let next_ctor = if exported {
          ctor_name
        } else {
          match lookup_alias(ctor_renames, ctor_name) {
            Some(renamed) => renamed,
            None => ctor_name
          }
        }
        (next_ctor, for arg in args {
          rewrite_private_type_expr(arg, type_renames)
        })
      })
    },
    SStruct(exported, name, fields) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      SStruct(exported, next_name, for field in fields {
        let (field_name, field_ty) = field
        (field_name, rewrite_private_type_expr(field_ty, type_renames))
      })
    },
    STypeAlias(exported, name, params, target) => {
      let next_name = if exported {
        name
      } else {
        match lookup_alias(type_renames, name) {
          Some(renamed) => renamed,
          None => name
        }
      }
      STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))
    },
    SImpl(tparams, bounds, trait_name, target_name) => {
      let next_target = match lookup_alias(type_renames, target_name) {
        Some(renamed) => renamed,
        None => target_name
      }
      SImpl(tparams, bounds, trait_name, next_target)
    },
    SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),
    STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    SLetPat(pat, body) => {
      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
      SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
    },
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),
    SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {
      let (op_name, op_params, ret_ty) = op
      (op_name, for param in op_params {
        rewrite_private_type_expr(param, type_renames)
      }, rewrite_private_type_expr(ret_ty, type_renames))
    }),
    _ => stmt
  }
}

let namespace_private_stmt: (Stmt, Array[(String, String)]) -> Stmt = (stmt, renames) -> {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => {
      let next_name = match lookup_alias(renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))
    },
    SLetMut(name, ty, body) => {
      let next_name = match lookup_alias(renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))
    },
    STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),
    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),
    SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),
    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),
    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),
    _ => stmt
  }
}

export let namespace_private_value_stmts: (String, Array[Stmt]) -> Array[Stmt] = (path, stmts) -> {
  let renames = collect_private_value_renames(path, stmts)
  let value_renamed = if Array::length(renames) == 0 {
    stmts
  } else {
    for stmt in stmts {
      namespace_private_stmt(stmt, renames)
    }
  }
  let type_renames = collect_private_type_renames(path, value_renamed)
  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames)
  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {
    value_renamed
  } else {
    for stmt in value_renamed {
      namespace_private_type_ctor_stmt(stmt, type_renames, ctor_renames)
    }
  }
}
