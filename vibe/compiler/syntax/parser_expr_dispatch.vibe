//# Imports

import .. / core {
  Expr, Pat
}

import ./parser_base.vibe {
  empty_arms, empty_exprs, expect_tk, parse_enum_stmt, parse_pattern, parse_struct_stmt, parse_type_impl, peek, skip_semi, tk_name
}

import ./parser_expr_core.vibe {
  parse_infix_no_is
}

import ./token.vibe {
  Token
}

//# Functions

enum BlockStep {
  StepSeq(Expr);
  StepValue(Expr);
  StepLet(String, Expr);
  StepLetMut(String, Expr);
  StepLetRec(String, Expr);
  StepAssign(String, Expr);
  StepAssignOp(String, String, Expr);
  StepPattern(Pat, Expr);
  StepStructDestr(Pat, Expr);
  StepRecordDestr(Pat, Expr)
}

let rec parse_match_rest: (Array[Token], Int, Expr, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, scrutinee, b, parse_recur) -> {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 2),
      _ => {
        let (pa, paa) = parse_pattern(tokens, pos + 1)
        let a2 = match peek(tokens, paa) {
          TIf => {
            let (_, ga) = parse_recur(tokens, paa + 1, 0)
            expect_tk(tokens, ga, "=>")
          },
          _ => expect_tk(tokens, paa, "=>")
        }
        let (ea, en) = parse_recur(tokens, a2, 0)
        ArrayBuilder::push(b, (pa, ea))
        parse_match_rest(tokens, en, scrutinee, b, parse_recur)
      }
    },
    TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 1),
    _ => {
      let (pa, paa) = parse_pattern(tokens, pos)
      let a2 = match peek(tokens, paa) {
        TIf => {
          let (_, ga) = parse_recur(tokens, paa + 1, 0)
          expect_tk(tokens, ga, "=>")
        },
        _ => expect_tk(tokens, paa, "=>")
      }
      let (ea, en) = parse_recur(tokens, a2, 0)
      ArrayBuilder::push(b, (pa, ea))
      parse_match_rest(tokens, en, scrutinee, b, parse_recur)
    }
  }
}

let rec qualify_handle_arm_pattern: (String, Pat) -> Pat = (effect_name, pat) -> {
  match pat {
    PCtor(name, args) => if String::contains(name, "::") {
      PCtor(name, args)
    } else {
      PCtor(String::concat(effect_name, String::concat("::", name)), args)
    },
    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),
    _ => pat
  }
}

let parse_handle_arm: (Array[Token], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } = (tokens, pos, effect_name, parse_recur) -> {
  let (pat, pat_next) = parse_pattern(tokens, pos)
  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)
  let arrow_pos = expect_tk(tokens, pat_next, "=>")
  let (expr, next) = parse_recur(tokens, arrow_pos, 0)
  ((qualified_pat, expr), next)
}

let rec parse_handle_rest: (Array[Token], Int, Expr, String, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, body, effect_name, b, parse_recur) -> {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),
      _ => {
        let (arm, next) = parse_handle_arm(tokens, pos + 1, effect_name, parse_recur)
        ArrayBuilder::push(b, arm)
        parse_handle_rest(tokens, next, body, effect_name, b, parse_recur)
      }
    },
    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),
    _ => throw("expected ';' or '}' in handle arm list")
  }
}

let parse_block_after_expr: (Array[Token], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, e, parse_recur) -> {
  match peek(tokens, pos) {
    TRBrace => (e, pos + 1),
    TSemicolon => {
      let (rest, end) = parse_recur(tokens, pos + 1, 20)
      (ESeq(e, rest), end)
    },
    TEq => match e {
      EIdent(name) => {
        let val_pair = parse_recur(tokens, pos + 1, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20)
        (EAssign(name, val, rest), end)
      },
      EDot(obj, field) => {
        let val_pair = parse_recur(tokens, pos + 1, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20)
        let set_args = empty_exprs()
        Array::push(set_args, obj)
        Array::push(set_args, EString(field))
        Array::push(set_args, val)
        (ESeq(ECall(EIdent("__set_field"), set_args), rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TPlusEq => match e {
      EIdent(name) => {
        let val_pair = parse_recur(tokens, pos + 1, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20)
        (EAssignOp(name, "+", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TMinusEq => match e {
      EIdent(name) => {
        let val_pair = parse_recur(tokens, pos + 1, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20)
        (EAssignOp(name, "-", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TStarEq => match e {
      EIdent(name) => {
        let val_pair = parse_recur(tokens, pos + 1, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20)
        (EAssignOp(name, "*", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TSlashEq => match e {
      EIdent(name) => {
        let val_pair = parse_recur(tokens, pos + 1, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20)
        (EAssignOp(name, "/", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    TPercentEq => match e {
      EIdent(name) => {
        let val_pair = parse_recur(tokens, pos + 1, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        let a = skip_semi(tokens, val_next)
        let (rest, end) = parse_recur(tokens, a, 20)
        (EAssignOp(name, "%", val, rest), end)
      },
      _ => throw("invalid assignment target")
    },
    _ => {
      let (rest, end) = parse_recur(tokens, pos, 20)
      if end <= pos {
        throw("internal parser error: block continuation did not advance")
      } else {
        (ESeq(e, rest), end)
      }
    }
  }
}

let parse_block_value_body: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Expr, Int, Int) with { Error } = (tokens, eq, parse_recur) -> {
  let val_pair = parse_recur(tokens, eq, 0)
  let val = val_pair.0
  let val_next = val_pair.1
  let a = skip_semi(tokens, val_next)
  let (body, end) = parse_recur(tokens, a, 20)
  (val, body, end, a)
}

let parse_block_value_only: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, value_pos, parse_recur) -> {
  let val_pair = parse_recur(tokens, value_pos, 0)
  (val_pair.0, skip_semi(tokens, val_pair.1))
}

let apply_struct_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {
  let val_name = "__struct_destr"
  let mut desugar = rest
  match pat {
    PStruct(_, fields) => {
      let mut di = Array::length(fields) - 1
      while di >= 0 {
        let (fname, fpat) = Array::get(fields, di)
        match fpat {
          PBind(bname) => {
            desugar = ELet(bname, EDot(EIdent(val_name), fname), desugar)
          },
          _ => ()
        }
        di = di - 1
      }
    },
    _ => ()
  }
  ELet(val_name, val, desugar)
}

let apply_record_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {
  let val_name = "__rec_destr"
  let mut desugar = rest
  match pat {
    PTuple(field_pats) => {
      let mut di = Array::length(field_pats) - 1
      while di >= 0 {
        let fp = Array::get(field_pats, di)
        match fp {
          PBind(bname) => {
            desugar = ELet(bname, ECall(EIdent("__rec_field"), [
              EIdent(val_name),
              EInt(di)
            ]), desugar)
          },
          PTuple(sub_pats) => {
            let sub_name = String::concat("__rec_sub_", __to_string(di))
            let mut si = Array::length(sub_pats) - 1
            while si >= 0 {
              match Array::get(sub_pats, si) {
                PBind(sname) => {
                  desugar = ELet(sname, EDot(EIdent(sub_name), __to_string(si)), desugar)
                },
                _ => ()
              }
              si = si - 1
            }
            desugar = ELet(sub_name, ECall(EIdent("__rec_field"), [
              EIdent(val_name),
              EInt(di)
            ]), desugar)
          },
          _ => ()
        }
        di = di - 1
      }
    },
    _ => ()
  }
  ELet(val_name, val, desugar)
}

let apply_block_step: (BlockStep, Expr) -> Expr = (step, rest) -> {
  match step {
    StepSeq(expr) => ESeq(expr, rest),
    StepValue(expr) => expr,
    StepLet(name, val) => ELet(name, val, rest),
    StepLetMut(name, val) => ELetMut(name, val, rest),
    StepLetRec(name, val) => ELetRec(name, val, rest),
    StepAssign(name, val) => EAssign(name, val, rest),
    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),
    StepPattern(pat, val) => EMatch(val, [
      (pat, rest)
    ]),
    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),
    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest)
  }
}

let fold_block_steps: (Array[BlockStep]) -> Expr = (steps) -> {
  let mut result = EUnit
  let mut i = Array::length(steps) - 1
  while i >= 0 {
    result = apply_block_step(Array::get(steps, i), result)
    i = i - 1
  }
  result
}

let parse_impl_block: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  let steps = ArrayBuilder::new()
  let mut p = pos
  let mut end_pos = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TRBrace => {
        end_pos = p + 1
        done = true
      },
      TEof => throw("unexpected eof in block"),
      TEnum => {
        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)
        match enum_stmt {
          SEnum(_, _, _, variants) => {
            let mut vi = 0
            while vi < Array::length(variants) {
              let (vname, vfields) = Array::get(variants, vi)
              if Array::length(vfields) == 0 {
                ArrayBuilder::push(steps, StepLet(vname, EInt(vi)))
              }
              vi = vi + 1
            }
          },
          _ => ()
        }
        p = enum_end
      },
      TStruct => {
        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)
        p = struct_end
      },
      TLet => {
        let next = p + 1
        match peek(tokens, next) {
          TRec => match peek(tokens, next + 1) {
            TIdent(name) => {
              let eq_pos_r = match peek(tokens, next + 2) {
                TColon => {
                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)
                  tp
                },
                _ => next + 2
              }
              let eq = expect_tk(tokens, eq_pos_r, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              if next_pos <= eq {
                throw("internal parser error: block let-rec parser did not advance")
              } else {
                ArrayBuilder::push(steps, StepLetRec(name, val))
                p = next_pos
              }
            },
            _ => throw("expected identifier after 'let rec'")
          },
          TMut => match peek(tokens, next + 1) {
            TIdent(name) => {
              let eq_pos_m = match peek(tokens, next + 2) {
                TColon => {
                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)
                  tp
                },
                _ => next + 2
              }
              let eq = expect_tk(tokens, eq_pos_m, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              if next_pos <= eq {
                throw("internal parser error: block let-mut parser did not advance")
              } else {
                ArrayBuilder::push(steps, StepLetMut(name, val))
                p = next_pos
              }
            },
            _ => throw("expected identifier after 'let mut'")
          },
          TIdent(name) => {
            let after_name = peek(tokens, next + 1)
            let next_is_struct_destr = match after_name {
              TDoubleColon => {
                let fc = String::char_code_at(name, 0)
                if fc >= 65 && fc <= 90 {
                  match peek(tokens, next + 2) {
                    TLBrace => true,
                    _ => false
                  }
                } else {
                  false
                }
              },
              _ => false
            }
            let next_is_record_destr = match after_name {
              TLBrace => name == "record",
              _ => false
            }
            if next_is_struct_destr {
              let (pat, pn) = parse_pattern(tokens, next)
              let eq = expect_tk(tokens, pn, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              ArrayBuilder::push(steps, StepStructDestr(pat, val))
              p = next_pos
            } else if next_is_record_destr {
              let (pat, pn) = parse_pattern(tokens, next)
              let eq = expect_tk(tokens, pn, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              ArrayBuilder::push(steps, StepRecordDestr(pat, val))
              p = next_pos
            } else {
              match after_name {
                TLParen => {
                  let (pat, pn) = parse_pattern(tokens, next)
                  let eq = expect_tk(tokens, pn, "=")
                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
                  if next_pos <= eq {
                    throw("internal parser error: block let-ctor-pat parser did not advance")
                  } else {
                    ArrayBuilder::push(steps, StepPattern(pat, val))
                    p = next_pos
                  }
                },
                _ => {
                  let eq_pos = match after_name {
                    TColon => {
                      let (_, tp) = parse_type_impl(tokens, next + 2, 0)
                      tp
                    },
                    _ => next + 1
                  }
                  let eq = expect_tk(tokens, eq_pos, "=")
                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
                  if next_pos <= eq {
                    throw("internal parser error: block let parser did not advance")
                  } else {
                    ArrayBuilder::push(steps, StepLet(name, val))
                    p = next_pos
                  }
                }
              }
            }
          },
          TLParen => {
            let (pat, pn) = parse_pattern(tokens, next)
            let eq = expect_tk(tokens, pn, "=")
            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
            if next_pos <= eq {
              throw("internal parser error: block let-pat parser did not advance")
            } else {
              ArrayBuilder::push(steps, StepPattern(pat, val))
              p = next_pos
            }
          },
          _ => throw("expected identifier after 'let'")
        }
      },
      _ => {
        let (e, next) = parse_recur(tokens, p, 0)
        if next <= p {
          throw("internal parser error: block expr parser did not advance")
        } else {
          match peek(tokens, next) {
            TRBrace => {
              ArrayBuilder::push(steps, StepValue(e))
              end_pos = next + 1
              done = true
            },
            TSemicolon => {
              ArrayBuilder::push(steps, StepSeq(e))
              p = next + 1
            },
            TEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssign(name, val))
                p = next_pos
              },
              EDot(obj, field) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                let set_args = empty_exprs()
                Array::push(set_args, obj)
                Array::push(set_args, EString(field))
                Array::push(set_args, val)
                ArrayBuilder::push(steps, StepSeq(ECall(EIdent("__set_field"), set_args)))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TPlusEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "+", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TMinusEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "-", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TStarEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "*", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TSlashEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "/", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TPercentEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "%", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            _ => {
              ArrayBuilder::push(steps, StepSeq(e))
              p = next
            }
          }
        }
      }
    }
  }
  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)
}

// `for await x in s { body }` desugar (selfhost pull model, docs/spec
// §M2c-3). The `await` marker selects the async-iterator (pull) loop: the
// iterable `s` is a pull closure `() -> Option[T]` whose state lives in the
// host (e.g. `stdin_stream(4)`), so the loop calls `s()` once per step and
// stops at `None`. This mirrors the proven terminal-consumer shape in
// vibe/io/byte_stream.vibe (`while not(done) { match next() { Some => ..,
// None => done = true } }`) using only nodes codegen already handles, so no
// type information is needed at codegen time. `uid` (the source token index)
// keeps the generated binding names unique across nested loops.
let build_pull_for_in: (String, Option[String], Expr, Expr, Int) -> Expr = (value_name, index_name, iterable, body, uid) -> {
  let next_var = "__pull_next_\{uid}"
  let cont_var = "__pull_continue_\{uid}"
  let some_arm = match index_name {
    Some(ix) => ESeq(body, EAssign(ix, EBinOp("+", EIdent(ix), EInt(1)), EUnit)),
    None => ESeq(body, EUnit)
  }
  let loop_body = EMatch(ECall(EIdent(next_var), []), [
    (PCtor("Some", [PBind(value_name)]), some_arm),
    (PCtor("None", []), EAssign(cont_var, EBool(false), EUnit))
  ])
  let core_loop = ELetMut(cont_var, EBool(true), EWhile(EIdent(cont_var), loop_body))
  let with_index = match index_name {
    Some(ix) => ELetMut(ix, EInt(0), core_loop),
    None => core_loop
  }
  ELet(next_var, iterable, with_index)
}

export let parse_impl_dispatch: (Array[Token], Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, mode, parse_recur) -> {
  if mode == 20 {
    parse_impl_block(tokens, pos, parse_recur)
  } else if mode == 21 {
    // Parse cond with the no-is variant so a trailing `is pattern` belongs
    // to the if-cond pattern slot rather than collapsing into a Bool match.
    let (cond, cn) = parse_infix_no_is(tokens, pos, 0, pos, parse_recur)
    let mut is_mode = false
    let mut is_pat_val = PWild
    let mut brace_pos = cn
    match peek(tokens, cn) {
      TIs => {
        let (pat, pn) = parse_pattern(tokens, cn + 1)
        is_mode = true
        is_pat_val = pat
        brace_pos = pn
      },
      TIdent(kw) => if kw == "is" {
        let (pat, pn) = parse_pattern(tokens, cn + 1)
        is_mode = true
        is_pat_val = pat
        brace_pos = pn
      },
      _ => ()
    }
    let br = expect_tk(tokens, brace_pos, "{")
    let (then_e, tn) = parse_recur(tokens, br, 20)
    let (else_e, end_pos) = match peek(tokens, tn) {
      TElse => match peek(tokens, tn + 1) {
        TIf => parse_recur(tokens, tn + 2, 21),
        TLBrace => parse_recur(tokens, tn + 2, 20),
        _ => parse_recur(tokens, tn + 1, 0)
      },
      _ => (EUnit, tn)
    }
    if is_mode {
      (EMatch(cond, [
        (is_pat_val, then_e),
        (PWild, else_e)
      ]), end_pos)
    } else {
      (EIf(cond, then_e, else_e), end_pos)
    }
  } else if mode == 22 {
    let (scrutinee, sn) = parse_recur(tokens, pos, 0)
    let br = expect_tk(tokens, sn, "{")
    match peek(tokens, br) {
      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),
      _ => {
        let b = ArrayBuilder::new()
        let (fp, fa) = parse_pattern(tokens, br)
        let aa = match peek(tokens, fa) {
          TIf => {
            let (_, ga) = parse_recur(tokens, fa + 1, 0)
            expect_tk(tokens, ga, "=>")
          },
          _ => expect_tk(tokens, fa, "=>")
        }
        let (fe, fn1) = parse_recur(tokens, aa, 0)
        ArrayBuilder::push(b, (fp, fe))
        parse_match_rest(tokens, fn1, scrutinee, b, parse_recur)
      }
    }
  } else if mode == 23 {
    let (cond, cn) = parse_recur(tokens, pos, 0)
    let br = expect_tk(tokens, cn, "{")
    let (body, end) = parse_recur(tokens, br, 20)
    (EWhile(cond, body), end)
  } else if mode == 24 {
    let br = expect_tk(tokens, pos, "{")
    let (body, bn) = parse_recur(tokens, br, 20)
    let wp = expect_tk(tokens, bn, "with")
    let (effect_name, effect_next) = match peek(tokens, wp) {
      TIdent(name) => (name, wp + 1),
      _ => throw("expected effect name after 'with'")
    }
    let hb = expect_tk(tokens, effect_next, "{")
    match peek(tokens, hb) {
      TRBrace => (EHandle(body, empty_arms()), hb + 1),
      _ => {
        let b = ArrayBuilder::new()
        let (arm, next) = parse_handle_arm(tokens, hb, effect_name, parse_recur)
        ArrayBuilder::push(b, arm)
        parse_handle_rest(tokens, next, body, effect_name, b, parse_recur)
      }
    }
  } else if mode == 25 {
    // `for await x in stream { ... }`: `await` is not a keyword (it is the
    // builtin call `await(...)`), so detect the async-iterator marker as an
    // `await` identifier immediately followed by the binding name. When the
    // marker is present, the iterable is a pull closure `() -> Option[T]` and
    // the loop is desugared into a pull-to-`None` loop (see build_pull_for_in,
    // docs/spec §M2c-3). Without the marker, `for x in arr` iterates an eager
    // Array[T] via EForIn. A loop variable literally named `await`
    // (`for await in e`) is still parsed as a binding because `await` is then
    // followed by `in`, so `is_await` stays false.
    let mut start = pos
    let mut is_await = false
    match peek(tokens, pos) {
      TIdent(marker) => if marker == "await" {
        match peek(tokens, pos + 1) {
          TIdent(_) => { start = pos + 1; is_await = true },
          _ => ()
        }
      } else (),
      _ => ()
    }
    match peek(tokens, start) {
      TIdent(first_name) => match peek(tokens, start + 1) {
        TComma => match peek(tokens, start + 2) {
          TIdent(second_name) => {
            let ip = expect_tk(tokens, start + 3, "in")
            match parse_recur(tokens, ip, 0) {
              (iterable, after_iter) => {
                let bb = expect_tk(tokens, after_iter, "{")
                let (body, end) = parse_recur(tokens, bb, 20)
                let loop_expr = if is_await {
                  build_pull_for_in(second_name, Some(first_name), iterable, body, start)
                } else {
                  EForIn(second_name, Some(first_name), iterable, body)
                }
                (loop_expr, end)
              },
              _ => throw("unreachable: parse_recur for for-in")
            }
          },
          _ => throw("expected value binding name after ','")
        },
        _ => {
          let ip = expect_tk(tokens, start + 1, "in")
          match parse_recur(tokens, ip, 0) {
            (iterable, after_iter) => {
              let bb = expect_tk(tokens, after_iter, "{")
              let (body, end) = parse_recur(tokens, bb, 20)
              let loop_expr = if is_await {
                build_pull_for_in(first_name, None, iterable, body, start)
              } else {
                EForIn(first_name, None, iterable, body)
              }
              (loop_expr, end)
            },
            _ => throw("unreachable: parse_recur for for-in")
          }
        }
      }
      ,
      _ => throw("expected identifier after 'for'")
    }
  } else {
    let actual = tk_name(peek(tokens, pos))
    throw("internal parser error: unknown parse mode \{mode} at #\{pos} token=\{actual}")
  }
}
