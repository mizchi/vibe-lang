//# Imports

import ../core {
  Expr, Pat, Stmt, TypeExpr
}

import ./token.vibe {
  Token
}


//# Functions

let peek = (tokens: Array[Token], pos: Int) -> Token {
  if pos < Array::length(tokens) {
    Array::get(tokens, pos)
  } else TEof
}

let _no_tp = () -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

let _no_tb = () -> Array[(String, Array[String])] {
  Array::slice([
    ("", _no_tp())
  ], 0, 0)
}

let mode_if = 21

let tk_name = (tok: Token) -> String {
  match tok {
    TInt(_) => "int",
    TFloat(_) => "float",
    TString(_) => "string",
    TStringInterp(_) => "string",
    TIdent(_) => "ident",
    TLet => "let",
    TRec => "rec",
    TMut => "mut",
    TFn => "fn",
    TIf => "if",
    TElse => "else",
    TMatch => "match",
    TDo => "do",
    TEnum => "enum",
    TStruct => "struct",
    TType => "type",
    TTrait => "trait",
    TImpl => "impl",
    TExport => "export",
    TTest => "test",
    TWhile => "while",
    TFor => "for",
    TIn => "in",
    TLoop => "loop",
    TBreak => "break",
    TContinue => "continue",
    TReturn => "return",
    TWith => "with",
    THandle => "handle",
    TThrow => "throw",
    TRaise => "raise",
    TYield => "yield",
    TBench => "bench",
    TDeclare => "declare",
    TAs => "as",
    TModule => "module",
    TSuberror => "suberror",
    TDerive => "derive",
    TOpen => "open",
    TImport => "import",
    TPlus => "+",
    TMinus => "-",
    TStar => "*",
    TSlash => "/",
    TPercent => "%",
    TEqEq => "==",
    TNeq => "!=",
    TLt => "<",
    TLte => "<=",
    TGt => ">",
    TGte => ">=",
    TAnd => "&&",
    TOr => "||",
    TNot => "!",
    TBitAnd => "&",
    TBitOr => "|",
    TBitXor => "^",
    TLShift => "<<",
    TRShift => ">>",
    TPipeGt => "|>",
    TArrow => "=>",
    TThinArrow => "->",
    TEq => "=",
    TDot => ".",
    TColon => ":",
    TDoubleColon => "::",
    TComma => ",",
    TSemicolon => ";",
    THash => "#",
    TTilde => "~",
    TQuestion => "?",
    TPlusEq => "+=",
    TMinusEq => "-=",
    TStarEq => "*=",
    TSlashEq => "/=",
    TPercentEq => "%=",
    TLParen => "(",
    TRParen => ")",
    TLBrace => "{",
    TRBrace => "}",
    TLBracket => "[",
    TRBracket => "]",
    TDotDot => "..",
    TDotDotDot => "...",
    TStringInterp(_) => "string",
    TEof => "eof"
  }
}

let is_tk = (tok: Token, name: String) -> Bool {
  tk_name(tok) == name
}

let expect_tk = (tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {
  if is_tk(peek(tokens, pos), expected) {
    pos + 1
  }
  else throw("expected \{expected} but got \{tk_name(peek(tokens, pos))}")
}

let skip_semi = (tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens, pos) {
    TSemicolon => pos + 1,
    _ => pos
  }
}

let empty_arms = () -> Array[(Pat, Expr)] {
  Array::slice([
    (PWild, EUnit)
  ], 0, 0)
}

let empty_pats = () -> Array[Pat] {
  Array::slice([
    PWild
  ], 0, 0)
}

let mode_block = 20

let mode_match = 22

let mode_while = 23

let empty_ctors = () -> Array[(String, Array[TypeExpr])] {
  Array::slice([
    ("_", Array::slice([
      TyUnit
    ], 0, 0))
  ], 0, 0)
}

let empty_exprs = () -> Array[Expr] {
  Array::slice([
    EUnit
  ], 0, 0)
}

let empty_names = () -> Array[String] {
  Array::slice([
    "_"
  ], 0, 0)
}

let mode_for_in = 25

let mode_handle = 24

let empty_fields = () -> Array[(String, TypeExpr)] {
  Array::slice([
    ("_", TyUnit)
  ], 0, 0)
}

let empty_params = () -> Array[(String, Option[TypeExpr])] {
  Array::slice([
    ("", None)
  ], 0, 0)
}

let rec parse_pattern = (tokens: Array[Token], pos: Int) -> (Pat, Int)with { Error } {
  let rec parse_pat_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Pat]) -> (Array[Pat], Int)with { Error } {
    match peek(tokens, pos) {
      TComma => {
        let (p, pn) = parse_pattern(tokens, pos + 1)
        ArrayBuilder::push(b, p)
        parse_pat_cont(tokens, pn, b)
      },
      TRParen => (ArrayBuilder::freeze(b), pos + 1),
      _ => throw("expected ',' or ')' in pattern list")
    }
  }
  let parse_pats_until_rparen = (tokens: Array[Token], pos: Int) -> (Array[Pat], Int)with { Error } {
    match peek(tokens, pos) {
      TRParen => (empty_pats(), pos + 1),
      _ => {
        let (f, fn1) = parse_pattern(tokens, pos)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, f)
        parse_pat_cont(tokens, fn1, b)
      }
    }
  }
  let (pat, next) = match peek(tokens, pos) {
    TInt(n) => (PInt(n), pos + 1),
    TFloat(_) => (PWild, pos + 1),
    TString(s) => (PString(s), pos + 1),
    TIdent(name) => if name == "true" {
      (PBool(true), pos + 1)
    }
    else if name == "false" {
      (PBool(false), pos + 1)
    }
    else if name == "_" {
      (PWild, pos + 1)
    }
    else if name == "record" && (match peek(tokens, pos + 1) { TLBrace => true, _ => false }) {
      // Record pattern: record { x: a, y: (b, c) } — bind fields positionally
      let mut rp = pos + 2
      let field_pats_b = ArrayBuilder::new()
      let mut rd = true
      while rd {
        match peek(tokens, rp) {
          TRBrace => { rd = false },
          TIdent(fname) => {
            match peek(tokens, rp + 1) {
              TColon => {
                let (fp, fnext) = parse_pattern(tokens, rp + 2)
                ArrayBuilder::push(field_pats_b, fp)
                rp = fnext
              },
              TComma => { ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1 },
              TRBrace => { ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1 },
              _ => { ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1 }
            }
            match peek(tokens, rp) {
              TComma => { rp = rp + 1 },
              _ => ()
            }
          },
          _ => { rp = rp + 1 }
        }
      }
      let rp2 = rp + 1
      (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)
    }
    else {
      let fc = String::char_code_at(name, 0)
      if fc >= 65 && fc <= 90 {
        match peek(tokens, pos + 1) {
          TLParen => {
            let (args, end) = parse_pats_until_rparen(tokens, pos + 2);
            (PCtor(name, args), end)
          },
          TDoubleColon => match peek(tokens, pos + 2) {
            TLBrace => {
              // Struct pattern: Point::{ x, y } → bind fields positionally
              let mut sp = pos + 3
              let field_pats = ArrayBuilder::new()
              let mut sd = true
              while sd {
                match peek(tokens, sp) {
                  TRBrace => { sd = false },
                  TIdent(fname) => {
                    ArrayBuilder::push(field_pats, PBind(fname))
                    sp = sp + 1
                    match peek(tokens, sp) { TComma => { sp = sp + 1 }, _ => () }
                  },
                  _ => { sd = false }
                }
              }
              (PTuple(ArrayBuilder::freeze(field_pats)), sp + 1)
            },
            _ => (PCtor(name, empty_pats()), pos + 1)
          },
          _ => (PCtor(name, empty_pats()), pos + 1)
        }
      } else (PBind(name), pos + 1)
    },
    TLParen => match peek(tokens, pos + 1) {
      TRParen => (PTuple(empty_pats()), pos + 2),
      _ => {
        let (f, n1) = parse_pattern(tokens, pos + 1)
        match peek(tokens, n1) {
          TRParen => (f, n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, f)
            let (rest, end) = parse_pat_cont(tokens, n1, b);
            (PTuple(rest), end)
          },
          _ => throw("expected ')' or ',' in pattern")
        }
      }
    },
    _ => throw("unexpected in pattern: \{tk_name(peek(tokens, pos))}")
  }
  match peek(tokens, next) {
    TBitOr => {
      let (right, end) = parse_pattern(tokens, next + 1);
      (POr(pat, right), end)
    },
    _ => (pat, next)
  }
}

let parse_impl_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  let empty_strings = Array::slice([
    "_"
  ], 0, 0)
  let empty_bounds = Array::slice([
    ("_", empty_strings)
  ], 0, 0)
  match peek(tokens, pos) {
    TLBracket => {
      throw("impl type parameters are not supported yet")
    },
    TIdent(trait_name) => {
      let fp = expect_tk(tokens, pos + 1, "for")
      match peek(tokens, fp) {
        TIdent(type_name) => (SImpl(empty_strings, empty_bounds, trait_name, type_name), fp + 1),
        _ => throw("expected type name after 'for'")
      }
    },
    _ => throw("expected trait name after 'impl'")
  }
}

let empty_type_exprs = () -> Array[TypeExpr] {
  Array::slice([
    TyUnit
  ], 0, 0)
}

let rec parse_type_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int)with { Error } {
  let rec type_list_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {
    match peek(tokens, pos) {
      TComma => {
        // Skip optional label
        let ts = match peek(tokens, pos + 1) {
          TIdent(_) => match peek(tokens, pos + 2) {
            TColon => pos + 3,
            TTilde => match peek(tokens, pos + 3) { TColon => pos + 4, _ => pos + 1 },
            TQuestion => match peek(tokens, pos + 3) { TColon => pos + 4, _ => pos + 1 },
            _ => pos + 1
          },
          _ => pos + 1
        }
        let (ty, next) = parse_type_impl(tokens, ts, 0)
        ArrayBuilder::push(b, ty)
        type_list_rest(tokens, next, b)
      },
      _ => (ArrayBuilder::freeze(b), pos)
    }
  }
  if mode == 0 {
    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)
    match peek(tokens, atom_next) {
      TThinArrow => {
        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)
        let params = match atom_ty {
          TyUnit => empty_type_exprs(),
          TyTuple(elems) => elems,
          _ => [
            atom_ty
          ]
        }
        let rn2 = match peek(tokens, rn) {
          TWith => {
            let p1 = rn + 1
            match peek(tokens, p1) {
              TLBrace => {
                let mut p2 = p1 + 1
                let mut done = false
                while (!(done)) {
                  match peek(tokens, p2) {
                    TRBrace => {
                      done = true
                    },
                    _ => {
                      p2 = p2 + 1
                    }
                  }
                }
                p2 + 1
              },
              _ => rn
            }
          },
          _ => rn
        };
        // Skip optional `with { Effect }` after function return type
        let fn_end = match peek(tokens, rn2) {
          TWith => {
            // Skip { ... } block
            let mut wp = rn2 + 1
            match peek(tokens, wp) {
              TLBrace => {
                wp = wp + 1
                let mut wd = 1
                while wd > 0 {
                  match peek(tokens, wp) {
                    TLBrace => { wd = wd + 1 },
                    TRBrace => { wd = wd - 1 },
                    _ => ()
                  }
                  wp = wp + 1
                }
                wp
              },
              _ => rn2
            }
          },
          _ => rn2
        }
        (TyFn(params, ret), fn_end)
      },
      _ => (atom_ty, atom_next)
    }
  } else match peek(tokens, pos) {
    TLParen => match peek(tokens, pos + 1) {
      TRParen => (TyUnit, pos + 2),
      _ => {
        // Skip optional label: (name: Type, ...) or (name~: Type, ...)
        let ty_start = match peek(tokens, pos + 1) {
          TIdent(_) => match peek(tokens, pos + 2) {
            TColon => pos + 3,
            TTilde => match peek(tokens, pos + 3) { TColon => pos + 4, _ => pos + 1 },
            TQuestion => match peek(tokens, pos + 3) { TColon => pos + 4, _ => pos + 1 },
            _ => pos + 1
          },
          _ => pos + 1
        }
        let (first, n1) = parse_type_impl(tokens, ty_start, 0)
        match peek(tokens, n1) {
          TRParen => (first, n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, first)
            let (rest, end) = type_list_rest(tokens, n1, b)
            let en = expect_tk(tokens, end, ")");
            (TyTuple(rest), en)
          },
          _ => throw("expected ')' or ',' in type")
        }
      }
    },
    TIdent(name) => match peek(tokens, pos + 1) {
      TLBracket => {
        let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
        match peek(tokens, n1) {
          TRBracket => (TyApp(name, [
            first
          ]), n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, first)
            let (rest, end) = type_list_rest(tokens, n1, b)
            let en = expect_tk(tokens, end, "]");
            (TyApp(name, rest), en)
          },
          _ => throw("expected ']' or ',' in type application")
        }
      },
      _ => (TyName(name), pos + 1)
    },
    _ => throw("expected type but got \{tk_name(peek(tokens, pos))}")
  }
}

export let parse_type = (tokens: Array[Token], pos: Int) -> (TypeExpr, Int)with { Error } {
  parse_type_impl(tokens, pos, 0)
}

let parse_one_param = (tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TTilde => {
        let labeled_name = "\{name}~"
        match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            ((labeled_name, Some(ty)), tp)
          },
          _ => ((labeled_name, None), pos + 2)
        }
      },
      TQuestion => {
        let opt_name = "\{name}?"
        match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            ((opt_name, Some(ty)), tp)
          },
          _ => ((opt_name, None), pos + 2)
        }
      },
      TColon => {
        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);
        // Skip optional trait bound: x: T: Eq or x: T: Eq + Show
        let tp2 = match peek(tokens, tp) {
          TColon => {
            let mut bp = tp + 1
            let mut bd = true
            while bd {
              match peek(tokens, bp) {
                TIdent(_) => { bp = bp + 1; match peek(tokens, bp) { TPlus => { bp = bp + 1 }, _ => { bd = false } } },
                _ => { bd = false }
              }
            }
            bp
          },
          _ => tp
        }
        ((name, Some(ty)), tp2)
      },
      _ => ((name, None), pos + 1)
    },
    _ => throw("expected parameter name")
  }
}

let rec parse_param_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRParen => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (p, pn) = parse_one_param(tokens, pos + 1)
        ArrayBuilder::push(b, p)
        parse_param_cont(tokens, pn, b)
      }
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or ')' in param list")
  }
}

let parse_param_list = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {
  match peek(tokens, pos) {
    TRParen => (empty_params(), pos + 1),
    _ => {
      let (f, fn1) = parse_one_param(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, f)
      parse_param_cont(tokens, fn1, b)
    }
  }
}

let parse_trait_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  let empty_strings = Array::slice([
    "_"
  ], 0, 0)
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TColon => {
        let rec parse_supers = (p: Int, acc: Array[String]) -> (Array[String], Int) {
          match peek(tokens, p) {
            TIdent(sname) => match peek(tokens, p + 1) {
              TPlus => parse_supers(p + 2, Array::concat(acc, [
                sname
              ])),
              _ => (Array::concat(acc, [
                sname
              ]), p + 1)
            },
            _ => (acc, p)
          }
        }
        let (supers, np) = parse_supers(pos + 2, empty_strings);
        (STrait(exported, name, supers), np)
      },
      _ => (STrait(exported, name, empty_strings), pos + 1)
    },
    _ => throw("expected trait name")
  }
}

let is_expr_end_token = (tok: Token) -> Bool {
  match tok {
    TInt(_) => true,
    TFloat(_) => true,
    TString(_) => true,
    TStringInterp(_) => true,
    TIdent(_) => true,
    TRParen => true,
    TRBracket => true,
    TRBrace => true,
    _ => false
  }
}

let is_non_pipe_infix = (tok: Token) -> Bool {
  match tok {
    TOr => true,
    TAnd => true,
    TEqEq => true,
    TNeq => true,
    TLt => true,
    TLte => true,
    TGt => true,
    TGte => true,
    TBitOr => true,
    TBitXor => true,
    TBitAnd => true,
    TLShift => true,
    TRShift => true,
    TPlus => true,
    TMinus => true,
    TStar => true,
    TSlash => true,
    TPercent => true,
    _ => false
  }
}

let parse_import_item = (tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int)with { Error } {
  let parse_import_name = (name_pos: Int) -> ((String, Option[String]), Int)with { Error } {
    match peek(tokens, name_pos) {
      TIdent(name) => match peek(tokens, name_pos + 1) {
        TAs => match peek(tokens, name_pos + 2) {
          TIdent(alias) => ((name, Some(alias)), name_pos + 3),
          _ => throw("expected alias name after 'as'")
        },
        _ => ((name, None), name_pos + 1)
      },
      _ => throw("expected import item name")
    }
  }
  match peek(tokens, pos) {
    TIdent(_) => parse_import_name(pos),
    TType => parse_import_name(pos + 1),
    TTrait => parse_import_name(pos + 1),
    _ => throw("expected import item name")
  }
}

let empty_import_items = () -> Array[(String, Option[String])] {
  Array::slice([
    ("_", None)
  ], 0, 0)
}

let parse_binding_name = (tokens: Array[Token], pos: Int) -> (String, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) => (String::concat(name, String::concat("::", member)), pos + 3),
        _ => throw("expected qualified member name after '::'")
      },
      _ => (name, pos + 1)
    },
    _ => throw("expected name after 'let'")
  }
}

let parse_struct_field = (tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let cn = expect_tk(tokens, pos + 1, ":")
      let (ty, next) = parse_type_impl(tokens, cn, 0);
      ((name, ty), next)
    },
    _ => throw("expected field name")
  }
}

let rec collect_import_path = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {
  match peek(tokens, pos) {
    TLBrace => (acc, pos),
    TDot => collect_import_path(tokens, pos + 1, "\{acc}."),
    TDotDot => collect_import_path(tokens, pos + 1, "\{acc}.."),
    TSlash => collect_import_path(tokens, pos + 1, "\{acc}/"),
    TIdent(name) => collect_import_path(tokens, pos + 1, "\{acc}\{name}"),
    TMinus => collect_import_path(tokens, pos + 1, "\{acc}-"),
    TModule => collect_import_path(tokens, pos + 1, "\{acc}module"),
    TType => collect_import_path(tokens, pos + 1, "\{acc}type"),
    TMatch => collect_import_path(tokens, pos + 1, "\{acc}match"),
    TTest => collect_import_path(tokens, pos + 1, "\{acc}test"),
    _ => throw("unexpected token in import path: \{tk_name(peek(tokens, pos))}")
  }
}

let rec collect_effect_names = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {
  match peek(tokens, pos) {
    TRBrace => (acc, pos + 1),
    TIdent(name) => {
      let new_acc = if String::length(acc) == 0 {
        name
      } else "\{acc}, \{name}"
      match peek(tokens, pos + 1) {
        TComma => collect_effect_names(tokens, pos + 2, new_acc),
        TRBrace => (new_acc, pos + 2),
        _ => throw("expected ',' or '}' in effect list")
      }
    },
    _ => throw("expected effect name or '}'")
  }
}

let rec is_lambda_start_impl = (tokens: Array[Token], pos: Int, depth: Int, has_colon: Bool) -> Bool {
  match peek(tokens, pos) {
    TColon => if depth == 0 {
      is_lambda_start_impl(tokens, pos + 1, depth, true)
    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),
    TRParen => if depth == 0 {
      match peek(tokens, pos + 1) {
        TThinArrow => true,
        TLBrace => true,
        _ => false
      }
    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),
    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),
    TEof => false,
    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)
  }
}

let is_lambda_start = (tokens: Array[Token], pos: Int) -> Bool {
  is_lambda_start_impl(tokens, pos, 0, false)
}

let rec parse_ctor_types_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {
  match peek(tokens, pos) {
    TComma => {
      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)
      ArrayBuilder::push(b, ty)
      parse_ctor_types_rest(tokens, next, b)
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or ')' in constructor types")
  }
}

let parse_enum_ctor = (tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TLParen => match peek(tokens, pos + 2) {
        TRParen => ((name, empty_type_exprs()), pos + 3),
        _ => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, first)
          let (types, end) = parse_ctor_types_rest(tokens, n1, b);
          ((name, types), end)
        }
      },
      _ => ((name, empty_type_exprs()), pos + 1)
    },
    _ => throw("expected constructor name")
  }
}

let rec parse_enum_ctors_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)
        ArrayBuilder::push(b, ctor)
        parse_enum_ctors_rest(tokens, next, b)
      }
    },
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)
        ArrayBuilder::push(b, ctor)
        parse_enum_ctors_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';', ',' or '}' in enum")
  }
}

let parse_enum_ctors = (tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_ctors(), pos + 1),
    _ => {
      let (first, next) = parse_enum_ctor(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_enum_ctors_rest(tokens, next, b)
    }
  }
}

let parse_enum_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      // Skip optional type parameters [T] or [T, U]
      let after_name = match peek(tokens, pos + 1) {
        TLBracket => {
          let mut skip = pos + 2
          let mut depth = 1
          while depth > 0 {
            match peek(tokens, skip) {
              TLBracket => { depth = depth + 1; skip = skip + 1 },
              TRBracket => { depth = depth - 1; skip = skip + 1 },
              _ => { skip = skip + 1 }
            }
          }
          skip
        },
        _ => pos + 1
      }
      let br = expect_tk(tokens, after_name, "{")
      let (ctors, end) = parse_enum_ctors(tokens, br);
      (SEnum(exported, name, ctors), end)
    },
    _ => throw("expected enum name")
  }
}

let parse_suberror_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TLParen => match peek(tokens, pos + 2) {
        TRParen => {
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, (name, empty_type_exprs()))
          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)
        },
        _ => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          let args_b = ArrayBuilder::new()
          ArrayBuilder::push(args_b, first)
          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)
          let ctors_b = ArrayBuilder::new()
          ArrayBuilder::push(ctors_b, (name, args))
          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)
        }
      },
      TLBrace => {
        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);
        (SSuberror(exported, name, ctors), end)
      },
      _ => throw("expected '(' or '{' after suberror name")
    },
    _ => throw("expected suberror name")
  }
}

let parse_type_alias_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let ep = expect_tk(tokens, pos + 1, "=")
      let (ty, next) = parse_type_impl(tokens, ep, 0);
      (STypeAlias(exported, name, ty), next)
    },
    _ => throw("expected type alias name")
  }
}

let has_non_pipe_infix_top = (tokens: Array[Token], start: Int, end: Int) -> Bool {
  let rec go = (i: Int, depth: Int, prev_top_end: Bool) -> Bool {
    if i >= end {
      false
    } else {
      let tok = peek(tokens, i)
      if depth == 0 {
        if is_non_pipe_infix(tok) {
          if prev_top_end {
            true
          } else go(i + 1, 0, false)
        } else match tok {
          TLParen => go(i + 1, 1, false),
          TLBracket => go(i + 1, 1, false),
          TLBrace => go(i + 1, 1, false),
          _ => go(i + 1, 0, is_expr_end_token(tok))
        }
      } else match tok {
        TLParen => go(i + 1, depth + 1, prev_top_end),
        TLBracket => go(i + 1, depth + 1, prev_top_end),
        TLBrace => go(i + 1, depth + 1, prev_top_end),
        TRParen => if depth == 1 {
          go(i + 1, 0, true)
        } else go(i + 1, depth - 1, prev_top_end),
        TRBracket => if depth == 1 {
          go(i + 1, 0, true)
        } else go(i + 1, depth - 1, prev_top_end),
        TRBrace => if depth == 1 {
          go(i + 1, 0, true)
        } else go(i + 1, depth - 1, prev_top_end),
        _ => go(i + 1, depth, prev_top_end)
      }
    }
  }
  go(start, 0, false)
}

export let rec parse_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (Expr, Int)with { Error } {
  let rec parse_comma_exprs_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {
    match peek(tokens, pos) {
      TComma => {
        let (e, next) = parse_impl(tokens, pos + 1, 0)
        ArrayBuilder::push(b, e)
        parse_comma_exprs_rest(tokens, next, b)
      },
      _ => (ArrayBuilder::freeze(b), pos)
    }
  }
  let parse_primary = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {
    match peek(tokens, pos) {
      TInt(n) => (EInt(n), pos + 1),
      TFloat(n) => (EFloat(n), pos + 1),
      TString(s) => (EString(s), pos + 1),
      TStringInterp(parts) => (EStringInterp(parts), pos + 1),
      TIdent(name) => if name == "true" {
        (EBool(true), pos + 1)
      }
      else if name == "false" {
        (EBool(false), pos + 1)
      }
      else if name == "record" {
        match peek(tokens, pos + 1) {
          TLBrace => {
            let rec parse_rec_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int)with { Error } {
              match peek(toks, p) {
                TRBrace => (ArrayBuilder::freeze(b), p + 1),
                TIdent(fname) => {
                  let (val, vn) = match peek(toks, p + 1) {
                    TComma => (EIdent(fname), p + 1),
                    TRBrace => (EIdent(fname), p + 1),
                    _ => {
                      let cn = expect_tk(toks, p + 1, ":")
                      parse_impl(toks, cn, 0)
                    }
                  }
                  ArrayBuilder::push(b, (fname, val))
                  match peek(toks, vn) {
                    TComma => parse_rec_fields(toks, vn + 1, b),
                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),
                    _ => throw("expected ',' or '}' in record literal")
                  }
                },
                _ => throw("expected field name or '}' in record literal")
              }
            }
            let rb = ArrayBuilder::new()
            let (fields, end) = parse_rec_fields(tokens, pos + 2, rb);
            (ERecord(fields), end)
          },
          _ => (EIdent(name), pos + 1)
        }
      }
      else if name == "map" {
        match peek(tokens, pos + 1) {
          TLBrace => {
            let rec parse_map_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int)with { Error } {
              match peek(toks, p) {
                TRBrace => (ArrayBuilder::freeze(b), p + 1),
                TIdent(fname) => {
                  let cn = expect_tk(toks, p + 1, ":")
                  let (val, vn) = parse_impl(toks, cn, 0)
                  ArrayBuilder::push(b, (fname, val))
                  match peek(toks, vn) {
                    TComma => parse_map_fields(toks, vn + 1, b),
                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),
                    _ => throw("expected ',' or '}' in map literal")
                  }
                },
                TString(skey) => {
                  let cn = expect_tk(toks, p + 1, ":")
                  let (val, vn) = parse_impl(toks, cn, 0)
                  ArrayBuilder::push(b, (skey, val))
                  match peek(toks, vn) {
                    TComma => parse_map_fields(toks, vn + 1, b),
                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),
                    _ => throw("expected ',' or '}' in map literal")
                  }
                },
                _ => throw("expected field name or '}' in map literal")
              }
            }
            let mb = ArrayBuilder::new()
            let (fields, end) = parse_map_fields(tokens, pos + 2, mb);
            (EMap(fields), end)
          },
          _ => (EIdent(name), pos + 1)
        }
      }
      else match peek(tokens, pos + 1) {
        TDoubleColon => match peek(tokens, pos + 2) {
          TIdent(member) => (EIdent(String::concat(name, String::concat("::", member))), pos + 3),
          TLBrace => {
            let rec parse_record_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int)with { Error } {
              match peek(toks, p) {
                TRBrace => (ArrayBuilder::freeze(b), p + 1),
                TIdent(fname) => {
                  let cn = expect_tk(toks, p + 1, ":")
                  let (val, vn) = parse_impl(toks, cn, 0)
                  ArrayBuilder::push(b, (fname, val))
                  match peek(toks, vn) {
                    TComma => parse_record_fields(toks, vn + 1, b),
                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),
                    _ => throw("expected ',' or '}' in record literal")
                  }
                },
                _ => throw("expected field name or '}' in record literal")
              }
            }
            let rb = ArrayBuilder::new()
            let (fields, end) = parse_record_fields(tokens, pos + 3, rb);
            (ERecord(fields), end)
          },
          _ => (EIdent(name), pos + 1)
        },
        _ => (EIdent(name), pos + 1)
      },
      TLParen => if is_lambda_start(tokens, pos + 1) {
        let (params, ap) = parse_param_list(tokens, pos + 1)
        let parse_lambda_body = (saved_params: Array[(String, Option[TypeExpr])], saved_ret_ty: Option[TypeExpr], saved_effect: Option[String], body_pos: Int, body_mode: Int) -> (Expr, Int)with { Error } {
          let (body, end) = parse_impl(tokens, body_pos, body_mode);
          (EFn(_no_tp(), _no_tb(), saved_params, saved_ret_ty, saved_effect, body), end)
        }
        match peek(tokens, ap) {
          TThinArrow => {
            let after_arrow = ap + 1
            match peek(tokens, after_arrow) {
              TIdent(_) => {
                let (ty, tp) = parse_type_impl(tokens, after_arrow, 0)
                match peek(tokens, tp) {
                  TLBrace => parse_lambda_body(params, Some(ty), None, tp + 1, mode_block),
                  TWith => {
                    let wb = expect_tk(tokens, tp + 1, "{")
                    let (eff, eb) = collect_effect_names(tokens, wb, "")
                    let bb = expect_tk(tokens, eb, "{")
                    parse_lambda_body(params, Some(ty), Some(eff), bb, mode_block)
                  },
                  _ => parse_lambda_body(params, None, None, after_arrow, 0)
                }
              },
              TLParen => {
                let (ty, tp) = parse_type_impl(tokens, after_arrow, 0)
                match peek(tokens, tp) {
                  TLBrace => parse_lambda_body(params, Some(ty), None, tp + 1, mode_block),
                  TWith => {
                    let wb = expect_tk(tokens, tp + 1, "{")
                    let (eff, eb) = collect_effect_names(tokens, wb, "")
                    let bb = expect_tk(tokens, eb, "{")
                    parse_lambda_body(params, Some(ty), Some(eff), bb, mode_block)
                  },
                  _ => parse_lambda_body(params, None, None, after_arrow, 0)
                }
              },
              _ => parse_lambda_body(params, None, None, after_arrow, 0)
            }
          },
          TLBrace => parse_lambda_body(params, None, None, ap + 1, mode_block),
          _ => throw("expected '->' or '{' after fn params")
        }
      } else match peek(tokens, pos + 1) {
        TRParen => (EUnit, pos + 2),
        _ => {
          let (f, n1) = parse_impl(tokens, pos + 1, 0)
          match peek(tokens, n1) {
            TRParen => (f, n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, f)
              let (tup, end) = parse_comma_exprs_rest(tokens, n1, b)
              let en = expect_tk(tokens, end, ")");
              (ETuple(tup), en)
            },
            _ => throw("expected ')' or ','")
          }
        }
      },
      TLBracket => {
        // Check if this is generic function type params [T] or [K: Show]
        // Heuristic: [Ident(:]|,|]) ... ](
        let is_type_params = match peek(tokens, pos + 1) {
          TIdent(_) => match peek(tokens, pos + 2) {
            TRBracket => match peek(tokens, pos + 3) { TLParen => true, _ => false },
            TColon => true,
            TComma => match peek(tokens, pos + 3) { TIdent(_) => true, _ => false },
            _ => false
          },
          _ => false
        }
        if is_type_params {
          // Skip type params [T] or [K: Show, V]: scan to matching ]
          let mut skip_pos = pos + 1
          let mut depth = 1
          while depth > 0 {
            match peek(tokens, skip_pos) {
              TLBracket => { depth = depth + 1 },
              TRBracket => { depth = depth - 1 },
              _ => ()
            }
            skip_pos = skip_pos + 1
          }
          // Parse as regular lambda (type params stripped)
          let (params, ap) = parse_param_list(tokens, skip_pos)
          match peek(tokens, ap) {
            TThinArrow => {
              let (ret_ty, rtp) = parse_type_impl(tokens, ap + 1, 0)
              let (effect, ep) = match peek(tokens, rtp) {
                TWith => {
                  let lb = expect_tk(tokens, rtp + 1, "{")
                  let (eff_name, en) = collect_effect_names(tokens, lb, "")
                  (Some(eff_name), en)
                },
                _ => (None, rtp)
              }
              let bp2 = expect_tk(tokens, ep, "{")
              let (body, end) = parse_impl(tokens, bp2, mode_block);
              (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end)
            },
            TLBrace => {
              let (body, end) = parse_impl(tokens, ap + 1, mode_block);
              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
            },
            _ => throw("expected '->' or '{' after generic function params")
          }
        } else {
        let rec parse_array_elems_rest = (toks: Array[Token], p: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {
          match peek(toks, p) {
            TComma => {
              let next_p = p + 1
              match peek(toks, next_p) {
                TDotDotDot => {
                  let (e, en) = parse_impl(toks, next_p + 1, 0)
                  ArrayBuilder::push(b, ESpread(e))
                  parse_array_elems_rest(toks, en, b)
                },
                _ => {
                  let (e, en) = parse_impl(toks, next_p, 0)
                  ArrayBuilder::push(b, e)
                  parse_array_elems_rest(toks, en, b)
                }
              }
            },
            _ => (ArrayBuilder::freeze(b), p)
          }
        }
        match peek(tokens, pos + 1) {
          TRBracket => (EArray(empty_exprs()), pos + 2),
          TDotDotDot => {
            let b = ArrayBuilder::new()
            let (f, n1) = parse_impl(tokens, pos + 2, 0)
            ArrayBuilder::push(b, ESpread(f))
            let (arr, end) = parse_array_elems_rest(tokens, n1, b)
            let en = expect_tk(tokens, end, "]");
            (EArray(arr), en)
          },
          _ => {
            let b = ArrayBuilder::new()
            let (f, n1) = parse_impl(tokens, pos + 1, 0)
            ArrayBuilder::push(b, f)
            let (arr, end) = parse_array_elems_rest(tokens, n1, b)
            let en = expect_tk(tokens, end, "]");
            (EArray(arr), en)
          }
        }
        }
      },
      TLBrace => parse_impl(tokens, pos + 1, mode_block),
      TIf => parse_impl(tokens, pos + 1, mode_if),
      TMatch => parse_impl(tokens, pos + 1, mode_match),
      THandle => parse_impl(tokens, pos + 1, mode_handle),
      TWhile => parse_impl(tokens, pos + 1, mode_while),
      TFor => parse_impl(tokens, pos + 1, mode_for_in),
      TThrow => {
        let lp = expect_tk(tokens, pos + 1, "(")
        let (e, en) = parse_impl(tokens, lp, 0)
        let rp = expect_tk(tokens, en, ")");
        (EThrow(e), rp)
      },
      TBreak => {
        let next_tok = peek(tokens, pos + 1)
        match next_tok {
          TRBrace => (EBreak(None), pos + 1),
          TSemicolon => (EBreak(None), pos + 1),
          TEof => (EBreak(None), pos + 1),
          _ => {
            let (e, en) = parse_impl(tokens, pos + 1, 0);
            (EBreak(Some(e)), en)
          }
        }
      },
      TContinue => match peek(tokens, pos + 1) {
        TLParen => {
          let b = ArrayBuilder::new()
          match peek(tokens, pos + 2) {
            TRParen => (EContinue(empty_exprs()), pos + 3),
            _ => {
              let (f, fn1) = parse_impl(tokens, pos + 2, 0)
              ArrayBuilder::push(b, f)
              let (args, end) = parse_comma_exprs_rest(tokens, fn1, b)
              let en = expect_tk(tokens, end, ")");
              (EContinue(args), en)
            }
          }
        },
        _ => (EContinue(empty_exprs()), pos + 1)
      }
      ,
      TRaise => throw("'raise' is deprecated, use 'throw(expr)' instead"),
      TReturn => throw("'return' is not supported; use implicit returns"),
      TDo => throw("'do' is reserved; use 'while' or 'for' instead"),
      TLoop => match peek(tokens, pos + 1) {
        TLParen => {
          let params_b = ArrayBuilder::new()
          let mut cur = pos + 2
          let mut done = false
          while !done {
            match peek(tokens, cur) {
              TRParen => {
                cur = cur + 1
                done = true
              },
              TIdent(name) => {
                let eq = expect_tk(tokens, cur + 1, "=")
                let (init, next) = parse_impl(tokens, eq, 0)
                ArrayBuilder::push(params_b, (name, init))
                match peek(tokens, next) {
                  TComma => {
                    cur = next + 1
                  },
                  TRParen => {
                    cur = next + 1
                    done = true
                  },
                  _ => throw("expected ',' or ')' in loop params")
                }
              },
              _ => throw("expected loop parameter name or ')'")
            }
          }
          let br = expect_tk(tokens, cur, "{")
          let (body, end) = parse_impl(tokens, br, mode_block)
          (ELoop(ArrayBuilder::freeze(params_b), body), end)
        },
        _ => {
          let br = expect_tk(tokens, pos + 1, "{")
          let (body, end) = parse_impl(tokens, br, mode_block)
          (EWhile(EBool(true), body), end)
        }
      },
      TYield => throw("'yield' is not supported"),
      TDeclare => throw("'declare' is not supported"),
      _ => throw("unexpected token: \{tk_name(peek(tokens, pos))}")
    }
  }
  let parse_call_arg = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {
    match peek(tokens, pos) {
      TIdent(name) => match peek(tokens, pos + 1) {
        TThinArrow => {
          // Single-param lambda: x -> body
          let (body, end) = parse_impl(tokens, pos + 2, 0);
          (EFn(_no_tp(), _no_tb(), [(name, None)], None, None, body), end)
        },
        TTilde => match peek(tokens, pos + 2) {
          TEq => {
            let (val, end) = parse_impl(tokens, pos + 3, 0);
            (ELabeledArg(name, "~", val), end)
          },
          _ => parse_impl(tokens, pos, 0)
        },
        TQuestion => match peek(tokens, pos + 2) {
          TEq => {
            let (val, end) = parse_impl(tokens, pos + 3, 0);
            (ELabeledArg(name, "?", val), end)
          },
          _ => parse_impl(tokens, pos, 0)
        },
        TEq => {
          let (val, end) = parse_impl(tokens, pos + 2, 0);
          (ELabeledArg(name, "~", val), end)
        },
        _ => parse_impl(tokens, pos, 0)
      },
      _ => parse_impl(tokens, pos, 0)
    }
  }
  let rec parse_call_args_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {
    match peek(tokens, pos) {
      TComma => {
        let (e, next) = parse_call_arg(tokens, pos + 1)
        ArrayBuilder::push(b, e)
        parse_call_args_rest(tokens, next, b)
      },
      _ => (ArrayBuilder::freeze(b), pos)
    }
  }
  let parse_postfix = (tokens: Array[Token], pos: Int, expr: Expr) -> (Expr, Int)with { Error } {
    let mut cur_expr = expr
    let mut cur_pos = pos
    let mut done = false
    while !done {
      match peek(tokens, cur_pos) {
        TLParen => match cur_expr {
          ECall(_, _) => {
            done = true
          },
          _ => match peek(tokens, cur_pos + 1) {
            TRParen => {
              cur_expr = ECall(cur_expr, empty_exprs())
              cur_pos = cur_pos + 2
            },
            _ => {
              let b = ArrayBuilder::new()
              let (f, n1) = parse_call_arg(tokens, cur_pos + 1)
              ArrayBuilder::push(b, f)
              let (args, end) = parse_call_args_rest(tokens, n1, b)
              let en = expect_tk(tokens, end, ")")
              // Desugar placeholder args: if any arg contains _, wrap in lambda
              let has_placeholder = {
                let mut hp = false
                let mut hpi = 0
                while hpi < Array::length(args) {
                  let arg = Array::get(args, hpi)
                  match arg {
                    EIdent(n) => if n == "_" { hp = true },
                    EBinOp(_, l, r) => {
                      match l { EIdent(n) => if n == "_" { hp = true }, _ => () }
                      match r { EIdent(n) => if n == "_" { hp = true }, _ => () }
                    },
                    _ => ()
                  }
                  hpi = hpi + 1
                }
                hp
              }
              if has_placeholder {
                // Wrap only placeholder-containing args in lambda
                let mut dargs = Array::slice([EUnit], 0, 0)
                let mut dai = 0
                while dai < Array::length(args) {
                  let arg = Array::get(args, dai)
                  let arg_has_ph = match arg {
                    EIdent(n) => n == "_",
                    EBinOp(_, l, r) => {
                      let lh = match l { EIdent(n) => n == "_", _ => false }
                      let rh = match r { EIdent(n) => n == "_", _ => false }
                      lh || rh
                    },
                    _ => false
                  }
                  if arg_has_ph {
                    let mut pc = 0
                    let mut params = Array::slice([("", None)], 0, 0)
                    let replaced = match arg {
                      EIdent(n) => if n == "_" {
                        let pn = "__ph0"
                        Array::push(params, (pn, None))
                        EIdent(pn)
                      } else arg,
                      EBinOp(op, l, r) => {
                        let nl = match l {
                          EIdent(n) => if n == "_" {
                            let pn = String::concat("__ph", __to_string(pc))
                            Array::push(params, (pn, None))
                            pc = pc + 1
                            EIdent(pn)
                          } else l, _ => l
                        }
                        let nr = match r {
                          EIdent(n) => if n == "_" {
                            let pn = String::concat("__ph", __to_string(pc))
                            Array::push(params, (pn, None))
                            pc = pc + 1
                            EIdent(pn)
                          } else r, _ => r
                        }
                        EBinOp(op, nl, nr)
                      },
                      _ => arg
                    }
                    Array::push(dargs, EFn(_no_tp(), _no_tb(), params, None, None, replaced))
                  } else {
                    Array::push(dargs, arg)
                  }
                  dai = dai + 1
                }
                cur_expr = ECall(cur_expr, dargs)
              } else {
                cur_expr = ECall(cur_expr, args)
              }
              cur_pos = en
            }
          }
        },
        TLBracket => {
          match peek(tokens, cur_pos + 1) {
            TColon => match peek(tokens, cur_pos + 2) {
              TRBracket => {
                // expr[:] — full copy
                cur_expr = ECall(EIdent("__slice"), [cur_expr, EInt(0), ECall(EIdent("__len"), [cur_expr])])
                cur_pos = cur_pos + 3
              },
              _ => {
                // expr[:j] — slice from 0 to j
                let (end_expr, en) = parse_impl(tokens, cur_pos + 2, 0)
                let en2 = expect_tk(tokens, en, "]")
                cur_expr = ECall(EIdent("__slice"), [cur_expr, EInt(0), end_expr])
                cur_pos = en2
              }
            },
            _ => {
              let (idx, n1) = parse_impl(tokens, cur_pos + 1, 0)
              match peek(tokens, n1) {
                TColon => match peek(tokens, n1 + 1) {
                  TRBracket => {
                    // expr[i:] — slice from i to length
                    cur_expr = ECall(EIdent("__slice"), [cur_expr, idx, ECall(EIdent("__len"), [cur_expr])])
                    cur_pos = n1 + 2
                  },
                  _ => {
                    // expr[i:j]
                    let (end_expr, en) = parse_impl(tokens, n1 + 1, 0)
                    let en2 = expect_tk(tokens, en, "]")
                    cur_expr = ECall(EIdent("__slice"), [cur_expr, idx, end_expr])
                    cur_pos = en2
                  }
                },
                _ => {
                  let en = expect_tk(tokens, n1, "]")
                  cur_expr = ECall(EIdent("__index"), [cur_expr, idx])
                  cur_pos = en
                }
              }
            }
          }
        },
        TDot => match peek(tokens, cur_pos + 1) {
          TIdent(field) => {
            cur_expr = EDot(cur_expr, field)
            cur_pos = cur_pos + 2
          },
          TInt(idx) => {
            cur_expr = EDot(cur_expr, __to_string(idx))
            cur_pos = cur_pos + 2
          },
          _ => {
            done = true
          }
        },
        _ => {
          done = true
        }
      }
    }
    (cur_expr, cur_pos)
  }
  let pipe_desugar = (lhs: Expr, rhs: Expr) -> Expr {
    match rhs {
      ECall(callee, args) => ECall(callee, Array::concat([
        lhs
      ], args)),
      _ => ECall(rhs, [
        lhs
      ])
    }
  }
  let binop_prec = (tok: Token) -> Int {
    match tok {
      TOr => 0,
      TAnd => 1,
      TPipeGt => 2,
      TEqEq => 3,
      TNeq => 3,
      TLt => 3,
      TLte => 3,
      TGt => 3,
      TGte => 3,
      TBitOr => 4,
      TBitXor => 5,
      TBitAnd => 6,
      TLShift => 7,
      TRShift => 7,
      TPlus => 8,
      TMinus => 8,
      TStar => 9,
      TSlash => 9,
      TPercent => 9,
      _ => -1
    }
  }
  let binop_op = (tok: Token) -> String with { Error } {
    match tok {
      TOr => "||",
      TAnd => "&&",
      TPipeGt => "|>",
      TEqEq => "==",
      TNeq => "!=",
      TLt => "<",
      TLte => "<=",
      TGt => ">",
      TGte => ">=",
      TBitOr => "|",
      TBitXor => "^",
      TBitAnd => "&",
      TLShift => "<<",
      TRShift => ">>",
      TPlus => "+",
      TMinus => "-",
      TStar => "*",
      TSlash => "/",
      TPercent => "%",
      _ => throw("internal parser error: not a binary operator")
    }
  }
  let rec parse_prefix = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {
    match peek(tokens, pos) {
      TMinus => {
        let (e, next) = parse_prefix(tokens, pos + 1);
        (EUnaryOp("-", e), next)
      },
      TNot => {
        let (e, next) = parse_prefix(tokens, pos + 1);
        (EUnaryOp("!", e), next)
      },
      _ => {
        let (e, next) = parse_primary(tokens, pos)
        parse_postfix(tokens, next, e)
      }
    }
  }
  let rec parse_infix_loop = (tokens: Array[Token], left: Expr, next: Int, min_prec: Int, expr_start: Int, cmp_locked: Bool) -> (Expr, Int)with { Error } {
    let tok = peek(tokens, next)
    let prec = binop_prec(tok)
    if prec < min_prec || (cmp_locked && prec == 3) {
      (left, next)
    } else {
      let op = binop_op(tok)
      if op == "|>" {
        if has_non_pipe_infix_top(tokens, expr_start, next) {
          throw("cannot mix '|>' with other infix operators without explicit parentheses")
        } else {
          0
        }
      } else {
        0
      }
      let (right0, right_next0) = parse_prefix(tokens, next + 1)
      let (right, rn) = parse_infix_loop(tokens, right0, right_next0, prec + 1, next + 1, false)
      if op == "|>" {
        if has_non_pipe_infix_top(tokens, next + 1, rn) {
          throw("cannot mix '|>' with other infix operators without explicit parentheses")
        } else {
          0
        }
      } else {
        0
      }
      let combined = if op == "|>" {
        pipe_desugar(left, right)
      } else {
        EBinOp(op, left, right)
      }
      let next_cmp_locked = if prec == 3 {
        true
      } else {
        cmp_locked
      }
      parse_infix_loop(tokens, combined, rn, min_prec, expr_start, next_cmp_locked)
    }
  }
  let rec parse_infix = (tokens: Array[Token], pos: Int, min_prec: Int, expr_start: Int) -> (Expr, Int)with { Error } {
    let (left0, next0) = parse_prefix(tokens, pos)
    let (expr, en) = parse_infix_loop(tokens, left0, next0, min_prec, expr_start, false)
    match peek(tokens, en) {
      TIdent(kw) => if kw == "is" {
        let (pat, pn) = parse_pattern(tokens, en + 1)
        (EMatch(expr, [(pat, EBool(true)), (PWild, EBool(false))]), pn)
      } else {
        (expr, en)
      },
      _ => (expr, en)
    }
  }
  let rec parse_match_rest = (tokens: Array[Token], pos: Int, scrutinee: Expr, b: ArrayBuilder[(Pat, Expr)]) -> (Expr, Int)with { Error } {
    match peek(tokens, pos) {
      TComma => match peek(tokens, pos + 1) {
        TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 2),
        _ => {
          let (pa, paa) = parse_pattern(tokens, pos + 1)
          let a2 = match peek(tokens, paa) {
            TIf => { let (_, ga) = parse_impl(tokens, paa + 1, 0); expect_tk(tokens, ga, "=>") },
            _ => expect_tk(tokens, paa, "=>")
          }
          let (ea, en) = parse_impl(tokens, a2, 0)
          ArrayBuilder::push(b, (pa, ea))
          parse_match_rest(tokens, en, scrutinee, b)
        }
      },
      TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 1),
      _ => {
        let (pa, paa) = parse_pattern(tokens, pos)
        let a2 = match peek(tokens, paa) {
          TIf => { let (_, ga) = parse_impl(tokens, paa + 1, 0); expect_tk(tokens, ga, "=>") },
          _ => expect_tk(tokens, paa, "=>")
        }
        let (ea, en) = parse_impl(tokens, a2, 0)
        ArrayBuilder::push(b, (pa, ea))
        parse_match_rest(tokens, en, scrutinee, b)
      }
    }
  }
  let rec parse_handle_rest = (tokens: Array[Token], pos: Int, body: Expr, b: ArrayBuilder[(Pat, Expr)]) -> (Expr, Int)with { Error } {
    match peek(tokens, pos) {
      TComma => match peek(tokens, pos + 1) {
        TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),
        _ => {
          let (pa, paa) = parse_pattern(tokens, pos + 1)
          let a2 = expect_tk(tokens, paa, "=>")
          let (ea, en) = parse_impl(tokens, a2, 0)
          ArrayBuilder::push(b, (pa, ea))
          parse_handle_rest(tokens, en, body, b)
        }
      },
      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),
      _ => {
        let (pa, paa) = parse_pattern(tokens, pos)
        let a2 = expect_tk(tokens, paa, "=>")
        let (ea, en) = parse_impl(tokens, a2, 0)
        ArrayBuilder::push(b, (pa, ea))
        parse_handle_rest(tokens, en, body, b)
      }
    }
  }
  let rec parse_block_after_expr = (tokens: Array[Token], pos: Int, e: Expr) -> (Expr, Int)with { Error } {
    match peek(tokens, pos) {
      TRBrace => (e, pos + 1),
      TSemicolon => {
        let (rest, end) = parse_impl(tokens, pos + 1, mode_block);
        (ESeq(e, rest), end)
      },
      TEq => match e {
        EIdent(name) => {
          let (val, vn) = parse_impl(tokens, pos + 1, 0)
          let a = skip_semi(tokens, vn)
          let (rest, end) = parse_impl(tokens, a, mode_block);
          (EAssign(name, val, rest), end)
        },
        _ => throw("invalid assignment target")
      },
      TPlusEq => match e {
        EIdent(name) => {
          let (val, vn) = parse_impl(tokens, pos + 1, 0)
          let a = skip_semi(tokens, vn)
          let (rest, end) = parse_impl(tokens, a, mode_block);
          (EAssignOp(name, "+", val, rest), end)
        },
        _ => throw("invalid assignment target")
      },
      TMinusEq => match e {
        EIdent(name) => {
          let (val, vn) = parse_impl(tokens, pos + 1, 0)
          let a = skip_semi(tokens, vn)
          let (rest, end) = parse_impl(tokens, a, mode_block);
          (EAssignOp(name, "-", val, rest), end)
        },
        _ => throw("invalid assignment target")
      },
      TStarEq => match e {
        EIdent(name) => {
          let (val, vn) = parse_impl(tokens, pos + 1, 0)
          let a = skip_semi(tokens, vn)
          let (rest, end) = parse_impl(tokens, a, mode_block);
          (EAssignOp(name, "*", val, rest), end)
        },
        _ => throw("invalid assignment target")
      },
      TSlashEq => match e {
        EIdent(name) => {
          let (val, vn) = parse_impl(tokens, pos + 1, 0)
          let a = skip_semi(tokens, vn)
          let (rest, end) = parse_impl(tokens, a, mode_block);
          (EAssignOp(name, "/", val, rest), end)
        },
        _ => throw("invalid assignment target")
      },
      TPercentEq => match e {
        EIdent(name) => {
          let (val, vn) = parse_impl(tokens, pos + 1, 0)
          let a = skip_semi(tokens, vn)
          let (rest, end) = parse_impl(tokens, a, mode_block);
          (EAssignOp(name, "%", val, rest), end)
        },
        _ => throw("invalid assignment target")
      },
      _ => {
        let (rest, end) = parse_impl(tokens, pos, mode_block)
        if end <= pos {
          throw("internal parser error: block continuation did not advance")
        } else (ESeq(e, rest), end)
      }
    }
  }
  if mode == mode_match {
    let (scrutinee, sn) = parse_impl(tokens, pos, 0)
    let br = expect_tk(tokens, sn, "{")
    match peek(tokens, br) {
      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),
      _ => {
        let b = ArrayBuilder::new()
        let (fp, fa) = parse_pattern(tokens, br)
        // Check for guard: pat if cond => body
        let aa = match peek(tokens, fa) {
          TIf => {
            let (guard_cond, ga) = parse_impl(tokens, fa + 1, 0)
            // Guard is ignored for now (always true) — just skip to =>
            expect_tk(tokens, ga, "=>")
          },
          _ => expect_tk(tokens, fa, "=>")
        }
        let (fe, fn1) = parse_impl(tokens, aa, 0)
        ArrayBuilder::push(b, (fp, fe))
        parse_match_rest(tokens, fn1, scrutinee, b)
      }
    }
  } else if mode == mode_if {
    let (cond, cn) = parse_impl(tokens, pos, 0)
    let mut is_mode = false
    let mut is_pat_val = PWild
    let mut brace_pos = cn
    match peek(tokens, cn) {
      TIdent(kw) => if kw == "is" {
        let (pat, pn) = parse_pattern(tokens, cn + 1)
        is_mode = true
        is_pat_val = pat
        brace_pos = pn
      },
      _ => ()
    }
    let br = expect_tk(tokens, brace_pos, "{")
    let (then_e, tn) = parse_impl(tokens, br, mode_block)
    let (else_e, end_pos) = match peek(tokens, tn) {
      TElse => match peek(tokens, tn + 1) {
        TIf => parse_impl(tokens, tn + 2, mode_if),
        TLBrace => parse_impl(tokens, tn + 2, mode_block),
        _ => parse_impl(tokens, tn + 1, 0)
      },
      _ => (EUnit, tn)
    }
    if is_mode {
      (EMatch(cond, [(is_pat_val, then_e), (PWild, else_e)]), end_pos)
    } else {
      (EIf(cond, then_e, else_e), end_pos)
    }
  } else if mode == mode_while {
    let (cond, cn) = parse_impl(tokens, pos, 0)
    let br = expect_tk(tokens, cn, "{")
    let (body, end) = parse_impl(tokens, br, mode_block);
    (EWhile(cond, body), end)
  } else if mode == mode_handle {
    let br = expect_tk(tokens, pos, "{")
    let (body, bn) = parse_impl(tokens, br, mode_block)
    let hb = expect_tk(tokens, bn, "{")
    match peek(tokens, hb) {
      TRBrace => (EHandle(body, empty_arms()), hb + 1),
      _ => {
        let b = ArrayBuilder::new()
        let (fp, fa) = parse_pattern(tokens, hb)
        let aa = expect_tk(tokens, fa, "=>")
        let (fe, fn1) = parse_impl(tokens, aa, 0)
        ArrayBuilder::push(b, (fp, fe))
        parse_handle_rest(tokens, fn1, body, b)
      }
    }
  } else if mode == mode_for_in {
    match peek(tokens, pos) {
      TIdent(first_name) => {
        let (value_name, index_name, name_end) = match peek(tokens, pos + 1) {
          TComma => match peek(tokens, pos + 2) {
            TIdent(second_name) => (second_name, Some(first_name), pos + 3),
            _ => throw("expected value binding name after ','")
          },
          _ => (first_name, None, pos + 1)
        }
        let ip = expect_tk(tokens, name_end, "in")
        let (iterable, inext) = parse_impl(tokens, ip, 0)
        let bb = expect_tk(tokens, inext, "{")
        let (body, end) = parse_impl(tokens, bb, mode_block);
        (EForIn(value_name, index_name, iterable, body), end)
      },
      _ => throw("expected identifier after 'for'")
    }
  } else if mode == mode_block {
    match peek(tokens, pos) {
      TRBrace => (EUnit, pos + 1),
      TEnum => {
        // Block-local enum: desugar constructors to ELet bindings
        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, pos + 1, false)
        let (rest, rend) = parse_impl(tokens, enum_end, mode_block)
        // Extract variants from SEnum and create ELet chain
        match enum_stmt {
          SEnum(_, _, variants) => {
            let mut result = rest
            let mut vi = Array::length(variants) - 1
            while vi >= 0 {
              let (vname, vfields) = Array::get(variants, vi)
              if Array::length(vfields) == 0 {
                // 0-arg ctor: bind as tagged int (vi << 2)
                result = ELet(vname, EInt(vi), result)
              }
              vi = vi - 1
            }
            (result, rend)
          },
          _ => (rest, rend)
        }
      },
      TStruct => {
        // Block-local struct: parse and skip, continue with rest of block
        let (_, struct_end) = parse_struct_stmt(tokens, pos + 1, false)
        parse_impl(tokens, struct_end, mode_block)
      },
      TLet => {
        let next = pos + 1
        match peek(tokens, next) {
          TRec => match peek(tokens, next + 1) {
            TIdent(name) => {
              let eq_pos_r = match peek(tokens, next + 2) {
                TColon => {
                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)
                  tp
                },
                _ => next + 2
              }
              let eq = expect_tk(tokens, eq_pos_r, "=")
              let (val, vn) = parse_impl(tokens, eq, 0)
              let a = skip_semi(tokens, vn)
              let (body, end) = parse_impl(tokens, a, mode_block)
              if end <= a {
                throw("internal parser error: block let-rec parser did not advance")
              } else (ELetRec(name, val, body), end)
            },
            _ => throw("expected identifier after 'let rec'")
          },
          TMut => match peek(tokens, next + 1) {
            TIdent(name) => {
              let eq_pos_m = match peek(tokens, next + 2) {
                TColon => {
                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)
                  tp
                },
                _ => next + 2
              }
              let eq = expect_tk(tokens, eq_pos_m, "=")
              let (val, vn) = parse_impl(tokens, eq, 0)
              let a = skip_semi(tokens, vn)
              let (body, end) = parse_impl(tokens, a, mode_block)
              if end <= a {
                throw("internal parser error: block let-mut parser did not advance")
              } else (ELetMut(name, val, body), end)
            },
            _ => throw("expected identifier after 'let mut'")
          },
          TIdent(name) => {
            // Record destructuring: let record { x, y: (a, b) } = expr
            // Desugar to __rec_field access chain with nested tuple desugar
            if name == "record" && (match peek(tokens, next + 1) { TLBrace => true, _ => false }) {
              let (pat, pn) = parse_pattern(tokens, next)
              let eq = expect_tk(tokens, pn, "=")
              let (val, vn) = parse_impl(tokens, eq, 0)
              let a = skip_semi(tokens, vn)
              let (body, end) = parse_impl(tokens, a, mode_block)
              // Extract field patterns from PTuple
              let val_name = "__rec_destr"
              let mut desugar = body
              match pat {
                PTuple(field_pats) => {
                  let mut di = Array::length(field_pats) - 1
                  while di >= 0 {
                    let fp = Array::get(field_pats, di)
                    match fp {
                      PBind(bname) => {
                        desugar = ELet(bname, ECall(EIdent("__rec_field"), [EIdent(val_name), EInt(di)]), desugar)
                      },
                      PTuple(sub_pats) => {
                        // Nested tuple: let __sub = __rec_field(val, di); let (a, b) = __sub
                        let sub_name = String::concat("__rec_sub_", __to_string(di))
                        let mut si = Array::length(sub_pats) - 1
                        while si >= 0 {
                          match Array::get(sub_pats, si) {
                            PBind(sname) => {
                              desugar = ELet(sname, EDot(EIdent(sub_name), __to_string(si)), desugar)
                            },
                            _ => ()
                          }
                          si = si - 1
                        }
                        desugar = ELet(sub_name, ECall(EIdent("__rec_field"), [EIdent(val_name), EInt(di)]), desugar)
                      },
                      _ => ()
                    }
                    di = di - 1
                  }
                },
                _ => ()
              }
              desugar = ELet(val_name, val, desugar)
              (desugar, end)
            }
            // Check if this is a constructor pattern: let Some(x) = expr
            else if (match peek(tokens, next + 1) { TLParen => true, _ => false }) {
              let (pat, pn) = parse_pattern(tokens, next)
              let eq = expect_tk(tokens, pn, "=")
              let (val, vn) = parse_impl(tokens, eq, 0)
              let a = skip_semi(tokens, vn)
              let (body, end) = parse_impl(tokens, a, mode_block)
              if end <= a {
                throw("internal parser error: block let-ctor-pat parser did not advance")
              } else {
                (EMatch(val, [(pat, body)]), end)
              }
            } else {
              let eq_pos = match peek(tokens, next + 1) {
                TColon => {
                  let (_, tp) = parse_type_impl(tokens, next + 2, 0)
                  tp
                },
                _ => next + 1
              }
              let eq = expect_tk(tokens, eq_pos, "=")
              let (val, vn) = parse_impl(tokens, eq, 0)
              let a = skip_semi(tokens, vn)
              let (body, end) = parse_impl(tokens, a, mode_block)
              if end <= a {
                throw("internal parser error: block let parser did not advance")
              } else (ELet(name, val, body), end)
            }
          },
          TLParen => {
            let (pat, pn) = parse_pattern(tokens, next)
            let eq = expect_tk(tokens, pn, "=")
            let (val, vn) = parse_impl(tokens, eq, 0)
            let a = skip_semi(tokens, vn)
            let (body, end) = parse_impl(tokens, a, mode_block)
            if end <= a {
              throw("internal parser error: block let-pat parser did not advance")
            } else {
              // Desugar tuple pattern to ELet + EDot chain
              let desugar_tuple_pat = (base_name: String, base_expr: Expr, tpats: Array[Pat], cont: Expr) -> Expr {
                let mut result = cont
                let mut ti = Array::length(tpats) - 1
                while ti >= 0 {
                  let tp = Array::get(tpats, ti)
                  match tp {
                    PBind(bname) => {
                      result = ELet(bname, EDot(EIdent(base_name), __to_string(ti)), result)
                    },
                    PTuple(sub_pats) => {
                      let sub_name = String::concat(base_name, String::concat("_", __to_string(ti)))
                      // Recursively desugar nested tuple
                      let mut si = Array::length(sub_pats) - 1
                      while si >= 0 {
                        match Array::get(sub_pats, si) {
                          PBind(sname) => {
                            result = ELet(sname, EDot(EIdent(sub_name), __to_string(si)), result)
                          },
                          PTuple(deep_pats) => {
                            let deep_name = String::concat(sub_name, String::concat("_", __to_string(si)))
                            let mut di2 = Array::length(deep_pats) - 1
                            while di2 >= 0 {
                              match Array::get(deep_pats, di2) {
                                PBind(dname) => {
                                  result = ELet(dname, EDot(EIdent(deep_name), __to_string(di2)), result)
                                },
                                _ => ()
                              }
                              di2 = di2 - 1
                            }
                            result = ELet(deep_name, EDot(EIdent(sub_name), __to_string(si)), result)
                          },
                          _ => ()
                        }
                        si = si - 1
                      }
                      result = ELet(sub_name, EDot(EIdent(base_name), __to_string(ti)), result)
                    },
                    _ => ()
                  }
                  ti = ti - 1
                }
                ELet(base_name, base_expr, result)
              }
              match pat {
                PTuple(tpats) => (desugar_tuple_pat("__tup", val, tpats, body), end),
                _ => (EMatch(val, [(pat, body)]), end)
              }
            }
          },
          _ => throw("expected identifier after 'let'")
        }
      },
      _ => {
        let (e, next) = parse_impl(tokens, pos, 0)
        if next <= pos {
          throw("internal parser error: block expr parser did not advance")
        } else parse_block_after_expr(tokens, next, e)
      }
    }
  } else if mode >= 0 && mode <= 10 {
    parse_infix(tokens, pos, mode, pos)
  } else {
    throw("internal parser error: unknown parse mode")
  }
}

export let parse = (tokens: Array[Token]) -> Expr with { Error } {
  let (e, next) = parse_impl(tokens, 0, 0)
  match peek(tokens, next) {
    TEof => e,
    _ => throw("unexpected after expression: \{tk_name(peek(tokens, next))}")
  }
}

export let parse_ok = (tokens: Array[Token]) -> Bool {
  handle {
    let _ = parse(tokens)
    true
  } {
    Error(_) => false
  }
}

export let parse_expr = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {
  parse_impl(tokens, pos, 0)
}

let parse_let_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TRec => {
      let (name, name_next) = parse_binding_name(tokens, pos + 1)
      let (ty_opt, eq_pos) = match peek(tokens, name_next) {
        TColon => {
          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0);
          (Some(ty), tp)
        },
        _ => (None, name_next)
      }
      let ep = expect_tk(tokens, eq_pos, "=")
      // Skip generic type params
      let val_start_r = match peek(tokens, ep) {
        TLBracket => match peek(tokens, ep + 1) {
          TIdent(_) => {
            let mg = match peek(tokens, ep + 2) {
              TRBracket => match peek(tokens, ep + 3) { TLParen => true, _ => false },
              TColon => true, TComma => true, _ => false
            }
            if mg {
              let mut sp = ep + 1; let mut sd = 1
              while sd > 0 { match peek(tokens, sp) { TLBracket => { sd = sd + 1 }, TRBracket => { sd = sd - 1 }, _ => () }; sp = sp + 1 }
              sp
            } else ep
          }, _ => ep
        }, _ => ep
      }
      let (val, vn) = parse_impl(tokens, val_start_r, 0);
      (SLet(exported, true, name, ty_opt, val), vn)
    },
    TMut => match peek(tokens, pos + 1) {
      TIdent(name) => {
        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            (Some(ty), tp)
          },
          _ => (None, pos + 2)
        }
        let ep = expect_tk(tokens, eq_pos, "=")
        let (val, vn) = parse_impl(tokens, ep, 0);
        (SLetMut(name, ty_opt, val), vn)
      },
      _ => throw("expected name after 'let mut'")
    },
    TLParen => {
      // let (a, b) = expr  →  SLetPat(PTuple([PBind("a"), PBind("b")]), expr)
      let (pat, pat_next) = parse_pattern(tokens, pos)
      let ep = expect_tk(tokens, pat_next, "=")
      let (val, vn) = parse_impl(tokens, ep, 0);
      (SLetPat(pat, val), vn)
    },
    TIdent(_) => {
      let (name, name_next) = parse_binding_name(tokens, pos)
      let (ty_opt, eq_pos) = match peek(tokens, name_next) {
        TColon => {
          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0);
          (Some(ty), tp)
        },
        _ => (None, name_next)
      }
      let ep = expect_tk(tokens, eq_pos, "=")
      // Skip generic type params [T] or [K: Show] before value expression
      let val_start = match peek(tokens, ep) {
        TLBracket => match peek(tokens, ep + 1) {
          TIdent(_) => {
            // Check if [Ident](... or [Ident:... pattern
            let maybe_gen = match peek(tokens, ep + 2) {
              TRBracket => match peek(tokens, ep + 3) { TLParen => true, _ => false },
              TColon => true,
              TComma => true,
              _ => false
            }
            if maybe_gen {
              let mut sp = ep + 1
              let mut sd = 1
              while sd > 0 {
                match peek(tokens, sp) {
                  TLBracket => { sd = sd + 1 },
                  TRBracket => { sd = sd - 1 },
                  _ => ()
                }
                sp = sp + 1
              }
              sp
            } else ep
          },
          _ => ep
        },
        _ => ep
      }
      let (val, vn) = parse_impl(tokens, val_start, 0);
      (SLet(exported, false, name, ty_opt, val), vn)
    },
    _ => throw("expected name after 'let'")
  }
}

let parse_test_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, br, mode_block);
      (STest(name, body), end)
    },
    _ => throw("expected test name string")
  }
}

let parse_bench_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, br, mode_block);
      (SBench(name, body), end)
    },
    _ => throw("expected bench name string")
  }
}

let rec parse_export_names_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int)with { Error } {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        parse_export_names_rest(tokens, pos + 2, b)
      },
      _ => throw("expected name in export list")
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in export list")
  }
}

let rec parse_import_items_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int)with { Error } {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (item, next) = parse_import_item(tokens, pos + 1)
        ArrayBuilder::push(b, item)
        parse_import_items_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in import list")
  }
}

let parse_import_items = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int)with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_import_items(), pos + 1),
    _ => {
      let (first, next) = parse_import_item(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_import_items_rest(tokens, next, b)
    }
  }
}

let parse_import_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  // Check for alias import: import @alias { items }
  match peek(tokens, pos) {
    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {
      // import @alias { items }
      let br = expect_tk(tokens, pos + 1, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(name, items), end)
    } else {
      let (path, bp) = collect_import_path(tokens, pos, "")
      // Check for alias declaration: import path @alias
      match peek(tokens, bp) {
        TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {
          let alias_str = String::substring(alias_name, 1, String::length(alias_name))
          (SAliasDecl(alias_str, path), bp + 1)
        } else {
          let br = expect_tk(tokens, bp, "{")
          let (items, end) = parse_import_items(tokens, br);
          (SImport(path, items), end)
        },
        _ => {
          let br = expect_tk(tokens, bp, "{")
          let (items, end) = parse_import_items(tokens, br);
          (SImport(path, items), end)
        }
      }
    },
    _ => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(path, items), end)
    }
  }
}

let parse_impl_stmt_dispatch = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  parse_impl_stmt(tokens, pos)
}

let rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (field, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        parse_struct_fields_rest(tokens, next, b)
      }
    },
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (field, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        parse_struct_fields_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';', ',' or '}' in struct")
  }
}

let parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_fields(), pos + 1),
    _ => {
      let (first, next) = parse_struct_field(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_struct_fields_rest(tokens, next, b)
    }
  }
}

let parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (fields, end) = parse_struct_fields(tokens, br);
      (SStruct(exported, name, fields), end)
    },
    _ => throw("expected struct name")
  }
}

let parse_export_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TLet => parse_let_stmt(tokens, pos + 1, true),
    TEnum => parse_enum_stmt(tokens, pos + 1, true),
    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),
    TStruct => parse_struct_stmt(tokens, pos + 1, true),
    TType => parse_type_alias_stmt(tokens, pos + 1, true),
    TTrait => parse_trait_stmt(tokens, pos + 1, true),
    TOpen => match peek(tokens, pos + 1) {
      TTrait => parse_trait_stmt(tokens, pos + 2, true),
      _ => throw("expected 'trait' after 'open'")
    },
    TLBrace => match peek(tokens, pos + 1) {
      TRBrace => (SExport(empty_names()), pos + 2),
      TIdent(name) => {
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, name)
        let (names, end) = parse_export_names_rest(tokens, pos + 2, b);
        (SExport(names), end)
      },
      _ => throw("expected name in export list")
    },
    TDot => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SReExport(path, items), end)
    },
    _ => throw("unexpected after 'export': \{tk_name(peek(tokens, pos))}")
  }
}

let parse_percent_symbol_name = (tokens: Array[Token], pos: Int, label: String) -> (String, Int)with { Error } {
  let pp = expect_tk(tokens, pos, "%")
  match peek(tokens, pp) {
    TIdent(name) => ("%\{name}", pp + 1),
    _ => throw("expected \{label} after '%'")
  }
}

let parse_extern_let_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  let lp = expect_tk(tokens, pos, "let")
  let (name, np) = parse_percent_symbol_name(tokens, lp, "extern symbol name")
  let cp = expect_tk(tokens, np, ":")
  let (ty, end) = parse_type_impl(tokens, cp, 0);
  (SExternLet(name, ty), end)
}

export let rec parse_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  let rec parse_module_body = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Stmt]) -> (Array[Stmt], Int)with { Error } {
    match peek(tokens, pos) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 1),
      _ => {
        let (stmt, next) = parse_stmt(tokens, pos)
        ArrayBuilder::push(b, stmt)
        parse_module_body(tokens, next, b)
      }
    }
  }
  let head = peek(tokens, pos)
  match head {
    TLet => parse_let_stmt(tokens, pos + 1, false),
    TExport => match peek(tokens, pos + 1) {
      TModule => match peek(tokens, pos + 2) {
        TIdent(name) => {
          let br = expect_tk(tokens, pos + 3, "{")
          {
            let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());
            (SModule(true, name, stmts), end)
          }
        },
        _ => throw("expected module name")
      },
      _ => parse_export_stmt(tokens, pos + 1)
    },
    TModule => match peek(tokens, pos + 1) {
      TIdent(name) => {
        let br = expect_tk(tokens, pos + 2, "{")
        {
          let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());
          (SModule(false, name, stmts), end)
        }
      },
      _ => throw("expected module name")
    },
    TEnum => parse_enum_stmt(tokens, pos + 1, false),
    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),
    TStruct => parse_struct_stmt(tokens, pos + 1, false),
    TType => parse_type_alias_stmt(tokens, pos + 1, false),
    TTrait => parse_trait_stmt(tokens, pos + 1, false),
    TTest => parse_test_stmt(tokens, pos + 1),
    TBench => parse_bench_stmt(tokens, pos + 1),
    TImport => parse_import_stmt(tokens, pos + 1),
    TIdent(name) => if name == "extern" {
      parse_extern_let_stmt(tokens, pos + 1)
    } else if name == "use" {
      throw("'use' syntax is removed; use 'import <module-ref> { ... }'")
    } else {
      // Parse expression, then check for trailing assign (x = val)
      let (e, next) = parse_impl(tokens, pos, 0)
      match peek(tokens, next) {
        TEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssign(name, val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TPlusEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssignOp(name, "+", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TMinusEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssignOp(name, "-", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TStarEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssignOp(name, "*", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TSlashEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssignOp(name, "/", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        _ => (SExpr(e), next)
      }
    },
    _ => {
      let (e, next) = parse_impl(tokens, pos, 0);
      (SExpr(e), next)
    }
  }
}

export let parse_program = (tokens: Array[Token]) -> Array[Stmt] with { Error } {
  let b = ArrayBuilder::new()
  let mut pos = 0
  while !is_tk(peek(tokens, pos), "eof") {
    let (stmt, next) = if is_tk(peek(tokens, pos), "impl") {
      parse_impl_stmt_dispatch(tokens, pos + 1)
    } else {
      parse_stmt(tokens, pos)
    }
    ArrayBuilder::push(b, stmt)
    pos = next
  }
  ArrayBuilder::freeze(b)
}

//# Misc

export {
  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_impl, parse_stmt, parse_type, parse_program
}
