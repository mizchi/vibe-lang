//# Imports

import .. / core {
  Expr, Pat, Stmt, TypeExpr
}

import ./parser_base.vibe {
  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_pattern, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, peek, tk_name
}

import ./parser_expr_core.vibe {
  parse_infix
}

import ./parser_expr_dispatch.vibe {
  parse_impl_dispatch
}

import ./token.vibe {
  Token
}

//# Functions

export let parse_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (Expr, Int)with { Error } {
  let rec parse_recur = (rtoks: Array[Token], rpos: Int, rmode: Int) -> (Expr, Int)with { Error } {
    if rmode >= 0 && rmode <= 10 {
      parse_infix(rtoks, rpos, rmode, rpos, parse_recur)
    } else {
      parse_impl_dispatch(rtoks, rpos, rmode, parse_recur)
    }
  }
  parse_recur(tokens, pos, mode)
}

export let parse = (tokens: Array[Token]) -> Expr with { Error } {
  let (e, next) = parse_impl(tokens, 0, 0)
  match peek(tokens, next) {
    TEof => e,
    _ => throw("unexpected after expression: \{tk_name(peek(tokens, next))}")
  }
}

export let parse_ok = (tokens: Array[Token]) -> Bool {
  handle {
    let _ = parse(tokens)
    true
  } with Error {
    Throw(_) => false
  }
}

export let parse_expr = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {
  parse_impl(tokens, pos, 0)
}

let skip_generic_value_start = (tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens, pos) {
    TLBracket => match peek(tokens, pos + 1) {
      TIdent(_) => {
        let maybe_generic = match peek(tokens, pos + 2) {
          TRBracket => match peek(tokens, pos + 3) {
            TLParen => true,
            _ => false
          },
          TColon => true,
          TComma => true,
          _ => false
        }
        if maybe_generic {
          let mut scan_pos = pos + 1
          let mut depth = 1
          while depth > 0 {
            match peek(tokens, scan_pos) {
              TLBracket => {
                depth = depth + 1
              },
              TRBracket => {
                depth = depth - 1
              },
              _ => ()
            }
            scan_pos = scan_pos + 1
          }
          scan_pos
        } else {
          pos
        }
      },
      _ => pos
    },
    _ => pos
  }
}

let parse_let_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TRec => {
      let (name, name_next) = parse_binding_name(tokens, pos + 1)
      let (ty_opt, eq_pos) = match peek(tokens, name_next) {
        TColon => {
          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0)
          (Some(ty), tp)
        },
        _ => (None, name_next)
      }
      let ep = expect_tk(tokens, eq_pos, "=")
      let val_start_r = skip_generic_value_start(tokens, ep)
      let val_pair = parse_impl(tokens, val_start_r, 0)
      let val = val_pair.0
      let val_next = val_pair.1
      (SLet(exported, true, name, ty_opt, val), val_next)
    },
    TMut => match peek(tokens, pos + 1) {
      TIdent(name) => {
        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)
            (Some(ty), tp)
          },
          _ => (None, pos + 2)
        }
        let ep = expect_tk(tokens, eq_pos, "=")
        let val_pair = parse_impl(tokens, ep, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        (SLetMut(name, ty_opt, val), val_next)
      },
      _ => throw("expected name after 'let mut'")
    },
    TLParen => {
      let (pat, pat_next) = parse_pattern(tokens, pos)
      let ep = expect_tk(tokens, pat_next, "=")
      let val_pair = parse_impl(tokens, ep, 0)
      let val = val_pair.0
      let val_next = val_pair.1
      (SLetPat(pat, val), val_next)
    },
    TIdent(_name0) => {
      let (name, name_next) = parse_binding_name(tokens, pos)
      let (ty_opt, eq_pos) = match peek(tokens, name_next) {
        TColon => {
          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0)
          (Some(ty), tp)
        },
        _ => (None, name_next)
      }
      let ep = expect_tk(tokens, eq_pos, "=")
      let val_start = skip_generic_value_start(tokens, ep)
      let val_pair = parse_impl(tokens, val_start, 0)
      let val = val_pair.0
      let val_next = val_pair.1
      (SLet(exported, false, name, ty_opt, val), val_next)
    },
    _ => throw("expected name after 'let'")
  }
}

