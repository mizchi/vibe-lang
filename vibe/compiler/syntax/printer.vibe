//# Imports

import ../core {
  Expr, Pat, Stmt, TypeExpr, __to_string
}

import ./float_format.vibe {
  double_to_string_compiler
}

//# Functions

let join = (arr: Array[String], sep: String) -> String {
  let len = Array::length(arr)
  if len == 0 {
    ""
  } else {
    let b = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      if i > 0 {
        ArrayBuilder::push(b, sep)
      }
      ArrayBuilder::push(b, Array::get(arr, i))
      i = i + 1
    }
    String::join(ArrayBuilder::freeze(b), "")
  }
}

let escape_string = (s: String) -> String {
  let len = String::length(s)
  let b = ArrayBuilder::new()
  let push_chunk = (start: Int, end: Int) -> Unit {
    if end > start {
      ArrayBuilder::push(b, String::substring(s, start, end))
    }
  }
  let mut i = 0
  let mut start = 0
  while i < len {
    let c = String::char_code_at(s, i)
    if c == '"' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\\"")
      i = i + 1
      start = i
    } else if c == '\\' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\\\")
      i = i + 1
      start = i
    } else if c == '\n' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\n")
      i = i + 1
      start = i
    } else if c == '\t' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\t")
      i = i + 1
      start = i
    } else if c == 13 {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\r")
      i = i + 1
      start = i
    } else if c == 0 {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\0")
      i = i + 1
      start = i
    } else {
      i = i + 1
    }
  }
  push_chunk(start, len)
  String::join(ArrayBuilder::freeze(b), "")
}

export let rec print_pat = (p: Pat) -> String {
  match p {
    PWild => "_",
    PBind(name) => name,
    PInt(n) => __to_string(n),
    PString(s) => "\"\{escape_string(s)}\"",
    PBool(b) => if b {
      "true"
    } else "false",
    PCtor(name, args) => if Array::length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        print_pat(arg)
      }
      "\{name}(\{join(parts, ", ")})"
    },
    PTuple(elems) => {
      let parts = for elem in elems {
        print_pat(elem)
      }
      "(\{join(parts, ", ")})"
    },
    POr(left, right) => "\{print_pat(left)} | \{print_pat(right)}"
  }
}

let map_to_strings = (exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {
  for expr in exprs {
    f(expr)
  }
}

export let rec print_type_expr = (ty: TypeExpr) -> String {
  match ty {
    TyName(name) => name,
    TyUnit => "()",
    TyApp(name, args) => {
      let parts = for arg in args {
        print_type_expr(arg)
      }
      "\{name}[\{join(parts, ", ")}]"
    },
    TyFn(params, ret) => {
      let parts = for param in params {
        print_type_expr(param)
      }
      "(\{join(parts, ", ")}) -> \{print_type_expr(ret)}"
    },
    TyTuple(elems) => {
      let parts = for elem in elems {
        print_type_expr(elem)
      }
      "(\{join(parts, ", ")})"
    }
  }
}

let print_ctor = (ctor: (String, Array[TypeExpr])) -> String {
  let (name, args) = ctor
  if eq(Array::length(args), 0) {
    name
  }
  else {
    let parts = for arg in args {
      print_type_expr(arg)
    }
    "\{name}(\{join(parts, ", ")})"
  }
}

export let rec print_expr = (e: Expr) -> String {
  match e {
    EInt(n) => __to_string(n),
    EFloat(n) => double_to_string_compiler(n),
    EString(s) => "\"\{escape_string(s)}\"",
    EBool(b) => if b {
      "true"
    } else "false",
    EIdent(name) => name,
    EUnit => "()",
    ETuple(elems) => "(\{join(map_to_strings(elems, print_expr), ", ")})",
    EArray(elems) => "[\{join(map_to_strings(elems, print_expr), ", ")}]",
    ERecord(fields) => {
      let parts = for field in fields {
        let (name, val) = field
        "\{name}: \{print_expr(val)}"
      }
      "{ \{join(parts, ", ")} }"
    },
    EIf(cond, then_e, else_e) => match else_e {
      EUnit => "if \{print_expr(cond)} { \{print_expr(then_e)} }",
      _ => "if \{print_expr(cond)} { \{print_expr(then_e)} } else { \{print_expr(else_e)} }"
    },
    ELet(name, val, body) => "{ let \{name} = \{print_expr(val)}; \{print_expr(body)} }",
    ELetRec(name, val, body) => "{ let rec \{name} = \{print_expr(val)}; \{print_expr(body)} }",
    ELetMut(name, val, body) => "{ let mut \{name} = \{print_expr(val)}; \{print_expr(body)} }",
    EAssign(name, val, body) => "{ \{name} = \{print_expr(val)}; \{print_expr(body)} }",
    EAssignOp(name, op, val, body) => "{ \{name} \{op}= \{print_expr(val)}; \{print_expr(body)} }",
    ESeq(a, b) => "{ \{print_expr(a)}; \{print_expr(b)} }",
    EMatch(scrutinee, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        "\{print_pat(pat)} => \{print_expr(expr)}"
      }
      "match \{print_expr(scrutinee)} { \{join(parts, ", ")} }"
    },
    EHandle(body, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        "\{print_pat(pat)} => \{print_expr(expr)}"
      }
      "handle { \{print_expr(body)} } { \{join(parts, ", ")} }"
    },
    EWhile(cond, body) => "while \{print_expr(cond)} { \{print_expr(body)} }",
    ELoop(params, body) => {
      let parts = for param in params {
        let (name, init) = param
        "\{name} = \{print_expr(init)}"
      }
      "loop (\{join(parts, ", ")}) { \{print_expr(body)} }"
    },
    EForIn(value_name, index_name, iterable, body) => {
      let binding = match index_name {
        Some(index_name) => "\{index_name}, \{value_name}",
        None => value_name
      }
      "for \{binding} in \{print_expr(iterable)} { \{print_expr(body)} }"
    },
    ECall(callee, args) => "\{print_expr(callee)}(\{join(map_to_strings(args, print_expr), ", ")})",
    EBinOp(op, left, right) => "(\{print_expr(left)} \{op} \{print_expr(right)})",
    EUnaryOp(op, expr) => "(\{op}\{print_expr(expr)})",
    EFn(_, _, params, ret_ty, effect, body) => {
      let parts = for param in params {
        let (name, ty_opt) = param
        match ty_opt {
          Some(ty) => "\{name}: \{print_type_expr(ty)}",
          None => name
        }
      }
      let ret_str = match ret_ty {
        Some(rt) => {
          let eff_str = match effect {
            Some(e) => " with {\{e}}",
            None => ""
          }
          ") -> \{print_type_expr(rt)}\{eff_str} { \{print_expr(body)} }"
        },
        None => ") -> \{print_expr(body)}"
      }
      "(\{join(parts, ", ")}\{ret_str}"
    },
    EDot(expr, field) => "\{print_expr(expr)}.\{field}",
    EThrow(e) => "throw(\{print_expr(e)})",
    EBreak(opt) => match opt {
      None => "break",
      Some(v) => "break \{print_expr(v)}"
    },
    EContinue(args) => if eq(Array::length(args), 0) {
      "continue"
    } else "continue(\{join(map_to_strings(args, print_expr), ", ")})",
    ELabeledArg(name, _modifier, val) => "\{name}=\{print_expr(val)}",
    EMap(fields) => if eq(Array::length(fields), 0) {
      "map {}"
    } else {
      let parts = for field in fields {
        let (k, v) = field
        "\{k}: \{print_expr(v)}"
      }
      "map { \{join(parts, ", ")} }"
    }
    ,
    ESpread(inner) => "...\{print_expr(inner)}",
    EStringInterp(parts) => "\"\{join(parts, "")}\""
  }
}

let print_ctor_list = (ctors: Array[(String, Array[TypeExpr])]) -> String {
  let parts = for ctor in ctors {
    print_ctor(ctor)
  }
  join(parts, "; ")
}

export let rec print_stmt = (s: Stmt) -> String {
  let prefix = (exported: Bool) -> String {
    if exported {
      "export "
    } else ""
  }
  match s {
    SLet(exported, is_rec, name, ty_opt, val) => {
      let p = prefix(exported)
      let r = if is_rec {
        "let rec "
      } else "let "
      let t = match ty_opt {
        Some(ty) => ": \{print_type_expr(ty)}",
        None => ""
      }
      "\{p}\{r}\{name}\{t} = \{print_expr(val)}"
    },
    SLetMut(name, ty_opt, val) => {
      let t = match ty_opt {
        Some(ty) => ": \{print_type_expr(ty)}",
        None => ""
      }
      "let mut \{name}\{t} = \{print_expr(val)}"
    },
    SEnum(exported, name, ctors) => "\{prefix(exported)}enum \{name} { \{print_ctor_list(ctors)} }",
    SSuberror(exported, name, ctors) => {
      let p = prefix(exported)
      if eq(Array::length(ctors), 1) {
        let (ctor_name, ctor_args) = Array::get(ctors, 0)
        if ctor_name == name {
          let parts = for arg in ctor_args {
            print_type_expr(arg)
          }
          "\{p}suberror \{name}(\{join(parts, ", ")})"
        }
        else "\{p}suberror \{name} { \{print_ctor_list(ctors)} }"
      } else "\{p}suberror \{name} { \{print_ctor_list(ctors)} }"
    },
    SStruct(exported, name, fields) => {
      let parts = for field in fields {
        let (fn1, ty) = field
        "\{fn1}: \{print_type_expr(ty)}"
      }
      "\{prefix(exported)}struct \{name} { \{join(parts, "; ")} }"
    },
    STypeAlias(exported, name, ty) => "\{prefix(exported)}type \{name} = \{print_type_expr(ty)}",
    STrait(exported, name, supers) => {
      let base = "\{prefix(exported)}trait \{name}"
      if eq(Array::length(supers), 0) {
        base
      }
      else "\{base}: \{join(supers, " + ")}"
    },
    SImpl(tparams, _, trait_name, type_name) => {
      let base = "impl \{trait_name} for \{type_name}"
      if eq(Array::length(tparams), 0) {
        base
      }
      else "[\{join(tparams, ", ")}] \{base}"
    },
    SExternLet(name, ty) => "extern let \{name}: \{print_type_expr(ty)}",
    SImport(path, items) => {
      let parts = for item in items {
        let (name, alias) = item
        match alias {
          Some(a) => "\{name} as \{a}",
          None => name
        }
      }
      "import \{path} { \{join(parts, ", ")} }"
    },
    STest(name, body) => "test \"\{name}\" { \{print_expr(body)} }",
    SBench(name, body) => "bench \"\{name}\" { \{print_expr(body)} }",
    SExpr(e) => print_expr(e),
    SExport(names) => "export { \{join(names, ", ")} }",
    SReExport(path, items) => {
      let parts = for item in items {
        let (name, alias) = item
        match alias {
          Some(a) => "\{name} as \{a}",
          None => name
        }
      }
      "export \{path} { \{join(parts, ", ")} }"
    },
    SModule(exported, name, stmts) => {
      let parts = for s in stmts {
        print_stmt(s)
      }
      let p = if exported {
        "export "
      } else ""
      "\{p}module \{name} { \{join(parts, "\n")} }"
    }
  }
}

export let print_program = (stmts: Array[Stmt]) -> String {
  let parts = for s in stmts {
    print_stmt(s)
  }
  join(parts, "\n")
}
