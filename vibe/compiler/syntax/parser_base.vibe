//# Imports
// Expression parser internals are split from stmt parsing for selfhost compatibility.

import ../core {
  Expr, Pat, Stmt, TypeExpr
}

import ./token.vibe {
  Token
}


//# Functions

let peek = (tokens: Array[Token], pos: Int) -> Token {
  if pos < Array::length(tokens) {
    Array::get(tokens, pos)
  } else TEof
}

let _no_tp = () -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

let _no_tb = () -> Array[(String, Array[String])] {
  Array::slice([
    ("", _no_tp())
  ], 0, 0)
}

let mode_if = 21

let tk_name = (tok: Token) -> String {
  match tok {
    TInt(_) => "int",
    TFloat(_) => "float",
    TString(_) => "string",
    TStringInterp(_) => "string",
    TIdent(_) => "ident",
    TLet => "let",
    TRec => "rec",
    TMut => "mut",
    TFn => "fn",
    TIf => "if",
    TElse => "else",
    TMatch => "match",
    TDo => "do",
    TEnum => "enum",
    TStruct => "struct",
    TType => "type",
    TTrait => "trait",
    TImpl => "impl",
    TExport => "export",
    TTest => "test",
    TWhile => "while",
    TFor => "for",
    TIn => "in",
    TLoop => "loop",
    TBreak => "break",
    TContinue => "continue",
    TReturn => "return",
    TWith => "with",
    THandle => "handle",
    TThrow => "throw",
    TRaise => "raise",
    TYield => "yield",
    TBench => "bench",
    TDeclare => "declare",
    TAs => "as",
    TModule => "module",
    TSuberror => "suberror",
    TDerive => "derive",
    TOpen => "open",
    TImport => "import",
    TPlus => "+",
    TMinus => "-",
    TStar => "*",
    TSlash => "/",
    TPercent => "%",
    TEqEq => "==",
    TNeq => "!=",
    TLt => "<",
    TLte => "<=",
    TGt => ">",
    TGte => ">=",
    TAnd => "&&",
    TOr => "||",
    TNot => "!",
    TBitAnd => "&",
    TBitOr => "|",
    TBitXor => "^",
    TLShift => "<<",
    TRShift => ">>",
    TPipeGt => "|>",
    TArrow => "=>",
    TThinArrow => "->",
    TEq => "=",
    TDot => ".",
    TColon => ":",
    TDoubleColon => "::",
    TComma => ",",
    TSemicolon => ";",
    THash => "#",
    TTilde => "~",
    TQuestion => "?",
    TPlusEq => "+=",
    TMinusEq => "-=",
    TStarEq => "*=",
    TSlashEq => "/=",
    TPercentEq => "%=",
    TLParen => "(",
    TRParen => ")",
    TLBrace => "{",
    TRBrace => "}",
    TLBracket => "[",
    TRBracket => "]",
    TDotDot => "..",
    TDotDotDot => "...",
    TStringInterp(_) => "string",
    TEof => "eof"
  }
}

let is_tk = (tok: Token, name: String) -> Bool {
  tk_name(tok) == name
}

let expect_tk = (tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {
  if is_tk(peek(tokens, pos), expected) {
    pos + 1
  }
  else throw("expected \{expected} but got \{tk_name(peek(tokens, pos))}")
}

let skip_semi = (tokens: Array[Token], pos: Int) -> Int {
  match peek(tokens, pos) {
    TSemicolon => pos + 1,
    _ => pos
  }
}

let empty_arms = () -> Array[(Pat, Expr)] {
  Array::slice([
    (PWild, EUnit)
  ], 0, 0)
}

let empty_pats = () -> Array[Pat] {
  Array::slice([
    PWild
  ], 0, 0)
}

let mode_block = 20

let mode_match = 22

let mode_while = 23

let empty_ctors = () -> Array[(String, Array[TypeExpr])] {
  Array::slice([
    ("_", Array::slice([
      TyUnit
    ], 0, 0))
  ], 0, 0)
}

let empty_exprs = () -> Array[Expr] {
  Array::slice([
    EUnit
  ], 0, 0)
}

let empty_names = () -> Array[String] {
  Array::slice([
    "_"
  ], 0, 0)
}

let mode_for_in = 25

let mode_handle = 24

let empty_fields = () -> Array[(String, TypeExpr)] {
  Array::slice([
    ("_", TyUnit)
  ], 0, 0)
}

let empty_params = () -> Array[(String, Option[TypeExpr])] {
  Array::slice([
    ("", None)
  ], 0, 0)
}

let rec parse_pattern = (tokens: Array[Token], pos: Int) -> (Pat, Int)with { Error } {
  let rec parse_pat_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Pat]) -> (Array[Pat], Int)with { Error } {
    match peek(tokens, pos) {
      TComma => {
        let (p, pn) = parse_pattern(tokens, pos + 1)
        ArrayBuilder::push(b, p)
        parse_pat_cont(tokens, pn, b)
      },
      TRParen => (ArrayBuilder::freeze(b), pos + 1),
      _ => throw("expected ',' or ')' in pattern list")
    }
  }
  let parse_pats_until_rparen = (tokens: Array[Token], pos: Int) -> (Array[Pat], Int)with { Error } {
    match peek(tokens, pos) {
      TRParen => (empty_pats(), pos + 1),
      _ => {
        let (f, fn1) = parse_pattern(tokens, pos)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, f)
        parse_pat_cont(tokens, fn1, b)
      }
    }
  }
  let (pat, next) = match peek(tokens, pos) {
    TInt(n) => (PInt(n), pos + 1),
    TFloat(_) => (PWild, pos + 1),
    TString(s) => (PString(s), pos + 1),
    TIdent(name) => {
      let next_is_lbrace = match peek(tokens, pos + 1) {
        TLBrace => true,
        _ => false
      }
      if name == "true" {
        (PBool(true), pos + 1)
      }
      else if name == "false" {
        (PBool(false), pos + 1)
      }
      else if name == "_" {
        (PWild, pos + 1)
      }
      else if name == "record" && next_is_lbrace {
        // Record pattern: record { x: a, y: (b, c) } — bind fields positionally
        let mut rp = pos + 2
        let field_pats_b = ArrayBuilder::new()
        let mut rd = true
        while rd {
          match peek(tokens, rp) {
            TRBrace => { rd = false },
            TIdent(fname) => {
              match peek(tokens, rp + 1) {
                TColon => {
                  let (fp, fnext) = parse_pattern(tokens, rp + 2)
                  ArrayBuilder::push(field_pats_b, fp)
                  rp = fnext
                },
                TComma => { ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1 },
                TRBrace => { ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1 },
                _ => { ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1 }
              }
              match peek(tokens, rp) {
                TComma => { rp = rp + 1 },
                _ => ()
              }
            },
            _ => { rp = rp + 1 }
          }
        }
        let rp2 = rp + 1
        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)
      }
      else {
        let fc = String::char_code_at(name, 0)
        if fc >= 65 && fc <= 90 {
          match peek(tokens, pos + 1) {
            TLParen => {
              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);
              (PCtor(name, args), end)
            },
            TDoubleColon => match peek(tokens, pos + 2) {
              TLBrace => {
                // Struct pattern: Point::{ x, y } → bind fields positionally
                let mut sp = pos + 3
                let field_pats = ArrayBuilder::new()
                let mut sd = true
                while sd {
                  match peek(tokens, sp) {
                    TRBrace => { sd = false },
                    TIdent(fname) => {
                      ArrayBuilder::push(field_pats, PBind(fname))
                      sp = sp + 1
                      match peek(tokens, sp) { TComma => { sp = sp + 1 }, _ => () }
                    },
                    _ => { sd = false }
                  }
                }
                (PTuple(ArrayBuilder::freeze(field_pats)), sp + 1)
              },
              _ => (PCtor(name, empty_pats()), pos + 1)
            },
            _ => (PCtor(name, empty_pats()), pos + 1)
          }
        } else (PBind(name), pos + 1)
      }
    },
    TLParen => match peek(tokens, pos + 1) {
      TRParen => (PTuple(empty_pats()), pos + 2),
      _ => {
        let (f, n1) = parse_pattern(tokens, pos + 1)
        match peek(tokens, n1) {
          TRParen => (f, n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, f)
            let (rest, end) = parse_pat_cont(tokens, n1, b);
            (PTuple(rest), end)
          },
          _ => throw("expected ')' or ',' in pattern")
        }
      }
    },
    _ => throw("unexpected in pattern: \{tk_name(peek(tokens, pos))}")
  }
  match peek(tokens, next) {
    TBitOr => {
      let (right, end) = parse_pattern(tokens, next + 1);
      (POr(pat, right), end)
    },
    _ => (pat, next)
  }
}

let parse_impl_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  let empty_strings = Array::slice([
    "_"
  ], 0, 0)
  let empty_bounds = Array::slice([
    ("_", empty_strings)
  ], 0, 0)
  match peek(tokens, pos) {
    TLBracket => {
      throw("impl type parameters are not supported yet")
    },
    TIdent(trait_name) => {
      let fp = expect_tk(tokens, pos + 1, "for")
      match peek(tokens, fp) {
        TIdent(type_name) => (SImpl(empty_strings, empty_bounds, trait_name, type_name), fp + 1),
        _ => throw("expected type name after 'for'")
      }
    },
    _ => throw("expected trait name after 'impl'")
  }
}

let empty_type_exprs = () -> Array[TypeExpr] {
  Array::slice([
    TyUnit
  ], 0, 0)
}

let rec parse_type_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int)with { Error } {
  let rec type_list_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {
    match peek(tokens, pos) {
      TComma => {
        // Skip optional label
        let ts = match peek(tokens, pos + 1) {
          TIdent(_) => match peek(tokens, pos + 2) {
            TColon => pos + 3,
            TTilde => match peek(tokens, pos + 3) { TColon => pos + 4, _ => pos + 1 },
            TQuestion => match peek(tokens, pos + 3) { TColon => pos + 4, _ => pos + 1 },
            _ => pos + 1
          },
          _ => pos + 1
        }
        let (ty, next) = parse_type_impl(tokens, ts, 0)
        ArrayBuilder::push(b, ty)
        type_list_rest(tokens, next, b)
      },
      _ => (ArrayBuilder::freeze(b), pos)
    }
  }
  if mode == 0 {
    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)
    match peek(tokens, atom_next) {
      TThinArrow => {
        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)
        let params = match atom_ty {
          TyUnit => empty_type_exprs(),
          TyTuple(elems) => elems,
          _ => [
            atom_ty
          ]
        }
        let rn2 = match peek(tokens, rn) {
          TWith => {
            let p1 = rn + 1
            match peek(tokens, p1) {
              TLBrace => {
                let mut p2 = p1 + 1
                let mut done = false
                while !done{
                  match peek(tokens, p2) {
                    TRBrace => {
                      done = true
                    },
                    _ => {
                      p2 = p2 + 1
                    }
                  }
                }
                p2 + 1
              },
              _ => rn
            }
          },
          _ => rn
        };
        // Skip optional `with { Effect }` after function return type
        let fn_end = match peek(tokens, rn2) {
          TWith => {
            // Skip { ... } block
            let mut wp = rn2 + 1
            match peek(tokens, wp) {
              TLBrace => {
                wp = wp + 1
                let mut wd = 1
                while wd > 0 {
                  match peek(tokens, wp) {
                    TLBrace => { wd = wd + 1 },
                    TRBrace => { wd = wd - 1 },
                    _ => ()
                  }
                  wp = wp + 1
                }
                wp
              },
              _ => rn2
            }
          },
          _ => rn2
        }
        (TyFn(params, ret), fn_end)
      },
      _ => (atom_ty, atom_next)
    }
  } else match peek(tokens, pos) {
    TLParen => match peek(tokens, pos + 1) {
      TRParen => (TyUnit, pos + 2),
      _ => {
        // Skip optional label: (name: Type, ...) or (name~: Type, ...)
        let ty_start = match peek(tokens, pos + 1) {
          TIdent(_) => match peek(tokens, pos + 2) {
            TColon => pos + 3,
            TTilde => match peek(tokens, pos + 3) { TColon => pos + 4, _ => pos + 1 },
            TQuestion => match peek(tokens, pos + 3) { TColon => pos + 4, _ => pos + 1 },
            _ => pos + 1
          },
          _ => pos + 1
        }
        let (first, n1) = parse_type_impl(tokens, ty_start, 0)
        match peek(tokens, n1) {
          TRParen => (first, n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, first)
            let (rest, end) = type_list_rest(tokens, n1, b)
            let en = expect_tk(tokens, end, ")");
            (TyTuple(rest), en)
          },
          _ => throw("expected ')' or ',' in type")
        }
      }
    },
    TIdent(name) => match peek(tokens, pos + 1) {
      TLBracket => {
        let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
        match peek(tokens, n1) {
          TRBracket => (TyApp(name, [
            first
          ]), n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, first)
            let (rest, end) = type_list_rest(tokens, n1, b)
            let en = expect_tk(tokens, end, "]");
            (TyApp(name, rest), en)
          },
          _ => throw("expected ']' or ',' in type application")
        }
      },
      _ => (TyName(name), pos + 1)
    },
    _ => throw("expected type but got \{tk_name(peek(tokens, pos))}")
  }
}

export let parse_type = (tokens: Array[Token], pos: Int) -> (TypeExpr, Int)with { Error } {
  parse_type_impl(tokens, pos, 0)
}

let parse_one_param = (tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TTilde => {
        let labeled_name = "\{name}~"
        match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            ((labeled_name, Some(ty)), tp)
          },
          _ => ((labeled_name, None), pos + 2)
        }
      },
      TQuestion => {
        let opt_name = "\{name}?"
        match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            ((opt_name, Some(ty)), tp)
          },
          _ => ((opt_name, None), pos + 2)
        }
      },
      TColon => {
        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);
        // Skip optional trait bound: x: T: Eq or x: T: Eq + Show
        let tp2 = match peek(tokens, tp) {
          TColon => {
            let mut bp = tp + 1
            let mut bd = true
            while bd {
              match peek(tokens, bp) {
                TIdent(_) => { bp = bp + 1; match peek(tokens, bp) { TPlus => { bp = bp + 1 }, _ => { bd = false } } },
                _ => { bd = false }
              }
            }
            bp
          },
          _ => tp
        }
        ((name, Some(ty)), tp2)
      },
      _ => ((name, None), pos + 1)
    },
    _ => throw("expected parameter name")
  }
}

let rec parse_param_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRParen => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (p, pn) = parse_one_param(tokens, pos + 1)
        ArrayBuilder::push(b, p)
        parse_param_cont(tokens, pn, b)
      }
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or ')' in param list")
  }
}

let parse_param_list = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {
  match peek(tokens, pos) {
    TRParen => (empty_params(), pos + 1),
    _ => {
      let (f, fn1) = parse_one_param(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, f)
      parse_param_cont(tokens, fn1, b)
    }
  }
}

let parse_trait_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  let empty_strings = Array::slice([
    "_"
  ], 0, 0)
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TColon => {
        let rec parse_supers = (p: Int, acc: Array[String]) -> (Array[String], Int) {
          match peek(tokens, p) {
            TIdent(sname) => match peek(tokens, p + 1) {
              TPlus => parse_supers(p + 2, Array::concat(acc, [
                sname
              ])),
              _ => (Array::concat(acc, [
                sname
              ]), p + 1)
            },
            _ => (acc, p)
          }
        }
        let (supers, np) = parse_supers(pos + 2, empty_strings);
        (STrait(exported, name, supers), np)
      },
      _ => (STrait(exported, name, empty_strings), pos + 1)
    },
    _ => throw("expected trait name")
  }
}

let is_expr_end_token = (tok: Token) -> Bool {
  match tok {
    TInt(_) => true,
    TFloat(_) => true,
    TString(_) => true,
    TStringInterp(_) => true,
    TIdent(_) => true,
    TRParen => true,
    TRBracket => true,
    TRBrace => true,
    _ => false
  }
}

let is_non_pipe_infix = (tok: Token) -> Bool {
  match tok {
    TOr => true,
    TAnd => true,
    TEqEq => true,
    TNeq => true,
    TLt => true,
    TLte => true,
    TGt => true,
    TGte => true,
    TBitOr => true,
    TBitXor => true,
    TBitAnd => true,
    TLShift => true,
    TRShift => true,
    TPlus => true,
    TMinus => true,
    TStar => true,
    TSlash => true,
    TPercent => true,
    _ => false
  }
}

let parse_import_item = (tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int)with { Error } {
  let parse_import_name = (name_pos: Int) -> ((String, Option[String]), Int)with { Error } {
    match peek(tokens, name_pos) {
      TIdent(name) => match peek(tokens, name_pos + 1) {
        TAs => match peek(tokens, name_pos + 2) {
          TIdent(alias) => ((name, Some(alias)), name_pos + 3),
          _ => throw("expected alias name after 'as'")
        },
        _ => ((name, None), name_pos + 1)
      },
      _ => throw("expected import item name")
    }
  }
  match peek(tokens, pos) {
    TIdent(_) => parse_import_name(pos),
    TType => parse_import_name(pos + 1),
    TTrait => parse_import_name(pos + 1),
    _ => throw("expected import item name")
  }
}

let empty_import_items = () -> Array[(String, Option[String])] {
  Array::slice([
    ("_", None)
  ], 0, 0)
}

let parse_binding_name = (tokens: Array[Token], pos: Int) -> (String, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) => (String::concat(name, String::concat("::", member)), pos + 3),
        _ => throw("expected qualified member name after '::'")
      },
      _ => (name, pos + 1)
    },
    _ => throw("expected name after 'let'")
  }
}

let parse_struct_field = (tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let cn = expect_tk(tokens, pos + 1, ":")
      let (ty, next) = parse_type_impl(tokens, cn, 0);
      ((name, ty), next)
    },
    _ => throw("expected field name")
  }
}

let rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (field, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        parse_struct_fields_rest(tokens, next, b)
      }
    },
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (field, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        parse_struct_fields_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';', ',' or '}' in struct")
  }
}

let parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_fields(), pos + 1),
    _ => {
      let (first, next) = parse_struct_field(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_struct_fields_rest(tokens, next, b)
    }
  }
}

let parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (fields, end) = parse_struct_fields(tokens, br);
      (SStruct(exported, name, fields), end)
    },
    _ => throw("expected struct name")
  }
}

let rec collect_import_path = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {
  match peek(tokens, pos) {
    TLBrace => (acc, pos),
    TDot => collect_import_path(tokens, pos + 1, "\{acc}."),
    TDotDot => collect_import_path(tokens, pos + 1, "\{acc}.."),
    TSlash => collect_import_path(tokens, pos + 1, "\{acc}/"),
    TIdent(name) => collect_import_path(tokens, pos + 1, "\{acc}\{name}"),
    TMinus => collect_import_path(tokens, pos + 1, "\{acc}-"),
    TModule => collect_import_path(tokens, pos + 1, "\{acc}module"),
    TType => collect_import_path(tokens, pos + 1, "\{acc}type"),
    TMatch => collect_import_path(tokens, pos + 1, "\{acc}match"),
    TTest => collect_import_path(tokens, pos + 1, "\{acc}test"),
    _ => throw("unexpected token in import path: \{tk_name(peek(tokens, pos))}")
  }
}

let rec collect_effect_names = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {
  match peek(tokens, pos) {
    TRBrace => (acc, pos + 1),
    TIdent(name) => {
      let new_acc = if String::length(acc) == 0 {
        name
      } else "\{acc}, \{name}"
      match peek(tokens, pos + 1) {
        TComma => collect_effect_names(tokens, pos + 2, new_acc),
        TRBrace => (new_acc, pos + 2),
        _ => throw("expected ',' or '}' in effect list")
      }
    },
    _ => throw("expected effect name or '}'")
  }
}

let rec is_lambda_start_impl = (tokens: Array[Token], pos: Int, depth: Int, has_colon: Bool) -> Bool {
  match peek(tokens, pos) {
    TColon => if depth == 0 {
      is_lambda_start_impl(tokens, pos + 1, depth, true)
    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),
    TRParen => if depth == 0 {
      match peek(tokens, pos + 1) {
        TThinArrow => true,
        TLBrace => true,
        _ => false
      }
    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),
    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),
    TEof => false,
    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)
  }
}

let is_lambda_start = (tokens: Array[Token], pos: Int) -> Bool {
  is_lambda_start_impl(tokens, pos, 0, false)
}

let rec parse_ctor_types_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {
  match peek(tokens, pos) {
    TComma => {
      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)
      ArrayBuilder::push(b, ty)
      parse_ctor_types_rest(tokens, next, b)
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or ')' in constructor types")
  }
}

let parse_enum_ctor = (tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TLParen => match peek(tokens, pos + 2) {
        TRParen => ((name, empty_type_exprs()), pos + 3),
        _ => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, first)
          let (types, end) = parse_ctor_types_rest(tokens, n1, b);
          ((name, types), end)
        }
      },
      _ => ((name, empty_type_exprs()), pos + 1)
    },
    _ => throw("expected constructor name")
  }
}

let rec parse_enum_ctors_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)
        ArrayBuilder::push(b, ctor)
        parse_enum_ctors_rest(tokens, next, b)
      }
    },
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)
        ArrayBuilder::push(b, ctor)
        parse_enum_ctors_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';', ',' or '}' in enum")
  }
}

let parse_enum_ctors = (tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {
  match peek(tokens, pos) {
    TRBrace => (empty_ctors(), pos + 1),
    _ => {
      let (first, next) = parse_enum_ctor(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_enum_ctors_rest(tokens, next, b)
    }
  }
}

let parse_enum_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      // Skip optional type parameters [T] or [T, U]
      let after_name = match peek(tokens, pos + 1) {
        TLBracket => {
          let mut skip = pos + 2
          let mut depth = 1
          while depth > 0 {
            match peek(tokens, skip) {
              TLBracket => { depth = depth + 1; skip = skip + 1 },
              TRBracket => { depth = depth - 1; skip = skip + 1 },
              _ => { skip = skip + 1 }
            }
          }
          skip
        },
        _ => pos + 1
      }
      let br = expect_tk(tokens, after_name, "{")
      let (ctors, end) = parse_enum_ctors(tokens, br);
      (SEnum(exported, name, ctors), end)
    },
    _ => throw("expected enum name")
  }
}

let parse_suberror_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TLParen => match peek(tokens, pos + 2) {
        TRParen => {
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, (name, empty_type_exprs()))
          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)
        },
        _ => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          let args_b = ArrayBuilder::new()
          ArrayBuilder::push(args_b, first)
          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)
          let ctors_b = ArrayBuilder::new()
          ArrayBuilder::push(ctors_b, (name, args))
          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)
        }
      },
      TLBrace => {
        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);
        (SSuberror(exported, name, ctors), end)
      },
      _ => throw("expected '(' or '{' after suberror name")
    },
    _ => throw("expected suberror name")
  }
}

// Parse effect declaration: effect Name[T] { Op(Args) -> Ret; ... }
let parse_effect_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int) with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      // Parse optional type parameters [T, S]
      let (type_params, after_params) = match peek(tokens, pos + 1) {
        TLBracket => parse_type_params_list(tokens, pos + 2),
        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)
      }
      let br = expect_tk(tokens, after_params, "{")
      let ops_b = ArrayBuilder::new()
      let mut p = br
      while true {
        match peek(tokens, p) {
          TRBrace => {
            p = p + 1
            break
          },
          TIdent(op_name) => {
            // Parse optional params: Op(Type, ...) or just Op
            let (params, after_op_params) = match peek(tokens, p + 1) {
              TLParen => {
                let params_b = ArrayBuilder::new()
                let mut pp = p + 2
                match peek(tokens, pp) {
                  TRParen => (ArrayBuilder::freeze(params_b), pp + 1),
                  _ => {
                    let (first_type, n1) = parse_type_impl(tokens, pp, 0)
                    ArrayBuilder::push(params_b, first_type)
                    pp = n1
                    while true {
                      match peek(tokens, pp) {
                        TComma => {
                          let (next_type, n2) = parse_type_impl(tokens, pp + 1, 0)
                          ArrayBuilder::push(params_b, next_type)
                          pp = n2
                        },
                        TRParen => {
                          pp = pp + 1
                          break
                        },
                        _ => throw("expected ',' or ')' in effect op params")
                      }
                    }
                    (ArrayBuilder::freeze(params_b), pp)
                  }
                }
              },
              _ => (ArrayBuilder::freeze(ArrayBuilder::new()), p + 1)
            }
            // Expect -> RetType
            let arrow_pos = expect_tk(tokens, after_op_params, "->")
            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)
            ArrayBuilder::push(ops_b, (op_name, params, ret_type))
            // Skip optional semicolons
            p = match peek(tokens, after_ret) {
              TSemicolon => after_ret + 1,
              _ => after_ret
            }
          },
          _ => throw("expected effect operation name or '}'")
        }
      }
      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)
    },
    _ => throw("expected effect name")
  }
}

// Parse type parameter list: T, S] (after opening [)
let parse_type_params_list = (tokens: Array[Token], pos: Int) -> (Array[String], Int) with { Error } {
  let b = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        p = p + 1
        match peek(tokens, p) {
          TComma => { p = p + 1 },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

let parse_type_alias_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {
  match peek(tokens, pos) {
    TIdent(name) => {
      let ep = expect_tk(tokens, pos + 1, "=")
      let (ty, next) = parse_type_impl(tokens, ep, 0);
      (STypeAlias(exported, name, ty), next)
    },
    _ => throw("expected type alias name")
  }
}

let parse_impl_stmt_dispatch = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {
  parse_impl_stmt(tokens, pos)
}

