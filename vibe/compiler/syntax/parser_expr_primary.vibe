//# Imports

import .. / core {
  Expr, TypeExpr
}

import ./parser_base.vibe {
  _no_tb, _no_tp, collect_effect_names, empty_exprs, expect_tk, is_lambda_start, mode_block, parse_param_list, parse_type_impl, peek, tk_name
}

import ./token.vibe {
  Token
}

//# Functions

// Transform break(val) and continue(args) inside a loop body for desugaring.
// break(val) → { __loop_result = val; break }
// continue(a, b) → { let __lt0 = a; let __lt1 = b; p0 = __lt0; p1 = __lt1; continue }
let rec desugar_loop_body: (Expr, Array[String]) -> Expr = (expr, param_names) -> {
  match expr {
    EBreak(opt) => match opt {
      Some(val) => EAssign("__loop_result", desugar_loop_body(val, param_names), EBreak(None)),
      None => EBreak(None)
    },
    EContinue(args) => {
      if Array::length(args) == 0 {
        EContinue(args)
      } else {
        let nargs = Array::length(args)
        let nparams = Array::length(param_names)
        if nargs > nparams {
          // Guard: more args than params → use only param count to avoid OOB
          EContinue(args)
        } else {
        let mut result = EContinue(Array::slice([EUnit], 0, 0))
        let mut ci = nargs - 1
        while ci >= 0 {
          result = EAssign(Array::get(param_names, ci), EIdent(String::concat("__lt", __to_string(ci))), result)
          ci = ci - 1
        }
        let mut ci2 = nargs - 1
        while ci2 >= 0 {
          result = ELet(String::concat("__lt", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result)
          ci2 = ci2 - 1
        }
        result
        }
      }
    },
    EWhile(_, _) => expr,
    ELoop(_, _) => expr,
    EFn(_, _, _, _, _, _) => expr,
    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),
    ELet(n, v, b) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),
    ELetMut(n, v, b) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),
    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),
    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),
    // EMatch/EHandle: pass through unchanged.
    // Limitation: break/continue inside match/handle arms won't be desugared.
    // The host compiler crashes on (Pat, Expr) tuple operations, preventing
    // arms transformation. The selfhost parser (which compiles user code) handles
    // ELoop natively via this desugaring, so this only affects programs compiled
    // by the host-compiled selfhost. A future fix could add arms recursion when
    // the host compiler supports Pat tuple types.
    EMatch(_, _) => expr,
    EHandle(_, _) => expr,
    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),
    ECall(_, _) => expr,
    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),
    EThrow(e) => EThrow(desugar_loop_body(e, param_names)),
    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),
    EDot(obj, field) => EDot(desugar_loop_body(obj, param_names), field),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),
    _ => expr
  }
}


let parse_loop_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TLParen => {
      let param_names_b = ArrayBuilder::new()
      let param_inits_b = ArrayBuilder::new()
      let mut cur = pos + 2
      let mut done = false
      while !done {
        match peek(tokens, cur) {
          TRParen => {
            cur = cur + 1
            done = true
          },
          TIdent(name) => {
            let eq_pos = expect_tk(tokens, cur + 1, "=")
            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)
            ArrayBuilder::push(param_names_b, name)
            ArrayBuilder::push(param_inits_b, init)
            match peek(tokens, next_pos) {
              TComma => {
                cur = next_pos + 1
              },
              TRParen => {
                cur = next_pos + 1
                done = true
              },
              _ => throw("expected ',' or ')' in loop params")
            }
          },
          _ => throw("expected loop parameter name or ')'")
        }
      }
      let body_pos = expect_tk(tokens, cur, "{")
      let (body, end_pos) = parse_recur(tokens, body_pos, mode_block)
      // Desugar ELoop into ELetMut + EWhile
      let pnames = ArrayBuilder::freeze(param_names_b)
      let pinits = ArrayBuilder::freeze(param_inits_b)
      let transformed_body = desugar_loop_body(body, pnames)
      let while_expr = EWhile(EBool(true), transformed_body)
      let result = ELetMut("__loop_result", EInt(0),
        ESeq(while_expr, EIdent("__loop_result")))
      let mut wrapped = result
      let mut wi = Array::length(pnames) - 1
      while wi >= 0 {
        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped)
        wi = wi - 1
      }
      (wrapped, end_pos)
    },
    _ => {
      let body_pos = expect_tk(tokens, pos + 1, "{")
      let (body, end_pos) = parse_recur(tokens, body_pos, mode_block)
      (EWhile(EBool(true), body), end_pos)
    }
  }
}

let parse_break_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRBrace => (EBreak(None), pos + 1),
    TSemicolon => (EBreak(None), pos + 1),
    TEof => (EBreak(None), pos + 1),
    _ => {
      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)
      (EBreak(Some(expr)), next_pos)
    }
  }
}

let parse_throw_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  let open_pos = expect_tk(tokens, pos + 1, "(")
  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)
  let close_pos = expect_tk(tokens, next_pos, ")")
  (EThrow(expr), close_pos)
}

let parse_return_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRBrace => (EReturn(EUnit), pos + 1),
    TSemicolon => (EReturn(EUnit), pos + 1),
    TEof => (EReturn(EUnit), pos + 1),
    _ => {
      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)
      (EReturn(expr), next_pos)
    }
  }
}

let parse_perform_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRParen => (EIdent("perform"), pos + 1),
    TRBracket => (EIdent("perform"), pos + 1),
    TRBrace => (EIdent("perform"), pos + 1),
    TComma => (EIdent("perform"), pos + 1),
    TSemicolon => (EIdent("perform"), pos + 1),
    TEof => (EIdent("perform"), pos + 1),
    _ => {
      let (arg, next_pos) = parse_recur(tokens, pos + 1, 0)
      (ECall(EIdent("perform"), [
        arg
      ]), next_pos)
    }
  }
}

let rec parse_array_elems_rest: (Array[Token], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TComma => {
      let next_pos = pos + 1
      match peek(tokens, next_pos) {
        TDotDotDot => {
          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)
          ArrayBuilder::push(b, ESpread(expr))
          parse_array_elems_rest(tokens, end_pos, b, parse_recur)
        },
        _ => {
          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)
          ArrayBuilder::push(b, expr)
          parse_array_elems_rest(tokens, end_pos, b, parse_recur)
        }
      }
    },
    _ => (ArrayBuilder::freeze(b), pos)
  }
}

let parse_array_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRBracket => (EArray(empty_exprs()), pos + 2),
    TDotDotDot => {
      let b = ArrayBuilder::new()
      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)
      ArrayBuilder::push(b, ESpread(first))
      let (items, end_pos) = parse_array_elems_rest(tokens, next_pos, b, parse_recur)
      let close_pos = expect_tk(tokens, end_pos, "]")
      (EArray(items), close_pos)
    },
    _ => {
      let b = ArrayBuilder::new()
      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)
      ArrayBuilder::push(b, first)
      let (items, end_pos) = parse_array_elems_rest(tokens, next_pos, b, parse_recur)
      let close_pos = expect_tk(tokens, end_pos, "]")
      (EArray(items), close_pos)
    }
  }
}

let rec parse_comma_exprs_rest: (Array[Token], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TComma => {
      let (e, next) = parse_recur(tokens, pos + 1, 0)
      ArrayBuilder::push(b, e)
      parse_comma_exprs_rest(tokens, next, b, parse_recur)
    },
    _ => (ArrayBuilder::freeze(b), pos)
  }
}

let parse_continue_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TLParen => {
      let b = ArrayBuilder::new()
      match peek(tokens, pos + 2) {
        TRParen => (EContinue(empty_exprs()), pos + 3),
        _ => {
          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)
          ArrayBuilder::push(b, first)
          let (args, end_pos) = parse_comma_exprs_rest(tokens, next_pos, b, parse_recur)
          let close_pos = expect_tk(tokens, end_pos, ")")
          (EContinue(args), close_pos)
        }
      }
    },
    _ => (EContinue(empty_exprs()), pos + 1)
  }
}

let parse_control_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos) {
    TLBrace => parse_recur(tokens, pos + 1, mode_block),
    TIf => parse_recur(tokens, pos + 1, 21),
    TMatch => parse_recur(tokens, pos + 1, 22),
    THandle => parse_recur(tokens, pos + 1, 24),
    TWhile => parse_recur(tokens, pos + 1, 23),
    TFor => parse_recur(tokens, pos + 1, 25),
    TThrow => parse_throw_primary(tokens, pos, parse_recur),
    TBreak => parse_break_primary(tokens, pos, parse_recur),
    TContinue => parse_continue_primary(tokens, pos, parse_recur),
    TRaise => throw("'raise' is deprecated, use 'throw(expr)' instead"),
    TReturn => parse_return_primary(tokens, pos, parse_recur),
    TDo => throw("'do' is reserved; use 'while' or 'for' instead"),
    TLoop => parse_loop_primary(tokens, pos, parse_recur),
    TYield => throw("'yield' is not supported"),
    TDeclare => throw("'declare' is not supported"),
    _ => throw("unexpected token: \{tk_name(peek(tokens, pos))}")
  }
}

let parse_lambda_body_expr: (Array[Token], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, params, ret_ty, effect, body_pos, body_mode, parse_recur) -> {
  let (body, end) = parse_recur(tokens, body_pos, body_mode)
  (EFn(_no_tp(), _no_tb(), params, ret_ty, effect, body), end)
}

let rec parse_ctor_record_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    TIdent(fname) => {
      let colon_pos = expect_tk(tokens, pos + 1, ":")
      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)
      ArrayBuilder::push(b, (fname, val))
      match peek(tokens, next_pos) {
        TComma => parse_ctor_record_fields(tokens, next_pos + 1, b, parse_recur),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in record literal")
      }
    },
    _ => throw("expected field name or '}' in record literal")
  }
}

let parse_generic_fn_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  let mut skip_pos = pos + 1
  let mut depth = 1
  while depth > 0 {
    match peek(tokens, skip_pos) {
      TLBracket => {
        depth = depth + 1
      },
      TRBracket => {
        depth = depth - 1
      },
      _ => ()
    }
    skip_pos = skip_pos + 1
  }
  let (params, after_params) = parse_param_list(tokens, skip_pos)
  match peek(tokens, after_params) {
    TThinArrow => {
      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)
      let effect_pair = match peek(tokens, ret_pos) {
        TWith => {
          let with_pos = expect_tk(tokens, ret_pos + 1, "{")
          let effect_name_pair = collect_effect_names(tokens, with_pos, "")
          let effect_name = effect_name_pair.0
          let end_pos = effect_name_pair.1
          (Some(effect_name), end_pos)
        },
        _ => (None, ret_pos)
      }
      let effect = effect_pair.0
      let effect_next = effect_pair.1
      let body_pos = expect_tk(tokens, effect_next, "{")
      let (body, end_pos) = parse_recur(tokens, body_pos, mode_block)
      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)
    },
    TLBrace => {
      let (body, end_pos) = parse_recur(tokens, after_params + 1, mode_block)
      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)
    },
    _ => throw("expected '->' or '{' after generic function params")
  }
}

let is_generic_fn_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {
  match peek(tokens, pos + 1) {
    TIdent(_) => {
      let mut p = pos + 2
      let mut depth = 1
      while depth > 0 {
        match peek(tokens, p) {
          TLBracket => {
            depth = depth + 1
          },
          TRBracket => {
            depth = depth - 1
          },
          TEof => {
            depth = 0
          },
          _ => ()
        }
        p = p + 1
      }
      match peek(tokens, p) {
        TLParen => true,
        _ => false
      }
    },
    _ => false
  }
}

let parse_bracket_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  if is_generic_fn_start(tokens, pos) {
    parse_generic_fn_primary(tokens, pos, parse_recur)
  } else {
    parse_array_primary(tokens, pos, parse_recur)
  }
}

let rec parse_map_literal_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    TIdent(fname) => {
      let colon_pos = expect_tk(tokens, pos + 1, ":")
      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)
      ArrayBuilder::push(b, (fname, val))
      match peek(tokens, next_pos) {
        TComma => parse_map_literal_fields(tokens, next_pos + 1, b, parse_recur),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in map literal")
      }
    },
    TString(skey) => {
      let colon_pos = expect_tk(tokens, pos + 1, ":")
      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)
      ArrayBuilder::push(b, (skey, val))
      match peek(tokens, next_pos) {
        TComma => parse_map_literal_fields(tokens, next_pos + 1, b, parse_recur),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in map literal")
      }
    },
    _ => throw("expected field name or '}' in map literal")
  }
}

let parse_paren_tuple_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRParen => (EUnit, pos + 2),
    _ => {
      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)
      match peek(tokens, next_pos) {
        TRParen => (first, next_pos + 1),
        TComma => {
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, first)
          let (items, end_pos) = parse_comma_exprs_rest(tokens, next_pos, b, parse_recur)
          let close_pos = expect_tk(tokens, end_pos, ")")
          (ETuple(items), close_pos)
        },
        _ => throw("expected ')' or ','")
      }
    }
  }
}

let parse_paren_lambda_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  let (params, after_params) = parse_param_list(tokens, pos + 1)
  match peek(tokens, after_params) {
    TThinArrow => {
      let after_arrow = after_params + 1
      match peek(tokens, after_arrow) {
        TIdent(_) => {
          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)
          match peek(tokens, ty_pos) {
            TLBrace => parse_lambda_body_expr(tokens, params, Some(ty), None, ty_pos + 1, mode_block, parse_recur),
            TWith => {
              let with_pos = expect_tk(tokens, ty_pos + 1, "{")
              let effect_pair = collect_effect_names(tokens, with_pos, "")
              let effect_name = effect_pair.0
              let effect_next = effect_pair.1
              let body_pos = expect_tk(tokens, effect_next, "{")
              parse_lambda_body_expr(tokens, params, Some(ty), Some(effect_name), body_pos, mode_block, parse_recur)
            },
            _ => parse_lambda_body_expr(tokens, params, None, None, after_arrow, 0, parse_recur)
          }
        },
        TLParen => {
          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)
          match peek(tokens, ty_pos) {
            TLBrace => parse_lambda_body_expr(tokens, params, Some(ty), None, ty_pos + 1, mode_block, parse_recur),
            TWith => {
              let with_pos = expect_tk(tokens, ty_pos + 1, "{")
              let effect_pair = collect_effect_names(tokens, with_pos, "")
              let effect_name = effect_pair.0
              let effect_next = effect_pair.1
              let body_pos = expect_tk(tokens, effect_next, "{")
              parse_lambda_body_expr(tokens, params, Some(ty), Some(effect_name), body_pos, mode_block, parse_recur)
            },
            _ => parse_lambda_body_expr(tokens, params, None, None, after_arrow, 0, parse_recur)
          }
        },
        _ => parse_lambda_body_expr(tokens, params, None, None, after_arrow, 0, parse_recur)
      }
    },
    TLBrace => parse_lambda_body_expr(tokens, params, None, None, after_params + 1, mode_block, parse_recur),
    _ => throw("expected '->' or '{' after fn params")
  }
}

let parse_paren_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  if is_lambda_start(tokens, pos + 1) {
    handle {
      parse_paren_lambda_primary(tokens, pos, parse_recur)
    } with Error {
      Throw(_) => parse_paren_tuple_primary(tokens, pos, parse_recur)
    }
  } else {
    parse_paren_tuple_primary(tokens, pos, parse_recur)
  }
}

let rec parse_record_literal_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    TIdent(fname) => {
      let (val, next_pos) = match peek(tokens, pos + 1) {
        TComma => (EIdent(fname), pos + 1),
        TRBrace => (EIdent(fname), pos + 1),
        _ => {
          let colon_pos = expect_tk(tokens, pos + 1, ":")
          parse_recur(tokens, colon_pos, 0)
        }
      }
      ArrayBuilder::push(b, (fname, val))
      match peek(tokens, next_pos) {
        TComma => parse_record_literal_fields(tokens, next_pos + 1, b, parse_recur),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in record literal")
      }
    },
    _ => throw("expected field name or '}' in record literal")
  }
}

let parse_ident_primary: (Array[Token], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, name, parse_recur) -> {
  if name == "true" {
    (EBool(true), pos + 1)
  } else if name == "false" {
    (EBool(false), pos + 1)
  } else if name == "perform" {
    parse_perform_primary(tokens, pos, parse_recur)
  } else if name == "record" {
    match peek(tokens, pos + 1) {
      TLBrace => {
        let b = ArrayBuilder::new()
        let (fields, end_pos) = parse_record_literal_fields(tokens, pos + 2, b, parse_recur)
        (ERecord(fields), end_pos)
      },
      _ => (EIdent(name), pos + 1)
    }
  } else if name == "map" {
    match peek(tokens, pos + 1) {
      TLBrace => {
        let b = ArrayBuilder::new()
        let (fields, end_pos) = parse_map_literal_fields(tokens, pos + 2, b, parse_recur)
        (EMap(fields), end_pos)
      },
      _ => (EIdent(name), pos + 1)
    }
  } else {
    match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) => (EIdent(String::concat(name, String::concat("::", member))), pos + 3),
        TLBrace => {
          let b = ArrayBuilder::new()
          let (fields, end_pos) = parse_ctor_record_fields(tokens, pos + 3, b, parse_recur)
          (ERecord(fields), end_pos)
        },
        _ => (EIdent(name), pos + 1)
      },
      _ => (EIdent(name), pos + 1)
    }
  }
}

export let parse_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos) {
    TInt(n) => (EInt(n), pos + 1),
    TFloat(n) => (EFloat(n), pos + 1),
    TString(s) => (EString(s), pos + 1),
    TStringInterp(parts) => (EStringInterp(parts), pos + 1),
    TIdent(name) => parse_ident_primary(tokens, pos, name, parse_recur),
    TLParen => parse_paren_primary(tokens, pos, parse_recur),
    TLBracket => parse_bracket_primary(tokens, pos, parse_recur),
    _ => parse_control_primary(tokens, pos, parse_recur)
  }
}
