//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

//# Helpers

let array_contains_str = (arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < array_length(arr) {
    if string_equals(array_get(arr, i), s) {
      found = true
    }
    i = i + 1
  }
  found
}

let empty_strings = () -> Array[String] {
  array_slice([""], 0, 0)
}

let empty_pairs = () -> Array[(String, String)] {
  array_slice([("", "")], 0, 0)
}

let append_all = (dst: Array[String], src: Array[String]) -> Unit {
  let mut i = 0
  while i < array_length(src) {
    array_push(dst, array_get(src, i))
    i = i + 1
  }
}

let append_all_pairs = (dst: Array[(String, String)], src: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < array_length(src) {
    array_push(dst, array_get(src, i))
    i = i + 1
  }
}

let add_unique = (arr: Array[String], s: String) -> Unit {
  if not(array_contains_str(arr, s)) {
    array_push(arr, s)
  }
}

// Extract binding names from a pattern
let rec collect_pat_bindings = (pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PBind(name) => array_push(out, name),
    PCtor(_, pats) => {
      let mut i = 0
      while i < array_length(pats) {
        collect_pat_bindings(array_get(pats, i), out)
        i = i + 1
      }
    },
    PTuple(pats) => {
      let mut i = 0
      while i < array_length(pats) {
        collect_pat_bindings(array_get(pats, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      collect_pat_bindings(a, out)
      collect_pat_bindings(b, out)
    },
    _ => ()
  }
}

// Clone a string array and add more items
let bound_with = (bound: Array[String], extras: Array[String]) -> Array[String] {
  let result = empty_strings()
  let mut i = 0
  while i < array_length(bound) {
    array_push(result, array_get(bound, i))
    i = i + 1
  }
  i = 0
  while i < array_length(extras) {
    array_push(result, array_get(extras, i))
    i = i + 1
  }
  result
}

let bound_with_one = (bound: Array[String], name: String) -> Array[String] {
  bound_with(bound, [name])
}

//# collect_free_vars

// Collect all free variables in an expression (not bound within it)
export let rec collect_free_vars = (expr: Expr, bound: Array[String]) -> Array[String] {
  let result = empty_strings()
  match expr {
    EIdent(name) => {
      if not(array_contains_str(bound, name)) {
        add_unique(result, name)
      }
      result
    },
    EInt(_) => result,
    EFloat(_) => result,
    EString(_) => result,
    EBool(_) => result,
    EUnit => result,
    ELet(name, val, body) => {
      append_all(result, collect_free_vars(val, bound))
      append_all(result, collect_free_vars(body, bound_with_one(bound, name)))
      result
    },
    ELetRec(name, val, body) => {
      let new_bound = bound_with_one(bound, name)
      append_all(result, collect_free_vars(val, new_bound))
      append_all(result, collect_free_vars(body, new_bound))
      result
    },
    ELetMut(name, val, body) => {
      append_all(result, collect_free_vars(val, bound))
      append_all(result, collect_free_vars(body, bound_with_one(bound, name)))
      result
    },
    EAssign(name, val, cont) => {
      if not(array_contains_str(bound, name)) {
        add_unique(result, name)
      }
      append_all(result, collect_free_vars(val, bound))
      append_all(result, collect_free_vars(cont, bound))
      result
    },
    EAssignOp(name, _, val, cont) => {
      if not(array_contains_str(bound, name)) {
        add_unique(result, name)
      }
      append_all(result, collect_free_vars(val, bound))
      append_all(result, collect_free_vars(cont, bound))
      result
    },
    EFn(_, _, params, _, _, body) => {
      let param_names = empty_strings()
      let mut i = 0
      while i < array_length(params) {
        let (pname, _) = array_get(params, i)
        array_push(param_names, pname)
        i = i + 1
      }
      append_all(result, collect_free_vars(body, bound_with(bound, param_names)))
      result
    },
    ECall(callee, args) => {
      append_all(result, collect_free_vars(callee, bound))
      let mut i = 0
      while i < array_length(args) {
        append_all(result, collect_free_vars(array_get(args, i), bound))
        i = i + 1
      }
      result
    },
    EIf(cond, then_e, else_e) => {
      append_all(result, collect_free_vars(cond, bound))
      append_all(result, collect_free_vars(then_e, bound))
      append_all(result, collect_free_vars(else_e, bound))
      result
    },
    ESeq(a, b) => {
      append_all(result, collect_free_vars(a, bound))
      append_all(result, collect_free_vars(b, bound))
      result
    },
    EBinOp(_, left, right) => {
      append_all(result, collect_free_vars(left, bound))
      append_all(result, collect_free_vars(right, bound))
      result
    },
    EUnaryOp(_, operand) => {
      append_all(result, collect_free_vars(operand, bound))
      result
    },
    EWhile(cond, body) => {
      append_all(result, collect_free_vars(cond, bound))
      append_all(result, collect_free_vars(body, bound))
      result
    },
    EForIn(name, iter, body) => {
      append_all(result, collect_free_vars(iter, bound))
      append_all(result, collect_free_vars(body, bound_with_one(bound, name)))
      result
    },
    EMatch(scrut, arms) => {
      append_all(result, collect_free_vars(scrut, bound))
      let mut ai = 0
      while ai < array_length(arms) {
        let (pat, arm_body) = array_get(arms, ai)
        let pat_binds = empty_strings()
        collect_pat_bindings(pat, pat_binds)
        append_all(result, collect_free_vars(arm_body, bound_with(bound, pat_binds)))
        ai = ai + 1
      }
      result
    },
    EHandle(body, arms) => {
      append_all(result, collect_free_vars(body, bound))
      let mut ai = 0
      while ai < array_length(arms) {
        let (pat, arm_body) = array_get(arms, ai)
        let pat_binds = empty_strings()
        collect_pat_bindings(pat, pat_binds)
        append_all(result, collect_free_vars(arm_body, bound_with(bound, pat_binds)))
        ai = ai + 1
      }
      result
    },
    ETuple(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        append_all(result, collect_free_vars(array_get(elems, i), bound))
        i = i + 1
      }
      result
    },
    EArray(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        append_all(result, collect_free_vars(array_get(elems, i), bound))
        i = i + 1
      }
      result
    },
    ERecord(fields) => {
      let mut i = 0
      while i < array_length(fields) {
        let (_, fval) = array_get(fields, i)
        append_all(result, collect_free_vars(fval, bound))
        i = i + 1
      }
      result
    },
    EDot(obj, _) => {
      append_all(result, collect_free_vars(obj, bound))
      result
    },
    EThrow(e) => {
      append_all(result, collect_free_vars(e, bound))
      result
    },
    ELabeledArg(_, _, e) => {
      append_all(result, collect_free_vars(e, bound))
      result
    },
    EBreak(opt) => {
      match opt {
        Some(e) => append_all(result, collect_free_vars(e, bound)),
        None => ()
      }
      result
    },
    EContinue(exprs) => {
      let mut i = 0
      while i < array_length(exprs) {
        append_all(result, collect_free_vars(array_get(exprs, i), bound))
        i = i + 1
      }
      result
    }
  }
}

//# collect_mut_bindings

// Collect mutable bindings from an expression
export let rec collect_mut_bindings = (expr: Expr) -> Array[String] {
  let result = empty_strings()
  match expr {
    ELetMut(name, val, body) => {
      array_push(result, name)
      append_all(result, collect_mut_bindings(val))
      append_all(result, collect_mut_bindings(body))
      result
    },
    ELet(_, val, body) => {
      append_all(result, collect_mut_bindings(val))
      append_all(result, collect_mut_bindings(body))
      result
    },
    ELetRec(_, val, body) => {
      append_all(result, collect_mut_bindings(val))
      append_all(result, collect_mut_bindings(body))
      result
    },
    ESeq(a, b) => {
      append_all(result, collect_mut_bindings(a))
      append_all(result, collect_mut_bindings(b))
      result
    },
    EIf(cond, then_e, else_e) => {
      append_all(result, collect_mut_bindings(cond))
      append_all(result, collect_mut_bindings(then_e))
      append_all(result, collect_mut_bindings(else_e))
      result
    },
    _ => result
  }
}

// Collect mutable bindings from statements
export let collect_mut_bindings_stmts = (stmts: Array[Stmt]) -> Array[String] {
  let result = empty_strings()
  let mut i = 0
  while i < array_length(stmts) {
    match array_get(stmts, i) {
      SLetMut(name, _, _) => array_push(result, name),
      SLet(_, _, _, _, body) => append_all(result, collect_mut_bindings(body)),
      SExpr(e) => append_all(result, collect_mut_bindings(e)),
      _ => ()
    }
    i = i + 1
  }
  result
}

//# check_mut_capture

// Check if a closure captures any mutable variable
export let check_mut_capture = (fn_body: Expr, outer_muts: Array[String]) -> Array[String] {
  let free = collect_free_vars(fn_body, empty_strings())
  let captured_muts = empty_strings()
  let mut i = 0
  while i < array_length(free) {
    let name = array_get(free, i)
    if array_contains_str(outer_muts, name) {
      add_unique(captured_muts, name)
    }
    i = i + 1
  }
  captured_muts
}

//# analyze_captures

let rec analyze_captures_with_muts = (expr: Expr, outer_muts: Array[String]) -> Array[(String, String)] {
  let result = empty_pairs()
  match expr {
    ELetMut(name, val, body) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      let new_muts = empty_strings()
      append_all(new_muts, outer_muts)
      array_push(new_muts, name)
      append_all_pairs(result, analyze_captures_with_muts(body, new_muts))
      result
    },
    EFn(_, _, params, _, _, body) => {
      // Check if this lambda captures any mutable variable from outer scope
      let param_names = empty_strings()
      let mut pi = 0
      while pi < array_length(params) {
        let (pname, _) = array_get(params, pi)
        array_push(param_names, pname)
        pi = pi + 1
      }
      let free = collect_free_vars(body, param_names)
      let mut i = 0
      while i < array_length(free) {
        let name = array_get(free, i)
        if array_contains_str(outer_muts, name) {
          array_push(result, ("lambda", name))
        }
        i = i + 1
      }
      // Also recurse into body to find nested captures
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    ELet(_, val, body) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    ELetRec(_, val, body) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    ESeq(a, b) => {
      append_all_pairs(result, analyze_captures_with_muts(a, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(b, outer_muts))
      result
    },
    EIf(cond, then_e, else_e) => {
      append_all_pairs(result, analyze_captures_with_muts(cond, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(then_e, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(else_e, outer_muts))
      result
    },
    ECall(callee, args) => {
      append_all_pairs(result, analyze_captures_with_muts(callee, outer_muts))
      let mut i = 0
      while i < array_length(args) {
        append_all_pairs(result, analyze_captures_with_muts(array_get(args, i), outer_muts))
        i = i + 1
      }
      result
    },
    EWhile(cond, body) => {
      append_all_pairs(result, analyze_captures_with_muts(cond, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    EForIn(_, iter, body) => {
      append_all_pairs(result, analyze_captures_with_muts(iter, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      result
    },
    EMatch(scrut, arms) => {
      append_all_pairs(result, analyze_captures_with_muts(scrut, outer_muts))
      let mut ai = 0
      while ai < array_length(arms) {
        let (_, arm_body) = array_get(arms, ai)
        append_all_pairs(result, analyze_captures_with_muts(arm_body, outer_muts))
        ai = ai + 1
      }
      result
    },
    EAssign(_, val, cont) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(cont, outer_muts))
      result
    },
    EAssignOp(_, _, val, cont) => {
      append_all_pairs(result, analyze_captures_with_muts(val, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(cont, outer_muts))
      result
    },
    EBinOp(_, left, right) => {
      append_all_pairs(result, analyze_captures_with_muts(left, outer_muts))
      append_all_pairs(result, analyze_captures_with_muts(right, outer_muts))
      result
    },
    EUnaryOp(_, operand) => {
      append_all_pairs(result, analyze_captures_with_muts(operand, outer_muts))
      result
    },
    ETuple(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        append_all_pairs(result, analyze_captures_with_muts(array_get(elems, i), outer_muts))
        i = i + 1
      }
      result
    },
    EArray(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        append_all_pairs(result, analyze_captures_with_muts(array_get(elems, i), outer_muts))
        i = i + 1
      }
      result
    },
    ERecord(fields) => {
      let mut i = 0
      while i < array_length(fields) {
        let (_, fval) = array_get(fields, i)
        append_all_pairs(result, analyze_captures_with_muts(fval, outer_muts))
        i = i + 1
      }
      result
    },
    EHandle(body, arms) => {
      append_all_pairs(result, analyze_captures_with_muts(body, outer_muts))
      let mut ai = 0
      while ai < array_length(arms) {
        let (_, arm_body) = array_get(arms, ai)
        append_all_pairs(result, analyze_captures_with_muts(arm_body, outer_muts))
        ai = ai + 1
      }
      result
    },
    EDot(obj, _) => {
      append_all_pairs(result, analyze_captures_with_muts(obj, outer_muts))
      result
    },
    EThrow(e) => {
      append_all_pairs(result, analyze_captures_with_muts(e, outer_muts))
      result
    },
    _ => result
  }
}

// Analyze an expression for unsafe mutable captures in nested closures
export let analyze_captures = (expr: Expr) -> Array[(String, String)] {
  analyze_captures_with_muts(expr, empty_strings())
}

// Analyze statements for unsafe captures
export let analyze_captures_stmts = (stmts: Array[Stmt]) -> Array[(String, String)] {
  let result = empty_pairs()
  let muts = empty_strings()
  let mut i = 0
  while i < array_length(stmts) {
    match array_get(stmts, i) {
      SLetMut(name, _, val) => {
        append_all_pairs(result, analyze_captures_with_muts(val, muts))
        array_push(muts, name)
      },
      SLet(_, _, _, _, body) => {
        append_all_pairs(result, analyze_captures_with_muts(body, muts))
      },
      SExpr(e) => {
        append_all_pairs(result, analyze_captures_with_muts(e, muts))
      },
      STest(_, body) => {
        append_all_pairs(result, analyze_captures_with_muts(body, muts))
      },
      _ => ()
    }
    i = i + 1
  }
  result
}
