//# Imports

import ./cache_probe_support.vibe {
  selfbuild_probe_type_db_cache_counts
}

import ./cli_cache.vibe {
  selfbuild_probe_cli_prepare_batch_parse_counts
}

//# Functions

let encoded_cache = selfbuild_probe_type_db_cache_counts()

let cache_count1 = encoded_cache / 1000

let cache_count2 = encoded_cache % 1000

assert(cache_count1 > 0)

assert(eq(cache_count2, cache_count1))

let encoded_cli_batch = selfbuild_probe_cli_prepare_batch_parse_counts()

let cli_batch_fresh_total = encoded_cli_batch / 1000

let cli_batch_shared_total = encoded_cli_batch % 1000

assert(cli_batch_fresh_total > 0)

assert(cli_batch_shared_total > 0)

assert(cli_batch_shared_total < cli_batch_fresh_total)
