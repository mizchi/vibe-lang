//# Imports

import ./eval_e2e_helpers.vibe {
  run_with_imports
}

//# Misc

test "import basic export let" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { x }\nlet result = x"),
    ("lib.vibe", "export let x = 42")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "42"))
}

test "import with alias" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { x as y }\nlet result = y"),
    ("lib.vibe", "export let x = 99")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "99"))
}

test "import export block" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { add }\nlet result = add(1, 2)"),
    ("lib.vibe", "let add = (a: Int, b: Int) -> Int { a + b }\nexport { add }")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "3"))
}

test "import non-exported not visible" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { secret }\nlet result = secret"),
    ("lib.vibe", "let secret = 123\nexport let public_val = 1")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "()"))
}

test "import cycle detected" {
  let sources = [
    ("a.vibe", "import ./b.vibe { y }\nexport let x = 1"),
    ("b.vibe", "import ./a.vibe { x }\nexport let y = 2")
  ]
  let result = run_with_imports(sources, "a.vibe", "x")
  assert(String::starts_with(result, "ERROR: import cycle"))
}

test "import transitive" {
  let sources = [
    ("main.vibe", "import ./b.vibe { val_from_c }\nlet result = val_from_c"),
    ("b.vibe", "import ./c.vibe { base }\nexport let val_from_c = base + 10"),
    ("c.vibe", "export let base = 5")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "15"))
}

test "import module not found" {
  let sources = [
    ("main.vibe", "import ./missing.vibe { x }\nlet result = x")
  ]
  let result = run_with_imports(sources, "main.vibe", "result")
  assert(String::starts_with(result, "ERROR: module not found"))
}

test "import enum export" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { Some, None }\nlet result = Some(42)"),
    ("lib.vibe", "export enum MyOpt { Some(Int); None }")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "Some(42)"))
}
