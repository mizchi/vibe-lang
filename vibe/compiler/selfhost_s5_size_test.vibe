//# Imports

import ./codegen.vibe {
  compile_wasi_module
}

import ./selfhost_s5_test_support.vibe {
  load_selfhost_merged
}

//# Misc

test "S5: check WASM output size (~385KB)" {
  let bytes = compile_wasi_module(load_selfhost_merged(), "run")
  let len = Bytes::length(bytes)
  assert(len > 300000)
  assert(len < 500000)
}
