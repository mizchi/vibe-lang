//# Types

export enum CheckError {
  CEUnboundVar(String);
  CETypeMismatch(String, String);
  CEArityMismatch(String, Int, Int);
  CENotCallable(String);
  CEUnknownField(String, String);
  CEUnknownCtor(String);
  CEDuplicateDecl(String)
}

//# Functions

export let add_error: (Array[CheckError], CheckError) -> Unit = (errors, err) -> {
  Array::push(errors, err)
}

export let has_errors: (Array[CheckError]) -> Bool = (errors) -> {
  Array::length(errors) > 0
}

export let new_errors: () -> Array[CheckError] = () -> {
  Array::slice([
    CEUnboundVar("")
  ], 0, 0)
}

export let check_error_to_string: (CheckError) -> String = (err) -> {
  match err {
    CEUnboundVar(name) => "unbound variable: \{name}",
    CETypeMismatch(expected, got) => "type mismatch: expected \{expected}, got \{got}",
    CEArityMismatch(name, expected, got) => "arity mismatch: \{name} expects \{expected} args, got \{got}",
    CENotCallable(expr) => "not callable: \{expr}",
    CEUnknownField(ty, field) => "unknown field \{field} on \{ty}",
    CEUnknownCtor(name) => "unknown constructor: \{name}",
    CEDuplicateDecl(name) => "duplicate declaration: \{name}"
  }
}

let rec format_errors_from: (Array[CheckError], Int, Int) -> String = (errors, i, len) -> {
  let head = check_error_to_string(Array::get(errors, i))
  if i + 1 >= len {
    head
  } else {
    String::concat(head, String::concat("\n", format_errors_from(errors, i + 1, len)))
  }
}

export let format_errors: (Array[CheckError]) -> String = (errors) -> {
  let len = Array::length(errors)
  if eq(len, 0) {
    ""
  } else {
    format_errors_from(errors, 0, len)
  }
}
