//# Types

export enum CheckError {
  CEUnboundVar(String);
  CETypeMismatch(String, String);
  CEArityMismatch(String, Int, Int);
  CENotCallable(String);
  CEUnknownField(String, String);
  CEUnknownCtor(String);
  CEDuplicateDecl(String)
}

//# Functions

export let check_error_to_string = (err: CheckError) -> String {
  match err {
    CEUnboundVar(name) => string_concat("unbound variable: ", name),
    CETypeMismatch(expected, got) => string_concat(string_concat(string_concat("type mismatch: expected ", expected), ", got "), got),
    CEArityMismatch(name, expected, got) => string_concat(string_concat(string_concat(string_concat(string_concat("arity mismatch: ", name), " expects "), __to_string(expected)), " args, got "), __to_string(got)),
    CENotCallable(expr) => string_concat("not callable: ", expr),
    CEUnknownField(ty, field) => string_concat(string_concat(string_concat("unknown field ", field), " on "), ty),
    CEUnknownCtor(name) => string_concat("unknown constructor: ", name),
    CEDuplicateDecl(name) => string_concat("duplicate declaration: ", name)
  }
}

export let new_errors = () -> Array[CheckError] {
  array_slice([CEUnboundVar("")], 0, 0)
}

export let add_error = (errors: Array[CheckError], err: CheckError) -> Unit {
  array_push(errors, err)
}

export let has_errors = (errors: Array[CheckError]) -> Bool {
  array_length(errors) > 0
}

export let format_errors = (errors: Array[CheckError]) -> String {
  let len = array_length(errors)
  if eq(len, 0) {
    ""
  } else {
    let mut result = check_error_to_string(array_get(errors, 0))
    let mut i = 1
    while i < len {
      result = string_concat(string_concat(result, "\n"), check_error_to_string(array_get(errors, i)))
      i = i + 1
    }
    result
  }
}
