//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./checker_stmt.vibe {
  check_stmts
}

import ./types.vibe {
  Subst, Type, TypeDef, TypeEnv, env_lookup, types_equal
}

//# Functions

let empty_defs: () -> Array[TypeDef] = () -> {
  Array::slice([
    TDAlias("_dummy", Array::slice([""], 0, 0), CtUnit)
  ], 0, 0)
}

let check_stmts_compat: (Array[Stmt]) -> TypeEnv = (stmts) -> {
  let errors = Array::slice([
    ""
  ], 0, 0)
  let (env, _, _) = check_stmts(stmts, 0, EnvEmpty, empty_defs(), SubstEmpty, 0, errors)
  env
}

//# Misc

test "enum nullary constructor typed as CtEnum" {
  let stmts = [
    SEnum(false, "Color", Array::slice([""], 0, 0), [
      ("Red", Array::slice([
        TyUnit
      ], 0, 0)),
      ("Green", Array::slice([
        TyUnit
      ], 0, 0)),
      ("Blue", Array::slice([
        TyUnit
      ], 0, 0))
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "Red") {
    Some(t) => assert(types_equal(t, CtEnum("Color"))),
    None => assert(false)
  }
  match env_lookup(env, "Green") {
    Some(t) => assert(types_equal(t, CtEnum("Color"))),
    None => assert(false)
  }
}

test "enum unary constructor typed as CtFn" {
  let stmts = [
    SEnum(false, "Option2", Array::slice([""], 0, 0), [
      ("Some2", [
        TyName("Int")
      ]),
      ("None2", Array::slice([
        TyUnit
      ], 0, 0))
    ])
  ]
  let env = check_stmts_compat(stmts)
  // Some2 should be a function Int -> Option2
  match env_lookup(env, "Some2") {
    Some(t) => assert(types_equal(t, CtFn([
      CtInt
    ], CtEnum("Option2"), None))),
    None => assert(false)
  }
  // None2 should be CtEnum (nullary)
  match env_lookup(env, "None2") {
    Some(t) => assert(types_equal(t, CtEnum("Option2"))),
    None => assert(false)
  }
}

test "enum multi-arg constructor typed as CtFn" {
  let stmts = [
    SEnum(false, "Expr2", Array::slice([""], 0, 0), [
      ("Add2", [
        TyName("Int"),
        TyName("Int")
      ]),
      ("Lit2", [
        TyName("Int")
      ])
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "Add2") {
    Some(t) => assert(types_equal(t, CtFn([
      CtInt,
      CtInt
    ], CtEnum("Expr2"), None))),
    None => assert(false)
  }
  match env_lookup(env, "Lit2") {
    Some(t) => assert(types_equal(t, CtFn([
      CtInt
    ], CtEnum("Expr2"), None))),
    None => assert(false)
  }
}

test "struct constructor typed as CtFn" {
  let stmts = [
    SStruct(false, "Point", [
      ("x", TyName("Int")),
      ("y", TyName("Int"))
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "Point") {
    Some(t) => assert(types_equal(t, CtFn([
      CtInt,
      CtInt
    ], CtStruct("Point"), None))),
    None => assert(false)
  }
}

test "calling enum constructor returns CtEnum" {
  let stmts = [
    SEnum(false, "MyOpt", Array::slice([""], 0, 0), [
      ("MySome", [
        TyName("Int")
      ]),
      ("MyNone", Array::slice([
        TyUnit
      ], 0, 0))
    ]),
    SLet(false, false, "x", None, ECall(EIdent("MySome", -1), [
      EInt(42)
    ]))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtEnum("MyOpt"))),
    None => assert(false)
  }
}

test "generic enum constructor instantiates payload into return" {
  let stmts = [
    SEnum(false, "Result2", [
      "T"
    ], [
      ("Ok2", [
        TyName("T")
      ]),
      ("Err2", Array::slice([
        TyUnit
      ], 0, 0))
    ]),
    SLet(false, false, "x", None, ECall(EIdent("Ok2", -1), [
      EInt(42)
    ]))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtNamed("Result2", [
      CtInt
    ]))),
    None => assert(false)
  }
}

test "enum type name still bound as CtEnum" {
  let stmts = [
    SEnum(false, "Dir", Array::slice([""], 0, 0), [
      ("Up", Array::slice([
        TyUnit
      ], 0, 0)),
      ("Down", Array::slice([
        TyUnit
      ], 0, 0))
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "Dir") {
    Some(t) => assert(types_equal(t, CtEnum("Dir"))),
    None => assert(false)
  }
}
