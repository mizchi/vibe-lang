//# Imports

import ./printer_test_support.vibe {
  roundtrip
}

//# Misc

test "roundtrip binop" {
  let ok = handle {
    roundtrip("1 + 2")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip precedence" {
  let ok = handle {
    roundtrip("1 + 2 * 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip left assoc" {
  let ok = handle {
    roundtrip("1 + 2 + 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip parens" {
  let ok = handle {
    roundtrip("(1 + 2) * 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip unary" {
  let ok = handle {
    roundtrip("-1")
  } {
    Error(_) => false
  }
  assert(ok)
}
