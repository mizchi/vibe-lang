//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./eval.vibe {
  eval_expr
}

import ./eval_loader.vibe {
  collect_exports, contains_str, load_and_parse, source_lookup
}

import ./values.vibe {
  ModuleCtx, ValEnv, Value, empty_module_ctx, module_ctx_new, val_env_bind, val_env_lookup, value_to_string
}

//# Functions

let dir_of = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  }
  else {
    file_path[0:idx]
  }
}

let resolve_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  if len >= 3 {
    if raw_path[0:3] == "../" {
      let rest = raw_path[3:len]
      let parent = dir_of(base_dir)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      }
      else {
        String::concat(rest, ".vibe")
      }
      if parent == "" {
        resolved
      }
      else {
        String::concat(parent, String::concat("/", resolved))
      }
    }
    else if raw_path[0:2] == "./" {
      let rest = raw_path[2:len]
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      }
      else {
        String::concat(rest, ".vibe")
      }
      if base_dir == "" {
        resolved
      }
      else {
        String::concat(base_dir, String::concat("/", resolved))
      }
    }
    else {
      raw_path
    }
  }
  else if len >= 2 {
    if raw_path[0:2] == "./" {
      let rest = raw_path[2:len]
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      }
      else {
        String::concat(rest, ".vibe")
      }
      if base_dir == "" {
        resolved
      }
      else {
        String::concat(base_dir, String::concat("/", resolved))
      }
    }
    else {
      raw_path
    }
  }
  else {
    raw_path
  }
}

let empty_ctor_args = Array::slice([
  VUnit
], 0, 0)

let rec bind_enum_ctors = (variants: Array[(String, Array[TypeExpr])], i: Int, env: ValEnv) -> ValEnv {
  if i >= Array::length(variants) {
    env
  }
  else {
    let (cname, _) = Array::get(variants, i)
    let env2 = val_env_bind(env, cname, VCtor(cname, empty_ctor_args))
    bind_enum_ctors(variants, i + 1, env2)
  }
}

let export_has_namespace = (exports: Array[String], name: String) -> Bool {
  let prefix = String::concat(name, "::")
  let rec go = (i: Int) -> Bool {
    if i >= Array::length(exports) {
      false
    }
    else if String::starts_with(Array::get(exports, i), prefix) {
      true
    }
    else {
      go(i + 1)
    }
  }
  go(0)
}

let bind_namespace_exports = (env: ValEnv, module_env: ValEnv, exports: Array[String], original_name: String, bind_name: String) -> ValEnv {
  let prefix = String::concat(original_name, "::")
  let bind_prefix = String::concat(bind_name, "::")
  let rec go = (i: Int, acc: ValEnv) -> ValEnv {
    if i >= Array::length(exports) {
      acc
    }
    else {
      let exported_name = Array::get(exports, i)
      if String::starts_with(exported_name, prefix) {
        let rebound_name = if bind_name == original_name {
          exported_name
        }
        else {
          String::concat(bind_prefix, String::substring(exported_name, String::length(prefix), String::length(exported_name)))
        }
        let next_env = match val_env_lookup(module_env, exported_name) {
          Some(val) => val_env_bind(acc, rebound_name, val),
          None => acc
        }
        go(i + 1, next_env)
      }
      else {
        go(i + 1, acc)
      }
    }
  }
  go(0, env)
}

let rec bind_import_names = (names: Array[(String, Option[String])], j: Int, env: ValEnv, module_env: ValEnv, exports: Array[String]) -> ValEnv {
  if j >= Array::length(names) {
    env
  }
  else {
    let (name, alias) = Array::get(names, j)
    let bind_name = match alias {
      Some(a) => a,
      None => name
    }
    let next_env = if contains_str(exports, name) {
      let v = match val_env_lookup(module_env, name) {
        Some(val) => val,
        None => VUnit
      }
      val_env_bind(env, bind_name, v)
    }
    else if export_has_namespace(exports, name) {
      bind_namespace_exports(env, module_env, exports, name, bind_name)
    }
    else {
      val_env_bind(env, bind_name, VUnit)
    }
    bind_import_names(names, j + 1, next_env, module_env, exports)
  }
}

export let rec eval_stmts = (stmts: Array[Stmt], i: Int, env: ValEnv, ctx: ModuleCtx) -> ValEnv with { Error } {
  if i >= Array::length(stmts) {
    env
  }
  else {
    let stmt = Array::get(stmts, i)
    let new_env = match stmt {
      SLet(_, is_rec, name, _, val_expr) => if is_rec {
        let env_placeholder = val_env_bind(env, name, VUnit)
        let (v, env2) = eval_expr(val_expr, env_placeholder)
        let final_v = match v {
          VFn(captures, params, body_idx, _) => VFn(captures, params, body_idx, Some(name)),
          _ => v
        }
        val_env_bind(env2, name, final_v)
      } else {
        let (v, env2) = eval_expr(val_expr, env)
        val_env_bind(env2, name, v)
      }
      ,
      SLetMut(name, _, val_expr) => {
        let (v, env2) = eval_expr(val_expr, env)
        val_env_bind(env2, name, v)
      },
      SEnum(_, _, variants) => bind_enum_ctors(variants, 0, env),
      SSuberror(_, _, variants) => bind_enum_ctors(variants, 0, env),
      SEffectDef(_, _, _, _) => env,
      STest(_, body) => {
        let (_tv, _te) = eval_expr(body, env)
        env
      },
      SExpr(body) => {
        let (_ev, env2) = eval_expr(body, env)
        env2
      },
      SImport(raw_path, names) => match ctx {
        ModuleCtx(sources, loading, base_dir) => {
          let resolved = resolve_path(base_dir, raw_path)
          if contains_str(loading, resolved) {
            throw(String::concat("import cycle detected: ", resolved))
          }
          match source_lookup(sources, resolved) {
            None => throw(String::concat("module not found: ", resolved)),
            Some(source) => {
              let module_stmts = load_and_parse(source)
              let new_loading = Array::concat(loading, [
                resolved
              ])
              let new_base = dir_of(resolved)
              let child_ctx = ModuleCtx(sources, new_loading, new_base)
              let module_env = eval_stmts(module_stmts, 0, VEnvEmpty, child_ctx)
              let exports = collect_exports(module_stmts)
              bind_import_names(names, 0, env, module_env, exports)
            }
          }
        }
      }
      ,
      _ => env
    }
    eval_stmts(stmts, i + 1, new_env, ctx)
  }
}

export let eval_program = (stmts: Array[Stmt]) -> ValEnv {
  handle {
    eval_stmts(stmts, 0, VEnvEmpty, empty_module_ctx())
  } {
    Error(_) => VEnvEmpty
  }
}

export let eval_and_lookup = (stmts: Array[Stmt], name: String) -> String {
  let env = eval_program(stmts)
  match val_env_lookup(env, name) {
    Some(v) => value_to_string(v),
    None => "<not found>"
  }
}

export let run_source = (source: String, name: String) -> String {
  handle {
    let stmts = load_and_parse(source)
    eval_and_lookup(stmts, name)
  } {
    Error(msg) => String::concat("ERROR: ", msg)
  }
}

export let eval_with_imports = (stmts: Array[Stmt], sources: Array[(String, String)], base_dir: String) -> ValEnv with { Error } {
  let ctx = module_ctx_new(sources, base_dir)
  eval_stmts(stmts, 0, VEnvEmpty, ctx)
}

export let eval_with_imports_lookup = (stmts: Array[Stmt], sources: Array[(String, String)], base_dir: String, name: String) -> String with { Error } {
  let env = eval_with_imports(stmts, sources, base_dir)
  match val_env_lookup(env, name) {
    Some(v) => value_to_string(v),
    None => "<not found>"
  }
}

export let run_source_with_imports = (sources: Array[(String, String)], main_key: String, lookup_name: String) -> String {
  handle {
    match source_lookup(sources, main_key) {
      None => throw(String::concat("main module not found: ", main_key)),
      Some(main_src) => {
        let stmts = load_and_parse(main_src)
        let base_dir = dir_of(main_key)
        eval_with_imports_lookup(stmts, sources, base_dir, lookup_name)
      }
    }
  } {
    Error(msg) => String::concat("ERROR: ", msg)
  }
}
