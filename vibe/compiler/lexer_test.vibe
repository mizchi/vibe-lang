//# Imports

import ./lexer.vibe {
  lex, lex_ok
}

import ./token.vibe {
  Token, token_to_string
}

//# Functions

let tokens_match = (actual: Array[Token], expected: Array[Token]) -> Bool {
  if Array::length(actual) != Array::length(expected) {
    false
  } else {
    let len = Array::length(actual)
    let rec go = (i: Int) -> Bool {
      if i >= len {
        true
      } else {
        let a = token_to_string(Array::get(actual, i))
        let b = token_to_string(Array::get(expected, i))
        if a == b {
          go(i + 1)
        } else false
      }
    }
    go(0)
  }
}

let assert_string_interp_parts = (source: String, expected: Array[String]) -> Unit {
  let tokens = lex(source)
  match Array::get(tokens, 0) {
    TStringInterp(parts) => {
      assert(eq(Array::length(parts), Array::length(expected)))
      let len = Array::length(expected)
      let mut i = 0
      while i < len {
        assert(Array::get(parts, i) == Array::get(expected, i))
        i = i + 1
      }
    },
    _ => assert(false)
  }
}

//# Misc

test "lex_simple_arithmetic" {
  let tokens = lex("1 + 2 * 3")
  assert(eq(Array::length(tokens), 6))
  assert(tokens_match(tokens, [
    TInt(1),
    TPlus,
    TInt(2),
    TStar,
    TInt(3),
    TEof
  ]))
}

test "lex_identifiers_and_keywords" {
  let tokens = lex("let x = fn y")
  assert(tokens_match(tokens, [
    TLet,
    TIdent("x"),
    TEq,
    TIdent("fn"),
    TIdent("y"),
    TEof
  ]))
}

test "lex_comparison_operators" {
  let tokens = lex("a == b != c < d <= e > f >= g")
  assert(eq(Array::length(tokens), 14))
}

test "lex_logical_operators" {
  let tokens = lex("a && b || !c")
  assert(tokens_match(tokens, [
    TIdent("a"),
    TAnd,
    TIdent("b"),
    TOr,
    TNot,
    TIdent("c"),
    TEof
  ]))
}

test "lex_bitwise_operators" {
  let tokens = lex("a & b | c ^ d << e >> f")
  assert(tokens_match(tokens, [
    TIdent("a"),
    TBitAnd,
    TIdent("b"),
    TBitOr,
    TIdent("c"),
    TBitXor,
    TIdent("d"),
    TLShift,
    TIdent("e"),
    TRShift,
    TIdent("f"),
    TEof
  ]))
}

test "lex_arrows_and_pipe" {
  let tokens = lex("x -> y => z |> w")
  assert(tokens_match(tokens, [
    TIdent("x"),
    TThinArrow,
    TIdent("y"),
    TArrow,
    TIdent("z"),
    TPipeGt,
    TIdent("w"),
    TEof
  ]))
}

test "lex_delimiters" {
  let tokens = lex("( ) { } [ ] , ; . : ::")
  assert(tokens_match(tokens, [
    TLParen,
    TRParen,
    TLBrace,
    TRBrace,
    TLBracket,
    TRBracket,
    TComma,
    TSemicolon,
    TDot,
    TColon,
    TDoubleColon,
    TEof
  ]))
}

test "lex_string_literal" {
  let tokens = lex("\"hello world\"")
  assert(tokens_match(tokens, [
    TString("hello world"),
    TEof
  ]))
}

test "lex_string_escape" {
  let tokens = lex("\"a\\nb\\tc\"")
  assert(tokens_match(tokens, [
    TString("a\nb\tc"),
    TEof
  ]))
}

test "lex_string_interp_basic" {
  assert_string_interp_parts("\"hello \\{name}\"", [
    "hello ",
    "name",
    ""
  ])
}

test "lex_string_interp_multiple" {
  assert_string_interp_parts("\"\\{a} + \\{b} = \\{a + b}\"", [
    "",
    "a",
    " + ",
    "b",
    " = ",
    "a + b",
    ""
  ])
}

test "lex_string_interp_nested_braces" {
  assert_string_interp_parts("\"value \\{if ok { left } else { right }}\"", [
    "value ",
    "if ok { left } else { right }",
    ""
  ])
}

test "lex_integer" {
  let tokens = lex("42")
  assert(tokens_match(tokens, [
    TInt(42),
    TEof
  ]))
}

test "lex_hex_integer" {
  let tokens = lex("0xFF")
  assert(tokens_match(tokens, [
    TInt(255),
    TEof
  ]))
}

test "lex_float" {
  let tokens = lex("3.14")
  assert(eq(Array::length(tokens), 2))
}

test "lex_comment_skip" {
  let tokens = lex("a // comment\nb")
  assert(tokens_match(tokens, [
    TIdent("a"),
    TIdent("b"),
    TEof
  ]))
}

test "lex_empty" {
  let tokens = lex("")
  assert(tokens_match(tokens, [
    TEof
  ]))
}

test "lex_whitespace_only" {
  let tokens = lex("   \n\t  ")
  assert(tokens_match(tokens, [
    TEof
  ]))
}

test "lex_compound_assignment" {
  let tokens = lex("x += 1")
  assert(tokens_match(tokens, [
    TIdent("x"),
    TPlusEq,
    TInt(1),
    TEof
  ]))
}

test "lex_keywords_all" {
  assert(lex_ok("let rec mut fn if else match do"))
  assert(lex_ok("enum struct type trait impl export import test"))
  assert(lex_ok("while for in loop break continue return"))
  assert(lex_ok("with handle throw raise yield"))
}

test "lex_if_expression" {
  let tokens = lex("if x > 0 { x } else { 0 }")
  assert(eq(Array::length(tokens), 12))
}

test "lex_match_expression" {
  assert(lex_ok("match x { 1 => a, _ => b }"))
}

test "lex_true_false_as_ident" {
  let tokens = lex("true false")
  assert(tokens_match(tokens, [
    TIdent("true"),
    TIdent("false"),
    TEof
  ]))
}

test "tokens_match_negative" {
  assert(!tokens_match([
    TInt(1),
    TEof
  ], [
    TInt(2),
    TEof
  ]))
  assert(!tokens_match([
    TInt(1)
  ], [
    TInt(1),
    TEof
  ]))
}

test "lex_char_literal_and_escapes" {
  let tokens = lex("'a' '\\n' '\\'' '\\\\' '\\0'")
  assert(tokens_match(tokens, [
    TInt(97),
    TInt(10),
    TInt(39),
    TInt(92),
    TInt(0),
    TEof
  ]))
}

test "lex_string_escape_extended" {
  assert(lex_ok("\"a\\r\""))
  assert(lex_ok("\"a\\\\b\""))
}

test "lex_more_operators" {
  let tokens = lex("x -= 1 y *= 2 z /= 3 w %= 4 ~a #b ?c")
  assert(tokens_match(tokens, [
    TIdent("x"),
    TMinusEq,
    TInt(1),
    TIdent("y"),
    TStarEq,
    TInt(2),
    TIdent("z"),
    TSlashEq,
    TInt(3),
    TIdent("w"),
    TPercentEq,
    TInt(4),
    TTilde,
    TIdent("a"),
    THash,
    TIdent("b"),
    TQuestion,
    TIdent("c"),
    TEof
  ]))
}

test "lex_keyword_tail_set" {
  assert(lex_ok("suberror declare module derive open as"))
}

test "lex_comment_eof" {
  let tokens = lex("a // trailing comment")
  assert(tokens_match(tokens, [
    TIdent("a"),
    TEof
  ]))
}

test "lex_error_paths" {
  assert(!lex_ok("'"))
  assert(!lex_ok("\"unterminated"))
  assert(!lex_ok("@"))
}
