//# Imports

import ./codegen_test_support.vibe {
  assert_wasm, compile_wasi, compile_wasi_gc
}

//# Misc

test "wasi: struct create and field access" {
  let bytes = compile_wasi("struct Point { x: Int; y: Int }\nexport let main: () -> Int = () -> { let p = Point::{ x: 10, y: 20 }; p.x + p.y }", "main")
  assert_wasm(bytes)
}

test "wasi: struct field order independence" {
  let bytes = compile_wasi("struct Point { x: Int; y: Int }\nexport let main: () -> Int = () -> { let p = Point::{ y: 99, x: 1 }; p.x }", "main")
  assert_wasm(bytes)
}

test "gc: struct create and field access" {
  let bytes = compile_wasi_gc("struct Point { x: Int; y: Int }\nexport let main: () -> Int = () -> { let p = Point::{ x: 5, y: 15 }; p.x + p.y }", "main")
  assert_wasm(bytes)
}

test "wasi: struct destructuring let" {
  let bytes = compile_wasi("struct Point { x: Int; y: Int }\nexport let main: () -> Int = () -> { let p = Point::{ x: 10, y: 20 }\nlet Point::{ x, y } = p\nx + y }", "main")
  assert_wasm(bytes)
}
