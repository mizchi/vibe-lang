//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./eval_builtins.vibe {
  eval_builtin_call
}

import ./values.vibe {
  ValEnv, Value, val_env_bind, val_env_bind_all, val_env_lookup, value_to_string, values_equal
}

//# Functions

let _no_tp = Array::slice([
  ""
], 0, 0)

let _no_tb = Array::slice([
  ("", _no_tp)
], 0, 0)

let rec decode_pat = (v: Value) -> Pat {
  let rec go_arr_inner = (arr: Array[Value], i: Int, len: Int) -> Array[Pat] {
    if i >= len {
      Array::slice([
        PWild
      ], 0, 0)
    }
    else {
      Array::concat([
        decode_pat(Array::get(arr, i))
      ], go_arr_inner(arr, i + 1, len))
    }
  }
  let go_arr = (v2: Value) -> Array[Pat] {
    match v2 {
      VArray(arr) => go_arr_inner(arr, 0, Array::length(arr)),
      _ => Array::slice([
        PWild
      ], 0, 0)
    }
  }
  match v {
    VArray(arr) => if eq(Array::length(arr), 0) {
      PWild
    }
    else {
      let tag = match Array::get(arr, 0) {
        VString(t) => t,
        _ => "PW"
      }
      if String::equals(tag, "PW") {
        PWild
      }
      else if String::equals(tag, "PB") {
        PBind(match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        })
      }
      else if String::equals(tag, "PI") {
        PInt(match Array::get(arr, 1) {
          VInt(n) => n,
          _ => 0
        })
      }
      else if String::equals(tag, "PS") {
        PString(match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        })
      }
      else if String::equals(tag, "PL") {
        PBool(match Array::get(arr, 1) {
          VBool(bv) => bv,
          _ => false
        })
      }
      else if String::equals(tag, "PC") {
        let name = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        }
        PCtor(name, go_arr(Array::get(arr, 2)))
      }
      else if String::equals(tag, "PT") {
        PTuple(go_arr(Array::get(arr, 1)))
      }
      else if String::equals(tag, "PO") {
        POr(decode_pat(Array::get(arr, 1)), decode_pat(Array::get(arr, 2)))
      }
      else PWild
    }
    ,
    _ => PWild
  }
}

let eval_binop = (op: String, lv: Value, rv: Value) -> Value {
  if String::equals(op, "+") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VInt(a + b),
        _ => VUnit
      },
      VFloat(a) => match rv {
        VFloat(b) => VFloat(a + b),
        _ => VUnit
      },
      VString(a) => match rv {
        VString(b) => VString(String::concat(a, b)),
        _ => VUnit
      },
      _ => VUnit
    }
  }
  else if String::equals(op, "-") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VInt(a - b),
        _ => VUnit
      },
      VFloat(a) => match rv {
        VFloat(b) => VFloat(a - b),
        _ => VUnit
      },
      _ => VUnit
    }
  }
  else if String::equals(op, "*") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VInt(a * b),
        _ => VUnit
      },
      VFloat(a) => match rv {
        VFloat(b) => VFloat(a * b),
        _ => VUnit
      },
      _ => VUnit
    }
  }
  else if String::equals(op, "/") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VInt(a / b),
        _ => VUnit
      },
      VFloat(a) => match rv {
        VFloat(b) => VFloat(a / b),
        _ => VUnit
      },
      _ => VUnit
    }
  }
  else if String::equals(op, "%") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VInt(a % b),
        _ => VUnit
      },
      _ => VUnit
    }
  }
  else if String::equals(op, "==") {
    VBool(values_equal(lv, rv))
  }
  else if String::equals(op, "!=") {
    VBool(not(values_equal(lv, rv)))
  }
  else if String::equals(op, "<") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VBool(a < b),
        _ => VBool(false)
      },
      _ => VBool(false)
    }
  }
  else if String::equals(op, ">") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VBool(a > b),
        _ => VBool(false)
      },
      _ => VBool(false)
    }
  }
  else if String::equals(op, "<=") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VBool(a <= b),
        _ => VBool(false)
      },
      _ => VBool(false)
    }
  }
  else if String::equals(op, ">=") {
    match lv {
      VInt(a) => match rv {
        VInt(b) => VBool(a >= b),
        _ => VBool(false)
      },
      _ => VBool(false)
    }
  }
  else VUnit
}

export let rec decode_expr = (v: Value) -> Expr {
  let rec go_exprs_inner = (arr: Array[Value], i: Int, len: Int) -> Array[Expr] {
    if i >= len {
      Array::slice([
        EUnit
      ], 0, 0)
    }
    else {
      Array::concat([
        decode_expr(Array::get(arr, i))
      ], go_exprs_inner(arr, i + 1, len))
    }
  }
  let go_exprs = (v2: Value) -> Array[Expr] {
    match v2 {
      VArray(arr) => {
        let len = Array::length(arr)
        if eq(len, 0) {
          Array::slice([
            EUnit
          ], 0, 0)
        }
        else {
          go_exprs_inner(arr, 0, len)
        }
      },
      _ => Array::slice([
        EUnit
      ], 0, 0)
    }
  }
  let rec go_fields_inner = (arr: Array[Value], i: Int, len: Int) -> Array[(String, Expr)] {
    if i >= len {
      Array::slice([
        ("_", EUnit)
      ], 0, 0)
    }
    else {
      let entry = Array::get(arr, i)
      let (name, fexpr) = match entry {
        VArray(ea) => {
          let n = match Array::get(ea, 0) {
            VString(sv) => sv,
            _ => ""
          }
          (n, decode_expr(Array::get(ea, 1)))
        },
        _ => ("", EUnit)
      }
      Array::concat([
        (name, fexpr)
      ], go_fields_inner(arr, i + 1, len))
    }
  }
  let go_fields = (v2: Value) -> Array[(String, Expr)] {
    match v2 {
      VArray(arr) => go_fields_inner(arr, 0, Array::length(arr)),
      _ => Array::slice([
        ("_", EUnit)
      ], 0, 0)
    }
  }
  let rec go_params_inner = (arr: Array[Value], i: Int, len: Int) -> Array[(String, Option[TypeExpr])] {
    if i >= len {
      Array::slice([
        ("_", None)
      ], 0, 0)
    }
    else {
      let name = match Array::get(arr, i) {
        VString(sv) => sv,
        _ => ""
      }
      Array::concat([
        (name, None)
      ], go_params_inner(arr, i + 1, len))
    }
  }
  let go_params = (v2: Value) -> Array[(String, Option[TypeExpr])] {
    match v2 {
      VArray(arr) => go_params_inner(arr, 0, Array::length(arr)),
      _ => Array::slice([
        ("_", None)
      ], 0, 0)
    }
  }
  let rec go_arms_inner = (arr: Array[Value], i: Int, len: Int) -> Array[(Pat, Expr)] {
    if i >= len {
      Array::slice([
        (PWild, EUnit)
      ], 0, 0)
    }
    else {
      let entry = Array::get(arr, i)
      let arm = match entry {
        VArray(ea) => (decode_pat(Array::get(ea, 0)), decode_expr(Array::get(ea, 1))),
        _ => (PWild, EUnit)
      }
      Array::concat([
        arm
      ], go_arms_inner(arr, i + 1, len))
    }
  }
  let go_arms = (v2: Value) -> Array[(Pat, Expr)] {
    match v2 {
      VArray(arr) => go_arms_inner(arr, 0, Array::length(arr)),
      _ => Array::slice([
        (PWild, EUnit)
      ], 0, 0)
    }
  }
  match v {
    VArray(arr) => if eq(Array::length(arr), 0) {
      EUnit
    }
    else {
      let tag = match Array::get(arr, 0) {
        VString(t) => t,
        _ => "u"
      }
      if String::equals(tag, "i") {
        EInt(match Array::get(arr, 1) {
          VInt(n) => n,
          _ => 0
        })
      }
      else if String::equals(tag, "f") {
        EFloat(match Array::get(arr, 1) {
          VFloat(fv) => fv,
          _ => 0.0
        })
      }
      else if String::equals(tag, "s") {
        EString(match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        })
      }
      else if String::equals(tag, "b") {
        EBool(match Array::get(arr, 1) {
          VBool(bv) => bv,
          _ => false
        })
      }
      else if String::equals(tag, "u") {
        EUnit
      }
      else if String::equals(tag, "d") {
        EIdent(match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        })
      }
      else if String::equals(tag, "bo") {
        let op = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => "+"
        }
        EBinOp(op, decode_expr(Array::get(arr, 2)), decode_expr(Array::get(arr, 3)))
      }
      else if String::equals(tag, "uo") {
        let op = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => "-"
        }
        EUnaryOp(op, decode_expr(Array::get(arr, 2)))
      }
      else if String::equals(tag, "lt") {
        let name = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        }
        ELet(name, decode_expr(Array::get(arr, 2)), decode_expr(Array::get(arr, 3)))
      }
      else if String::equals(tag, "lr") {
        let name = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        }
        ELetRec(name, decode_expr(Array::get(arr, 2)), decode_expr(Array::get(arr, 3)))
      }
      else if String::equals(tag, "lm") {
        let name = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        }
        ELetMut(name, decode_expr(Array::get(arr, 2)), decode_expr(Array::get(arr, 3)))
      }
      else if String::equals(tag, "as") {
        let name = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        }
        EAssign(name, decode_expr(Array::get(arr, 2)), decode_expr(Array::get(arr, 3)))
      }
      else if String::equals(tag, "ao") {
        let name = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        }
        let op = match Array::get(arr, 2) {
          VString(sv) => sv,
          _ => "+"
        }
        EAssignOp(name, op, decode_expr(Array::get(arr, 3)), decode_expr(Array::get(arr, 4)))
      }
      else if String::equals(tag, "sq") {
        ESeq(decode_expr(Array::get(arr, 1)), decode_expr(Array::get(arr, 2)))
      }
      else if String::equals(tag, "if") {
        EIf(decode_expr(Array::get(arr, 1)), decode_expr(Array::get(arr, 2)), decode_expr(Array::get(arr, 3)))
      }
      else if String::equals(tag, "ca") {
        ECall(decode_expr(Array::get(arr, 1)), go_exprs(Array::get(arr, 2)))
      }
      else if String::equals(tag, "tu") {
        ETuple(go_exprs(Array::get(arr, 1)))
      }
      else if String::equals(tag, "ar") {
        EArray(go_exprs(Array::get(arr, 1)))
      }
      else if String::equals(tag, "rc") {
        ERecord(go_fields(Array::get(arr, 1)))
      }
      else if String::equals(tag, "fn") {
        let params = go_params(Array::get(arr, 1))
        EFn(_no_tp, _no_tb, params, None, None, decode_expr(Array::get(arr, 2)))
      }
      else if String::equals(tag, "ma") {
        EMatch(decode_expr(Array::get(arr, 1)), go_arms(Array::get(arr, 2)))
      }
      else if String::equals(tag, "wh") {
        EWhile(decode_expr(Array::get(arr, 1)), decode_expr(Array::get(arr, 2)))
      }
      else if String::equals(tag, "fi") {
        let name = match Array::get(arr, 1) {
          VString(sv) => sv,
          _ => ""
        }
        EForIn(name, decode_expr(Array::get(arr, 2)), decode_expr(Array::get(arr, 3)))
      }
      else if String::equals(tag, "dt") {
        let field = match Array::get(arr, 2) {
          VString(sv) => sv,
          _ => ""
        }
        EDot(decode_expr(Array::get(arr, 1)), field)
      }
      else if String::equals(tag, "ha") {
        EHandle(decode_expr(Array::get(arr, 1)), go_arms(Array::get(arr, 2)))
      }
      else if String::equals(tag, "th") {
        EThrow(decode_expr(Array::get(arr, 1)))
      }
      else if String::equals(tag, "br") {
        EBreak(None)
      }
      else if String::equals(tag, "co") {
        EContinue(Array::slice([
          EUnit
        ], 0, 0))
      }
      else EUnit
    }
    ,
    _ => EUnit
  }
}

let empty_encoded = Array::slice([
  VUnit
], 0, 0)

let rec encode_pat = (p: Pat) -> Value {
  let rec go_arr = (pats: Array[Pat], i: Int) -> Value {
    if i >= Array::length(pats) {
      VArray(empty_encoded)
    }
    else {
      let rest = go_arr(pats, i + 1)
      match rest {
        VArray(rarr) => VArray(Array::concat([
          encode_pat(Array::get(pats, i))
        ], rarr)),
        _ => VArray([
          encode_pat(Array::get(pats, i))
        ])
      }
    }
  }
  match p {
    PWild => VArray([
      VString("PW")
    ]),
    PBind(name) => VArray([
      VString("PB"),
      VString(name)
    ]),
    PInt(n) => VArray([
      VString("PI"),
      VInt(n)
    ]),
    PString(s) => VArray([
      VString("PS"),
      VString(s)
    ]),
    PBool(b) => VArray([
      VString("PL"),
      VBool(b)
    ]),
    PCtor(name, pats) => VArray([
      VString("PC"),
      VString(name),
      go_arr(pats, 0)
    ]),
    PTuple(pats) => VArray([
      VString("PT"),
      go_arr(pats, 0)
    ]),
    POr(p1, p2) => VArray([
      VString("PO"),
      encode_pat(p1),
      encode_pat(p2)
    ])
  }
}

export let rec encode_expr = (expr: Expr) -> Value {
  let rec go_exprs = (exprs: Array[Expr], i: Int) -> Value {
    if i >= Array::length(exprs) {
      VArray(empty_encoded)
    }
    else {
      let rest = go_exprs(exprs, i + 1)
      match rest {
        VArray(rarr) => VArray(Array::concat([
          encode_expr(Array::get(exprs, i))
        ], rarr)),
        _ => VArray([
          encode_expr(Array::get(exprs, i))
        ])
      }
    }
  }
  let rec go_fields = (fields: Array[(String, Expr)], i: Int) -> Value {
    if i >= Array::length(fields) {
      VArray(empty_encoded)
    }
    else {
      let (name, fexpr) = Array::get(fields, i)
      let rest = go_fields(fields, i + 1)
      match rest {
        VArray(rarr) => VArray(Array::concat([
          VArray([
            VString(name),
            encode_expr(fexpr)
          ])
        ], rarr)),
        _ => VArray([
          VArray([
            VString(name),
            encode_expr(fexpr)
          ])
        ])
      }
    }
  }
  let rec go_params = (params: Array[(String, Option[TypeExpr])], i: Int) -> Value {
    if i >= Array::length(params) {
      VArray(empty_encoded)
    }
    else {
      let (name, _) = Array::get(params, i)
      let rest = go_params(params, i + 1)
      match rest {
        VArray(rarr) => VArray(Array::concat([
          VString(name)
        ], rarr)),
        _ => VArray([
          VString(name)
        ])
      }
    }
  }
  let rec go_arms = (arms: Array[(Pat, Expr)], i: Int) -> Value {
    if i >= Array::length(arms) {
      VArray(empty_encoded)
    }
    else {
      let (pat, aexpr) = Array::get(arms, i)
      let rest = go_arms(arms, i + 1)
      match rest {
        VArray(rarr) => VArray(Array::concat([
          VArray([
            encode_pat(pat),
            encode_expr(aexpr)
          ])
        ], rarr)),
        _ => VArray([
          VArray([
            encode_pat(pat),
            encode_expr(aexpr)
          ])
        ])
      }
    }
  }
  match expr {
    EInt(n) => VArray([
      VString("i"),
      VInt(n)
    ]),
    EFloat(f) => VArray([
      VString("f"),
      VFloat(f)
    ]),
    EString(s) => VArray([
      VString("s"),
      VString(s)
    ]),
    EBool(b) => VArray([
      VString("b"),
      VBool(b)
    ]),
    EUnit => VArray([
      VString("u")
    ]),
    EIdent(name) => VArray([
      VString("d"),
      VString(name)
    ]),
    EBinOp(op, left, right) => VArray([
      VString("bo"),
      VString(op),
      encode_expr(left),
      encode_expr(right)
    ]),
    EUnaryOp(op, operand) => VArray([
      VString("uo"),
      VString(op),
      encode_expr(operand)
    ]),
    ELet(name, val, body) => VArray([
      VString("lt"),
      VString(name),
      encode_expr(val),
      encode_expr(body)
    ]),
    ELetRec(name, val, body) => VArray([
      VString("lr"),
      VString(name),
      encode_expr(val),
      encode_expr(body)
    ]),
    ELetMut(name, val, body) => VArray([
      VString("lm"),
      VString(name),
      encode_expr(val),
      encode_expr(body)
    ]),
    EAssign(name, val, body) => VArray([
      VString("as"),
      VString(name),
      encode_expr(val),
      encode_expr(body)
    ]),
    EAssignOp(name, op, val, body) => VArray([
      VString("ao"),
      VString(name),
      VString(op),
      encode_expr(val),
      encode_expr(body)
    ]),
    ESeq(left, right) => VArray([
      VString("sq"),
      encode_expr(left),
      encode_expr(right)
    ]),
    EIf(cond, then_e, else_e) => VArray([
      VString("if"),
      encode_expr(cond),
      encode_expr(then_e),
      encode_expr(else_e)
    ]),
    ECall(callee, args) => VArray([
      VString("ca"),
      encode_expr(callee),
      go_exprs(args, 0)
    ]),
    ETuple(elems) => VArray([
      VString("tu"),
      go_exprs(elems, 0)
    ]),
    EArray(elems) => VArray([
      VString("ar"),
      go_exprs(elems, 0)
    ]),
    ERecord(fields) => VArray([
      VString("rc"),
      go_fields(fields, 0)
    ]),
    EFn(_, _, params, _, _, body) => VArray([
      VString("fn"),
      go_params(params, 0),
      encode_expr(body)
    ]),
    EMatch(scrutinee, arms) => VArray([
      VString("ma"),
      encode_expr(scrutinee),
      go_arms(arms, 0)
    ]),
    EWhile(cond, body) => VArray([
      VString("wh"),
      encode_expr(cond),
      encode_expr(body)
    ]),
    EForIn(name, iter, body) => VArray([
      VString("fi"),
      VString(name),
      encode_expr(iter),
      encode_expr(body)
    ]),
    EDot(obj, field) => VArray([
      VString("dt"),
      encode_expr(obj),
      VString(field)
    ]),
    EHandle(body, arms) => VArray([
      VString("ha"),
      encode_expr(body),
      go_arms(arms, 0)
    ]),
    EThrow(val) => VArray([
      VString("th"),
      encode_expr(val)
    ]),
    EBreak(_) => VArray([
      VString("br")
    ]),
    EContinue(_) => VArray([
      VString("co")
    ]),
    ELabeledArg(_, _, inner) => encode_expr(inner),
    _ => VArray([
      VString("u")
    ])
  }
}

export let rec match_pattern = (pat: Pat, v: Value) -> Option[Array[(String, Value)]] {
  let empty_binds = Array::slice([
    ("_", VUnit)
  ], 0, 0)
  let rec pats_to_binds = (pats: Array[Pat], vals: Array[Value], i: Int, acc: Array[(String, Value)]) -> Option[Array[(String, Value)]] {
    if i >= Array::length(pats) {
      Some(acc)
    }
    else {
      let p = Array::get(pats, i)
      let pv = Array::get(vals, i)
      match match_pattern(p, pv) {
        None => None,
        Some(binds) => pats_to_binds(pats, vals, i + 1, Array::concat(acc, binds))
      }
    }
  }
  match pat {
    PWild => Some(empty_binds),
    PBind(name) => Some([
      (name, v)
    ]),
    PInt(n) => match v {
      VInt(vi) => if eq(vi, n) {
        Some(empty_binds)
      } else {
        None
      },
      _ => None
    },
    PString(s) => match v {
      VString(sv) => if String::equals(sv, s) {
        Some(empty_binds)
      } else {
        None
      },
      _ => None
    },
    PBool(b) => match v {
      VBool(bv) => {
        let same = if b {
          bv
        } else {
          not(bv)
        }
        if same {
          Some(empty_binds)
        } else {
          None
        }
      },
      _ => None
    },
    PCtor(cname, pats) => match v {
      VCtor(vname, vargs) => if String::equals(cname, vname) {
        if eq(Array::length(pats), 0) {
          Some(empty_binds)
        }
        else {
          pats_to_binds(pats, vargs, 0, empty_binds)
        }
      } else {
        None
      }
      ,
      _ => None
    },
    PTuple(pats) => match v {
      VTuple(elems) => pats_to_binds(pats, elems, 0, empty_binds),
      _ => None
    },
    POr(p1, p2) => match match_pattern(p1, v) {
      Some(binds) => Some(binds),
      None => match_pattern(p2, v)
    }
  }
}

export let rec eval_expr = (expr: Expr, env: ValEnv) -> (Value, ValEnv)with { Error } {
  let apply_fn = (fn_val: Value, evaled_args: Array[Value], caller_env: ValEnv) -> (Value, ValEnv)with { Error } {
    match fn_val {
      VFn(captures, params, _, self_name) => {
        // First capture entry is ("__body", encoded_body)
        let encoded_body = if Array::length(captures) > 0 {
          let (key, bval) = Array::get(captures, 0)
          if String::equals(key, "__body") {
            bval
          } else {
            VUnit
          }
        } else {
          VUnit
        }
        let body = decode_expr(encoded_body)
        // Build fn env from remaining captures (skip __body)
        let real_captures = if Array::length(captures) > 1 {
          Array::slice(captures, 1, Array::length(captures))
        } else {
          Array::slice([
            ("_", VUnit)
          ], 0, 0)
        }
        let fn_env = val_env_bind_all(VEnvEmpty, real_captures)
        let fn_env2 = match self_name {
          Some(sn) => val_env_bind(fn_env, sn, fn_val),
          None => fn_env
        }
        let plen = Array::length(params)
        let rec bind_params = (i: Int, acc: ValEnv) -> ValEnv {
          if i >= plen {
            acc
          }
          else {
            let pname = Array::get(params, i)
            let pval = if i < Array::length(evaled_args) {
              Array::get(evaled_args, i)
            } else {
              VUnit
            }
            bind_params(i + 1, val_env_bind(acc, pname, pval))
          }
        }
        let fn_env3 = bind_params(0, fn_env2)
        // Propagate __bstore into function scope
        let fn_env4 = match val_env_lookup(caller_env, "__bstore") {
          Some(bs) => val_env_bind(fn_env3, "__bstore", bs),
          None => fn_env3
        }
        let (result, ret_env) = eval_expr(body, fn_env4)
        // Propagate __bstore back to caller
        let caller_env2 = match val_env_lookup(ret_env, "__bstore") {
          Some(bs) => val_env_bind(caller_env, "__bstore", bs),
          None => caller_env
        }
        (result, caller_env2)
      },
      VCtor(cname, _) => (VCtor(cname, evaled_args), caller_env),
      _ => (VUnit, caller_env)
    }
  }
  let rec eval_handle_arms = (arms: Array[(Pat, Expr)], err_msg: String, h_env: ValEnv, i: Int) -> (Value, ValEnv)with { Error } {
    if i >= Array::length(arms) {
      throw(err_msg)
    }
    else {
      let (pat, arm_expr) = Array::get(arms, i)
      let err_val = VCtor("Error", [
        VString(err_msg)
      ])
      match match_pattern(pat, err_val) {
        Some(binds) => {
          let arm_env = val_env_bind_all(h_env, binds)
          eval_expr(arm_expr, arm_env)
        },
        None => eval_handle_arms(arms, err_msg, h_env, i + 1)
      }
    }
  }
  let rec eval_match_arms = (arms: Array[(Pat, Expr)], scrutinee_val: Value, match_env: ValEnv, i: Int) -> (Value, ValEnv)with { Error } {
    if i >= Array::length(arms) {
      (VUnit, match_env)
    }
    else {
      let (pat, arm_expr) = Array::get(arms, i)
      match match_pattern(pat, scrutinee_val) {
        Some(binds) => {
          let arm_env = val_env_bind_all(match_env, binds)
          eval_expr(arm_expr, arm_env)
        },
        None => eval_match_arms(arms, scrutinee_val, match_env, i + 1)
      }
    }
  }
  let rec eval_while_loop = (cond_expr: Expr, body_expr: Expr, while_env: ValEnv) -> (Value, ValEnv)with { Error } {
    let (cv, env2) = eval_expr(cond_expr, while_env)
    match cv {
      VBool(true) => {
        let (bv, env3) = eval_expr(body_expr, env2)
        match bv {
          VBreak(val) => (val, env3),
          VContinue(_) => eval_while_loop(cond_expr, body_expr, env3),
          _ => eval_while_loop(cond_expr, body_expr, env3)
        }
      },
      _ => (VUnit, env2)
    }
  }
  let rec eval_args = (arg_exprs: Array[Expr], arg_env: ValEnv, i: Int, acc: Array[Value]) -> (Array[Value], ValEnv)with { Error } {
    if i >= Array::length(arg_exprs) {
      (acc, arg_env)
    }
    else {
      let (av, env2) = eval_expr(Array::get(arg_exprs, i), arg_env)
      eval_args(arg_exprs, env2, i + 1, Array::concat(acc, [
        av
      ]))
    }
  }
  let rec eval_elems = (elems: Array[Expr], el_env: ValEnv, i: Int, acc: Array[Value]) -> (Array[Value], ValEnv)with { Error } {
    if i >= Array::length(elems) {
      (acc, el_env)
    }
    else {
      let (ev, env2) = eval_expr(Array::get(elems, i), el_env)
      eval_elems(elems, env2, i + 1, Array::concat(acc, [
        ev
      ]))
    }
  }
  let rec eval_fields = (fields: Array[(String, Expr)], f_env: ValEnv, i: Int, acc: Array[(String, Value)]) -> (Array[(String, Value)], ValEnv)with { Error } {
    if i >= Array::length(fields) {
      (acc, f_env)
    }
    else {
      let (fname, fexpr) = Array::get(fields, i)
      let (fv, env2) = eval_expr(fexpr, f_env)
      eval_fields(fields, env2, i + 1, Array::concat(acc, [
        (fname, fv)
      ]))
    }
  }
  let rec capture_env = (e: ValEnv, acc: Array[(String, Value)]) -> Array[(String, Value)] {
    match e {
      VEnvEmpty => acc,
      VEnvBind(n, v, rest) => capture_env(rest, Array::concat(acc, [
        (n, v)
      ]))
    }
  }
  let rec eval_for_in = (vname: String, elems: Array[Value], body_expr: Expr, for_env: ValEnv, i: Int, acc: Array[Value]) -> (Value, ValEnv)with { Error } {
    if i >= Array::length(elems) {
      (VArray(acc), for_env)
    }
    else {
      let elem = Array::get(elems, i)
      let iter_env = val_env_bind(for_env, vname, elem)
      let (rv, _) = eval_expr(body_expr, iter_env)
      match rv {
        VBreak(val) => (val, for_env),
        VContinue(_) => eval_for_in(vname, elems, body_expr, for_env, i + 1, acc),
        _ => eval_for_in(vname, elems, body_expr, for_env, i + 1, Array::concat(acc, [
          rv
        ]))
      }
    }
  }
  let value_type_prefix = (v: Value) -> String {
    match v {
      VInt(_) => "Int",
      VFloat(_) => "Double",
      VString(_) => "String",
      VBool(_) => "Bool",
      VUnit => "Unit",
      VTuple(_) => "Tuple",
      VArray(_) => "Array",
      VRecord(_) => "Record",
      VBytes(_) => "Bytes",
      _ => ""
    }
  }
  let empty_vals = Array::slice([
    VUnit
  ], 0, 0)
  let empty_pairs = Array::slice([
    ("_", VUnit)
  ], 0, 0)
  match expr {
    EInt(n) => (VInt(n), env),
    EFloat(f) => (VFloat(f), env),
    EString(s) => (VString(s), env),
    EBool(b) => (VBool(b), env),
    EUnit => (VUnit, env),
    EIdent(name) => match val_env_lookup(env, name) {
      Some(v) => (v, env),
      None => (VUnit, env)
    }
    ,
    ETuple(elems) => {
      let (vals, env2) = eval_elems(elems, env, 0, empty_vals)
      (VTuple(vals), env2)
    },
    EArray(elems) => {
      let (vals, env2) = eval_elems(elems, env, 0, empty_vals)
      (VArray(vals), env2)
    },
    ERecord(fields) => {
      let (fvals, env2) = eval_fields(fields, env, 0, empty_pairs)
      (VRecord(fvals), env2)
    },
    ELet(name, val_expr, body) => {
      let (v, env2) = eval_expr(val_expr, env)
      match v {
        VBreak(_) => (v, env2),
        VContinue(_) => (v, env2),
        _ => eval_expr(body, val_env_bind(env2, name, v))
      }
    },
    ELetRec(name, val_expr, body) => {
      let env_placeholder = val_env_bind(env, name, VUnit)
      let (v, env2) = eval_expr(val_expr, env_placeholder)
      match v {
        VBreak(_) => (v, env2),
        VContinue(_) => (v, env2),
        _ => {
          let final_v = match v {
            VFn(captures, params, body_idx, _) => VFn(captures, params, body_idx, Some(name)),
            _ => v
          }
          eval_expr(body, val_env_bind(env2, name, final_v))
        }
      }
    },
    ELetMut(name, val_expr, body) => {
      let (v, env2) = eval_expr(val_expr, env)
      match v {
        VBreak(_) => (v, env2),
        VContinue(_) => (v, env2),
        _ => eval_expr(body, val_env_bind(env2, name, v))
      }
    },
    EAssign(name, val_expr, body) => {
      let (v, env2) = eval_expr(val_expr, env)
      match v {
        VBreak(_) => (v, env2),
        VContinue(_) => (v, env2),
        _ => eval_expr(body, val_env_bind(env2, name, v))
      }
    },
    EAssignOp(name, op, val_expr, body) => {
      let old_val = match val_env_lookup(env, name) {
        Some(ov) => ov,
        None => VInt(0)
      }
      let (rv, env2) = eval_expr(val_expr, env)
      match rv {
        VBreak(_) => (rv, env2),
        VContinue(_) => (rv, env2),
        _ => {
          let new_val = eval_binop(op, old_val, rv)
          eval_expr(body, val_env_bind(env2, name, new_val))
        }
      }
    },
    ESeq(left, right) => {
      let (lv, env2) = eval_expr(left, env)
      match lv {
        VBreak(_) => (lv, env2),
        VContinue(_) => (lv, env2),
        _ => eval_expr(right, env2)
      }
    },
    EIf(cond, then_e, else_e) => {
      let (cv, env2) = eval_expr(cond, env)
      match cv {
        VBreak(_) => (cv, env2),
        VContinue(_) => (cv, env2),
        VBool(true) => eval_expr(then_e, env2),
        _ => eval_expr(else_e, env2)
      }
    },
    EMatch(scrutinee, arms) => {
      let (sv, env2) = eval_expr(scrutinee, env)
      eval_match_arms(arms, sv, env2, 0)
    },
    EWhile(cond_expr, body_expr) => eval_while_loop(cond_expr, body_expr, env),
    EForIn(vname, iterable, body_expr) => {
      let (iv, env2) = eval_expr(iterable, env)
      match iv {
        VArray(elems) => eval_for_in(vname, elems, body_expr, env2, 0, empty_vals),
        _ => (VUnit, env2)
      }
    },
    EFn(_, _, params, _, _, body) => {
      let plen = Array::length(params)
      let rec get_names = (i: Int, acc: Array[String]) -> Array[String] {
        if i >= plen {
          acc
        }
        else {
          let (pname, _) = Array::get(params, i)
          get_names(i + 1, Array::concat(acc, [
            pname
          ]))
        }
      }
      let param_names = get_names(0, Array::slice([
        "_"
      ], 0, 0))
      let env_captures = capture_env(env, empty_pairs)
      let captures = Array::concat([
        ("__body", encode_expr(body))
      ], env_captures)
      (VFn(captures, param_names, 0, None), env)
    },
    ECall(callee, arg_exprs) => {
      let is_method_call = match callee {
        EDot(_, _) => true,
        _ => false
      }
      if is_method_call {
        let (obj_expr, method_name) = match callee {
          EDot(o, m) => (o, m),
          _ => (EUnit, "")
        }
        let (obj_val, env2) = eval_expr(obj_expr, env)
        let type_prefix = value_type_prefix(obj_val)
        let qualified = String::concat(type_prefix, String::concat("::", method_name))
        let (rest_args, env3) = eval_args(arg_exprs, env2, 0, empty_vals)
        let all_args = Array::slice([VUnit], 0, 0)
        Array::push(all_args, obj_val)
        let mut ri = 0
        while ri < Array::length(rest_args) {
          Array::push(all_args, Array::get(rest_args, ri))
          ri = ri + 1
        }
        match val_env_lookup(env3, qualified) {
          Some(fn_val) => apply_fn(fn_val, all_args, env3),
          None => match eval_builtin_call(qualified, all_args) {
            Some(v) => (v, env3),
            None => (VUnit, env3)
          }
        }
      } else {
      let callee_is_ident = match callee {
        EIdent(_) => true,
        _ => false
      }
      let (callee_val, env2) = eval_expr(callee, env)
      let (evaled_args, env3) = eval_args(arg_exprs, env2, 0, empty_vals)
      match callee_val {
        VFn(_, _, _, _) => apply_fn(callee_val, evaled_args, env3),
        VCtor(_, _) => apply_fn(callee_val, evaled_args, env3),
        _ => if callee_is_ident {
          let name = match callee {
            EIdent(n) => n,
            _ => ""
          }
          // ArrayBuilder::new: managed via __bstore in env
          if String::equals(name, "ArrayBuilder::new") {
            let store = match val_env_lookup(env3, "__bstore") {
              Some(VArray(s)) => s,
              _ => empty_vals
            }
            let bid = Array::length(store) + 1
            let new_store = Array::concat(store, [
              VArray(empty_vals)
            ])
            let env4 = val_env_bind(env3, "__bstore", VArray(new_store))
            (VInt(bid), env4)
          }
          else if String::equals(name, "ArrayBuilder::push") {
            let builder = Array::get(evaled_args, 0)
            let val = Array::get(evaled_args, 1)
            match builder {
              VInt(bid) => {
                let store = match val_env_lookup(env3, "__bstore") {
                  Some(VArray(s)) => s,
                  _ => empty_vals
                }
                let idx = bid - 1
                if idx >= 0 {
                  if idx < Array::length(store) {
                    let old_items = match Array::get(store, idx) {
                      VArray(items) => items,
                      _ => empty_vals
                    }
                    let new_items = Array::concat(old_items, [
                      val
                    ])
                    let before = Array::slice(store, 0, idx)
                    let after = Array::slice(store, idx + 1, Array::length(store))
                    let new_store = Array::concat(Array::concat(before, [
                      VArray(new_items)
                    ]), after)
                    let env4 = val_env_bind(env3, "__bstore", VArray(new_store))
                    (VUnit, env4)
                  } else {
                    (VUnit, env3)
                  }
                } else {
                  (VUnit, env3)
                }
              },
              _ => (VUnit, env3)
            }
          }
          else if String::equals(name, "ArrayBuilder::freeze") {
            let builder = Array::get(evaled_args, 0)
            match builder {
              VInt(bid) => {
                let store = match val_env_lookup(env3, "__bstore") {
                  Some(VArray(s)) => s,
                  _ => empty_vals
                }
                let idx = bid - 1
                if idx >= 0 {
                  if idx < Array::length(store) {
                    match Array::get(store, idx) {
                      VArray(items) => (VArray(items), env3),
                      _ => (VArray(empty_vals), env3)
                    }
                  } else {
                    (VArray(empty_vals), env3)
                  }
                } else {
                  (VArray(empty_vals), env3)
                }
              },
              _ => (VArray(empty_vals), env3)
            }
          }
          else {
            match eval_builtin_call(name, evaled_args) {
              Some(v) => (v, env3),
              None => (VUnit, env3)
            }
          }
        } else {
          (VUnit, env3)
        }
      }
      }
    },
    EBinOp(op, left, right) => {
      let (lv, env2) = eval_expr(left, env)
      if String::equals(op, "&&") {
        match lv {
          VBool(false) => (VBool(false), env2),
          _ => eval_expr(right, env2)
        }
      }
      else if String::equals(op, "||") {
        match lv {
          VBool(true) => (VBool(true), env2),
          _ => eval_expr(right, env2)
        }
      }
      else {
        let (rv, env3) = eval_expr(right, env2)
        (eval_binop(op, lv, rv), env3)
      }
    },
    EUnaryOp(op, operand) => {
      let (v, env2) = eval_expr(operand, env)
      if String::equals(op, "-") {
        match v {
          VInt(n) => (VInt(0 - n), env2),
          VFloat(fv) => (VFloat(0.0 - fv), env2),
          _ => (VUnit, env2)
        }
      }
      else if String::equals(op, "!") {
        match v {
          VBool(bv) => (VBool(not(bv)), env2),
          _ => (VUnit, env2)
        }
      }
      else {
        (VUnit, env2)
      }
    },
    EDot(obj_expr, field) => {
      let (ov, env2) = eval_expr(obj_expr, env)
      match ov {
        VRecord(fields) => {
          let rec find_field = (fs: Array[(String, Value)], i: Int) -> Value {
            if i >= Array::length(fs) {
              VUnit
            }
            else {
              let (fn_name, fv) = Array::get(fs, i)
              if String::equals(fn_name, field) {
                fv
              }
              else {
                find_field(fs, i + 1)
              }
            }
          }
          (find_field(fields, 0), env2)
        },
        VTuple(elems) => {
          let idx = if String::equals(field, "0") {
            0
          }
          else if String::equals(field, "1") {
            1
          }
          else if String::equals(field, "2") {
            2
          }
          else if String::equals(field, "3") {
            3
          }
          else {
            0
          }
          if idx < Array::length(elems) {
            (Array::get(elems, idx), env2)
          }
          else {
            (VUnit, env2)
          }
        },
        _ => (VUnit, env2)
      }
    },
    EHandle(body, arms) => handle {
      eval_expr(body, env)
    } {
      Error(msg) => eval_handle_arms(arms, msg, env, 0)
    }
    ,
    EThrow(val_expr) => {
      let (v, _) = eval_expr(val_expr, env)
      let msg = value_to_string(v)
      throw(msg)
    },
    EBreak(opt) => {
      let bval = match opt {
        Some(e) => {
          let (v, _) = eval_expr(e, env)
          v
        },
        None => VUnit
      }
      (VBreak(bval), env)
    },
    EContinue(args) => {
      let (vals, env2) = eval_args(args, env, 0, empty_vals)
      (VContinue(vals), env2)
    },
    ELabeledArg(_, _, inner) => eval_expr(inner, env),
    _ => (VUnit, env)
  }
}
