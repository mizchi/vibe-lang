//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

let join = (arr: Array[String], sep: String) -> String {
  let len = array_length(arr)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    } else {
      let s = if i > 0 {
        string_concat(string_concat(acc, sep), array_get(arr, i))
      } else array_get(arr, i)
      go(i + 1, s)
    }
  }
  go(0, "")
}

export let rec print_pat = (p: Pat) -> String {
  match p {
    PWild => "_",
    PBind(name) => name,
    PInt(n) => __to_string(n),
    PString(s) => string_concat("\"", string_concat(s, "\"")),
    PBool(b) => if b {
      "true"
    } else "false",
    PCtor(name, args) => if array_length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        print_pat(arg)
      }
      string_concat(name, string_concat("(", string_concat(join(parts, ", "), ")")))
    },
    PTuple(elems) => {
      let parts = for elem in elems {
        print_pat(elem)
      }
      string_concat("(", string_concat(join(parts, ", "), ")"))
    },
    POr(left, right) => string_concat(print_pat(left), string_concat(" | ", print_pat(right)))
  }
}

let map_to_strings = (exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {
  for expr in exprs {
    f(expr)
  }
}

export let rec print_expr = (e: Expr) -> String {
  match e {
    EInt(n) => __to_string(n),
    EFloat(n) => __to_string(n),
    EString(s) => string_concat("\"", string_concat(s, "\"")),
    EBool(b) => if b {
      "true"
    } else "false",
    EIdent(name) => name,
    EUnit => "()",
    ETuple(elems) => string_concat("(", string_concat(join(map_to_strings(elems, print_expr), ", "), ")")),
    EArray(elems) => string_concat("[", string_concat(join(map_to_strings(elems, print_expr), ", "), "]")),
    ERecord(fields) => {
      let parts = for field in fields {
        let (name, val) = field
        string_concat(name, string_concat(": ", print_expr(val)))
      }
      string_concat("{ ", string_concat(join(parts, ", "), " }"))
    },
    EIf(cond, then_e, else_e) => string_concat("if ", string_concat(print_expr(cond), string_concat(" { ", string_concat(print_expr(then_e), string_concat(" } else { ", string_concat(print_expr(else_e), " }")))))),
    ELet(name, val, body) => string_concat("let ", string_concat(name, string_concat(" = ", string_concat(print_expr(val), string_concat("; ", print_expr(body)))))),
    ELetRec(name, val, body) => string_concat("let rec ", string_concat(name, string_concat(" = ", string_concat(print_expr(val), string_concat("; ", print_expr(body)))))),
    ELetMut(name, val, body) => string_concat("let mut ", string_concat(name, string_concat(" = ", string_concat(print_expr(val), string_concat("; ", print_expr(body)))))),
    EAssign(name, val, body) => string_concat(name, string_concat(" = ", string_concat(print_expr(val), string_concat("; ", print_expr(body))))),
    EAssignOp(name, op, val, body) => string_concat(name, string_concat(" ", string_concat(op, string_concat("= ", string_concat(print_expr(val), string_concat("; ", print_expr(body))))))),
    ESeq(a, b) => string_concat(print_expr(a), string_concat("; ", print_expr(b))),
    EMatch(scrutinee, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        string_concat(print_pat(pat), string_concat(" => ", print_expr(expr)))
      }
      string_concat("match ", string_concat(print_expr(scrutinee), string_concat(" { ", string_concat(join(parts, ", "), " }"))))
    },
    EHandle(body, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        string_concat(print_pat(pat), string_concat(" => ", print_expr(expr)))
      }
      string_concat("handle { ", string_concat(print_expr(body), string_concat(" } { ", string_concat(join(parts, ", "), " }"))))
    },
    EWhile(cond, body) => string_concat("while ", string_concat(print_expr(cond), string_concat(" { ", string_concat(print_expr(body), " }")))),
    EForIn(name, iterable, body) => string_concat("for ", string_concat(name, string_concat(" in ", string_concat(print_expr(iterable), string_concat(" { ", string_concat(print_expr(body), " }")))))),
    ECall(callee, args) => string_concat(print_expr(callee), string_concat("(", string_concat(join(map_to_strings(args, print_expr), ", "), ")"))),
    EBinOp(op, left, right) => string_concat("(", string_concat(print_expr(left), string_concat(" ", string_concat(op, string_concat(" ", string_concat(print_expr(right), ")")))))),
    EUnaryOp(op, expr) => string_concat("(", string_concat(op, string_concat(print_expr(expr), ")"))),
    EFn(params, ret_ty, effect, body) => {
      let parts = for param in params {
        let (name, ty_opt) = param
        match ty_opt {
          Some(ty) => string_concat(name, string_concat(": ", print_type_expr(ty))),
          None => name
        }
      }
      let ret_str = match ret_ty {
        Some(rt) => {
          let eff_str = match effect {
            Some(e) => string_concat(" with {", string_concat(e, "}")),
            None => ""
          }
          string_concat(") -> ", string_concat(print_type_expr(rt), string_concat(eff_str, string_concat(" { ", string_concat(print_expr(body), " }")))))
        },
        None => string_concat(") -> ", print_expr(body))
      }
      string_concat("(", string_concat(join(parts, ", "), ret_str))
    },
    EDot(expr, field) => string_concat(print_expr(expr), string_concat(".", field)),
    EPipe(left, right) => string_concat("(", string_concat(print_expr(left), string_concat(" |> ", string_concat(print_expr(right), ")")))),
    EThrow(e) => string_concat("throw(", string_concat(print_expr(e), ")")),
    EBreak(opt) => match opt {
      None => "break",
      Some(v) => string_concat("break ", print_expr(v))
    },
    EContinue(args) => if eq(array_length(args), 0) {
      "continue"
    } else string_concat("continue(", string_concat(join(map_to_strings(args, print_expr), ", "), ")")),
    ELabeledArg(name, modifier, val) => string_concat(name, string_concat("=", print_expr(val)))
  }
}

export let rec print_type_expr = (ty: TypeExpr) -> String {
  match ty {
    TyName(name) => name,
    TyUnit => "()",
    TyApp(name, args) => {
      let parts = for arg in args {
        print_type_expr(arg)
      }
      string_concat(name, string_concat("[", string_concat(join(parts, ", "), "]")))
    },
    TyFn(params, ret) => {
      let parts = for param in params {
        print_type_expr(param)
      }
      string_concat("(", string_concat(join(parts, ", "), string_concat(") -> ", print_type_expr(ret))))
    },
    TyTuple(elems) => {
      let parts = for elem in elems {
        print_type_expr(elem)
      }
      string_concat("(", string_concat(join(parts, ", "), ")"))
    }
  }
}

let print_ctor = (ctor: (String, Array[TypeExpr])) -> String {
  let (name, args) = ctor
  if eq(array_length(args), 0) {
    name
  }
  else {
    let parts = for arg in args {
      print_type_expr(arg)
    }
    string_concat(name, string_concat("(", string_concat(join(parts, ", "), ")")))
  }
}

let print_ctor_list = (ctors: Array[(String, Array[TypeExpr])]) -> String {
  let parts = for ctor in ctors {
    print_ctor(ctor)
  }
  join(parts, "; ")
}

export let rec print_stmt = (s: Stmt) -> String {
  let prefix = (exported: Bool) -> String {
    if exported {
      "export "
    } else ""
  }
  match s {
    SLet(exported, is_rec, name, ty_opt, val) => {
      let p = prefix(exported)
      let r = if is_rec {
        "let rec "
      } else "let "
      let t = match ty_opt {
        Some(ty) => string_concat(": ", print_type_expr(ty)),
        None => ""
      }
      string_concat(p, string_concat(r, string_concat(name, string_concat(t, string_concat(" = ", print_expr(val))))))
    },
    SLetMut(name, ty_opt, val) => {
      let t = match ty_opt {
        Some(ty) => string_concat(": ", print_type_expr(ty)),
        None => ""
      }
      string_concat("let mut ", string_concat(name, string_concat(t, string_concat(" = ", print_expr(val)))))
    },
    SEnum(exported, name, ctors) => string_concat(prefix(exported), string_concat("enum ", string_concat(name, string_concat(" { ", string_concat(print_ctor_list(ctors), " }"))))),
    SSuberror(exported, name, ctors) => {
      let p = prefix(exported)
      if eq(array_length(ctors), 1) {
        let (ctor_name, ctor_args) = array_get(ctors, 0)
        if string_equals(ctor_name, name) {
          let parts = for arg in ctor_args {
            print_type_expr(arg)
          }
          string_concat(p, string_concat("suberror ", string_concat(name, string_concat("(", string_concat(join(parts, ", "), ")")))))
        }
        else {
          string_concat(p, string_concat("suberror ", string_concat(name, string_concat(" { ", string_concat(print_ctor_list(ctors), " }")))))
        }
      } else {
        string_concat(p, string_concat("suberror ", string_concat(name, string_concat(" { ", string_concat(print_ctor_list(ctors), " }")))))
      }
    },
    SStruct(exported, name, fields) => {
      let parts = for field in fields {
        let (fn1, ty) = field
        string_concat(fn1, string_concat(": ", print_type_expr(ty)))
      }
      string_concat(prefix(exported), string_concat("struct ", string_concat(name, string_concat(" { ", string_concat(join(parts, "; "), " }")))))
    },
    STypeAlias(exported, name, ty) => string_concat(prefix(exported), string_concat("type ", string_concat(name, string_concat(" = ", print_type_expr(ty))))),
    STrait(exported, name) => string_concat(prefix(exported), string_concat("trait ", name)),
    SImpl(trait_name, type_name) => string_concat("impl ", string_concat(trait_name, string_concat(" for ", type_name))),
    SExternLet(name, ty) => string_concat("extern let ", string_concat(name, string_concat(": ", print_type_expr(ty)))),
    SImport(path, items) => {
      let parts = for item in items {
        let (name, alias) = item
        match alias {
          Some(a) => string_concat(name, string_concat(" as ", a)),
          None => name
        }
      }
      string_concat("use ", string_concat(path, string_concat(" { ", string_concat(join(parts, ", "), " }"))))
    },
    STest(name, body) => string_concat("test \"", string_concat(name, string_concat("\" { ", string_concat(print_expr(body), " }")))),
    SBench(name, body) => string_concat("bench \"", string_concat(name, string_concat("\" { ", string_concat(print_expr(body), " }")))),
    SExpr(e) => print_expr(e),
    SExport(names) => string_concat("export { ", string_concat(join(names, ", "), " }")),
    SReExport(path, items) => {
      let parts = for item in items {
        let (name, alias) = item
        match alias {
          Some(a) => string_concat(name, string_concat(" as ", a)),
          None => name
        }
      }
      string_concat("export ", string_concat(path, string_concat(" { ", string_concat(join(parts, ", "), " }"))))
    },
    SModule(exported, name, stmts) => {
      let parts = for s in stmts {
        print_stmt(s)
      }
      let p = if exported {
        "export "
      } else ""
      string_concat(p, string_concat("module ", string_concat(name, string_concat(" { ", string_concat(join(parts, "\n"), " }")))))
    }
  }
}

export let print_program = (stmts: Array[Stmt]) -> String {
  let parts = for s in stmts {
    print_stmt(s)
  }
  join(parts, "\n")
}
