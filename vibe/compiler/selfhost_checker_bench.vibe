//# Imports

import ./checker_hotspot_probe.vibe {
  load_checker_fixture,
  probe_check_chained_lets,
  probe_check_deep_binop,
  probe_check_large_match,
  probe_check_nested_if,
  probe_check_seq_chain
}

//# Misc

let (
  chained_lets_expr,
  deep_binop_expr,
  nested_if_expr,
  large_match_expr,
  seq_chain_expr
) = load_checker_fixture()

bench "selfhost/check_chained_lets_64" {
  let _ = handle {
    probe_check_chained_lets(chained_lets_expr)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_deep_binop_64" {
  let _ = handle {
    probe_check_deep_binop(deep_binop_expr)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_nested_if_64" {
  let _ = handle {
    probe_check_nested_if(nested_if_expr)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_large_match_48" {
  let _ = handle {
    probe_check_large_match(large_match_expr)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_seq_chain_96" {
  let _ = handle {
    probe_check_seq_chain(seq_chain_expr)
  } with Error {
    Throw(_) => 0
  }
}
