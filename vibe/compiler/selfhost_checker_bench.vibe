//# Imports

import ./checker_hotspot_probe.vibe {
  probe_check_cached_env_lookups_n256,
  probe_check_cached_env_lookups_n512,
  probe_check_cached_env_lookups_n64,
  probe_check_chained_lets,
  probe_check_deep_binop,
  probe_check_large_match,
  probe_check_nested_if,
  probe_check_seq_chain
}

bench "selfhost/check_chained_lets_64" {
  let _ = handle {
    probe_check_chained_lets()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_deep_binop_64" {
  let _ = handle {
    probe_check_deep_binop()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_nested_if_64" {
  let _ = handle {
    probe_check_nested_if()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_large_match_48" {
  let _ = handle {
    probe_check_large_match()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_seq_chain_96" {
  let _ = handle {
    probe_check_seq_chain()
  } with Error {
    Throw(_) => 0
  }
}

// Cached-env lookup scaling. Fixed refs=128, sweep N. Linear-Map emit gives
// O(N) per Map::has_key + Map::get → wallclock should scale roughly linearly
// in N. Hash-backed Map (per #395) would flatten this. The 64/256/512 spread
// is wide enough that even a wasm-instantiation-dominated 100ms wallclock can
// distinguish ~1× vs ~8×.
bench "selfhost/check_cached_env_lookups_n64" {
  let _ = handle {
    probe_check_cached_env_lookups_n64()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_cached_env_lookups_n256" {
  let _ = handle {
    probe_check_cached_env_lookups_n256()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/check_cached_env_lookups_n512" {
  let _ = handle {
    probe_check_cached_env_lookups_n512()
  } with Error {
    Throw(_) => 0
  }
}
