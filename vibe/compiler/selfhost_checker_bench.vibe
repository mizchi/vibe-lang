//# Imports

import ./checker_hotspot_probe.vibe {
  load_cached_env_lookup_fixture_n2048, load_cached_env_lookup_fixture_n256, load_cached_env_lookup_fixture_n512, load_cached_env_lookup_fixture_n64, probe_check_cached_env_lookups, probe_check_chained_lets, probe_check_deep_binop, probe_check_large_match, probe_check_nested_if, probe_check_seq_chain
}

//# Functions

let (cached_env_lookup_expr_n64, cached_env_lookup_env_n64) = load_cached_env_lookup_fixture_n64()

let (cached_env_lookup_expr_n256, cached_env_lookup_env_n256) = load_cached_env_lookup_fixture_n256()

let (cached_env_lookup_expr_n512, cached_env_lookup_env_n512) = load_cached_env_lookup_fixture_n512()

let (cached_env_lookup_expr_n2048, cached_env_lookup_env_n2048) = load_cached_env_lookup_fixture_n2048()

//# Misc

bench "selfhost/check_chained_lets_64" {
  let _ = handle {
    probe_check_chained_lets()
  } with Error {
    Throw(_) => 0
  }
}

