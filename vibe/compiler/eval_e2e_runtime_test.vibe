//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup
}

//# Misc

test "e2e string builtin" {
  let src = "let s = String::concat(\"hello\", \" world\")\nlet n = String::length(s)"
  assert(run_and_lookup(src, "n") == "11")
}

test "e2e array builtin" {
  let src = "let arr = [1, 2, 3]\nlet n = Array::length(arr)"
  assert(run_and_lookup(src, "n") == "3")
}

test "e2e while mutation" {
  let src = "let mut x = 0\nwhile x < 5 { x = x + 1 }\nlet result = x"
  assert(run_and_lookup(src, "result") == "5")
}

test "e2e multi stmt" {
  let src = "let a = 10\nlet b = a + 5\nlet c = b * 2"
  assert(run_and_lookup(src, "c") == "30")
}

test "e2e bitwise ops" {
  let src = "let result = (0xFF & 0x0F) | 0x30"
  assert(run_and_lookup(src, "result") == "63")
}

test "e2e invalid arithmetic reports error" {
  let src = "let result = 1 + \"x\""
  assert(String::starts_with(run_and_lookup(src, "result"), "ERROR: type mismatch in '+'"))
}

test "e2e invalid logic reports error" {
  let src = "let result = 1 && 2"
  assert(String::starts_with(run_and_lookup(src, "result"), "ERROR: type mismatch in '&&'"))
}
