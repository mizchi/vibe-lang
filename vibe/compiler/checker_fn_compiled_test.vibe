//# Imports

import ./ast.vibe {
  Expr, TypeExpr
}

import ./checker_test_support.vibe {
  check, no_tb, no_tp
}

import ./types.vibe {
  Type, TypeEnv, type_to_string, types_equal
}

//# Misc

test "compiled: fn typed param binds in body" {
  let ann: TypeExpr = TyName("Int")
  let env: TypeEnv = EnvEmpty
  let int_ty: Type = CtInt
  let expr: Expr = EFn(no_tp, no_tb, [
    ("x", Some(ann))
  ], None, None, EIdent("x"))
  let ty = check(expr, env)
  let ok = match ty {
    CtFn(_, ret, he) => types_equal(ret, int_ty) && not(he),
    _ => false
  }
  if !ok {
    throw(type_to_string(ty))
  }
}
