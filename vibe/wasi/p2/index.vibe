export let version = "0.0.1"

// WASI Preview 2: fd-based HTTP and TCP socket builtins
// These are synchronous, pollable-based interfaces.

import ../../http/index.vibe {
  close, accept, listen, request, respond,
  request_url, request_body, response_body,
  request_header, request_method, response_header, response_status,
  HttpRequest, HttpResponse, headers_empty, headers_get, headers_set,
  headers_to_wire, make_request, make_response,
  status_ok, status_not_found, status_internal_server_error,
  request_with, respond_with
}

import ../../../lib/@vibe/socket/index.vibe {
  TcpEndpoint, TcpConnection,
  endpoint, connection, connection_fd,
  connect, read, write, close
}

// Re-export HTTP
export {
  close, accept, listen, request, respond,
  request_url, request_body, response_body,
  request_header, request_method, response_header, response_status,
  HttpRequest, HttpResponse, headers_empty, headers_get, headers_set,
  headers_to_wire, make_request, make_response,
  status_ok, status_not_found, status_internal_server_error,
  request_with, respond_with
}

// Re-export Socket (with prefix to avoid collision with Http::close)
export let socket_connect = connect
export let socket_read = read
export let socket_write = write
export let socket_close = close
export let Socket::endpoint = endpoint
export let Socket::connection = connection
export let Socket::connection_fd = connection_fd
