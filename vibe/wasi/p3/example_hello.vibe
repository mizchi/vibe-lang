// P3 HTTP handler example: returns 200 for all requests.
//
// The adapter expects: export handler: func(method: string, url: string) -> s64
//
// Build & run:
//   scripts/build_wasi_http_p3_adapter.sh _build/http_adapter/adapter.component.wasm
//   vibe compile --compose-p3 vibe/wasi/p3/example_hello.vibe \
//     --adapter _build/http_adapter/adapter.component.wasm \
//     -o _build/http_adapter/hello.p3.component.wasm
//   wasmtime serve -Sp3 -Wcomponent-model-async=y -Wcomponent-model-async-builtins=y \
//     --addr 127.0.0.1:8080 _build/http_adapter/hello.p3.component.wasm
//   curl http://127.0.0.1:8080/

export let handler = (method: String, url: String) -> Int {
  200
}
handler("GET", "/")
