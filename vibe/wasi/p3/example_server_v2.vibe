// P3 HTTP server v2: handler controls status, headers, and body.
//
// Response format: "STATUS\nHeader: Value\n\nBODY"
//
// Build & serve:
//   scripts/build_wasi_http_p3_adapter_v2.sh _build/http_adapter/adapter_v2.wasm
//   vibe compile --component-string-lift vibe/wasi/p3/example_server_v2.vibe \
//     -o _build/server_v2.component.wasm
//   # compose (mwac plug)
//   vibe compile --compose-p3 vibe/wasi/p3/example_server_v2.vibe \
//     --adapter _build/http_adapter/adapter_v2.wasm \
//     -o _build/server_v2.p3.component.wasm
//   deps/wasmtime/target/release/wasmtime serve -Sp3 -Shttp \
//     -Wcomponent-model-async=y -Wcomponent-model-async-builtins=y \
//     --addr 127.0.0.1:8080 _build/server_v2.p3.component.wasm

export let handler = (method: String, url: String) -> String {
  if String::equals(url, "/") {
    "200\n\nWelcome to vibe-lang P3 HTTP server!"
  } else if String::equals(url, "/health") {
    "200\ncontent-type: application/json\n\n{\"status\":\"ok\"}"
  } else if String::equals(url, "/api/hello") {
    if String::equals(method, "GET") {
      String::concat("200\ncontent-type: application/json\n\n{\"message\":\"hello from vibe\",\"url\":\"", String::concat(url, "\"}"))
    } else {
      "405\n\nMethod Not Allowed"
    }
  } else {
    "404\n\nNot Found"
  }
}
handler("GET", "/")
