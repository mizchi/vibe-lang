// P3 HTTP server example with routing
//
// Build & serve:
//   just test-wasi-p3-e2e-v44  # ensures adapter is built
//   vibe compile --compose-p3 vibe/wasi/p3/example_server.vibe \
//     --adapter _build/wasi_p3_e2e/adapter.component.wasm \
//     -o _build/server.p3.component.wasm
//   deps/wasmtime/target/release/wasmtime serve -Sp3 -Shttp \
//     -Wcomponent-model-async=y -Wcomponent-model-async-builtins=y \
//     --addr 127.0.0.1:8080 _build/server.p3.component.wasm

export let handler = (method: String, url: String) -> Int {
  if String::equals(url, "/") {
    200
  } else if String::equals(url, "/health") {
    200
  } else if String::equals(url, "/api/hello") {
    if String::equals(method, "GET") { 200 }
    else { 405 }
  } else {
    404
  }
}
handler("GET", "/")
