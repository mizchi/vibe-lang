export let version = "0.1.0"

// WASI Preview 3: async HTTP handler via Component Model
//
// P3 replaces P2's pollable-based async with native async functions.
// In vibe, the handler is compiled to a Component Model export:
//
//   wasi:http/handler.handle: async (request) -> result<response, error-code>
//
// Usage:
//   import vibe/wasi/p3 { Handler, Request, Response, respond_text, respond_json }
//
//   export let handler = Handler::{
//     serve: (req: Request) -> Response {
//       respond_text(200, "hello from vibe p3")
//     }
//   }
//
// Compilation:
//   vibe compile --compose-p3 handler.vibe -o handler.component.wasm
//   wasmtime serve -Sp3 -Wcomponent-model-async=y handler.component.wasm

export ./handler.vibe {
  Handler, Request, Response,
  respond_text, respond_json, respond_empty,
  request_method, request_url, request_header, request_body,
  status_ok, status_created, status_not_found, status_bad_request,
  status_internal_server_error
}
