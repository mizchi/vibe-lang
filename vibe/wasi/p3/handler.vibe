//# Types

// P3 HTTP Request (simplified view of wasi:http/types.request)
export struct Request {
  method: String;
  url: String;
  headers: Map[String, String];
  body: String
}

// P3 HTTP Response (simplified view of wasi:http/types.response)
export struct Response {
  status: Int;
  headers: Map[String, String];
  body: String
}

// P3 HTTP Handler definition
// When compiled with --compose-p3, this becomes a wasi:http/server component.
export struct Handler {
  serve: (Request) -> Response
}

//# Response Constructors

export let respond_text = (status: Int, body: String) -> Response {
  let headers = MapBuilder::new()
  MapBuilder::set(headers, "content-type", "text/plain; charset=utf-8")
  Response::{
    status: status,
    headers: MapBuilder::freeze(headers),
    body: body
  }
}

export let respond_json = (status: Int, body: String) -> Response {
  let headers = MapBuilder::new()
  MapBuilder::set(headers, "content-type", "application/json; charset=utf-8")
  Response::{
    status: status,
    headers: MapBuilder::freeze(headers),
    body: body
  }
}

export let respond_empty = (status: Int) -> Response {
  Response::{
    status: status,
    headers: MapBuilder::freeze(MapBuilder::new()),
    body: ""
  }
}

//# Request Accessors

export let request_method = (req: Request) -> String {
  req.method
}

export let request_url = (req: Request) -> String {
  req.url
}

export let request_header = (req: Request, name: String) -> Option[String] {
  let key = String::to_lower(name)
  if Map::has_key(req.headers, key) {
    Some(Map::get(req.headers, key))
  } else None
}

export let request_body = (req: Request) -> String {
  req.body
}

//# Status Code Constants

export let status_ok = () -> Int { 200 }
export let status_created = () -> Int { 201 }
export let status_no_content = () -> Int { 204 }
export let status_bad_request = () -> Int { 400 }
export let status_not_found = () -> Int { 404 }
export let status_method_not_allowed = () -> Int { 405 }
export let status_internal_server_error = () -> Int { 500 }
