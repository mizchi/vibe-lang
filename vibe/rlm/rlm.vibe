// LLM direct call
declare export let complete: (String, String) -> String with { Llm }

// RLM loop execution
declare export let run: (String, String) -> String with { Llm }

// RLM completion signal (used inside RLM loop)
declare export let finalize: (String) -> String

complete = (system: String, user: String) -> String with { Llm } {
  do { llm_complete(system, user) }
}

run = (task: String, prompt: String) -> String with { Llm } {
  do { rlm_run(task, prompt) }
}

finalize = (result: String) -> String {
  rlm_finalize(result)
}
