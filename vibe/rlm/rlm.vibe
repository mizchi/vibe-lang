
export let run = (task: String, prompt: String) -> String with {
  Llm
} {
  do {
    rlm_run(task, prompt)
  }
}
export let complete = (system: String, user: String) -> String with {
  Llm
} {
  do {
    llm_complete(system, user)
  }
}
export let finalize = (result: String) -> String {
  rlm_finalize(result)
}
