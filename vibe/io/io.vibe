//# Functions

export let read: (Int) -> String with { Stdin } = (max_bytes) -> {
  perform Stdin::ReadStream(max_bytes)
}

export let print: (String) -> Unit with { Stdout } = (s) -> {
  perform Stdout::WriteStream(s)
}

export let println: (String) -> Unit with { Stdout } = (s) -> {
  {
    perform Stdout::WriteStream(s)
    perform Stdout::WriteChar(10)
  }
}

export let read_char: () -> Int with { Stdin } = () -> {
  Stdin::read_char()
}

export let read_line: () -> String with { Stdin } = () -> {
  {
    let mut acc = ""
    let mut done = false
    while not(done) {
      let c = Stdin::read_char()
      let stop = c < 0 || c == 10
      done = stop
      acc = if stop {
        acc
      } else "\{acc}\{String::from_char_code(c)}"
    }
    acc
  }
}

export let write_char: (Int) -> Unit with { Stdout } = (code) -> {
  perform Stdout::WriteChar(code)
}
