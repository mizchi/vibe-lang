
export let read = (max_bytes: Int) -> String with {
  Stdin
} {
  do {
    stdin_read_stream(max_bytes)
  }
}
export let print = (s: String) -> Unit with {
  Stdout
} {
  do {
    stdout_write_stream(s)
  }
}
export let println = (s: String) -> Unit with {
  Stdout
} {
  do {
    stdout_write_stream(s)
    stdout_write_char(10)
  }
}
export let read_char = () -> Int with {
  Stdin
} {
  do {
    stdin_read_char()
  }
}
export let read_line = () -> String with {
  Stdin
} {
  do {
    let mut acc = ""
    let mut done = false
    while not(done) {
      let c = stdin_read_char()
      let stop = c < 0 || c == 10
      done = stop
      acc = if stop {
        acc
      } else {
        string_concat(acc, string_from_char_code(c))
      }
    }
    acc
  }
}
export let write_char = (code: Int) -> Unit with {
  Stdout
} {
  do {
    stdout_write_char(code)
  }
}
