//# Imports

import ./index.vibe {
  io_read, io_print, io_println, io_read_char, io_read_line, io_write_char
}

//# Misc

test "io index exports canonical aliases" {
  let _ = io_read
  let _ = io_read_char
  let _ = io_read_line
  let _ = io_write_char
  io_print("")
  io_println("")
  assert(true)
}
