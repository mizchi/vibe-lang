
use ./io.vibe {
  print, println, write_char, read_line, read, read_char
}
let greet = (name: String) -> Unit with { Stdout } {
  do {
    print("Hello, ")
    println(name)
  }
}
let echo_line = () -> Unit with { Stdin, Stdout } {
  do {
    let line = read_line()
    println(line)
  }
}
let write_abc = () -> Unit with { Stdout } {
  do {
    write_char(65)
    write_char(66)
    write_char(67)
    write_char(10)
  }
}
test "greet writes to stdout" {
  do {
    greet("vibe")
  }
  assert(true)
}
test "write_abc writes A B C" {
  do {
    write_abc()
  }
  assert(true)
}
test "echo_line reads and writes" {
  do {
    echo_line()
  }
  assert(true)
}
test "read returns empty for zero bytes" {
  let result = do {
    read(0)
  }
  assert(string_equals(result, ""))
}
test "read_char returns eof in test" {
  let c = do {
    read_char()
  }
  assert(c < 0)
}
