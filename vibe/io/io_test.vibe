
use ./io.vibe {
  print, println, read_line, read, read_char, write_char
}
test "println and print run with Stdout effect" {
  let run = () -> Unit with { Stdout } {
    do {
      print("hello")
      println(" world")
    }
  }
  do {
    run()
  }
  assert(true)
}
test "write_char runs with Stdout effect" {
  let run = () -> Unit with { Stdout } {
    do {
      write_char(65)
    }
  }
  do {
    run()
  }
  assert(true)
}
test "read_line returns empty on eof" {
  assert(string_equals(read_line(), ""))
}
test "read returns empty for zero bytes" {
  let result = do {
    read(0)
  }
  assert(string_equals(result, ""))
}
test "read_char returns -1 on eof" {
  let c = do {
    read_char()
  }
  assert(c < 0)
}
