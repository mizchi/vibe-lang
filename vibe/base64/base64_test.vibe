//# Imports

import ./base64.vibe {
  String, decode, encode
}

//# Misc

test "encode 3 bytes" {
  assert(String::equals(encode("Man"), "TWFu"))
}

test "encode 2 bytes padding" {
  assert(String::equals(encode("Ma"), "TWE="))
}

test "encode 1 byte padding" {
  assert(String::equals(encode("M"), "TQ=="))
}

test "encode empty" {
  assert(String::equals(encode(""), ""))
}

test "encode longer string" {
  assert(String::equals(encode("Hello World"), "SGVsbG8gV29ybGQ="))
}

test "decode 3 bytes" {
  assert(String::equals(decode("TWFu"), "Man"))
}

test "decode 2 bytes padding" {
  assert(String::equals(decode("TWE="), "Ma"))
}

test "decode 1 byte padding" {
  assert(String::equals(decode("TQ=="), "M"))
}

test "decode empty" {
  assert(String::equals(decode(""), ""))
}

test "decode longer string" {
  assert(String::equals(decode("SGVsbG8gV29ybGQ="), "Hello World"))
}

test "round-trip ascii" {
  let s = "Hello, Base64!"
  assert(String::equals(decode(encode(s)), s))
}

test "round-trip empty" {
  assert(String::equals(decode(encode("")), ""))
}

test "round-trip single char" {
  assert(String::equals(decode(encode("A")), "A"))
}

test "round-trip two chars" {
  assert(String::equals(decode(encode("AB")), "AB"))
}

test "String::base64_encode" {
  assert(String::equals("Man"|>base64_encode(), "TWFu"))
}

test "String::base64_decode" {
  assert(String::equals("TWFu"|>base64_decode(), "Man"))
}

test "String::base64 round-trip" {
  let s = "test123"
  assert(String::equals(s|>base64_encode()|>base64_decode(), s))
}
