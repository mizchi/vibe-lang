declare export let recv: (Int) -> String
declare export let send: (Int, String) -> Bool
declare export let wait: (Int) -> Int
declare export let spawn: (String, Int) -> Int
declare export let probe_wat: () -> String
declare export let channel_new: (Int) -> Int
recv = (channel: Int) -> String {
  threads_recv(channel)
}
send = (channel: Int, message: String) -> Bool {
  threads_send(channel, message)
}
wait = (task: Int) -> Int {
  threads_wait(task)
}
spawn = (name: String, mailbox: Int) -> Int {
  threads_spawn(name, mailbox)
}
probe_wat = () -> String {
  threads_probe_wat()
}
channel_new = (capacity: Int) -> Int {
  threads_channel_new(capacity)
}
export let runtime_hints = () {
  threads_runtime_hints()
}
