export struct PathRef {
  raw: String
}
export struct DynamicPath {
  raw: String
}
declare export let dynamic: (String) -> DynamicPath
declare export let from_literal: (String) -> PathRef
declare export let path_ref_as_string: (PathRef) -> String
declare export let path_ref_is_absolute: (PathRef) -> Bool
declare export let dynamic_path_as_string: (DynamicPath) -> String
declare export let PathRef::as_string: (PathRef) -> String
declare export let PathRef::is_absolute: (PathRef) -> Bool
declare export let DynamicPath::as_string: (DynamicPath) -> String
dynamic = (raw: String) -> DynamicPath {
  DynamicPath::{
    raw: raw
  }
}
from_literal = (literal: String) -> PathRef {
  PathRef::{
    raw: path_to_string(path_ref(literal))
  }
}
path_ref_as_string = (self: PathRef) -> String {
  self.raw
}
path_ref_is_absolute = (self: PathRef) -> Bool {
  path_is_absolute(path(self.raw))
}
dynamic_path_as_string = (path: DynamicPath) -> String {
  path.raw
}
PathRef::as_string = (self: PathRef) -> String {
  path_ref_as_string(self)
}
PathRef::is_absolute = (self: PathRef) -> Bool {
  path_ref_is_absolute(self)
}
DynamicPath::as_string = (path: DynamicPath) -> String {
  dynamic_path_as_string(path)
}
