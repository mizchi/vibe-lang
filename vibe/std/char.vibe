declare export let is_ascii: (Int) -> Bool
declare export let to_string: (Int) -> String
declare export let is_ascii_digit: (Int) -> Bool
declare export let is_ascii_hexdigit: (Int) -> Bool
declare export let is_ascii_lowercase: (Int) -> Bool
declare export let is_ascii_uppercase: (Int) -> Bool
declare export let to_ascii_lowercase: (Int) -> Int
declare export let to_ascii_uppercase: (Int) -> Int
declare export let is_ascii_alphabetic: (Int) -> Bool
declare export let is_ascii_alnum: (Int) -> Bool
declare export let is_ascii_whitespace: (Int) -> Bool
is_ascii = (code: Int) -> Bool {
  code >= 0 && code <= 127
}
to_string = (code: Int) -> String {
  string_from_char_code(code)
}
export let from_string = (s: String) -> Option[Int] {
  if string_length(s) == 1 {
    Some(string_char_code_at(s, 0))
  } else {
    None
  }
}
is_ascii_digit = (code: Int) -> Bool {
  code >= 48 && code <= 57
}
is_ascii_hexdigit = (code: Int) -> Bool {
  is_ascii_digit(code)
  || (code >= 65 && code <= 70)
  || (code >= 97 && code <= 102)
}
is_ascii_lowercase = (code: Int) -> Bool {
  code >= 97 && code <= 122
}
is_ascii_uppercase = (code: Int) -> Bool {
  code >= 65 && code <= 90
}
to_ascii_lowercase = (code: Int) -> Int {
  if is_ascii_uppercase(code) {
    code + 32
  } else {
    code
  }
}
to_ascii_uppercase = (code: Int) -> Int {
  if is_ascii_lowercase(code) {
    code - 32
  } else {
    code
  }
}
is_ascii_alphabetic = (code: Int) -> Bool {
  is_ascii_lowercase(code) || is_ascii_uppercase(code)
}
is_ascii_alnum = (code: Int) -> Bool {
  is_ascii_alphabetic(code) || is_ascii_digit(code)
}
is_ascii_whitespace = (code: Int) -> Bool {
  code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}
