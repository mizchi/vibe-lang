
declare export let to_int: (Char) -> Int
declare export let is_ascii: (Char) -> Bool
declare export let to_string: (Char) -> String
declare export let is_ascii_digit: (Char) -> Bool
declare export let is_ascii_hexdigit: (Char) -> Bool
declare export let is_ascii_lowercase: (Char) -> Bool
declare export let is_ascii_uppercase: (Char) -> Bool
declare export let to_ascii_lowercase: (Char) -> Char
declare export let to_ascii_uppercase: (Char) -> Char
declare export let is_ascii_alphabetic: (Char) -> Bool
declare export let is_ascii_alnum: (Char) -> Bool
declare export let is_ascii_whitespace: (Char) -> Bool
to_int = (ch: Char) -> Int {
  char_to_int(ch)
}
export let from_int = (code: Int) -> Option[Char] {
  if code < 0 || code > 1114111 {
    None
  } else {
    Some(char_from_int(code))
  }
}
is_ascii = (ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 0 && code <= 127
}
to_string = (ch: Char) -> String {
  __to_string(ch)
}
export let from_string = (s: String) -> Option[Char] {
  if string_length(s) == 1 {
    from_int(string_char_code_at(s, 0))
  } else {
    None
  }
}
is_ascii_digit = (ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 48 && code <= 57
}
is_ascii_hexdigit = (ch: Char) -> Bool {
  let code = to_int(ch)
  is_ascii_digit(ch)
  || (code >= 65 && code <= 70)
  || (code >= 97 && code <= 102)
}
is_ascii_lowercase = (ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 97 && code <= 122
}
is_ascii_uppercase = (ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 65 && code <= 90
}
to_ascii_lowercase = (ch: Char) -> Char {
  if is_ascii_uppercase(ch) {
    char_from_int(to_int(ch) + 32)
  } else {
    ch
  }
}
to_ascii_uppercase = (ch: Char) -> Char {
  if is_ascii_lowercase(ch) {
    char_from_int(to_int(ch) - 32)
  } else {
    ch
  }
}
is_ascii_alphabetic = (ch: Char) -> Bool {
  is_ascii_lowercase(ch) || is_ascii_uppercase(ch)
}
is_ascii_alnum = (ch: Char) -> Bool {
  is_ascii_alphabetic(ch) || is_ascii_digit(ch)
}
is_ascii_whitespace = (ch: Char) -> Bool {
  let code = to_int(ch)
  code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}
