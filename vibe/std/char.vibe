export let is_ascii = (code: Int) -> Bool {
  code >= 0 && code <= 127
}

export let is_ascii_digit = (code: Int) -> Bool {
  code >= 48 && code <= 57
}

export let is_ascii_lowercase = (code: Int) -> Bool {
  code >= 97 && code <= 122
}

export let is_ascii_uppercase = (code: Int) -> Bool {
  code >= 65 && code <= 90
}

export let is_ascii_alphabetic = (code: Int) -> Bool {
  is_ascii_lowercase(code) || is_ascii_uppercase(code)
}

export let is_ascii_alnum = (code: Int) -> Bool {
  is_ascii_alphabetic(code) || is_ascii_digit(code)
}

export let is_ascii_whitespace = (code: Int) -> Bool {
  code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}

export let is_ascii_hexdigit = (code: Int) -> Bool {
  is_ascii_digit(code)
    || (code >= 65 && code <= 70)
    || (code >= 97 && code <= 102)
}

export let to_ascii_lowercase = (code: Int) -> Int {
  if is_ascii_uppercase(code) {
    code + 32
  } else {
    code
  }
}

export let to_ascii_uppercase = (code: Int) -> Int {
  if is_ascii_lowercase(code) {
    code - 32
  } else {
    code
  }
}

export let to_string = (code: Int) -> String {
  string_from_char_code(code)
}

export let from_string = (s: String) -> Option[Int] {
  if string_length(s) == 1 {
    Some(string_char_code_at(s, 0))
  } else {
    None
  }
}
