
use ./array.vibe {
  length,
  is_empty,
  get,
  head,
  last,
  append,
  slice,
  reverse,
  array_map,
  filter,
  fold,
  find,
  any,
  all
}
test "array_basic_access" {
  assert(eq(length([
    1,
    2,
    3
  ]), 3))
  assert(is_empty([
  ]))
  assert(not(is_empty([
    1
  ])))
  match get([
    10,
    20
  ], 1) {
    Some(v) => assert(eq(v, 20)),
    _ => assert(false)
  }
  match get([
    10,
    20
  ], 2) {
    None => assert(true),
    _ => assert(false)
  }
  match head([
    5,
    6
  ]) {
    Some(v) => assert(eq(v, 5)),
    _ => assert(false)
  }
  match last([
    5,
    6
  ]) {
    Some(v) => assert(eq(v, 6)),
    _ => assert(false)
  }
}
test "array_transform" {
  assert(eq(array_length(append([
    1,
    2
  ], [
    3
  ])), 3))
  assert(eq(array_length(slice([
    0,
    1,
    2,
    3
  ], 1, 3)), 2))
  let reversed = reverse([
    1,
    2,
    3
  ])
  assert(eq(array_get(reversed, 0), 3))
  assert(eq(array_get(reversed, 2), 1))
  let doubled = array_map([
    1,
    2,
    3
  ], (x: Int) -> Int {
    x * 2
  })
  assert(eq(array_get(doubled, 0), 2))
  assert(eq(array_get(doubled, 2), 6))
  let evens = filter([
    1,
    2,
    3,
    4
  ], (x: Int) -> Bool {
    x % 2 == 0
  })
  assert(eq(array_length(evens), 2))
  assert(eq(array_get(evens, 0), 2))
  assert(eq(array_get(evens, 1), 4))
}
test "array_fold_find_predicates" {
  let sum = fold([
    1,
    2,
    3,
    4
  ], 0, (acc: Int, x: Int) -> Int {
    acc + x
  })
  assert(eq(sum, 10))
  match find([
    3,
    7,
    9
  ], (x: Int) -> Bool {
    x > 5
  }) {
    Some(v) => assert(eq(v, 7)),
    _ => assert(false)
  }
  match find([
    1,
    2
  ], (x: Int) -> Bool {
    x > 5
  }) {
    None => assert(true),
    _ => assert(false)
  }
  assert(any([
    1,
    2,
    8
  ], (x: Int) -> Bool {
    x > 5
  }))
  assert(not(any([
    1,
    2,
    3
  ], (x: Int) -> Bool {
    x > 5
  })))
  assert(all([
    2,
    4,
    6
  ], (x: Int) -> Bool {
    x % 2 == 0
  }))
  assert(not(all([
    2,
    3,
    6
  ], (x: Int) -> Bool {
    x % 2 == 0
  })))
}
