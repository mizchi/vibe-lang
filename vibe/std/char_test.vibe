use ./char.vibe {
  is_ascii,
  is_ascii_digit,
  is_ascii_lowercase,
  is_ascii_uppercase,
  is_ascii_alphabetic,
  is_ascii_alnum,
  is_ascii_whitespace,
  is_ascii_hexdigit,
  to_ascii_lowercase,
  to_ascii_uppercase,
  to_string,
  from_string
}
test "char_ascii_classes" {
  assert(is_ascii(65))
  assert(not(is_ascii(200)))
  assert(is_ascii_digit(48))
  assert(not(is_ascii_digit(65)))
  assert(is_ascii_lowercase(97))
  assert(is_ascii_uppercase(65))
  assert(is_ascii_alphabetic(90))
  assert(is_ascii_alnum(57))
  assert(is_ascii_alnum(90))
  assert(not(is_ascii_alnum(45)))
  assert(is_ascii_whitespace(32))
  assert(is_ascii_whitespace(10))
  assert(is_ascii_hexdigit(102))
  assert(not(is_ascii_hexdigit(103)))
}
test "char_ascii_case_convert" {
  assert(eq(to_ascii_lowercase(65), 97))
  assert(eq(to_ascii_lowercase(97), 97))
  assert(eq(to_ascii_uppercase(97), 65))
  assert(eq(to_ascii_uppercase(65), 65))
}
test "char_string_bridge" {
  assert(string_equals(to_string(65), "A"))
  match from_string("A") {
    Some(code) => assert(eq(code, 65)),
    _ => assert(false)
  }
  match from_string("") {
    None => assert(true),
    _ => assert(false)
  }
  match from_string("AB") {
    None => assert(true),
    _ => assert(false)
  }
}
