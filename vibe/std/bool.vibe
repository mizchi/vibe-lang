declare export let bool_nor: (Bool, Bool) -> Bool
declare export let nor: (Bool, Bool) -> Bool
declare export let bool_xor: (Bool, Bool) -> Bool
declare export let xor: (Bool, Bool) -> Bool
declare export let bool_all3: (Bool, Bool, Bool) -> Bool
declare export let all3: (Bool, Bool, Bool) -> Bool
declare export let bool_any3: (Bool, Bool, Bool) -> Bool
declare export let any3: (Bool, Bool, Bool) -> Bool
declare export let bool_nand: (Bool, Bool) -> Bool
declare export let nand: (Bool, Bool) -> Bool
declare export let bool_to_int: (Bool) -> Int
declare export let to_int: (Bool) -> Int
declare export let int_to_bool: (Int) -> Bool
declare export let from_int: (Int) -> Bool
declare export let bool_implies: (Bool, Bool) -> Bool
declare export let implies: (Bool, Bool) -> Bool
declare export let Bool::nor: (Bool, Bool) -> Bool
declare export let Bool::xor: (Bool, Bool) -> Bool
declare export let Bool::all3: (Bool, Bool, Bool) -> Bool
declare export let Bool::any3: (Bool, Bool, Bool) -> Bool
declare export let Bool::nand: (Bool, Bool) -> Bool
declare export let Bool::to_int: (Bool) -> Int
declare export let Bool::implies: (Bool, Bool) -> Bool
// NOR (not or)
bool_nor = (a: Bool, b: Bool) -> Bool {
  not(a || b)
}
// Short names (preferred): use with method-call desugar, e.g. b.implies(other)
nor = (a: Bool, b: Bool) -> Bool {
  bool_nor(a, b)
}
// Exclusive or (xor)
bool_xor = (a: Bool, b: Bool) -> Bool {
  if a {
    not(b)
  } else {
    b
  }
}
xor = (a: Bool, b: Bool) -> Bool {
  bool_xor(a, b)
}
bool_all3 = (a: Bool, b: Bool, c: Bool) -> Bool {
  a && b && c
}
// Short names (preferred): use with method-call desugar, e.g. b.implies(other)
all3 = (a: Bool, b: Bool, c: Bool) -> Bool {
  bool_all3(a, b, c)
}
// Any predicate true
bool_any3 = (a: Bool, b: Bool, c: Bool) -> Bool {
  a || b || c
}
any3 = (a: Bool, b: Bool, c: Bool) -> Bool {
  bool_any3(a, b, c)
}
// Logical implication: a implies b
bool_nand = (a: Bool, b: Bool) -> Bool {
  not(a && b)
}
nand = (a: Bool, b: Bool) -> Bool {
  bool_nand(a, b)
}
// Convert bool to int (true=1, false=0)
bool_to_int = (b: Bool) -> Int {
  if b {
    1
  } else {
    0
  }
}
to_int = (b: Bool) -> Int {
  bool_to_int(b)
}
// Convert int to bool (0=false, else=true)
int_to_bool = (n: Int) -> Bool {
  n != 0
}
from_int = (n: Int) -> Bool {
  int_to_bool(n)
}
bool_implies = (a: Bool, b: Bool) -> Bool {
  if a {
    b
  } else {
    true
  }
}
implies = (a: Bool, b: Bool) -> Bool {
  bool_implies(a, b)
}
// Type member names: can be imported with `use <module-ref> { Bool }`
Bool::nor = (a: Bool, b: Bool) -> Bool {
  bool_nor(a, b)
}
// Exclusive or (xor)
Bool::xor = (a: Bool, b: Bool) -> Bool {
  bool_xor(a, b)
}
// All predicates true
Bool::all3 = (a: Bool, b: Bool, c: Bool) -> Bool {
  bool_all3(a, b, c)
}
// Any predicate true
Bool::any3 = (a: Bool, b: Bool, c: Bool) -> Bool {
  bool_any3(a, b, c)
}
// NAND (not and)
Bool::nand = (a: Bool, b: Bool) -> Bool {
  bool_nand(a, b)
}
// Convert bool to int (true=1, false=0)
Bool::to_int = (b: Bool) -> Int {
  bool_to_int(b)
}
// Logical implication: a implies b
Bool::implies = (a: Bool, b: Bool) -> Bool {
  bool_implies(a, b)
}
