use ./threads / runtime.vibe {
  probe_wat,
  runtime_hints,
  channel_new,
  spawn,
  send,
  recv,
  wait
}
test "threads/runtime probe and hints typecheck" {
  let _ = probe_wat
  let _ = runtime_hints
  assert(true)
}
test "threads/runtime unstable APIs stay thunk-only in std tests" {
  let channel_new_fn = () -> Int {
    channel_new(1)
  }
  let spawn_fn = (ch: Int) -> Int {
    spawn("worker", ch)
  }
  let send_fn = (ch: Int) -> Bool {
    send(ch, "msg")
  }
  let recv_fn = (ch: Int) -> String {
    recv(ch)
  }
  let wait_fn = (task: Int) -> Int {
    wait(task)
  }
  assert(true)
}
