declare export let Int::signum: (Int) -> Int
declare export let Int::is_even: (Int) -> Bool
declare export let Int::is_zero: (Int) -> Bool
declare export let Int::factorial: (Int) -> Int
declare export let Int::fibonacci: (Int) -> Int
