declare export let Int::is_negative: (Int) -> Bool
declare export let Int::is_positive: (Int) -> Bool
let int_max = (a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}
max = (a: Int, b: Int) -> Int {
  int_max(a, b)
}
let int_min = (a: Int, b: Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}
min = (a: Int, b: Int) -> Int {
  int_min(a, b)
}
let rec int_pow = (base: Int, exp: Int) -> Int {
  if exp <= 0 {
    1
  }
  else if exp == 1 {
    base
  }
  else if exp % 2 == 0 {
    let half = int_pow(base, exp / 2)
    half * half
  } else {
    base * int_pow(base, exp - 1)
  }
}
// Short names (preferred): use with method-call desugar, e.g. x.abs()
pow = (base: Int, exp: Int) -> Int {
  int_pow(base, exp)
}
let int_clamp = (x: Int, min_val: Int, max_val: Int) -> Int {
  if x < min_val {
    min_val
  }
  else if x > max_val {
    max_val
  }
  else {
    x
  }
}
clamp = (x: Int, min_val: Int, max_val: Int) -> Int {
  int_clamp(x, min_val, max_val)
}
let int_is_odd = (x: Int) -> Bool {
  x % 2 != 0
}
is_odd = (x: Int) -> Bool {
  int_is_odd(x)
}
let int_signum = (x: Int) -> Int {
  if x < 0 {
    -1
  }
  else if x > 0 {
    1
  }
  else {
    0
  }
}
signum = (x: Int) -> Int {
  int_signum(x)
}
let int_is_even = (x: Int) -> Bool {
  x % 2 == 0
}
is_even = (x: Int) -> Bool {
  int_is_even(x)
}
let int_is_zero = (x: Int) -> Bool {
  x == 0
}
is_zero = (x: Int) -> Bool {
  int_is_zero(x)
}
let rec int_factorial = (n: Int) -> Int {
  if n <= 1 {
    1
  }
  else {
    n * int_factorial(n - 1)
  }
}
factorial = (n: Int) -> Int {
  int_factorial(n)
}
let int_fibonacci = (n: Int) -> Int {
  let rec fib = (a: Int, b: Int, count: Int) -> Int {
    if count <= 0 {
      a
    }
    else {
      fib(b, a + b, count - 1)
    }
  }
  fib(0, 1, n)
}
fibonacci = (n: Int) -> Int {
  int_fibonacci(n)
}
let int_max_value: Int = 2305843009213693951
max_value = int_max_value
let int_min_value: Int = 0 - 2305843009213693951 - 1
let int_abs = (x: Int) -> Int {
  if x == int_min_value {
    int_max_value
  }
  else if x < 0 {
    0 - x
  }
  else {
    x
  }
}
abs = (x: Int) -> Int {
  int_abs(x)
}
let rec int_gcd = (a: Int, b: Int) -> Int {
  let abs_a = int_abs(a)
  let abs_b = int_abs(b)
  if abs_b == 0 {
    abs_a
  }
  else {
    int_gcd(abs_b, abs_a % abs_b)
  }
}
// Short names (preferred): use with method-call desugar, e.g. x.abs()
gcd = (a: Int, b: Int) -> Int {
  int_gcd(a, b)
}
let int_lcm = (a: Int, b: Int) -> Int {
  if a == 0 || b == 0 {
    0
  }
  else {
    let g = int_gcd(a, b)
    let scaled = a / g
    int_abs(scaled * b)
  }
}
lcm = (a: Int, b: Int) -> Int {
  int_lcm(a, b)
}
min_value = int_min_value
let int_is_negative = (x: Int) -> Bool {
  x < 0
}
is_negative = (x: Int) -> Bool {
  int_is_negative(x)
}
let int_is_positive = (x: Int) -> Bool {
  x > 0
}
is_positive = (x: Int) -> Bool {
  int_is_positive(x)
}
Int::abs = (x: Int) -> Int {
  int_abs(x)
}
Int::gcd = (a: Int, b: Int) -> Int {
  int_gcd(a, b)
}
Int::lcm = (a: Int, b: Int) -> Int {
  int_lcm(a, b)
}
// Maximum of two integers
Int::max = (a: Int, b: Int) -> Int {
  int_max(a, b)
}
Int::min = (a: Int, b: Int) -> Int {
  int_min(a, b)
}
// Type member names: can be imported with `use <module-ref> { Int }`
Int::pow = (base: Int, exp: Int) -> Int {
  int_pow(base, exp)
}
Int::clamp = (x: Int, min_val: Int, max_val: Int) -> Int {
  int_clamp(x, min_val, max_val)
}
Int::is_odd = (x: Int) -> Bool {
  int_is_odd(x)
}
Int::signum = (x: Int) -> Int {
  int_signum(x)
}
// Is even
Int::is_even = (x: Int) -> Bool {
  int_is_even(x)
}
// Type member names: can be imported with `use <module-ref> { Int }`
Int::is_zero = (x: Int) -> Bool {
  int_is_zero(x)
}
Int::factorial = (n: Int) -> Int {
  int_factorial(n)
}
Int::fibonacci = (n: Int) -> Int {
  int_fibonacci(n)
}
Int::to_double = (x: Int) -> Double {
  int_to_double(x)
}
Int::is_negative = (x: Int) -> Bool {
  int_is_negative(x)
}
Int::is_positive = (x: Int) -> Bool {
  int_is_positive(x)
}
