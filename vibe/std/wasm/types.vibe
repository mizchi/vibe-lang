
export type I32 = i32
export type F32 = f32
export type F64 = f64
declare export let f32_id: (Float) -> Float
declare export let f64_id: (Double) -> Double
declare export let i32_add: (Int, Int) -> Int
f32_id = (x: f32) -> f32 {
  x
}
f64_id = (x: f64) -> f64 {
  x
}
i32_add = (a: i32, b: i32) -> i32 {
  a + b
}
