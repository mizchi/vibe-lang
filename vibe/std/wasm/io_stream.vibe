declare export let stdin_read: (Int) -> String with {
  Stdin
}
declare export let ansi_escape: (String) -> Unit with {
  Stdout
}
declare export let stdout_write: (String) -> Unit with {
  Stdout
}
declare export let stdout_writeln: (String) -> Unit with {
  Stdout
}
declare export let tui_cursor_home: () -> Unit with {
  Stdout
}
declare export let tui_clear_screen: () -> Unit with {
  Stdout
}
declare export let tui_enter_alt_screen: () -> Unit with {
  Stdout
}
declare export let tui_leave_alt_screen: () -> Unit with {
  Stdout
}
stdin_read = (max_bytes: Int) -> String with {
  Stdin
} {
  do {
    stdin_read_stream(max_bytes)
  }
}
ansi_escape = (suffix: String) -> Unit with {
  Stdout
} {
  do {
    stdout_write_char(27)
    stdout_write_stream(suffix)
  }
}
stdout_write = (s: String) -> Unit with {
  Stdout
} {
  do {
    stdout_write_stream(s)
  }
}
stdout_writeln = (s: String) -> Unit with {
  Stdout
} {
  do {
    stdout_write_stream(s)
    stdout_write_char(10)
  }
}
tui_cursor_home = () -> Unit with {
  Stdout
} {
  do {
    ansi_escape("[H")
  }
}
tui_clear_screen = () -> Unit with {
  Stdout
} {
  do {
    ansi_escape("[2J")
  }
}
tui_enter_alt_screen = () -> Unit with {
  Stdout
} {
  do {
    ansi_escape("[?1049h")
  }
}
tui_leave_alt_screen = () -> Unit with {
  Stdout
} {
  do {
    ansi_escape("[?1049l")
  }
}
