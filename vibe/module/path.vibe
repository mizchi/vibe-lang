export let dir_of = (file_path: String) -> String {
  let idx = string_last_index_of(file_path, "/")
  if idx < 0 { "" }
  else { string_substring(file_path, 0, idx) }
}

export let resolve_path = (base_dir: String, raw_path: String) -> String {
  let len = string_length(raw_path)
  if len >= 3 {
    if string_equals(string_substring(raw_path, 0, 3), "../") {
      let rest = string_substring(raw_path, 3, len)
      let parent = dir_of(base_dir)
      let resolved = if string_ends_with(rest, ".vibe") { rest }
                     else { string_concat(rest, ".vibe") }
      if string_equals(parent, "") { resolved }
      else { string_concat(parent, string_concat("/", resolved)) }
    }
    else if string_equals(string_substring(raw_path, 0, 2), "./") {
      let rest = string_substring(raw_path, 2, len)
      let resolved = if string_ends_with(rest, ".vibe") { rest }
                     else { string_concat(rest, ".vibe") }
      if string_equals(base_dir, "") { resolved }
      else { string_concat(base_dir, string_concat("/", resolved)) }
    }
    else { raw_path }
  }
  else if len >= 2 {
    if string_equals(string_substring(raw_path, 0, 2), "./") {
      let rest = string_substring(raw_path, 2, len)
      let resolved = if string_ends_with(rest, ".vibe") { rest }
                     else { string_concat(rest, ".vibe") }
      if string_equals(base_dir, "") { resolved }
      else { string_concat(base_dir, string_concat("/", resolved)) }
    }
    else { raw_path }
  }
  else { raw_path }
}
