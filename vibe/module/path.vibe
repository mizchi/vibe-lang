//# Functions

export let dir_of = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  }
  else {
    file_path[0..idx]
  }
}

export let resolve_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  if len >= 3 {
    if raw_path[0..3] == "../" {
      let rest = raw_path[3..len]
      let parent = dir_of(base_dir)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      }
      else {
        "\{rest}.vibe"
      }
      if parent == "" {
        resolved
      }
      else {
        "\{parent}/\{resolved}"
      }
    }
    else if raw_path[0..2] == "./" {
      let rest = raw_path[2..len]
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      }
      else {
        "\{rest}.vibe"
      }
      if base_dir == "" {
        resolved
      }
      else {
        "\{base_dir}/\{resolved}"
      }
    }
    else {
      raw_path
    }
  }
  else if len >= 2 {
    if raw_path[0..2] == "./" {
      let rest = raw_path[2..len]
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      }
      else {
        "\{rest}.vibe"
      }
      if base_dir == "" {
        resolved
      }
      else {
        "\{base_dir}/\{resolved}"
      }
    }
    else {
      raw_path
    }
  }
  else {
    raw_path
  }
}
