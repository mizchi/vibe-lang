//# Imports

import ./path.vibe {
  dir_of, resolve_path
}

//# Misc

test "dir_of extracts parent directory" {
  assert(dir_of("a/b/c.vibe") == "a/b")
  assert(dir_of("main.vibe") == "")
}

test "resolve_path resolves ./ and appends .vibe" {
  assert(resolve_path("a/b", "./mod") == "a/b/mod.vibe")
  assert(resolve_path("", "./main") == "main.vibe")
}

test "resolve_path resolves ../ relative to parent" {
  assert(resolve_path("a/b", "../mod") == "a/mod.vibe")
  assert(resolve_path("a/b", "../mod.vibe") == "a/mod.vibe")
}

test "resolve_path leaves non-local namespace untouched" {
  assert(resolve_path("a/b", "std/prelude") == "std/prelude")
}
