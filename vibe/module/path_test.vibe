//# Imports

import ./path.vibe {
  dir_of, resolve_path
}

//# Misc

test "dir_of extracts parent directory" {
  assert(string_equals(dir_of("a/b/c.vibe"), "a/b"))
  assert(string_equals(dir_of("main.vibe"), ""))
}

test "resolve_path resolves ./ and appends .vibe" {
  assert(string_equals(resolve_path("a/b", "./mod"), "a/b/mod.vibe"))
  assert(string_equals(resolve_path("", "./main"), "main.vibe"))
}

test "resolve_path resolves ../ relative to parent" {
  assert(string_equals(resolve_path("a/b", "../mod"), "a/mod.vibe"))
  assert(string_equals(resolve_path("a/b", "../mod.vibe"), "a/mod.vibe"))
}

test "resolve_path leaves non-local namespace untouched" {
  assert(string_equals(resolve_path("a/b", "std/prelude"), "std/prelude"))
}
