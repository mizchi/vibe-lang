
export let run = (cmd: String) -> Unit with {
  Process
} {
  do {
    sh(cmd)
  }
}
export let run_lines = (cmd: String) -> Array[String] with {
  Process
} {
  do {
    sh_lines(cmd)
  }
}
export let run_text = (cmd: String) -> String with {
  Process
} {
  string_join(do {
    run_lines(cmd)
  }, "\n")
}
let first_line = (lines: Array[String]) -> String {
  if array_length(lines) == 0 {
    ""
  } else {
    array_get(lines, 0)
  }
}
export let run_line = (cmd: String) -> String with {
  Process
} {
  first_line(do {
    run_lines(cmd)
  })
}
export {
  run, run_lines, run_line, run_text
}
export {
  run, run_line, run_text, run_lines
}
