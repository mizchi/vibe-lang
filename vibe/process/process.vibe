//# Functions

// run: (String) -> Unit with {Process}
export let run = (cmd: String) -> Unit with { Process } {
  sh(cmd)
}

// run_lines: (String) -> Array[String] with {Process}
export let run_lines = (cmd: String) -> Array[String] with { Process } {
  sh_lines(cmd)
}

// run_text: (String) -> String with {Process}
export let run_text = (cmd: String) -> String with { Process } {
  String::join(run_lines(cmd), "\n")
}

let first_line = (lines: Array[String]) -> String {
  if Array::length(lines) == 0 {
    ""
  } else Array::get(lines, 0)
}

// run_line: (String) -> String with {Process}
export let run_line = (cmd: String) -> String with { Process } {
  first_line(run_lines(cmd))
}
