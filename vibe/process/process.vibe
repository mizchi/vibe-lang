//# Functions

// run: (String) -> Unit with { Process }
export let run: (String) -> Unit with { Process } = (cmd) -> {
  sh(cmd)
}

// run_lines: (String) -> Array[String] with { Process }
export let run_lines: (String) -> Array[String] with { Process } = (cmd) -> {
  sh_lines(cmd)
}

// run_text: (String) -> String with { Process }
export let run_text: (String) -> String with { Process } = (cmd) -> {
  String::join(run_lines(cmd), "\n")
}

let first_line: (Array[String]) -> String = (lines) -> {
  if Array::length(lines) == 0 {
    ""
  } else Array::get(lines, 0)
}

// run_line: (String) -> String with { Process }
export let run_line: (String) -> String with { Process } = (cmd) -> {
  first_line(run_lines(cmd))
}
