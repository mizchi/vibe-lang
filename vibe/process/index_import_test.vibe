
use ./index.vibe {
  run, run_lines, run_line, run_text
}
test "process index exports shell wrappers" {
  let lines = do {
    run_lines("printf 'a\\nb\\nc'")
  }
  assert(eq(array_length(lines), 3))
  assert(string_equals(array_get(lines, 0), "a"))
  assert(string_equals(array_get(lines, 2), "c"))
  let first = do {
    run_line("printf 'first\\nsecond'")
  }
  assert(string_equals(first, "first"))
  let text = do {
    run_text("printf 'x\\ny'")
  }
  assert(string_equals(text, "x\ny"))
  do {
    run("echo process module smoke")
  }
}
