//# Imports

import ./index.vibe {
  run, run_lines, run_line, run_text,
  process_run, process_run_lines, process_run_line, process_run_text
}

//# Misc

test "process index exports shell wrappers" {
  let lines = run_lines("printf 'a\\nb\\nc'")
  assert(eq(array_length(lines), 3))
  assert(string_equals(array_get(lines, 0), "a"))
  assert(string_equals(array_get(lines, 2), "c"))
  let first = run_line("printf 'first\\nsecond'")
  assert(string_equals(first, "first"))
  let text = run_text("printf 'x\\ny'")
  assert(string_equals(text, "x\ny"))
  run("echo process module smoke")
}

test "process index exports canonical aliases" {
  let lines = process_run_lines("printf 'a\\nb\\nc'")
  assert(eq(array_length(lines), 3))
  assert(string_equals(array_get(lines, 0), "a"))
  assert(string_equals(array_get(lines, 2), "c"))
  let first = process_run_line("printf 'first\\nsecond'")
  assert(string_equals(first, "first"))
  let text = process_run_text("printf 'x\\ny'")
  assert(string_equals(text, "x\ny"))
  process_run("echo process alias smoke")
}
