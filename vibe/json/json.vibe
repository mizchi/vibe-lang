//# Types

export enum Json {
  JNull;
  JBool(Bool);
  JNum(Double);
  JStr(String);
  JArr(Array[Json]);
  JObj(Map[String, Json])
}

//# Functions

let is_ws = (c: Int) -> Bool {
  c == ' ' || c == '\n' || c == '\t' || c == '\r'
}

let rec skip_ws = (s: String, len: Int, i: Int) -> Int {
  if i < len {
    let c = string_char_code_at(s, i)
    if is_ws(c) {
      skip_ws(s, len, i + 1)
    } else i
  } else i
}

let is_digit = (c: Int) -> Bool {
  c >= '0' && c < ':'
}

export let json_get = (j: Json, key: String) -> Json with { Error } {
  match j {
    JObj(m) => if map_has_key(m, key) {
      map_get(m, key)
    } else throw(string_concat("key not found: ", key)),
    _ => throw("not an object")
  }
}

export let json_as_arr = (j: Json) -> Array[Json] with { Error } {
  match j {
    JArr(a) => a,
    _ => throw("not an array")
  }
}

export let json_as_num = (j: Json) -> Double with { Error } {
  match j {
    JNum(n) => n,
    _ => throw("not a number")
  }
}

export let json_as_obj = (j: Json) -> Map[String, Json] with { Error } {
  match j {
    JObj(m) => m,
    _ => throw("not an object")
  }
}

export let json_as_str = (j: Json) -> String with { Error } {
  match j {
    JStr(s) => s,
    _ => throw("not a string")
  }
}

export let json_as_bool = (j: Json) -> Bool with { Error } {
  match j {
    JBool(b) => b,
    _ => throw("not a bool")
  }
}

let parse_string = (s: String, len: Int, i: Int) -> (String, Int)with { Error } {
  if i >= len {
    throw("unexpected eof")
  }
  else if string_char_code_at(s, i) != '"' {
    throw("expected string")
  }
  else {
    let rec scan = (idx: Int, start: Int, acc: String) -> (String, Int)with { Error } {
      if idx >= len {
        throw("unterminated string")
      }
      else {
        let c = string_char_code_at(s, idx)
        if c < ' ' {
          throw("invalid string")
        }
        else if c == '"' {
          let chunk = string_substring(s, start, idx)
          (string_concat(acc, chunk), idx + 1)
        }
        else if c == '\\' {
          let chunk = string_substring(s, start, idx)
          let next = idx + 1
          if next >= len {
            throw("unterminated string")
          }
          else {
            let esc = string_char_code_at(s, next)
            let escaped = if esc == '"' {
              "\""
            } else if esc == '\\' {
              "\\"
            } else if esc == '/' {
              "/"
            } else if esc == 'n' {
              "\n"
            } else if esc == 't' {
              "\t"
            } else if esc == 'r' {
              string_from_char_code(13)
            } else throw("invalid escape")
            scan(next + 1, next + 1, string_concat(string_concat(acc, chunk), escaped))
          }
        }
        else scan(idx + 1, start, acc)
      }
    }
    scan(i + 1, i + 1, "")
  }
}

let escape_string = (s: String) -> String {
  let len = string_length(s)
  let rec go = (i: Int, acc: String) -> String {
    if i < len {
      let c = string_char_code_at(s, i)
      let esc = if c == '"' {
        "\\\""
      } else if c == '\\' {
        "\\\\"
      } else if c == '\n' {
        "\\n"
      } else if c == '\t' {
        "\\t"
      } else if c == '\r' {
        "\\r"
      } else string_from_char_code(c)
      go(i + 1, string_concat(acc, esc))
    } else acc
  }
  string_concat(string_concat("\"", go(0, "")), "\"")
}

let format_number = (n: Double) -> String {
  let s = __to_string(n)
  let len = string_length(s)
  if len >= 2 && string_char_code_at(s, len - 1) == '0' && string_char_code_at(s, len - 2) == '.' {
    string_substring(s, 0, len - 2)
  } else s
}

let rec apply_exponent = (value: Double, exp: Int) -> Double {
  if exp == 0 {
    value
  }
  else if exp < 0 {
    apply_exponent(value / 10.0, exp + 1)
  }
  else apply_exponent(value * 10.0, exp - 1)
}

let build_json_map = (keys: Array[String], vals: Array[Json]) -> Map[String, Json] {
  {
    let b = MapBuilder::new()
    let len = array_length(keys)
    let mut i = 0
    while i < len {
      MapBuilder::set(b, array_get(keys, i), array_get(vals, i))
      i += 1
    }
    MapBuilder::freeze(b)
  }
}

let make_empty_map = () -> Map[String, Json] {
  {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
}

let rec stringify_impl = (j: Json) -> String {
  let stringify_array = (arr: Array[Json]) -> String {
    let len = array_length(arr)
    let rec go = (i: Int, acc: String) -> String {
      if i < len {
        let sep = if i > 0 {
          ","
        } else ""
        go(i + 1, string_concat(string_concat(acc, sep), stringify_impl(array_get(arr, i))))
      } else acc
    }
    string_concat(string_concat("[", go(0, "")), "]")
  }
  let stringify_object = (m: Map[String, Json]) -> String {
    let keys = map_keys(m)
    let len = array_length(keys)
    let rec go = (i: Int, acc: String) -> String {
      if i < len {
        let sep = if i > 0 {
          ","
        } else ""
        let k = array_get(keys, i)
        let entry = string_concat(string_concat(escape_string(k), ":"), stringify_impl(map_get(m, k)))
        go(i + 1, string_concat(string_concat(acc, sep), entry))
      } else acc
    }
    string_concat(string_concat("{", go(0, "")), "}")
  }
  match j {
    JNull => "null",
    JBool(b) => if b {
      "true"
    } else "false",
    JNum(n) => format_number(n),
    JStr(s) => escape_string(s),
    JArr(arr) => stringify_array(arr),
    JObj(m) => stringify_object(m)
  }
}

export let stringify = (j: Json) -> String {
  stringify_impl(j)
}

let digit_to_double = (c: Int) -> Double {
  int_to_double(c - 48)
}

let rec parse_fraction = (s: String, len: Int, i: Int, acc: Double, scale: Double, seen: Bool) -> (Double, Int)with { Error } {
  if i < len {
    let c = string_char_code_at(s, i)
    if is_digit(c) {
      parse_fraction(s, len, i + 1, acc + digit_to_double(c) / scale, scale * 10.0, true)
    } else if seen {
      (acc, i)
    } else throw("expected fraction")
  } else if seen {
    (acc, i)
  } else throw("expected fraction")
}

let empty_json_array = () -> Array[Json] {
  array_slice([
    JNull
  ], 0, 0)
}

let rec parse_digits_int = (s: String, len: Int, i: Int, acc: Int) -> (Int, Int) {
  if i < len {
    let c = string_char_code_at(s, i)
    if is_digit(c) {
      parse_digits_int(s, len, i + 1, acc * 10 + (c - 48))
    } else (acc, i)
  } else (acc, i)
}

let rec starts_with_from = (s: String, len: Int, i: Int, word: String, wi: Int, wlen: Int) -> Bool {
  if wi >= wlen {
    true
  }
  else {
    let si = i + wi
    if si >= len {
      false
    }
    else if string_char_code_at(s, si) == string_char_code_at(word, wi) {
      starts_with_from(s, len, i, word, wi + 1, wlen)
    }
    else false
  }
}

let starts_with = (s: String, len: Int, i: Int, word: String) -> Bool {
  let wlen = string_length(word)
  i + wlen <= len && starts_with_from(s, len, i, word, 0, wlen)
}

let rec parse_digits_double = (s: String, len: Int, i: Int, acc: Double, seen: Bool) -> (Double, Int)with { Error } {
  if i < len {
    let c = string_char_code_at(s, i)
    if is_digit(c) {
      parse_digits_double(s, len, i + 1, acc * 10.0 + digit_to_double(c), true)
    } else if seen {
      (acc, i)
    } else throw("expected digit")
  } else if seen {
    (acc, i)
  } else throw("expected digit")
}

let parse_int_part = (s: String, len: Int, i: Int) -> (Double, Int)with { Error } {
  if i < len {
    let c = string_char_code_at(s, i)
    if c == '0' {
      let next = i + 1
      if next < len && is_digit(string_char_code_at(s, next)) {
        throw("leading zero")
      } else (0.0, next)
    }
    else if is_digit(c) {
      parse_digits_double(s, len, i, 0.0, false)
    }
    else throw("expected digit")
  } else throw("expected digit")
}

let parse_exponent_if_any = (s: String, len: Int, i: Int, value: Double) -> (Double, Int)with { Error } {
  let parse_exp = (exp_sign: Int, exp_idx: Int) -> (Double, Int)with { Error } {
    if exp_idx < len && is_digit(string_char_code_at(s, exp_idx)) {
      let (exp, exp_next) = parse_digits_int(s, len, exp_idx, 0)
      let signed_exp = if exp_sign < 0 {
        0 - exp
      } else {
        exp
      }
      (apply_exponent(value, signed_exp), exp_next)
    } else throw("expected exponent")
  }
  if i < len {
    let c = string_char_code_at(s, i)
    if c == 'e' || c == 'E' {
      let exp_start = i + 1
      if exp_start < len {
        let sign_char = string_char_code_at(s, exp_start)
        if sign_char == '-' {
          parse_exp(-1, exp_start + 1)
        } else if sign_char == '+' {
          parse_exp(1, exp_start + 1)
        } else parse_exp(1, exp_start)
      } else throw("expected exponent")
    } else (value, i)
  } else (value, i)
}

let parse_fraction_if_any = (s: String, len: Int, i: Int, value: Double) -> (Double, Int)with { Error } {
  if i < len && string_char_code_at(s, i) == '.' {
    let (frac, next) = parse_fraction(s, len, i + 1, 0.0, 10.0, false)
    (value + frac, next)
  } else (value, i)
}

let parse_number_body = (s: String, len: Int, idx: Int, sign: Double) -> (Json, Int)with { Error } {
  let (int_part, next) = parse_int_part(s, len, idx)
  let (with_frac, next_frac) = parse_fraction_if_any(s, len, next, int_part)
  let (with_exp, next_exp) = parse_exponent_if_any(s, len, next_frac, with_frac)
  (JNum(with_exp * sign), next_exp)
}

let parse_number = (s: String, len: Int, i: Int) -> (Json, Int)with { Error } {
  if i >= len {
    throw("expected number")
  } else if string_char_code_at(s, i) == '-' {
    parse_number_body(s, len, i + 1, -1.0)
  } else parse_number_body(s, len, i, 1.0)
}

let rec parse_value = (s: String, len: Int, i: Int) -> (Json, Int)with { Error } {
  let idx = skip_ws(s, len, i)
  if idx >= len {
    throw("unexpected eof")
  }
  else {
    let c = string_char_code_at(s, idx)
    if c == 'n' {
      if starts_with(s, len, idx, "null") {
        (JNull, idx + 4)
      } else throw("expected null")
    }
    else if c == 't' {
      if starts_with(s, len, idx, "true") {
        (JBool(true), idx + 4)
      } else throw("expected true")
    }
    else if c == 'f' {
      if starts_with(s, len, idx, "false") {
        (JBool(false), idx + 5)
      } else throw("expected false")
    }
    else if c == '"' {
      let (value, next) = parse_string(s, len, idx)
      (JStr(value), next)
    }
    else if c == '[' {
      {
        let arr_start = skip_ws(s, len, idx + 1)
        if arr_start >= len {
          throw("unexpected eof")
        } else if string_char_code_at(s, arr_start) == ']' {
          (JArr(empty_json_array()), arr_start + 1)
        } else {
          let b = array_builder()
          let (first_val, first_next) = parse_value(s, len, arr_start)
          array_builder_push(b, first_val)
          let mut cur = skip_ws(s, len, first_next)
          while cur < len && string_char_code_at(s, cur) == ',' {
            let (v, nx) = parse_value(s, len, cur + 1)
            array_builder_push(b, v)
            cur = skip_ws(s, len, nx)
          }
          if cur < len && string_char_code_at(s, cur) == ']' {
            (JArr(array_builder_freeze(b)), cur + 1)
          } else throw("expected , or ]")
        }
      }
    }
    else if c == '{' {
      {
        let obj_start = skip_ws(s, len, idx + 1)
        if obj_start >= len {
          throw("unexpected eof")
        } else if string_char_code_at(s, obj_start) == '}' {
          (JObj(make_empty_map()), obj_start + 1)
        } else {
          let kb = array_builder()
          let vb = array_builder()
          let (first_key, kn) = parse_string(s, len, obj_start)
          let colon1 = skip_ws(s, len, kn)
          if colon1 >= len || string_char_code_at(s, colon1) != ':' {
            throw("expected :")
          } else {
            let (first_val, vn) = parse_value(s, len, colon1 + 1)
            array_builder_push(kb, first_key)
            array_builder_push(vb, first_val)
            let mut cur = skip_ws(s, len, vn)
            while cur < len && string_char_code_at(s, cur) == ',' {
              let ws_after_comma = skip_ws(s, len, cur + 1)
              let (k, kn2) = parse_string(s, len, ws_after_comma)
              let colon2 = skip_ws(s, len, kn2)
              if colon2 >= len || string_char_code_at(s, colon2) != ':' {
                throw("expected :")
              }
              let (v, vn2) = parse_value(s, len, colon2 + 1)
              array_builder_push(kb, k)
              array_builder_push(vb, v)
              cur = skip_ws(s, len, vn2)
            }
            if cur < len && string_char_code_at(s, cur) == '}' {
              let keys = array_builder_freeze(kb)
              let vals = array_builder_freeze(vb)
              (JObj(build_json_map(keys, vals)), cur + 1)
            } else throw("expected , or }")
          }
        }
      }
    }
    else if c == '-' || is_digit(c) {
      parse_number(s, len, idx)
    }
    else throw("unexpected token")
  }
}

export let parse = (s: String) -> (Json, Int)with { Error } {
  let len = string_length(s)
  let (value, next) = parse_value(s, len, 0)
  let end = skip_ws(s, len, next)
  if end == len {
    (value, end)
  } else throw("trailing input")
}

export let parse_ok = (s: String) -> Bool {
  handle {
    let (_, end) = parse(s)
    end == string_length(s)
  } {
    Error(_) => false
  }
}

export let parse_err = (s: String) -> Bool {
  not(parse_ok(s))
}
