//# Imports

import ./json.vibe {
  Json
}

import ./jsonrpc.vibe {
  RpcId, RpcMessage, parse_message, stringify_error, stringify_notification, stringify_request, stringify_response
}

//# Misc

test "parse_request" {
  let msg = parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,2],\"id\":1}")
  match msg {
    Request(method, _, id) => {
      assert(method == "add")
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_request_string_id" {
  let msg = parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"foo\",\"params\":null,\"id\":\"abc\"}")
  match msg {
    Request(method, _, id) => {
      assert(method == "foo")
      match id {
        IdStr(s) => assert(s == "abc"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_request_null_id" {
  let msg = parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"foo\",\"params\":null,\"id\":null}")
  match msg {
    Request(_, _, id) => match id {
      IdNull => assert(true),
      _ => assert(false)
    },
    _ => assert(false)
  }
}

test "parse_notification" {
  let msg = parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"update\",\"params\":[1]}")
  match msg {
    Notification(method, _) => assert(method == "update"),
    _ => assert(false)
  }
}

test "parse_notification_no_params" {
  let msg = parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}")
  match msg {
    Notification(method, params) => {
      assert(method == "ping")
      match params {
        JNull => assert(true),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_success_response" {
  let msg = parse_message("{\"jsonrpc\":\"2.0\",\"result\":42,\"id\":1}")
  match msg {
    SuccessResponse(id, result) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      match result {
        JNum(n) => assert(eq(n, 42.0)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_error_response" {
  let msg = parse_message("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"},\"id\":1}")
  match msg {
    ErrorResponse(id, code, message, _) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      assert(eq(code, -32601))
      assert(message == "Method not found")
    },
    _ => assert(false)
  }
}

test "parse_error_response_with_data" {
  let msg = parse_message("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid\",\"data\":\"detail\"},\"id\":\"x\"}")
  match msg {
    ErrorResponse(id, code, _, data) => {
      match id {
        IdStr(s) => assert(s == "x"),
        _ => assert(false)
      }
      assert(eq(code, -32600))
      match data {
        JStr(s) => assert(s == "detail"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_invalid_jsonrpc_version" {
  let ok = handle {
    let _ = parse_message("{\"jsonrpc\":\"1.0\",\"method\":\"foo\"}")
    true
  } with Error {
    Throw(_) => false
  }
  assert(not(ok))
}

test "parse_invalid_not_object" {
  let ok = handle {
    let _ = parse_message("[1,2,3]")
    true
  } with Error {
    Throw(_) => false
  }
  assert(not(ok))
}

test "parse_missing_jsonrpc" {
  let ok = handle {
    let _ = parse_message("{\"method\":\"foo\"}")
    true
  } with Error {
    Throw(_) => false
  }
  assert(not(ok))
}

test "stringify_request_roundtrip" {
  let s = stringify_request("add", JArr([
    JNum(1.0),
    JNum(2.0)
  ]), IdNum(1))
  let msg = parse_message(s)
  match msg {
    Request(method, _, id) => {
      assert(method == "add")
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "stringify_notification_roundtrip" {
  let s = stringify_notification("ping", JNull)
  let msg = parse_message(s)
  match msg {
    Notification(method, _) => assert(method == "ping"),
    _ => assert(false)
  }
}

test "stringify_response_roundtrip" {
  let s = stringify_response(IdNum(42), JStr("ok"))
  let msg = parse_message(s)
  match msg {
    SuccessResponse(id, result) => {
      match id {
        IdNum(n) => assert(eq(n, 42)),
        _ => assert(false)
      }
      match result {
        JStr(v) => assert(v == "ok"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "stringify_error_roundtrip" {
  let s = stringify_error(IdNum(1), -32601, "Method not found", JNull)
  let msg = parse_message(s)
  match msg {
    ErrorResponse(id, code, message, _) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      assert(eq(code, -32601))
      assert(message == "Method not found")
    },
    _ => assert(false)
  }
}
