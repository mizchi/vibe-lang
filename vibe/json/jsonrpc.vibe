//# Imports

import ./json.vibe {
  Json, Json::get, json_as_num, json_as_obj, json_as_str, parse, stringify
}

//# Types

export enum RpcId {
  IdNum(Int);
  IdStr(String);
  IdNull
}

export enum RpcMessage {
  Request(String, Json, RpcId);
  Notification(String, Json);
  SuccessResponse(RpcId, Json);
  ErrorResponse(RpcId, Int, String, Json)
}

//# Functions

let require_key = (obj: Map[String, Json], key: String) -> Json with { Error } {
  if Map::has_key(obj, key) {
    Map::get(obj, key)
  } else throw("missing key: \{key}")
}

let get_string = (obj: Map[String, Json], key: String) -> String with { Error } {
  let v = require_key(obj, key)
  match v {
    JStr(s) => s,
    _ => throw("expected string for key: \{key}")
  }
}

let parse_rpc_id = (j: Json) -> RpcId with { Error } {
  match j {
    JNum(n) => IdNum(Double::to_int(n)),
    JStr(s) => IdStr(s),
    JNull => IdNull,
    _ => throw("invalid id")
  }
}

export let parse_message = (input: String) -> RpcMessage with { Error } {
  let (json, _) = parse(input)
  let obj = match json {
    JObj(m) => m,
    _ => throw("expected object")
  }
  let jsonrpc = get_string(obj, "jsonrpc")
  if jsonrpc != "2.0" {
    throw("invalid jsonrpc version")
  }
  let has_method = Map::has_key(obj, "method")
  let has_result = Map::has_key(obj, "result")
  let has_error = Map::has_key(obj, "error")
  if has_method {
    let method = get_string(obj, "method")
    let params = if Map::has_key(obj, "params") {
      Map::get(obj, "params")
    } else JNull
    if Map::has_key(obj, "id") {
      let id = parse_rpc_id(Map::get(obj, "id"))
      Request(method, params, id)
    } else Notification(method, params)
  } else if has_result {
    let id = parse_rpc_id(require_key(obj, "id"))
    let result = Map::get(obj, "result")
    SuccessResponse(id, result)
  } else if has_error {
    let id = parse_rpc_id(require_key(obj, "id"))
    let err_json = Map::get(obj, "error")
    let err_obj = match err_json {
      JObj(m) => m,
      _ => throw("error must be object")
    }
    let code = match require_key(err_obj, "code") {
      JNum(n) => Double::to_int(n),
      _ => throw("error code must be number")
    }
    let message = get_string(err_obj, "message")
    let data = if Map::has_key(err_obj, "data") {
      Map::get(err_obj, "data")
    } else JNull
    ErrorResponse(id, code, message, data)
  } else throw("invalid message: missing method, result, or error")
}

let rpc_id_json_str = (id: RpcId) -> String {
  match id {
    IdNum(n) => stringify(JNum(Int::to_double(n))),
    IdStr(s) => stringify(JStr(s)),
    IdNull => "null"
  }
}

export let stringify_error = (id: RpcId, code: Int, message: String, data: Json) -> String {
  let code_str = stringify(JNum(Int::to_double(code)))
  let msg_str = stringify(JStr(message))
  let data_str = stringify(data)
  let id_str = rpc_id_json_str(id)
  let err_str = "{\"code\":\{code_str},\"message\":\{msg_str},\"data\":\{data_str}}"
  "{\"jsonrpc\":\"2.0\",\"error\":\{err_str},\"id\":\{id_str}}"
}

export let stringify_request = (method: String, params: Json, id: RpcId) -> String {
  let method_str = stringify(JStr(method))
  let params_str = stringify(params)
  let id_str = rpc_id_json_str(id)
  "{\"jsonrpc\":\"2.0\",\"method\":\{method_str},\"params\":\{params_str},\"id\":\{id_str}}"
}

export let stringify_response = (id: RpcId, result: Json) -> String {
  let result_str = stringify(result)
  let id_str = rpc_id_json_str(id)
  "{\"jsonrpc\":\"2.0\",\"result\":\{result_str},\"id\":\{id_str}}"
}

export let stringify_notification = (method: String, params: Json) -> String {
  let method_str = stringify(JStr(method))
  let params_str = stringify(params)
  "{\"jsonrpc\":\"2.0\",\"method\":\{method_str},\"params\":\{params_str}}"
}
