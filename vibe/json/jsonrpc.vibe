//# Imports

import ../prelude/result.vibe {
  Result, from_option
}

import ./json.vibe {
  Json, parse, stringify
}

//# Types

export enum RpcId {
  IdNum(Int);
  IdStr(String);
  IdNull
}

export enum RpcMessage {
  Request(String, Json, RpcId);
  Notification(String, Json);
  SuccessResponse(RpcId, Json);
  ErrorResponse(RpcId, Int, String, Json)
}

//# Functions

let require_key = (obj: Map[String, Json], key: String) -> Result[Json, String] {
  let opt: Option[Json] = if Map::has_key(obj, key) {
    Some(Map::get(obj, key))
  } else {
    None
  }
  from_option(opt, "missing key: \{key}")
}

let get_string = (obj: Map[String, Json], key: String) -> Result[String, String] {
  match require_key(obj, key) {
    Result::Ok(JStr(s)) => Result::Ok(s),
    Result::Ok(_) => Result::Err("expected string for key: \{key}"),
    Result::Err(msg) => Result::Err(msg)
  }
}

let get_object = (j: Json, message: String) -> Result[Map[String, Json], String] {
  match j {
    JObj(m) => Result::Ok(m),
    _ => Result::Err(message)
  }
}

let parse_rpc_id = (j: Json) -> Result[RpcId, String] {
  match j {
    JNum(n) => Result::Ok(IdNum(Double::to_int(n))),
    JStr(s) => Result::Ok(IdStr(s)),
    JNull => Result::Ok(IdNull),
    _ => Result::Err("invalid id")
  }
}

export let parse_message = (input: String) -> Result[RpcMessage, String] {
  match parse(input) {
    Result::Ok((json, _)) => match get_object(json, "expected object") {
      Result::Ok(obj) => match get_string(obj, "jsonrpc") {
        Result::Ok(jsonrpc) =>
          if jsonrpc != "2.0" {
            Result::Err("invalid jsonrpc version")
          } else {
            let has_method = Map::has_key(obj, "method")
            let has_result = Map::has_key(obj, "result")
            let has_error = Map::has_key(obj, "error")
            if has_method {
              match get_string(obj, "method") {
                Result::Ok(method) => {
                  let params = if Map::has_key(obj, "params") {
                    Map::get(obj, "params")
                  } else JNull
                  if Map::has_key(obj, "id") {
                    match parse_rpc_id(Map::get(obj, "id")) {
                      Result::Ok(id) => Result::Ok(Request(method, params, id)),
                      Result::Err(msg) => Result::Err(msg)
                    }
                  } else Result::Ok(Notification(method, params))
                },
                Result::Err(msg) => Result::Err(msg)
              }
            } else if has_result {
              match require_key(obj, "id") {
                Result::Ok(id_json) => match parse_rpc_id(id_json) {
                  Result::Ok(id) => Result::Ok(SuccessResponse(id, Map::get(obj, "result"))),
                  Result::Err(msg) => Result::Err(msg)
                },
                Result::Err(msg) => Result::Err(msg)
              }
            } else if has_error {
              match require_key(obj, "id") {
                Result::Ok(id_json) => match parse_rpc_id(id_json) {
                  Result::Ok(id) => match get_object(Map::get(obj, "error"), "error must be object") {
                    Result::Ok(err_obj) => match require_key(err_obj, "code") {
                      Result::Ok(JNum(n)) => match get_string(err_obj, "message") {
                        Result::Ok(message) => {
                          let data = if Map::has_key(err_obj, "data") {
                            Map::get(err_obj, "data")
                          } else JNull
                          Result::Ok(ErrorResponse(id, Double::to_int(n), message, data))
                        },
                        Result::Err(msg) => Result::Err(msg)
                      },
                      Result::Ok(_) => Result::Err("error code must be number"),
                      Result::Err(msg) => Result::Err(msg)
                    },
                    Result::Err(msg) => Result::Err(msg)
                  },
                  Result::Err(msg) => Result::Err(msg)
                },
                Result::Err(msg) => Result::Err(msg)
              }
            } else Result::Err("invalid message: missing method, result, or error")
          },
        Result::Err(msg) => Result::Err(msg)
      },
      Result::Err(msg) => Result::Err(msg)
    },
    Result::Err(msg) => Result::Err(msg)
  }
}

let rpc_id_json_str = (id: RpcId) -> String {
  match id {
    IdNum(n) => stringify(JNum(Int::to_double(n))),
    IdStr(s) => stringify(JStr(s)),
    IdNull => "null"
  }
}

export let stringify_error = (id: RpcId, code: Int, message: String, data: Json) -> String {
  let code_str = stringify(JNum(Int::to_double(code)))
  let msg_str = stringify(JStr(message))
  let data_str = stringify(data)
  let id_str = rpc_id_json_str(id)
  let err_str = "{\"code\":\{code_str},\"message\":\{msg_str},\"data\":\{data_str}}"
  "{\"jsonrpc\":\"2.0\",\"error\":\{err_str},\"id\":\{id_str}}"
}

export let stringify_request = (method: String, params: Json, id: RpcId) -> String {
  let method_str = stringify(JStr(method))
  let params_str = stringify(params)
  let id_str = rpc_id_json_str(id)
  "{\"jsonrpc\":\"2.0\",\"method\":\{method_str},\"params\":\{params_str},\"id\":\{id_str}}"
}

export let stringify_response = (id: RpcId, result: Json) -> String {
  let result_str = stringify(result)
  let id_str = rpc_id_json_str(id)
  "{\"jsonrpc\":\"2.0\",\"result\":\{result_str},\"id\":\{id_str}}"
}

export let stringify_notification = (method: String, params: Json) -> String {
  let method_str = stringify(JStr(method))
  let params_str = stringify(params)
  "{\"jsonrpc\":\"2.0\",\"method\":\{method_str},\"params\":\{params_str}}"
}
