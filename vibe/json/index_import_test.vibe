//# Imports

import .{
  Json, RpcId, parse, parse_message, stringify, stringify_request
}

//# Misc

test "json index exports core symbols" {
  let (j, _) = parse("\"ok\"")
  assert(stringify(j) == "\"ok\"")
  let msg = parse_message(stringify_request("ping", JNull, IdNum(1)))
  match msg {
    Request(method, _, _) => assert(method == "ping")
    _ => assert(false)
  }
}
