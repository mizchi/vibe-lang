//# Imports

import ./index.vibe {
  Json,
  parse,
  stringify,
  parse_message,
  stringify_request,
  RpcId
}

//# Misc

test "json index exports core symbols" {
  let (j, _) = parse("\"ok\"")
  assert(string_equals(stringify(j), "\"ok\""))
  let msg = parse_message(
    stringify_request("ping", JNull, IdNum(1))
  )
  match msg {
    Request(method, _, _) => assert(string_equals(method, "ping"))
    _ => assert(false)
  }
}
