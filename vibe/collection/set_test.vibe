
use ./set.vibe {
  StringSet,
  empty,
  from_array,
  contains,
  add,
  remove,
  size,
  is_empty,
  set_union,
  set_intersect,
  set_difference
}
test "set_basic" {
  let s0 = empty()
  match s0 {
    Empty => assert(true),
    _ => assert(false)
  }
  assert(is_empty(s0))
  assert(eq(size(s0), 0))
  let s1 = add(s0, "a")
  assert(contains(s1, "a"))
  assert(eq(size(s1), 1))
  let s2 = add(s1, "a")
  assert(eq(size(s2), 1))
  let s3 = remove(s2, "a")
  assert(not(contains(s3, "a")))
  assert(is_empty(s3))
}
test "set_ops" {
  let u = set_union(from_array([
    "a",
    "b",
    "b"
  ]), from_array([
    "b",
    "c"
  ]))
  assert(eq(size(u), 3))
  assert(contains(u, "a"))
  assert(contains(u, "b"))
  assert(contains(u, "c"))
  let i = set_intersect(from_array([
    "a",
    "b",
    "b"
  ]), from_array([
    "b",
    "c"
  ]))
  assert(eq(size(i), 1))
  assert(contains(i, "b"))
  let d = set_difference(from_array([
    "a",
    "b",
    "b"
  ]), from_array([
    "b",
    "c"
  ]))
  assert(eq(size(d), 1))
  assert(contains(d, "a"))
}
