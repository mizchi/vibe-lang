//# Imports

import .{
  List, StringSet, from_array, get_or, list_length, list_of3, size
}

//# Misc

test "collection index exports core symbols" {
  let xs: List[Int] = list_of3(1, 2, 3)
  assert(eq(list_length(xs), 3))
  let m: Map[String, Int] = map {
    "a": 1
  }
  assert(eq(get_or(m, "a", 0), 1))
  let s: StringSet = from_array([
    "a",
    "b",
    "a"
  ])
  assert(eq(size(s), 2))
}
