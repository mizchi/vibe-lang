
use ./r#map.vibe {
  has_key,
  get,
  get_or,
  get_or_else,
  keys,
  values,
  length,
  is_empty
}
test "map_accessors" {
  let m: Map[Int] = map {
    "a": 1,
    "b": 2
  }
  assert(has_key(m, "a"))
  assert(not(has_key(m, "x")))
  match get(m, "b") {
    Some(v) => assert(eq(v, 2)),
    _ => assert(false)
  }
  match get(m, "x") {
    None => assert(true),
    _ => assert(false)
  }
  assert(eq(get_or(m, "a", 99), 1))
  assert(eq(get_or(m, "x", 99), 99))
  assert(eq(get_or_else(m, "x", () -> Int {
    42
  }), 42))
  assert(eq(length(m), 2))
  assert(not(is_empty(m)))
  assert(is_empty(map {
  }))
  let ks = keys(m)
  let vs = values(m)
  assert(eq(array_length(ks), 2))
  assert(eq(array_length(vs), 2))
}
