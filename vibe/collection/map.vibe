export let get = [V](m: Map[V], key: String) -> Option[V] {
  if map_has_key(m, key) {
    Some(map_get(m, key))
  } else {
    None
  }
}
export let keys = [V](m: Map[V]) -> Array[String] {
  map_keys(m)
}
export let get_or = [V](m: Map[V], key: String, default: V) -> V {
  match get(m, key) {
    Some(value) => value,
    _ => default
  }
}
export let length = [V](m: Map[V]) -> Int {
  array_length(map_keys(m))
}
export let values = [V](m: Map[V]) -> Array[V] {
  map_values(m)
}
export let has_key = [V](m: Map[V], key: String) -> Bool {
  map_has_key(m, key)
}
export let is_empty = [V](m: Map[V]) -> Bool {
  length(m) == 0
}
export let get_or_else = [V](m: Map[V], key: String, default: () -> V) -> V {
  match get(m, key) {
    Some(value) => value,
    _ => default()
  }
}
