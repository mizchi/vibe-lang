//# Types

export enum List[T] {
  Nil;
  Cons(T, List[T])
}

impl [T] Iterable for List[T]

//# Functions

// list_nth: (, Int) ->
export let rec list_nth = [T](xs: List[T], n: Int) -> Option[T] {
  match xs {
    Nil => None,
    Cons(h, t) => if n == 0 {
      Some(h)
    } else list_nth(t, n - 1)
  }
}

// nth: (, Int) ->
export let nth = [T](xs: List[T], n: Int) -> Option[T] {
  list_nth(xs, n)
}

// list_of3: (, , ) ->
export let list_of3 = [T](a: T, b: T, c: T) -> List[T] {
  Cons(a, Cons(b, Cons(c, Nil)))
}

// of3: (, , ) ->
export let of3 = [T](a: T, b: T, c: T) -> List[T] {
  list_of3(a, b, c)
}

// list_of5: (, , , , ) ->
export let list_of5 = [T](a: T, b: T, c: T, d: T, e: T) -> List[T] {
  Cons(a, Cons(b, Cons(c, Cons(d, Cons(e, Nil)))))
}

// of5: (, , , , ) ->
export let of5 = [T](a: T, b: T, c: T, d: T, e: T) -> List[T] {
  list_of5(a, b, c, d, e)
}

// list_cons: (, ) ->
export let list_cons = [T](x: T, xs: List[T]) -> List[T] {
  Cons(x, xs)
}

// list_drop: (Int, ) ->
export let rec list_drop = [T](n: Int, xs: List[T]) -> List[T] {
  if n <= 0 {
    xs
  }
  else match xs {
    Nil => Nil,
    Cons(_, t) => list_drop(n - 1, t)
  }
}

// drop: (, Int) ->
export let drop = [T](xs: List[T], n: Int) -> List[T] {
  list_drop(n, xs)
}

// list_fold: ((, ) -> , , ) ->
export let list_fold = [A, B](f: (acc: B, x: A) -> B, init: B, xs: List[A]) -> B {
  let rec go = (acc: B, rest: List[A]) -> B {
    match rest {
      Nil => acc,
      Cons(h, t) => go(f(acc, h), t)
    }
  }
  go(init, xs)
}

// list_sum: () -> Int
export let list_sum = (xs: List[Int]) -> Int {
  list_fold((acc: Int, x: Int) -> Int {
    acc + x
  }, 0, xs)
}

// sum: () -> Int
export let sum = (xs: List[Int]) -> Int {
  list_sum(xs)
}

// list_head: () ->
export let list_head = [T](xs: List[T]) -> Option[T] {
  match xs {
    Cons(h, _) => Some(h),
    _ => None
  }
}

// head: () ->
export let head = [T](xs: List[T]) -> Option[T] {
  list_head(xs)
}

// list_iter: (() -> , ) -> Int
export let list_iter = [T, R](f: (x: T) -> R, xs: List[T]) -> Int {
  let rec go = (count: Int, rest: List[T]) -> Int {
    match rest {
      Nil => count,
      Cons(h, t) => {
        f(h)
        go(count + 1, t)
      }
    }
  }
  go(0, xs)
}

// iter: (, () -> ) -> Int
export let iter = [T, R](xs: List[T], f: (x: T) -> R) -> Int {
  list_iter(f, xs)
}

// list_tail: () ->
export let list_tail = [T](xs: List[T]) -> List[T] {
  match xs {
    Cons(_, t) => t,
    _ => Nil
  }
}

// tail: () ->
export let tail = [T](xs: List[T]) -> List[T] {
  list_tail(xs)
}

// list_empty: () ->
export let list_empty = [T]() -> List[T] {
  Nil
}

// empty: () ->
export let empty = [T]() -> List[T] {
  list_empty()
}

// list_length: () -> Int
export let rec list_length = [T](xs: List[T]) -> Int {
  match xs {
    Nil => 0,
    Cons(_, t) => 1 + list_length(t)
  }
}

// length: () -> Int
export let length = [T](xs: List[T]) -> Int {
  list_length(xs)
}

// iter_length: () -> Int
export let iter_length = [T](xs: List[T]) -> Int {
  list_length(xs)
}

// list_reverse: () ->
export let list_reverse = [T](xs: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t)
    }
  }
  go(Nil, xs)
}

// reverse: () ->
export let reverse = [T](xs: List[T]) -> List[T] {
  list_reverse(xs)
}

// list_map: (() -> , ) ->
export let list_map = [A, B](f: (x: A) -> B, xs: List[A]) -> List[B] {
  let rec go = (acc: List[B], rest: List[A]) -> List[B] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(f(h), acc), t)
    }
  }
  list_reverse(go(Nil, xs))
}

// list_zip: (, ) ->
export let list_zip = [A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {
  let rec go = (acc: List[(A, B)], left: List[A], right: List[B]) -> List[(A, B)] {
    match (left, right) {
      (Cons(x, xt), Cons(y, yt)) => go(Cons((x, y), acc), xt, yt),
      _ => list_reverse(acc)
    }
  }
  go(Nil, xs, ys)
}

// zip: (, ) ->
export let zip = [A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {
  list_zip(xs, ys)
}

// list_take: (Int, ) ->
export let list_take = [T](n: Int, xs: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T], count: Int) -> List[T] {
    if count <= 0 {
      acc
    }
    else match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t, count - 1)
    }
  }
  list_reverse(go(Nil, xs, n))
}

// take: (, Int) ->
export let take = [T](xs: List[T], n: Int) -> List[T] {
  list_take(n, xs)
}

// list_append: (, ) ->
export let list_append = [T](xs: List[T], ys: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) => go(Cons(h, acc), t)
    }
  }
  go(ys, list_reverse(xs))
}

// append: (, ) ->
export let append = [T](xs: List[T], ys: List[T]) -> List[T] {
  list_append(xs, ys)
}

// list_filter: (() -> Bool, ) ->
export let list_filter = [T](pred: (x: T) -> Bool, xs: List[T]) -> List[T] {
  let rec go = (acc: List[T], rest: List[T]) -> List[T] {
    match rest {
      Nil => acc,
      Cons(h, t) =>
      if pred(h) {
        go(Cons(h, acc), t)
      }
      else go(acc, t)
    }
  }
  list_reverse(go(Nil, xs))
}

// filter: (, () -> Bool) ->
export let filter = [T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {
  list_filter(pred, xs)
}

// list_flatmap: (() -> , ) ->
export let list_flatmap = [A, B](f: (x: A) -> List[B], xs: List[A]) -> List[B] {
  let rec go = (rest: List[A]) -> List[B] {
    match rest {
      Nil => Nil,
      Cons(h, t) => list_append(f(h), go(t))
    }
  }
  go(xs)
}

// flatmap: (, () -> ) ->
export let flatmap = [A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {
  list_flatmap(f, xs)
}

// list_is_empty: () -> Bool
export let list_is_empty = [T](xs: List[T]) -> Bool {
  xs is Nil
}

// is_empty: () -> Bool
export let is_empty = [T](xs: List[T]) -> Bool {
  list_is_empty(xs)
}

// list_iter_get: (, Int) ->
export let rec list_iter_get = [T](xs: List[T], index: Int) -> T {
  match xs {
    Cons(h, t) =>
    if index == 0 {
      h
    } else list_iter_get(t, index - 1)
    Nil => list_iter_get(xs, index)
  }
}

// iter_get: (, Int) ->
export let iter_get = [T](xs: List[T], index: Int) -> T {
  list_iter_get(xs, index)
}

// list_singleton: () ->
export let list_singleton = [T](x: T) -> List[T] {
  Cons(x, Nil)
}

// singleton: () ->
export let singleton = [T](x: T) -> List[T] {
  list_singleton(x)
}

// list_contains_by: ((, ) -> Bool, , ) -> Bool
export let rec list_contains_by = [T](eq: (a: T, b: T) -> Bool, value: T, xs: List[T]) -> Bool {
  match xs {
    Nil => false,
    Cons(h, t) => if eq(h, value) {
      true
    } else list_contains_by(eq, value, t)
  }
}

// contains_by: (, (, ) -> Bool, ) -> Bool
export let contains_by = [T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {
  list_contains_by(eq, value, xs)
}

export let List::nth = [T](xs: List[T], n: Int) -> Option[T] {
  list_nth(xs, n)
}

export let List::sum = (xs: List[Int]) -> Int {
  list_sum(xs)
}

export let List::zip = [A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {
  list_zip(xs, ys)
}

export let List::drop = [T](xs: List[T], n: Int) -> List[T] {
  list_drop(n, xs)
}

export let List::head = [T](xs: List[T]) -> Option[T] {
  list_head(xs)
}

export let List::iter = [T, R](xs: List[T], f: (x: T) -> R) -> Int {
  list_iter(f, xs)
}

export let List::tail = [T](xs: List[T]) -> List[T] {
  list_tail(xs)
}

export let List::take = [T](xs: List[T], n: Int) -> List[T] {
  list_take(n, xs)
}

export let List::append = [T](xs: List[T], ys: List[T]) -> List[T] {
  list_append(xs, ys)
}

export let List::filter = [T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {
  list_filter(pred, xs)
}

export let List::length = [T](xs: List[T]) -> Int {
  list_length(xs)
}

export let List::flatmap = [A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {
  list_flatmap(f, xs)
}

export let List::reverse = [T](xs: List[T]) -> List[T] {
  list_reverse(xs)
}

export let List::is_empty = [T](xs: List[T]) -> Bool {
  list_is_empty(xs)
}

export let List::iter_get = [T](xs: List[T], index: Int) -> T {
  iter_get(xs, index)
}

export let List::contains_by = [T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {
  list_contains_by(eq, value, xs)
}

export let List::iter_length = [T](xs: List[T]) -> Int {
  iter_length(xs)
}
