//# Types

export enum StringSet {
  Empty;
  Node(String, StringSet)
}

//# Functions

// size: () -> Int
export let rec size = (s: StringSet) -> Int {
  match s {
    Empty => 0,
    Node(_, tail) => 1 + size(tail)
  }
}

// empty: () ->
export let empty = () -> StringSet {
  Empty
}

// remove: (, String) ->
export let rec remove = (s: StringSet, value: String) -> StringSet {
  match s {
    Empty => Empty,
    Node(head, tail) => if head == value {
      tail
    } else {
      Node(head, remove(tail, value))
    }
  }
}

// contains: (, String) -> Bool
export let rec contains = (s: StringSet, value: String) -> Bool {
  match s {
    Empty => false,
    Node(head, tail) => if head == value {
      true
    } else {
      contains(tail, value)
    }
  }
}

// add: (, String) ->
export let add = (s: StringSet, value: String) -> StringSet {
  if contains(s, value) {
    s
  } else {
    Node(value, s)
  }
}

// is_empty: () -> Bool
export let is_empty = (s: StringSet) -> Bool {
  match s {
    Empty => true,
    _ => false
  }
}

// set_union: (, ) ->
export let set_union = (a: StringSet, b: StringSet) -> StringSet {
  let rec r#loop = (rest: StringSet, acc: StringSet) -> StringSet {
    match rest {
      Empty => acc,
      Node(head, tail) => r#loop(tail, add(acc, head))
    }
  }
  r#loop(b, a)
}

// from_array: (Array[String]) ->
export let from_array = (values: Array[String]) -> StringSet {
  let len = array_length(values)
  let rec r#loop = (i: Int, acc: StringSet) -> StringSet {
    if i >= len {
      acc
    } else {
      r#loop(i + 1, add(acc, array_get(values, i)))
    }
  }
  r#loop(0, Empty)
}

// set_intersect: (, ) ->
export let set_intersect = (a: StringSet, b: StringSet) -> StringSet {
  let rec r#loop = (rest: StringSet, acc: StringSet) -> StringSet {
    match rest {
      Empty => acc,
      Node(head, tail) => if contains(b, head) {
        r#loop(tail, add(acc, head))
      } else {
        r#loop(tail, acc)
      }
    }
  }
  r#loop(a, Empty)
}

// set_difference: (, ) ->
export let set_difference = (a: StringSet, b: StringSet) -> StringSet {
  let rec r#loop = (rest: StringSet, acc: StringSet) -> StringSet {
    match rest {
      Empty => acc,
      Node(head, tail) => if contains(b, head) {
        r#loop(tail, acc)
      } else {
        r#loop(tail, add(acc, head))
      }
    }
  }
  r#loop(a, Empty)
}

// set_value_to_string: () -> String
export let set_value_to_string = [T](value: T) -> String {
  __to_string(value)
}

// add_by: (, ) ->
export let add_by = [T](s: StringSet, value: T) -> StringSet {
  add(s, set_value_to_string(value))
}

// remove_by: (, ) ->
export let remove_by = [T](s: StringSet, value: T) -> StringSet {
  remove(s, set_value_to_string(value))
}

// contains_by: (, ) -> Bool
export let contains_by = [T](s: StringSet, value: T) -> Bool {
  contains(s, set_value_to_string(value))
}

// from_array_by: (Array[]) ->
export let from_array_by = [T](values: Array[T]) -> StringSet {
  let len = array_length(values)
  let rec r#loop = (i: Int, acc: StringSet) -> StringSet {
    if i >= len {
      acc
    } else {
      r#loop(i + 1, add_by(acc, array_get(values, i)))
    }
  }
  r#loop(0, Empty)
}

//# Misc

export {
  add, size, empty, add_by, remove, contains, is_empty, StringSet, remove_by, set_union, from_array, contains_by, from_array_by, set_intersect, set_difference, set_value_to_string
}
