
use ./list.vibe {
  List, list_of3
}
use ./r#map.vibe {
  get_or
}
use ./set.vibe {
  StringSet, from_array, size
}
let m: Map[Int] = map {
  "a": 1
}
let s: StringSet = from_array([
  "a",
  "b",
  "a"
])
let xs: List[Int] = list_of3(1, 2, 3)
xs.length() == 3 && get_or(m, "a", 0) == 1 && size(s) == 2
