//# Imports

import ./index.vibe {
  seed, next, next_between
}

//# Misc

test "random index exports deterministic generator" {
  let s0 = seed(42)
  let (a1, s1) = next(s0)
  let (a2, _) = next(s1)
  let t0 = seed(42)
  let (b1, t1) = next(t0)
  let (b2, _) = next(t1)
  assert(eq(a1, b1))
  assert(eq(a2, b2))
  let (r, _) = next_between(seed(7), 10, 20)
  assert(r >= 10)
  assert(r < 20)
}
