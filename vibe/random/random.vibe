//# Functions

let mask31: Int = 2147483647

let normalize_seed = (seed_value: Int) -> Int {
  let s = seed_value&mask31
  if s == 0 {
    1
  } else {
    s
  }
}

// seed: (Int) -> Int
export let seed = (seed_value: Int) -> Int {
  normalize_seed(seed_value)
}

let xorshift31 = (state: Int) -> Int {
  let mut x = normalize_seed(state)
  x = x^(x<<13)
  x = x^(x>>17)
  x = x^(x<<5)
  x&mask31
}

// next: (Int) -> (Int, Int)
export let next = (state: Int) -> (Int, Int) {
  let next_state = xorshift31(state)
  (next_state, next_state)
}

// next_between: (Int, Int, Int) -> (Int, Int)
export let next_between = (state: Int, min_inclusive: Int, max_exclusive: Int) -> (Int, Int) {
  let (value, next_state) = next(state)
  let span = max_exclusive - min_inclusive
  if span <= 0 {
    (min_inclusive, next_state)
  } else {
    (min_inclusive + (value % span), next_state)
  }
}
