//# Functions

export let _csv_is_number = (s: String) -> Bool {
  let len = String::length(s)
  if len == 0 {
    false
  } else {
    let mut i = 0
    let first = String::substring(s, 0, 1)
    if first == "-" {
      if len == 1 {
        false
      } else {
        i = 1
        let mut valid = true
        let mut has_dot = false
        while i < len {
          let ch = s[i]
          if ch == "." {
            if has_dot {
              valid = false
            }
            has_dot = true
          } else if not(ch == "0") {
            if not(ch == "1") {
              if not(ch == "2") {
                if not(ch == "3") {
                  if not(ch == "4") {
                    if not(ch == "5") {
                      if not(ch == "6") {
                        if not(ch == "7") {
                          if not(ch == "8") {
                            if not(ch == "9") {
                              valid = false
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          i = i + 1
        }
        valid
      }
    } else {
      let mut valid = true
      let mut has_dot = false
      while i < len {
        let ch = s[i]
        if ch == "." {
          if has_dot {
            valid = false
          }
          has_dot = true
        } else if not(ch == "0") {
          if not(ch == "1") {
            if not(ch == "2") {
              if not(ch == "3") {
                if not(ch == "4") {
                  if not(ch == "5") {
                    if not(ch == "6") {
                      if not(ch == "7") {
                        if not(ch == "8") {
                          if not(ch == "9") {
                            valid = false
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        i = i + 1
      }
      valid
    }
  }
}

export let _csv_parse_line = (line: String) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = String::length(line)
    let mut field_sb = StringBuilder::new()
    let mut i = 0
    let mut in_quotes = false
    while i < len {
      let ch = line[i]
      let mut extra = 0
      let prev_in_quotes = in_quotes
      if in_quotes {
        if ch == "\"" {
          let mut is_escape = false
          if i + 1 < len {
            let next = String::substring(line, i + 1, i + 2)
            if next == "\"" {
              is_escape = true
            }
          }
          if is_escape {
            StringBuilder::push(field_sb, "\"")
            extra = 1
          }
          if not(is_escape) {
            in_quotes = false
          }
        }
        if not(ch == "\"") {
          StringBuilder::push(field_sb, ch)
        }
      }
      if not(prev_in_quotes) {
        if ch == "\"" {
          in_quotes = true
        }
        if ch == "," {
          ArrayBuilder::push(result, StringBuilder::freeze(field_sb))
          field_sb = StringBuilder::new()
        }
        if not(ch == "\"") {
          if not(ch == ",") {
            StringBuilder::push(field_sb, ch)
          }
        }
      }
      i = i + 1 + extra
    }
    ArrayBuilder::push(result, StringBuilder::freeze(field_sb))
    ArrayBuilder::freeze(result)
  }
}

export let _csv_escape_json = (s: String) -> String {
  {
    let sb = StringBuilder::new()
    let len = String::length(s)
    let mut i = 0
    while i < len {
      let ch = s[i]
      if ch == "\\" {
        StringBuilder::push(sb, "\\\\")
      } else if ch == "\"" {
        StringBuilder::push(sb, "\\\"")
      } else if ch == "\n" {
        StringBuilder::push(sb, "\\n")
      } else if ch == "\t" {
        StringBuilder::push(sb, "\\t")
      } else StringBuilder::push(sb, ch)
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

export let from_csv = (text: String) -> Json {
  let cr = String::from_char_code(13)
  let cleaned = String::replace_all(text, cr, "")
  let all_lines = String::split(cleaned, "\n")
  let num_lines = Array::length(all_lines)
  if num_lines < 2 {
    Json::parse("[]")
  } else {
    let headers = _csv_parse_line(Array::get(all_lines, 0))
    let num_headers = Array::length(headers)
    {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "[")
      let mut row_idx = 1
      let mut first_row = true
      while row_idx < num_lines {
        let line = Array::get(all_lines, row_idx)
        if not(String::trim(line) == "") {
          let fields = _csv_parse_line(line)
          if not(first_row) {
            StringBuilder::push(sb, ",")
          }
          first_row = false
          StringBuilder::push(sb, "{")
          let mut col = 0
          while col < num_headers {
            if col > 0 {
              StringBuilder::push(sb, ",")
            }
            StringBuilder::push(sb, "\"")
            StringBuilder::push(sb, _csv_escape_json(Array::get(headers, col)))
            StringBuilder::push(sb, "\":")
            let val = if col < Array::length(fields) {
              Array::get(fields, col)
            } else ""
            if _csv_is_number(val) {
              StringBuilder::push(sb, val)
            } else {
              StringBuilder::push(sb, "\"")
              StringBuilder::push(sb, _csv_escape_json(val))
              StringBuilder::push(sb, "\"")
            }
            col = col + 1
          }
          StringBuilder::push(sb, "}")
        }
        row_idx = row_idx + 1
      }
      StringBuilder::push(sb, "]")
      Json::parse(StringBuilder::freeze(sb))
    }
  }
}
