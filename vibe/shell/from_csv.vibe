//# Functions

export let _csv_is_number = (s: String) -> Bool {
  let len = string_length(s)
  if len == 0 {
    false
  } else {
    let mut i = 0
    let first = string_substring(s, 0, 1)
    if string_equals(first, "-") {
      if len == 1 {
        false
      } else {
        i = 1
        let mut valid = true
        let mut has_dot = false
        while i < len {
          let ch = string_substring(s, i, i + 1)
          if string_equals(ch, ".") {
            if has_dot {
              valid = false
            }
            has_dot = true
          } else if not(string_equals(ch, "0")) {
            if not(string_equals(ch, "1")) {
              if not(string_equals(ch, "2")) {
                if not(string_equals(ch, "3")) {
                  if not(string_equals(ch, "4")) {
                    if not(string_equals(ch, "5")) {
                      if not(string_equals(ch, "6")) {
                        if not(string_equals(ch, "7")) {
                          if not(string_equals(ch, "8")) {
                            if not(string_equals(ch, "9")) {
                              valid = false
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          i = i + 1
        }
        valid
      }
    } else {
      let mut valid = true
      let mut has_dot = false
      while i < len {
        let ch = string_substring(s, i, i + 1)
        if string_equals(ch, ".") {
          if has_dot {
            valid = false
          }
          has_dot = true
        } else if not(string_equals(ch, "0")) {
          if not(string_equals(ch, "1")) {
            if not(string_equals(ch, "2")) {
              if not(string_equals(ch, "3")) {
                if not(string_equals(ch, "4")) {
                  if not(string_equals(ch, "5")) {
                    if not(string_equals(ch, "6")) {
                      if not(string_equals(ch, "7")) {
                        if not(string_equals(ch, "8")) {
                          if not(string_equals(ch, "9")) {
                            valid = false
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        i = i + 1
      }
      valid
    }
  }
}

export let _csv_parse_line = (line: String) -> Array[String] {
  do {
    let result = array_builder()
    let len = string_length(line)
    let mut field_sb = string_builder()
    let mut i = 0
    let mut in_quotes = false
    while i < len {
      let ch = string_substring(line, i, i + 1)
      let mut extra = 0
      let prev_in_quotes = in_quotes
      if in_quotes {
        if string_equals(ch, "\"") {
          let mut is_escape = false
          if i + 1 < len {
            let next = string_substring(line, i + 1, i + 2)
            if string_equals(next, "\"") {
              is_escape = true
            }
          }
          if is_escape {
            string_builder_push(field_sb, "\"")
            extra = 1
          }
          if not(is_escape) {
            in_quotes = false
          }
        }
        if not(string_equals(ch, "\"")) {
          string_builder_push(field_sb, ch)
        }
      }
      if not(prev_in_quotes) {
        if string_equals(ch, "\"") {
          in_quotes = true
        }
        if string_equals(ch, ",") {
          array_builder_push(result, string_builder_freeze(field_sb))
          field_sb = string_builder()
        }
        if not(string_equals(ch, "\"")) {
          if not(string_equals(ch, ",")) {
            string_builder_push(field_sb, ch)
          }
        }
      }
      i = i + 1 + extra
    }
    array_builder_push(result, string_builder_freeze(field_sb))
    array_builder_freeze(result)
  }
}

export let _csv_escape_json = (s: String) -> String {
  do {
    let sb = string_builder()
    let len = string_length(s)
    let mut i = 0
    while i < len {
      let ch = string_substring(s, i, i + 1)
      if string_equals(ch, "\\") {
        string_builder_push(sb, "\\\\")
      } else if string_equals(ch, "\"") {
        string_builder_push(sb, "\\\"")
      } else if string_equals(ch, "\n") {
        string_builder_push(sb, "\\n")
      } else if string_equals(ch, "\t") {
        string_builder_push(sb, "\\t")
      } else {
        string_builder_push(sb, ch)
      }
      i = i + 1
    }
    string_builder_freeze(sb)
  }
}

export let from_csv = (text: String) -> Json {
  let cr = string_from_char_code(13)
  let cleaned = string_replace_all(text, cr, "")
  let all_lines = string_split(cleaned, "\n")
  let num_lines = array_length(all_lines)
  if num_lines < 2 {
    from_json("[]")
  } else {
    let headers = _csv_parse_line(array_get(all_lines, 0))
    let num_headers = array_length(headers)
    do {
      let sb = string_builder()
      string_builder_push(sb, "[")
      let mut row_idx = 1
      let mut first_row = true
      while row_idx < num_lines {
        let line = array_get(all_lines, row_idx)
        if not(string_equals(string_trim(line), "")) {
          let fields = _csv_parse_line(line)
          if not(first_row) {
            string_builder_push(sb, ",")
          }
          first_row = false
          string_builder_push(sb, "{")
          let mut col = 0
          while col < num_headers {
            if col > 0 {
              string_builder_push(sb, ",")
            }
            string_builder_push(sb, "\"")
            string_builder_push(sb, _csv_escape_json(array_get(headers, col)))
            string_builder_push(sb, "\":")
            let val = if col < array_length(fields) {
              array_get(fields, col)
            } else {
              ""
            }
            if _csv_is_number(val) {
              string_builder_push(sb, val)
            } else {
              string_builder_push(sb, "\"")
              string_builder_push(sb, _csv_escape_json(val))
              string_builder_push(sb, "\"")
            }
            col = col + 1
          }
          string_builder_push(sb, "}")
        }
        row_idx = row_idx + 1
      }
      string_builder_push(sb, "]")
      from_json(string_builder_freeze(sb))
    }
  }
}
