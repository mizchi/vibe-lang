//# Imports

import .{
  shell_exists, shell_is_dir, shell_is_file, shell_print, shell_println, shell_read_line, shell_write_file
}

//# Misc

test "shell index exports canonical aliases" {
  let _ = shell_read_line
  let _ = shell_exists
  let _ = shell_is_dir
  let _ = shell_is_file
  let _ = shell_write_file
  shell_print("")
  shell_println("")
  assert(true)
}
