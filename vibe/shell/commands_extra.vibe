//# Functions

// df: () -> Array[String] with {Stdout}
export let df = () -> Array[String] with { Stdout } {
  sh_lines("df -h")
}

// du: (String) -> Array[String] with {Stdout}
export let du = (path: String) -> Array[String] with { Stdout } {
  sh_lines("du -sh \{path}")
}

// tree: (String) -> String with {Stdout}
export let tree = (dir: String) -> String with { Stdout } {
  let lines = sh_lines("find \{dir}")
  let sb = StringBuilder::new()
  StringBuilder::push(sb, dir)
  StringBuilder::push(sb, "\n")
  let dir_prefix = "\{dir}/"
  let dir_prefix_len = String::length(dir_prefix)
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if not(line == dir) {
      let rel = if String::starts_with(line, dir_prefix) {
        String::substring(line, dir_prefix_len, String::length(line))
      } else line
      let depth = {
        let mut d = 0
        let mut j = 0
        while j < String::length(rel) {
          if String::substring(rel, j, j + 1) == "/" {
            d = d + 1
          }
          j = j + 1
        }
        d
      }
      let mut k = 0
      while k < depth {
        StringBuilder::push(sb, "  ")
        k = k + 1
      }
      let name_start = String::last_index_of(rel, "/")
      let name = if name_start >= 0 {
        String::substring(rel, name_start + 1, String::length(rel))
      } else rel
      StringBuilder::push(sb, name)
      StringBuilder::push(sb, "\n")
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

// which: (String) -> String with {Stdout}
export let which = (name: String) -> String with { Stdout } {
  let result = sh_lines("which \{name}")
  if Array::length(result) > 0 {
    Array::get(result, 0)
  } else ""
}

// diff_files: (String, String) -> Array[String] with {Stdout}
export let diff_files = (a: String, b: String) -> Array[String] with { Stdout } {
  sh_lines("diff \{a} \{b}")
}
