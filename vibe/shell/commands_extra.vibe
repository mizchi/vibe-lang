//# Functions

// df: () -> Array[String] with {Stdout}
export let df = () -> Array[String] with { Stdout } {
  do {
    sh_lines("df -h")
  }
}

// du: (String) -> Array[String] with {Stdout}
export let du = (path: String) -> Array[String] with { Stdout } {
  do {
    sh_lines(string_concat("du -sh ", path))
  }
}

// tree: (String) -> String with {Stdout}
export let tree = (dir: String) -> String with { Stdout } {
  let lines = do {
    sh_lines(string_concat("find ", dir))
  }
  let sb = string_builder()
  string_builder_push(sb, dir)
  string_builder_push(sb, "\n")
  let dir_prefix = string_concat(dir, "/")
  let dir_prefix_len = string_length(dir_prefix)
  let mut i = 0
  while i < array_length(lines) {
    let line = array_get(lines, i)
    if not(string_equals(line, dir)) {
      let rel = if string_starts_with(line, dir_prefix) {
        string_substring(line, dir_prefix_len, string_length(line))
      } else {
        line
      }
      let depth = do {
        let mut d = 0
        let mut j = 0
        while j < string_length(rel) {
          if string_equals(string_substring(rel, j, j + 1), "/") {
            d = d + 1
          }
          j = j + 1
        }
        d
      }
      let mut k = 0
      while k < depth {
        string_builder_push(sb, "  ")
        k = k + 1
      }
      let name_start = string_last_index_of(rel, "/")
      let name = if name_start >= 0 {
        string_substring(rel, name_start + 1, string_length(rel))
      } else {
        rel
      }
      string_builder_push(sb, name)
      string_builder_push(sb, "\n")
    }
    i = i + 1
  }
  string_builder_freeze(sb)
}

// which: (String) -> String with {Stdout}
export let which = (name: String) -> String with { Stdout } {
  let result = do {
    sh_lines(string_concat("which ", name))
  }
  if array_length(result) > 0 {
    array_get(result, 0)
  } else {
    ""
  }
}

// diff_files: (String, String) -> Array[String] with {Stdout}
export let diff_files = (a: String, b: String) -> Array[String] with { Stdout } {
  do {
    sh_lines(string_concat(string_concat(string_concat("diff ", a), " "), b))
  }
}
