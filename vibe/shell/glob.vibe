//# Functions

// glob: (String) -> Array[String] with {Stdout}
export let glob = (pattern: String) -> Array[String] with { Stdout } {
  let slash_idx = String::last_index_of(pattern, "/")
  let dir = if slash_idx >= 0 {
    String::substring(pattern, 0, slash_idx)
  } else "."
  let file_pattern = if slash_idx >= 0 {
    String::substring(pattern, slash_idx + 1, String::length(pattern))
  } else pattern
  let has_double_star = String::contains(pattern, "**")
  let cmd = if has_double_star {
    String::concat(String::concat("find ", dir), String::concat(" -name '", String::concat(file_pattern, "'")))
  } else String::concat(String::concat("find ", dir), String::concat(" -maxdepth 1 -name '", String::concat(file_pattern, "'")))
  let lines = sh_lines(cmd)
  let result = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if not(String::equals(line, dir)) {
      ArrayBuilder::push(result, line)
    }
    i = i + 1
  }
  ArrayBuilder::freeze(result)
}
