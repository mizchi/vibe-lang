//# Functions

// glob: (String) -> Array[String] with {Stdout}
export let glob = (pattern: String) -> Array[String] with { Stdout } {
  let slash_idx = string_last_index_of(pattern, "/")
  let dir = if slash_idx >= 0 {
    string_substring(pattern, 0, slash_idx)
  } else "."
  let file_pattern = if slash_idx >= 0 {
    string_substring(pattern, slash_idx + 1, string_length(pattern))
  } else pattern
  let has_double_star = string_contains(pattern, "**")
  let cmd = if has_double_star {
    string_concat(string_concat("find ", dir), string_concat(" -name '", string_concat(file_pattern, "'")))
  } else string_concat(string_concat("find ", dir), string_concat(" -maxdepth 1 -name '", string_concat(file_pattern, "'")))
  let lines = sh_lines(cmd)
  let result = array_builder()
  let mut i = 0
  while i < array_length(lines) {
    let line = array_get(lines, i)
    if not(string_equals(line, dir)) {
      array_builder_push(result, line)
    }
    i = i + 1
  }
  array_builder_freeze(result)
}
