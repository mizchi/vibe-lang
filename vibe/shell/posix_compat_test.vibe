//# Imports

import ./commands.vibe {
  ls, ls_all, pwd, cd, cat, echo, mkdir, mkdir_p, touch,
  rm, cp, mv, write_file, append, exists, is_dir, is_file, env, env_or,
  tee, find, realpath
}

import ./pipeline.vibe {
  names, lines, grep, head_str, tail_str, sort_str, uniq,
  cut, tr, wc, wc_l, nl, paste, tac, expand,
  seq, seq_step, join_str, count_str, filter_str,
  basename, dirname, len, upper, lower, replace, index_of,
  split
}

import ./types.vibe {
  type FileEntry
}

//# Misc

test "posix: cat file" {
  let path = "/tmp/vibe_posix_cat.txt"
  write_file(path, "hello posix")
  let content = cat(path)
  assert(string_equals(content, "hello posix"))
}

test "posix: echo text > file (write_file + cat roundtrip)" {
  let path = "/tmp/vibe_posix_redirect.txt"
  write_file(path, "redirected output")
  let content = cat(path)
  assert(string_equals(content, "redirected output"))
}

test "posix: echo text >> file (append)" {
  let path = "/tmp/vibe_posix_append.txt"
  write_file(path, "line1")
  append(path, "\nline2")
  let content = cat(path)
  assert(string_equals(content, "line1\nline2"))
}

test "posix: cp src dst" {
  let src = "/tmp/vibe_posix_cp_src.txt"
  let dst = "/tmp/vibe_posix_cp_dst.txt"
  write_file(src, "copy content")
  cp(src, dst)
  let src_content = cat(src)
  let dst_content = cat(dst)
  assert(string_equals(src_content, "copy content"))
  assert(string_equals(dst_content, "copy content"))
}

test "posix: mv src dst (src removed)" {
  let src = "/tmp/vibe_posix_mv_src.txt"
  let dst = "/tmp/vibe_posix_mv_dst.txt"
  write_file(src, "move content")
  mv(src, dst)
  let src_exists = exists(src)
  assert(not(src_exists))
  let dst_content = cat(dst)
  assert(string_equals(dst_content, "move content"))
}

test "posix: rm file + exists check" {
  let path = "/tmp/vibe_posix_rm.txt"
  write_file(path, "delete me")
  let before = exists(path)
  assert(before)
  rm(path)
  let after = exists(path)
  assert(not(after))
}

test "posix: mkdir -p a/b/c" {
  let dir = "/tmp/vibe_posix_mkdir_p/a/b/c"
  mkdir_p(dir)
  let d = is_dir(dir)
  assert(d)
}

test "posix: touch file (existing file unchanged)" {
  let path = "/tmp/vibe_posix_touch.txt"
  write_file(path, "original")
  touch(path)
  let content = cat(path)
  assert(string_equals(content, "original"))
}

test "posix: touch new file (creates empty)" {
  let path = "/tmp/vibe_posix_touch_new.txt"
  if (exists(path)) {
    rm(path)
  }
  touch(path)
  let content = cat(path)
  assert(string_equals(content, ""))
}

test "posix: ls excludes hidden files" {
  let dir = "/tmp/vibe_posix_ls"
  mkdir_p(dir)
  write_file(string_concat(dir, "/visible.txt"), "v")
  write_file(string_concat(dir, "/.hidden"), "h")
  let entries = ls(dir)
  let entry_names = names(entries)
  let has_hidden = filter_str(entry_names, (s: String) -> Bool {
    string_starts_with(s, ".")
  })
  assert(array_length(has_hidden) == 0)
}

test "posix: ls -a includes hidden files" {
  let dir = "/tmp/vibe_posix_ls_all"
  mkdir_p(dir)
  write_file(string_concat(dir, "/visible.txt"), "v")
  write_file(string_concat(dir, "/.hidden"), "h")
  let entries = ls_all(dir)
  let entry_names = names(entries)
  let hidden = filter_str(entry_names, (s: String) -> Bool {
    string_starts_with(s, ".")
  })
  assert(array_length(hidden) >= 1)
}

test "posix: cd dir && pwd" {
  cd("/tmp")
  let cwd = pwd()
  assert(string_contains(cwd, "tmp"))
}

test "posix: tee file" {
  let path = "/tmp/vibe_posix_tee.txt"
  let result = tee("tee output", path)
  assert(string_equals(result, "tee output"))
  let content = cat(path)
  assert(string_equals(content, "tee output"))
}

test "posix: find dir (recursive)" {
  let base = "/tmp/vibe_posix_find"
  mkdir_p(string_concat(base, "/sub/deep"))
  write_file(string_concat(base, "/a.txt"), "a")
  write_file(string_concat(base, "/sub/b.txt"), "b")
  write_file(string_concat(base, "/sub/deep/c.txt"), "c")
  let entries = find(base)
  assert(array_length(entries) >= 5)
}

test "posix: test -f and test -d" {
  let dir = "/tmp/vibe_posix_testfd"
  let file = "/tmp/vibe_posix_testfd/file.txt"
  mkdir_p(dir)
  write_file(file, "x")
  let d = is_dir(dir)
  let f = is_file(file)
  assert(d)
  assert(f)
  let not_d = is_dir(file)
  let not_f = is_file(dir)
  assert(not(not_d))
  assert(not(not_f))
}

test "posix: realpath" {
  let resolved = realpath("/tmp")
  assert(string_starts_with(resolved, "/"))
}

test "posix: head -n 3" {
  let text = "a\nb\nc\nd\ne"
  let result = lines(text)|>head_str(3)
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "a"))
  assert(string_equals(array_get(result, 2), "c"))
}

test "posix: tail -n 2" {
  let text = "a\nb\nc\nd\ne"
  let result = lines(text)|>tail_str(2)
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "d"))
  assert(string_equals(array_get(result, 1), "e"))
}

test "posix: sort" {
  let text = "cherry\napple\nbanana"
  let result = lines(text)|>sort_str()
  assert(string_equals(array_get(result, 0), "apple"))
  assert(string_equals(array_get(result, 1), "banana"))
  assert(string_equals(array_get(result, 2), "cherry"))
}

test "posix: sort | uniq" {
  let text = "b\na\nb\na\nc"
  let result = lines(text)|>sort_str()|>uniq()
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "a"))
  assert(string_equals(array_get(result, 1), "b"))
  assert(string_equals(array_get(result, 2), "c"))
}

test "posix: grep pattern" {
  let text = "error: fail\ninfo: ok\nerror: timeout\nwarn: slow"
  let result = lines(text)|>grep("error")
  assert(array_length(result) == 2)
  assert(string_contains(array_get(result, 0), "fail"))
  assert(string_contains(array_get(result, 1), "timeout"))
}

test "posix: cut -d: -f2" {
  let text = "name:alice:30\nname:bob:25"
  let result = lines(text)|>cut(":", 1)
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "alice"))
  assert(string_equals(array_get(result, 1), "bob"))
}

test "posix: tr abc ABC" {
  assert(string_equals(tr("hello", "hlo", "HLO"), "HeLLO"))
}

test "posix: wc -w (word count)" {
  assert(wc("the quick brown fox") == 4)
  assert(wc("") == 0)
  assert(wc("single") == 1)
}

test "posix: wc -l (line count)" {
  assert(wc_l("a\nb\nc") == 3)
  assert(wc_l("single line") == 1)
  assert(wc_l("") == 0)
}

test "posix: nl (number lines)" {
  let text = "first\nsecond\nthird"
  let result = lines(text)|>nl("\t")
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "1\tfirst"))
  assert(string_equals(array_get(result, 1), "2\tsecond"))
  assert(string_equals(array_get(result, 2), "3\tthird"))
}

test "posix: paste" {
  let xs = [
    "name",
    "age"
  ]
  let ys = [
    "alice",
    "30"
  ]
  let result = paste(xs, ys, "\t")
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "name\talice"))
  assert(string_equals(array_get(result, 1), "age\t30"))
}

test "posix: tac (reverse lines)" {
  assert(string_equals(tac("first\nsecond\nthird"), "third\nsecond\nfirst"))
}

test "posix: expand -t4 (tab expansion)" {
  assert(string_equals(expand("\tindented", 4), "    indented"))
}

test "posix: seq 1 10" {
  let result = seq(1, 10)
  assert(array_length(result) == 10)
  assert(string_equals(array_get(result, 0), "1"))
  assert(string_equals(array_get(result, 9), "10"))
}

test "posix: seq 0 2 10 (step)" {
  let result = seq_step(0, 2, 10)
  assert(array_length(result) == 6)
  assert(string_equals(array_get(result, 0), "0"))
  assert(string_equals(array_get(result, 5), "10"))
}

test "posix: basename" {
  assert(string_equals(basename("/foo/bar.txt"), "bar.txt"))
  assert(string_equals(basename("/usr/local/bin/prog"), "prog"))
  assert(string_equals(basename("file.txt"), "file.txt"))
}

test "posix: dirname" {
  assert(string_equals(dirname("/foo/bar.txt"), "/foo"))
  assert(string_equals(dirname("/usr/local/bin/prog"), "/usr/local/bin"))
  assert(string_equals(dirname("file.txt"), "."))
}

test "posix pipe: cat | grep | wc -l" {
  let path = "/tmp/vibe_posix_pipe1.txt"
  write_file(path, "error: a\ninfo: b\nerror: c\nwarn: d")
  let content = cat(path)
  let count = content|>lines()|>grep("error")|>count_str()
  assert(count == 2)
}

test "posix pipe: cat | sort | uniq" {
  let path = "/tmp/vibe_posix_pipe2.txt"
  write_file(path, "banana\napple\nbanana\ncherry\napple")
  let content = cat(path)
  let result = content|>lines()|>sort_str()|>uniq()
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "apple"))
  assert(string_equals(array_get(result, 1), "banana"))
  assert(string_equals(array_get(result, 2), "cherry"))
}

test "posix pipe: cat | head -n 5 | tail -n 3" {
  let path = "/tmp/vibe_posix_pipe3.txt"
  write_file(path, "1\n2\n3\n4\n5\n6\n7")
  let content = cat(path)
  let result = content|>lines()|>head_str(5)|>tail_str(3)
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "3"))
  assert(string_equals(array_get(result, 1), "4"))
  assert(string_equals(array_get(result, 2), "5"))
}

test "posix pipe: cat | cut | sort | uniq" {
  let path = "/tmp/vibe_posix_pipe4.txt"
  write_file(path, "b,2\na,1\nb,3\nc,4\na,5")
  let content = cat(path)
  let result = content|>lines()|>cut(",", 0)|>sort_str()|>uniq()
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "a"))
  assert(string_equals(array_get(result, 1), "b"))
  assert(string_equals(array_get(result, 2), "c"))
}

test "posix pipe: find | grep .txt" {
  let base = "/tmp/vibe_posix_pipe_find"
  mkdir_p(string_concat(base, "/sub"))
  write_file(string_concat(base, "/a.txt"), "a")
  write_file(string_concat(base, "/b.log"), "b")
  write_file(string_concat(base, "/sub/c.txt"), "c")
  let entries = find(base)
  let txt_files = names(entries)|>grep(".txt")
  assert(array_length(txt_files) >= 2)
}

test "posix pipe: ls | head -n 3" {
  let dir = "/tmp/vibe_posix_pipe_ls"
  mkdir_p(dir)
  write_file(string_concat(dir, "/a.txt"), "a")
  write_file(string_concat(dir, "/b.txt"), "b")
  write_file(string_concat(dir, "/c.txt"), "c")
  write_file(string_concat(dir, "/d.txt"), "d")
  let entries = ls(dir)
  let first3 = names(entries)|>head_str(3)
  assert(array_length(first3) == 3)
}

test "posix pipe: seq | grep" {
  let result = seq(1, 10)|>grep("5")
  assert(array_length(result) == 1)
  assert(string_equals(array_get(result, 0), "5"))
}

test "posix pipe: cut | tr" {
  let csv = "x,abc,z\ny,abd,w"
  let result = lines(csv)|>cut(",", 1)|>join_str("\n")
  let transformed = tr(result, "ab", "AB")
  assert(string_contains(transformed, "ABc"))
  assert(string_contains(transformed, "ABd"))
}

test "posix: ${#var} (len)" {
  assert(len("hello") == 5)
  assert(len("") == 0)
  assert(len("multi word string") == 17)
}

test "posix: upper" {
  assert(string_equals(upper("hello world"), "HELLO WORLD"))
}

test "posix: lower" {
  assert(string_equals(lower("HELLO WORLD"), "hello world"))
}

test "posix: sed s/old/new/g (replace)" {
  assert(string_equals(replace("foo bar foo", "foo", "baz"), "baz bar baz"))
  assert(string_equals(replace("hello", "x", "y"), "hello"))
}

test "posix: expr index (index_of)" {
  assert(index_of("hello world", "world") == 6)
  assert(index_of("abcdef", "cd") == 2)
  assert(index_of("hello", "xyz") == -1)
}

test "posix: echo $PATH (env)" {
  let path_val = env("PATH")
  assert(string_length(path_val) > 0)
  assert(string_contains(path_val, "/"))
}

test "posix: ${VAR:-default} (env_or)" {
  let val = env_or("VIBE_POSIX_TEST_NONEXISTENT_12345", "fallback")
  assert(string_equals(val, "fallback"))
}

test "posix: env_or with existing var" {
  let val = env_or("PATH", "unused_default")
  assert(string_contains(val, "/"))
}
