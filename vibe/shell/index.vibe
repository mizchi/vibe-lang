// Canonical collision-safe aliases
export let shell_print = (text: String) -> Unit {
  perform Stdout::WriteStream(text)
}

export let shell_println = (text: String) -> Unit {
  perform Stdout::WriteStream(text)
  perform Stdout::WriteChar(10)
}

export let shell_read_line = () -> String {
  perform Stdin::ReadStream(4096)
}

export let shell_exists = (path: String) -> Bool {
  perform Fs::Exists(path)
}

export let shell_is_dir = (path: String) -> Bool {
  perform Fs::IsDir(path)
}

export let shell_is_file = (path: String) -> Bool {
  perform Fs::IsFile(path)
}

export let shell_write_file = (path: String, content: String) -> Unit {
  perform Fs::WriteFile(path, content)
}
