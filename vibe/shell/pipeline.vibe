
use ./types.vibe { type FileEntry }

declare export let names: (Array[FileEntry]) -> Array[String]
declare export let take_str: (Array[String], Int) -> Array[String]
declare export let take_entries: (Array[FileEntry], Int) -> Array[FileEntry]
declare export let drop_str: (Array[String], Int) -> Array[String]
declare export let count_str: (Array[String]) -> Int
declare export let count_entries: (Array[FileEntry]) -> Int
declare export let lines: (String) -> Array[String]
declare export let grep: (Array[String], String) -> Array[String]

export let where_entry = (entries: Array[FileEntry], pred: (FileEntry) -> Bool) -> Array[FileEntry] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(entries) {
      let entry = array_get(entries, i)
      if pred(entry) {
        array_builder_push(result, entry)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}

names = (entries: Array[FileEntry]) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(entries) {
      let entry = array_get(entries, i)
      array_builder_push(result, entry.name)
      i = i + 1
    }
    array_builder_freeze(result)
  }
}

take_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let limit = if n < len { n } else { len }
    let mut i = 0
    while i < limit {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}

take_entries = (xs: Array[FileEntry], n: Int) -> Array[FileEntry] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let limit = if n < len { n } else { len }
    let mut i = 0
    while i < limit {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}

drop_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let start = if n < len { n } else { len }
    let mut i = start
    while i < len {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}

count_str = (xs: Array[String]) -> Int {
  array_length(xs)
}

count_entries = (xs: Array[FileEntry]) -> Int {
  array_length(xs)
}

lines = (text: String) -> Array[String] {
  string_split(text, "\n")
}

grep = (xs: Array[String], pattern: String) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(xs) {
      let line = array_get(xs, i)
      if string_contains(line, pattern) {
        array_builder_push(result, line)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
