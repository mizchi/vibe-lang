
use ./types.vibe {
  type FileEntry
}
export let wc = (text: String) -> Int {
  let trimmed = string_trim(text)
  if string_equals(trimmed, "") {
    0
  } else {
    let parts = string_split(trimmed, " ")
    do {
      let result = array_builder()
      let mut i = 0
      while i < array_length(parts) {
        let p = string_trim(array_get(parts, i))
        if not(string_equals(p, "")) {
          array_builder_push(result, p)
        }
        i = i + 1
      }
      array_length(array_builder_freeze(result))
    }
  }
}
export let grep = (xs: Array[String], pattern: String) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(xs) {
      let line = array_get(xs, i)
      if string_contains(line, pattern) {
        array_builder_push(result, line)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let trim = (text: String) -> String {
  string_trim(text)
}
export let uniq = (xs: Array[String]) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let mut i = 0
    while i < len {
      let item = array_get(xs, i)
      if i == 0 {
        array_builder_push(result, item)
      } else {
        if not(string_equals(item, array_get(xs, i - 1))) {
          array_builder_push(result, item)
        }
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let wc_l = (text: String) -> Int {
  if string_equals(text, "") {
    0
  } else {
    let ls = string_split(text, "\n")
    array_length(ls)
  }
}
export let lines = (text: String) -> Array[String] {
  string_split(text, "\n")
}
export let lower = (text: String) -> String {
  string_to_lower(text)
}
export let names = (entries: Array[FileEntry]) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(entries) {
      let entry = array_get(entries, i)
      array_builder_push(result, entry.name)
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let split = (text: String, sep: String) -> Array[String] {
  string_split(text, sep)
}
export let upper = (text: String) -> String {
  string_to_upper(text)
}
export let dirname = (path: String) -> String {
  let idx = string_last_index_of(path, "/")
  if idx < 0 {
    "."
  } else if idx == 0 {
    "/"
  } else {
    string_substring(path, 0, idx)
  }
}
export let replace = (text: String, pattern: String, replacement: String) -> String {
  string_replace_all(text, pattern, replacement)
}
export let rev_str = (xs: Array[String]) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let mut i = len - 1
    while i >= 0 {
      array_builder_push(result, array_get(xs, i))
      i = i - 1
    }
    array_builder_freeze(result)
  }
}
export let basename = (path: String) -> String {
  let idx = string_last_index_of(path, "/")
  if idx < 0 {
    path
  } else {
    string_substring(path, idx + 1, string_length(path))
  }
}
export let extname = (path: String) -> String {
  let base = basename(path)
  let idx = string_last_index_of(base, ".")
  if idx <= 0 {
    ""
  } else {
    string_substring(base, idx, string_length(base))
  }
}
export let drop_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let start = if n < len {
      n
    } else {
      len
    }
    let mut i = start
    while i < len {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let join_str = (xs: Array[String], sep: String) -> String {
  string_join(xs, sep)
}
export let sort_str = (xs: Array[String]) -> Array[String] {
  let len = array_length(xs)
  let arr = array_slice(xs, 0, len)
  let mut i2 = 1
  while i2 < len {
    let key = array_get(arr, i2)
    let mut j = i2 - 1
    while j >= 0 {
      if __lt(key, array_get(arr, j)) {
        arr[j + 1] = array_get(arr, j)
        j = j - 1
      } else {
        break
      }
    }
    arr[j + 1] = key
    i2 = i2 + 1
  }
  arr
}
export let tail_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let start = if len > n {
      len - n
    } else {
      0
    }
    let mut i = start
    while i < len {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let take_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let limit = if n < len {
      n
    } else {
      len
    }
    let mut i = 0
    while i < limit {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let head_str = (xs: Array[String], n: Int) -> Array[String] {
  take_str(xs, n)
}
export let count_str = (xs: Array[String]) -> Int {
  array_length(xs)
}
export let where_entry = (entries: Array[FileEntry], pred: (FileEntry) -> Bool) -> Array[FileEntry] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(entries) {
      let entry = array_get(entries, i)
      if pred(entry) {
        array_builder_push(result, entry)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let contains_str = (text: String, sub: String) -> Bool {
  string_contains(text, sub)
}
export let take_entries = (xs: Array[FileEntry], n: Int) -> Array[FileEntry] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let limit = if n < len {
      n
    } else {
      len
    }
    let mut i = 0
    while i < limit {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let count_entries = (xs: Array[FileEntry]) -> Int {
  array_length(xs)
}
