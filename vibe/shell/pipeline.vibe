
use ./types.vibe {
  type FileEntry
}
export let grep = (xs: Array[String], pattern: String) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(xs) {
      let line = array_get(xs, i)
      if string_contains(line, pattern) {
        array_builder_push(result, line)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let lines = (text: String) -> Array[String] {
  string_split(text, "\n")
}
export let names = (entries: Array[FileEntry]) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(entries) {
      let entry = array_get(entries, i)
      array_builder_push(result, entry.name)
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let drop_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let start = if n < len {
      n
    } else {
      len
    }
    let mut i = start
    while i < len {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let take_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let limit = if n < len {
      n
    } else {
      len
    }
    let mut i = 0
    while i < limit {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let count_str = (xs: Array[String]) -> Int {
  array_length(xs)
}
export let where_entry = (entries: Array[FileEntry], pred: (FileEntry) -> Bool) -> Array[FileEntry] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(entries) {
      let entry = array_get(entries, i)
      if pred(entry) {
        array_builder_push(result, entry)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let take_entries = (xs: Array[FileEntry], n: Int) -> Array[FileEntry] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let limit = if n < len {
      n
    } else {
      len
    }
    let mut i = 0
    while i < limit {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let count_entries = (xs: Array[FileEntry]) -> Int {
  array_length(xs)
}
