
use ./types.vibe {
  type FileEntry
}
export let jq = (text: String, expr: String) -> String {
  let root = from_json(text)
  let e = if string_starts_with(expr, ".") {
    string_substring(expr, 1, string_length(expr))
  } else {
    expr
  }
  if string_equals(e, "") {
    to_json(root)
  } else if string_equals(e, "keys") {
    do {
      let ks = json_keys(root)
      let sb = string_builder()
      string_builder_push(sb, "[")
      let mut i = 0
      while i < array_length(ks) {
        if i > 0 {
          string_builder_push(sb, ",")
        }
        string_builder_push(sb, "\"")
        string_builder_push(sb, array_get(ks, i))
        string_builder_push(sb, "\"")
        i = i + 1
      }
      string_builder_push(sb, "]")
      string_builder_freeze(sb)
    }
  } else if string_equals(e, "values") {
    do {
      let ks = json_keys(root)
      let sb = string_builder()
      string_builder_push(sb, "[")
      let mut i = 0
      while i < array_length(ks) {
        if i > 0 {
          string_builder_push(sb, ",")
        }
        string_builder_push(sb, to_json(json_get(root, array_get(ks, i))))
        i = i + 1
      }
      string_builder_push(sb, "]")
      string_builder_freeze(sb)
    }
  } else if string_equals(e, "type") {
    do {
      let sb = string_builder()
      string_builder_push(sb, "\"")
      string_builder_push(sb, json_type(root))
      string_builder_push(sb, "\"")
      string_builder_freeze(sb)
    }
  } else if string_equals(e, "length") {
    __to_string(json_length(root))
  } else if string_starts_with(e, "[") {
    let close_idx = string_index_of(e, "]")
    let idx_str = string_substring(e, 1, close_idx)
    let idx_len = string_length(idx_str)
    let mut idx = 0
    let mut k = 0
    while k < idx_len {
      let c = string_substring(idx_str, k, k + 1)
      let d = if string_equals(c, "0") {
        0
      }
      else if string_equals(c, "1") {
        1
      }
      else if string_equals(c, "2") {
        2
      }
      else if string_equals(c, "3") {
        3
      }
      else if string_equals(c, "4") {
        4
      }
      else if string_equals(c, "5") {
        5
      }
      else if string_equals(c, "6") {
        6
      }
      else if string_equals(c, "7") {
        7
      }
      else if string_equals(c, "8") {
        8
      }
      else {
        9
      }
      idx = idx * 10 + d
      k = k + 1
    }
    to_json(json_index(root, idx))
  } else if string_contains(e, ".") {
    let parts = string_split(e, ".")
    let mut cur = root
    let mut i = 0
    while i < array_length(parts) {
      cur = json_get(cur, array_get(parts, i))
      i = i + 1
    }
    to_json(cur)
  } else {
    to_json(json_get(root, e))
  }
}
export let nl = (xs: Array[String], sep: String) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(xs) {
      let num = __to_string(i + 1)
      array_builder_push(result, string_concat(string_concat(num, sep), array_get(xs, i)))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let tr = (text: String, src_chars: String, dst_chars: String) -> String {
  do {
    let sb = string_builder()
    let len = string_length(text)
    let mut i = 0
    while i < len {
      let ch = string_substring(text, i, i + 1)
      let idx = string_index_of(src_chars, ch)
      if idx >= 0 {
        if idx < string_length(dst_chars) {
          string_builder_push(sb, string_substring(dst_chars, idx, idx + 1))
        }
      } else {
        string_builder_push(sb, ch)
      }
      i = i + 1
    }
    string_builder_freeze(sb)
  }
}
export let wc = (text: String) -> Int {
  let trimmed = string_trim(text)
  if string_equals(trimmed, "") {
    0
  } else {
    let parts = string_split(trimmed, " ")
    do {
      let result = array_builder()
      let mut i = 0
      while i < array_length(parts) {
        let p = string_trim(array_get(parts, i))
        if not(string_equals(p, "")) {
          array_builder_push(result, p)
        }
        i = i + 1
      }
      array_length(array_builder_freeze(result))
    }
  }
}
export let cut = (xs: Array[String], delim: String, field: Int) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(xs) {
      let parts = string_split(array_get(xs, i), delim)
      if field < array_length(parts) {
        array_builder_push(result, array_get(parts, field))
      } else {
        array_builder_push(result, "")
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let len = (text: String) -> Int {
  string_length(text)
}
export let seq = (first: Int, last: Int) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = first
    while i <= last {
      array_builder_push(result, __to_string(i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let grep = (xs: Array[String], pattern: String) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(xs) {
      let line = array_get(xs, i)
      if string_contains(line, pattern) {
        array_builder_push(result, line)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let trim = (text: String) -> String {
  string_trim(text)
}
export let uniq = (xs: Array[String]) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let mut i = 0
    while i < len {
      let item = array_get(xs, i)
      if i == 0 {
        array_builder_push(result, item)
      } else {
        if not(string_equals(item, array_get(xs, i - 1))) {
          array_builder_push(result, item)
        }
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let wc_l = (text: String) -> Int {
  if string_equals(text, "") {
    0
  } else {
    let ls = string_split(text, "\n")
    array_length(ls)
  }
}
export let count = (text: String, sub: String) -> Int {
  string_count(text, sub)
}
export let lines = (text: String) -> Array[String] {
  string_split(text, "\n")
}
export let lower = (text: String) -> String {
  string_to_lower(text)
}
export let names = (entries: Array[FileEntry]) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(entries) {
      let entry = array_get(entries, i)
      array_builder_push(result, entry.name)
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let paste = (xs: Array[String], ys: Array[String], sep: String) -> Array[String] {
  do {
    let result = array_builder()
    let len_x = array_length(xs)
    let len_y = array_length(ys)
    let max_len = if len_x > len_y {
      len_x
    } else {
      len_y
    }
    let mut i = 0
    while i < max_len {
      let x = if i < len_x {
        array_get(xs, i)
      } else {
        ""
      }
      let y = if i < len_y {
        array_get(ys, i)
      } else {
        ""
      }
      array_builder_push(result, string_concat(string_concat(x, sep), y))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let split = (text: String, sep: String) -> Array[String] {
  string_split(text, sep)
}
export let upper = (text: String) -> String {
  string_to_upper(text)
}
export let expand = (text: String, tab_width: Int) -> String {
  do {
    let sb = string_builder()
    let len = string_length(text)
    let spaces_sb = string_builder()
    let mut s = 0
    while s < tab_width {
      string_builder_push(spaces_sb, " ")
      s = s + 1
    }
    let spaces = string_builder_freeze(spaces_sb)
    let mut i = 0
    while i < len {
      let ch = string_substring(text, i, i + 1)
      if string_equals(ch, "\t") {
        string_builder_push(sb, spaces)
      } else {
        string_builder_push(sb, ch)
      }
      i = i + 1
    }
    string_builder_freeze(sb)
  }
}
export let jq_arr = (text: String) -> Array[String] {
  do {
    let j = from_json(text)
    let n = json_length(j)
    let result = array_builder()
    let mut i = 0
    while i < n {
      array_builder_push(result, to_json(json_index(j, i)))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let jq_num = (text: String, expr: String) -> Double {
  json_number(from_json(jq(text, expr)))
}
export let jq_str = (text: String, expr: String) -> String {
  json_string(from_json(jq(text, expr)))
}
export let char_at = (text: String, idx: Int) -> String {
  string_substring(text, idx, idx + 1)
}
export let dirname = (path: String) -> String {
  let idx = string_last_index_of(path, "/")
  if idx < 0 {
    "."
  } else if idx == 0 {
    "/"
  } else {
    string_substring(path, 0, idx)
  }
}
export let map_str = (xs: Array[String], f: (String) -> String) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(xs) {
      array_builder_push(result, f(array_get(xs, i)))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let replace = (text: String, pattern: String, replacement: String) -> String {
  string_replace_all(text, pattern, replacement)
}
export let rev_str = (xs: Array[String]) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let mut i = len - 1
    while i >= 0 {
      array_builder_push(result, array_get(xs, i))
      i = i - 1
    }
    array_builder_freeze(result)
  }
}
export let tac = (text: String) -> String {
  let ls = string_split(text, "\n")
  let reversed = rev_str(ls)
  string_join(reversed, "\n")
}
export let basename = (path: String) -> String {
  let idx = string_last_index_of(path, "/")
  if idx < 0 {
    path
  } else {
    string_substring(path, idx + 1, string_length(path))
  }
}
export let extname = (path: String) -> String {
  let base = basename(path)
  let idx = string_last_index_of(base, ".")
  if idx <= 0 {
    ""
  } else {
    string_substring(base, idx, string_length(base))
  }
}
export let drop_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let start = if n < len {
      n
    } else {
      len
    }
    let mut i = start
    while i < len {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let index_of = (text: String, sub: String) -> Int {
  string_index_of(text, sub)
}
export let join_str = (xs: Array[String], sep: String) -> String {
  string_join(xs, sep)
}
export let pad_left = (text: String, width: Int, pad: String) -> String {
  let text_len = string_length(text)
  if text_len >= width {
    text
  } else {
    do {
      let pad_len = string_length(pad)
      let sb = string_builder()
      let mut filled = 0
      let needed = width - text_len
      while filled < needed {
        if pad_len > 0 {
          let remaining = needed - filled
          if remaining >= pad_len {
            string_builder_push(sb, pad)
            filled = filled + pad_len
          } else {
            string_builder_push(sb, string_substring(pad, 0, remaining))
            filled = filled + remaining
          }
        } else {
          filled = needed
        }
      }
      string_builder_push(sb, text)
      string_builder_freeze(sb)
    }
  }
}
export let seq_step = (first: Int, incr: Int, last: Int) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = first
    if incr > 0 {
      while i <= last {
        array_builder_push(result, __to_string(i))
        i = i + incr
      }
    } else if incr < 0 {
      while i >= last {
        array_builder_push(result, __to_string(i))
        i = i + incr
      }
    }
    array_builder_freeze(result)
  }
}
export let sort_str = (xs: Array[String]) -> Array[String] {
  let len = array_length(xs)
  let arr = array_slice(xs, 0, len)
  let mut i2 = 1
  while i2 < len {
    let key = array_get(arr, i2)
    let mut j = i2 - 1
    while j >= 0 {
      if __lt(key, array_get(arr, j)) {
        arr[j + 1] = array_get(arr, j)
        j = j - 1
      } else {
        break
      }
    }
    arr[j + 1] = key
    i2 = i2 + 1
  }
  arr
}
export let tail_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let start = if len > n {
      len - n
    } else {
      0
    }
    let mut i = start
    while i < len {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let take_str = (xs: Array[String], n: Int) -> Array[String] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let limit = if n < len {
      n
    } else {
      len
    }
    let mut i = 0
    while i < limit {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let head_str = (xs: Array[String], n: Int) -> Array[String] {
  take_str(xs, n)
}
export let count_str = (xs: Array[String]) -> Int {
  array_length(xs)
}
export let ends_with = (text: String, suffix: String) -> Bool {
  string_ends_with(text, suffix)
}
export let pad_right = (text: String, width: Int, pad: String) -> String {
  let text_len = string_length(text)
  if text_len >= width {
    text
  } else {
    do {
      let pad_len = string_length(pad)
      let sb = string_builder()
      string_builder_push(sb, text)
      let mut filled = 0
      let needed = width - text_len
      while filled < needed {
        if pad_len > 0 {
          let remaining = needed - filled
          if remaining >= pad_len {
            string_builder_push(sb, pad)
            filled = filled + pad_len
          } else {
            string_builder_push(sb, string_substring(pad, 0, remaining))
            filled = filled + remaining
          }
        } else {
          filled = needed
        }
      }
      string_builder_freeze(sb)
    }
  }
}
export let filter_str = (xs: Array[String], f: (String) -> Bool) -> Array[String] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(xs) {
      let item = array_get(xs, i)
      if f(item) {
        array_builder_push(result, item)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let repeat_str = (text: String, n: Int) -> String {
  do {
    let sb = string_builder()
    let mut i = 0
    while i < n {
      string_builder_push(sb, text)
      i = i + 1
    }
    string_builder_freeze(sb)
  }
}
export let starts_with = (text: String, prefix: String) -> Bool {
  string_starts_with(text, prefix)
}
export let where_entry = (entries: Array[FileEntry], pred: (FileEntry) -> Bool) -> Array[FileEntry] {
  do {
    let result = array_builder()
    let mut i = 0
    while i < array_length(entries) {
      let entry = array_get(entries, i)
      if pred(entry) {
        array_builder_push(result, entry)
      }
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let contains_str = (text: String, sub: String) -> Bool {
  string_contains(text, sub)
}
export let take_entries = (xs: Array[FileEntry], n: Int) -> Array[FileEntry] {
  do {
    let result = array_builder()
    let len = array_length(xs)
    let limit = if n < len {
      n
    } else {
      len
    }
    let mut i = 0
    while i < limit {
      array_builder_push(result, array_get(xs, i))
      i = i + 1
    }
    array_builder_freeze(result)
  }
}
export let count_entries = (xs: Array[FileEntry]) -> Int {
  array_length(xs)
}
export let last_index_of = (text: String, sub: String) -> Int {
  string_last_index_of(text, sub)
}
export let grep_re = (xs: Array[String], pattern: String) -> Array[String] with {
  Stdout
} {
  let text = string_join(xs, "\n")
  if string_equals(text, "") {
    xs
  } else {
    do {
      sh_lines(string_concat(string_concat(string_concat("printf '%s' '", string_replace_all(text, "'", "'\\''")), "' | grep -E '"), string_concat(string_replace_all(pattern, "'", "'\\''"), "'")))
    }
  }
}
export {
  jq, nl, tr, wc, cut, len, seq, tac, grep, trim, uniq, wc_l, count, lines, lower, names, paste, split, upper, expand, jq_arr, jq_num, jq_str, char_at, dirname, extname, map_str, replace, rev_str, basename, drop_str, head_str, index_of, join_str, pad_left, seq_step, sort_str, tail_str, take_str, count_str, ends_with, pad_right, filter_str, repeat_str, starts_with, where_entry, contains_str, take_entries, count_entries, last_index_of, grep_re
}
