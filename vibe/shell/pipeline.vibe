//# Imports

import ./types.vibe {
  type FileEntry
}

//# Functions

export let jq = (text: String, expr: String) -> String {
  let root = Json::parse(text)
  let e = if String::starts_with(expr, ".") {
    String::substring(expr, 1, String::length(expr))
  } else expr
  if e == "" {
    Json::stringify(root)
  } else if e == "keys" {
    {
      let ks = Json::keys(root)
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "[")
      let mut i = 0
      while i < Array::length(ks) {
        if i > 0 {
          StringBuilder::push(sb, ",")
        }
        StringBuilder::push(sb, "\"")
        StringBuilder::push(sb, Array::get(ks, i))
        StringBuilder::push(sb, "\"")
        i = i + 1
      }
      StringBuilder::push(sb, "]")
      StringBuilder::freeze(sb)
    }
  } else if e == "values" {
    {
      let ks = Json::keys(root)
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "[")
      let mut i = 0
      while i < Array::length(ks) {
        if i > 0 {
          StringBuilder::push(sb, ",")
        }
        StringBuilder::push(sb, Json::stringify(Json::get(root, Array::get(ks, i))))
        i = i + 1
      }
      StringBuilder::push(sb, "]")
      StringBuilder::freeze(sb)
    }
  } else if e == "type" {
    {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "\"")
      StringBuilder::push(sb, Json::type_of(root))
      StringBuilder::push(sb, "\"")
      StringBuilder::freeze(sb)
    }
  } else if e == "length" {
    __to_string(Json::length(root))
  } else if String::starts_with(e, "[") {
    let close_idx = String::index_of(e, "]")
    let idx_str = String::substring(e, 1, close_idx)
    let idx_len = String::length(idx_str)
    let mut idx = 0
    let mut k = 0
    while k < idx_len {
      let c = idx_str[k]
      let d = if c == "0" {
        0
      }
      else if c == "1" {
        1
      }
      else if c == "2" {
        2
      }
      else if c == "3" {
        3
      }
      else if c == "4" {
        4
      }
      else if c == "5" {
        5
      }
      else if c == "6" {
        6
      }
      else if c == "7" {
        7
      }
      else if c == "8" {
        8
      }
      else 9
      idx = idx * 10 + d
      k = k + 1
    }
    Json::stringify(Json::index(root, idx))
  } else if String::contains(e, ".") {
    let parts = String::split(e, ".")
    let mut cur = root
    let mut i = 0
    while i < Array::length(parts) {
      cur = Json::get(cur, Array::get(parts, i))
      i = i + 1
    }
    Json::stringify(cur)
  } else Json::stringify(Json::get(root, e))
}

export let nl = (xs: Array[String], sep: String) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(xs) {
      let num = __to_string(i + 1)
      ArrayBuilder::push(result, "\{num}\{sep}\{Array::get(xs, i)}")
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let tr = (text: String, src_chars: String, dst_chars: String) -> String {
  {
    let sb = StringBuilder::new()
    let len = String::length(text)
    let mut i = 0
    while i < len {
      let ch = text[i]
      let idx = String::index_of(src_chars, ch)
      if idx >= 0 {
        if idx < String::length(dst_chars) {
          StringBuilder::push(sb, dst_chars[idx])
        }
      } else StringBuilder::push(sb, ch)
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

export let wc = (text: String) -> Int {
  let trimmed = String::trim(text)
  if trimmed == "" {
    0
  } else {
    let parts = String::split(trimmed, " ")
    {
      let result = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(parts) {
        let p = String::trim(Array::get(parts, i))
        if not(p == "") {
          ArrayBuilder::push(result, p)
        }
        i = i + 1
      }
      Array::length(ArrayBuilder::freeze(result))
    }
  }
}

export let cut = (xs: Array[String], delim: String, field: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(xs) {
      let parts = String::split(Array::get(xs, i), delim)
      if field >= 0 && field < Array::length(parts) {
        ArrayBuilder::push(result, Array::get(parts, field))
      } else ArrayBuilder::push(result, "")
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let len = (text: String) -> Int {
  String::length(text)
}

export let seq = (first: Int, last: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = first
    while i <= last {
      ArrayBuilder::push(result, __to_string(i))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let grep = (xs: Array[String], pattern: String) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(xs) {
      let line = Array::get(xs, i)
      if String::contains(line, pattern) {
        ArrayBuilder::push(result, line)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let trim = (text: String) -> String {
  String::trim(text)
}

export let uniq = (xs: Array[String]) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let mut i = 0
    while i < len {
      let item = Array::get(xs, i)
      if i == 0 {
        ArrayBuilder::push(result, item)
      } else if not(item == Array::get(xs, i - 1)) {
        ArrayBuilder::push(result, item)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let wc_l = (text: String) -> Int {
  if text == "" {
    0
  } else {
    let ls = String::split(text, "\n")
    Array::length(ls)
  }
}

export let count = (text: String, sub: String) -> Int {
  String::count(text, sub)
}

export let lines = (text: String) -> Array[String] {
  String::split(text, "\n")
}

export let lower = (text: String) -> String {
  String::to_lower(text)
}

export let paste = (xs: Array[String], ys: Array[String], sep: String) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len_x = Array::length(xs)
    let len_y = Array::length(ys)
    let max_len = if len_x > len_y {
      len_x
    } else len_y
    let mut i = 0
    while i < max_len {
      let x = if i < len_x {
        Array::get(xs, i)
      } else ""
      let y = if i < len_y {
        Array::get(ys, i)
      } else ""
      ArrayBuilder::push(result, "\{x}\{sep}\{y}")
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let split = (text: String, sep: String) -> Array[String] {
  String::split(text, sep)
}

export let upper = (text: String) -> String {
  String::to_upper(text)
}

export let expand = (text: String, tab_width: Int) -> String {
  {
    let sb = StringBuilder::new()
    let len = String::length(text)
    let spaces_sb = StringBuilder::new()
    let mut s = 0
    while s < tab_width {
      StringBuilder::push(spaces_sb, " ")
      s = s + 1
    }
    let spaces = StringBuilder::freeze(spaces_sb)
    let mut i = 0
    while i < len {
      let ch = text[i]
      if ch == "\t" {
        StringBuilder::push(sb, spaces)
      } else StringBuilder::push(sb, ch)
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

export let jq_arr = (text: String) -> Array[String] {
  {
    let j = Json::parse(text)
    let n = Json::length(j)
    let result = ArrayBuilder::new()
    let mut i = 0
    while i < n {
      ArrayBuilder::push(result, Json::stringify(Json::index(j, i)))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let jq_num = (text: String, expr: String) -> Double {
  Json::number(Json::parse(jq(text, expr)))
}

export let jq_str = (text: String, expr: String) -> String {
  Json::string(Json::parse(jq(text, expr)))
}

export let char_at = (text: String, idx: Int) -> String {
  text[idx]
}

export let dirname = (path: String) -> String {
  let idx = String::last_index_of(path, "/")
  if idx < 0 {
    "."
  } else if idx == 0 {
    "/"
  } else String::substring(path, 0, idx)
}

export let grep_re = (xs: Array[String], pattern: String) -> Array[String] with { Stdout } {
  let text = String::join(xs, "\n")
  if text == "" {
    xs
  } else {
    let escaped_text = String::replace_all(text, "'", "'\\''")
    let escaped_pattern = String::replace_all(pattern, "'", "'\\''")
    sh_lines("printf '%s' '\{escaped_text}' | grep -E '\{escaped_pattern}'")
  }
}

export let replace = (text: String, pattern: String, replacement: String) -> String {
  String::replace_all(text, pattern, replacement)
}

export let rev_str = (xs: Array[String]) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let mut i = len - 1
    while i >= 0 {
      ArrayBuilder::push(result, Array::get(xs, i))
      i = i - 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let tac = (text: String) -> String {
  let ls = String::split(text, "\n")
  let reversed = rev_str(ls)
  String::join(reversed, "\n")
}

export let basename = (path: String) -> String {
  let idx = String::last_index_of(path, "/")
  if idx < 0 {
    path
  } else String::substring(path, idx + 1, String::length(path))
}

export let extname = (path: String) -> String {
  let base = basename(path)
  let idx = String::last_index_of(base, ".")
  if idx <= 0 {
    ""
  } else String::substring(base, idx, String::length(base))
}

export let index_of = (text: String, sub: String) -> Int {
  String::index_of(text, sub)
}

export let join_str = (xs: Array[String], sep: String) -> String {
  String::join(xs, sep)
}

export let seq_step = (first: Int, incr: Int, last: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = first
    if incr > 0 {
      while i <= last {
        ArrayBuilder::push(result, __to_string(i))
        i = i + incr
      }
    } else if incr < 0 {
      while i >= last {
        ArrayBuilder::push(result, __to_string(i))
        i = i + incr
      }
    }
    ArrayBuilder::freeze(result)
  }
}

export let sort_str = (xs: Array[String]) -> Array[String] {
  let len = Array::length(xs)
  let arr = Array::slice(xs, 0, len)
  let mut i2 = 1
  while i2 < len {
    let key = Array::get(arr, i2)
    let mut j = i2 - 1
    while j >= 0 {
      if __lt(key, Array::get(arr, j)) {
        arr[j + 1] = Array::get(arr, j)
        j = j - 1
      } else break
    }
    arr[j + 1] = key
    i2 = i2 + 1
  }
  arr
}

let clamp_int = (value: Int, lower: Int, upper: Int) -> Int {
  if value < lower {
    lower
  } else if value > upper {
    upper
  } else value
}

export let drop_str = (xs: Array[String], n: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let start = clamp_int(n, 0, len)
    let mut i = start
    while i < len {
      ArrayBuilder::push(result, Array::get(xs, i))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let tail_str = (xs: Array[String], n: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let keep = clamp_int(n, 0, len)
    let start = if len > keep {
      len - keep
    } else 0
    let mut i = start
    while i < len {
      ArrayBuilder::push(result, Array::get(xs, i))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let count_str = (xs: Array[String]) -> Int {
  Array::length(xs)
}

export let ends_with = (text: String, suffix: String) -> Bool {
  String::ends_with(text, suffix)
}

let array_take = [T](xs: Array[T], n: Int) -> Array[T] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let limit = clamp_int(n, 0, len)
    let mut i = 0
    while i < limit {
      ArrayBuilder::push(result, Array::get(xs, i))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let take_str = (xs: Array[String], n: Int) -> Array[String] {
  array_take(xs, n)
}

export let head_str = (xs: Array[String], n: Int) -> Array[String] {
  take_str(xs, n)
}

export let repeat_str = (text: String, n: Int) -> String {
  {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < n {
      StringBuilder::push(sb, text)
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

export let starts_with = (text: String, prefix: String) -> Bool {
  String::starts_with(text, prefix)
}

export let contains_str = (text: String, sub: String) -> Bool {
  String::contains(text, sub)
}

export let take_entries = (xs: Array[FileEntry], n: Int) -> Array[FileEntry] {
  array_take(xs, n)
}

export let count_entries = (xs: Array[FileEntry]) -> Int {
  Array::length(xs)
}

export let last_index_of = (text: String, sub: String) -> Int {
  String::last_index_of(text, sub)
}

let build_pad_prefix = (needed: Int, pad: String) -> String {
  if needed <= 0 {
    ""
  } else {
    let pad_len = String::length(pad)
    if pad_len <= 0 {
      ""
    } else {
      let sb = StringBuilder::new()
      let mut remaining = needed
      while remaining >= pad_len {
        StringBuilder::push(sb, pad)
        remaining = remaining - pad_len
      }
      if remaining > 0 {
        StringBuilder::push(sb, String::substring(pad, 0, remaining))
      }
      StringBuilder::freeze(sb)
    }
  }
}

export let pad_left = (text: String, width: Int, pad: String) -> String {
  let text_len = String::length(text)
  if text_len >= width {
    text
  } else {
    let needed = width - text_len
    let prefix = build_pad_prefix(needed, pad)
    "\{prefix}\{text}"
  }
}

export let pad_right = (text: String, width: Int, pad: String) -> String {
  let text_len = String::length(text)
  if text_len >= width {
    text
  } else {
    let needed = width - text_len
    let suffix = build_pad_prefix(needed, pad)
    "\{text}\{suffix}"
  }
}

let Array::r#map = [
  A,
  B
](xs: Array[A], f: (A) -> B) -> Array[B] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let mut i = 0
    while i < len {
      ArrayBuilder::push(result, f(Array::get(xs, i)))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let names = (entries: Array[FileEntry]) -> Array[String] {
  Array::r#map(entries, (entry: FileEntry) -> String {
    entry.name
  })
}

export let map_str = (xs: Array[String], f: (String) -> String) -> Array[String] {
  Array::r#map(xs, f)
}

let Array::filter = [T](xs: Array[T], pred: (T) -> Bool) -> Array[T] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let mut i = 0
    while i < len {
      let item = Array::get(xs, i)
      if pred(item) {
        ArrayBuilder::push(result, item)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export let filter_str = (xs: Array[String], f: (String) -> Bool) -> Array[String] {
  Array::filter(xs, f)
}

export let where_entry = (entries: Array[FileEntry], pred: (FileEntry) -> Bool) -> Array[FileEntry] {
  Array::filter(entries, pred)
}
