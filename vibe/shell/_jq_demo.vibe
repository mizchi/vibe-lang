//# Imports

import ./commands.vibe {
  write_file, cat, println
}

import ./pipeline.vibe {
  jq, jq_str, jq_num, jq_arr, map_str, join_str
}

//# Functions

let main = () -> Unit with { Fs, Stdout } {
  println("=== jq demo ===")
  let data1 = "{\"name\":\"vibe\"}"
  let name = jq_str(data1, "name")
  println(string_concat("1. name: ", name))
  let data2 = "{\"a\":{\"b\":42}}"
  let val = jq(data2, "a.b")
  println(string_concat("2. a.b: ", val))
  let data3 = "[10,20,30]"
  let first = jq(data3, "[0]")
  println(string_concat("3. [0]: ", first))
  let data4 = "{\"items\":[\"x\",\"y\",\"z\"]}"
  let item_json = jq(data4, "items")|>jq("[1]")
  println(string_concat("4. items[1]: ", item_json))
  let data5 = "{\"a\":1,\"b\":2,\"c\":3}"
  let keys = jq(data5, "keys")|>jq_arr()
  println(string_concat("5. keys: ", join_str(keys, ", ")))
  let arr_type = jq_str(jq(data4, "items"), "type")
  println(string_concat("6. type: ", arr_type))
  let arr_len = jq(jq(data4, "items"), "length")
  println(string_concat("6. length: ", arr_len))
  let file_path = "/tmp/vibe_jq_demo.json"
  write_file(file_path, "{\"users\":[{\"name\":\"alice\",\"age\":30},{\"name\":\"bob\",\"age\":25}]}")
  let file_data = cat(file_path)
  let user_names = jq(file_data, "users")|>jq_arr()|>map_str((u: String) -> String {
    jq_str(u, "name")
  })
  println(string_concat("7. users: ", join_str(user_names, ", ")))
  let bob_json = jq(file_data, "users")|>jq("[1]")
  let bob_age = jq_num(bob_json, "age")
  println(string_concat("8. bob age: ", __to_string(bob_age)))
  println("done")
}
