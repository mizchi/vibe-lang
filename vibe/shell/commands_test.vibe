//# Imports

use ./commands.vibe {
  ls, ls_all, pwd, cd, cat, echo, mkdir, mkdir_p, touch,
  rm, cp, mv, write_file, append, exists, is_dir, is_file, env, env_or,
  exec_lines, tee, find, realpath
}

use ./types.vibe {
  type FileEntry
}

//# Misc

test "echo returns text" {
  assert(string_equals(echo("hello"), "hello"))
}

test "pwd returns string" {
  let cwd = do {
    pwd()
  }
  assert(string_length(cwd) > 0)
}

test "mkdir and ls" {
  let dir = "/tmp/vibe_shell_test_ls"
  do {
    mkdir_p(dir)
  }
  let entries = do {
    ls(dir)
  }
  assert(array_length(entries) >= 0)
}

test "touch and cat" {
  let path = "/tmp/vibe_shell_test_touch.txt"
  do {
    touch(path)
  }
  let content = do {
    cat(path)
  }
  assert(string_equals(content, ""))
}

test "cd changes cwd" {
  do {
    cd("/tmp")
  }
  let after = do {
    pwd()
  }
  assert(string_equals(after, "/tmp"))
}

test "ls_all shows hidden files" {
  let dir = "/tmp/vibe_shell_test_hidden"
  do {
    mkdir_p(dir)
  }
  do {
    touch(string_concat(dir, "/.hidden"))
  }
  do {
    touch(string_concat(dir, "/visible"))
  }
  let without_all = do {
    ls(dir)
  }
  let with_all = do {
    ls_all(dir)
  }
  assert(array_length(with_all) >= array_length(without_all))
}

test "mkdir_p creates nested dirs" {
  let dir = "/tmp/vibe_shell_test_mkdir_p/a/b/c"
  do {
    mkdir_p(dir)
  }
  let exists_result = do {
    fs_exists(dir)
  }
  assert(exists_result)
}

test "write_file and cat roundtrip" {
  let path = "/tmp/vibe_shell_test_write.txt"
  do {
    write_file(path, "hello world")
  }
  let content = do {
    cat(path)
  }
  assert(string_equals(content, "hello world"))
}

test "rm removes file" {
  let path = "/tmp/vibe_shell_test_rm.txt"
  do {
    write_file(path, "delete me")
  }
  do {
    rm(path)
  }
  let e = do {
    exists(path)
  }
  assert(not(e))
}

test "cp copies file" {
  let src = "/tmp/vibe_shell_test_cp_src.txt"
  let dst = "/tmp/vibe_shell_test_cp_dst.txt"
  do {
    write_file(src, "copy me")
  }
  do {
    cp(src, dst)
  }
  let content = do {
    cat(dst)
  }
  assert(string_equals(content, "copy me"))
}

test "mv moves file" {
  let src = "/tmp/vibe_shell_test_mv_src.txt"
  let dst = "/tmp/vibe_shell_test_mv_dst.txt"
  do {
    write_file(src, "move me")
  }
  do {
    mv(src, dst)
  }
  let e = do {
    exists(src)
  }
  assert(not(e))
  let content = do {
    cat(dst)
  }
  assert(string_equals(content, "move me"))
}

test "append appends to file" {
  let path = "/tmp/vibe_shell_test_append.txt"
  do {
    write_file(path, "hello")
  }
  do {
    append(path, " world")
  }
  let content = do {
    cat(path)
  }
  assert(string_equals(content, "hello world"))
}

test "exists checks file existence" {
  let path = "/tmp/vibe_shell_test_exists.txt"
  do {
    write_file(path, "x")
  }
  let e = do {
    exists(path)
  }
  assert(e)
  let e2 = do {
    exists("/tmp/vibe_shell_test_no_such_file_999.txt")
  }
  assert(not(e2))
}

test "is_dir and is_file" {
  let dir = "/tmp/vibe_shell_test_isdir"
  let file = "/tmp/vibe_shell_test_isfile.txt"
  do {
    mkdir_p(dir)
  }
  do {
    write_file(file, "x")
  }
  let d = do {
    is_dir(dir)
  }
  assert(d)
  let f = do {
    is_file(file)
  }
  assert(f)
  let d2 = do {
    is_dir(file)
  }
  assert(not(d2))
  let f2 = do {
    is_file(dir)
  }
  assert(not(f2))
}

test "env reads environment variable" {
  let path_val = do {
    env("PATH")
  }
  assert(string_length(path_val) > 0)
}

test "env_or returns fallback for missing var" {
  let val = do {
    env_or("VIBE_SHELL_TEST_NONEXISTENT_VAR_12345", "default_value")
  }
  assert(string_equals(val, "default_value"))
}

test "exec_lines returns output" {
  let result = do {
    exec_lines("echo hello")
  }
  assert(array_length(result) >= 1)
  assert(string_equals(array_get(result, 0), "hello"))
}

test "tee writes file and returns text" {
  let path = "/tmp/vibe_shell_test_tee.txt"
  let result = do {
    tee("tee content", path)
  }
  assert(string_equals(result, "tee content"))
  let content = do {
    cat(path)
  }
  assert(string_equals(content, "tee content"))
}

test "find recursively lists entries" {
  let base = "/tmp/vibe_shell_test_find"
  do {
    mkdir_p(string_concat(base, "/sub"))
  }
  do {
    write_file(string_concat(base, "/a.txt"), "a")
  }
  do {
    write_file(string_concat(base, "/sub/b.txt"), "b")
  }
  let entries = do {
    find(base)
  }
  assert(array_length(entries) >= 3)
}

test "realpath resolves absolute path" {
  let resolved = do {
    realpath("/tmp")
  }
  assert(string_starts_with(resolved, "/"))
}

test "realpath resolves with trailing component" {
  let resolved = do {
    realpath("/tmp/.")
  }
  assert(string_contains(resolved, "tmp"))
}
