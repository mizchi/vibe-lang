//# Imports

import ./from_yaml.vibe {
  from_yaml
}

//# Misc

test "yaml simple key-value" {
  let data = from_yaml("name: vibe")
  assert(String::equals(Json::string(Json::get(data, "name")), "vibe"))
}

test "yaml number value" {
  let data = from_yaml("port: 8080")
  assert(eq(Json::number(Json::get(data, "port")), 8080.0))
}

test "yaml bool and null" {
  let data = from_yaml("flag: true\nval: null")
  assert(Json::bool(Json::get(data, "flag")))
  assert(Json::is_null(Json::get(data, "val")))
}

test "yaml nested object" {
  let data = from_yaml("db:\n  host: localhost\n  port: 5432")
  assert(String::equals(Json::string(Json::get(Json::get(data, "db"), "host")), "localhost"))
  assert(eq(Json::number(Json::get(Json::get(data, "db"), "port")), 5432.0))
}

test "yaml list" {
  let data = from_yaml("- a\n- b\n- c")
  assert(Json::length(data) == 3)
  assert(String::equals(Json::string(Json::index(data, 0)), "a"))
  assert(String::equals(Json::string(Json::index(data, 2)), "c"))
}

test "yaml list in mapping" {
  let data = from_yaml("items:\n  - x\n  - y")
  let items = Json::get(data, "items")
  assert(Json::length(items) == 2)
}

test "yaml quoted string with colon" {
  let data = from_yaml("msg: 'hello: world'")
  assert(String::equals(Json::string(Json::get(data, "msg")), "hello: world"))
}

test "yaml comment stripping" {
  let data = from_yaml("key: val # this is a comment")
  assert(String::equals(Json::string(Json::get(data, "key")), "val"))
}

test "yaml tilde is null" {
  let data = from_yaml("x: ~")
  assert(Json::is_null(Json::get(data, "x")))
}

test "yaml scalar document values" {
  assert(eq(Json::number(from_yaml("42")), 42.0))
  assert(Json::bool(from_yaml("true")))
  assert(Json::is_null(from_yaml("null")))
  assert(String::equals(Json::string(from_yaml("hello")), "hello"))
}

test "yaml numeric scalar detection includes negative and decimal" {
  let data = from_yaml("neg: -12\npi: 3.5")
  assert(eq(Json::number(Json::get(data, "neg")), -12.0))
  assert(eq(Json::number(Json::get(data, "pi")), 3.5))
}

test "yaml keeps hash inside quoted values" {
  let data = from_yaml("msg: \"a # b\"")
  assert(String::equals(Json::string(Json::get(data, "msg")), "a # b"))
}

test "yaml multiple keys" {
  let data = from_yaml("a: 1\nb: 2\nc: 3")
  assert(eq(Json::number(Json::get(data, "a")), 1.0))
  assert(eq(Json::number(Json::get(data, "b")), 2.0))
  assert(eq(Json::number(Json::get(data, "c")), 3.0))
}
