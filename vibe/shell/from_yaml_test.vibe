
use ./from_yaml.vibe {
  from_yaml, _yaml_scalar_to_json, _yaml_count_indent,
  _yaml_strip_comment, _yaml_find_colon, _yaml_is_number
}
use ./pipeline.vibe {
  jq_arr
}
test "yaml simple key-value" {
  let data = from_yaml("name: vibe")
  assert(string_equals(json_string(json_get(data, "name")), "vibe"))
}
test "yaml number value" {
  let data = from_yaml("port: 8080")
  assert(eq(json_number(json_get(data, "port")), 8080.0))
}
test "yaml bool and null" {
  let data = from_yaml("flag: true\nval: null")
  assert(json_bool(json_get(data, "flag")))
  assert(json_is_null(json_get(data, "val")))
}
test "yaml nested object" {
  let data = from_yaml("db:\n  host: localhost\n  port: 5432")
  assert(string_equals(json_string(json_get(json_get(data, "db"), "host")), "localhost"))
  assert(eq(json_number(json_get(json_get(data, "db"), "port")), 5432.0))
}
test "yaml list" {
  let data = from_yaml("- a\n- b\n- c")
  assert(json_length(data) == 3)
  assert(string_equals(json_string(json_index(data, 0)), "a"))
  assert(string_equals(json_string(json_index(data, 2)), "c"))
}
test "yaml list in mapping" {
  let data = from_yaml("items:\n  - x\n  - y")
  let items = json_get(data, "items")
  assert(json_length(items) == 2)
}
test "yaml quoted string with colon" {
  let data = from_yaml("msg: 'hello: world'")
  assert(string_equals(json_string(json_get(data, "msg")), "hello: world"))
}
test "yaml comment stripping" {
  let data = from_yaml("key: val # this is a comment")
  assert(string_equals(json_string(json_get(data, "key")), "val"))
}
test "yaml tilde is null" {
  let data = from_yaml("x: ~")
  assert(json_is_null(json_get(data, "x")))
}
test "_yaml_scalar_to_json" {
  assert(string_equals(_yaml_scalar_to_json("true"), "true"))
  assert(string_equals(_yaml_scalar_to_json("false"), "false"))
  assert(string_equals(_yaml_scalar_to_json("null"), "null"))
  assert(string_equals(_yaml_scalar_to_json("42"), "42"))
  assert(string_equals(_yaml_scalar_to_json("hello"), "\"hello\""))
}
test "_yaml_count_indent" {
  assert(_yaml_count_indent("hello") == 0)
  assert(_yaml_count_indent("  hello") == 2)
  assert(_yaml_count_indent("    hello") == 4)
}
test "_yaml_find_colon" {
  assert(_yaml_find_colon("key: val") == 3)
  assert(_yaml_find_colon("'a: b': val") == 6)
  assert(_yaml_find_colon("no colon here") == -1)
}
test "yaml multiple keys" {
  let data = from_yaml("a: 1\nb: 2\nc: 3")
  assert(eq(json_number(json_get(data, "a")), 1.0))
  assert(eq(json_number(json_get(data, "b")), 2.0))
  assert(eq(json_number(json_get(data, "c")), 3.0))
}
