
use ./pipeline.vibe {
  where_entry, names, take_str, take_entries, drop_str, count_str, count_entries, lines, grep,
  basename, dirname, extname, sort_str, uniq, rev_str, head_str, tail_str,
  join_str, split, wc, wc_l, trim, upper, lower, replace, contains_str,
  cut, tr, seq, seq_step, nl, paste, tac, expand,
  starts_with, ends_with, char_at, index_of, last_index_of, len, count, repeat_str,
  pad_left, pad_right, map_str, filter_str,
  jq, jq_str, jq_num, jq_arr
}
use ./types.vibe {
  type FileEntry
}
test "take_str returns first n elements" {
  let xs = [
    "a",
    "b",
    "c",
    "d",
    "e"
  ]
  let result = take_str(xs, 3)
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "a"))
  assert(string_equals(array_get(result, 2), "c"))
}
test "drop_str skips first n elements" {
  let xs = [
    "a",
    "b",
    "c",
    "d",
    "e"
  ]
  let result = drop_str(xs, 2)
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "c"))
}
test "count_str returns length" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  assert(count_str(xs) == 3)
}
test "lines splits text" {
  let text = "a\nb\nc"
  let result = lines(text)
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "a"))
  assert(string_equals(array_get(result, 2), "c"))
}
test "grep filters matching lines" {
  let xs = [
    "hello world",
    "foo bar",
    "hello again"
  ]
  let result = grep(xs, "hello")
  assert(array_length(result) == 2)
}
test "names extracts entry names" {
  let entries = [
    FileEntry::{
      name: "a", path: "/a", is_dir: false
    },
    FileEntry::{
      name: "b", path: "/b", is_dir: true
    }
  ]
  let result = names(entries)
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "a"))
}
test "where_entry filters entries" {
  let entries = [
    FileEntry::{
      name: "dir1", path: "/dir1", is_dir: true
    },
    FileEntry::{
      name: "file1", path: "/file1", is_dir: false
    },
    FileEntry::{
      name: "dir2", path: "/dir2", is_dir: true
    }
  ]
  let dirs = where_entry(entries, (e: FileEntry) -> Bool {
    e.is_dir
  })
  assert(array_length(dirs) == 2)
}
test "pipeline composition with take_str and count_str" {
  let xs = [
    "a",
    "b",
    "c",
    "d",
    "e"
  ]
  let result = xs|>take_str(3)|>count_str()
  assert(result == 3)
}
test "grep with lines pipeline" {
  let text = "error: something\ninfo: ok\nerror: another"
  let result = text|>lines()|>grep("error")
  assert(array_length(result) == 2)
}
test "basename extracts filename" {
  assert(string_equals(basename("/foo/bar/baz.txt"), "baz.txt"))
  assert(string_equals(basename("file.txt"), "file.txt"))
  assert(string_equals(basename("/foo/"), ""))
}
test "dirname extracts directory" {
  assert(string_equals(dirname("/foo/bar/baz.txt"), "/foo/bar"))
  assert(string_equals(dirname("file.txt"), "."))
  assert(string_equals(dirname("/foo"), "/"))
}
test "extname extracts extension" {
  assert(string_equals(extname("/foo/bar.txt"), ".txt"))
  assert(string_equals(extname("file"), ""))
  assert(string_equals(extname(".hidden"), ""))
}
test "sort_str sorts strings" {
  let xs = [
    "c",
    "a",
    "b"
  ]
  let result = sort_str(xs)
  assert(string_equals(array_get(result, 0), "a"))
  assert(string_equals(array_get(result, 1), "b"))
  assert(string_equals(array_get(result, 2), "c"))
}
test "uniq removes consecutive duplicates" {
  let xs = [
    "a",
    "a",
    "b",
    "b",
    "a"
  ]
  let result = uniq(xs)
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "a"))
  assert(string_equals(array_get(result, 1), "b"))
  assert(string_equals(array_get(result, 2), "a"))
}
test "rev_str reverses array" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  let result = rev_str(xs)
  assert(string_equals(array_get(result, 0), "c"))
  assert(string_equals(array_get(result, 1), "b"))
  assert(string_equals(array_get(result, 2), "a"))
}
test "head_str returns first n" {
  let xs = [
    "a",
    "b",
    "c",
    "d"
  ]
  let result = head_str(xs, 2)
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "a"))
}
test "tail_str returns last n" {
  let xs = [
    "a",
    "b",
    "c",
    "d"
  ]
  let result = tail_str(xs, 2)
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "c"))
  assert(string_equals(array_get(result, 1), "d"))
}
test "join_str joins with separator" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  assert(string_equals(join_str(xs, ","), "a,b,c"))
}
test "split splits string" {
  let result = split("a,b,c", ",")
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "a"))
}
test "wc counts words" {
  assert(wc("hello world foo") == 3)
  assert(wc("") == 0)
  assert(wc("  one  ") == 1)
}
test "wc_l counts lines" {
  assert(wc_l("a\nb\nc") == 3)
  assert(wc_l("") == 0)
  assert(wc_l("single") == 1)
}
test "trim removes whitespace" {
  assert(string_equals(trim("  hello  "), "hello"))
}
test "upper converts to uppercase" {
  assert(string_equals(upper("hello"), "HELLO"))
}
test "lower converts to lowercase" {
  assert(string_equals(lower("HELLO"), "hello"))
}
test "replace replaces pattern" {
  assert(string_equals(replace("aXb", "X", "-"), "a-b"))
}
test "contains_str checks substring" {
  assert(contains_str("hello world", "world"))
  assert(not(contains_str("hello", "xyz")))
}
test "cut extracts fields" {
  let xs = [
    "a:b:c",
    "d:e:f"
  ]
  let result = cut(xs, ":", 1)
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "b"))
  assert(string_equals(array_get(result, 1), "e"))
}
test "tr translates characters" {
  assert(string_equals(tr("hello", "elo", "ELO"), "hELLO"))
  assert(string_equals(tr("abc", "a", "x"), "xbc"))
}
test "seq generates number sequence" {
  let result = seq(1, 5)
  assert(array_length(result) == 5)
  assert(string_equals(array_get(result, 0), "1"))
  assert(string_equals(array_get(result, 4), "5"))
}
test "seq_step generates stepped sequence" {
  let result = seq_step(0, 2, 6)
  assert(array_length(result) == 4)
  assert(string_equals(array_get(result, 0), "0"))
  assert(string_equals(array_get(result, 1), "2"))
  assert(string_equals(array_get(result, 3), "6"))
}
test "nl numbers lines" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  let result = nl(xs, "\t")
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "1\ta"))
  assert(string_equals(array_get(result, 2), "3\tc"))
}
test "paste merges two arrays" {
  let xs = [
    "a",
    "b"
  ]
  let ys = [
    "1",
    "2"
  ]
  let result = paste(xs, ys, "\t")
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "a\t1"))
  assert(string_equals(array_get(result, 1), "b\t2"))
}
test "tac reverses lines" {
  assert(string_equals(tac("a\nb\nc"), "c\nb\na"))
}
test "expand replaces tabs" {
  assert(string_equals(expand("\thello", 4), "    hello"))
  assert(string_equals(expand("a\tb", 2), "a  b"))
}
test "starts_with checks prefix" {
  assert(starts_with("hello world", "hello"))
  assert(not(starts_with("hello", "world")))
}
test "ends_with checks suffix" {
  assert(ends_with("hello world", "world"))
  assert(not(ends_with("hello", "world")))
}
test "char_at returns character" {
  assert(string_equals(char_at("hello", 0), "h"))
  assert(string_equals(char_at("hello", 4), "o"))
}
test "index_of finds first occurrence" {
  assert(index_of("hello world", "world") == 6)
  assert(index_of("hello", "xyz") == -1)
}
test "last_index_of finds last occurrence" {
  assert(last_index_of("abcabc", "abc") == 3)
  assert(last_index_of("hello", "xyz") == -1)
}
test "len returns string length" {
  assert(len("hello") == 5)
  assert(len("") == 0)
}
test "count counts occurrences" {
  assert(count("abcabcabc", "abc") == 3)
  assert(count("hello", "xyz") == 0)
}
test "repeat_str repeats string" {
  assert(string_equals(repeat_str("ab", 3), "ababab"))
  assert(string_equals(repeat_str("x", 0), ""))
}
test "pad_left pads string" {
  assert(string_equals(pad_left("hi", 5, " "), "   hi"))
  assert(string_equals(pad_left("hello", 3, " "), "hello"))
}
test "pad_right pads string" {
  assert(string_equals(pad_right("hi", 5, " "), "hi   "))
  assert(string_equals(pad_right("hello", 3, " "), "hello"))
}
test "map_str transforms elements" {
  let xs = [
    "hello",
    "world"
  ]
  let result = map_str(xs, (s: String) -> String {
    string_to_upper(s)
  })
  assert(string_equals(array_get(result, 0), "HELLO"))
  assert(string_equals(array_get(result, 1), "WORLD"))
}
test "filter_str filters elements" {
  let xs = [
    "hello",
    "hi",
    "hey",
    "world"
  ]
  let result = filter_str(xs, (s: String) -> Bool {
    string_starts_with(s, "h")
  })
  assert(array_length(result) == 3)
}
test "jq extracts field as JSON" {
  let result = jq("{\"name\":\"vibe\",\"ver\":1}", "name")
  assert(string_equals(result, "\"vibe\""))
}
test "jq navigates dotted path" {
  assert(string_equals(jq("{\"a\":{\"b\":{\"c\":42}}}", "a.b.c"), "42"))
}
test "jq indexes array with [n]" {
  assert(string_equals(jq("[10,20,30]", "[0]"), "10"))
  assert(string_equals(jq("[10,20,30]", "[2]"), "30"))
}
test "jq returns keys as JSON array" {
  let keys_json = jq("{\"a\":1,\"b\":2}", "keys")
  let keys = jq_arr(keys_json)
  assert(array_length(keys) == 2)
}
test "jq returns values as JSON array" {
  let vals_json = jq("{\"a\":1,\"b\":2}", "values")
  let vals = jq_arr(vals_json)
  assert(array_length(vals) == 2)
}
test "jq returns type" {
  assert(string_equals(jq_str("42", "type"), "number"))
  assert(string_equals(jq_str("\"hello\"", "type"), "string"))
  assert(string_equals(jq_str("null", "type"), "null"))
  assert(string_equals(jq_str("[1,2]", "type"), "array"))
  assert(string_equals(jq_str("{\"a\":1}", "type"), "object"))
}
test "jq returns length" {
  assert(string_equals(jq("[1,2,3]", "length"), "3"))
  assert(string_equals(jq("{\"a\":1,\"b\":2}", "length"), "2"))
}
test "jq with dot prefix" {
  assert(string_equals(jq("{\"x\":1}", ".x"), "1"))
  assert(string_equals(jq("{\"a\":{\"b\":2}}", ".a.b"), "2"))
}
test "jq_str extracts string field" {
  assert(string_equals(jq_str("{\"name\":\"vibe\"}", "name"), "vibe"))
}
test "jq_str with dotted path" {
  assert(string_equals(jq_str("{\"a\":{\"name\":\"deep\"}}", "a.name"), "deep"))
}
test "jq_num extracts number field" {
  assert(eq(jq_num("{\"x\":3.14}", "x"), 3.14))
}
test "jq_arr expands array elements" {
  let result = jq_arr("[1,2,3]")
  assert(array_length(result) == 3)
  assert(string_equals(array_get(result, 0), "1"))
  assert(string_equals(array_get(result, 2), "3"))
}
test "jq pipeline: map over array" {
  let arr = "[{\"name\":\"a\"},{\"name\":\"b\"}]"
  let result = jq_arr(arr)|>map_str((item: String) -> String {
    jq_str(item, "name")
  })
  assert(array_length(result) == 2)
  assert(string_equals(array_get(result, 0), "a"))
  assert(string_equals(array_get(result, 1), "b"))
}
