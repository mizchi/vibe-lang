
use ./commands_extra.vibe {
  tree, which, du, diff_files
}
use ./glob.vibe {
  glob
}
use ./pipeline.vibe {
  grep_re
}

test "tree returns directory listing" {
  let dir = "/tmp/vibe_tree_test_2"
  do {
    fs_mkdir_p(string_concat(dir, "/sub"))
  }
  do {
    fs_write_file(string_concat(dir, "/file.txt"), "x")
  }
  let output = do {
    tree(dir)
  }
  assert(string_contains(output, "file.txt"))
  assert(string_contains(output, "sub"))
}

test "which finds ls" {
  let path = do {
    which("ls")
  }
  assert(string_length(path) > 0)
}

test "du returns output" {
  let result = do {
    du("/tmp")
  }
  assert(array_length(result) > 0)
}

test "glob matches txt files" {
  let dir = "/tmp/vibe_glob_test_3"
  do {
    fs_mkdir_p(dir)
  }
  do {
    fs_write_file(string_concat(dir, "/a.txt"), "a")
  }
  do {
    fs_write_file(string_concat(dir, "/b.txt"), "b")
  }
  do {
    fs_write_file(string_concat(dir, "/c.md"), "c")
  }
  let result = do {
    glob(string_concat(dir, "/*.txt"))
  }
  assert(array_length(result) == 2)
}

test "glob star pattern" {
  let dir = "/tmp/vibe_glob_test_3"
  let result = do {
    glob(string_concat(dir, "/*"))
  }
  assert(array_length(result) >= 3)
}

test "glob question mark" {
  let dir = "/tmp/vibe_glob_test_3"
  let result = do {
    glob(string_concat(dir, "/?.txt"))
  }
  assert(array_length(result) == 2)
}

test "grep_re filters with regex" {
  let input = ["hello world", "foo bar", "hello foo", "baz"]
  let result = do {
    grep_re(input, "^hello")
  }
  assert(array_length(result) == 2)
}

test "diff_files same files returns empty" {
  let a = "/tmp/vibe_diff_same.txt"
  do {
    fs_write_file(a, "line1\nline2\n")
  }
  let result = do {
    diff_files(a, a)
  }
  assert(array_length(result) == 0)
}
