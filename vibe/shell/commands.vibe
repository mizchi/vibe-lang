//# Imports

import ./types.vibe {
  type FileEntry
}

//# Functions

export let cd = (path: String) -> Unit with { Fs } {
  perform Fs::Chdir(path)
}

export let cp = (src: String, dst: String) -> Unit with { Fs } {
  perform Fs::Copy(src, dst)
}

export let mv = (src: String, dst: String) -> Unit with { Fs } {
  perform Fs::Rename(src, dst)
}

export let rm = (path: String) -> Unit with { Fs } {
  perform Fs::Remove(path)
}

export let cat = (path: String) -> String with { Fs } {
  perform Fs::ReadFile(path)
}

export let env = (name: String) -> String with { Env } {
  perform Env::Get(name)
}

export let pwd = () -> String with { Fs } {
  perform Fs::Getcwd
}

export let tee = (text: String, path: String) -> String with { Fs } {
  perform Fs::WriteFile(path, text)
  text
}

export let echo = (text: String) -> String {
  text
}

export let exec = (cmd: String) -> Unit with { Stdout } {
  perform Process::Exec(cmd)
}

export let mkdir = (path: String) -> Unit with { Fs } {
  perform Fs::Mkdir(path)
}

export let print = (text: String) -> Unit with { Stdout } {
  perform Stdout::WriteStream(text)
}

export let touch = (path: String) -> Unit with { Fs } {
  if not(perform Fs::Exists(path)) {
    perform Fs::WriteFile(path, "")
  }
}

export let append = (path: String, content: String) -> Unit with { Fs } {
  perform Fs::Append(path, content)
}

export let env_or = (name: String, fallback: String) -> String with { Env } {
  let value = perform Env::Get(name)
  if value == "" {
    fallback
  } else value
}

export let exists = (path: String) -> Bool with { Fs } {
  perform Fs::Exists(path)
}

export let is_dir = (path: String) -> Bool with { Fs } {
  perform Fs::IsDir(path)
}

export let is_file = (path: String) -> Bool with { Fs } {
  perform Fs::IsFile(path)
}

export let mkdir_p = (path: String) -> Unit with { Fs } {
  perform Fs::MkdirP(path)
}

export let println = (text: String) -> Unit with { Stdout } {
  perform Stdout::WriteStream(text)
  perform Stdout::WriteChar(10)
}

export let realpath = (p: String) -> String with { Env } {
  Path::to_string(Path::resolve(p))
}

export let sleep_ms = (ms: Int) -> Unit with { Async } {
  sleep(ms)
}

export let read_line = () -> String with { Stdin } {
  perform Stdin::ReadStream(4096)
}

export let exec_lines = (cmd: String) -> Array[String] with { Stdout } {
  sh_lines(cmd)
}

export let write_file = (path: String, content: String) -> Unit with { Fs } {
  perform Fs::WriteFile(path, content)
}

let to_file_entry = (name: String, path: String) -> FileEntry with { Fs } {
  FileEntry::{
    name: name,
    path: path,
    is_dir: perform Fs::IsDir(path)
  }
}

let is_navigation_entry = (name: String) -> Bool {
  if name == "." { true } else name == ".."
}

let strip_trailing_slashes = (path: String) -> String {
  let path_len = String::length(path)
  if path_len <= 1 { path }
  else if String::ends_with(path, "/") { path[0:path_len - 1] }
  else path
}

let join_path = (dir: String, name: String) -> String {
  let normalized_dir = strip_trailing_slashes(dir)
  if normalized_dir == "/" { "/\{name}" }
  else { "\{normalized_dir}/\{name}" }
}

let list_entries = (dir: String, include_hidden: Bool) -> Array[FileEntry] with { Fs } {
  let names = perform Fs::ReadDir(dir)
  let result = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    let visible = if include_hidden { true }
    else not(String::starts_with(name, "."))
    if visible {
      ArrayBuilder::push(result, to_file_entry(name, join_path(dir, name)))
    }
    i = i + 1
  }
  ArrayBuilder::freeze(result)
}

export let ls = (dir: String) -> Array[FileEntry] with { Fs } {
  list_entries(dir, false)
}

export let ls_all = (dir: String) -> Array[FileEntry] with { Fs } {
  list_entries(dir, true)
}

let path_basename = (path: String) -> String {
  let normalized_path = strip_trailing_slashes(path)
  let idx = String::last_index_of(normalized_path, "/")
  if idx < 0 { normalized_path }
  else normalized_path[idx + 1:String::length(normalized_path)]
}

export let find = (dir: String) -> Array[FileEntry] with { Fs } {
  let root_dir = strip_trailing_slashes(dir)
  let result = ArrayBuilder::new()
  let queue_paths = ArrayBuilder::new()
  let initial_names = perform Fs::ReadDir(root_dir)
  let mut k = 0
  while k < Array::length(initial_names) {
    let name = Array::get(initial_names, k)
    if not(is_navigation_entry(name)) {
      ArrayBuilder::push(queue_paths, join_path(root_dir, name))
    }
    k = k + 1
  }
  let mut paths = ArrayBuilder::freeze(queue_paths)
  while Array::length(paths) > 0 {
    let next_paths = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(paths) {
      let p = Array::get(paths, i)
      let is_directory = perform Fs::IsDir(p)
      ArrayBuilder::push(result, FileEntry::{
        name: path_basename(p), path: p, is_dir: is_directory
      })
      if is_directory {
        let child_names = perform Fs::ReadDir(p)
        let mut j = 0
        while j < Array::length(child_names) {
          let cname = Array::get(child_names, j)
          if not(is_navigation_entry(cname)) {
            ArrayBuilder::push(next_paths, join_path(p, cname))
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    paths = ArrayBuilder::freeze(next_paths)
  }
  ArrayBuilder::freeze(result)
}
