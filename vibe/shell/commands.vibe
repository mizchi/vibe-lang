
use ./types.vibe {
  type FileEntry
}
export let cd = (path: String) -> Unit with {
  Fs
} {
  do {
    fs_chdir(path)
  }
}
export let cp = (src: String, dst: String) -> Unit with {
  Fs
} {
  do {
    fs_copy(src, dst)
  }
}
export let ls = (dir: String) -> Array[FileEntry] with {
  Fs
} {
  let names = do {
    fs_readdir(dir)
  }
  let result = array_builder()
  let mut i = 0
  while i < array_length(names) {
    let name = array_get(names, i)
    if not(string_starts_with(name, ".")) {
      let entry_path = string_concat(string_concat(dir, "/"), name)
      let is_directory = do {
        fs_is_dir(entry_path)
      }
      array_builder_push(result, FileEntry::{
        name: name, path: entry_path, is_dir: is_directory
      })
    }
    i = i + 1
  }
  array_builder_freeze(result)
}
export let mv = (src: String, dst: String) -> Unit with {
  Fs
} {
  do {
    fs_rename(src, dst)
  }
}
export let rm = (path: String) -> Unit with {
  Fs
} {
  do {
    fs_remove(path)
  }
}
export let cat = (path: String) -> String with {
  Fs
} {
  do {
    fs_read_file(path)
  }
}
export let env = (name: String) -> String with {
  Env
} {
  do {
    env_get(name)
  }
}
export let pwd = () -> String with {
  Fs
} {
  do {
    fs_getcwd()
  }
}
export let echo = (text: String) -> String {
  text
}
export let mkdir = (path: String) -> Unit with {
  Fs
} {
  do {
    fs_mkdir(path)
  }
}
export let touch = (path: String) -> Unit with {
  Fs
} {
  if not(do {
    fs_exists(path)
  }) {
    do {
      fs_write_file(path, "")
    }
  }
}
export let append = (path: String, content: String) -> Unit with {
  Fs
} {
  do {
    fs_append(path, content)
  }
}
export let env_or = (name: String, fallback: String) -> String with {
  Env
} {
  let value = do {
    env_get(name)
  }
  if string_equals(value, "") {
    fallback
  } else {
    value
  }
}
export let exists = (path: String) -> Bool with {
  Fs
} {
  do {
    fs_exists(path)
  }
}
export let is_dir = (path: String) -> Bool with {
  Fs
} {
  do {
    fs_is_dir(path)
  }
}
export let ls_all = (dir: String) -> Array[FileEntry] with {
  Fs
} {
  let names = do {
    fs_readdir(dir)
  }
  let result = array_builder()
  let mut i = 0
  while i < array_length(names) {
    let name = array_get(names, i)
    let entry_path = string_concat(string_concat(dir, "/"), name)
    let is_directory = do {
      fs_is_dir(entry_path)
    }
    array_builder_push(result, FileEntry::{
      name: name, path: entry_path, is_dir: is_directory
    })
    i = i + 1
  }
  array_builder_freeze(result)
}
export let is_file = (path: String) -> Bool with {
  Fs
} {
  do {
    fs_is_file(path)
  }
}
export let mkdir_p = (path: String) -> Unit with {
  Fs
} {
  do {
    fs_mkdir_p(path)
  }
}
export let write_file = (path: String, content: String) -> Unit with {
  Fs
} {
  do {
    fs_write_file(path, content)
  }
}
