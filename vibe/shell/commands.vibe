//# Imports

import ./types.vibe {
  type FileEntry
}

//# Functions

export let cd = (path: String) -> Unit with { Fs } {
  fs_chdir(path)
}

export let cp = (src: String, dst: String) -> Unit with { Fs } {
  fs_copy(src, dst)
}

export let mv = (src: String, dst: String) -> Unit with { Fs } {
  fs_rename(src, dst)
}

export let rm = (path: String) -> Unit with { Fs } {
  fs_remove(path)
}

export let cat = (path: String) -> String with { Fs } {
  fs_read_file(path)
}

export let env = (name: String) -> String with { Env } {
  env_get(name)
}

export let pwd = () -> String with { Fs } {
  fs_getcwd()
}

export let tee = (text: String, path: String) -> String with { Fs } {
  fs_write_file(path, text)
  text
}

export let echo = (text: String) -> String {
  text
}

export let exec = (cmd: String) -> Unit with { Stdout } {
  sh(cmd)
}

export let mkdir = (path: String) -> Unit with { Fs } {
  fs_mkdir(path)
}

export let print = (text: String) -> Unit with { Stdout } {
  stdout_write_stream(text)
}

export let touch = (path: String) -> Unit with { Fs } {
  if not(fs_exists(path)) {
    fs_write_file(path, "")
  }
}

export let append = (path: String, content: String) -> Unit with { Fs } {
  fs_append(path, content)
}

export let env_or = (name: String, fallback: String) -> String with { Env } {
  let value = env_get(name)
  if string_equals(value, "") {
    fallback
  } else value
}

export let exists = (path: String) -> Bool with { Fs } {
  fs_exists(path)
}

export let is_dir = (path: String) -> Bool with { Fs } {
  fs_is_dir(path)
}

export let is_file = (path: String) -> Bool with { Fs } {
  fs_is_file(path)
}

export let mkdir_p = (path: String) -> Unit with { Fs } {
  fs_mkdir_p(path)
}

export let println = (text: String) -> Unit with { Stdout } {
  stdout_write_stream(text)
  stdout_write_char(10)
}

export let realpath = (p: String) -> String with { Env } {
  path_to_string(dynamic_path_resolve(p))
}

export let sleep_ms = (ms: Int) -> Unit with { Async } {
  sleep(ms)
}

export let read_line = () -> String with { Stdin } {
  stdin_read_stream(4096)
}

export let exec_lines = (cmd: String) -> Array[String] with { Stdout } {
  sh_lines(cmd)
}

export let write_file = (path: String, content: String) -> Unit with { Fs } {
  fs_write_file(path, content)
}

let to_file_entry = (name: String, path: String) -> FileEntry with { Fs } {
  FileEntry::{
    name: name,
    path: path,
    is_dir: fs_is_dir(path)
  }
}

let is_navigation_entry = (name: String) -> Bool {
  if string_equals(name, ".") {
    true
  } else string_equals(name, "..")
}

let strip_trailing_slashes = (path: String) -> String {
  let path_len = string_length(path)
  if path_len <= 1 {
    path
  } else if string_ends_with(path, "/") {
    string_substring(path, 0, path_len - 1)
  } else path
}

let join_path = (dir: String, name: String) -> String {
  let normalized_dir = strip_trailing_slashes(dir)
  if string_equals(normalized_dir, "/") {
    string_concat("/", name)
  } else {
    string_concat(string_concat(normalized_dir, "/"), name)
  }
}

let list_entries = (dir: String, include_hidden: Bool) -> Array[FileEntry] with { Fs } {
  let names = fs_readdir(dir)
  let result = array_builder()
  let mut i = 0
  while i < array_length(names) {
    let name = array_get(names, i)
    let visible = if include_hidden {
      true
    } else not(string_starts_with(name, "."))
    if visible {
      let entry_path = join_path(dir, name)
      array_builder_push(result, to_file_entry(name, entry_path))
    }
    i = i + 1
  }
  array_builder_freeze(result)
}

export let ls = (dir: String) -> Array[FileEntry] with { Fs } {
  list_entries(dir, false)
}

export let ls_all = (dir: String) -> Array[FileEntry] with { Fs } {
  list_entries(dir, true)
}

let path_basename = (path: String) -> String {
  let normalized_path = strip_trailing_slashes(path)
  let idx = string_last_index_of(normalized_path, "/")
  if idx < 0 {
    normalized_path
  } else string_substring(normalized_path, idx + 1, string_length(normalized_path))
}

export let find = (dir: String) -> Array[FileEntry] with { Fs } {
  let root_dir = strip_trailing_slashes(dir)
  let result = array_builder()
  let queue_paths = array_builder()
  let initial_names = fs_readdir(root_dir)
  let mut k = 0
  while k < array_length(initial_names) {
    let name = array_get(initial_names, k)
    if not(is_navigation_entry(name)) {
      array_builder_push(queue_paths, join_path(root_dir, name))
    }
    k = k + 1
  }
  let mut paths = array_builder_freeze(queue_paths)
  while array_length(paths) > 0 {
    let next_paths = array_builder()
    let mut i = 0
    while i < array_length(paths) {
      let p = array_get(paths, i)
      let is_directory = fs_is_dir(p)
      array_builder_push(result, FileEntry::{
        name: path_basename(p), path: p, is_dir: is_directory
      })
      if is_directory {
        let child_names = fs_readdir(p)
        let mut j = 0
        while j < array_length(child_names) {
          let cname = array_get(child_names, j)
          if not(is_navigation_entry(cname)) {
            array_builder_push(next_paths, join_path(p, cname))
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    paths = array_builder_freeze(next_paths)
  }
  array_builder_freeze(result)
}
