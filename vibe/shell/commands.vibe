use ./types.vibe { type FileEntry }

declare export let ls: (String) -> Array[FileEntry] with { Fs }
declare export let ls_all: (String) -> Array[FileEntry] with { Fs }
declare export let pwd: () -> String with { Fs }
declare export let cd: (String) -> Unit with { Fs }
declare export let cat: (String) -> String with { Fs }
declare export let echo: (String) -> String
declare export let mkdir: (String) -> Unit with { Fs }
declare export let mkdir_p: (String) -> Unit with { Fs }
declare export let touch: (String) -> Unit with { Fs }

ls = (dir: String) -> Array[FileEntry] with { Fs } {
  let names = do { fs_readdir(dir) }
  let result = array_builder()
  let mut i = 0
  while i < array_length(names) {
    let name = array_get(names, i)
    if not(string_starts_with(name, ".")) {
      let entry_path = string_concat(string_concat(dir, "/"), name)
      let is_directory = do { fs_is_dir(entry_path) }
      array_builder_push(result, FileEntry::{ name: name, path: entry_path, is_dir: is_directory })
    }
    i = i + 1
  }
  array_builder_freeze(result)
}

ls_all = (dir: String) -> Array[FileEntry] with { Fs } {
  let names = do { fs_readdir(dir) }
  let result = array_builder()
  let mut i = 0
  while i < array_length(names) {
    let name = array_get(names, i)
    let entry_path = string_concat(string_concat(dir, "/"), name)
    let is_directory = do { fs_is_dir(entry_path) }
    array_builder_push(result, FileEntry::{ name: name, path: entry_path, is_dir: is_directory })
    i = i + 1
  }
  array_builder_freeze(result)
}

pwd = () -> String with { Fs } {
  do { fs_getcwd() }
}

cd = (path: String) -> Unit with { Fs } {
  do { fs_chdir(path) }
}

cat = (path: String) -> String with { Fs } {
  do { fs_read_file(path) }
}

echo = (text: String) -> String {
  text
}

mkdir = (path: String) -> Unit with { Fs } {
  do { fs_mkdir(path) }
}

mkdir_p = (path: String) -> Unit with { Fs } {
  do { fs_mkdir_p(path) }
}

touch = (path: String) -> Unit with { Fs } {
  if not(do { fs_exists(path) }) {
    do { fs_write_file(path, "") }
  }
}
