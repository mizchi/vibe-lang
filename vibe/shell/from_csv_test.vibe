//# Imports

import ./from_csv.vibe {
  _csv_escape_json, _csv_is_number, _csv_parse_line, from_csv
}

import ./pipeline.vibe {
  jq_arr, jq_str, map_str
}

//# Misc

test "csv basic: name and age" {
  let data = from_csv("name,age\nalice,30\nbob,25")
  assert(Json::length(data) == 2)
  assert(String::equals(Json::string(Json::get(Json::index(data, 0), "name")), "alice"))
  assert(String::equals(Json::string(Json::get(Json::index(data, 1), "name")), "bob"))
}

test "csv number detection" {
  let data = from_csv("name,age\nalice,30")
  let row = Json::index(data, 0)
  assert(eq(Json::number(Json::get(row, "age")), 30.0))
}

test "csv quoted field with comma" {
  let data = from_csv("name,desc\nalice,\"hello, world\"")
  let row = Json::index(data, 0)
  assert(String::equals(Json::string(Json::get(row, "desc")), "hello, world"))
}

test "csv escaped double quote" {
  let data = from_csv("name,desc\nalice,\"say \"\"hi\"\"\"")
  let row = Json::index(data, 0)
  assert(String::equals(Json::string(Json::get(row, "desc")), "say \"hi\""))
}

test "csv empty field" {
  let data = from_csv("a,b,c\n1,,3")
  let row = Json::index(data, 0)
  assert(String::equals(Json::string(Json::get(row, "b")), ""))
}

test "csv pipeline: from_csv |> Json::stringify |> jq_arr |> map_str" {
  let names = Json::stringify(from_csv("name,age\nalice,30\nbob,25"))
  |>jq_arr()
  |>map_str((row: String) -> String {
    jq_str(row, "name")
  })
  assert(Array::length(names) == 2)
  assert(String::equals(Array::get(names, 0), "alice"))
  assert(String::equals(Array::get(names, 1), "bob"))
}

test "_csv_is_number" {
  assert(_csv_is_number("42"))
  assert(_csv_is_number("3.14"))
  assert(_csv_is_number("-1"))
  assert(not(_csv_is_number("")))
  assert(not(_csv_is_number("abc")))
  assert(not(_csv_is_number("1.2.3")))
}

test "_csv_parse_line basic" {
  let fields = _csv_parse_line("a,b,c")
  assert(Array::length(fields) == 3)
  assert(String::equals(Array::get(fields, 0), "a"))
  assert(String::equals(Array::get(fields, 1), "b"))
  assert(String::equals(Array::get(fields, 2), "c"))
}

test "_csv_escape_json" {
  assert(String::equals(_csv_escape_json("hello"), "hello"))
  assert(String::equals(_csv_escape_json("a\"b"), "a\\\"b"))
  assert(String::equals(_csv_escape_json("a\\b"), "a\\\\b"))
}
