//# Imports

import ./from_csv.vibe {
  from_csv, _csv_parse_line, _csv_is_number, _csv_escape_json
}

import ./pipeline.vibe {
  jq_str, jq_arr, map_str
}

//# Misc

test "csv basic: name and age" {
  let data = from_csv("name,age\nalice,30\nbob,25")
  assert(json_length(data) == 2)
  assert(string_equals(json_string(json_get(json_index(data, 0), "name")), "alice"))
  assert(string_equals(json_string(json_get(json_index(data, 1), "name")), "bob"))
}

test "csv number detection" {
  let data = from_csv("name,age\nalice,30")
  let row = json_index(data, 0)
  assert(eq(json_number(json_get(row, "age")), 30.0))
}

test "csv quoted field with comma" {
  let data = from_csv("name,desc\nalice,\"hello, world\"")
  let row = json_index(data, 0)
  assert(string_equals(json_string(json_get(row, "desc")), "hello, world"))
}

test "csv escaped double quote" {
  let data = from_csv("name,desc\nalice,\"say \"\"hi\"\"\"")
  let row = json_index(data, 0)
  assert(string_equals(json_string(json_get(row, "desc")), "say \"hi\""))
}

test "csv empty field" {
  let data = from_csv("a,b,c\n1,,3")
  let row = json_index(data, 0)
  assert(string_equals(json_string(json_get(row, "b")), ""))
}

test "csv pipeline: from_csv |> to_json |> jq_arr |> map_str" {
  let names = to_json(from_csv("name,age\nalice,30\nbob,25"))
  |>jq_arr()
  |>map_str((row: String) -> String {
    jq_str(row, "name")
  })
  assert(array_length(names) == 2)
  assert(string_equals(array_get(names, 0), "alice"))
  assert(string_equals(array_get(names, 1), "bob"))
}

test "_csv_is_number" {
  assert(_csv_is_number("42"))
  assert(_csv_is_number("3.14"))
  assert(_csv_is_number("-1"))
  assert(not(_csv_is_number("")))
  assert(not(_csv_is_number("abc")))
  assert(not(_csv_is_number("1.2.3")))
}

test "_csv_parse_line basic" {
  let fields = _csv_parse_line("a,b,c")
  assert(array_length(fields) == 3)
  assert(string_equals(array_get(fields, 0), "a"))
  assert(string_equals(array_get(fields, 1), "b"))
  assert(string_equals(array_get(fields, 2), "c"))
}

test "_csv_escape_json" {
  assert(string_equals(_csv_escape_json("hello"), "hello"))
  assert(string_equals(_csv_escape_json("a\"b"), "a\\\"b"))
  assert(string_equals(_csv_escape_json("a\\b"), "a\\\\b"))
}
