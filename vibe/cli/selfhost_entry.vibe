//# Imports

import ./selfhost.vibe {
  selfhost_cli_main
}

//# Effects

effect Profiler {
  NowUs -> Int
}

//# Functions

export let cli_main: () -> Int with { Fs, Env } = () -> {
  handle {
    handle {
      selfhost_cli_main()
    } with Profiler {
      NowUs => resume(0)
    }
  } with Error {
    Throw(_) => 1
  }
}
