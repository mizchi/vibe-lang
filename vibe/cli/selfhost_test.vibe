//# Imports

import ./selfhost.vibe {
  parse_build_args, parse_check_args, parse_compile_args, parse_compile_lite_args,
  selfhost_cli_build_args, selfhost_cli_check_args, selfhost_cli_compile_args,
  selfhost_cli_compile_lite_args
}

//# Functions

let string_to_bytes: (String) -> Bytes = (s) -> {
  let out = Array::slice([
    0
  ], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

//# Misc

test "selfhost cli parses compile-lite command args" {
  let (input_path, output_path, entry_name, mode, in_memory) = parse_compile_lite_args([
    "compile-lite", "--wasm-linear", "--entry", "answer", "--no-dce", "main.vibe", "-o", "out.wasm"
  ])
  assert(input_path == "main.vibe")
  assert(output_path == "out.wasm")
  assert(entry_name == "answer")
  assert(mode == "no-dce")
  assert(!in_memory)
}

test "selfhost cli compile-lite command writes wasm" {
  let main_path = "/tmp/vibe_selfhost_cli_compile_lite_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_compile_lite_out.wasm"
  let source = "export let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_compile_lite_args([
    "compile-lite", "--wasm", "--entry", "answer", main_path, "-o", output_path
  ])
  assert(status == 0)
  assert(Fs::exists(output_path))
}

test "selfhost cli parses compile command args" {
  let (input_path, output_path, entry_name, mode) = parse_compile_args([
    "compile", "--wasm-linear", "--no-dce", "main.vibe", "-o", "out.wasm"
  ])
  assert(input_path == "main.vibe")
  assert(output_path == "out.wasm")
  assert(entry_name == "_start")
  assert(mode == "no-dce")
}

test "selfhost cli compile command writes wasm" {
  let main_path = "/tmp/vibe_selfhost_cli_compile_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_compile_out.wasm"
  let source = "export let _start: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_compile_args([
    "compile", "--wasm", main_path, "-o", output_path
  ])
  assert(status == 0)
  assert(Fs::exists(output_path))
}

test "selfhost cli parses build command args" {
  let (input_path, output_path, entry_name, mode) = parse_build_args([
    "build", "--debug", "main.vibe", "--out", "out.wasm"
  ])
  assert(input_path == "main.vibe")
  assert(output_path == "out.wasm")
  assert(entry_name == "_start")
  assert(mode == "debug")
}

test "selfhost cli build release command writes wasm" {
  let main_path = "/tmp/vibe_selfhost_cli_build_main.vibe"
  let output_path = "/tmp/vibe_selfhost_cli_build_out.wasm"
  let source = "export let _start: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_build_args([
    "build", "--release", main_path, "-o", output_path
  ])
  assert(status == 0)
  assert(Fs::exists(output_path))
}

test "selfhost cli parses check command args" {
  let paths = parse_check_args([
    "check", "--profile-tsv", "/tmp/check.tsv", "a.vibe", "b.vibe"
  ])
  assert(Array::length(paths) == 2)
  assert(Array::get(paths, 0) == "a.vibe")
  assert(Array::get(paths, 1) == "b.vibe")
}

test "selfhost cli check command accepts valid file" {
  let main_path = "/tmp/vibe_selfhost_cli_check_main.vibe"
  let source = "let answer: () -> Int = () -> { 40 + 2 }\n"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let status = selfhost_cli_check_args([
    "check", main_path
  ])
  assert(status == 0)
}
