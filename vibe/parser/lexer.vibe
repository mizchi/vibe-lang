//# Imports

import ./token.vibe {
  Token
}

//# Functions

let is_ws = (c: Int) -> Bool {
  c == ' ' || c == '\n' || c == '\t' || c == '\r'
}

let is_alpha = (c: Int) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

let is_digit = (c: Int) -> Bool {
  c >= '0' && c <= '9'
}

let is_alnum = (c: Int) -> Bool {
  is_alpha(c) || is_digit(c)
}

let lex_char = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {
  let start = i + 1
  if start >= len {
    throw("unterminated char literal")
  }
  let c = String::char_code_at(s, start)
  if c == '\\' {
    let esc_pos = start + 1
    if esc_pos >= len {
      throw("unterminated char escape")
    }
    let esc = String::char_code_at(s, esc_pos)
    let val = if esc == 'n' {
      10
    }
    else if esc == 't' {
      9
    }
    else if esc == 'r' {
      13
    }
    else if esc == '\\' {
      92
    }
    else if esc == '\'' {
      39
    }
    else if esc == '0' {
      0
    }
    else throw("invalid char escape")
    let close = esc_pos + 1
    if close >= len || String::char_code_at(s, close) != '\'' {
      throw("expected closing quote for char literal")
    };
    (TInt(val), close + 1)
  } else {
    let close = start + 1
    if close >= len || String::char_code_at(s, close) != '\'' {
      throw("expected closing quote for char literal")
    };
    (TInt(c), close + 1)
  }
}

let is_hex_digit = (c: Int) -> Bool {
  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

let keyword_lookup = (word: String) -> Option[Token] {
  let len = String::length(word)
  if len == 2 {
    let c0 = String::char_code_at(word, 0)
    if c0 == 'f' {
      if word == "fn" {
        Some(TIdent("fn"))
      } else None
    } else if c0 == 'i' {
      if word == "if" {
        Some(TIf)
      } else if word == "in" {
        Some(TIn)
      } else None
    } else if c0 == 'd' {
      if word == "do" {
        Some(TDo)
      } else None
    } else if c0 == 'a' {
      if word == "as" {
        Some(TAs)
      } else None
    } else None
  } else if len == 3 {
    let c0 = String::char_code_at(word, 0)
    if c0 == 'l' {
      if word == "let" {
        Some(TLet)
      } else None
    } else if c0 == 'r' {
      if word == "rec" {
        Some(TRec)
      } else None
    } else if c0 == 'm' {
      if word == "mut" {
        Some(TMut)
      } else None
    } else if c0 == 'f' {
      if word == "for" {
        Some(TFor)
      } else None
    } else None
  } else if len == 4 {
    let c0 = String::char_code_at(word, 0)
    if c0 == 'e' {
      if word == "else" {
        Some(TElse)
      } else if word == "enum" {
        Some(TEnum)
      } else None
    } else if c0 == 't' {
      if word == "true" {
        Some(TIdent("true"))
      } else if word == "type" {
        Some(TType)
      } else if word == "test" {
        Some(TTest)
      } else None
    } else if c0 == 'w' {
      if word == "with" { Some(TWith) } else None
    } else if c0 == 'l' {
      if word == "loop" {
        Some(TLoop)
      } else None
    } else if c0 == 'o' {
      if word == "open" {
        Some(TOpen)
      } else None
    } else if c0 == 'i' {
      if word == "impl" {
        Some(TImpl)
      } else None
    } else None
  } else if len == 5 {
    let c0 = String::char_code_at(word, 0)
    if c0 == 'f' {
      if word == "false" {
        Some(TIdent("false"))
      } else None
    } else if c0 == 'm' {
      if word == "match" {
        Some(TMatch)
      } else None
    } else if c0 == 't' {
      if word == "trait" {
        Some(TTrait)
      } else if word == "throw" {
        Some(TThrow)
      } else None
    } else if c0 == 'w' {
      if word == "while" {
        Some(TWhile)
      } else None
    } else if c0 == 'b' {
      if word == "break" {
        Some(TBreak)
      } else if word == "bench" {
        Some(TBench)
      } else None
    } else if c0 == 'r' {
      if word == "raise" {
        Some(TRaise)
      } else None
    } else if c0 == 'y' {
      if word == "yield" {
        Some(TYield)
      } else None
    } else None
  } else if len == 6 {
    let c0 = String::char_code_at(word, 0)
    if c0 == 's' {
      if word == "struct" {
        Some(TStruct)
      } else None
    } else if c0 == 'e' {
      if word == "export" {
        Some(TExport)
      } else None
    } else if c0 == 'r' {
      if word == "return" {
        Some(TReturn)
      } else None
    } else if c0 == 'h' {
      if word == "handle" {
        Some(THandle)
      } else None
    } else if c0 == 'm' {
      if word == "module" {
        Some(TModule)
      } else None
    } else if c0 == 'd' {
      if word == "derive" {
        Some(TDerive)
      } else None
    } else if c0 == 'i' {
      if word == "import" {
        Some(TImport)
      } else None
    } else None
  } else if len == 7 {
    if word == "declare" {
      Some(TDeclare)
    } else None
  } else if len == 8 {
    let c0 = String::char_code_at(word, 0)
    if c0 == 'c' {
      if word == "continue" {
        Some(TContinue)
      } else None
    } else if c0 == 's' {
      if word == "suberror" {
        Some(TSuberror)
      } else None
    } else None
  } else None
}

let rec scan_ident_end = (s: String, len: Int, i: Int) -> Int {
  if i < len && is_alnum(String::char_code_at(s, i)) {
    scan_ident_end(s, len, i + 1)
  } else i
}

let lex_ident = (s: String, len: Int, i: Int) -> (Token, Int) {
  let end = scan_ident_end(s, len, i)
  let word = s[i: end]
  if word == "r" && end < len && String::char_code_at(s, end) == '#' {
    let ri_start = end + 1
    let ri_end = scan_ident_end(s, len, ri_start)
    (TIdent(s[ri_start: ri_end]), ri_end)
  }
  else if word == "r" && end < len && String::char_code_at(s, end) == '"' {
    let mut ri = end + 1
    let mut raw_acc = ""
    while ri < len && String::char_code_at(s, ri) != '"' {
      raw_acc = String::concat(raw_acc, String::from_char_code(String::char_code_at(s, ri)))
      ri = ri + 1
    }
    if ri >= len {
      (TString(raw_acc), ri)
    } else {
      (TString(raw_acc), ri + 1)
    }
  } else {
    match keyword_lookup(word) {
      Some(tok) => if word == "true" || word == "false" {
        (TIdent(word), end)
      } else (tok, end),
      None => (TIdent(word), end)
    }
  }
}

let rec scan_digits_end = (s: String, len: Int, i: Int) -> Int {
  if i < len && is_digit(String::char_code_at(s, i)) {
    scan_digits_end(s, len, i + 1)
  } else i
}

let rec scan_interp_end = (s: String, len: Int, idx: Int, depth: Int) -> Int with { Error } {
  if idx >= len {
    throw("unterminated string interpolation")
  }
  let c = String::char_code_at(s, idx)
  if c == '{' {
    scan_interp_end(s, len, idx + 1, depth + 1)
  } else if c == '}' {
    if depth == 1 {
      idx
    } else scan_interp_end(s, len, idx + 1, depth - 1)
  } else scan_interp_end(s, len, idx + 1, depth)
}

let rec lex_string_go = (s: String, len: Int, idx: Int, start: Int, acc: String, has_interp: Bool, parts: ArrayBuilder[String]) -> (Token, Int)with { Error } {
  {
    if idx >= len {
      throw("unterminated string")
    }
    let c = String::char_code_at(s, idx)
    if c == '"' {
      let chunk = s[start: idx]
      let value = String::concat(acc, chunk)
      if has_interp {
        ArrayBuilder::push(parts, value)
        (TStringInterp(ArrayBuilder::freeze(parts)), idx + 1)
      } else {
        (TString(value), idx + 1)
      }
    } else if c == '\\' {
      let chunk = s[start: idx]
      let next = idx + 1
      if next >= len {
        throw("unterminated string escape")
      }
      let esc = String::char_code_at(s, next)
      if esc == '{' || esc == '(' {
        let close_char = if esc == '{' {
          '}'
        } else ')'
        ArrayBuilder::push(parts, String::concat(acc, chunk))
        let interp_end = if esc == '{' {
          scan_interp_end(s, len, next + 1, 1)
        } else {
          let mut ie = next + 1
          let mut depth = 1
          while ie < len && depth > 0 {
            let ic = String::char_code_at(s, ie)
            if ic == '(' {
              depth = depth + 1
            }
            else if ic == ')' {
              depth = depth - 1
            }
            ie = ie + 1
          }
          ie - 1
        }
        let expr_src = s[next + 1: interp_end]
        ArrayBuilder::push(parts, expr_src)
        lex_string_go(s, len, interp_end + 1, interp_end + 1, "", true, parts)
      } else {
        let escaped = if esc == '"' {
          "\""
        }
        else if esc == '\\' {
          "\\"
        }
        else if esc == 'n' {
          "\n"
        }
        else if esc == 't' {
          "\t"
        }
        else if esc == 'r' {
          String::from_char_code(13)
        }
        else if esc == '0' {
          String::from_char_code(0)
        }
        else throw("invalid escape sequence")
        lex_string_go(s, len, next + 1, next + 1, String::concat(String::concat(acc, chunk), escaped), has_interp, parts)
      }
    } else {
      lex_string_go(s, len, idx + 1, start, acc, has_interp, parts)
    }
  }
}

let lex_string = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {
  lex_string_go(s, len, i + 1, i + 1, "", false, ArrayBuilder::new())
}

let rec parse_frac_digits = (s: String, len: Int, i: Int, acc: Double, scale: Double) -> (Double, Int) {
  if i < len {
    let c = String::char_code_at(s, i)
    if is_digit(c) {
      parse_frac_digits(s, len, i + 1, acc + Int::to_double(c - 48) / scale, scale * 10.0)
    } else (acc, i)
  } else (acc, i)
}

let rec skip_until_newline = (s: String, len: Int, i: Int) -> Int {
  if i < len {
    if String::char_code_at(s, i) == '\n' {
      i + 1
    } else skip_until_newline(s, len, i + 1)
  } else i
}

let rec skip_ws = (s: String, len: Int, i: Int) -> Int {
  if i < len {
    let c = String::char_code_at(s, i)
    if is_ws(c) {
      skip_ws(s, len, i + 1)
    } else if c == '/' && i + 1 < len && String::char_code_at(s, i + 1) == '/' {
      let after_comment = skip_until_newline(s, len, i + 2)
      skip_ws(s, len, after_comment)
    } else i
  } else i
}

let rec scan_hex_digits_end = (s: String, len: Int, i: Int) -> Int {
  if i < len && is_hex_digit(String::char_code_at(s, i)) {
    scan_hex_digits_end(s, len, i + 1)
  } else i
}

let parse_hex_from_string = (s: String) -> Int {
  let len = String::length(s)
  let mut i = 0
  let mut acc = 0
  while i < len {
    let c = String::char_code_at(s, i)
    let digit = if c >= '0' && c <= '9' {
      c - 48
    } else if c >= 'a' && c <= 'f' {
      c - 87
    } else c - 55
    acc = acc * 16 + digit
    i = i + 1
  }
  acc
}

let parse_int_from_string = (s: String) -> Int {
  let len = String::length(s)
  let mut i = 0
  let mut acc = 0
  while i < len {
    let c = String::char_code_at(s, i)
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

let lex_decimal = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {
  let int_end = scan_digits_end(s, len, i)
  if int_end == i {
    throw("expected digit")
  }
  if int_end < len && String::char_code_at(s, int_end) == '.' {
    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {
      let int_str = s[i: int_end]
      let int_val = Int::to_double(parse_int_from_string(int_str))
      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);
      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {
        (TFloat(int_val + frac_val), frac_end + 1)
      } else {
        (TFloat(int_val + frac_val), frac_end)
      }
    } else {
      let int_str = s[i: int_end];
      (TInt(parse_int_from_string(int_str)), int_end)
    }
  } else {
    let int_str = s[i: int_end];
    (TInt(parse_int_from_string(int_str)), int_end)
  }
}

let lex_number = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {
  if i + 1 < len && String::char_code_at(s, i) == '0' {
    let next_c = String::char_code_at(s, i + 1)
    if next_c == 'x' || next_c == 'X' {
      let hex_start = i + 2
      let hex_end = scan_hex_digits_end(s, len, hex_start)
      if hex_end == hex_start {
        throw("expected hex digit after 0x")
      }
      let hex_str = s[hex_start: hex_end];
      (TInt(parse_hex_from_string(hex_str)), hex_end)
    } else lex_decimal(s, len, i)
  } else lex_decimal(s, len, i)
}

export let lex = (source: String) -> Array[Token] with { Error } {
  let len = String::length(source)
  {
    let b = ArrayBuilder::new()
    let mut pos = skip_ws(source, len, 0)
    while pos < len {
      let c = String::char_code_at(source, pos)
      let (tok, next) = if is_alpha(c) {
        lex_ident(source, len, pos)
      } else if is_digit(c) {
        lex_number(source, len, pos)
      } else if c == '"' {
        lex_string(source, len, pos)
      } else if c == '+' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TPlusEq, pos + 2)
        } else (TPlus, pos + 1)
      } else if c == '-' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {
          (TThinArrow, pos + 2)
        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TMinusEq, pos + 2)
        } else (TMinus, pos + 1)
      } else if c == '*' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TStarEq, pos + 2)
        } else (TStar, pos + 1)
      } else if c == '/' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TSlashEq, pos + 2)
        } else (TSlash, pos + 1)
      } else if c == '%' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TPercentEq, pos + 2)
        } else (TPercent, pos + 1)
      } else if c == '=' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TEqEq, pos + 2)
        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {
          (TArrow, pos + 2)
        } else (TEq, pos + 1)
      } else if c == '!' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TNeq, pos + 2)
        } else (TNot, pos + 1)
      } else if c == '<' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TLte, pos + 2)
        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {
          (TLShift, pos + 2)
        } else (TLt, pos + 1)
      } else if c == '>' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
          (TGte, pos + 2)
        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {
          (TRShift, pos + 2)
        } else (TGt, pos + 1)
      } else if c == '&' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {
          (TAnd, pos + 2)
        } else (TBitAnd, pos + 1)
      } else if c == '|' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {
          (TOr, pos + 2)
        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {
          (TPipeGt, pos + 2)
        } else (TBitOr, pos + 1)
      } else if c == '^' {
        (TBitXor, pos + 1)
      } else if c == '(' {
        (TLParen, pos + 1)
      } else if c == ')' {
        (TRParen, pos + 1)
      } else if c == '{' {
        (TLBrace, pos + 1)
      } else if c == '}' {
        (TRBrace, pos + 1)
      } else if c == '[' {
        (TLBracket, pos + 1)
      } else if c == ']' {
        (TRBracket, pos + 1)
      } else if c == ',' {
        (TComma, pos + 1)
      } else if c == ';' {
        (TSemicolon, pos + 1)
      } else if c == '.' {
        if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {
          (TDotDotDot, pos + 3)
        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {
          (TDotDot, pos + 2)
        } else (TDot, pos + 1)
      } else if c == ':' {
        if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {
          (TDoubleColon, pos + 2)
        } else (TColon, pos + 1)
      } else if c == '#' {
        (THash, pos + 1)
      } else if c == '~' {
        (TTilde, pos + 1)
      } else if c == '?' {
        (TQuestion, pos + 1)
      } else if c == '\'' {
        lex_char(source, len, pos)
      } else throw(String::concat("unexpected character: ", String::from_char_code(c)))
      ArrayBuilder::push(b, tok)
      pos = skip_ws(source, len, next)
    }
    ArrayBuilder::push(b, TEof)
    ArrayBuilder::freeze(b)
  }
}

export let lex_ok = (source: String) -> Bool {
  handle {
    let _ = lex(source)
    true
  } with Error {
    Throw(_) => false
  }
}
