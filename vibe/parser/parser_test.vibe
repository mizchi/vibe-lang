//# Imports
import parser/index.vibe { lex, parse, print_expr, parse_program }
//# Misc
test "lex" { assert(Array::length(lex("1 + 2")) > 0) }
test "parse expr" {
  let text = print_expr(parse(lex("1 + 2")))
  assert(String::contains(text, "1"))
}
test "parse program" { assert(Array::length(parse_program(lex("let x = 42"))) > 0) }
