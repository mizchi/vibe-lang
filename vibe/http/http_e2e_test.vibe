//# Imports

use ./http.vibe {
  request, response_status, response_body, close
}

//# Misc

test "http GET request" {
  let h = request("GET", "http://127.0.0.1:18280/hello", "", "")
  let status = response_status(h)
  assert(status == 200)
  let body = response_body(h)
  assert(body == "hello")
  close(h)
}

test "http POST echo" {
  let h = request("POST", "http://127.0.0.1:18280/echo", "", "ping from vibe")
  let status = response_status(h)
  assert(status == 200)
  let body = response_body(h)
  assert(body == "ping from vibe")
  close(h)
}

test "http 404 response" {
  let h = request("GET", "http://127.0.0.1:18280/nonexistent", "", "")
  let status = response_status(h)
  assert(status == 404)
  close(h)
}
