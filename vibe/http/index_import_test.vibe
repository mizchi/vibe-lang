//# Imports

import .{
  HttpRequest, HttpResponse, Http::accept, Http::close, Http::listen, Http::request, Http::request_body, Http::request_header, Http::request_method, Http::request_url, http_request_with, Http::respond, http_respond_with, Http::response_body, Http::response_header, Http::response_status
}

//# Misc

test "http index exports canonical aliases" {
  let _ = Http::close
  let _ = Http::accept
  let _ = Http::listen
  let _ = Http::request
  let _ = Http::respond
  let _ = Http::request_url
  let _ = Http::request_body
  let _ = Http::response_body
  let _ = Http::request_header
  let _ = Http::request_method
  let _ = Http::response_header
  let _ = Http::response_status
  let _ = http_request_with
  let _ = http_respond_with
  assert(true)
}
