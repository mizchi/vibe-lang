//# Imports

import .{
  HttpRequest, HttpResponse, http_close, http_accept, http_listen, http_request, http_respond, http_request_url, http_request_body, http_response_body, http_request_header, http_request_method, http_response_header, http_response_status, http_request_with, http_respond_with
}

//# Misc

test "http index exports canonical aliases" {
  let _ = http_close
  let _ = http_accept
  let _ = http_listen
  let _ = http_request
  let _ = http_respond
  let _ = http_request_url
  let _ = http_request_body
  let _ = http_response_body
  let _ = http_request_header
  let _ = http_request_method
  let _ = http_response_header
  let _ = http_response_status
  let _ = http_request_with
  let _ = http_respond_with
  assert(true)
}
