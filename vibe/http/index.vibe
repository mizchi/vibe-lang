export let version = "0.1.0"

export ./http.vibe {
  close, accept, listen, request, respond, request_url, request_body, response_body,
  request_header, request_method, response_header, response_status
}

export ./high_level.vibe {
  HttpRequest, HttpResponse, headers_empty, headers_get, headers_get_or, headers_set,
  headers_to_wire, make_request, make_response, status_ok, status_created, status_not_found,
  status_internal_server_error, status_is_success, status_is_client_error, status_is_server_error,
  request_with, respond_with
}

// Canonical collision-safe aliases
export let http_close = close
export let http_accept = accept
export let http_listen = listen
export let http_request = request
export let http_respond = respond
export let http_request_url = request_url
export let http_request_body = request_body
export let http_response_body = response_body
export let http_request_header = request_header
export let http_request_method = request_method
export let http_response_header = response_header
export let http_response_status = response_status
export let http_request_with = request_with
export let http_respond_with = respond_with
