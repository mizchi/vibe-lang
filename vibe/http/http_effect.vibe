//# Types

export effect HttpServer {
  Listen(Int) -> Int;
  Accept(Int) -> Int;
  Respond(Int, Int, String, String) -> Unit;
  Close(Int) -> Unit
}

export effect HttpClient {
  Request(String, String, String, String) -> Int;
  ResponseStatus(Int) -> Int;
  ResponseHeader(Int, String) -> String;
  ResponseBody(Int) -> String
}

export effect HttpIncoming {
  RequestMethod(Int) -> String;
  RequestUrl(Int) -> String;
  RequestHeader(Int, String) -> String;
  RequestBody(Int) -> String
}
