//# Functions

export let close = (fd: Int) -> Unit {
  perform Http::Close(fd)
}

export let accept = (server_fd: Int) -> Int {
  perform Http::Accept(server_fd)
}

export let listen = (port: Int) -> Int {
  perform Http::Listen(port)
}

export let request = (method: String, url: String, headers: String, body: String) -> Int {
  perform Http::Request(method, url, headers, body)
}

export let respond = (req_fd: Int, status: Int, headers: String, body: String) -> Unit {
  perform Http::Respond(req_fd, status, headers, body)
}

export let request_url = (fd: Int) -> String {
  perform Http::RequestUrl(fd)
}

export let request_body = (fd: Int) -> String {
  perform Http::RequestBody(fd)
}

export let response_body = (fd: Int) -> String {
  perform Http::ResponseBody(fd)
}

export let request_header = (fd: Int, name: String) -> String {
  perform Http::RequestHeader(fd, name)
}

export let request_method = (fd: Int) -> String {
  perform Http::RequestMethod(fd)
}

export let response_header = (fd: Int, name: String) -> String {
  perform Http::ResponseHeader(fd, name)
}

export let response_status = (fd: Int) -> Int {
  perform Http::ResponseStatus(fd)
}
