
export let close = (fd: Int) -> Unit with { Net } {
  do {
    http_close(fd)
  }
}
export let accept = (server_fd: Int) -> Int with { Net } {
  do {
    http_accept(server_fd)
  }
}
export let listen = (port: Int) -> Int with { Net } {
  do {
    http_listen(port)
  }
}
export let request = (method: String, url: String, headers: String, body: String) -> Int with { Net } {
  do {
    http_request(method, url, headers, body)
  }
}
export let respond = (req_fd: Int, status: Int, headers: String, body: String) -> Unit with { Net } {
  do {
    http_respond(req_fd, status, headers, body)
  }
}
export let request_url = (fd: Int) -> String with { Net } {
  do {
    http_request_url(fd)
  }
}
export let request_body = (fd: Int) -> String with { Net } {
  do {
    http_request_body(fd)
  }
}
export let response_body = (fd: Int) -> String with { Net } {
  do {
    http_response_body(fd)
  }
}
export let request_header = (fd: Int, name: String) -> String with { Net } {
  do {
    http_request_header(fd, name)
  }
}
export let request_method = (fd: Int) -> String with { Net } {
  do {
    http_request_method(fd)
  }
}
export let response_header = (fd: Int, name: String) -> String with { Net } {
  do {
    http_response_header(fd, name)
  }
}
export let response_status = (fd: Int) -> Int with { Net } {
  do {
    http_response_status(fd)
  }
}
export {
  close, accept, listen, request, respond, request_url, request_body, response_body, request_header, request_method, response_header, response_status
}
