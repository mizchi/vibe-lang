
// HTTP Client
declare export let request: (String, String, String, String) -> Int with { Net }
declare export let response_status: (Int) -> Int with { Net }
declare export let response_header: (Int, String) -> String with { Net }
declare export let response_body: (Int) -> String with { Net }
declare export let close: (Int) -> Unit with { Net }

// HTTP Server
declare export let listen: (Int) -> Int with { Net }
declare export let accept: (Int) -> Int with { Net }
declare export let request_method: (Int) -> String with { Net }
declare export let request_url: (Int) -> String with { Net }
declare export let request_header: (Int, String) -> String with { Net }
declare export let request_body: (Int) -> String with { Net }
declare export let respond: (Int, Int, String, String) -> Unit with { Net }

request = (method: String, url: String, headers: String, body: String) -> Int with { Net } {
  do {
    http_request(method, url, headers, body)
  }
}
response_status = (handle: Int) -> Int with { Net } {
  do {
    http_response_status(handle)
  }
}
response_header = (handle: Int, name: String) -> String with { Net } {
  do {
    http_response_header(handle, name)
  }
}
response_body = (handle: Int) -> String with { Net } {
  do {
    http_response_body(handle)
  }
}
close = (handle: Int) -> Unit with { Net } {
  do {
    http_close(handle)
  }
}
listen = (port: Int) -> Int with { Net } {
  do {
    http_listen(port)
  }
}
accept = (server_handle: Int) -> Int with { Net } {
  do {
    http_accept(server_handle)
  }
}
request_method = (handle: Int) -> String with { Net } {
  do {
    http_request_method(handle)
  }
}
request_url = (handle: Int) -> String with { Net } {
  do {
    http_request_url(handle)
  }
}
request_header = (handle: Int, name: String) -> String with { Net } {
  do {
    http_request_header(handle, name)
  }
}
request_body = (handle: Int) -> String with { Net } {
  do {
    http_request_body(handle)
  }
}
respond = (req_handle: Int, status: Int, headers: String, body: String) -> Unit with { Net } {
  do {
    http_respond(req_handle, status, headers, body)
  }
}
