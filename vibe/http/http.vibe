
export let close = (handle: Int) -> Unit with {
  Net
} {
  do {
    http_close(handle)
  }
}
export let accept = (server_handle: Int) -> Int with {
  Net
} {
  do {
    http_accept(server_handle)
  }
}
export let listen = (port: Int) -> Int with {
  Net
} {
  do {
    http_listen(port)
  }
}
export let request = (method: String, url: String, headers: String, body: String) -> Int with {
  Net
} {
  do {
    http_request(method, url, headers, body)
  }
}
export let respond = (req_handle: Int, status: Int, headers: String, body: String) -> Unit with {
  Net
} {
  do {
    http_respond(req_handle, status, headers, body)
  }
}
export let request_url = (handle: Int) -> String with {
  Net
} {
  do {
    http_request_url(handle)
  }
}
export let request_body = (handle: Int) -> String with {
  Net
} {
  do {
    http_request_body(handle)
  }
}
export let response_body = (handle: Int) -> String with {
  Net
} {
  do {
    http_response_body(handle)
  }
}
export let request_header = (handle: Int, name: String) -> String with {
  Net
} {
  do {
    http_request_header(handle, name)
  }
}
export let request_method = (handle: Int) -> String with {
  Net
} {
  do {
    http_request_method(handle)
  }
}
export let response_header = (handle: Int, name: String) -> String with {
  Net
} {
  do {
    http_response_header(handle, name)
  }
}
export let response_status = (handle: Int) -> Int with {
  Net
} {
  do {
    http_response_status(handle)
  }
}
