// Collection operations as effects: filter/map/reduce via perform
// Instead of passing callback functions, use effects for each step.

export effect Predicate {
  Test(Int) -> Bool
}

export effect Transform {
  Apply(Int) -> Int
}

// Filter array using Predicate effect
export let filter_effect = (arr: Array[Int]) -> Array[Int] with { Predicate } {
  let b = ArrayBuilder::new()
  for x in arr {
    if perform Predicate::Test(x) {
      ArrayBuilder::push(b, x)
    }
  }
  ArrayBuilder::freeze(b)
}

// Map array using Transform effect
export let map_effect = (arr: Array[Int]) -> Array[Int] with { Transform } {
  let b = ArrayBuilder::new()
  for x in arr {
    ArrayBuilder::push(b, perform Transform::Apply(x))
  }
  ArrayBuilder::freeze(b)
}
