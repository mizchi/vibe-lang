//# Imports

import ./index.vibe {
  compile, count, find, find_all, find_match, is_match, replace_all, replace_first, split, test_match
}

//# Misc

bench "regexp/compile_simple" {
  let _ = compile("hello")
}

bench "regexp/compile_complex" {
  let _ = compile("(foo|bar)+[0-9]*\\.\\w+")
}

bench "regexp/test_match_literal" {
  let re = compile("hello")
  let _ = test_match(re, "hello")
}

bench "regexp/test_match_class" {
  let re = compile("[a-z]+[0-9]+")
  let _ = test_match(re, "abc123")
}

bench "regexp/find_in_string" {
  let re = compile("\\d+")
  let _ = find(re, "the answer is 42 ok")
}

bench "regexp/find_match" {
  let re = compile("[a-z]+")
  let _ = find_match(re, "123hello456")
}

bench "regexp/backtrack_star" {
  let re = compile("a.*b")
  let _ = test_match(re, "axxxxxxxxxxxb")
}

bench "regexp/anchor_start_end" {
  let re = compile("^hello$")
  let _ = test_match(re, "hello")
}

bench "regexp/find_all" {
  let re = compile("\\d+")
  let _ = find_all(re, "a1b23c456d7890")
}

bench "regexp/replace_all" {
  let re = compile("\\d+")
  let _ = replace_all(re, "a1b23c456", "N")
}

bench "regexp/replace_first" {
  let re = compile("\\d+")
  let _ = replace_first(re, "a1b23c456", "X")
}

bench "regexp/split" {
  let re = compile(",")
  let _ = split(re, "a,b,c,d,e,f")
}

bench "regexp/repeat_exact" {
  let re = compile("[a-z]{4}")
  let _ = test_match(re, "abcd")
}

bench "regexp/word_boundary" {
  let re = compile("\\bhello\\b")
  let _ = is_match(re, "say hello world")
}

bench "regexp/count" {
  let re = compile("\\d+")
  let _ = count(re, "a1b23c456d7e8f9")
}
