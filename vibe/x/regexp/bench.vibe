//# Imports

import ./index.vibe {
  compile, compile_regex, count, find, find_all, find_match, get_capture, get_named_capture, has_match, is_match, match_groups, replace_all, replace_first, replace_with_groups, split, test_match
}

//# Misc

bench "regexp/compile_simple" {
  let _ = compile("hello")
}

bench "regexp/compile_complex" {
  let _ = compile("(foo|bar)+[0-9]*\\.\\w+")
}

bench "regexp/test_match_literal" {
  let re = compile("hello")
  let _ = test_match(re, "hello")
}

bench "regexp/test_match_class" {
  let re = compile("[a-z]+[0-9]+")
  let _ = test_match(re, "abc123")
}

bench "regexp/find_in_string" {
  let re = compile("\\d+")
  let _ = find(re, "the answer is 42 ok")
}

bench "regexp/find_match" {
  let re = compile("[a-z]+")
  let _ = find_match(re, "123hello456")
}

bench "regexp/backtrack_star" {
  let re = compile("a.*b")
  let _ = test_match(re, "axxxxxxxxxxxb")
}

bench "regexp/anchor_start_end" {
  let re = compile("^hello$")
  let _ = test_match(re, "hello")
}

bench "regexp/find_all" {
  let re = compile("\\d+")
  let _ = find_all(re, "a1b23c456d7890")
}

bench "regexp/replace_all" {
  let re = compile("\\d+")
  let _ = replace_all(re, "a1b23c456", "N")
}

bench "regexp/replace_first" {
  let re = compile("\\d+")
  let _ = replace_first(re, "a1b23c456", "X")
}

bench "regexp/split" {
  let re = compile(",")
  let _ = split(re, "a,b,c,d,e,f")
}

bench "regexp/repeat_exact" {
  let re = compile("[a-z]{4}")
  let _ = test_match(re, "abcd")
}

bench "regexp/word_boundary" {
  let re = compile("\\bhello\\b")
  let _ = is_match(re, "say hello world")
}

bench "regexp/count" {
  let re = compile("\\d+")
  let _ = count(re, "a1b23c456d7e8f9")
}

bench "regexp/compile_regex_named" {
  let _ = compile_regex("(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})")
}

bench "regexp/match_groups_numbered" {
  let re = compile_regex("(\\d+)-(\\d+)")
  let _ = match_groups(re, "2026-03")
}

bench "regexp/match_groups_named" {
  let re = compile_regex("(?<year>\\d{4})-(?<month>\\d{2})")
  let _ = match_groups(re, "date: 2026-03-13")
}

bench "regexp/get_capture" {
  let re = compile_regex("(\\w+)@(\\w+)")
  let m = match_groups(re, "user@host")
  let _ = get_capture(m, 0)
  let _ = get_capture(m, 1)
}

bench "regexp/get_named_capture" {
  let re = compile_regex("(?<user>\\w+)@(?<host>\\w+)")
  let m = match_groups(re, "user@host")
  let _ = get_named_capture(m, "user")
  let _ = get_named_capture(m, "host")
}

bench "regexp/backreference" {
  let re = compile_regex("(\\w+)=\\1")
  let m = match_groups(re, "abc=abc")
  let _ = has_match(m)
}

bench "regexp/non_capturing_group" {
  let re = compile_regex("(?:foo|bar)(baz)")
  let _ = match_groups(re, "foobaz")
}

bench "regexp/replace_with_groups" {
  let re = compile_regex("(\\w+)@(\\w+)")
  let _ = replace_with_groups(re, "user@host other@place", "$2/$1")
}

bench "regexp/replace_with_named_groups" {
  let re = compile_regex("(?<first>\\w+)-(?<last>\\w+)")
  let _ = replace_with_groups(re, "John-Doe Jane-Smith", "${last}, ${first}")
}
