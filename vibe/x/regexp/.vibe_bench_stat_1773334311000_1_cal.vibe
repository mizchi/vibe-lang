//# Functions

{
  let mut vibe_bench_iter_internal = 0
  while vibe_bench_iter_internal < 1 {
    let _ = compile_regex("(?<year>\\d{4})-(?<month>\\d{2})")
    vibe_bench_iter_internal += 1
  }
}
