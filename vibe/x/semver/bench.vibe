//# Imports

import ./semver.vibe {
  Semver::to_string, bump_major, bump_minor, bump_patch, compare, eq, gt, gte, lt, lte, parse
}

//# Misc

bench "semver/parse_simple" {
  let _ = parse("1.2.3")
}

bench "semver/parse_prerelease" {
  let _ = parse("1.0.0-alpha.1")
}

bench "semver/compare" {
  let a = parse("1.2.3")
  let b = parse("1.3.0")
  let _ = compare(a, b)
}

bench "semver/gt_lt" {
  let a = parse("2.0.0")
  let b = parse("1.9.9")
  let _ = gt(a, b)
  let _ = lt(b, a)
}

bench "semver/bump_all" {
  let v = parse("1.2.3")
  let _ = bump_major(v)
  let _ = bump_minor(v)
  let _ = bump_patch(v)
}

bench "semver/to_string" {
  let _ = Semver::to_string(parse("1.2.3-beta.1"))
}
