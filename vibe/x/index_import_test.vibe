//# Imports

import .{
  Json, JsonSchema, ParseResult, parse_args, ripple_eval_count, ripple_new, ripple_record_eval, validate
}

//# Misc

test "x index exports jsonschema and args symbols" {
  assert(validate(SNumber, JNum(3.14)))
  match parse_args([
    "--flag",
  ]) {
    ParseOk(_) => assert(true),
    ParseErr(_) => assert(false),
  }
  let db1 = ripple_record_eval(ripple_new(), "a.vibe", "fp1", array_slice([
    ""
  ], 0, 0))
  assert(eq(ripple_eval_count(db1), 1))
}
