//# Imports

import ./index.vibe {
  b, f, format, i, join, pad_left, pad_right, s
}

//# Misc

test "format string interpolation" {
  let result = format("{} is {} years old", [
    s("Alice"),
    i(25)
  ])
  assert(String::equals(result, "Alice is 25 years old"))
}

test "format with bool and double" {
  let result = format("active={} score={}", [
    b(true),
    f(3.14)
  ])
  assert(String::equals(result, "active=true score=3.14"))
}

test "format no placeholders" {
  let result = format("hello world", Array::slice([
    s("")
  ], 0, 0))
  assert(String::equals(result, "hello world"))
}

test "format extra placeholders kept" {
  let result = format("{} {} {}", [
    s("a")
  ])
  assert(String::equals(result, "a {} {}"))
}

test "format negative int" {
  assert(String::equals(format("{}", [
    i(-42)
  ]), "-42"))
}

test "format zero" {
  assert(String::equals(format("{}", [
    i(0)
  ]), "0"))
}

test "format multiple same type" {
  let result = format("{} + {} = {}", [
    i(1),
    i(2),
    i(3)
  ])
  assert(String::equals(result, "1 + 2 = 3"))
}

test "format single placeholder" {
  assert(String::equals(format("val={}", [
    i(99)
  ]), "val=99"))
}

test "format bool false" {
  assert(String::equals(format("{}", [
    b(false)
  ]), "false"))
}

test "format adjacent placeholders" {
  assert(String::equals(format("{}{}", [
    s("ab"),
    s("cd")
  ]), "abcd"))
}

test "format placeholder at start" {
  assert(String::equals(format("{} end", [
    s("start")
  ]), "start end"))
}

test "format placeholder at end" {
  assert(String::equals(format("start {}", [
    s("end")
  ]), "start end"))
}

test "format no braces" {
  assert(String::equals(format("plain text", [
    s("ignored")
  ]), "plain text"))
}

test "format single open brace not placeholder" {
  assert(String::equals(format("a { b", Array::slice([
    s("")
  ], 0, 0)), "a { b"))
}

test "join strings" {
  assert(String::equals(join([
    "a",
    "b",
    "c"
  ], ", "), "a, b, c"))
}

test "join empty" {
  assert(String::equals(join(Array::slice([
    ""
  ], 0, 0), ", "), ""))
}

test "join single element" {
  assert(String::equals(join([
    "only"
  ], ", "), "only"))
}

test "join with empty separator" {
  assert(String::equals(join([
    "a",
    "b",
    "c"
  ], ""), "abc"))
}

test "join with long separator" {
  assert(String::equals(join([
    "x",
    "y"
  ], " --- "), "x --- y"))
}

test "pad_left" {
  assert(String::equals(pad_left("42", 5, "0"), "00042"))
}

test "pad_left already wide enough" {
  assert(String::equals(pad_left("hello", 3, "0"), "hello"))
}

test "pad_right" {
  assert(String::equals(pad_right("hi", 5, "."), "hi..."))
}

test "pad_right already wide enough" {
  assert(String::equals(pad_right("hello", 3, "."), "hello"))
}

test "pad_left single char" {
  assert(String::equals(pad_left("x", 4, " "), "   x"))
}
