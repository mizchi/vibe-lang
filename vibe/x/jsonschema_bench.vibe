//# Imports

import ./jsonschema.vibe {
  Json,
  JsonSchema,
  validate,
}

//# Functions

let nested_ok = JObj(map {
  items: JArr([
    JObj(map {
      id: JNum(1.0),
      kind: JStr("a")
    }),
    JObj(map {
      id: JNum(2.0),
      kind: JStr("b")
    }),
    JObj(map {
      id: JNum(3.0),
      kind: JStr("c")
    })
  ]),
  meta: JObj(map {
    version: JNum(1.0)
  })
})

let person_ok = JObj(map {
  id: JNum(1.0),
  name: JStr("alice"),
  active: JBool(true),
  score: JNum(98.5),
  city: JStr("tokyo")
})

let nested_bad = JObj(map {
  items: JArr([
    JObj(map {
      id: JNum(1.0),
      kind: JStr("a")
    }),
    JObj(map {
      id: JStr("2"),
      kind: JStr("b")
    }),
    JObj(map {
      id: JNum(3.0),
      kind: JStr("c")
    })
  ]),
  meta: JObj(map {
    version: JNum(1.0)
  })
})

let person_bad = JObj(map {
  id: JNum(1.0),
  name: JStr("alice"),
  active: JBool(true),
  score: JStr("98.5")
})

let item_schema = SObject([
  "id",
  "kind"
], [
  ("id", SNumber),
  ("kind", SString)
])

let nested_schema = SObject([
  "items",
  "meta"
], [
  ("items", SArray(item_schema)),
  ("meta", SObject([
    "version"
  ], [
    ("version", SNumber)
  ]))
])

let person_schema = SObject([
  "id",
  "name",
  "active",
  "score"
], [
  ("id", SNumber),
  ("name", SString),
  ("active", SBool),
  ("score", SNumber)
])

//# Misc

bench "jsonschema/person_ok" {
  let _ = validate(person_schema, person_ok)
}

bench "jsonschema/person_bad" {
  let _ = validate(person_schema, person_bad)
}

bench "jsonschema/nested_ok" {
  let _ = validate(nested_schema, nested_ok)
}

bench "jsonschema/nested_bad" {
  let _ = validate(nested_schema, nested_bad)
}
