//# Imports

import ./index.vibe { exec_body, make_memory, opcode_name, disassemble, exec_module, exec_module_with_args }

//# Functions

let make_bytes = (values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

let make_locals = (n: Int) -> Array[Int] {
  let arr = Array::slice([0], 0, 0)
  let mut i = 0
  while i < n { Array::push(arr, 0); i = i + 1 }
  arr
}

let empty_stack = () -> Array[Int] { Array::slice([0], 0, 0) }
let empty_globals = () -> Array[Int] { Array::slice([0], 0, 0) }
let empty_funcs = () -> Array[(Int, Int, Int, Int)] { Array::slice([(0, 0, 0, 0)], 0, 0) }

//# Misc

// === Basic arithmetic ===

test "i32 const and add" {
  let code = make_bytes([0x41, 3, 0x41, 5, 0x6A, 0x0B])
  let locals = make_locals(0)
  let stack = empty_stack()
  let mem = make_memory(1)
  let (exit, result) = exec_body(code, 0, 6, locals, stack, mem, empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 8)
}

test "i32 sub" {
  let code = make_bytes([0x41, 10, 0x41, 3, 0x6B, 0x0B])
  let (exit, result) = exec_body(code, 0, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 7)
}

test "i32 mul" {
  let code = make_bytes([0x41, 6, 0x41, 7, 0x6C, 0x0B])
  let (exit, result) = exec_body(code, 0, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 42)
}

test "i64 const and add" {
  let code = make_bytes([0x42, 0xE4, 0x00, 0x42, 0xC8, 0x01, 0x7C, 0x0B])
  let (exit, result) = exec_body(code, 0, 8, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 300)
}

// === Local variables ===

test "local get and set" {
  let code = make_bytes([0x41, 42, 0x21, 0, 0x20, 0, 0x0B])
  let locals = make_locals(1)
  let (exit, result) = exec_body(code, 0, 7, locals, empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 42)
}

test "local set get 99" {
  let code = make_bytes([0x41, 0xE3, 0x00, 0x21, 0, 0x20, 0, 0x0B])
  let locals = make_locals(1)
  let (exit, result) = exec_body(code, 0, 8, locals, empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 99)
}

// === Comparisons ===

test "i32 eq" {
  let code = make_bytes([0x41, 5, 0x41, 5, 0x46, 0x0B])
  let (_, result) = exec_body(code, 0, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 1)
}

test "i32 ne" {
  let code = make_bytes([0x41, 5, 0x41, 3, 0x47, 0x0B])
  let (_, result) = exec_body(code, 0, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 1)
}

test "i32 eqz true" {
  let code = make_bytes([0x41, 0, 0x45, 0x0B])
  let (_, result) = exec_body(code, 0, 4, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 1)
}

test "i32 eqz false" {
  let code = make_bytes([0x41, 1, 0x45, 0x0B])
  let (_, result) = exec_body(code, 0, 4, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 0)
}

// === Control flow ===

test "if true branch" {
  let code = make_bytes([0x41, 1, 0x04, 0x7F, 0x41, 10, 0x05, 0x41, 20, 0x0B, 0x0B])
  let (exit, result) = exec_body(code, 0, 11, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 10)
}

test "if false branch" {
  let code = make_bytes([0x41, 0, 0x04, 0x7F, 0x41, 10, 0x05, 0x41, 20, 0x0B, 0x0B])
  let (exit, result) = exec_body(code, 0, 11, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 20)
}

// === Drop and select ===

test "drop" {
  let code = make_bytes([0x41, 42, 0x41, 99, 0x1A, 0x0B])
  let (_, result) = exec_body(code, 0, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 42)
}

test "select true" {
  let code = make_bytes([0x41, 10, 0x41, 20, 0x41, 1, 0x1B, 0x0B])
  let (_, result) = exec_body(code, 0, 8, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 10)
}

test "select false" {
  let code = make_bytes([0x41, 10, 0x41, 20, 0x41, 0, 0x1B, 0x0B])
  let (_, result) = exec_body(code, 0, 8, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 20)
}

// === Memory ===

test "i32 store and load" {
  let code = make_bytes([
    0x41, 0, 0x41, 42, 0x36, 2, 0,
    0x41, 0, 0x28, 2, 0,
    0x0B
  ])
  let (exit, result) = exec_body(code, 0, 13, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 42)
}

// === Globals ===

test "global get and set" {
  let globals = Array::slice([0], 0, 0)
  Array::push(globals, 100)
  let code = make_bytes([0x23, 0, 0x0B])
  let (exit, result) = exec_body(code, 0, 3, make_locals(0), empty_stack(), make_memory(1), globals, empty_funcs())
  assert(exit == 0)
  assert(result == 100)
}

// === Call ===

test "call simple function" {
  let code = make_bytes([
    0x41, 42, 0x0B,
    0x10, 0, 0x0B
  ])
  let funcs = Array::slice([(0, 0, 0, 0)], 0, 0)
  Array::push(funcs, (0, 3, 0, 0))
  Array::push(funcs, (3, 6, 0, 0))
  let (exit, result) = exec_body(code, 3, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), funcs)
  assert(exit == 0)
  assert(result == 42)
}

test "call with params" {
  let code = make_bytes([
    0x20, 0, 0x20, 1, 0x6A, 0x0B,
    0x41, 3, 0x41, 5, 0x10, 0, 0x0B
  ])
  let funcs = Array::slice([(0, 0, 0, 0)], 0, 0)
  Array::push(funcs, (0, 6, 2, 0))
  Array::push(funcs, (6, 13, 0, 0))
  let (exit, result) = exec_body(code, 6, 13, make_locals(0), empty_stack(), make_memory(1), empty_globals(), funcs)
  assert(exit == 0)
  assert(result == 8)
}

// === Bitwise ===

test "i32 and or xor" {
  let code = make_bytes([0x41, 0xFF, 0x01, 0x41, 0x0F, 0x71, 0x0B])
  let (_, result) = exec_body(code, 0, 7, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 15)
}

// === Return ===

test "early return" {
  let code = make_bytes([0x41, 42, 0x0F, 0x41, 99, 0x0B])
  let (exit, result) = exec_body(code, 0, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 2)
  assert(result == 42)
}

// === Opcode name ===

test "opcode_name" {
  assert(opcode_name(0x41) == "i32.const")
  assert(opcode_name(0x6A) == "i32.add")
  assert(opcode_name(0x7C) == "i64.add")
  assert(opcode_name(0x20) == "local.get")
  assert(opcode_name(0x10) == "call")
  assert(opcode_name(0xFF) == "unknown")
}

// === New: extended opcode names ===

test "opcode_name extended" {
  assert(opcode_name(0x22) == "local.tee")
  assert(opcode_name(0x23) == "global.get")
  assert(opcode_name(0x24) == "global.set")
  assert(opcode_name(0x28) == "i32.load")
  assert(opcode_name(0x2D) == "i32.load8_u")
  assert(opcode_name(0x36) == "i32.store")
  assert(opcode_name(0x3A) == "i32.store8")
  assert(opcode_name(0x3F) == "memory.size")
  assert(opcode_name(0x40) == "memory.grow")
  assert(opcode_name(0x0E) == "br_table")
  assert(opcode_name(0x45) == "i32.eqz")
  assert(opcode_name(0x6D) == "i32.div_s")
  assert(opcode_name(0x71) == "i32.and")
  assert(opcode_name(0xAD) == "i64.extend_i32_u")
}

// === New: i32.load8_u / i32.store8 ===

test "i32.store8 and i32.load8_u" {
  let code = make_bytes([
    0x41, 10, 0x41, 0xAB, 0x01, 0x3A, 0, 0,
    0x41, 10, 0x2D, 0, 0,
    0x0B
  ])
  let (exit, result) = exec_body(code, 0, 14, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 0xAB)
}

test "i32.store8 truncates to byte" {
  let code = make_bytes([
    0x41, 0, 0x41, 0xFF, 0x03, 0x3A, 0, 0,
    0x41, 0, 0x2D, 0, 0,
    0x0B
  ])
  let (_, result) = exec_body(code, 0, 14, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(result == 0xFF)
}

// === New: memory.size / memory.grow ===

test "memory.size" {
  let code = make_bytes([0x3F, 0x00, 0x0B])
  let mem = make_memory(2)
  let (exit, result) = exec_body(code, 0, 3, make_locals(0), empty_stack(), mem, empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 2)
}

test "memory.grow returns old size" {
  // i32.const 3, memory.grow -> should return 1 (old page count)
  let code = make_bytes([0x41, 3, 0x40, 0x00, 0x0B])
  // Use a small initial memory to avoid slow test
  let mem = Bytes::new()
  let mut mi = 0
  while mi < 256 { Bytes::push(mem, 0); mi = mi + 1 }
  // memory is 256 bytes = 0 pages (less than 1), so size = 0
  // Actually make_memory(1) = 65536 bytes. Let's use that.
  let mem2 = make_memory(1)
  let (exit, result) = exec_body(code, 0, 5, make_locals(0), empty_stack(), mem2, empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 1)
}

// === New: disassemble ===

test "disassemble basic" {
  let code = make_bytes([0x41, 3, 0x41, 5, 0x6A, 0x0B])
  let lines = disassemble(code, 0, 6)
  assert(Array::length(lines) == 4)
  assert(Array::get(lines, 0) == "i32.const 3")
  assert(Array::get(lines, 1) == "i32.const 5")
  assert(Array::get(lines, 2) == "i32.add")
  assert(Array::get(lines, 3) == "end")
}

test "disassemble locals" {
  let code = make_bytes([0x20, 0, 0x21, 1, 0x22, 2, 0x0B])
  let lines = disassemble(code, 0, 7)
  assert(Array::length(lines) == 4)
  assert(Array::get(lines, 0) == "local.get 0")
  assert(Array::get(lines, 1) == "local.set 1")
  assert(Array::get(lines, 2) == "local.tee 2")
  assert(Array::get(lines, 3) == "end")
}

test "disassemble memory ops" {
  let code = make_bytes([0x28, 2, 0, 0x0B])
  let lines = disassemble(code, 0, 4)
  assert(Array::length(lines) == 2)
  assert(Array::get(lines, 0) == "i32.load align=2 offset=0")
  assert(Array::get(lines, 1) == "end")
}

test "disassemble call" {
  let code = make_bytes([0x10, 3, 0x0B])
  let lines = disassemble(code, 0, 3)
  assert(Array::length(lines) == 2)
  assert(Array::get(lines, 0) == "call 3")
  assert(Array::get(lines, 1) == "end")
}

// === New: exec_module ===

test "exec_module simple add" {
  let wasm = make_bytes([
    0x00, 0x61, 0x73, 0x6D,
    0x01, 0x00, 0x00, 0x00,
    // type section: (i32, i32) -> i32
    0x01, 0x07, 0x01, 0x60, 0x02, 0x7F, 0x7F, 0x01, 0x7F,
    // func section
    0x03, 0x02, 0x01, 0x00,
    // export section: "add" = func 0
    0x07, 0x07, 0x01, 0x03, 0x61, 0x64, 0x64, 0x00, 0x00,
    // code section: local.get 0, local.get 1, i32.add, end
    0x0A, 0x09, 0x01, 0x07, 0x00, 0x20, 0x00, 0x20, 0x01, 0x6A, 0x0B
  ])
  let args = Array::slice([0], 0, 0)
  Array::push(args, 13)
  Array::push(args, 29)
  let (ec, result) = exec_module_with_args(wasm, "add", args)
  assert(ec == 0)
  assert(result == 42)
}

test "exec_module no-param func" {
  let wasm = make_bytes([
    0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,
    // type section: () -> i32
    0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7F,
    // func section
    0x03, 0x02, 0x01, 0x00,
    // export section: "run" = func 0
    0x07, 0x07, 0x01, 0x03, 0x72, 0x75, 0x6E, 0x00, 0x00,
    // code section: i32.const 42, end  (42 = 0x2A, fits in 1-byte sleb128)
    0x0A, 0x06, 0x01, 0x04, 0x00, 0x41, 0x2A, 0x0B
  ])
  let (ec, result) = exec_module(wasm, "run")
  assert(ec == 0)
  assert(result == 42)
}

test "exec_module bad magic" {
  let wasm = make_bytes([0xFF, 0xFF, 0xFF, 0xFF, 0x01, 0x00, 0x00, 0x00])
  let (ec, _) = exec_module(wasm, "run")
  assert(ec == -1)
}

test "exec_module export not found" {
  let wasm = make_bytes([
    0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,
    0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7F,
    0x03, 0x02, 0x01, 0x00,
    0x07, 0x07, 0x01, 0x03, 0x72, 0x75, 0x6E, 0x00, 0x00,
    0x0A, 0x06, 0x01, 0x04, 0x00, 0x41, 0x63, 0x0B
  ])
  let (ec, _) = exec_module(wasm, "missing")
  assert(ec == -2)
}

test "exec_module too small" {
  let wasm = make_bytes([0x00, 0x61])
  let (ec, _) = exec_module(wasm, "run")
  assert(ec == -1)
}

test "exec_module with locals" {
  // func(x: i32) -> i32: tmp = x + 10; return tmp
  // Uses 1 local declaration (1 x i32)
  let wasm = make_bytes([
    0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,
    // type section: (i32) -> i32
    0x01, 0x06, 0x01, 0x60, 0x01, 0x7F, 0x01, 0x7F,
    // func section
    0x03, 0x02, 0x01, 0x00,
    // export section: "f" = func 0
    0x07, 0x05, 0x01, 0x01, 0x66, 0x00, 0x00,
    // code section
    0x0A, 0x0E, 0x01,
    0x0C,             // body size = 12
    0x01,             // 1 local declaration group
    0x01, 0x7F,       // 1 local of type i32
    0x20, 0x00,       // local.get 0
    0x41, 0x0A,       // i32.const 10
    0x6A,             // i32.add
    0x21, 0x01,       // local.set 1
    0x20, 0x01,       // local.get 1
    0x0B              // end
  ])
  let args = Array::slice([0], 0, 0)
  Array::push(args, 32)
  let (ec, result) = exec_module_with_args(wasm, "f", args)
  assert(ec == 0)
  assert(result == 42)
}

test "exec_module multi-function call" {
  // func0 = double(x) = x + x, func1 = main() = double(21)
  let wasm = make_bytes([
    0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,
    // type section: type0=(i32)->i32, type1=()->i32
    0x01, 0x0A, 0x02,
      0x60, 0x01, 0x7F, 0x01, 0x7F,
      0x60, 0x00, 0x01, 0x7F,
    // func section: func0=type0, func1=type1
    0x03, 0x03, 0x02, 0x00, 0x01,
    // export section: "main" = func 1
    0x07, 0x08, 0x01, 0x04, 0x6D, 0x61, 0x69, 0x6E, 0x00, 0x01,
    // code section: 2 bodies
    0x0A, 0x11, 0x02,
      // func 0: size=7, 0 locals, local.get 0, local.get 0, i32.add, end
      0x07, 0x00, 0x20, 0x00, 0x20, 0x00, 0x6A, 0x0B,
      // func 1: size=6, 0 locals, i32.const 21, call 0, end
      0x06, 0x00, 0x41, 0x15, 0x10, 0x00, 0x0B
  ])
  let (ec, result) = exec_module(wasm, "main")
  assert(ec == 0)
  assert(result == 42)
}

test "exec_module with global" {
  // 1 mutable global (i32, init=42), func reads it
  let wasm = make_bytes([
    0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,
    // type section: ()->i32
    0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7F,
    // func section
    0x03, 0x02, 0x01, 0x00,
    // global section (id=6): 1 global, i32 mutable, init=i32.const 42
    0x06, 0x06, 0x01,
      0x7F, 0x01,        // i32, mutable
      0x41, 0x2A, 0x0B,  // i32.const 42, end
    // export section: "g" = func 0
    0x07, 0x05, 0x01, 0x01, 0x67, 0x00, 0x00,
    // code section: global.get 0, end
    0x0A, 0x06, 0x01, 0x04, 0x00, 0x23, 0x00, 0x0B
  ])
  let (ec, result) = exec_module(wasm, "g")
  assert(ec == 0)
  assert(result == 42)
}

// === New: br_table ===

test "br_table index 0" {
  // block (result i32)
  //   block (void)
  //     i32.const 0 (index)
  //     br_table count=2 [0, 1, default=2]
  //   end
  //   i32.const 10
  //   br 0
  // end
  let code = make_bytes([
    0x02, 0x7F,           // block (result i32)
      0x02, 0x40,         //   block (void)
        0x41, 0,          //     i32.const 0 (index)
        0x0E, 2, 0, 1, 2, //     br_table count=2 [0, 1, default=2]
      0x0B,               //   end inner
      0x41, 10,           //   i32.const 10
      0x0C, 0,            //   br 0
    0x0B,                 // end outer
    0x0B                  // final end
  ])
  let (exit, result) = exec_body(code, 0, 18, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 10)
}

// ============================================================
// Ported from Rust wasmparser "out of scope" tests
// ============================================================

// --- big_function_body: loop executing many iterations ---
// Original test uses 8M unreachable instructions.
// We test a loop that executes 100 iterations.

// --- Sequential accumulation (no loop, just repeated code) ---

test "rs: sequential accumulation" {
  // Accumulate: local 0 += 1 repeated 5 times, then return
  let code = make_bytes([
    0x20, 0, 0x41, 1, 0x6A, 0x21, 0,  // local.get 0, i32.const 1, i32.add, local.set 0
    0x20, 0, 0x41, 1, 0x6A, 0x21, 0,
    0x20, 0, 0x41, 1, 0x6A, 0x21, 0,
    0x20, 0, 0x41, 1, 0x6A, 0x21, 0,
    0x20, 0, 0x41, 1, 0x6A, 0x21, 0,
    0x20, 0,  // local.get 0
    0x0B
  ])
  let mem = Bytes::new()
  let mut mi = 0
  while mi < 256 { Bytes::push(mem, 0); mi = mi + 1 }
  let (exit, result) = exec_body(code, 0, Bytes::length(code), make_locals(1), empty_stack(), mem, empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 5)
}

// --- Recursive call (simple: double via self-call) ---

test "rs: recursive call double" {
  // func 0 (double): local.get 0, local.get 0, i32.add, end
  // func 1 (main): i32.const 21, call 0, end
  let code = make_bytes([
    // func 0 (double): param 0 = n, returns n+n
    0x20, 0,              // local.get 0
    0x20, 0,              // local.get 0
    0x6A,                 // i32.add
    0x0B,                 // end func 0
    // func 1 (main):
    0x41, 21,             // i32.const 21
    0x10, 0,              // call 0
    0x0B                  // end func 1
  ])
  let funcs = Array::slice([(0, 0, 0, 0)], 0, 0)
  Array::push(funcs, (0, 6, 1, 0))    // func 0: start=0, end=6, 1 param
  Array::push(funcs, (6, 11, 0, 0))   // func 1: start=6, end=11
  let mem = Bytes::new()
  let mut mi = 0
  while mi < 256 { Bytes::push(mem, 0); mi = mi + 1 }
  let (exit, result) = exec_body(code, 6, 11, make_locals(0), empty_stack(), mem, empty_globals(), funcs)
  assert(exit == 0)
  assert(result == 42)
}
