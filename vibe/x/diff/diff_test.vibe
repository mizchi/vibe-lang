//# Imports

import ./index.vibe {
  count_additions, count_deletions, diff_lines, format_unified, has_changes
}

//# Misc

test "identical texts no changes" {
  let ops = diff_lines("a\nb\nc", "a\nb\nc")
  assert(not(has_changes(ops)))
  assert(count_additions(ops) == 0)
  assert(count_deletions(ops) == 0)
}

test "single line identical" {
  let ops = diff_lines("hello", "hello")
  assert(not(has_changes(ops)))
}

test "addition at end" {
  let ops = diff_lines("a\nb", "a\nb\nc")
  assert(has_changes(ops))
  assert(count_additions(ops) == 1)
  assert(count_deletions(ops) == 0)
}

test "addition in middle" {
  let ops = diff_lines("a\nc", "a\nb\nc")
  assert(has_changes(ops))
  assert(count_additions(ops) == 1)
  assert(count_deletions(ops) == 0)
}

test "addition at start" {
  let ops = diff_lines("b\nc", "a\nb\nc")
  assert(has_changes(ops))
  assert(count_additions(ops) == 1)
}

test "deletion from end" {
  let ops = diff_lines("a\nb\nc", "a\nb")
  assert(has_changes(ops))
  assert(count_deletions(ops) == 1)
  assert(count_additions(ops) == 0)
}

test "deletion from middle" {
  let ops = diff_lines("a\nb\nc", "a\nc")
  assert(has_changes(ops))
  assert(count_deletions(ops) == 1)
  assert(count_additions(ops) == 0)
}

test "modification is add + remove" {
  let ops = diff_lines("hello", "world")
  assert(has_changes(ops))
  assert(count_additions(ops) >= 1)
  assert(count_deletions(ops) >= 1)
}

test "multiple additions" {
  let ops = diff_lines("a", "a\nb\nc\nd")
  assert(count_additions(ops) == 3)
  assert(count_deletions(ops) == 0)
}

test "multiple deletions" {
  let ops = diff_lines("a\nb\nc\nd", "a")
  assert(count_additions(ops) == 0)
  assert(count_deletions(ops) == 3)
}

test "complete replacement" {
  let ops = diff_lines("a\nb\nc", "x\ny\nz")
  assert(has_changes(ops))
  assert(count_additions(ops) == 3)
  assert(count_deletions(ops) == 3)
}

test "format_unified output keeps" {
  let ops = diff_lines("a\nb", "a\nc")
  let output = format_unified(ops)
  assert(String::contains(output, " a"))
  assert(String::contains(output, "-b"))
  assert(String::contains(output, "+c"))
}

test "format_unified identical has only keeps" {
  let ops = diff_lines("a\nb", "a\nb")
  let output = format_unified(ops)
  assert(String::contains(output, " a"))
  assert(String::contains(output, " b"))
  assert(not(String::contains(output, "+")))
  assert(not(String::contains(output, "-")))
}

test "empty to content" {
  let ops = diff_lines("", "hello\nworld")
  assert(has_changes(ops))
  assert(count_additions(ops) == 2)
}

test "content to empty" {
  let ops = diff_lines("hello\nworld", "")
  assert(has_changes(ops))
  assert(count_deletions(ops) == 2)
}

test "reorder lines" {
  let ops = diff_lines("a\nb\nc", "c\nb\na")
  assert(has_changes(ops))
}

test "duplicate lines" {
  let ops = diff_lines("a\na\na", "a\na\na")
  assert(not(has_changes(ops)))
}
