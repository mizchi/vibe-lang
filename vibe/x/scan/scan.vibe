//# Types

export struct Scanner {
  input: String;
  pos: Int
}

//# Functions

export let new = (input: String) -> Scanner {
  Scanner::{
    input: input,
    pos: 0
  }
}

let char_at = (input: String, pos: Int) -> String {
  input[pos:pos + 1]
}

let clamp_pos = (input: String, pos: Int) -> Int {
  let len = String::length(input)
  if pos < 0 {
    0
  }
  else if pos > len {
    len
  } else pos
}

export let Scanner::pos = (scan: Scanner) -> Int {
  scan.pos
}

export let pos = (scan: Scanner) -> Int {
  Scanner::pos(scan)
}

export let Scanner::advance = (scan: Scanner, count: Int) -> Scanner {
  Scanner::{
    input: scan.input,
    pos: clamp_pos(scan.input, scan.pos + count)
  }
}

export let Scanner::is_done = (scan: Scanner) -> Bool {
  scan.pos >= String::length(scan.input)
}

export let is_done = (scan: Scanner) -> Bool {
  Scanner::is_done(scan)
}

export let Scanner::peek = (scan: Scanner) -> Option[String] {
  if Scanner::is_done(scan) {
    None
  } else Some(char_at(scan.input, scan.pos))
}

export let peek = (scan: Scanner) -> Option[String] {
  Scanner::peek(scan)
}

export let Scanner::next = (scan: Scanner) -> Option[(String, Scanner)] {
  match Scanner::peek(scan) {
    Some(ch) => Some((ch, Scanner::advance(scan, 1))),
    _ => None
  }
}

export let next = (scan: Scanner) -> Option[(String, Scanner)] {
  Scanner::next(scan)
}

export let Scanner::eat_if = (scan: Scanner, pred: (ch: String) -> Bool) -> Option[(String, Scanner)] {
  match Scanner::peek(scan) {
    Some(ch) => if pred(ch) {
      Some((ch, Scanner::advance(scan, 1)))
    } else None
    ,
    _ => None
  }
}

export let eat_if = (scan: Scanner, pred: (ch: String) -> Bool) -> Option[(String, Scanner)] {
  Scanner::eat_if(scan, pred)
}

export let Scanner::remaining = (scan: Scanner) -> String {
  scan.input[scan.pos: String::length(scan.input)]
}

export let remaining = (scan: Scanner) -> String {
  Scanner::remaining(scan)
}

export let Scanner::eat = (scan: Scanner, prefix: String) -> Option[Scanner] {
  if String::starts_with(Scanner::remaining(scan), prefix) {
    Some(Scanner::advance(scan, String::length(prefix)))
  } else None
}

export let eat = (scan: Scanner, prefix: String) -> Option[Scanner] {
  Scanner::eat(scan, prefix)
}

export let Scanner::take_until = (scan: Scanner, needle: String) -> (String, Scanner) {
  let rest = Scanner::remaining(scan)
  let needle_len = String::length(needle)
  if needle_len == 0 {
    ("", scan)
  } else {
    let rel = String::index_of(rest, needle)
    if rel >= 0 {
      (rest[0: rel], Scanner::advance(scan, rel),)
    } else {
      (rest, Scanner::advance(scan, String::length(rest)),)
    }
  }
}

export let take_until = (scan: Scanner, needle: String) -> (String, Scanner) {
  Scanner::take_until(scan, needle)
}

export let Scanner::take_while = (scan: Scanner, pred: (ch: String) -> Bool) -> (String, Scanner) {
  let len = String::length(scan.input)
  let rec r#loop = (pos: Int) -> Int {
    if pos >= len {
      pos
    } else {
      let ch = char_at(scan.input, pos)
      if pred(ch) {
        r#loop(pos + 1)
      } else pos
    }
  }
  let end = r#loop(scan.pos)
  (scan.input[scan.pos: end], Scanner::{
    input: scan.input, pos: end
  },)
}

export let take_while = (scan: Scanner, pred: (ch: String) -> Bool) -> (String, Scanner) {
  Scanner::take_while(scan, pred)
}
