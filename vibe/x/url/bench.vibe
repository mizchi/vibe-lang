//# Imports

import ./url.vibe {
  Url::fragment, Url::host, Url::path, Url::port, Url::query, Url::scheme, decode, decode_query, encode, encode_query, parse
}

//# Misc

bench "url/parse_full" {
  let _ = parse("https://example.com:8080/api/v1?key=val&foo=bar#section")
}

bench "url/parse_simple" {
  let _ = parse("https://example.com/path")
}

bench "url/encode" {
  let _ = encode("hello world & foo=bar baz")
}

bench "url/decode" {
  let _ = decode("hello+world+%26+foo%3Dbar+baz")
}

bench "url/encode_query" {
  let _ = encode_query([
    ("name", "Alice Bob"),
    ("age", "25"),
    ("city", "New York")
  ])
}

bench "url/decode_query" {
  let _ = decode_query("name=Alice+Bob&age=25&city=New+York")
}
