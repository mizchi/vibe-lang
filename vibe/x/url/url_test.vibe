//# Imports

import ./pattern.vibe {
  compile_pattern, exec_pattern, get_param, pattern_has_match, test_pattern
}

import ./url.vibe {
  Url::fragment, Url::host, Url::path, Url::port, Url::query, Url::scheme, decode, decode_query, encode, encode_query, parse
}

//# Misc

test "encode spaces as plus" {
  assert(String::equals(encode("hello world"), "hello+world"))
}

test "encode special chars" {
  assert(String::equals(encode("a&b=c"), "a%26b%3Dc"))
}

test "encode unreserved chars unchanged" {
  assert(String::equals(encode("abc123"), "abc123"))
  assert(String::equals(encode("hello-world_v2.0"), "hello-world_v2.0"))
}

test "encode empty string" {
  assert(String::equals(encode(""), ""))
}

test "decode plus to space" {
  assert(String::equals(decode("hello+world"), "hello world"))
}

test "decode percent encoding" {
  assert(String::equals(decode("a%26b%3Dc"), "a&b=c"))
}

test "decode plain string" {
  assert(String::equals(decode("hello"), "hello"))
}

test "decode empty string" {
  assert(String::equals(decode(""), ""))
}

test "roundtrip encode decode" {
  let original = "hello world&foo=bar"
  assert(String::equals(decode(encode(original)), original))
}

test "roundtrip special chars" {
  let original = "a+b&c=d"
  assert(String::equals(decode(encode(original)), original))
}

test "encode_query pairs" {
  let result = encode_query([
    ("name", "Alice Bob"),
    ("age", "25")
  ])
  assert(String::equals(result, "name=Alice+Bob&age=25"))
}

test "encode_query single pair" {
  assert(String::equals(encode_query([
    ("key", "val")
  ]), "key=val"))
}

test "encode_query empty" {
  assert(String::equals(encode_query(Array::slice([
    ("", "")
  ], 0, 0)), ""))
}

test "decode_query string" {
  let pairs = decode_query("name=Alice+Bob&age=25")
  assert(Array::length(pairs) == 2)
  let (k1, v1) = Array::get(pairs, 0)
  assert(String::equals(k1, "name"))
  assert(String::equals(v1, "Alice Bob"))
  let (k2, v2) = Array::get(pairs, 1)
  assert(String::equals(k2, "age"))
  assert(String::equals(v2, "25"))
}

test "decode_query single param" {
  let pairs = decode_query("key=val")
  assert(Array::length(pairs) == 1)
  let (k, v) = Array::get(pairs, 0)
  assert(String::equals(k, "key"))
  assert(String::equals(v, "val"))
}

test "decode_query empty string" {
  let pairs = decode_query("")
  assert(Array::length(pairs) == 0)
}

test "decode_query no value" {
  let pairs = decode_query("flag")
  assert(Array::length(pairs) == 1)
  let (k, v) = Array::get(pairs, 0)
  assert(String::equals(k, "flag"))
  assert(String::equals(v, ""))
}

test "parse full url" {
  let u = parse("https://example.com:8080/api/v1?key=val#sec")
  assert(String::equals(Url::scheme(u), "https"))
  assert(String::equals(Url::host(u), "example.com"))
  assert(Url::port(u) == 8080)
  assert(String::equals(Url::path(u), "/api/v1"))
  assert(String::equals(Url::query(u), "key=val"))
  assert(String::equals(Url::fragment(u), "sec"))
}

test "parse https default port" {
  let u = parse("https://example.com/path")
  assert(Url::port(u) == 443)
}

test "parse http default port" {
  let u = parse("http://example.com/path")
  assert(Url::port(u) == 80)
}

test "parse url no path" {
  let u = parse("https://example.com")
  assert(String::equals(Url::host(u), "example.com"))
  assert(String::equals(Url::path(u), "/"))
}

test "parse url with query only" {
  let u = parse("https://example.com?q=1")
  assert(String::equals(Url::query(u), "q=1"))
}

test "parse url with fragment only" {
  let u = parse("https://example.com#section")
  assert(String::equals(Url::fragment(u), "section"))
}

test "parse url with deep path" {
  let u = parse("https://api.example.com/v1/users/123")
  assert(String::equals(Url::path(u), "/v1/users/123"))
  assert(String::equals(Url::host(u), "api.example.com"))
}

test "parse url custom port" {
  let u = parse("http://localhost:3000/api")
  assert(String::equals(Url::host(u), "localhost"))
  assert(Url::port(u) == 3000)
  assert(String::equals(Url::path(u), "/api"))
}

test "parse url no fragment" {
  let u = parse("https://example.com/path?q=1")
  assert(String::equals(Url::fragment(u), ""))
}

test "parse url no query" {
  let u = parse("https://example.com/path#frag")
  assert(String::equals(Url::query(u), ""))
  assert(String::equals(Url::fragment(u), "frag"))
}

test "urlpattern matches pathname param" {
  let pattern = compile_pattern("/users/:id")
  assert(test_pattern(pattern, "/users/42"))
  assert(test_pattern(pattern, "https://example.com/users/42?tab=profile"))
  let m = exec_pattern(pattern, "/users/42")
  assert(pattern_has_match(m))
  assert(String::equals(get_param(m, "id"), "42"))
}

test "urlpattern matches host and pathname params" {
  let pattern = compile_pattern("https://:sub.example.com/users/:id")
  let m = exec_pattern(pattern, "https://api.example.com/users/42")
  assert(pattern_has_match(m))
  assert(String::equals(get_param(m, "sub"), "api"))
  assert(String::equals(get_param(m, "id"), "42"))
  assert(not(test_pattern(pattern, "http://api.example.com/users/42")))
}

test "urlpattern wildcard matches remaining path" {
  let pattern = compile_pattern("/assets/*")
  assert(test_pattern(pattern, "/assets/app.js"))
  assert(test_pattern(pattern, "/assets/css/site.css"))
  assert(not(test_pattern(pattern, "/static/app.js")))
}

test "urlpattern can capture query params" {
  let pattern = compile_pattern("/search?q=:query&sort=:sort")
  let m = exec_pattern(pattern, "https://example.com/search?q=vibe&sort=asc")
  assert(pattern_has_match(m))
  assert(String::equals(get_param(m, "query"), "vibe"))
  assert(String::equals(get_param(m, "sort"), "asc"))
}

test "urlpattern can require explicit port" {
  let pattern = compile_pattern("https://example.com:8443/admin")
  assert(test_pattern(pattern, "https://example.com:8443/admin"))
  assert(not(test_pattern(pattern, "https://example.com/admin")))
}
