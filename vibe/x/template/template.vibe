//# Functions

export let render = (template: String, vars: Array[(String, String)]) -> String {
  let mut result = template
  let var_count = Array::length(vars)
  let mut idx = 0
  while idx < var_count {
    let (key, value) = Array::get(vars, idx)
    let placeholder = String::concat(String::concat("{{", key), "}}")
    result = String::replace_all(result, placeholder, value)
    idx = idx + 1
  }
  result
}

export let has_vars = (template: String) -> Bool {
  String::contains(template, "{{") && String::contains(template, "}}")
}

let find_close = (s: String, start: Int) -> Int {
  let len = String::length(s)
  let mut idx = start
  let mut found = -1
  while idx + 1 < len && found < 0 {
    if String::equals(String::substring(s, idx, idx + 2), "}}") {
      found = idx
    } else {
      idx = idx + 1
    }
  }
  found
}

export let render_map = (template: String, vars: Map[String, String]) -> String {
  let len = String::length(template)
  let mut result = ""
  let mut i = 0
  while i < len {
    if i + 1 < len && String::equals(String::substring(template, i, i + 2), "{{") {
      let close = find_close(template, i + 2)
      if close > 0 {
        let key = String::trim(String::substring(template, i + 2, close))
        if Map::has_key(vars, key) {
          result = String::concat(result, Map::get(vars, key))
        } else {
          result = String::concat(result, String::substring(template, i, close + 2))
        }
        i = close + 2
      } else {
        result = String::concat(result, String::substring(template, i, i + 1))
        i = i + 1
      }
    } else {
      result = String::concat(result, String::substring(template, i, i + 1))
      i = i + 1
    }
  }
  result
}

export let extract_keys = (template: String) -> Array[String] {
  let len = String::length(template)
  let mut keys = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  while i < len {
    if i + 1 < len && String::equals(String::substring(template, i, i + 2), "{{") {
      let close = find_close(template, i + 2)
      if close > 0 {
        let key = String::trim(String::substring(template, i + 2, close))
        Array::push(keys, key)
        i = close + 2
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  keys
}
