//# Imports

import ./demo.vibe {
  demo_parse
}

import ./parser.vibe {
  ArgList, ArgToken, ParseResult
}

//# Misc

test "args demo parse shape" {
  match demo_parse() {
    ParseOk(items) => match items {
      ArgCons(Opt(k1, v1), rest1) => {
        assert(k1 == "name")
        assert(v1 == "alice")
        match rest1 {
          ArgCons(Flag(f1), rest2) => {
            assert(f1 == "verbose")
            match rest2 {
              ArgCons(Flag(f2), rest3) => {
                assert(f2 == "a")
                match rest3 {
                  ArgCons(Flag(f3), rest4) => {
                    assert(f3 == "b")
                    match rest4 {
                      ArgCons(Flag(f4), rest5) => {
                        assert(f4 == "c")
                        match rest5 {
                          ArgCons(Opt(k2, v2), rest6) => {
                            assert(k2 == "o")
                            assert(v2 == "out.txt")
                            match rest6 {
                              ArgCons(Positional(p1), ArgNil) =>
                              assert(p1 == "--literal"),
                              _ => assert(false)
                            }
                          }
                          _ => assert(false)
                        }
                      }
                      _ => assert(false)
                    }
                  }
                  _ => assert(false)
                }
              }
              _ => assert(false)
            }
          }
          _ => assert(false)
        }
      }
      _ => assert(false)
    }
    _ => assert(false)
  }
}
