//# Imports

import ./demo.vibe {
  demo_parse
}

import ./parser.vibe {
  ArgList, ArgToken, ParseResult
}

//# Misc

test "args demo parse shape" {
  match demo_parse() {
    ParseOk(items) => match items {
      ArgCons(Opt(k1, v1), rest1) => {
        assert(String::equals(k1, "name"))
        assert(String::equals(v1, "alice"))
        match rest1 {
          ArgCons(Flag(f1), rest2) => {
            assert(String::equals(f1, "verbose"))
            match rest2 {
              ArgCons(Flag(f2), rest3) => {
                assert(String::equals(f2, "a"))
                match rest3 {
                  ArgCons(Flag(f3), rest4) => {
                    assert(String::equals(f3, "b"))
                    match rest4 {
                      ArgCons(Flag(f4), rest5) => {
                        assert(String::equals(f4, "c"))
                        match rest5 {
                          ArgCons(Opt(k2, v2), rest6) => {
                            assert(String::equals(k2, "o"))
                            assert(String::equals(v2, "out.txt"))
                            match rest6 {
                              ArgCons(Positional(p1), ArgNil) =>
                              assert(String::equals(p1, "--literal")),
                              _ => assert(false)
                            }
                          }
                          _ => assert(false)
                        }
                      }
                      _ => assert(false)
                    }
                  }
                  _ => assert(false)
                }
              }
              _ => assert(false)
            }
          }
          _ => assert(false)
        }
      }
      _ => assert(false)
    }
    _ => assert(false)
  }
}
