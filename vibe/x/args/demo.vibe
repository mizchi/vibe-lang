
use ./parser.vibe {
  ParseResult,
  ArgList,
  ArgToken,
  parse_args,
}
export let demo_parse = () -> ParseResult {
  parse_args([
    "--name=alice",
    "--verbose",
    "-abc",
    "-o",
    "out.txt",
    "--",
    "--literal",
  ])
}
let main = () -> Unit {
  let mut _r = demo_parse()
  _r = _r
}
