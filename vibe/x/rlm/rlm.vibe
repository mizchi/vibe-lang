//# Functions

// run: (String, String) -> String with {Llm}
export let run = (task: String, prompt: String) -> String with { Llm } {
  Rlm::run(task, prompt)
}

// complete: (String, String) -> String with {Llm}
export let complete = (system: String, user: String) -> String with { Llm } {
  Llm::complete(system, user)
}

export let finalize = (result: String) -> String {
  Rlm::finalize(result)
}
