import ./quickcheck_effect.vibe { Random }

// Test 1: mock Random that always returns true
test "always true" {
  let result = handle {
    let v = perform Random::NextBool
    v
  } {
    Random::NextBool => resume(true),
    Random::NextInt(_lo, _hi) => resume(0)
  }
  assert(result == true)
}

// Test 2: mock Random with specific int range
test "int range" {
  let result = handle {
    let a = perform Random::NextInt(1, 10)
    let b = perform Random::NextInt(1, 10)
    a + b
  } {
    Random::NextBool => resume(false),
    Random::NextInt(_lo, _hi) => resume(5)
  }
  assert(result == 10)
}

// Test 3: deterministic sequence via handle
test "deterministic sequence" {
  // All NextBool → false, so property (b) -> !b succeeds
  let ok = handle {
    let v1 = perform Random::NextBool
    let v2 = perform Random::NextBool
    not(v1) && not(v2)
  } {
    Random::NextBool => resume(false),
    Random::NextInt(_lo, _hi) => resume(0)
  }
  assert(ok == true)
}
