// QuickCheck with algebraic effects: Random as capability
// Benefits:
// - No manual Rng state threading ((value, Rng) tuples)
// - Testable: mock Random handler for deterministic tests
// - Composable: combine with other effects (Log, IO)

export effect Random {
  NextInt(Int, Int) -> Int;
  NextBool -> Bool
}

// Property test: run prop `count` times with Random effect
export let check_prop = (count: Int, prop: () -> Bool with { Random }) -> Bool with { Random } {
  let mut i = 0
  let mut ok = true
  while i < count {
    if not(prop()) {
      ok = false
    }
    i = i + 1
  }
  ok
}
