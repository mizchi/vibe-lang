//# Types

export effect Random {
  NextInt(Int, Int) -> Int;
  NextBool -> Bool
}

//# Functions

// check_prop: (Int, () -> Bool with {Random}) -> Bool with {Random}
export let check_prop = (count: Int, prop: () -> Bool with { Random }) -> Bool with { Random } {
  let mut i = 0
  let mut ok = true
  while i < count {
    if not(prop()) {
      ok = false
    }
    i = i + 1
  }
  ok
}
