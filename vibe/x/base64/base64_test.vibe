//# Imports

import ./index.vibe {
  decode, encode, encode_url_safe
}

//# Misc

test "encode empty" {
  assert(String::equals(encode(""), ""))
}

test "encode single char" {
  assert(String::equals(encode("A"), "QQ=="))
}

test "encode two chars" {
  assert(String::equals(encode("AB"), "QUI="))
}

test "encode three chars" {
  assert(String::equals(encode("ABC"), "QUJD"))
}

test "encode hello" {
  assert(String::equals(encode("Hello"), "SGVsbG8="))
}

test "encode hello world" {
  assert(String::equals(encode("Hello, World!"), "SGVsbG8sIFdvcmxkIQ=="))
}

test "encode foobar incremental" {
  assert(String::equals(encode("f"), "Zg=="))
  assert(String::equals(encode("fo"), "Zm8="))
  assert(String::equals(encode("foo"), "Zm9v"))
  assert(String::equals(encode("foob"), "Zm9vYg=="))
  assert(String::equals(encode("fooba"), "Zm9vYmE="))
  assert(String::equals(encode("foobar"), "Zm9vYmFy"))
}

test "decode empty" {
  assert(String::equals(decode(""), ""))
}

test "decode hello" {
  assert(String::equals(decode("SGVsbG8="), "Hello"))
}

test "decode hello world" {
  assert(String::equals(decode("SGVsbG8sIFdvcmxkIQ=="), "Hello, World!"))
}

test "decode foobar incremental" {
  assert(String::equals(decode("Zg=="), "f"))
  assert(String::equals(decode("Zm8="), "fo"))
  assert(String::equals(decode("Zm9v"), "foo"))
  assert(String::equals(decode("Zm9vYg=="), "foob"))
  assert(String::equals(decode("Zm9vYmE="), "fooba"))
  assert(String::equals(decode("Zm9vYmFy"), "foobar"))
}

test "roundtrip ascii" {
  let input = "The quick brown fox jumps over the lazy dog"
  assert(String::equals(decode(encode(input)), input))
}

test "roundtrip numbers" {
  let input = "0123456789"
  assert(String::equals(decode(encode(input)), input))
}

test "encode_url_safe" {
  // Standard base64 uses + and /, URL-safe uses - and _
  // Also strips padding =
  let result = encode_url_safe("Hello, World!")
  assert(not(String::contains(result, "+")))
  assert(not(String::contains(result, "/")))
  assert(not(String::contains(result, "=")))
}
