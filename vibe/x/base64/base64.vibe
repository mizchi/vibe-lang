//# Functions

let alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

let decode_char = (c: Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  }
  else if c >= 97 && c <= 122 {
    c - 97 + 26
  }
  else if c >= 48 && c <= 57 {
    c - 48 + 52
  }
  else if c == 43 {
    62
  }
  else if c == 47 {
    63
  }
  else {
    -1
  }
}

export let decode = (input: String) -> String {
  let len = String::length(input)
  let mut result = ""
  let mut i = 0
  while i < len {
    let c0 = if i < len {
      decode_char(String::char_code_at(input, i))
    } else {
      0
    }
    let c1 = if i + 1 < len {
      decode_char(String::char_code_at(input, i + 1))
    } else {
      0
    }
    let c2 = if i + 2 < len {
      decode_char(String::char_code_at(input, i + 2))
    } else {
      -1
    }
    let c3 = if i + 3 < len {
      decode_char(String::char_code_at(input, i + 3))
    } else {
      -1
    }
    let b0 = ((c0&63)<<2)|((c1>>4)&3)
    result = String::concat(result, String::from_char_code(b0))
    if c2 >= 0 {
      let b1 = ((c1&15)<<4)|((c2>>2)&15)
      result = String::concat(result, String::from_char_code(b1))
    }
    if c3 >= 0 {
      let b2 = ((c2&3)<<6)|(c3&63)
      result = String::concat(result, String::from_char_code(b2))
    }
    i = i + 4
  }
  result
}

let encode_char = (idx: Int) -> String {
  String::substring(alphabet, idx, idx + 1)
}

export let encode = (input: String) -> String {
  let len = String::length(input)
  let mut result = ""
  let mut i = 0
  while i < len {
    let b0 = String::char_code_at(input, i)
    let b1 = if i + 1 < len {
      String::char_code_at(input, i + 1)
    } else {
      0
    }
    let b2 = if i + 2 < len {
      String::char_code_at(input, i + 2)
    } else {
      0
    }
    let remaining = len - i
    result = String::concat(result, encode_char((b0>>2)&63))
    result = String::concat(result, encode_char(((b0&3)<<4)|((b1>>4)&15)))
    if remaining >= 2 {
      result = String::concat(result, encode_char(((b1&15)<<2)|((b2>>6)&3)))
    } else {
      result = String::concat(result, "=")
    }
    if remaining >= 3 {
      result = String::concat(result, encode_char(b2&63))
    } else {
      result = String::concat(result, "=")
    }
    i = i + 3
  }
  result
}

export let encode_url_safe = (input: String) -> String {
  let base = encode(input)
  let len = String::length(base)
  let mut result = ""
  let mut i = 0
  while i < len {
    let c = String::substring(base, i, i + 1)
    if String::equals(c, "+") {
      result = String::concat(result, "-")
    }
    else if String::equals(c, "/") {
      result = String::concat(result, "_")
    }
    else if String::equals(c, "=") {
      i = len
    }
    else {
      result = String::concat(result, c)
    }
    i = i + 1
  }
  result
}
