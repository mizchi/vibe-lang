//# Functions

export let pi: Double = 3.14159265358979323846

export let e_const: Double = 2.71828182845904523536

export let tau: Double = 6.28318530717958647692

let half_pi: Double = 1.5707963267948966

// Normalize angle to [-pi, pi]
let normalize_angle = (x: Double) -> Double {
  let mut a = x
  while a > pi {
    a = a - tau
  }
  while a < 0.0 - pi {
    a = a + tau
  }
  a
}

// sqrt via Newton's method
export let sqrt = (x: Double) -> Double {
  if x <= 0.0 {
    0.0
  } else {
    let mut guess = x
    let mut i = 0
    while i < 60 {
      guess = (guess + x / guess) * 0.5
      i = i + 1
    }
    guess
  }
}

// sin via Taylor series (13 terms for f64 precision)
export let sin = (x: Double) -> Double {
  let a = normalize_angle(x)
  let aa = a * a
  let mut term = a
  let mut result = a
  let mut i = 1
  while i < 13 {
    let n = i * 2 * (i * 2 + 1)
    let nd = Int::to_double(n)
    term = 0.0 - term * aa / nd
    result = result + term
    i = i + 1
  }
  result
}

export let cos = (x: Double) -> Double {
  sin(x + half_pi)
}

export let tan = (x: Double) -> Double {
  let c = cos(x)
  sin(x) / c
}

// atan via series, valid for |x| <= 1
let atan_small = (x: Double) -> Double {
  let xx = x * x
  let mut result = x
  let mut term = x
  let mut i = 1
  while i < 20 {
    let n = i * 2 + 1
    let nd = Int::to_double(n)
    term = 0.0 - term * xx
    result = result + term / nd
    i = i + 1
  }
  result
}

export let atan = (x: Double) -> Double {
  if x > 1.0 {
    half_pi - atan_small(1.0 / x)
  }
  else if x < -1.0 {
    0.0 - half_pi - atan_small(1.0 / x)
  }
  else if x > 0.999999999 {
    // x ~= 1.0, atan(1) = pi/4
    pi / 4.0
  }
  else if x < -0.999999999 {
    0.0 - pi / 4.0
  }
  else {
    atan_small(x)
  }
}

export let atan2 = (y: Double, x: Double) -> Double {
  if x > 0.0 {
    atan(y / x)
  }
  else if x < 0.0 {
    if y >= 0.0 {
      atan(y / x) + pi
    } else {
      atan(y / x) - pi
    }
  }
  else {
    if y > 0.0 {
      half_pi
    }
    else if y < 0.0 {
      0.0 - half_pi
    }
    else {
      0.0
    }
  }
}

// asin(x) = atan(x / sqrt(1 - x^2))
export let asin = (x: Double) -> Double {
  if x >= 1.0 {
    half_pi
  }
  else if x <= -1.0 {
    0.0 - half_pi
  }
  else {
    atan(x / sqrt(1.0 - x * x))
  }
}

// acos(x) = pi/2 - asin(x)
export let acos = (x: Double) -> Double {
  half_pi - asin(x)
}

// exp via Taylor series
export let exp_double = (x: Double) -> Double {
  let mut result = 1.0
  let mut term = 1.0
  let mut i = 1
  while i < 30 {
    let id = Int::to_double(i)
    term = term * x / id
    result = result + term
    i = i + 1
  }
  result
}

// ln via series with range reduction
export let ln = (x: Double) -> Double {
  if x <= 0.0 {
    0.0 - 1.0 / 0.0
  }
  else {
    let ln2 = 0.6931471805599453
    let mut k = 0
    let mut m = x
    while m >= 2.0 {
      m = m * 0.5
      k = k + 1
    }
    while m < 0.5 {
      m = m * 2.0
      k = k - 1
    }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    let mut term = t
    let mut result = t
    let mut i = 1
    while i < 30 {
      let nd = Int::to_double(i * 2 + 1)
      term = term * t2
      result = result + term / nd
      i = i + 1
    }
    Int::to_double(k) * ln2 + 2.0 * result
  }
}

export let log10 = (x: Double) -> Double {
  let log10e = 2.302585092994046
  ln(x) / log10e
}

export let log2_double = (x: Double) -> Double {
  let ln2 = 0.6931471805599453
  ln(x) / ln2
}

export let pow_double = (base: Double, exponent: Double) -> Double {
  exp_double(exponent * ln(base))
}

export let hypot = (x: Double, y: Double) -> Double {
  sqrt(x * x + y * y)
}

export let degrees = (rad: Double) -> Double {
  rad * 180.0 / pi
}

export let radians = (deg: Double) -> Double {
  deg * pi / 180.0
}
