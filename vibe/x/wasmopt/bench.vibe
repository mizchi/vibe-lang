//# Imports

import ./index.vibe {
  strip_custom_sections, count_functions, section_sizes,
  optimize_code_section, build_call_graph, find_reachable,
  dce, optimize
}

//# Functions

let make_bytes = (values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

let module_const_fold = () -> Bytes {
  make_bytes([
    0, 97, 115, 109, 1, 0, 0, 0,
    1, 5, 1, 96, 0, 1, 127,
    3, 2, 1, 0,
    7, 8, 1, 4, 109, 97, 105, 110, 0, 0,
    10, 9, 1, 7, 0, 65, 3, 65, 4, 106, 11
  ])
}

let module_unreachable = () -> Bytes {
  make_bytes([
    0, 97, 115, 109, 1, 0, 0, 0,
    1, 5, 1, 96, 0, 1, 127,
    3, 3, 2, 0, 0,
    7, 8, 1, 4, 109, 97, 105, 110, 0, 0,
    10, 11, 2, 4, 0, 65, 42, 11, 4, 0, 65, 42, 11
  ])
}

//# Misc

bench "wasmopt/count_functions" {
  let _ = count_functions(module_const_fold())
}

bench "wasmopt/section_sizes" {
  let _ = section_sizes(module_const_fold())
}

bench "wasmopt/optimize_code_section" {
  let _ = optimize_code_section(module_const_fold())
}

bench "wasmopt/build_call_graph" {
  let _ = build_call_graph(module_unreachable())
}

bench "wasmopt/find_reachable" {
  let _ = find_reachable(module_unreachable())
}

bench "wasmopt/dce" {
  let _ = dce(module_unreachable())
}

bench "wasmopt/optimize" {
  let _ = optimize(module_const_fold())
}
