//# Imports

import ./index.vibe {
  minify_fast, binary_size, count_functions, count_exports, count_types,
  section_sizes, strip_custom_sections
}

//# Misc

// zlib.wasm: 171100 bytes
// minify_fast → 72020 bytes (wasmtime validated ✅)
// Reference: wite(-O1)=69644, wasm-opt(-Oz)=66146

test "zlib.wasm is valid" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/zlib.wasm")
  assert(binary_size(bytes) == 171100)
  assert(bytes[0] == 0)
  assert(bytes[4] == 1)
}

test "zlib.wasm strip custom ~72K" {
  let stripped = strip_custom_sections(Fs::read_bytes("vibe/x/wasmopt/zlib.wasm"))
  assert(binary_size(stripped) < 73000)
  assert(binary_size(stripped) > 71000)
}

test "zlib.wasm sections" {
  assert(Array::length(section_sizes(Fs::read_bytes("vibe/x/wasmopt/zlib.wasm"))) >= 8)
}

test "zlib.wasm counts" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/zlib.wasm")
  assert(count_functions(bytes) > 100)
  assert(count_exports(bytes) > 0)
}

test "zlib.wasm minify_fast valid" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/zlib.wasm")
  let opt = minify_fast(bytes)
  assert(binary_size(opt) == 72020)
  assert(opt[0] == 0)
  assert(opt[4] == 1)
  assert(count_exports(opt) == count_exports(bytes))
  assert(count_functions(opt) == count_functions(bytes))
}

test "zlib.wasm minify_fast preserves all functions" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/zlib.wasm")
  let opt = minify_fast(bytes)
  assert(count_functions(opt) > 100)
  assert(count_types(opt) > 0)
  assert(Array::length(section_sizes(opt)) >= 4)
}
