// WASM Binary Optimizer
// Performs binary-level optimizations on WASM modules
// Includes peephole optimizations, call graph DCE, and more.

//# Functions

// === LEB128 ===

let read_uleb128 = (buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result | ((byte & 0x7F) << shift)
    i = i + 1
    if (byte & 0x80) == 0 { done = true }
    else { shift = shift + 7 }
  }
  (result, i)
}

let write_uleb128 = (buf: Bytes, n: Int) -> Unit {
  let mut val = n
  let mut more = true
  while more {
    let byte = val & 0x7F
    val = (val >> 7) & ((1 << 25) - 1)
    if val == 0 {
      Bytes::push(buf, byte)
      more = false
    } else {
      Bytes::push(buf, byte | 0x80)
    }
  }
}

let read_sleb128 = (buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result | ((byte & 0x7F) << shift)
    shift = shift + 7
    i = i + 1
    if (byte & 0x80) == 0 {
      if (byte & 0x40) > 0 { result = result | ((-1) << shift) }
      done = true
    }
  }
  (result, i)
}

let write_sleb128 = (buf: Bytes, n: Int) -> Unit {
  let mut val = n
  let mut more = true
  while more {
    let byte = val & 0x7F
    val = val >> 7
    if ((val == 0) && ((byte & 0x40) == 0)) || ((val == (-1)) && ((byte & 0x40) > 0)) {
      Bytes::push(buf, byte)
      more = false
    } else {
      Bytes::push(buf, byte | 0x80)
    }
  }
}

// Read name string
let read_name = (bytes: Bytes, offset: Int) -> (String, Int) {
  let (name_len, pos) = read_uleb128(bytes, offset)
  let mut s = ""
  let mut i = 0
  while i < name_len {
    s = String::concat(s, String::from_char_code(bytes[pos + i]))
    i = i + 1
  }
  (s, pos + name_len)
}

// === Section helpers ===

// List sections: (id, content_offset, content_size)
let list_sections = (bytes: Bytes) -> Array[(Int, Int, Int)] {
  let len = Bytes::length(bytes)
  let result = Array::slice([(0, 0, 0)], 0, 0)
  if len < 8 { result }
  else {
    let mut i = 8
    while i < len {
      let sec_id = bytes[i]
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len { i = len }
      else {
        Array::push(result, (sec_id, content_start, sec_size))
        i = sec_end
      }
    }
    result
  }
}

// Copy bytes range
let copy_bytes = (src: Bytes, start: Int, end_pos: Int) -> Bytes {
  Bytes::slice(src, start, end_pos)
}

// Write section to output buffer
let emit_section = (out: Bytes, sec_id: Int, content: Bytes) -> Unit {
  Bytes::push(out, sec_id)
  write_uleb128(out, Bytes::length(content))
  let mut i = 0
  while i < Bytes::length(content) {
    Bytes::push(out, content[i])
    i = i + 1
  }
}

// === Strip custom sections ===

// Remove all custom sections (id=0) from a WASM binary.
// Useful for reducing binary size.
export let strip_custom_sections = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let out = Bytes::new()
    // Copy header
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    // Copy non-custom sections
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid != 0 {
        // Find raw section start (section id byte)
        // We need to reconstruct: id + size_leb + content
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

// === Strip specific named custom section ===

export let strip_named_section = (bytes: Bytes, name: String) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      let mut keep = true
      if sid == 0 {
        // Check name
        let (sec_name, _) = read_name(bytes, off)
        if sec_name == name { keep = false }
      }
      if keep {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

// === Remove unused exports ===

// Keep only the specified export names. Rewrites the export section.
export let filter_exports = (bytes: Bytes, keep_names: Array[String]) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 7 {
        // Rewrite export section
        let new_content = rewrite_exports(bytes, off, sz, keep_names)
        emit_section(out, 7, new_content)
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

let rewrite_exports = (bytes: Bytes, offset: Int, size: Int, keep_names: Array[String]) -> Bytes {
  let end_pos = offset + size
  let kept = Array::slice([("", 0, 0)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (name, np) = read_name(bytes, pos)
    pos = np
    if pos < end_pos {
      let kind = bytes[pos]
      pos = pos + 1
      let (index, np2) = read_uleb128(bytes, pos)
      pos = np2
      // Check if name is in keep list
      if array_contains_str(keep_names, name) {
        Array::push(kept, (name, kind, index))
      }
    }
    i = i + 1
  }
  // Emit new export section content
  let out = Bytes::new()
  write_uleb128(out, Array::length(kept))
  let mut k = 0
  while k < Array::length(kept) {
    let (name, kind, index) = Array::get(kept, k)
    write_uleb128(out, String::length(name))
    let mut ci = 0
    while ci < String::length(name) {
      Bytes::push(out, String::char_code_at(name, ci))
      ci = ci + 1
    }
    Bytes::push(out, kind)
    write_uleb128(out, index)
    k = k + 1
  }
  out
}

let array_contains_str = (arr: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while (i < Array::length(arr)) && (found == false) {
    if Array::get(arr, i) == target { found = true }
    i = i + 1
  }
  found
}

// === Remove empty data segments ===

// Removes data segments with zero-length data.
export let strip_empty_data = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if (sid == 11) && (sz > 0) {
        // Data section: check for empty segments
        let new_content = filter_data_segments(bytes, off, sz)
        if Bytes::length(new_content) > 1 {
          emit_section(out, 11, new_content)
        }
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

let filter_data_segments = (bytes: Bytes, offset: Int, size: Int) -> Bytes {
  let end_pos = offset + size
  // Parse segments, keep non-empty ones
  let segments = Array::slice([(0, 0, 0)], 0, 0)  // (seg_start, seg_end, data_len)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let seg_start = pos
    let mode = bytes[pos]
    pos = pos + 1
    if mode == 0 {
      // active: skip init expr
      while (pos < end_pos) && (bytes[pos] != 0x0B) { pos = pos + 1 }
      if pos < end_pos { pos = pos + 1 }
      let (data_len, dp) = read_uleb128(bytes, pos)
      pos = dp + data_len
      Array::push(segments, (seg_start, pos, data_len))
    } else {
      if mode == 1 {
        let (data_len, dp) = read_uleb128(bytes, pos)
        pos = dp + data_len
        Array::push(segments, (seg_start, pos, data_len))
      } else {
        // mode 2 or unknown
        pos = end_pos
      }
    }
    i = i + 1
  }
  // Rebuild with non-empty segments
  let out = Bytes::new()
  let mut kept_count = 0
  let mut si = 0
  while si < Array::length(segments) {
    let (_, _, data_len) = Array::get(segments, si)
    if data_len > 0 { kept_count = kept_count + 1 }
    si = si + 1
  }
  write_uleb128(out, kept_count)
  si = 0
  while si < Array::length(segments) {
    let (seg_start, seg_end, data_len) = Array::get(segments, si)
    if data_len > 0 {
      let mut j = seg_start
      while j < seg_end { Bytes::push(out, bytes[j]); j = j + 1 }
    }
    si = si + 1
  }
  out
}

// === Merge consecutive data segments ===

// Count exported functions
export let count_exports = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut count = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 7 {
      let (cnt, _) = read_uleb128(bytes, off)
      count = cnt
    }
    s = s + 1
  }
  count
}

// Count functions (imported + defined)
export let count_functions = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut import_funcs = 0
  let mut defined_funcs = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      // Import section: count func imports
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        // skip module name
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        // skip field name
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (_, np) = read_uleb128(bytes, pos); pos = np
            import_funcs = import_funcs + 1
          } else {
            // skip other import types
            pos = end_pos
          }
        }
        i = i + 1
      }
    } else {
      if sid == 3 {
        // Function section
        let (cnt, _) = read_uleb128(bytes, off)
        defined_funcs = cnt
      }
    }
    s = s + 1
  }
  import_funcs + defined_funcs
}

// Count types
export let count_types = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut count = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, _) = Array::get(sections, s)
    if sid == 1 {
      let (cnt, _) = read_uleb128(bytes, off)
      count = cnt
    }
    s = s + 1
  }
  count
}

// Binary size
export let binary_size = (bytes: Bytes) -> Int {
  Bytes::length(bytes)
}

// Section sizes: array of (section_id, size)
export let section_sizes = (bytes: Bytes) -> Array[(Int, Int)] {
  let sections = list_sections(bytes)
  let result = Array::slice([(0, 0)], 0, 0)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, _, sz) = Array::get(sections, s)
    Array::push(result, (sid, sz))
    s = s + 1
  }
  result
}

// === Peephole Optimization ===

// WASM opcodes
// i32.const = 0x41, i64.const = 0x42
// i32.add = 0x6A, i32.sub = 0x6B, i32.mul = 0x6C
// i32.and = 0x71, i32.or = 0x72, i32.xor = 0x73
// local.get = 0x20
// drop = 0x1A

// Decode a single instruction starting at pos in body.
// Returns (opcode, immediate_value, next_pos).
// For i32.const: opcode=0x41, immediate=the const value.
// For local.get: opcode=0x20, immediate=local index.
// For others: opcode=byte, immediate=0.
let decode_instr = (body: Bytes, pos: Int) -> (Int, Int, Int) {
  let op = body[pos]
  if op == 0x41 {
    // i32.const: signed LEB128 immediate
    let (val, next) = read_sleb128(body, pos + 1)
    (0x41, val, next)
  } else {
    if op == 0x42 {
      // i64.const: signed LEB128 immediate
      let (val, next) = read_sleb128(body, pos + 1)
      (0x42, val, next)
    } else {
      if op == 0x20 {
        // local.get: unsigned LEB128 immediate
        let (val, next) = read_uleb128(body, pos + 1)
        (0x20, val, next)
      } else {
        if op == 0x21 {
          // local.set: unsigned LEB128 immediate
          let (val, next) = read_uleb128(body, pos + 1)
          (0x21, val, next)
        } else {
          if op == 0x22 {
            // local.tee: unsigned LEB128 immediate
            let (val, next) = read_uleb128(body, pos + 1)
            (0x22, val, next)
          } else {
            if op == 0x23 {
              // global.get: unsigned LEB128 immediate
              let (val, next) = read_uleb128(body, pos + 1)
              (0x23, val, next)
            } else {
              if op == 0x24 {
                // global.set: unsigned LEB128 immediate
                let (val, next) = read_uleb128(body, pos + 1)
                (0x24, val, next)
              } else {
                if op == 0x10 {
                  // call: unsigned LEB128 immediate
                  let (val, next) = read_uleb128(body, pos + 1)
                  (0x10, val, next)
                } else {
                  if op == 0x0C {
                    // br: unsigned LEB128 immediate
                    let (val, next) = read_uleb128(body, pos + 1)
                    (0x0C, val, next)
                  } else {
                    if op == 0x0D {
                      // br_if: unsigned LEB128 immediate
                      let (val, next) = read_uleb128(body, pos + 1)
                      (0x0D, val, next)
                    } else {
                      if (op == 0x02) || (op == 0x03) || (op == 0x04) {
                        // block/loop/if: blocktype (sleb128)
                        let (val, next) = read_sleb128(body, pos + 1)
                        (op, val, next)
                      } else {
                        if (op == 0x28) || (op == 0x29) || (op == 0x2A) || (op == 0x2B) ||
                           (op == 0x2C) || (op == 0x2D) || (op == 0x2E) || (op == 0x2F) ||
                           (op == 0x30) || (op == 0x31) || (op == 0x32) || (op == 0x33) ||
                           (op == 0x34) || (op == 0x35) ||
                           (op == 0x36) || (op == 0x37) || (op == 0x38) || (op == 0x39) ||
                           (op == 0x3A) || (op == 0x3B) || (op == 0x3C) || (op == 0x3D) || (op == 0x3E) {
                          // memory load/store: memarg = align(uleb) + offset(uleb)
                          let (_, p1) = read_uleb128(body, pos + 1)
                          let (_, next) = read_uleb128(body, p1)
                          (op, 0, next)
                        } else {
                          if op == 0x11 {
                            // call_indirect: type_idx(uleb) + table_idx(uleb)
                            let (_, p1) = read_uleb128(body, pos + 1)
                            let (_, next) = read_uleb128(body, p1)
                            (op, 0, next)
                          } else {
                            if op == 0x0E {
                              // br_table: count(uleb) + count labels(uleb each) + default(uleb)
                              let (cnt, p1) = read_uleb128(body, pos + 1)
                              let mut pp = p1
                              let mut bi = 0
                              while bi <= cnt {
                                let (_, np) = read_uleb128(body, pp)
                                pp = np
                                bi = bi + 1
                              }
                              (op, 0, pp)
                            } else {
                              if (op == 0x3F) || (op == 0x40) {
                                // memory.size / memory.grow: 1 byte index (0x00)
                                (op, 0, pos + 2)
                              } else {
                                if op == 0xFC {
                                  // multi-byte prefix (memory.copy etc): skip next uleb
                                  let (sub_op, p1) = read_uleb128(body, pos + 1)
                                  if (sub_op == 10) || (sub_op == 11) {
                                    // memory.copy / memory.fill: 2 index bytes
                                    (op, 0, p1 + 2)
                                  } else {
                                    (op, 0, p1)
                                  }
                                } else {
                                  // Single-byte instruction
                                  (op, 0, pos + 1)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// Emit an instruction to a Bytes buffer.
// NOTE: for complex opcodes (memarg, br_table, call_indirect, block/loop/if)
// we use the raw-copy path in peephole_body, not this function.
let emit_instr = (out: Bytes, op: Int, imm: Int) -> Unit {
  if op == 0x41 {
    Bytes::push(out, 0x41)
    write_sleb128(out, imm)
  } else {
    if op == 0x42 {
      Bytes::push(out, 0x42)
      write_sleb128(out, imm)
    } else {
      if (op == 0x20) || (op == 0x21) || (op == 0x22) || (op == 0x23) || (op == 0x24) || (op == 0x10) || (op == 0x0C) || (op == 0x0D) {
        Bytes::push(out, op)
        write_uleb128(out, imm)
      } else {
        if (op == 0x02) || (op == 0x03) || (op == 0x04) {
          // block/loop/if: blocktype (sleb128)
          Bytes::push(out, op)
          write_sleb128(out, imm)
        } else {
          Bytes::push(out, op)
        }
      }
    }
  }
}

// Check if an opcode is an i32 binary arithmetic/logic op
let is_i32_binop = (op: Int) -> Bool {
  (op == 0x6A) || (op == 0x6B) || (op == 0x6C) || (op == 0x71) || (op == 0x72) || (op == 0x73)
}

// Apply i32 binary op to two constants
let apply_i32_binop = (op: Int, a: Int, b: Int) -> Int {
  if op == 0x6A { a + b }
  else {
    if op == 0x6B { a - b }
    else {
      if op == 0x6C { a * b }
      else {
        if op == 0x71 { a & b }
        else {
          if op == 0x72 { a | b }
          else { a ^ b }
        }
      }
    }
  }
}

// Check if op+immediate is an identity operation (x op imm = x).
// i32.add 0, i32.sub 0, i32.mul 1, i32.or 0, i32.xor 0 are identities.
// i32.and with all-1s would also be identity but we skip that for simplicity.
let is_identity_op = (op: Int, imm: Int) -> Bool {
  if op == 0x6A { imm == 0 }
  else {
    if op == 0x6B { imm == 0 }
    else {
      if op == 0x6C { imm == 1 }
      else {
        if op == 0x72 { imm == 0 }
        else {
          if op == 0x73 { imm == 0 }
          else { false }
        }
      }
    }
  }
}

// Parse a function body into array of (opcode, immediate) pairs
let parse_body_instrs = (body: Bytes, start: Int, end_pos: Int) -> Array[(Int, Int)] {
  let instrs = Array::slice([(0, 0)], 0, 0)
  let mut pos = start
  while pos < end_pos {
    let (op, imm, next) = decode_instr(body, pos)
    Array::push(instrs, (op, imm))
    pos = next
  }
  instrs
}

// Parse a function body into array of (start_offset, end_offset, opcode) spans.
// Each span points to the raw bytes of the instruction in the body.
let parse_body_spans = (body: Bytes, start: Int, end_pos: Int) -> Array[(Int, Int, Int)] {
  let spans = Array::slice([(0, 0, 0)], 0, 0)
  let mut pos = start
  while pos < end_pos {
    let (op, _, next) = decode_instr(body, pos)
    Array::push(spans, (pos, next, op))
    pos = next
  }
  spans
}

// Read the signed LEB128 immediate from an i32.const span
let span_read_sleb_imm = (body: Bytes, span_start: Int) -> Int {
  let (val, _) = read_sleb128(body, span_start + 1)
  val
}

// Read the unsigned LEB128 immediate from an instruction span
let span_read_uleb_imm = (body: Bytes, span_start: Int) -> Int {
  let (val, _) = read_uleb128(body, span_start + 1)
  val
}

// Copy raw bytes from body[start..end) to output
let copy_span_bytes = (out: Bytes, body: Bytes, start: Int, end_pos: Int) -> Unit {
  let mut k = start
  while k < end_pos {
    Bytes::push(out, body[k])
    k = k + 1
  }
}

// Try 2-instruction peephole patterns at position i.
// Returns true and emits replacement to out if matched, false otherwise.
let peephole_try2 = (out: Bytes, body: Bytes, spans: Array[(Int, Int, Int)], i: Int, n: Int) -> Bool {
  if (i + 1) >= n { false }
  else {
    let (s_i, _, op_i) = Array::get(spans, i)
    let (s_next, _, op_next) = Array::get(spans, i + 1)
    // local.set X, local.get X -> local.tee X
    if (op_i == 0x21) && (op_next == 0x20) {
      let imm_i = span_read_uleb_imm(body, s_i)
      let imm_next = span_read_uleb_imm(body, s_next)
      if imm_i == imm_next {
        Bytes::push(out, 0x22)
        write_uleb128(out, imm_i)
        true
      } else { false }
    } else {
      // const 0, br_if -> remove (never-taken branch)
      if (op_i == 0x41) && (op_next == 0x0D) {
        let imm_i = span_read_sleb_imm(body, s_i)
        if imm_i == 0 { true }
        else { false }
      } else {
        // eqz, eqz -> remove (double negation)
        if (op_i == 0x45) && (op_next == 0x45) { true }
        else {
          // dead drop elimination: i32.const X, drop OR local.get N, drop
          if ((op_i == 0x41) || (op_i == 0x20)) && (op_next == 0x1A) { true }
          else { false }
        }
      }
    }
  }
}

// Peephole optimize using byte spans.
// Takes spans and raw body bytes. Returns optimized bytes (code portion only, no locals prefix, no end byte).
let peephole_spans = (body: Bytes, spans: Array[(Int, Int, Int)]) -> (Bytes, Bool) {
  let n = Array::length(spans)
  let out = Bytes::new()
  let mut changed = false
  let mut i = 0
  while i < n {
    let (s_i, e_i, op_i) = Array::get(spans, i)
    if (i + 2) < n {
      let (s_j, _, op_j) = Array::get(spans, i + 1)
      let (_, _, op_k) = Array::get(spans, i + 2)
      // Constant folding: i32.const A, i32.const B, binop
      if (op_i == 0x41) && (op_j == 0x41) && (is_i32_binop(op_k)) {
        let imm_i = span_read_sleb_imm(body, s_i)
        let imm_j = span_read_sleb_imm(body, s_j)
        let folded = apply_i32_binop(op_k, imm_i, imm_j)
        Bytes::push(out, 0x41)
        write_sleb128(out, folded)
        i = i + 3
        changed = true
      } else {
        // Identity elimination: x, i32.const IMM, binop
        if (op_j == 0x41) && (is_i32_binop(op_k)) {
          let imm_j = span_read_sleb_imm(body, s_j)
          if is_identity_op(op_k, imm_j) {
            // Keep only span i (raw copy)
            copy_span_bytes(out, body, s_i, e_i)
            i = i + 3
            changed = true
          } else {
            // No 3-instr pattern; try 2-instr
            let matched2 = peephole_try2(out, body, spans, i, n)
            if matched2 {
              i = i + 2
              changed = true
            } else {
              copy_span_bytes(out, body, s_i, e_i)
              i = i + 1
            }
          }
        } else {
          // No 3-instr pattern; try 2-instr
          let matched2 = peephole_try2(out, body, spans, i, n)
          if matched2 {
            i = i + 2
            changed = true
          } else {
            copy_span_bytes(out, body, s_i, e_i)
            i = i + 1
          }
        }
      }
    } else {
      // Less than 3 instructions remaining; try 2-instr
      let matched2 = peephole_try2(out, body, spans, i, n)
      if matched2 {
        i = i + 2
        changed = true
      } else {
        copy_span_bytes(out, body, s_i, e_i)
        i = i + 1
      }
    }
  }
  (out, changed)
}

// Peephole optimize an instruction stream (legacy, kept for compatibility).
// Returns optimized array of (opcode, immediate) pairs.
let peephole_instrs = (instrs: Array[(Int, Int)]) -> Array[(Int, Int)] {
  let mut changed = true
  let mut current = instrs
  while changed {
    changed = false
    let n = Array::length(current)
    let result = Array::slice([(0, 0)], 0, 0)
    let mut i = 0
    while i < n {
      let (op_i, imm_i) = Array::get(current, i)
      if (i + 2) < n {
        // Check for constant folding: i32.const A, i32.const B, binop
        let (op_j, imm_j) = Array::get(current, i + 1)
        let (op_k, _) = Array::get(current, i + 2)
        if (op_i == 0x41) && (op_j == 0x41) && (is_i32_binop(op_k)) {
          // Fold: replace with single i32.const
          let folded = apply_i32_binop(op_k, imm_i, imm_j)
          Array::push(result, (0x41, folded))
          i = i + 3
          changed = true
        } else {
          // Check identity elimination: x, i32.const IMM, binop
          if (op_j == 0x41) && (is_i32_binop(op_k)) && (is_identity_op(op_k, imm_j)) {
            // Drop the const and the binop, keep x
            Array::push(result, (op_i, imm_i))
            i = i + 3
            changed = true
          } else {
            // No 3-instr pattern; check 2-instr patterns
            let mut matched2 = false
            if (i + 1) < n {
              let (op_next, imm_next) = Array::get(current, i + 1)
              // local.set X, local.get X -> local.tee X
              if (op_i == 0x21) && (op_next == 0x20) && (imm_i == imm_next) {
                Array::push(result, (0x22, imm_i))
                i = i + 2
                changed = true
                matched2 = true
              } else {
                // const 0, br_if -> remove (never-taken branch)
                if (op_i == 0x41) && (imm_i == 0) && (op_next == 0x0D) {
                  i = i + 2
                  changed = true
                  matched2 = true
                } else {
                  // eqz, eqz -> remove (double negation)
                  if (op_i == 0x45) && (op_next == 0x45) {
                    i = i + 2
                    changed = true
                    matched2 = true
                  } else {
                    // dead drop elimination: i32.const X, drop OR local.get N, drop
                    if ((op_i == 0x41) || (op_i == 0x20)) && (op_next == 0x1A) {
                      i = i + 2
                      changed = true
                      matched2 = true
                    } else { () }
                  }
                }
              }
            } else { () }
            if matched2 == false {
              Array::push(result, (op_i, imm_i))
              i = i + 1
            } else { () }
          }
        }
      } else {
        if (i + 1) < n {
          let (op_next, imm_next) = Array::get(current, i + 1)
          // local.set X, local.get X -> local.tee X
          if (op_i == 0x21) && (op_next == 0x20) && (imm_i == imm_next) {
            Array::push(result, (0x22, imm_i))
            i = i + 2
            changed = true
          } else {
            // const 0, br_if -> remove
            if (op_i == 0x41) && (imm_i == 0) && (op_next == 0x0D) {
              i = i + 2
              changed = true
            } else {
              // eqz, eqz -> remove
              if (op_i == 0x45) && (op_next == 0x45) {
                i = i + 2
                changed = true
              } else {
                // dead drop elimination
                if ((op_i == 0x41) || (op_i == 0x20)) && (op_next == 0x1A) {
                  i = i + 2
                  changed = true
                } else {
                  Array::push(result, (op_i, imm_i))
                  i = i + 1
                }
              }
            }
          }
        } else {
          Array::push(result, (op_i, imm_i))
          i = i + 1
        }
      }
    }
    current = result
  }
  current
}

// Peephole optimize a single function body (raw bytes).
// Input: the body bytes (locals + code, ending with 0x0B).
// Returns optimized body bytes.
// Uses byte-span approach: instructions are represented as spans into the raw
// bytes, and unmatched instructions are raw-copied rather than reconstructed.
let peephole_body = (body: Bytes) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 { copy_bytes(body, 0, body_len) }
  else {
    // Skip locals declaration
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      // skip the type byte
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    // The last byte should be 0x0B (end)
    let code_end = body_len - 1

    if code_start >= code_end {
      // No code to optimize
      copy_bytes(body, 0, body_len)
    } else {
      // Multi-pass: keep optimizing until no changes (max 10 passes)
      let mut current_body = body
      let mut current_start = code_start
      let mut current_end = code_end
      let mut keep_going = true
      let mut pass_count = 0
      while keep_going && (pass_count < 3) {
        pass_count = pass_count + 1
        let spans = parse_body_spans(current_body, current_start, current_end)
        let (optimized_code, did_change) = peephole_spans(current_body, spans)
        if did_change {
          // Build new body: locals prefix + optimized code + end byte
          let new_body = Bytes::new()
          let mut ci = 0
          while ci < current_start {
            Bytes::push(new_body, current_body[ci])
            ci = ci + 1
          }
          let opt_len = Bytes::length(optimized_code)
          let mut oi = 0
          while oi < opt_len {
            Bytes::push(new_body, optimized_code[oi])
            oi = oi + 1
          }
          Bytes::push(new_body, 0x0B)
          // For next iteration, code_start stays the same (locals prefix unchanged)
          current_body = new_body
          current_end = Bytes::length(new_body) - 1
        } else {
          keep_going = false
        }
      }
      current_body
    }
  }
}

// === Optimize code section ===

// Apply peephole optimizations to all function bodies in the code section.
export let optimize_code_section = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 10 {
        // Code section: optimize each function body
        let new_content = optimize_code_section_content(bytes, off, sz)
        emit_section(out, 10, new_content)
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

let optimize_code_section_content = (bytes: Bytes, offset: Int, size: Int) -> Bytes {
  let end_pos = offset + size
  let (func_count, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  // Parse all function bodies
  let bodies = Array::slice([(Bytes::new())], 0, 0)
  let mut fi = 0
  while (fi < func_count) && (pos < end_pos) {
    let (body_size, bp) = read_uleb128(bytes, pos)
    let body = copy_bytes(bytes, bp, bp + body_size)
    let optimized = peephole_body(body)
    Array::push(bodies, optimized)
    pos = bp + body_size
    fi = fi + 1
  }
  // Rebuild code section content
  let out = Bytes::new()
  write_uleb128(out, Array::length(bodies))
  let mut bi = 0
  while bi < Array::length(bodies) {
    let body = Array::get(bodies, bi)
    write_uleb128(out, Bytes::length(body))
    let mut j = 0
    while j < Bytes::length(body) {
      Bytes::push(out, body[j])
      j = j + 1
    }
    bi = bi + 1
  }
  out
}

// === Call Graph DCE ===

// Count imported functions
let count_import_funcs = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut import_funcs = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (_, np) = read_uleb128(bytes, pos); pos = np
            import_funcs = import_funcs + 1
          } else {
            if kind == 1 {
              // table import: skip limits
              let (_, np) = read_uleb128(bytes, pos); pos = np
              let flag = bytes[pos]; pos = pos + 1
              let (_, np2) = read_uleb128(bytes, pos); pos = np2
              if flag == 1 {
                let (_, np3) = read_uleb128(bytes, pos); pos = np3
              }
            } else {
              if kind == 2 {
                // memory import: skip limits
                let flag = bytes[pos]; pos = pos + 1
                let (_, np2) = read_uleb128(bytes, pos); pos = np2
                if flag == 1 {
                  let (_, np3) = read_uleb128(bytes, pos); pos = np3
                }
              } else {
                if kind == 3 {
                  // global import: skip type + mutability
                  pos = pos + 2
                } else {
                  pos = end_pos
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  import_funcs
}

// Build call graph from code section.
// Returns Array[(Int, Array[Int])]: (func_index, callees).
// func_index is the absolute function index (import_count + local_index).
export let build_call_graph = (bytes: Bytes) -> Array[(Int, Array[Int])] {
  let result = Array::slice([(0, Array::slice([(0)], 0, 0))], 0, 0)
  let import_count = count_import_funcs(bytes)
  // Compute total function count for bitset sizing
  let total_funcs = count_functions(bytes)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 10 {
      let end_pos = off + sz
      let (func_count, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut fi = 0
      while (fi < func_count) && (pos < end_pos) {
        let func_idx = import_count + fi
        let (body_size, bp) = read_uleb128(bytes, pos)
        let body_end = bp + body_size
        // Scan body for call instructions
        let callees = Array::slice([(0)], 0, 0)
        let callee_seen = FixedArray::make(total_funcs + 1, 0)
        let body = copy_bytes(bytes, bp, body_end)
        let body_len = Bytes::length(body)
        let mut bpos = 0
        // Skip locals
        let (local_count, lp) = read_uleb128(body, 0)
        bpos = lp
        let mut lc = 0
        while lc < local_count {
          let (_, tp) = read_uleb128(body, bpos)
          bpos = tp + 1
          lc = lc + 1
        }
        // Scan instructions
        while bpos < body_len {
          let (op, imm, next) = decode_instr(body, bpos)
          if op == 0x10 {
            // call instruction: imm is the callee index
            if (imm >= 0) && (imm <= total_funcs) {
              if FixedArray::get(callee_seen, imm) == 0 {
                FixedArray::set(callee_seen, imm, 1)
                Array::push(callees, imm)
              }
            } else {
              // Out-of-range callee, keep with linear check
              if array_contains_int(callees, imm) == false {
                Array::push(callees, imm)
              }
            }
          }
          bpos = next
        }
        Array::push(result, (func_idx, callees))
        pos = body_end
        fi = fi + 1
      }
    }
    s = s + 1
  }
  result
}

// Get export function indices from export section
let get_export_func_indices = (bytes: Bytes) -> Array[Int] {
  let result = Array::slice([(0)], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 7 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (_, np) = read_name(bytes, pos)
        pos = np
        if pos < end_pos {
          let kind = bytes[pos]
          pos = pos + 1
          let (index, np2) = read_uleb128(bytes, pos)
          pos = np2
          if kind == 0 {
            // Function export
            Array::push(result, index)
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  result
}

let array_contains_int = (arr: Array[Int], target: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while (i < Array::length(arr)) && (found == false) {
    if Array::get(arr, i) == target { found = true }
    i = i + 1
  }
  found
}

// Find all reachable function indices from a set of root indices via BFS.
export let find_reachable = (bytes: Bytes) -> Array[Int] {
  let graph = build_call_graph(bytes)
  let roots = get_export_func_indices(bytes)
  // Compute max function index for bitset sizing
  let import_count = count_import_funcs(bytes)
  let mut max_func_idx = import_count
  let mut gi2 = 0
  while gi2 < Array::length(graph) {
    let (func_idx, callees) = Array::get(graph, gi2)
    if func_idx >= max_func_idx { max_func_idx = func_idx + 1 }
    let mut ci2 = 0
    while ci2 < Array::length(callees) {
      let callee = Array::get(callees, ci2)
      if callee >= max_func_idx { max_func_idx = callee + 1 }
      ci2 = ci2 + 1
    }
    gi2 = gi2 + 1
  }
  let visited = FixedArray::make(max_func_idx + 1, 0)
  let reachable = Array::slice([(0)], 0, 0)
  // BFS queue: start from roots
  let queue = Array::slice([(0)], 0, 0)
  let mut ri = 0
  while ri < Array::length(roots) {
    let root = Array::get(roots, ri)
    if (root >= 0) && (root <= max_func_idx) && (FixedArray::get(visited, root) == 0) {
      FixedArray::set(visited, root, 1)
      Array::push(queue, root)
      Array::push(reachable, root)
    }
    ri = ri + 1
  }
  let mut qi = 0
  while qi < Array::length(queue) {
    let current = Array::get(queue, qi)
    // Find callees in graph
    let mut gi = 0
    while gi < Array::length(graph) {
      let (func_idx, callees) = Array::get(graph, gi)
      if func_idx == current {
        let mut ci = 0
        while ci < Array::length(callees) {
          let callee = Array::get(callees, ci)
          if (callee >= 0) && (callee <= max_func_idx) && (FixedArray::get(visited, callee) == 0) {
            FixedArray::set(visited, callee, 1)
            Array::push(reachable, callee)
            Array::push(queue, callee)
          }
          ci = ci + 1
        }
      }
      gi = gi + 1
    }
    qi = qi + 1
  }
  reachable
}

// Dead code elimination: replace unreachable function bodies with `unreachable; end`.
export let dce = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let reachable = find_reachable(bytes)
    let import_count = count_import_funcs(bytes)
    // Build reachable bitset for O(1) lookup
    let total_funcs = count_functions(bytes)
    let reachable_flags = FixedArray::make(total_funcs + 1, 0)
    let mut ri = 0
    while ri < Array::length(reachable) {
      let idx = Array::get(reachable, ri)
      if (idx >= 0) && (idx <= total_funcs) {
        FixedArray::set(reachable_flags, idx, 1)
      }
      ri = ri + 1
    }
    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 10 {
        // DCE code section inline to avoid forward reference issue
        let end_pos2 = off + sz
        let (func_count2, pos02) = read_uleb128(bytes, off)
        let mut pos2 = pos02
        let bodies2 = Array::slice([(Bytes::new())], 0, 0)
        let mut fi2 = 0
        while (fi2 < func_count2) && (pos2 < end_pos2) {
          let func_idx2 = import_count + fi2
          let (body_size2, bp2) = read_uleb128(bytes, pos2)
          if (func_idx2 >= 0) && (func_idx2 <= total_funcs) && (FixedArray::get(reachable_flags, func_idx2) == 1) {
            let body2 = copy_bytes(bytes, bp2, bp2 + body_size2)
            Array::push(bodies2, body2)
          } else {
            let stub = Bytes::new()
            Bytes::push(stub, 0x00)
            Bytes::push(stub, 0x00)
            Bytes::push(stub, 0x0B)
            Array::push(bodies2, stub)
          }
          pos2 = bp2 + body_size2
          fi2 = fi2 + 1
        }
        let new_content = Bytes::new()
        write_uleb128(new_content, Array::length(bodies2))
        let mut bi2 = 0
        while bi2 < Array::length(bodies2) {
          let body2 = Array::get(bodies2, bi2)
          write_uleb128(new_content, Bytes::length(body2))
          let mut j2 = 0
          while j2 < Bytes::length(body2) {
            Bytes::push(new_content, body2[j2])
            j2 = j2 + 1
          }
          bi2 = bi2 + 1
        }
        emit_section(out, 10, new_content)
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

// === Full optimization pipeline ===

// Run all optimization passes: strip_custom -> peephole -> DCE.
export let optimize = (bytes: Bytes) -> Bytes {
  let step1 = strip_custom_sections(bytes)
  let step2 = optimize_code_section(step1)
  let step3 = dce(step2)
  step3
}

// === Coalesce locals ===

// Get param count for a function type at the given type section offset.
// Type entry format: 0x60 param_count param_types... result_count result_types...
let get_type_param_count = (bytes: Bytes, type_sec_off: Int, type_sec_sz: Int, type_idx: Int) -> Int {
  let end_pos = type_sec_off + type_sec_sz
  let (type_count, pos0) = read_uleb128(bytes, type_sec_off)
  let mut pos = pos0
  let mut ti = 0
  let mut result = 0
  while (ti < type_count) && (pos < end_pos) {
    // 0x60 = func type
    pos = pos + 1
    let (param_count, pp) = read_uleb128(bytes, pos)
    pos = pp + param_count
    let (result_count, rp) = read_uleb128(bytes, pos)
    pos = rp + result_count
    if ti == type_idx { result = param_count }
    else { () }
    ti = ti + 1
  }
  result
}

// Parse function section to get type indices for each function
let parse_func_type_indices = (bytes: Bytes) -> Array[Int] {
  let result = Array::slice([(0)], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 3 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (tidx, np) = read_uleb128(bytes, pos)
        Array::push(result, tidx)
        pos = np
        i = i + 1
      }
    } else { () }
    s = s + 1
  }
  result
}

// Coalesce locals: remove unused local declarations and remap indices.
export let coalesce_locals = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    // Find type section info
    let sections = list_sections(bytes)
    let mut type_sec_off = 0
    let mut type_sec_sz = 0
    let mut si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      if sid == 1 { type_sec_off = off; type_sec_sz = sz }
      else { () }
      si = si + 1
    }
    let func_type_indices = parse_func_type_indices(bytes)

    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      if sid == 10 {
        let new_content = coalesce_code_section(bytes, off, sz, type_sec_off, type_sec_sz, func_type_indices)
        emit_section(out, 10, new_content)
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      si = si + 1
    }
    out
  }
}

let coalesce_code_section = (bytes: Bytes, offset: Int, size: Int, type_sec_off: Int, type_sec_sz: Int, func_type_indices: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (func_count, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let bodies = Array::slice([(Bytes::new())], 0, 0)
  let mut fi = 0
  while (fi < func_count) && (pos < end_pos) {
    let (body_size, bp) = read_uleb128(bytes, pos)
    let body = copy_bytes(bytes, bp, bp + body_size)
    // Get param count for this function
    let param_count = if fi < Array::length(func_type_indices) {
      let tidx = Array::get(func_type_indices, fi)
      get_type_param_count(bytes, type_sec_off, type_sec_sz, tidx)
    } else { 0 }
    let optimized = coalesce_body(body, param_count)
    Array::push(bodies, optimized)
    pos = bp + body_size
    fi = fi + 1
  }
  // Rebuild
  let out = Bytes::new()
  write_uleb128(out, Array::length(bodies))
  let mut bi = 0
  while bi < Array::length(bodies) {
    let body = Array::get(bodies, bi)
    write_uleb128(out, Bytes::length(body))
    let mut j = 0
    while j < Bytes::length(body) {
      Bytes::push(out, body[j])
      j = j + 1
    }
    bi = bi + 1
  }
  out
}

let coalesce_body = (body: Bytes, param_count: Int) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 { copy_bytes(body, 0, body_len) }
  else {
    // Parse locals declaration
    let mut pos = 0
    let (local_decl_count, lp) = read_uleb128(body, 0)
    pos = lp
    // Collect local types: each entry is (count, type)
    let local_types = Array::slice([(0, 0)], 0, 0)
    let mut lc = 0
    while lc < local_decl_count {
      let (cnt, tp) = read_uleb128(body, pos)
      let ltype = body[tp]
      Array::push(local_types, (cnt, ltype))
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1

    // Expand local types to per-index type array
    // Index 0..param_count-1 are params, param_count..total-1 are locals
    let total_locals = param_count + expand_local_count(local_types)
    let local_type_arr = Array::slice([(0)], 0, 0)
    let mut li = 0
    // params (type doesn't matter for remapping, use placeholder)
    while li < param_count {
      Array::push(local_type_arr, (-1))
      li = li + 1
    }
    // declared locals
    let mut di = 0
    while di < Array::length(local_types) {
      let (cnt, ltype) = Array::get(local_types, di)
      let mut ci = 0
      while ci < cnt {
        Array::push(local_type_arr, ltype)
        ci = ci + 1
      }
      di = di + 1
    }

    // Scan code for used local indices (FixedArray bitset for O(1) lookup)
    let used_flags = FixedArray::make(total_locals + 1, 0)
    // Params are always used
    let mut pi = 0
    while pi < param_count {
      FixedArray::set(used_flags, pi, 1)
      pi = pi + 1
    }
    if code_start < code_end {
      let instrs = parse_body_instrs(body, code_start, code_end)
      let mut ii = 0
      while ii < Array::length(instrs) {
        let (op, imm) = Array::get(instrs, ii)
        if (op == 0x20) || (op == 0x21) || (op == 0x22) {
          if (imm >= 0) && (imm < total_locals) {
            FixedArray::set(used_flags, imm, 1)
          } else { () }
        } else { () }
        ii = ii + 1
      }
    } else { () }

    // Build old->new index map
    let index_map = Array::slice([(0)], 0, 0)
    let mut new_idx = 0
    let mut oi = 0
    while oi < total_locals {
      if FixedArray::get(used_flags, oi) == 1 {
        Array::push(index_map, new_idx)
        new_idx = new_idx + 1
      } else {
        Array::push(index_map, (-1))
      }
      oi = oi + 1
    }

    // Build new local declarations (only used non-param locals)
    // Group consecutive same-type locals
    let new_local_entries = Array::slice([(0, 0)], 0, 0)
    let mut nli = param_count
    while nli < total_locals {
      if FixedArray::get(used_flags, nli) == 1 {
        let ltype = Array::get(local_type_arr, nli)
        let nle_len = Array::length(new_local_entries)
        if nle_len > 0 {
          let (prev_cnt, prev_type) = Array::get(new_local_entries, nle_len - 1)
          if prev_type == ltype {
            Array::set(new_local_entries, nle_len - 1, (prev_cnt + 1, prev_type))
          } else {
            Array::push(new_local_entries, (1, ltype))
          }
        } else {
          Array::push(new_local_entries, (1, ltype))
        }
      } else { () }
      nli = nli + 1
    }

    // Rebuild body
    let out = Bytes::new()
    write_uleb128(out, Array::length(new_local_entries))
    let mut ei = 0
    while ei < Array::length(new_local_entries) {
      let (cnt, ltype) = Array::get(new_local_entries, ei)
      write_uleb128(out, cnt)
      Bytes::push(out, ltype)
      ei = ei + 1
    }

    // Rewrite instructions with remapped indices
    if code_start < code_end {
      let instrs = parse_body_instrs(body, code_start, code_end)
      let mut ii = 0
      while ii < Array::length(instrs) {
        let (op, imm) = Array::get(instrs, ii)
        if (op == 0x20) || (op == 0x21) || (op == 0x22) {
          let new_imm = if imm < Array::length(index_map) { Array::get(index_map, imm) } else { imm }
          emit_instr(out, op, new_imm)
        } else {
          emit_instr(out, op, imm)
        }
        ii = ii + 1
      }
    } else { () }
    Bytes::push(out, 0x0B)
    out
  }
}

let expand_local_count = (local_types: Array[(Int, Int)]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(local_types) {
    let (cnt, _) = Array::get(local_types, i)
    total = total + cnt
    i = i + 1
  }
  total
}

// === Remove unused types ===

// Collect used type indices from function section and import section
let collect_used_type_indices = (bytes: Bytes) -> Array[Int] {
  let used = Array::slice([(0)], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 3 {
      // Function section
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (tidx, np) = read_uleb128(bytes, pos)
        if array_contains_int(used, tidx) == false {
          Array::push(used, tidx)
        } else { () }
        pos = np
        i = i + 1
      }
    } else {
      if sid == 2 {
        // Import section: collect func import type indices
        let end_pos = off + sz
        let (cnt, pos0) = read_uleb128(bytes, off)
        let mut pos = pos0
        let mut i = 0
        while (i < cnt) && (pos < end_pos) {
          let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
          let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
          if pos < end_pos {
            let kind = bytes[pos]; pos = pos + 1
            if kind == 0 {
              let (tidx, np) = read_uleb128(bytes, pos); pos = np
              if array_contains_int(used, tidx) == false {
                Array::push(used, tidx)
              } else { () }
            } else {
              if kind == 1 {
                // table: skip reftype + limits
                let (_, np) = read_uleb128(bytes, pos); pos = np
                let flag = bytes[pos]; pos = pos + 1
                let (_, np2) = read_uleb128(bytes, pos); pos = np2
                if flag == 1 { let (_, np3) = read_uleb128(bytes, pos); pos = np3 }
                else { () }
              } else {
                if kind == 2 {
                  let flag = bytes[pos]; pos = pos + 1
                  let (_, np2) = read_uleb128(bytes, pos); pos = np2
                  if flag == 1 { let (_, np3) = read_uleb128(bytes, pos); pos = np3 }
                  else { () }
                } else {
                  if kind == 3 { pos = pos + 2 }
                  else { pos = end_pos }
                }
              }
            }
          } else { () }
          i = i + 1
        }
      } else { () }
    }
    s = s + 1
  }
  used
}

export let remove_unused_types = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let used = collect_used_type_indices(bytes)
    let sections = list_sections(bytes)

    // Parse type section to get count
    let mut type_count = 0
    let mut ts = 0
    while ts < Array::length(sections) {
      let (sid, off, _) = Array::get(sections, ts)
      if sid == 1 { let (cnt, _) = read_uleb128(bytes, off); type_count = cnt }
      else { () }
      ts = ts + 1
    }

    // Build used bitset for O(1) lookup
    let used_bitset = FixedArray::make(type_count + 1, 0)
    let mut ui = 0
    while ui < Array::length(used) {
      let tidx = Array::get(used, ui)
      if (tidx >= 0) && (tidx < type_count) {
        FixedArray::set(used_bitset, tidx, 1)
      }
      ui = ui + 1
    }

    // Build old->new type index map
    let type_map = Array::slice([(0)], 0, 0)
    let mut new_idx = 0
    let mut ti = 0
    while ti < type_count {
      if FixedArray::get(used_bitset, ti) == 1 {
        Array::push(type_map, new_idx)
        new_idx = new_idx + 1
      } else {
        Array::push(type_map, (-1))
      }
      ti = ti + 1
    }

    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }

    let mut si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      if sid == 1 {
        // Rewrite type section: only include used types
        let new_content = rewrite_type_section(bytes, off, sz, used)
        emit_section(out, 1, new_content)
      } else {
        if sid == 3 {
          // Rewrite function section: remap type indices
          let new_content = remap_func_section(bytes, off, sz, type_map)
          emit_section(out, 3, new_content)
        } else {
          if sid == 2 {
            // Rewrite import section: remap func import type indices
            let new_content = remap_import_section(bytes, off, sz, type_map)
            emit_section(out, 2, new_content)
          } else {
            let content = copy_bytes(bytes, off, off + sz)
            emit_section(out, sid, content)
          }
        }
      }
      si = si + 1
    }
    out
  }
}

let rewrite_type_section = (bytes: Bytes, offset: Int, size: Int, used: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (type_count, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  // Collect type entries as raw bytes
  let entries = Array::slice([(0, Bytes::new())], 0, 0)
  let mut ti = 0
  while (ti < type_count) && (pos < end_pos) {
    let entry_start = pos
    // 0x60 func type marker
    pos = pos + 1
    let (param_count, pp) = read_uleb128(bytes, pos)
    pos = pp + param_count
    let (result_count, rp) = read_uleb128(bytes, pos)
    pos = rp + result_count
    if array_contains_int(used, ti) {
      let entry = copy_bytes(bytes, entry_start, pos)
      Array::push(entries, (ti, entry))
    } else { () }
    ti = ti + 1
  }
  let out = Bytes::new()
  write_uleb128(out, Array::length(entries))
  let mut ei = 0
  while ei < Array::length(entries) {
    let (_, entry) = Array::get(entries, ei)
    let mut j = 0
    while j < Bytes::length(entry) {
      Bytes::push(out, entry[j])
      j = j + 1
    }
    ei = ei + 1
  }
  out
}

let remap_func_section = (bytes: Bytes, offset: Int, size: Int, type_map: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let out = Bytes::new()
  write_uleb128(out, cnt)
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (tidx, np) = read_uleb128(bytes, pos)
    let new_tidx = if tidx < Array::length(type_map) { Array::get(type_map, tidx) } else { tidx }
    write_uleb128(out, new_tidx)
    pos = np
    i = i + 1
  }
  out
}

let remap_import_section = (bytes: Bytes, offset: Int, size: Int, type_map: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let out = Bytes::new()
  write_uleb128(out, cnt)
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    // Copy module name
    let (mlen, mp) = read_uleb128(bytes, pos)
    write_uleb128(out, mlen)
    let mut mi = 0
    while mi < mlen { Bytes::push(out, bytes[mp + mi]); mi = mi + 1 }
    pos = mp + mlen
    // Copy field name
    let (flen, fp) = read_uleb128(bytes, pos)
    write_uleb128(out, flen)
    let mut fi2 = 0
    while fi2 < flen { Bytes::push(out, bytes[fp + fi2]); fi2 = fi2 + 1 }
    pos = fp + flen
    if pos < end_pos {
      let kind = bytes[pos]; pos = pos + 1
      Bytes::push(out, kind)
      if kind == 0 {
        // func import: remap type index
        let (tidx, np) = read_uleb128(bytes, pos); pos = np
        let new_tidx = if tidx < Array::length(type_map) { Array::get(type_map, tidx) } else { tidx }
        write_uleb128(out, new_tidx)
      } else {
        if kind == 1 {
          // table
          let (reftype, np) = read_uleb128(bytes, pos); pos = np
          write_uleb128(out, reftype)
          let flag = bytes[pos]; pos = pos + 1
          Bytes::push(out, flag)
          let (lim_min, np2) = read_uleb128(bytes, pos); pos = np2
          write_uleb128(out, lim_min)
          if flag == 1 {
            let (lim_max, np3) = read_uleb128(bytes, pos); pos = np3
            write_uleb128(out, lim_max)
          } else { () }
        } else {
          if kind == 2 {
            // memory
            let flag = bytes[pos]; pos = pos + 1
            Bytes::push(out, flag)
            let (lim_min, np2) = read_uleb128(bytes, pos); pos = np2
            write_uleb128(out, lim_min)
            if flag == 1 {
              let (lim_max, np3) = read_uleb128(bytes, pos); pos = np3
              write_uleb128(out, lim_max)
            } else { () }
          } else {
            if kind == 3 {
              // global: type + mutability
              Bytes::push(out, bytes[pos])
              Bytes::push(out, bytes[pos + 1])
              pos = pos + 2
            } else {
              pos = end_pos
            }
          }
        }
      }
    } else { () }
    i = i + 1
  }
  out
}

// === Remove empty sections ===

export let remove_empty_sections = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    let sections = list_sections(bytes)
    let mut si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      // For counted sections (1-12 except 0 custom, 5 memory, 8 start), check if count == 0
      let mut keep = true
      // Sections with count: type(1), import(2), func(3), table(4), global(6), export(7), elem(9), code(10), data(11), datacount(12)
      if (sid >= 1) && (sid <= 12) && (sid != 5) && (sid != 8) {
        if sz > 0 {
          let (cnt, _) = read_uleb128(bytes, off)
          if cnt == 0 { keep = false } else { () }
        } else {
          keep = false
        }
      } else { () }
      if keep {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      } else { () }
      si = si + 1
    }
    out
  }
}

// === Minify ===

// Comprehensive WASM minifier: applies all optimizations in sequence with multi-round convergence.
export let minify = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    // Step 1: strip custom sections inline (avoids separate list_sections call)
    let sections = list_sections(bytes)
    let stripped = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(stripped, bytes[i]); i = i + 1 }
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid != 0 {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(stripped, sid, content)
      }
      s = s + 1
    }
    // Step 2: peephole optimize
    let s2 = optimize_code_section(stripped)
    // Step 3: DCE
    let s3 = dce(s2)
    // Step 4: coalesce locals (now O(n) with FixedArray bitset)
    let s4 = coalesce_locals(s3)
    // Step 5: remove unused types
    let s5 = remove_unused_types(s4)
    // Step 6: remove empty sections
    remove_empty_sections(s5)
  }
}

// Fast minify: single-pass section filtering only.
// Strips custom sections + empty sections in one pass (no peephole/DCE).
export let minify_fast = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 { copy_bytes(bytes, 0, len) }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 { Bytes::push(out, bytes[i]); i = i + 1 }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid != 0 {
        // Skip custom sections; check non-empty
        if sz > 0 {
          // Check if section has count > 0 (for vector sections)
          let should_keep = if (sid >= 1) && (sid <= 11) && (sid != 8) {
            // Sections with a count prefix
            let (cnt, _) = read_uleb128(bytes, off)
            cnt > 0
          } else { true }
          if should_keep {
            let content = copy_bytes(bytes, off, off + sz)
            emit_section(out, sid, content)
          } else { () }
        } else { () }
      } else { () }
      s = s + 1
    }
    out
  }
}
