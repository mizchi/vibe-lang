//# Imports
import ./index.vibe { binary_size, section_sizes, count_functions, count_exports, count_types }
//# Misc

// duckdb-mvp.wasm: 39,362,651 bytes (39MB)
// Scalability test: parse-only (strip/minify exceeds fuel limit on 39MB)

test "duckdb valid header" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/duckdb-mvp.wasm")
  assert(binary_size(bytes) == 39362651)
  assert(bytes[0] == 0)
  assert(bytes[1] == 97)
  assert(bytes[2] == 115)
  assert(bytes[3] == 109)
  assert(bytes[4] == 1)
}

test "duckdb sections" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/duckdb-mvp.wasm")
  let sizes = section_sizes(bytes)
  // duckdb has many sections
  assert(Array::length(sizes) >= 4)
}

test "duckdb function count" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/duckdb-mvp.wasm")
  // duckdb has thousands of functions
  let f = count_functions(bytes)
  assert(f > 1000)
}

test "duckdb export count" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/duckdb-mvp.wasm")
  assert(count_exports(bytes) > 0)
}

test "duckdb type count" {
  let bytes = Fs::read_bytes("vibe/x/wasmopt/duckdb-mvp.wasm")
  assert(count_types(bytes) > 0)
}
