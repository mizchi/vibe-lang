//# Imports

import ./bitstream.vibe {
  BitWriter, new_writer, write_bits, flush_to_byte, write_byte, writer_bytes
}

//# Functions

// Encode `data` as a single stored DEFLATE block (no compression).
// This is the simplest valid DEFLATE output: 1 + 2 + 32 bits of overhead
// (block header + LEN + NLEN) per ≤65535-byte chunk plus the raw bytes.
//
// Stored blocks are useful for round-trip testing the inflate code and
// for serving as a baseline against compressed variants.
export let deflate_stored = (data: Bytes) -> Bytes {
  let w = new_writer()
  let total = Bytes::length(data)
  let mut pos = 0
  let block_max = 65535
  let mut more = true
  while more {
    let remaining = total - pos
    let chunk = if remaining > block_max { block_max } else { remaining }
    let is_final = if pos + chunk >= total { 1 } else { 0 }
    write_bits(w, is_final, 1)
    write_bits(w, 0, 2)             // BTYPE = 00 (stored)
    flush_to_byte(w)
    write_byte(w, chunk & 0xFF)
    write_byte(w, (chunk >> 8) & 0xFF)
    let nlen = chunk ^ 0xFFFF
    write_byte(w, nlen & 0xFF)
    write_byte(w, (nlen >> 8) & 0xFF)
    let mut i = 0
    while i < chunk {
      write_byte(w, Bytes::get(data, pos + i))
      i = i + 1
    }
    pos = pos + chunk
    if is_final == 1 {
      more = false
    }
  }
  writer_bytes(w)
}
