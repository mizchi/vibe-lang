//# Types

export enum Json {
  JNull;
  JBool(Bool);
  JNum(Double);
  JStr(String);
  JArr(Array[Json]);
  JObj(Map[Json])
}

export enum JsonSchema {
  SAny;
  SNull;
  SBool;
  SNumber;
  SString;
  SArray(JsonSchema);
  SObject(Array[String], Array[(String, JsonSchema)]);
  SOneOf(Array[JsonSchema])
}
