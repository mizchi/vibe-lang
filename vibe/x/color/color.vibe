//# Functions

let esc: String = String::from_char_code(27)

let wrap = (code: String, text: String) -> String {
  "\{esc}[\{code}m\{text}\{esc}[0m"
}

export let dim = (text: String) -> String {
  wrap("2", text)
}

export let red = (text: String) -> String {
  wrap("31", text)
}

export let blue = (text: String) -> String {
  wrap("34", text)
}

export let bold = (text: String) -> String {
  wrap("1", text)
}

export let cyan = (text: String) -> String {
  wrap("36", text)
}

export let black = (text: String) -> String {
  wrap("30", text)
}

export let green = (text: String) -> String {
  wrap("32", text)
}

export let strip = (text: String) -> String {
  let len = String::length(text)
  let mut result = ""
  let mut idx = 0
  while idx < len {
    let ch = text[idx:idx + 1]
    if String::char_code_at(text, idx) == 27 && idx + 1 < len && text[idx + 1: idx + 2] == "[" {
      let mut j = idx + 2
      while j < len && not(text[j:j + 1] == "m") {
        j = j + 1
      }
      idx = j + 1
    } else {
      result = "\{result}\{ch}"
      idx = idx + 1
    }
  }
  result
}

export let white = (text: String) -> String {
  wrap("37", text)
}

export let bg_red = (text: String) -> String {
  wrap("41", text)
}

export let italic = (text: String) -> String {
  wrap("3", text)
}

export let yellow = (text: String) -> String {
  wrap("33", text)
}

export let bg_blue = (text: String) -> String {
  wrap("44", text)
}

export let magenta = (text: String) -> String {
  wrap("35", text)
}

export let bg_green = (text: String) -> String {
  wrap("42", text)
}

export let bg_yellow = (text: String) -> String {
  wrap("43", text)
}

export let underline = (text: String) -> String {
  wrap("4", text)
}

export let bright_red = (text: String) -> String {
  wrap("91", text)
}

export let bright_blue = (text: String) -> String {
  wrap("94", text)
}

export let bright_green = (text: String) -> String {
  wrap("92", text)
}

export let bright_yellow = (text: String) -> String {
  wrap("93", text)
}

export let strikethrough = (text: String) -> String {
  wrap("9", text)
}
