//# Imports

import ./index.vibe {
  blue, bold, cyan, dim, green, italic, magenta, red, strip, underline, yellow
}

//# Misc

test "red wraps text" {
  let result = red("error")
  assert(String::contains(result, "error"))
  assert(String::length(result) > 5)
}

test "green wraps text" {
  let result = green("ok")
  assert(String::contains(result, "ok"))
  assert(String::length(result) > 2)
}

test "blue wraps text" {
  let result = blue("info")
  assert(String::contains(result, "info"))
}

test "yellow wraps text" {
  let result = yellow("warn")
  assert(String::contains(result, "warn"))
}

test "bold wraps text" {
  let result = bold("important")
  assert(String::contains(result, "important"))
}

test "strip removes ANSI from red" {
  assert(String::equals(strip(red("hello")), "hello"))
}

test "strip removes ANSI from green" {
  assert(String::equals(strip(green("ok")), "ok"))
}

test "strip removes ANSI from bold" {
  assert(String::equals(strip(bold("text")), "text"))
}

test "strip on plain text is identity" {
  assert(String::equals(strip("hello"), "hello"))
  assert(String::equals(strip(""), ""))
}

test "composable bold green" {
  let result = bold(green("ok"))
  assert(String::equals(strip(result), "ok"))
}

test "composable red underline" {
  let result = red(underline("err"))
  assert(String::equals(strip(result), "err"))
}

test "composable italic dim" {
  let result = italic(dim("note"))
  assert(String::equals(strip(result), "note"))
}

test "triple nesting" {
  let result = bold(red(underline("x")))
  assert(String::equals(strip(result), "x"))
}

test "different colors produce different output" {
  let r = red("x")
  let g = green("x")
  let b = blue("x")
  assert(not(String::equals(r, g)))
  assert(not(String::equals(g, b)))
  assert(not(String::equals(r, b)))
}

test "magenta and cyan produce output" {
  assert(String::length(magenta("x")) > 1)
  assert(String::length(cyan("x")) > 1)
}
