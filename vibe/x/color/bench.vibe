//# Imports

import ./index.vibe {
  blue, bold, green, italic, red, strip, underline
}

//# Misc

bench "color/red" {
  let _ = red("error message")
}

bench "color/bold_green" {
  let _ = bold(green("ok"))
}

bench "color/triple_nest" {
  let _ = bold(red(underline("important")))
}

bench "color/strip_colored" {
  let _ = strip(bold(red(underline("text"))))
}

bench "color/strip_plain" {
  let _ = strip("plain text no ansi codes here")
}
