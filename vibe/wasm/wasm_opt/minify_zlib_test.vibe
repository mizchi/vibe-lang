//# Imports

import ./index.vibe {
  minify, minify_fast, binary_size, count_functions, count_exports, count_types,
  section_sizes, strip_custom_sections
}

//# Misc

// zlib.wasm: 171100 bytes
// vibe minify:      57878 bytes (66.2% reduction, wasmtime validated ✅)
// vibe minify_fast:  72020 bytes (57.9%)
// wite(-O1):         69644 bytes (59.3%)
// wasm-opt(-Oz):     66146 bytes (61.3%)

test "zlib.wasm is valid" {
  let bytes = Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm")
  assert(binary_size(bytes) == 171100)
  assert(bytes[0] == 0)
  assert(bytes[4] == 1)
}

test "zlib.wasm strip custom ~72K" {
  let stripped = strip_custom_sections(Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm"))
  assert(binary_size(stripped) == 72020)
}

test "zlib.wasm counts" {
  let bytes = Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm")
  assert(count_functions(bytes) > 100)
  assert(count_exports(bytes) > 0)
}

test "zlib.wasm minify_fast" {
  let bytes = Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm")
  let opt = minify_fast(bytes)
  assert(binary_size(opt) == 72020)
  assert(count_exports(opt) == count_exports(bytes))
  assert(count_functions(opt) == count_functions(bytes))
}

test "zlib.wasm minify valid header" {
  let opt = minify(Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm"))
  assert(opt[0] == 0)
  assert(opt[1] == 97)
  assert(opt[4] == 1)
  assert(count_functions(opt) > 0)
  assert(count_exports(opt) > 0)
}

test "zlib.wasm minify beats wasm-opt" {
  let opt = minify(Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm"))
  let n = binary_size(opt)
  // Must beat wasm-opt(-Oz) = 66146
  assert(n < 66146)
  // Pin to measured value
  assert(n > 55000)
  assert(n < 60000)
}
