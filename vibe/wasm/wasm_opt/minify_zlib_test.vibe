//# Imports

import ./index.vibe {
  binary_size, count_exports, count_functions, count_types, minify, minify_fast, section_sizes, strip_custom_sections
}

//# Misc

test "zlib.wasm is valid" {
  let bytes = Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm")
  assert_true(binary_size(bytes) == 171100)
  assert_true(bytes[0] == 0)
  assert_true(bytes[4] == 1)
}

test "zlib.wasm strip custom ~72K" {
  let stripped = strip_custom_sections(Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm"))
  assert_true(binary_size(stripped) == 72020)
}

test "zlib.wasm counts" {
  let bytes = Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm")
  assert_true(count_functions(bytes) > 100)
  assert_true(count_exports(bytes) > 0)
}

test "zlib.wasm minify_fast" {
  let bytes = Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm")
  let opt = minify_fast(bytes)
  assert_true(binary_size(opt) == 72020)
  assert_true(count_exports(opt) == count_exports(bytes))
  assert_true(count_functions(opt) == count_functions(bytes))
}

test "zlib.wasm minify valid header" {
  let opt = minify(Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm"))
  assert_true(opt[0] == 0)
  assert_true(opt[1] == 97)
  assert_true(opt[4] == 1)
  assert_true(count_functions(opt) > 0)
  assert_true(count_exports(opt) > 0)
}

test "zlib.wasm minify beats wasm-opt" {
  let opt = minify(Fs::read_bytes("vibe/wasm/wasm_opt/__fixtures/zlib.wasm"))
  let n = binary_size(opt)
  // Must beat wasm-opt(-Oz) = 66146
  assert_true(n < 66146)
  // Pin to measured value
  assert_true(n > 55000)
  assert_true(n < 60000)
}
