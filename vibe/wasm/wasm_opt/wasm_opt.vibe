//# Functions

let copy_bytes = (src: Bytes, start: Int, end_pos: Int) -> Bytes {
  Bytes::slice(src, start, end_pos)
}

export let binary_size = (bytes: Bytes) -> Int {
  Bytes::length(bytes)
}

let append_bytes = (out: Bytes, src: Bytes) -> Unit {
  let mut i = 0
  while i < Bytes::length(src) {
    Bytes::push(out, src[i])
    i = i + 1
  }
}

let is_i32_binop = (op: Int) -> Bool {
  (op == 0x6A) || (op == 0x6B) || (op == 0x6C) || (op == 0x71) || (op == 0x72) || (op == 0x73)
}

// i32.shl / i32.shr_s / i32.shr_u. Kept separate from is_i32_binop so callers
// can ask for "binop" vs "shift" specifically; apply_i32_fold handles both
// (with wasm's 32-bit shift-amount masking and wraparound).
let is_i32_shift = (op: Int) -> Bool {
  (op == 0x74) || (op == 0x75) || (op == 0x76)
}

// Opcodes whose `i32.const a; i32.const b; OP` triple can be constant-folded.
// div/rem are excluded: folding `x / 0` would silently drop a wasm trap.
let is_i32_foldable = (op: Int) -> Bool {
  is_i32_binop(op) || is_i32_shift(op)
}

// i32 relational ops (eq/ne and signed/unsigned lt/gt/le/ge), 0x46..0x4F.
// Folding `i32.const a; i32.const b; CMP` yields `i32.const 0|1`.
let is_i32_cmp = (op: Int) -> Bool {
  (op >= 0x46) && (op <= 0x4F)
}

// i64 identity: `x OP <i64.const k>` collapses to `x` when (OP, k) is an
// identity. Mirrors is_identity_op for the i64 opcodes: add/sub/or/xor/shl/
// shr_s/shr_u with k == 0, and mul with k == 1. `and` is intentionally absent
// (x & 0 == 0, not x). Pure elimination, no arithmetic computed.
let is_i64_identity_op = (op: Int, imm: Int) -> Bool {
  if (op == 0x7C) || (op == 0x7D) || (op == 0x84) || (op == 0x85) || (op == 0x86) || (op == 0x87) || (op == 0x88) {
    imm == 0
  }
  else {
    if op == 0x7E {
      imm == 1
    }
    else {
      false
    }
  }
}

let read_sleb128 = (buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result|((byte&0x7F)<<shift)
    shift = shift + 7
    i = i + 1
    if (byte&0x80) == 0 {
      if (byte&0x40) > 0 {
        result = result|((-1)<<shift)
      }
      done = true
    }
  }
  (result, i)
}

let read_uleb128 = (buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result|((byte&0x7F)<<shift)
    i = i + 1
    if (byte&0x80) == 0 {
      done = true
    }
    else {
      shift = shift + 7
    }
  }
  (result, i)
}

let read_name = (bytes: Bytes, offset: Int) -> (String, Int) {
  let (name_len, pos) = read_uleb128(bytes, offset)
  let mut s = ""
  let mut i = 0
  while i < name_len {
    s = String::concat(s, String::from_char_code(bytes[pos + i]))
    i = i + 1
  }
  (s, pos + name_len)
}

export let minify_fast = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    while i < len {
      let sec_id = bytes[i]
      let raw_start = i
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if (sec_id != 0) && (sec_size > 0) {
          let should_keep = if (sec_id >= 1) && (sec_id <= 11) && (sec_id != 8) {
            let (cnt, _) = read_uleb128(bytes, content_start)
            cnt > 0
          } else {
            true
          }
          if should_keep {
            let mut j = raw_start
            while j < sec_end {
              Bytes::push(out, bytes[j])
              j = j + 1
            }
          } else {
            ()
          }
        } else {
          ()
        }
        i = sec_end
      }
    }
    out
  }
}

let decode_instr = (body: Bytes, pos: Int) -> (Int, Int, Int) {
  let op = body[pos]
  if op == 0x41 {
    let (val, next) = read_sleb128(body, pos + 1)
    (0x41, val, next)
  } else {
    if op == 0x42 {
      let (val, next) = read_sleb128(body, pos + 1)
      (0x42, val, next)
    } else {
      if op == 0x20 {
        let (val, next) = read_uleb128(body, pos + 1)
        (0x20, val, next)
      } else {
        if op == 0x21 {
          let (val, next) = read_uleb128(body, pos + 1)
          (0x21, val, next)
        } else {
          if op == 0x22 {
            let (val, next) = read_uleb128(body, pos + 1)
            (0x22, val, next)
          } else {
            if op == 0x23 {
              let (val, next) = read_uleb128(body, pos + 1)
              (0x23, val, next)
            } else {
              if op == 0x24 {
                let (val, next) = read_uleb128(body, pos + 1)
                (0x24, val, next)
              } else {
                if op == 0x10 {
                  let (val, next) = read_uleb128(body, pos + 1)
                  (0x10, val, next)
                } else {
                  if op == 0x0C {
                    let (val, next) = read_uleb128(body, pos + 1)
                    (0x0C, val, next)
                  } else {
                    if op == 0x0D {
                      let (val, next) = read_uleb128(body, pos + 1)
                      (0x0D, val, next)
                    } else {
                      if (op == 0x02) || (op == 0x03) || (op == 0x04) {
                        let (val, next) = read_sleb128(body, pos + 1)
                        (op, val, next)
                      } else {
                        if (op == 0x28) || (op == 0x29) || (op == 0x2A) || (op == 0x2B) ||
                        (op == 0x2C) || (op == 0x2D) || (op == 0x2E) || (op == 0x2F) ||
                        (op == 0x30) || (op == 0x31) || (op == 0x32) || (op == 0x33) ||
                        (op == 0x34) || (op == 0x35) ||
                        (op == 0x36) || (op == 0x37) || (op == 0x38) || (op == 0x39) ||
                        (op == 0x3A) || (op == 0x3B) || (op == 0x3C) || (op == 0x3D) || (op == 0x3E) {
                          let (_, p1) = read_uleb128(body, pos + 1)
                          let (_, next) = read_uleb128(body, p1)
                          (op, 0, next)
                        } else {
                          if op == 0x11 {
                            let (_, p1) = read_uleb128(body, pos + 1)
                            let (_, next) = read_uleb128(body, p1)
                            (op, 0, next)
                          } else {
                            if op == 0x0E {
                              let (cnt, p1) = read_uleb128(body, pos + 1)
                              let mut pp = p1
                              let mut bi = 0
                              while bi <= cnt {
                                let (_, np) = read_uleb128(body, pp)
                                pp = np
                                bi = bi + 1
                              }
                              (op, 0, pp)
                            } else {
                              if (op == 0x3F) || (op == 0x40) {
                                (op, 0, pos + 2)
                              } else {
                                if op == 0xFC {
                                  let (sub_op, p1) = read_uleb128(body, pos + 1)
                                  if sub_op <= 7 {
                                    (op, 0, p1)
                                  } else if sub_op == 8 {
                                    let (_, p2) = read_uleb128(body, p1)
                                    (op, 0, p2 + 1)
                                  } else if sub_op == 9 {
                                    let (_, p2) = read_uleb128(body, p1)
                                    (op, 0, p2)
                                  } else if sub_op == 10 {
                                    (op, 0, p1 + 2)
                                  } else if sub_op == 11 {
                                    (op, 0, p1 + 1)
                                  } else if (sub_op == 12) || (sub_op == 14) {
                                    let (_, p2) = read_uleb128(body, p1)
                                    let (_, p3) = read_uleb128(body, p2)
                                    (op, 0, p3)
                                  } else {
                                    let (_, p2) = read_uleb128(body, p1)
                                    (op, 0, p2)
                                  }
                                } else {
                                  (op, 0, pos + 1)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

let list_sections = (bytes: Bytes) -> Array[(Int, Int, Int)] {
  let len = Bytes::length(bytes)
  let result = Array::slice([
    (0, 0, 0)
  ], 0, 0)
  if len < 8 {
    result
  }
  else {
    let mut i = 8
    while i < len {
      let sec_id = bytes[i]
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len {
        i = len
      }
      else {
        Array::push(result, (sec_id, content_start, sec_size))
        i = sec_end
      }
    }
    result
  }
}

export let count_types = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut count = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, _) = Array::get(sections, s)
    if sid == 1 {
      let (cnt, _) = read_uleb128(bytes, off)
      count = cnt
    }
    s = s + 1
  }
  count
}

export let count_exports = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut count = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 7 {
      let (cnt, _) = read_uleb128(bytes, off)
      count = cnt
    }
    s = s + 1
  }
  count
}

export let section_sizes = (bytes: Bytes) -> Array[(Int, Int)] {
  let sections = list_sections(bytes)
  let result = Array::slice([
    (0, 0)
  ], 0, 0)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, _, sz) = Array::get(sections, s)
    Array::push(result, (sid, sz))
    s = s + 1
  }
  result
}

let write_sleb128 = (buf: Bytes, n: Int) -> Unit {
  let mut val = n
  let mut more = true
  while more {
    let byte = val&0x7F
    val = val>>7
    if ((val == 0) && ((byte&0x40) == 0)) || ((val == (-1)) && ((byte&0x40) > 0)) {
      Bytes::push(buf, byte)
      more = false
    } else {
      Bytes::push(buf, byte|0x80)
    }
  }
}

let write_uleb128 = (buf: Bytes, n: Int) -> Unit {
  let mut val = n
  let mut more = true
  while more {
    let byte = val&0x7F
    val = (val>>7)&((1<<25) - 1)
    if val == 0 {
      Bytes::push(buf, byte)
      more = false
    } else {
      Bytes::push(buf, byte|0x80)
    }
  }
}

let emit_section = (out: Bytes, sec_id: Int, content: Bytes) -> Unit {
  Bytes::push(out, sec_id)
  write_uleb128(out, Bytes::length(content))
  append_bytes(out, content)
}

let is_identity_op = (op: Int, imm: Int) -> Bool {
  if op == 0x6A {
    imm == 0
  }
  else {
    if op == 0x6B {
      imm == 0
    }
    else {
      if op == 0x6C {
        imm == 1
      }
      else {
        if op == 0x72 {
          imm == 0
        }
        else {
          if op == 0x73 {
            imm == 0
          }
          else {
            if (op == 0x74) || (op == 0x75) || (op == 0x76) {
              imm == 0
            }
            else {
              false
            }
          }
        }
      }
    }
  }
}

// Normalize a 62-bit Int result to a signed wasm i32 (two's complement,
// -2^31 .. 2^31-1) so constant folding matches wasm's wraparound semantics
// instead of leaking out-of-range values into the rewritten i32.const.
let wrap_i32 = (v: Int) -> Int {
  let m = v & 0xFFFFFFFF
  if (m & 0x80000000) != 0 {
    m - 4294967296
  }
  else {
    m
  }
}

let apply_i32_fold = (op: Int, a: Int, b: Int) -> Int {
  if op == 0x6A {
    wrap_i32(a + b)
  }
  else if op == 0x6B {
    wrap_i32(a - b)
  }
  else if op == 0x6C {
    wrap_i32(a * b)
  }
  else if op == 0x71 {
    wrap_i32(a & b)
  }
  else if op == 0x72 {
    wrap_i32(a | b)
  }
  else if op == 0x73 {
    wrap_i32(a ^ b)
  }
  else if op == 0x74 {
    wrap_i32(a << (b & 31))
  }
  else if op == 0x75 {
    // shr_s: arithmetic shift of the signed 32-bit value (vibe >> sign-extends)
    wrap_i32(wrap_i32(a) >> (b & 31))
  }
  else {
    // shr_u (0x76): logical shift of the unsigned 32-bit value
    let ua = a & 0xFFFFFFFF
    wrap_i32(ua >> (b & 31))
  }
}

// Evaluate an i32 relational op on two constants, returning 0 or 1. Signed
// ops compare the sign-extended i32 values; unsigned ops compare the low
// 32 bits as non-negative magnitudes.
let apply_i32_cmp = (op: Int, a: Int, b: Int) -> Int {
  let sa = wrap_i32(a)
  let sb = wrap_i32(b)
  let ua = a & 0xFFFFFFFF
  let ub = b & 0xFFFFFFFF
  if op == 0x46 {
    if sa == sb { 1 } else { 0 }
  }
  else if op == 0x47 {
    if sa != sb { 1 } else { 0 }
  }
  else if op == 0x48 {
    if sa < sb { 1 } else { 0 }
  }
  else if op == 0x49 {
    if ua < ub { 1 } else { 0 }
  }
  else if op == 0x4A {
    if sa > sb { 1 } else { 0 }
  }
  else if op == 0x4B {
    if ua > ub { 1 } else { 0 }
  }
  else if op == 0x4C {
    if sa <= sb { 1 } else { 0 }
  }
  else if op == 0x4D {
    if ua <= ub { 1 } else { 0 }
  }
  else if op == 0x4E {
    if sa >= sb { 1 } else { 0 }
  }
  else {
    if ua >= ub { 1 } else { 0 }
  }
}

let copy_span_bytes = (out: Bytes, body: Bytes, start: Int, end_pos: Int) -> Unit {
  let mut k = start
  while k < end_pos {
    Bytes::push(out, body[k])
    k = k + 1
  }
}

export let count_functions = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut import_funcs = 0
  let mut defined_funcs = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (_, np) = read_uleb128(bytes, pos); pos = np
            import_funcs = import_funcs + 1
          } else {
            pos = end_pos
          }
        }
        i = i + 1
      }
    } else {
      if sid == 3 {
        let (cnt, _) = read_uleb128(bytes, off)
        defined_funcs = cnt
      }
    }
    s = s + 1
  }
  import_funcs + defined_funcs
}

let parse_body_spans = (body: Bytes, start: Int, end_pos: Int) -> Array[(Int, Int, Int)] {
  let spans = Array::slice([
    (0, 0, 0)
  ], 0, 0)
  let mut pos = start
  while pos < end_pos {
    let (op, _, next) = decode_instr(body, pos)
    Array::push(spans, (pos, next, op))
    pos = next
  }
  spans
}

let is_table_exported = (bytes: Bytes) -> Bool {
  let sections = list_sections(bytes)
  let mut s = 0
  let mut found = false
  while (s < Array::length(sections)) && (found == false) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 7 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (_, np) = read_name(bytes, pos)
        pos = np
        if pos < end_pos {
          let kind = bytes[pos]
          pos = pos + 1
          let (_, np2) = read_uleb128(bytes, pos)
          pos = np2
          if kind == 1 {
            found = true
          }
          else {
            ()
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  found
}

let parse_body_instrs = (body: Bytes, start: Int, end_pos: Int) -> Array[(Int, Int)] {
  let instrs = Array::slice([
    (0, 0)
  ], 0, 0)
  let mut pos = start
  while pos < end_pos {
    let (op, imm, next) = decode_instr(body, pos)
    Array::push(instrs, (op, imm))
    pos = next
  }
  instrs
}

let parse_code_bodies = (bytes: Bytes, offset: Int, size: Int) -> Array[Bytes] {
  let end_pos = offset + size
  let (func_count, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let result = Array::slice([
    (Bytes::new())
  ], 0, 0)
  let mut fi = 0
  while (fi < func_count) && (pos < end_pos) {
    let (body_size, bp) = read_uleb128(bytes, pos)
    Array::push(result, copy_bytes(bytes, bp, bp + body_size))
    pos = bp + body_size
    fi = fi + 1
  }
  result
}

let array_contains_int = (arr: Array[Int], target: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while (i < Array::length(arr)) && (found == false) {
    if Array::get(arr, i) == target {
      found = true
    }
    i = i + 1
  }
  found
}

let array_contains_str = (arr: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while (i < Array::length(arr)) && (found == false) {
    if Array::get(arr, i) == target {
      found = true
    }
    i = i + 1
  }
  found
}

let rewrite_exports = (bytes: Bytes, offset: Int, size: Int, keep_names: Array[String]) -> Bytes {
  let end_pos = offset + size
  let kept = Array::slice([
    ("", 0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (name, np) = read_name(bytes, pos)
    pos = np
    if pos < end_pos {
      let kind = bytes[pos]
      pos = pos + 1
      let (index, np2) = read_uleb128(bytes, pos)
      pos = np2
      if array_contains_str(keep_names, name) {
        Array::push(kept, (name, kind, index))
      }
    }
    i = i + 1
  }
  let out = Bytes::new()
  write_uleb128(out, Array::length(kept))
  let mut k = 0
  while k < Array::length(kept) {
    let (name, kind, index) = Array::get(kept, k)
    write_uleb128(out, String::length(name))
    let mut ci = 0
    while ci < String::length(name) {
      Bytes::push(out, String::char_code_at(name, ci))
      ci = ci + 1
    }
    Bytes::push(out, kind)
    write_uleb128(out, index)
    k = k + 1
  }
  out
}

export let filter_exports = (bytes: Bytes, keep_names: Array[String]) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 7 {
        let new_content = rewrite_exports(bytes, off, sz, keep_names)
        emit_section(out, 7, new_content)
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

let count_import_funcs = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut import_funcs = 0
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (_, np) = read_uleb128(bytes, pos); pos = np
            import_funcs = import_funcs + 1
          } else {
            if kind == 1 {
              let (_, np) = read_uleb128(bytes, pos); pos = np
              let flag = bytes[pos]; pos = pos + 1
              let (_, np2) = read_uleb128(bytes, pos); pos = np2
              if flag == 1 {
                let (_, np3) = read_uleb128(bytes, pos); pos = np3
              }
            } else {
              if kind == 2 {
                let flag = bytes[pos]; pos = pos + 1
                let (_, np2) = read_uleb128(bytes, pos); pos = np2
                if flag == 1 {
                  let (_, np3) = read_uleb128(bytes, pos); pos = np3
                }
              } else {
                if kind == 3 {
                  pos = pos + 2
                } else {
                  pos = end_pos
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  import_funcs
}

export let build_call_graph = (bytes: Bytes) -> Array[(Int, Array[Int])] {
  let result = Array::slice([
    (0, Array::slice([
      (0)
    ], 0, 0))
  ], 0, 0)
  let import_count = count_import_funcs(bytes)
  let total_funcs = count_functions(bytes)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 10 {
      let end_pos = off + sz
      let (func_count, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut fi = 0
      while (fi < func_count) && (pos < end_pos) {
        let func_idx = import_count + fi
        let (body_size, bp) = read_uleb128(bytes, pos)
        let body_end = bp + body_size
        let callees = Array::slice([
          (0)
        ], 0, 0)
        let callee_seen = FixedArray::make(total_funcs + 1, 0)
        let body = copy_bytes(bytes, bp, body_end)
        let body_len = Bytes::length(body)
        let mut bpos = 0
        let (local_count, lp) = read_uleb128(body, 0)
        bpos = lp
        let mut lc = 0
        while lc < local_count {
          let (_, tp) = read_uleb128(body, bpos)
          bpos = tp + 1
          lc = lc + 1
        }
        while bpos < body_len {
          let (op, imm, next) = decode_instr(body, bpos)
          if op == 0x10 {
            if (imm >= 0) && (imm <= total_funcs) {
              if FixedArray::get(callee_seen, imm) == 0 {
                FixedArray::set(callee_seen, imm, 1)
                Array::push(callees, imm)
              }
            } else {
              if array_contains_int(callees, imm) == false {
                Array::push(callees, imm)
              }
            }
          }
          bpos = next
        }
        Array::push(result, (func_idx, callees))
        pos = body_end
        fi = fi + 1
      }
    }
    s = s + 1
  }
  result
}

let count_local_tables = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut s = 0
  let mut count = 0
  while s < Array::length(sections) {
    let (sid, off, _) = Array::get(sections, s)
    if sid == 4 {
      let (cnt, _) = read_uleb128(bytes, off)
      count = cnt
    }
    s = s + 1
  }
  count
}

let expand_local_count = (local_types: Array[(Int, Int)]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(local_types) {
    let (cnt, _) = Array::get(local_types, i)
    total = total + cnt
    i = i + 1
  }
  total
}

let remap_func_section = (bytes: Bytes, offset: Int, size: Int, type_map: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let out = Bytes::new()
  write_uleb128(out, cnt)
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (tidx, np) = read_uleb128(bytes, pos)
    let new_tidx = if tidx < Array::length(type_map) {
      Array::get(type_map, tidx)
    } else {
      tidx
    }
    write_uleb128(out, new_tidx)
    pos = np
    i = i + 1
  }
  out
}

let span_read_sleb_imm = (body: Bytes, span_start: Int) -> Int {
  let (val, _) = read_sleb128(body, span_start + 1)
  val
}

let directize_body = (body: Bytes, slot_to_func: Array[Int], max_slot: Int, func_type_by_idx: Array[Int]) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    }
    else {
      let spans = parse_body_spans(body, code_start, code_end)
      let n = Array::length(spans)
      let out = Bytes::new()
      let mut ci = 0
      while ci < code_start {
        Bytes::push(out, body[ci]); ci = ci + 1
      }
      let mut i = 0
      while i < n {
        let (s_i, e_i, op_i) = Array::get(spans, i)
        if (i + 1) < n {
          let (s_next, e_next, op_next) = Array::get(spans, i + 1)
          if (op_i == 0x41) && (op_next == 0x11) {
            let slot = span_read_sleb_imm(body, s_i)
            let (type_idx, p1) = read_uleb128(body, s_next + 1)
            let (table_idx, _) = read_uleb128(body, p1)
            if (table_idx == 0) && (slot >= 0) && (slot <= max_slot) {
              let target = Array::get(slot_to_func, slot)
              if target >= 0 {
                let type_matches = if target < Array::length(func_type_by_idx) {
                  Array::get(func_type_by_idx, target) == type_idx
                } else {
                  false
                }
                if type_matches {
                  Bytes::push(out, 0x10)
                  write_uleb128(out, target)
                  i = i + 2
                } else {
                  copy_span_bytes(out, body, s_i, e_i)
                  i = i + 1
                }
              } else {
                copy_span_bytes(out, body, s_i, e_i)
                i = i + 1
              }
            } else {
              copy_span_bytes(out, body, s_i, e_i)
              i = i + 1
            }
          } else {
            copy_span_bytes(out, body, s_i, e_i)
            i = i + 1
          }
        } else {
          copy_span_bytes(out, body, s_i, e_i)
          i = i + 1
        }
      }
      Bytes::push(out, 0x0B)
      out
    }
  }
}

let span_read_uleb_imm = (body: Bytes, span_start: Int) -> Int {
  let (val, _) = read_uleb128(body, span_start + 1)
  val
}

let coalesce_body = (body: Bytes, param_count: Int) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let mut pos = 0
    let (local_decl_count, lp) = read_uleb128(body, 0)
    pos = lp
    let local_types = Array::slice([
      (0, 0)
    ], 0, 0)
    let mut lc = 0
    while lc < local_decl_count {
      let (cnt, tp) = read_uleb128(body, pos)
      let ltype = body[tp]
      Array::push(local_types, (cnt, ltype))
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    let total_locals = param_count + expand_local_count(local_types)
    let local_type_arr = Array::slice([
      (0)
    ], 0, 0)
    let mut li = 0
    while li < param_count {
      Array::push(local_type_arr, (-1))
      li = li + 1
    }
    let mut di = 0
    while di < Array::length(local_types) {
      let (cnt, ltype) = Array::get(local_types, di)
      let mut ci = 0
      while ci < cnt {
        Array::push(local_type_arr, ltype)
        ci = ci + 1
      }
      di = di + 1
    }
    let used_flags = FixedArray::make(total_locals + 1, 0)
    let mut pi = 0
    while pi < param_count {
      FixedArray::set(used_flags, pi, 1)
      pi = pi + 1
    }
    if code_start < code_end {
      let instrs = parse_body_instrs(body, code_start, code_end)
      let mut ii = 0
      while ii < Array::length(instrs) {
        let (op, imm) = Array::get(instrs, ii)
        if (op == 0x20) || (op == 0x21) || (op == 0x22) {
          if (imm >= 0) && (imm < total_locals) {
            FixedArray::set(used_flags, imm, 1)
          } else {
            ()
          }
        } else {
          ()
        }
        ii = ii + 1
      }
    } else {
      ()
    }
    let index_map = Array::slice([
      (0)
    ], 0, 0)
    let mut new_idx = 0
    let mut oi = 0
    while oi < total_locals {
      if FixedArray::get(used_flags, oi) == 1 {
        Array::push(index_map, new_idx)
        new_idx = new_idx + 1
      } else {
        Array::push(index_map, (-1))
      }
      oi = oi + 1
    }
    let new_local_entries = Array::slice([
      (0, 0)
    ], 0, 0)
    let mut nli = param_count
    while nli < total_locals {
      if FixedArray::get(used_flags, nli) == 1 {
        let ltype = Array::get(local_type_arr, nli)
        let nle_len = Array::length(new_local_entries)
        if nle_len > 0 {
          let (prev_cnt, prev_type) = Array::get(new_local_entries, nle_len - 1)
          if prev_type == ltype {
            Array::set(new_local_entries, nle_len - 1, (prev_cnt + 1, prev_type))
          } else {
            Array::push(new_local_entries, (1, ltype))
          }
        } else {
          Array::push(new_local_entries, (1, ltype))
        }
      } else {
        ()
      }
      nli = nli + 1
    }
    let out = Bytes::new()
    write_uleb128(out, Array::length(new_local_entries))
    let mut ei = 0
    while ei < Array::length(new_local_entries) {
      let (cnt, ltype) = Array::get(new_local_entries, ei)
      write_uleb128(out, cnt)
      Bytes::push(out, ltype)
      ei = ei + 1
    }
    if code_start < code_end {
      let spans = parse_body_spans(body, code_start, code_end)
      let mut si = 0
      while si < Array::length(spans) {
        let (s_start, s_end, op) = Array::get(spans, si)
        if (op == 0x20) || (op == 0x21) || (op == 0x22) {
          let imm = span_read_uleb_imm(body, s_start)
          let new_imm = if imm < Array::length(index_map) {
            Array::get(index_map, imm)
          } else {
            imm
          }
          Bytes::push(out, op)
          write_uleb128(out, new_imm)
        } else {
          copy_span_bytes(out, body, s_start, s_end)
        }
        si = si + 1
      }
    } else {
      ()
    }
    Bytes::push(out, 0x0B)
    out
  }
}

let peephole_try2 = (out: Bytes, body: Bytes, spans: Array[(Int, Int, Int)], i: Int, n: Int) -> Bool {
  if (i + 1) >= n {
    false
  }
  else {
    let (s_i, _, op_i) = Array::get(spans, i)
    let (s_next, _, op_next) = Array::get(spans, i + 1)
    if (op_i == 0x21) && (op_next == 0x20) {
      let imm_i = span_read_uleb_imm(body, s_i)
      let imm_next = span_read_uleb_imm(body, s_next)
      if imm_i == imm_next {
        Bytes::push(out, 0x22)
        write_uleb128(out, imm_i)
        true
      } else {
        false
      }
    } else {
      if (op_i == 0x41) && (op_next == 0x0D) {
        let imm_i = span_read_sleb_imm(body, s_i)
        if imm_i == 0 {
          true
        }
        else {
          false
        }
      } else {
        if (op_i == 0x41) && (op_next == 0x45) {
          // i32.const c; i32.eqz  ->  i32.const (c == 0 ? 1 : 0)
          let c = span_read_sleb_imm(body, s_i)
          Bytes::push(out, 0x41)
          write_sleb128(out, if wrap_i32(c) == 0 { 1 } else { 0 })
          true
        }
        else if (op_i == 0x45) && (op_next == 0x45) {
          true
        }
        else if (op_i == 0x22) && (op_next == 0x1A) {
          // local.tee N; drop  ->  local.set N (the tee's pushed value is dropped)
          let idx = span_read_uleb_imm(body, s_i)
          Bytes::push(out, 0x21)
          write_uleb128(out, idx)
          true
        }
        else if ((op_i == 0x41) || (op_i == 0x20)) && (op_next == 0x1A) {
          true
        }
        else {
          false
        }
      }
    }
  }
}

let peephole_spans = (body: Bytes, spans: Array[(Int, Int, Int)]) -> (Bytes, Bool) {
  let n = Array::length(spans)
  let out = Bytes::new()
  let mut changed = false
  let mut i = 0
  while i < n {
    let (s_i, e_i, op_i) = Array::get(spans, i)
    if op_i == 0x01 {
      // nop: drop it (always a no-op)
      i = i + 1
      changed = true
    }
    else if (i + 2) < n {
      let (s_j, _, op_j) = Array::get(spans, i + 1)
      let (_, _, op_k) = Array::get(spans, i + 2)
      if (op_i == 0x41) && (op_j == 0x41) && (is_i32_foldable(op_k) || is_i32_cmp(op_k)) {
        let imm_i = span_read_sleb_imm(body, s_i)
        let imm_j = span_read_sleb_imm(body, s_j)
        let folded = if is_i32_cmp(op_k) {
          apply_i32_cmp(op_k, imm_i, imm_j)
        } else {
          apply_i32_fold(op_k, imm_i, imm_j)
        }
        Bytes::push(out, 0x41)
        write_sleb128(out, folded)
        i = i + 3
        changed = true
      } else {
        let is_i32_id = (op_j == 0x41) && (is_i32_binop(op_k) || is_i32_shift(op_k)) && is_identity_op(op_k, span_read_sleb_imm(body, s_j))
        let is_i64_id = (op_j == 0x42) && is_i64_identity_op(op_k, span_read_sleb_imm(body, s_j))
        if is_i32_id || is_i64_id {
          copy_span_bytes(out, body, s_i, e_i)
          i = i + 3
          changed = true
        } else {
          let matched2 = peephole_try2(out, body, spans, i, n)
          if matched2 {
            i = i + 2
            changed = true
          } else {
            copy_span_bytes(out, body, s_i, e_i)
            i = i + 1
          }
        }
      }
    } else {
      let matched2 = peephole_try2(out, body, spans, i, n)
      if matched2 {
        i = i + 2
        changed = true
      } else {
        copy_span_bytes(out, body, s_i, e_i)
        i = i + 1
      }
    }
  }
  (out, changed)
}

let peephole_body = (body: Bytes) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    } else {
      let mut current_body = body
      let mut current_start = code_start
      let mut current_end = code_end
      let mut keep_going = true
      let mut pass_count = 0
      while keep_going && (pass_count < 3) {
        pass_count = pass_count + 1
        let spans = parse_body_spans(current_body, current_start, current_end)
        let (optimized_code, did_change) = peephole_spans(current_body, spans)
        if did_change {
          let new_body = Bytes::new()
          let mut ci = 0
          while ci < current_start {
            Bytes::push(new_body, current_body[ci])
            ci = ci + 1
          }
          let opt_len = Bytes::length(optimized_code)
          let mut oi = 0
          while oi < opt_len {
            Bytes::push(new_body, optimized_code[oi])
            oi = oi + 1
          }
          Bytes::push(new_body, 0x0B)
          current_body = new_body
          current_end = Bytes::length(new_body) - 1
        } else {
          keep_going = false
        }
      }
      current_body
    }
  }
}

let rewrite_body_calls = (body: Bytes, fwd_lookup: Array[Int], max_func: Int) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    }
    else {
      let spans = parse_body_spans(body, code_start, code_end)
      let n = Array::length(spans)
      let out = Bytes::new()
      let mut ci = 0
      while ci < code_start {
        Bytes::push(out, body[ci]); ci = ci + 1
      }
      let mut i = 0
      while i < n {
        let (s_i, e_i, op_i) = Array::get(spans, i)
        if op_i == 0x10 {
          let target = span_read_uleb_imm(body, s_i)
          if (target >= 0) && (target <= max_func) {
            let new_target = Array::get(fwd_lookup, target)
            if new_target >= 0 {
              Bytes::push(out, 0x10)
              write_uleb128(out, new_target)
            } else {
              copy_span_bytes(out, body, s_i, e_i)
            }
          } else {
            copy_span_bytes(out, body, s_i, e_i)
          }
        } else {
          copy_span_bytes(out, body, s_i, e_i)
        }
        i = i + 1
      }
      Bytes::push(out, 0x0B)
      out
    }
  }
}

let detect_forward_call = (body: Bytes, param_count: Int) -> Int {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    (-1)
  }
  else {
    let mut pos = 0
    let (local_count, lp) = read_uleb128(body, 0)
    pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      (-1)
    }
    else {
      let instrs = parse_body_instrs(body, code_start, code_end)
      let n = Array::length(instrs)
      let call_pos = if (n >= 2) && (n >= (param_count + 1)) {
        let (last_op, _) = Array::get(instrs, n - 1)
        if last_op == 0x0F {
          n - 2
        } else {
          n - 1
        }
      } else {
        (-1)
      }
      if call_pos < param_count {
        (-1)
      }
      else {
        if call_pos != param_count {
          (-1)
        }
        else {
          let (call_op, call_target) = Array::get(instrs, call_pos)
          if call_op != 0x10 {
            (-1)
          }
          else {
            let mut ok = true
            let mut gi = 0
            while (gi < param_count) && ok {
              let (op, imm) = Array::get(instrs, gi)
              if (op != 0x20) || (imm != gi) {
                ok = false
              }
              gi = gi + 1
            }
            if ok {
              call_target
            }
            else {
              (-1)
            }
          }
        }
      }
    }
  }
}

export let strip_named_section = (bytes: Bytes, name: String) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      let mut keep = true
      if sid == 0 {
        let (sec_name, _) = read_name(bytes, off)
        if sec_name == name {
          keep = false
        }
      }
      if keep {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

let filter_data_segments = (bytes: Bytes, offset: Int, size: Int) -> Bytes {
  let end_pos = offset + size
  let segments = Array::slice([
    (0, 0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let seg_start = pos
    let mode = bytes[pos]
    pos = pos + 1
    if mode == 0 {
      while (pos < end_pos) && (bytes[pos] != 0x0B) {
        pos = pos + 1
      }
      if pos < end_pos {
        pos = pos + 1
      }
      let (data_len, dp) = read_uleb128(bytes, pos)
      pos = dp + data_len
      Array::push(segments, (seg_start, pos, data_len))
    } else {
      if mode == 1 {
        let (data_len, dp) = read_uleb128(bytes, pos)
        pos = dp + data_len
        Array::push(segments, (seg_start, pos, data_len))
      } else {
        pos = end_pos
      }
    }
    i = i + 1
  }
  let out = Bytes::new()
  let mut kept_count = 0
  let mut si = 0
  while si < Array::length(segments) {
    let (_, _, data_len) = Array::get(segments, si)
    if data_len > 0 {
      kept_count = kept_count + 1
    }
    si = si + 1
  }
  write_uleb128(out, kept_count)
  si = 0
  while si < Array::length(segments) {
    let (seg_start, seg_end, data_len) = Array::get(segments, si)
    if data_len > 0 {
      let mut j = seg_start
      while j < seg_end {
        Bytes::push(out, bytes[j]); j = j + 1
      }
    }
    si = si + 1
  }
  out
}

export let strip_empty_data = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if (sid == 11) && (sz > 0) {
        let new_content = filter_data_segments(bytes, off, sz)
        if Bytes::length(new_content) > 1 {
          emit_section(out, 11, new_content)
        }
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

let get_type_param_count = (bytes: Bytes, type_sec_off: Int, type_sec_sz: Int, type_idx: Int) -> Int {
  let end_pos = type_sec_off + type_sec_sz
  let (type_count, pos0) = read_uleb128(bytes, type_sec_off)
  let mut pos = pos0
  let mut ti = 0
  let mut result = 0
  while (ti < type_count) && (pos < end_pos) {
    pos = pos + 1
    let (param_count, pp) = read_uleb128(bytes, pos)
    pos = pp + param_count
    let (result_count, rp) = read_uleb128(bytes, pos)
    pos = rp + result_count
    if ti == type_idx {
      result = param_count
    }
    else {
      ()
    }
    ti = ti + 1
  }
  result
}

let get_func_param_count = (bytes: Bytes, func_idx: Int, func_type_by_idx: Array[Int]) -> Int {
  if func_idx >= Array::length(func_type_by_idx) {
    (-1)
  }
  else {
    let type_idx = Array::get(func_type_by_idx, func_idx)
    let sections = list_sections(bytes)
    let mut s = 0
    let mut result = (-1)
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 1 {
        result = get_type_param_count(bytes, off, sz, type_idx)
      }
      s = s + 1
    }
    result
  }
}

let rebuild_code_section = (bodies: Array[Bytes]) -> Bytes {
  let out = Bytes::new()
  write_uleb128(out, Array::length(bodies))
  let mut bi = 0
  while bi < Array::length(bodies) {
    let body = Array::get(bodies, bi)
    write_uleb128(out, Bytes::length(body))
    append_bytes(out, body)
    bi = bi + 1
  }
  out
}

let remap_import_section = (bytes: Bytes, offset: Int, size: Int, type_map: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let out = Bytes::new()
  write_uleb128(out, cnt)
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (mlen, mp) = read_uleb128(bytes, pos)
    write_uleb128(out, mlen)
    let mut mi = 0
    while mi < mlen {
      Bytes::push(out, bytes[mp + mi]); mi = mi + 1
    }
    pos = mp + mlen
    let (flen, fp) = read_uleb128(bytes, pos)
    write_uleb128(out, flen)
    let mut fi2 = 0
    while fi2 < flen {
      Bytes::push(out, bytes[fp + fi2]); fi2 = fi2 + 1
    }
    pos = fp + flen
    if pos < end_pos {
      let kind = bytes[pos]; pos = pos + 1
      Bytes::push(out, kind)
      if kind == 0 {
        let (tidx, np) = read_uleb128(bytes, pos); pos = np
        let new_tidx = if tidx < Array::length(type_map) {
          Array::get(type_map, tidx)
        } else {
          tidx
        }
        write_uleb128(out, new_tidx)
      } else {
        if kind == 1 {
          let (reftype, np) = read_uleb128(bytes, pos); pos = np
          write_uleb128(out, reftype)
          let flag = bytes[pos]; pos = pos + 1
          Bytes::push(out, flag)
          let (lim_min, np2) = read_uleb128(bytes, pos); pos = np2
          write_uleb128(out, lim_min)
          if flag == 1 {
            let (lim_max, np3) = read_uleb128(bytes, pos); pos = np3
            write_uleb128(out, lim_max)
          } else {
            ()
          }
        } else {
          if kind == 2 {
            let flag = bytes[pos]; pos = pos + 1
            Bytes::push(out, flag)
            let (lim_min, np2) = read_uleb128(bytes, pos); pos = np2
            write_uleb128(out, lim_min)
            if flag == 1 {
              let (lim_max, np3) = read_uleb128(bytes, pos); pos = np3
              write_uleb128(out, lim_max)
            } else {
              ()
            }
          } else {
            if kind == 3 {
              Bytes::push(out, bytes[pos])
              Bytes::push(out, bytes[pos + 1])
              pos = pos + 2
            } else {
              pos = end_pos
            }
          }
        }
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

let rewrite_type_section = (bytes: Bytes, offset: Int, size: Int, used: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (type_count, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let entries = Array::slice([
    (0, Bytes::new())
  ], 0, 0)
  let mut ti = 0
  while (ti < type_count) && (pos < end_pos) {
    let entry_start = pos
    pos = pos + 1
    let (param_count, pp) = read_uleb128(bytes, pos)
    pos = pp + param_count
    let (result_count, rp) = read_uleb128(bytes, pos)
    pos = rp + result_count
    if array_contains_int(used, ti) {
      let entry = copy_bytes(bytes, entry_start, pos)
      Array::push(entries, (ti, entry))
    } else {
      ()
    }
    ti = ti + 1
  }
  let out = Bytes::new()
  write_uleb128(out, Array::length(entries))
  let mut ei = 0
  while ei < Array::length(entries) {
    let (_, entry) = Array::get(entries, ei)
    append_bytes(out, entry)
    ei = ei + 1
  }
  out
}

let coalesce_code_section = (bytes: Bytes, offset: Int, size: Int, type_sec_off: Int, type_sec_sz: Int, func_type_indices: Array[Int]) -> Bytes {
  let raw_bodies = parse_code_bodies(bytes, offset, size)
  let optimized = Array::slice([
    (Bytes::new())
  ], 0, 0)
  let mut fi = 0
  while fi < Array::length(raw_bodies) {
    let body = Array::get(raw_bodies, fi)
    let param_count = if fi < Array::length(func_type_indices) {
      let tidx = Array::get(func_type_indices, fi)
      get_type_param_count(bytes, type_sec_off, type_sec_sz, tidx)
    } else {
      0
    }
    Array::push(optimized, coalesce_body(body, param_count))
    fi = fi + 1
  }
  rebuild_code_section(optimized)
}

let count_imported_tables = (bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let mut s = 0
  let mut count = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (_, np) = read_uleb128(bytes, pos); pos = np
          } else {
            if kind == 1 {
              count = count + 1
              pos = pos + 1
              let flag = bytes[pos]; pos = pos + 1
              let (_, np2) = read_uleb128(bytes, pos); pos = np2
              if flag == 1 {
                let (_, np3) = read_uleb128(bytes, pos); pos = np3
              }
            } else {
              if kind == 2 {
                let flag = bytes[pos]; pos = pos + 1
                let (_, np2) = read_uleb128(bytes, pos); pos = np2
                if flag == 1 {
                  let (_, np3) = read_uleb128(bytes, pos); pos = np3
                }
              } else {
                if kind == 3 {
                  pos = pos + 2
                }
                else {
                  pos = end_pos
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  count
}

export let remove_empty_sections = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      let mut keep = true
      if (sid >= 1) && (sid <= 12) && (sid != 5) && (sid != 8) {
        if sz > 0 {
          let (cnt, _) = read_uleb128(bytes, off)
          if cnt == 0 {
            keep = false
          } else {
            ()
          }
        } else {
          keep = false
        }
      } else {
        ()
      }
      if keep {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      } else {
        ()
      }
      si = si + 1
    }
    out
  }
}

export let strip_custom_sections = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    while i < len {
      let sec_id = bytes[i]
      let raw_start = i
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if sec_id != 0 {
          let mut j = raw_start
          while j < sec_end {
            Bytes::push(out, bytes[j])
            j = j + 1
          }
        } else {
          ()
        }
        i = sec_end
      }
    }
    out
  }
}

let directize_code_section = (bytes: Bytes, offset: Int, size: Int, slot_to_func: Array[Int], max_slot: Int, func_type_by_idx: Array[Int]) -> Bytes {
  let raw_bodies = parse_code_bodies(bytes, offset, size)
  let optimized = Array::slice([
    (Bytes::new())
  ], 0, 0)
  let mut fi = 0
  while fi < Array::length(raw_bodies) {
    Array::push(optimized, directize_body(Array::get(raw_bodies, fi), slot_to_func, max_slot, func_type_by_idx))
    fi = fi + 1
  }
  rebuild_code_section(optimized)
}

let get_export_func_indices = (bytes: Bytes) -> Array[Int] {
  let result = Array::slice([
    (0)
  ], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 7 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (_, np) = read_name(bytes, pos)
        pos = np
        if pos < end_pos {
          let kind = bytes[pos]
          pos = pos + 1
          let (index, np2) = read_uleb128(bytes, pos)
          pos = np2
          if kind == 0 {
            Array::push(result, index)
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  result
}

export let find_reachable = (bytes: Bytes) -> Array[Int] {
  let graph = build_call_graph(bytes)
  let roots = get_export_func_indices(bytes)
  let import_count = count_import_funcs(bytes)
  let mut max_func_idx = import_count
  let mut gi2 = 0
  while gi2 < Array::length(graph) {
    let (func_idx, callees) = Array::get(graph, gi2)
    if func_idx >= max_func_idx {
      max_func_idx = func_idx + 1
    }
    let mut ci2 = 0
    while ci2 < Array::length(callees) {
      let callee = Array::get(callees, ci2)
      if callee >= max_func_idx {
        max_func_idx = callee + 1
      }
      ci2 = ci2 + 1
    }
    gi2 = gi2 + 1
  }
  let visited = FixedArray::make(max_func_idx + 1, 0)
  let reachable = Array::slice([
    (0)
  ], 0, 0)
  let queue = Array::slice([
    (0)
  ], 0, 0)
  let mut ri = 0
  while ri < Array::length(roots) {
    let root = Array::get(roots, ri)
    if (root >= 0) && (root <= max_func_idx) && (FixedArray::get(visited, root) == 0) {
      FixedArray::set(visited, root, 1)
      Array::push(queue, root)
      Array::push(reachable, root)
    }
    ri = ri + 1
  }
  let mut qi = 0
  while qi < Array::length(queue) {
    let current = Array::get(queue, qi)
    let mut gi = 0
    while gi < Array::length(graph) {
      let (func_idx, callees) = Array::get(graph, gi)
      if func_idx == current {
        let mut ci = 0
        while ci < Array::length(callees) {
          let callee = Array::get(callees, ci)
          if (callee >= 0) && (callee <= max_func_idx) && (FixedArray::get(visited, callee) == 0) {
            FixedArray::set(visited, callee, 1)
            Array::push(reachable, callee)
            Array::push(queue, callee)
          }
          ci = ci + 1
        }
      }
      gi = gi + 1
    }
    qi = qi + 1
  }
  reachable
}

export let dce = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let reachable = find_reachable(bytes)
    let import_count = count_import_funcs(bytes)
    let total_funcs = count_functions(bytes)
    let reachable_flags = FixedArray::make(total_funcs + 1, 0)
    let mut ri = 0
    while ri < Array::length(reachable) {
      let idx = Array::get(reachable, ri)
      if (idx >= 0) && (idx <= total_funcs) {
        FixedArray::set(reachable_flags, idx, 1)
      }
      ri = ri + 1
    }
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 10 {
        let raw_bodies = parse_code_bodies(bytes, off, sz)
        let dce_bodies = Array::slice([
          (Bytes::new())
        ], 0, 0)
        let mut fi2 = 0
        while fi2 < Array::length(raw_bodies) {
          let func_idx2 = import_count + fi2
          if (func_idx2 >= 0) && (func_idx2 <= total_funcs) && (FixedArray::get(reachable_flags, func_idx2) == 1) {
            Array::push(dce_bodies, Array::get(raw_bodies, fi2))
          } else {
            let stub = Bytes::new()
            Bytes::push(stub, 0x00)
            Bytes::push(stub, 0x00)
            Bytes::push(stub, 0x0B)
            Array::push(dce_bodies, stub)
          }
          fi2 = fi2 + 1
        }
        emit_section(out, 10, rebuild_code_section(dce_bodies))
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

// Roots for true DCE: exported functions, any function named by a start
// section, and any function placed in a table by an element segment (it may be
// reached via call_indirect we cannot trace, so it must be kept).
let collect_func_roots = (bytes: Bytes) -> Array[Int] {
  let roots = Array::slice([
    (0)
  ], 0, 0)
  let exp = get_export_func_indices(bytes)
  let mut i = 0
  while i < Array::length(exp) {
    Array::push(roots, Array::get(exp, i))
    i = i + 1
  }
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 8 {
      let (fidx, _) = read_uleb128(bytes, off)
      Array::push(roots, fidx)
    }
    else if sid == 9 {
      let emap = parse_element_table_map(bytes, off, sz)
      let mut e = 0
      while e < Array::length(emap) {
        let (_, fidx) = Array::get(emap, e)
        Array::push(roots, fidx)
        e = e + 1
      }
    }
    s = s + 1
  }
  roots
}

// BFS over the call graph from an explicit root set (generalizes find_reachable).
let reachable_from = (bytes: Bytes, roots: Array[Int]) -> Array[Int] {
  let graph = build_call_graph(bytes)
  let import_count = count_import_funcs(bytes)
  let mut max_func_idx = import_count
  let mut gi2 = 0
  while gi2 < Array::length(graph) {
    let (func_idx, callees) = Array::get(graph, gi2)
    if func_idx >= max_func_idx {
      max_func_idx = func_idx + 1
    }
    let mut ci2 = 0
    while ci2 < Array::length(callees) {
      let callee = Array::get(callees, ci2)
      if callee >= max_func_idx {
        max_func_idx = callee + 1
      }
      ci2 = ci2 + 1
    }
    gi2 = gi2 + 1
  }
  let mut ri0 = 0
  while ri0 < Array::length(roots) {
    let r = Array::get(roots, ri0)
    if r >= max_func_idx {
      max_func_idx = r + 1
    }
    ri0 = ri0 + 1
  }
  let visited = FixedArray::make(max_func_idx + 2, 0)
  let reachable = Array::slice([
    (0)
  ], 0, 0)
  let queue = Array::slice([
    (0)
  ], 0, 0)
  let mut ri = 0
  while ri < Array::length(roots) {
    let root = Array::get(roots, ri)
    if (root >= 0) && (root <= max_func_idx) && (FixedArray::get(visited, root) == 0) {
      FixedArray::set(visited, root, 1)
      Array::push(queue, root)
      Array::push(reachable, root)
    }
    ri = ri + 1
  }
  let mut qi = 0
  while qi < Array::length(queue) {
    let current = Array::get(queue, qi)
    let mut gi = 0
    while gi < Array::length(graph) {
      let (func_idx, callees) = Array::get(graph, gi)
      if func_idx == current {
        let mut ci = 0
        while ci < Array::length(callees) {
          let callee = Array::get(callees, ci)
          if (callee >= 0) && (callee <= max_func_idx) && (FixedArray::get(visited, callee) == 0) {
            FixedArray::set(visited, callee, 1)
            Array::push(reachable, callee)
            Array::push(queue, callee)
          }
          ci = ci + 1
        }
      }
      gi = gi + 1
    }
    qi = qi + 1
  }
  reachable
}

// Reserialize an export section, remapping function-export indices (kind 0)
// through idx_map (old global func index -> new index).
let remap_export_section = (bytes: Bytes, offset: Int, size: Int, idx_map: Array[Int]) -> Bytes {
  let end_pos = offset + size
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let out = Bytes::new()
  write_uleb128(out, cnt)
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (name, np) = read_name(bytes, pos)
    pos = np
    let kind = bytes[pos]
    pos = pos + 1
    let (index, np2) = read_uleb128(bytes, pos)
    pos = np2
    write_uleb128(out, String::length(name))
    let mut ci = 0
    while ci < String::length(name) {
      Bytes::push(out, String::char_code_at(name, ci))
      ci = ci + 1
    }
    Bytes::push(out, kind)
    let new_index = if (kind == 0) && (index < Array::length(idx_map)) {
      Array::get(idx_map, index)
    } else {
      index
    }
    write_uleb128(out, if new_index >= 0 { new_index } else { index })
    i = i + 1
  }
  out
}

// Reserialize an active element section, remapping the function indices it
// places in the table through idx_map. Handles segment flag 0 (table 0, i32
// const offset) and flag 2 (explicit table, elemkind). Returns (out, true) on
// success; on any unsupported shape returns (_, false) so dce_remove bails.
let remap_element_section = (bytes: Bytes, offset: Int, size: Int, idx_map: Array[Int]) -> (Bytes, Bool) {
  let end_pos = offset + size
  let (seg_count, pos0) = read_uleb128(bytes, offset)
  let out = Bytes::new()
  write_uleb128(out, seg_count)
  let mut pos = pos0
  let mut si = 0
  let mut ok = true
  while (si < seg_count) && (pos < end_pos) && ok {
    let flags = bytes[pos]
    pos = pos + 1
    if (flags == 0) || (flags == 2) {
      Bytes::push(out, flags)
      if flags == 2 {
        let (tidx, pt) = read_uleb128(bytes, pos)
        write_uleb128(out, tidx)
        pos = pt
      }
      if (pos < end_pos) && (bytes[pos] == 0x41) {
        Bytes::push(out, 0x41)
        let sleb_start = pos + 1
        let (_, p1) = read_sleb128(bytes, sleb_start)
        let mut cp = sleb_start
        while cp < p1 {
          Bytes::push(out, bytes[cp]); cp = cp + 1
        }
        pos = p1
        if (pos < end_pos) && (bytes[pos] == 0x0B) {
          Bytes::push(out, 0x0B)
          pos = pos + 1
          if flags == 2 {
            Bytes::push(out, bytes[pos]); pos = pos + 1
          }
          let (fc, pfc) = read_uleb128(bytes, pos)
          pos = pfc
          write_uleb128(out, fc)
          let mut fi = 0
          while (fi < fc) && (pos < end_pos) {
            let (fidx, p3) = read_uleb128(bytes, pos)
            pos = p3
            let nf = if (fidx < Array::length(idx_map)) && (Array::get(idx_map, fidx) >= 0) {
              Array::get(idx_map, fidx)
            } else {
              fidx
            }
            write_uleb128(out, nf)
            fi = fi + 1
          }
        } else {
          ok = false
        }
      } else {
        ok = false
      }
    } else {
      ok = false
    }
    si = si + 1
  }
  (out, ok)
}

// True dead-function elimination: physically remove unreachable defined
// functions and renumber every surviving function reference (calls, exports,
// start, element segments), unlike `dce` which only stubs dead bodies. Bails
// (returns input unchanged) only when an element section uses a shape
// remap_element_section cannot reserialize; callers fall back to `dce` then.
export let dce_remove = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let sections = list_sections(bytes)
    let import_count = count_import_funcs(bytes)
    let total_funcs = count_functions(bytes)
    let defined_type_indices = parse_func_type_indices(bytes)
    let roots = collect_func_roots(bytes)
    let reachable = reachable_from(bytes, roots)
    let keep = FixedArray::make(total_funcs + 1, 0)
    let mut ic = 0
    while ic < import_count {
      if ic <= total_funcs {
        FixedArray::set(keep, ic, 1)
      }
      ic = ic + 1
    }
    let mut rr = 0
    while rr < Array::length(reachable) {
      let idx = Array::get(reachable, rr)
      if (idx >= 0) && (idx <= total_funcs) {
        FixedArray::set(keep, idx, 1)
      }
      rr = rr + 1
    }
    let idx_map = Array::slice([
      (0)
    ], 0, 0)
    let mut next_new = 0
    let mut gi = 0
    while gi < total_funcs {
      if FixedArray::get(keep, gi) == 1 {
        Array::push(idx_map, next_new)
        next_new = next_new + 1
      } else {
        Array::push(idx_map, -1)
      }
      gi = gi + 1
    }
    let kept_defined = Array::slice([
      (0)
    ], 0, 0)
    let mut df = 0
    while df < (total_funcs - import_count) {
      let g = import_count + df
      if (g <= total_funcs) && (FixedArray::get(keep, g) == 1) {
        Array::push(kept_defined, df)
      }
      df = df + 1
    }
    let kept_count = Array::length(kept_defined)
    let mut elem_present = false
    let mut elem_ok = true
    let mut elem_bytes = Bytes::new()
    let mut es = 0
    while es < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, es)
      if sid == 9 {
        elem_present = true
        let (eb, eok) = remap_element_section(bytes, off, sz, idx_map)
        elem_bytes = eb
        elem_ok = eok
      }
      es = es + 1
    }
    if elem_present && (elem_ok == false) {
      copy_bytes(bytes, 0, len)
    }
    else {
      let out = Bytes::new()
      let mut bi = 0
      while bi < 8 {
        Bytes::push(out, bytes[bi]); bi = bi + 1
      }
      let mut s = 0
      while s < Array::length(sections) {
        let (sid, off, sz) = Array::get(sections, s)
        if sid == 3 {
          if kept_count > 0 {
            let fsec = Bytes::new()
            write_uleb128(fsec, kept_count)
            let mut ki = 0
            while ki < kept_count {
              let fi = Array::get(kept_defined, ki)
              let tidx = if fi < Array::length(defined_type_indices) {
                Array::get(defined_type_indices, fi)
              } else {
                0
              }
              write_uleb128(fsec, tidx)
              ki = ki + 1
            }
            emit_section(out, 3, fsec)
          }
        }
        else if sid == 10 {
          if kept_count > 0 {
            let raw_bodies = parse_code_bodies(bytes, off, sz)
            let new_bodies = Array::slice([
              (Bytes::new())
            ], 0, 0)
            let mut ki = 0
            while ki < kept_count {
              let fi = Array::get(kept_defined, ki)
              if fi < Array::length(raw_bodies) {
                let body = Array::get(raw_bodies, fi)
                Array::push(new_bodies, rewrite_body_calls(body, idx_map, total_funcs - 1))
              }
              ki = ki + 1
            }
            emit_section(out, 10, rebuild_code_section(new_bodies))
          }
        }
        else if sid == 7 {
          emit_section(out, 7, remap_export_section(bytes, off, sz, idx_map))
        }
        else if sid == 9 {
          emit_section(out, 9, elem_bytes)
        }
        else if sid == 8 {
          let (fidx, _) = read_uleb128(bytes, off)
          let new_fidx = if (fidx < Array::length(idx_map)) && (Array::get(idx_map, fidx) >= 0) {
            Array::get(idx_map, fidx)
          } else {
            fidx
          }
          let ssec = Bytes::new()
          write_uleb128(ssec, new_fidx)
          emit_section(out, 8, ssec)
        }
        else {
          let content = copy_bytes(bytes, off, off + sz)
          emit_section(out, sid, content)
        }
        s = s + 1
      }
      out
    }
  }
}

let parse_element_table_map = (bytes: Bytes, elem_off: Int, elem_sz: Int) -> Array[(Int, Int)] {
  let end_pos = elem_off + elem_sz
  let result = Array::slice([
    (0, 0)
  ], 0, 0)
  let (seg_count, pos0) = read_uleb128(bytes, elem_off)
  let mut pos = pos0
  let mut si = 0
  let mut failed = false
  while (si < seg_count) && (pos < end_pos) && (failed == false) {
    let flags = bytes[pos]
    pos = pos + 1
    if flags == 0 {
      if (pos < end_pos) && (bytes[pos] == 0x41) {
        let (offset_val, p1) = read_sleb128(bytes, pos + 1)
        if (p1 < end_pos) && (bytes[p1] == 0x0B) {
          pos = p1 + 1
          let (func_count, p2) = read_uleb128(bytes, pos)
          pos = p2
          let mut fi = 0
          while (fi < func_count) && (pos < end_pos) {
            let (func_idx, p3) = read_uleb128(bytes, pos)
            Array::push(result, (offset_val + fi, func_idx))
            pos = p3
            fi = fi + 1
          }
        } else {
          failed = true
        }
      } else {
        failed = true
      }
    } else {
      if flags == 2 {
        let (table_idx, p1) = read_uleb128(bytes, pos)
        pos = p1
        if (table_idx == 0) && (pos < end_pos) && (bytes[pos] == 0x41) {
          let (offset_val, p2) = read_sleb128(bytes, pos + 1)
          if (p2 < end_pos) && (bytes[p2] == 0x0B) {
            pos = p2 + 1
            if pos < end_pos {
              pos = pos + 1
              let (func_count, p3) = read_uleb128(bytes, pos)
              pos = p3
              let mut fi = 0
              while (fi < func_count) && (pos < end_pos) {
                let (func_idx, p4) = read_uleb128(bytes, pos)
                Array::push(result, (offset_val + fi, func_idx))
                pos = p4
                fi = fi + 1
              }
            } else {
              failed = true
            }
          } else {
            failed = true
          }
        } else {
          failed = true
        }
      } else {
        failed = true
      }
    }
    si = si + 1
  }
  if failed {
    Array::slice([
      (0, 0)
    ], 0, 0)
  }
  else {
    result
  }
}

let parse_func_type_indices = (bytes: Bytes) -> Array[Int] {
  let result = Array::slice([
    (0)
  ], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 3 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (tidx, np) = read_uleb128(bytes, pos)
        Array::push(result, tidx)
        pos = np
        i = i + 1
      }
    } else {
      ()
    }
    s = s + 1
  }
  result
}

export let coalesce_locals = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let sections = list_sections(bytes)
    let mut type_sec_off = 0
    let mut type_sec_sz = 0
    let mut si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      if sid == 1 {
        type_sec_off = off; type_sec_sz = sz
      }
      else {
        ()
      }
      si = si + 1
    }
    let func_type_indices = parse_func_type_indices(bytes)
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      if sid == 10 {
        let new_content = coalesce_code_section(bytes, off, sz, type_sec_off, type_sec_sz, func_type_indices)
        emit_section(out, 10, new_content)
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      si = si + 1
    }
    out
  }
}

let build_func_type_by_index = (bytes: Bytes) -> Array[Int] {
  let result = Array::slice([
    (0)
  ], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 2 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
        let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
        if pos < end_pos {
          let kind = bytes[pos]; pos = pos + 1
          if kind == 0 {
            let (tidx, np) = read_uleb128(bytes, pos); pos = np
            Array::push(result, tidx)
          } else {
            if kind == 1 {
              pos = pos + 1
              let flag = bytes[pos]; pos = pos + 1
              let (_, np2) = read_uleb128(bytes, pos); pos = np2
              if flag == 1 {
                let (_, np3) = read_uleb128(bytes, pos); pos = np3
              }
            } else {
              if kind == 2 {
                let flag = bytes[pos]; pos = pos + 1
                let (_, np2) = read_uleb128(bytes, pos); pos = np2
                if flag == 1 {
                  let (_, np3) = read_uleb128(bytes, pos); pos = np3
                }
              } else {
                if kind == 3 {
                  pos = pos + 2
                }
                else {
                  pos = end_pos
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
    s = s + 1
  }
  s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 3 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (tidx, np) = read_uleb128(bytes, pos)
        Array::push(result, tidx)
        pos = np
        i = i + 1
      }
    }
    s = s + 1
  }
  result
}

let build_forwarding_map = (bytes: Bytes) -> Array[(Int, Int)] {
  let result = Array::slice([
    (0, 0)
  ], 0, 0)
  let import_count = count_import_funcs(bytes)
  let func_type_by_idx = build_func_type_by_index(bytes)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 10 {
      let end_pos = off + sz
      let (func_count, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut fi = 0
      while (fi < func_count) && (pos < end_pos) {
        let func_idx = import_count + fi
        let (body_size, bp) = read_uleb128(bytes, pos)
        let body = copy_bytes(bytes, bp, bp + body_size)
        let param_count = get_func_param_count(bytes, func_idx, func_type_by_idx)
        if param_count >= 0 {
          let target = detect_forward_call(body, param_count)
          if (target >= 0) && (target != func_idx) {
            if (target < Array::length(func_type_by_idx)) && (func_idx < Array::length(func_type_by_idx)) {
              let wrapper_type = Array::get(func_type_by_idx, func_idx)
              let target_type = Array::get(func_type_by_idx, target)
              if wrapper_type == target_type {
                Array::push(result, (func_idx, target))
              }
            }
          }
        }
        pos = bp + body_size
        fi = fi + 1
      }
    }
    s = s + 1
  }
  let resolved = Array::slice([
    (0, 0)
  ], 0, 0)
  let mut ri = 0
  while ri < Array::length(result) {
    let (wrapper, initial_target) = Array::get(result, ri)
    let mut current = initial_target
    let mut steps = 0
    let mut valid = true
    while (steps < 20) && valid {
      let mut found = false
      let mut fi2 = 0
      while (fi2 < Array::length(result)) && (found == false) {
        let (w, t) = Array::get(result, fi2)
        if w == current {
          if t == wrapper {
            valid = false
          }
          else {
            current = t; found = true
          }
        }
        fi2 = fi2 + 1
      }
      if found == false {
        steps = 20
      }
      else {
        steps = steps + 1
      }
    }
    if valid {
      Array::push(resolved, (wrapper, current))
    }
    ri = ri + 1
  }
  resolved
}

let has_disallowed_table_ops = (bytes: Bytes, code_off: Int, code_sz: Int) -> Bool {
  let end_pos = code_off + code_sz
  let (func_count, pos0) = read_uleb128(bytes, code_off)
  let mut pos = pos0
  let mut fi = 0
  let mut found = false
  while (fi < func_count) && (pos < end_pos) && (found == false) {
    let (body_size, bp) = read_uleb128(bytes, pos)
    let body = copy_bytes(bytes, bp, bp + body_size)
    let body_len = Bytes::length(body)
    let (local_count, lp) = read_uleb128(body, 0)
    let mut bpos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, bpos)
      bpos = tp + 1
      lc = lc + 1
    }
    while (bpos < body_len) && (found == false) {
      let op = body[bpos]
      if (op == 0x25) || (op == 0x26) {
        found = true
      } else {
        if op == 0xFC {
          let (sub_op, _) = read_uleb128(body, bpos + 1)
          if (sub_op >= 12) && (sub_op <= 17) {
            found = true
          }
          else {
            ()
          }
        } else {
          ()
        }
      }
      let (_, _, next) = decode_instr(body, bpos)
      bpos = next
    }
    pos = bp + body_size
    fi = fi + 1
  }
  found
}

export let directize = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    if count_imported_tables(bytes) > 0 {
      copy_bytes(bytes, 0, len)
    }
    else {
      if count_local_tables(bytes) != 1 {
        copy_bytes(bytes, 0, len)
      }
      else {
        if is_table_exported(bytes) {
          copy_bytes(bytes, 0, len)
        }
        else {
          let sections = list_sections(bytes)
          let mut elem_off = 0
          let mut elem_sz = 0
          let mut code_off = 0
          let mut code_sz = 0
          let mut has_elem = false
          let mut has_code = false
          let mut s = 0
          while s < Array::length(sections) {
            let (sid, off, sz) = Array::get(sections, s)
            if sid == 9 {
              elem_off = off; elem_sz = sz; has_elem = true
            }
            else {
              if sid == 10 {
                code_off = off; code_sz = sz; has_code = true
              }
              else {
                ()
              }
            }
            s = s + 1
          }
          if (has_elem == false) || (has_code == false) {
            copy_bytes(bytes, 0, len)
          }
          else {
            if has_disallowed_table_ops(bytes, code_off, code_sz) {
              copy_bytes(bytes, 0, len)
            }
            else {
              let table_map = parse_element_table_map(bytes, elem_off, elem_sz)
              if Array::length(table_map) == 0 {
                copy_bytes(bytes, 0, len)
              }
              else {
                let func_type_by_idx = build_func_type_by_index(bytes)
                let mut max_slot = 0
                let mut ti = 0
                while ti < Array::length(table_map) {
                  let (slot, _) = Array::get(table_map, ti)
                  if slot > max_slot {
                    max_slot = slot
                  }
                  ti = ti + 1
                }
                let slot_to_func = Array::slice([
                  (0)
                ], 0, 0)
                let mut si2 = 0
                while si2 < (max_slot + 2) {
                  Array::push(slot_to_func, (-1)); si2 = si2 + 1
                }
                ti = 0
                while ti < Array::length(table_map) {
                  let (slot, func_idx) = Array::get(table_map, ti)
                  if (slot >= 0) && (slot <= max_slot) {
                    Array::set(slot_to_func, slot, func_idx)
                  }
                  ti = ti + 1
                }
                let new_code = directize_code_section(bytes, code_off, code_sz, slot_to_func, max_slot, func_type_by_idx)
                let out = Bytes::new()
                let mut i = 0
                while i < 8 {
                  Bytes::push(out, bytes[i]); i = i + 1
                }
                s = 0
                while s < Array::length(sections) {
                  let (sid, off, sz) = Array::get(sections, s)
                  if sid == 10 {
                    emit_section(out, 10, new_code)
                  } else {
                    let content = copy_bytes(bytes, off, off + sz)
                    emit_section(out, sid, content)
                  }
                  s = s + 1
                }
                out
              }
            }
          }
        }
      }
    }
  }
}

let rewrite_calls_forwarding = (bytes: Bytes, offset: Int, size: Int, fwd_lookup: Array[Int], max_func: Int) -> Bytes {
  let raw_bodies = parse_code_bodies(bytes, offset, size)
  let optimized = Array::slice([
    (Bytes::new())
  ], 0, 0)
  let mut fi = 0
  while fi < Array::length(raw_bodies) {
    Array::push(optimized, rewrite_body_calls(Array::get(raw_bodies, fi), fwd_lookup, max_func))
    fi = fi + 1
  }
  rebuild_code_section(optimized)
}

export let call_forwarding = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let fwd_map = build_forwarding_map(bytes)
    if Array::length(fwd_map) == 0 {
      copy_bytes(bytes, 0, len)
    }
    else {
      let total_funcs = count_functions(bytes)
      let fwd_lookup = Array::slice([
        (0)
      ], 0, 0)
      let mut fli = 0
      while fli < (total_funcs + 1) {
        Array::push(fwd_lookup, (-1)); fli = fli + 1
      }
      let mut mi = 0
      while mi < Array::length(fwd_map) {
        let (wrapper, target) = Array::get(fwd_map, mi)
        if (wrapper >= 0) && (wrapper <= total_funcs) {
          Array::set(fwd_lookup, wrapper, target)
        }
        mi = mi + 1
      }
      let sections = list_sections(bytes)
      let out = Bytes::new()
      let mut i = 0
      while i < 8 {
        Bytes::push(out, bytes[i]); i = i + 1
      }
      let mut s = 0
      while s < Array::length(sections) {
        let (sid, off, sz) = Array::get(sections, s)
        if sid == 10 {
          let new_code = rewrite_calls_forwarding(bytes, off, sz, fwd_lookup, total_funcs)
          emit_section(out, 10, new_code)
        } else {
          let content = copy_bytes(bytes, off, off + sz)
          emit_section(out, sid, content)
        }
        s = s + 1
      }
      out
    }
  }
}

let collect_used_type_indices = (bytes: Bytes) -> Array[Int] {
  let used = Array::slice([
    (0)
  ], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 3 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        let (tidx, np) = read_uleb128(bytes, pos)
        if array_contains_int(used, tidx) == false {
          Array::push(used, tidx)
        } else {
          ()
        }
        pos = np
        i = i + 1
      }
    } else {
      if sid == 2 {
        let end_pos = off + sz
        let (cnt, pos0) = read_uleb128(bytes, off)
        let mut pos = pos0
        let mut i = 0
        while (i < cnt) && (pos < end_pos) {
          let (mlen, mp) = read_uleb128(bytes, pos); pos = mp + mlen
          let (flen, fp) = read_uleb128(bytes, pos); pos = fp + flen
          if pos < end_pos {
            let kind = bytes[pos]; pos = pos + 1
            if kind == 0 {
              let (tidx, np) = read_uleb128(bytes, pos); pos = np
              if array_contains_int(used, tidx) == false {
                Array::push(used, tidx)
              } else {
                ()
              }
            } else {
              if kind == 1 {
                let (_, np) = read_uleb128(bytes, pos); pos = np
                let flag = bytes[pos]; pos = pos + 1
                let (_, np2) = read_uleb128(bytes, pos); pos = np2
                if flag == 1 {
                  let (_, np3) = read_uleb128(bytes, pos); pos = np3
                }
                else {
                  ()
                }
              } else {
                if kind == 2 {
                  let flag = bytes[pos]; pos = pos + 1
                  let (_, np2) = read_uleb128(bytes, pos); pos = np2
                  if flag == 1 {
                    let (_, np3) = read_uleb128(bytes, pos); pos = np3
                  }
                  else {
                    ()
                  }
                } else {
                  if kind == 3 {
                    pos = pos + 2
                  }
                  else {
                    pos = end_pos
                  }
                }
              }
            }
          } else {
            ()
          }
          i = i + 1
        }
      } else {
        ()
      }
    }
    s = s + 1
  }
  used
}

export let remove_unused_types = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let used = collect_used_type_indices(bytes)
    let sections = list_sections(bytes)
    let mut type_count = 0
    let mut ts = 0
    while ts < Array::length(sections) {
      let (sid, off, _) = Array::get(sections, ts)
      if sid == 1 {
        let (cnt, _) = read_uleb128(bytes, off); type_count = cnt
      }
      else {
        ()
      }
      ts = ts + 1
    }
    let used_bitset = FixedArray::make(type_count + 1, 0)
    let mut ui = 0
    while ui < Array::length(used) {
      let tidx = Array::get(used, ui)
      if (tidx >= 0) && (tidx < type_count) {
        FixedArray::set(used_bitset, tidx, 1)
      }
      ui = ui + 1
    }
    let type_map = Array::slice([
      (0)
    ], 0, 0)
    let mut new_idx = 0
    let mut ti = 0
    while ti < type_count {
      if FixedArray::get(used_bitset, ti) == 1 {
        Array::push(type_map, new_idx)
        new_idx = new_idx + 1
      } else {
        Array::push(type_map, (-1))
      }
      ti = ti + 1
    }
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let mut si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      if sid == 1 {
        let new_content = rewrite_type_section(bytes, off, sz, used)
        emit_section(out, 1, new_content)
      } else {
        if sid == 3 {
          let new_content = remap_func_section(bytes, off, sz, type_map)
          emit_section(out, 3, new_content)
        } else {
          if sid == 2 {
            let new_content = remap_import_section(bytes, off, sz, type_map)
            emit_section(out, 2, new_content)
          } else {
            let content = copy_bytes(bytes, off, off + sz)
            emit_section(out, sid, content)
          }
        }
      }
      si = si + 1
    }
    out
  }
}

let optimize_code_section_content = (bytes: Bytes, offset: Int, size: Int) -> Bytes {
  let raw_bodies = parse_code_bodies(bytes, offset, size)
  let optimized = Array::slice([
    (Bytes::new())
  ], 0, 0)
  let mut fi = 0
  while fi < Array::length(raw_bodies) {
    Array::push(optimized, peephole_body(Array::get(raw_bodies, fi)))
    fi = fi + 1
  }
  rebuild_code_section(optimized)
}

export let optimize_code_section = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let out = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(out, bytes[i]); i = i + 1
    }
    let sections = list_sections(bytes)
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 10 {
        let new_content = optimize_code_section_content(bytes, off, sz)
        emit_section(out, 10, new_content)
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

// Result-arity of a function type (mirror of get_type_param_count).
let get_type_result_count = (bytes: Bytes, type_sec_off: Int, type_sec_sz: Int, type_idx: Int) -> Int {
  let end_pos = type_sec_off + type_sec_sz
  let (type_count, pos0) = read_uleb128(bytes, type_sec_off)
  let mut pos = pos0
  let mut ti = 0
  let mut result = 0
  while (ti < type_count) && (pos < end_pos) {
    pos = pos + 1
    let (param_count, pp) = read_uleb128(bytes, pos)
    pos = pp + param_count
    let (result_count, rp) = read_uleb128(bytes, pos)
    pos = rp + result_count
    if ti == type_idx {
      result = result_count
    }
    else {
      ()
    }
    ti = ti + 1
  }
  result
}

// A function body with no instructions other than the terminating `end`.
let is_body_empty = (body: Bytes) -> Bool {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    false
  }
  else {
    let (local_count, lp) = read_uleb128(body, 0)
    let mut pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    pos >= (body_len - 1)
  }
}

// Drop `call F` instructions whose target F is an empty () -> () function:
// such a call has no stack effect and no side effect, so removing it is a
// semantics-preserving no-op. Leaves func indices untouched (DCE renumbers).
let remove_noop_calls_body = (body: Bytes, noop: Array[Int], max_func: Int) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let (local_count, lp) = read_uleb128(body, 0)
    let mut pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    }
    else {
      let spans = parse_body_spans(body, code_start, code_end)
      let out = Bytes::new()
      let mut ci = 0
      while ci < code_start {
        Bytes::push(out, body[ci]); ci = ci + 1
      }
      let n = Array::length(spans)
      let mut i = 0
      while i < n {
        let (s_i, e_i, op_i) = Array::get(spans, i)
        if op_i == 0x10 {
          let target = span_read_uleb_imm(body, s_i)
          if (target >= 0) && (target <= max_func) && array_contains_int(noop, target) {
            ()
          } else {
            copy_span_bytes(out, body, s_i, e_i)
          }
        } else {
          copy_span_bytes(out, body, s_i, e_i)
        }
        i = i + 1
      }
      Bytes::push(out, 0x0B)
      out
    }
  }
}

// Inline (delete) calls to empty () -> () functions; the now-uncalled empty
// functions are removed by the following DCE pass.
export let inline_empty_calls = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let func_type_by_idx = build_func_type_by_index(bytes)
    let import_count = count_import_funcs(bytes)
    let total_funcs = count_functions(bytes)
    let sections = list_sections(bytes)
    let mut type_off = -1
    let mut type_sz = 0
    let mut code_off = -1
    let mut code_sz = 0
    let mut si = 0
    while si < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, si)
      if sid == 1 {
        type_off = off
        type_sz = sz
      }
      else if sid == 10 {
        code_off = off
        code_sz = sz
      }
      si = si + 1
    }
    if (code_off < 0) || (type_off < 0) {
      copy_bytes(bytes, 0, len)
    }
    else {
      let raw_bodies = parse_code_bodies(bytes, code_off, code_sz)
      let noop = Array::slice([
        (0)
      ], 0, 0)
      let mut fi = 0
      while fi < Array::length(raw_bodies) {
        let g = import_count + fi
        if (g >= 0) && (g < Array::length(func_type_by_idx)) {
          let tidx = Array::get(func_type_by_idx, g)
          let pc = get_type_param_count(bytes, type_off, type_sz, tidx)
          let rc = get_type_result_count(bytes, type_off, type_sz, tidx)
          if (pc == 0) && (rc == 0) && is_body_empty(Array::get(raw_bodies, fi)) {
            Array::push(noop, g)
          }
        }
        fi = fi + 1
      }
      if Array::length(noop) == 0 {
        copy_bytes(bytes, 0, len)
      }
      else {
        let new_bodies = Array::slice([
          (Bytes::new())
        ], 0, 0)
        let mut bi = 0
        while bi < Array::length(raw_bodies) {
          Array::push(new_bodies, remove_noop_calls_body(Array::get(raw_bodies, bi), noop, total_funcs - 1))
          bi = bi + 1
        }
        let out = Bytes::new()
        let mut hi = 0
        while hi < 8 {
          Bytes::push(out, bytes[hi]); hi = hi + 1
        }
        let mut s = 0
        while s < Array::length(sections) {
          let (sid, off, sz) = Array::get(sections, s)
          if sid == 10 {
            emit_section(out, 10, rebuild_code_section(new_bodies))
          } else {
            let content = copy_bytes(bytes, off, off + sz)
            emit_section(out, sid, content)
          }
          s = s + 1
        }
        out
      }
    }
  }
}

// Parse instruction spans of a whole function body (locals header skipped).
let parse_full_body_spans = (body: Bytes) -> Array[(Int, Int, Int)] {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    Array::slice([
      (0, 0, 0)
    ], 0, 0)
  }
  else {
    let (local_count, lp) = read_uleb128(body, 0)
    let mut pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    parse_body_spans(body, pos, body_len - 1)
  }
}

// Minimum size of each *defined* table (index space after imported tables).
let parse_table_mins = (bytes: Bytes) -> Array[Int] {
  let result = Array::slice([
    (0)
  ], 0, 0)
  let sections = list_sections(bytes)
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 4 {
      let end_pos = off + sz
      let (cnt, pos0) = read_uleb128(bytes, off)
      let mut pos = pos0
      let mut i = 0
      while (i < cnt) && (pos < end_pos) {
        pos = pos + 1
        let flag = bytes[pos]
        pos = pos + 1
        let (min_v, np) = read_uleb128(bytes, pos)
        pos = np
        if flag == 1 {
          let (_, np2) = read_uleb128(bytes, pos)
          pos = np2
        }
        Array::push(result, min_v)
        i = i + 1
      }
    }
    s = s + 1
  }
  result
}

// True if any body uses a table opcode: call_indirect, table.get/set, or any
// 0xFC table.* (init/drop/copy/grow/size/fill). Used to decide table removal.
let code_uses_any_table_op = (bytes: Bytes) -> Bool {
  let sections = list_sections(bytes)
  let mut found = false
  let mut s = 0
  while s < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, s)
    if sid == 10 {
      let raw_bodies = parse_code_bodies(bytes, off, sz)
      let mut bi = 0
      while bi < Array::length(raw_bodies) {
        let body = Array::get(raw_bodies, bi)
        let spans = parse_full_body_spans(body)
        let mut i = 0
        while i < Array::length(spans) {
          let (s_i, _, op_i) = Array::get(spans, i)
          if (op_i == 0x11) || (op_i == 0x25) || (op_i == 0x26) {
            found = true
          }
          else if op_i == 0xFC {
            let (sub, _) = read_uleb128(body, s_i + 1)
            if (sub >= 12) && (sub <= 17) {
              found = true
            }
          }
          i = i + 1
        }
        bi = bi + 1
      }
    }
    s = s + 1
  }
  found
}

// Replace `table.size t` with `i32.const <min size of table t>` in one body.
let fold_table_size_body = (body: Bytes, table_mins: Array[Int]) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let (local_count, lp) = read_uleb128(body, 0)
    let mut pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    }
    else {
      let spans = parse_body_spans(body, code_start, code_end)
      let out = Bytes::new()
      let mut ci = 0
      while ci < code_start {
        Bytes::push(out, body[ci]); ci = ci + 1
      }
      let mut i = 0
      while i < Array::length(spans) {
        let (s_i, e_i, op_i) = Array::get(spans, i)
        if op_i == 0xFC {
          let (sub, p_after_sub) = read_uleb128(body, s_i + 1)
          if sub == 16 {
            let (tidx, _) = read_uleb128(body, p_after_sub)
            if (tidx >= 0) && (tidx < Array::length(table_mins)) {
              Bytes::push(out, 0x41)
              write_sleb128(out, Array::get(table_mins, tidx))
            } else {
              copy_span_bytes(out, body, s_i, e_i)
            }
          } else {
            copy_span_bytes(out, body, s_i, e_i)
          }
        } else {
          copy_span_bytes(out, body, s_i, e_i)
        }
        i = i + 1
      }
      Bytes::push(out, 0x0B)
      out
    }
  }
}

// table.size -> i32.const folding. Only when every table is locally defined
// (no imported tables shift the index space) and no table.grow exists (so the
// current size equals the declared minimum). The resulting `i32.const; drop`
// is cleaned by peephole, often emptying the body.
export let fold_table_size = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else if count_imported_tables(bytes) > 0 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let table_mins = parse_table_mins(bytes)
    if Array::length(table_mins) == 0 {
      copy_bytes(bytes, 0, len)
    }
    else {
      // bail if any table.grow (0xFC 15) is present
      let sections = list_sections(bytes)
      let mut has_grow = false
      let mut gs = 0
      while gs < Array::length(sections) {
        let (sid, off, sz) = Array::get(sections, gs)
        if sid == 10 {
          let raw_bodies = parse_code_bodies(bytes, off, sz)
          let mut bi = 0
          while bi < Array::length(raw_bodies) {
            let body = Array::get(raw_bodies, bi)
            let spans = parse_full_body_spans(body)
            let mut i = 0
            while i < Array::length(spans) {
              let (s_i, _, op_i) = Array::get(spans, i)
              if op_i == 0xFC {
                let (sub, _) = read_uleb128(body, s_i + 1)
                if sub == 15 {
                  has_grow = true
                }
              }
              i = i + 1
            }
            bi = bi + 1
          }
        }
        gs = gs + 1
      }
      if has_grow {
        copy_bytes(bytes, 0, len)
      }
      else {
        let out = Bytes::new()
        let mut hi = 0
        while hi < 8 {
          Bytes::push(out, bytes[hi]); hi = hi + 1
        }
        let mut s = 0
        while s < Array::length(sections) {
          let (sid, off, sz) = Array::get(sections, s)
          if sid == 10 {
            let raw_bodies = parse_code_bodies(bytes, off, sz)
            let new_bodies = Array::slice([
              (Bytes::new())
            ], 0, 0)
            let mut bi = 0
            while bi < Array::length(raw_bodies) {
              Array::push(new_bodies, fold_table_size_body(Array::get(raw_bodies, bi), table_mins))
              bi = bi + 1
            }
            emit_section(out, 10, rebuild_code_section(new_bodies))
          } else {
            let content = copy_bytes(bytes, off, off + sz)
            emit_section(out, sid, content)
          }
          s = s + 1
        }
        out
      }
    }
  }
}

// Drop the table and element sections when no table opcode references any table
// and no table is exported or imported. The functions that were only kept alive
// by element segments then become dead and are removed by the following DCE.
export let drop_unused_tables = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else if count_imported_tables(bytes) > 0 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let sections = list_sections(bytes)
    let mut has_table = false
    let mut table_exported = false
    let mut s0 = 0
    while s0 < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s0)
      if sid == 4 {
        has_table = true
      }
      else if sid == 7 {
        let end_pos = off + sz
        let (cnt, pos0) = read_uleb128(bytes, off)
        let mut pos = pos0
        let mut i = 0
        while (i < cnt) && (pos < end_pos) {
          let (_, np) = read_name(bytes, pos)
          pos = np
          let kind = bytes[pos]
          pos = pos + 1
          let (_, np2) = read_uleb128(bytes, pos)
          pos = np2
          if kind == 1 {
            table_exported = true
          }
          i = i + 1
        }
      }
      s0 = s0 + 1
    }
    if (has_table == false) || table_exported || code_uses_any_table_op(bytes) {
      copy_bytes(bytes, 0, len)
    }
    else {
      let out = Bytes::new()
      let mut hi = 0
      while hi < 8 {
        Bytes::push(out, bytes[hi]); hi = hi + 1
      }
      let mut s = 0
      while s < Array::length(sections) {
        let (sid, off, sz) = Array::get(sections, s)
        if (sid == 4) || (sid == 9) {
          ()
        } else {
          let content = copy_bytes(bytes, off, off + sz)
          emit_section(out, sid, content)
        }
        s = s + 1
      }
      out
    }
  }
}

// Replace `local.set N` with `drop` when local N is never read anywhere in the
// function (no local.get/local.tee references it). Since "never read" is a
// whole-function property it is independent of control flow, so this is always
// safe; the resulting `<pure expr>; drop` is then cleaned by peephole and the
// now-unused local declaration by coalesce_locals.
let eliminate_dead_stores_body = (body: Bytes) -> Bytes {
  let body_len = Bytes::length(body)
  if body_len < 2 {
    copy_bytes(body, 0, body_len)
  }
  else {
    let (local_count, lp) = read_uleb128(body, 0)
    let mut pos = lp
    let mut lc = 0
    while lc < local_count {
      let (_, tp) = read_uleb128(body, pos)
      pos = tp + 1
      lc = lc + 1
    }
    let code_start = pos
    let code_end = body_len - 1
    if code_start >= code_end {
      copy_bytes(body, 0, body_len)
    }
    else {
      let spans = parse_body_spans(body, code_start, code_end)
      let reads = Array::slice([
        (0)
      ], 0, 0)
      let mut ri = 0
      while ri < Array::length(spans) {
        let (s_i, _, op_i) = Array::get(spans, ri)
        if (op_i == 0x20) || (op_i == 0x22) {
          Array::push(reads, span_read_uleb_imm(body, s_i))
        }
        ri = ri + 1
      }
      let out = Bytes::new()
      let mut ci = 0
      while ci < code_start {
        Bytes::push(out, body[ci]); ci = ci + 1
      }
      let mut i = 0
      while i < Array::length(spans) {
        let (s_i, e_i, op_i) = Array::get(spans, i)
        if op_i == 0x21 {
          let idx = span_read_uleb_imm(body, s_i)
          if array_contains_int(reads, idx) {
            copy_span_bytes(out, body, s_i, e_i)
          } else {
            Bytes::push(out, 0x1A)
          }
        } else {
          copy_span_bytes(out, body, s_i, e_i)
        }
        i = i + 1
      }
      Bytes::push(out, 0x0B)
      out
    }
  }
}

export let eliminate_dead_stores = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let sections = list_sections(bytes)
    let out = Bytes::new()
    let mut hi = 0
    while hi < 8 {
      Bytes::push(out, bytes[hi]); hi = hi + 1
    }
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid == 10 {
        let raw_bodies = parse_code_bodies(bytes, off, sz)
        let new_bodies = Array::slice([
          (Bytes::new())
        ], 0, 0)
        let mut bi = 0
        while bi < Array::length(raw_bodies) {
          Array::push(new_bodies, eliminate_dead_stores_body(Array::get(raw_bodies, bi)))
          bi = bi + 1
        }
        emit_section(out, 10, rebuild_code_section(new_bodies))
      } else {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(out, sid, content)
      }
      s = s + 1
    }
    out
  }
}

export let minify = (bytes: Bytes) -> Bytes {
  let len = Bytes::length(bytes)
  if len < 8 {
    copy_bytes(bytes, 0, len)
  }
  else {
    let sections = list_sections(bytes)
    let stripped = Bytes::new()
    let mut i = 0
    while i < 8 {
      Bytes::push(stripped, bytes[i]); i = i + 1
    }
    let mut s = 0
    while s < Array::length(sections) {
      let (sid, off, sz) = Array::get(sections, s)
      if sid != 0 {
        let content = copy_bytes(bytes, off, off + sz)
        emit_section(stripped, sid, content)
      }
      s = s + 1
    }
    let s2 = directize(stripped)
    let s3 = call_forwarding(s2)
    let s3t = fold_table_size(s3)
    let s3d = eliminate_dead_stores(s3t)
    let s4a = optimize_code_section(s3d)
    let s4b = inline_empty_calls(s4a)
    let s4 = drop_unused_tables(s4b)
    let s5_removed = dce_remove(s4)
    let s5 = if binary_size(s5_removed) < binary_size(s4) {
      s5_removed
    } else {
      dce(s4)
    }
    let s6 = coalesce_locals(s5)
    let s7 = remove_unused_types(s6)
    remove_empty_sections(s7)
  }
}

export let optimize = (bytes: Bytes) -> Bytes {
  let step1 = strip_custom_sections(bytes)
  let step2 = optimize_code_section(step1)
  let step3 = dce(step2)
  step3
}

// Run `minify` repeatedly until it stops shrinking the binary (wite's
// `--converge`). Passes feed each other across rounds: `directize` exposes
// dead functions for `dce`, `dce` exposes unused types for `remove_unused_types`,
// and deep constant-fold chains finish past `peephole_body`'s internal cap.
// Monotonic: a round is kept only if it is strictly smaller, so the result is
// never larger than a single `minify`. `max_rounds` bounds the work.
let minify_converge_n = (bytes: Bytes, max_rounds: Int) -> Bytes {
  let mut cur = minify(bytes)
  let mut rounds = 0
  let mut keep_going = true
  while keep_going && (rounds < max_rounds) {
    let next = minify(cur)
    if binary_size(next) < binary_size(cur) {
      cur = next
      rounds = rounds + 1
    } else {
      keep_going = false
    }
  }
  cur
}

export let minify_converge = (bytes: Bytes) -> Bytes {
  minify_converge_n(bytes, 16)
}
