//# Imports

import ./index.vibe {
  strip_custom_sections, count_functions, section_sizes, binary_size,
  optimize_code_section, build_call_graph, find_reachable,
  dce, minify, minify_fast, remove_unused_types, remove_empty_sections,
  coalesce_locals
}

//# Functions

let make_bytes = (values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

// Small module: 1 func const fold
let small_fold = () -> Bytes {
  make_bytes([
    0, 97, 115, 109, 1, 0, 0, 0,
    1, 5, 1, 96, 0, 1, 127,
    3, 2, 1, 0,
    7, 8, 1, 4, 109, 97, 105, 110, 0, 0,
    10, 9, 1, 7, 0, 65, 3, 65, 4, 106, 11
  ])
}

// Medium module: 4 funcs, 1 unreachable, custom section, dead drops
let medium_module = () -> Bytes {
  make_bytes([
    0, 97, 115, 109, 1, 0, 0, 0,
    // custom "x"
    0, 3, 1, 120, 255,
    // type: () -> (i32)
    1, 5, 1, 96, 0, 1, 127,
    // 4 functions
    3, 5, 4, 0, 0, 0, 0,
    // export "main" func 0
    7, 8, 1, 4, 109, 97, 105, 110, 0, 0,
    // code: 4 bodies
    10, 27, 4,
      // func 0: call 1, end
      4, 0, 16, 1, 11,
      // func 1: i32.const 3 + i32.const 4 + i32.add, end (foldable)
      7, 0, 65, 3, 65, 4, 106, 11,
      // func 2: i32.const 99, drop, i32.const 42, end (dead drop)
      7, 0, 65, 99, 26, 65, 42, 11,
      // func 3: i32.const 0, end (unreachable)
      4, 0, 65, 0, 11
  ])
}

//# Misc

// === Small module (35 bytes) ===

bench "wasmopt/small/peephole" {
  let _ = optimize_code_section(small_fold())
}

bench "wasmopt/small/dce" {
  let _ = dce(small_fold())
}

bench "wasmopt/small/minify" {
  let _ = minify(small_fold())
}

bench "wasmopt/small/strip_custom" {
  let _ = strip_custom_sections(small_fold())
}

// === Medium module (~80 bytes, 4 funcs) ===

bench "wasmopt/medium/peephole" {
  let _ = optimize_code_section(medium_module())
}

bench "wasmopt/medium/build_call_graph" {
  let _ = build_call_graph(medium_module())
}

bench "wasmopt/medium/find_reachable" {
  let _ = find_reachable(medium_module())
}

bench "wasmopt/medium/dce" {
  let _ = dce(medium_module())
}

bench "wasmopt/medium/minify" {
  let _ = minify(medium_module())
}

bench "wasmopt/medium/strip_custom" {
  let _ = strip_custom_sections(medium_module())
}

bench "wasmopt/medium/remove_unused_types" {
  let _ = remove_unused_types(medium_module())
}

bench "wasmopt/medium/remove_empty" {
  let _ = remove_empty_sections(medium_module())
}

bench "wasmopt/medium/minify_fast" {
  let _ = minify_fast(medium_module())
}

bench "wasmopt/small/minify_fast" {
  let _ = minify_fast(small_fold())
}

bench "wasmopt/medium/coalesce_locals" {
  let _ = coalesce_locals(medium_module())
}
