    7,
    8,
    1,
    4,
    109,
    97,
    105,
    110,
    0,
    0,
    10,
    11,
    2,
    4,
    0,
    65,
    42,
    11,
    4,
    0,
    65,
    0,
    11
  ])
  let opt = minify(m)
  // Output must have valid WASM magic
  assert(opt[0] == 0)
  assert(opt[1] == 97)
  assert(opt[2] == 115)
  assert(opt[3] == 109)
  assert(opt[4] == 1)
  assert(opt[5] == 0)
  assert(opt[6] == 0)
  assert(opt[7] == 0)
  // Must have at least 1 function
  assert(count_functions(opt) >= 1)
  // Must have export
  assert(count_exports(opt) == 1)
}

