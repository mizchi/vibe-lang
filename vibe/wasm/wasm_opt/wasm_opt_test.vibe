test "wasm-opt: const fold chain" {
  // i32.const 1, i32.const 2, i32.add, i32.const 3, i32.add
  // Round 1: fold (1+2)=3, then 3+3 needs round 2
  let m = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    5,
