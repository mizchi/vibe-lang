test "wasm-opt: minify output valid" {
  let m = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    0,
    5,
    3,
    102,
    111,
    111,
    255,
    1,
    5,
    1,
    96,
    0,
    1,
    127,
    3,
    3,
    2,
    0,
