// WAT (WebAssembly Text Format) to WASM binary compiler
// Takes WAT source string, returns valid WASM binary bytes

//# Functions

// === LEB128 encoding ===

let write_uleb128 = (buf: Bytes, val: Int) -> Unit {
  let mut v = val
  let mut done = false
  while done == false {
    let byte = v & 0x7F
    v = v >> 7
    // unsigned shift: mask off sign bits
    if v < 0 { v = v & 0x1FFFFFFFFFFFFFF }
    if v == 0 {
      Bytes::push(buf, byte)
      done = true
    } else {
      Bytes::push(buf, byte | 0x80)
    }
  }
}

let write_sleb128 = (buf: Bytes, val: Int) -> Unit {
  let mut v = val
  let mut done = false
  while done == false {
    let byte = v & 0x7F
    v = v >> 7
    if ((v == 0) && ((byte & 0x40) == 0)) || ((v == -1) && ((byte & 0x40) != 0)) {
      Bytes::push(buf, byte)
      done = true
    } else {
      Bytes::push(buf, byte | 0x80)
    }
  }
}

// === Token types ===

let tok_lparen = 1
let tok_rparen = 2
let tok_keyword = 3
let tok_ident = 4
let tok_int = 5
let tok_float = 6
let tok_string = 7

// === Tokenizer ===

let is_digit = (c: Int) -> Bool {
  (c >= 48) && (c <= 57)
}

let is_hex_digit = (c: Int) -> Bool {
  ((c >= 48) && (c <= 57)) ||
  ((c >= 97) && (c <= 102)) ||
  ((c >= 65) && (c <= 70))
}

let is_id_char = (c: Int) -> Bool {
  ((c >= 97) && (c <= 122)) ||
  ((c >= 65) && (c <= 90)) ||
  ((c >= 48) && (c <= 57)) ||
  (c == 95) || (c == 46) || (c == 47) || (c == 58) || (c == 45)
}

let tokenize = (src: String) -> Array[(Int, Int, Int)] {
  let len = String::length(src)
  let result = Array::slice([(0, 0, 0)], 0, 0)
  let mut i = 0
  while i < len {
    let c = String::char_code_at(src, i)
    if (c == 32) || (c == 9) || (c == 10) || (c == 13) {
      i = i + 1
    } else {
      if c == 40 {
        if ((i + 1) < len) && (String::char_code_at(src, i + 1) == 59) {
          i = i + 2
          let mut depth = 1
          while (i < len) && (depth > 0) {
            let cc = String::char_code_at(src, i)
            if (cc == 59) && ((i + 1) < len) && (String::char_code_at(src, i + 1) == 41) {
              depth = depth - 1
              i = i + 2
            } else {
              if (cc == 40) && ((i + 1) < len) && (String::char_code_at(src, i + 1) == 59) {
                depth = depth + 1
                i = i + 2
              } else {
                i = i + 1
              }
            }
          }
        } else {
          Array::push(result, (tok_lparen, i, i + 1))
          i = i + 1
        }
      } else {
        if c == 41 {
          Array::push(result, (tok_rparen, i, i + 1))
          i = i + 1
        } else {
          if c == 59 {
            while (i < len) && (String::char_code_at(src, i) != 10) {
              i = i + 1
            }
          } else {
            if c == 34 {
              let start = i
              i = i + 1
              while (i < len) && (String::char_code_at(src, i) != 34) {
                if String::char_code_at(src, i) == 92 { i = i + 2 }
                else { i = i + 1 }
              }
              if i < len { i = i + 1 }
              Array::push(result, (tok_string, start, i))
            } else {
              if c == 36 {
                let start = i
                i = i + 1
                while (i < len) && (is_id_char(String::char_code_at(src, i))) {
                  i = i + 1
                }
                Array::push(result, (tok_ident, start, i))
              } else {
                if is_digit(c) || ((c == 45) && ((i + 1) < len) && (is_digit(String::char_code_at(src, i + 1)))) || ((c == 43) && ((i + 1) < len) && (is_digit(String::char_code_at(src, i + 1)))) {
                  let start = i
                  let mut is_float = false
                  if (c == 45) || (c == 43) { i = i + 1 }
                  if ((i + 1) < len) && (String::char_code_at(src, i) == 48) && ((String::char_code_at(src, i + 1) == 120) || (String::char_code_at(src, i + 1) == 88)) {
                    i = i + 2
                    while (i < len) && (is_hex_digit(String::char_code_at(src, i)) || (String::char_code_at(src, i) == 95)) {
                      i = i + 1
                    }
                    // hex float: check for '.' or 'p'/'P'
                    if (i < len) && (String::char_code_at(src, i) == 46) {
                      is_float = true
                      i = i + 1
                      while (i < len) && (is_hex_digit(String::char_code_at(src, i)) || (String::char_code_at(src, i) == 95)) {
                        i = i + 1
                      }
                    }
                    if (i < len) && ((String::char_code_at(src, i) == 112) || (String::char_code_at(src, i) == 80)) {
                      is_float = true
                      i = i + 1
                      if (i < len) && ((String::char_code_at(src, i) == 43) || (String::char_code_at(src, i) == 45)) { i = i + 1 }
                      while (i < len) && (is_digit(String::char_code_at(src, i))) { i = i + 1 }
                    }
                  } else {
                    while (i < len) && (is_digit(String::char_code_at(src, i)) || (String::char_code_at(src, i) == 95)) {
                      i = i + 1
                    }
                    // decimal float: check for '.' or 'e'/'E'
                    if (i < len) && (String::char_code_at(src, i) == 46) {
                      is_float = true
                      i = i + 1
                      while (i < len) && (is_digit(String::char_code_at(src, i)) || (String::char_code_at(src, i) == 95)) {
                        i = i + 1
                      }
                    }
                    if (i < len) && ((String::char_code_at(src, i) == 101) || (String::char_code_at(src, i) == 69)) {
                      is_float = true
                      i = i + 1
                      if (i < len) && ((String::char_code_at(src, i) == 43) || (String::char_code_at(src, i) == 45)) { i = i + 1 }
                      while (i < len) && (is_digit(String::char_code_at(src, i))) { i = i + 1 }
                    }
                  }
                  if is_float {
                    Array::push(result, (tok_float, start, i))
                  } else {
                    Array::push(result, (tok_int, start, i))
                  }
                } else {
                  let start = i
                  while (i < len) && (is_id_char(String::char_code_at(src, i))) {
                    i = i + 1
                  }
                  if i > start {
                    Array::push(result, (tok_keyword, start, i))
                  } else {
                    i = i + 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  result
}

let tok_text = (src: String, tokens: Array[(Int, Int, Int)], idx: Int) -> String {
  let (_, s, e) = Array::get(tokens, idx)
  String::substring(src, s, e)
}

let tok_type = (tokens: Array[(Int, Int, Int)], idx: Int) -> Int {
  let (ty, _, _) = Array::get(tokens, idx)
  ty
}

// === Parse integer ===

let parse_int = (s: String) -> Int {
  let len = String::length(s)
  if len == 0 { 0 }
  else {
    let mut neg = false
    let mut start = 0
    if String::char_code_at(s, 0) == 45 { neg = true; start = 1 }
    else { if String::char_code_at(s, 0) == 43 { start = 1 } }
    let mut val = 0
    if ((start + 1) < len) && (String::char_code_at(s, start) == 48) && ((String::char_code_at(s, start + 1) == 120) || (String::char_code_at(s, start + 1) == 88)) {
      let mut i = start + 2
      while i < len {
        let c = String::char_code_at(s, i)
        if (c >= 48) && (c <= 57) { val = val * 16 + (c - 48) }
        else { if (c >= 97) && (c <= 102) { val = val * 16 + (c - 87) }
        else { if (c >= 65) && (c <= 70) { val = val * 16 + (c - 55) } } }
        i = i + 1
      }
    } else {
      let mut i = start
      while i < len {
        let c = String::char_code_at(s, i)
        if (c >= 48) && (c <= 57) { val = val * 10 + (c - 48) }
        i = i + 1
      }
    }
    if neg { 0 - val } else { val }
  }
}

// === Float encoding helpers ===

// Write f32 as 4 LE bytes
let write_f32_le = (buf: Bytes, bits: Int) -> Unit {
  Bytes::push(buf, bits & 0xFF)
  Bytes::push(buf, (bits >> 8) & 0xFF)
  Bytes::push(buf, (bits >> 16) & 0xFF)
  Bytes::push(buf, (bits >> 24) & 0xFF)
}

// Write f64 as 8 LE bytes
let write_f64_le = (buf: Bytes, bits: Int) -> Unit {
  Bytes::push(buf, bits & 0xFF)
  Bytes::push(buf, (bits >> 8) & 0xFF)
  Bytes::push(buf, (bits >> 16) & 0xFF)
  Bytes::push(buf, (bits >> 24) & 0xFF)
  Bytes::push(buf, (bits >> 32) & 0xFF)
  Bytes::push(buf, (bits >> 40) & 0xFF)
  Bytes::push(buf, (bits >> 48) & 0xFF)
  Bytes::push(buf, (bits >> 56) & 0xFF)
}

// Build 64-bit constant from two 32-bit halves to avoid IntLiteralOverflow
let make_i64 = (hi: Int, lo: Int) -> Int {
  (hi << 32) | lo
}

// Parse f64 literal to IEEE 754 bits using Double::parse
let parse_f64_bits = (s: String) -> Int {
  // NaN/Inf constants built from halves to stay within vibe Int literal limit (2^61-1)
  if s == "nan" { make_i64(0x7FF80000, 0) }
  else if s == "-nan" { make_i64(0xFFF80000, 0) }
  else if s == "inf" { make_i64(0x7FF00000, 0) }
  else if s == "-inf" { make_i64(0xFFF00000, 0) }
  else {
    // Strip underscores
    let mut clean = ""
    let len = String::length(s)
    let mut i = 0
    while i < len {
      let c = String::char_code_at(s, i)
      if c != 95 { clean = String::concat(clean, String::from_char_code(c)) }
      i = i + 1
    }
    let d = Double::parse(clean)
    Double::to_i64_bits(d)
  }
}

// Convert f64 IEEE 754 bits to f32 IEEE 754 bits
let f64_bits_to_f32_bits = (bits: Int) -> Int {
  let sign = (bits >> 63) & 1
  let exp64 = (bits >> 52) & 0x7FF
  let frac64 = bits & 0xFFFFFFFFFFFFF
  if exp64 == 0x7FF {
    // Inf or NaN
    if frac64 == 0 {
      // Infinity
      (sign << 31) | 0x7F800000
    } else {
      // NaN - preserve canonical NaN
      (sign << 31) | 0x7FC00000
    }
  } else if exp64 == 0 {
    // Zero or denormal -> f32 zero (denormals too small)
    sign << 31
  } else {
    // Normal number
    let exp32 = exp64 - 1023 + 127
    let frac32 = (frac64 >> 29) & 0x7FFFFF
    if exp32 >= 255 {
      // Overflow -> infinity
      (sign << 31) | 0x7F800000
    } else if exp32 <= 0 {
      // Underflow -> zero
      sign << 31
    } else {
      (sign << 31) | (exp32 << 23) | frac32
    }
  }
}

// Parse f32 literal to IEEE 754 bits (parse as f64, then convert)
let parse_f32_bits = (s: String) -> Int {
  if s == "nan" { 0x7FC00000 }
  else if s == "-nan" { 0xFFC00000 }
  else if s == "inf" { 0x7F800000 }
  else if s == "-inf" { 0xFF800000 }
  else {
    f64_bits_to_f32_bits(parse_f64_bits(s))
  }
}

// === Decode WAT string literal ===

let hex_val = (c: Int) -> Int {
  if (c >= 48) && (c <= 57) { c - 48 }
  else { if (c >= 97) && (c <= 102) { c - 87 }
  else { if (c >= 65) && (c <= 70) { c - 55 }
  else { 0 } } }
}

let decode_string = (s: String) -> String {
  let len = String::length(s)
  if len < 2 { "" }
  else {
    let mut result = ""
    let mut i = 1
    let end_pos = len - 1
    while i < end_pos {
      let c = String::char_code_at(s, i)
      if c == 92 {
        i = i + 1
        if i < end_pos {
          let c2 = String::char_code_at(s, i)
          if c2 == 110 { result = String::concat(result, String::from_char_code(10)); i = i + 1 }
          else { if c2 == 116 { result = String::concat(result, String::from_char_code(9)); i = i + 1 }
          else { if c2 == 92 { result = String::concat(result, "\\"); i = i + 1 }
          else { if c2 == 34 { result = String::concat(result, "\""); i = i + 1 }
          else {
            if is_hex_digit(c2) && ((i + 1) < end_pos) && (is_hex_digit(String::char_code_at(s, i + 1))) {
              let h = hex_val(c2) * 16 + hex_val(String::char_code_at(s, i + 1))
              result = String::concat(result, String::from_char_code(h))
              i = i + 2
            } else {
              result = String::concat(result, String::from_char_code(c2))
              i = i + 1
            }
          } } } }
        }
      } else {
        result = String::concat(result, String::from_char_code(c))
        i = i + 1
      }
    }
    result
  }
}

// Decode string to raw bytes (for data section)
let decode_string_bytes = (s: String) -> Bytes {
  let len = String::length(s)
  let buf = Bytes::new()
  if len < 2 { buf }
  else {
    let mut i = 1
    let end_pos = len - 1
    while i < end_pos {
      let c = String::char_code_at(s, i)
      if c == 92 {
        i = i + 1
        if i < end_pos {
          let c2 = String::char_code_at(s, i)
          if c2 == 110 { Bytes::push(buf, 10); i = i + 1 }
          else { if c2 == 116 { Bytes::push(buf, 9); i = i + 1 }
          else { if c2 == 92 { Bytes::push(buf, 92); i = i + 1 }
          else { if c2 == 34 { Bytes::push(buf, 34); i = i + 1 }
          else {
            if is_hex_digit(c2) && ((i + 1) < end_pos) && (is_hex_digit(String::char_code_at(s, i + 1))) {
              let h = hex_val(c2) * 16 + hex_val(String::char_code_at(s, i + 1))
              Bytes::push(buf, h)
              i = i + 2
            } else {
              Bytes::push(buf, c2)
              i = i + 1
            }
          } } } }
        }
      } else {
        Bytes::push(buf, c)
        i = i + 1
      }
    }
    buf
  }
}

// === Valtype mapping ===

let valtype_code = (name: String) -> Int {
  if name == "i32" { 0x7F }
  else if name == "i64" { 0x7E }
  else if name == "f32" { 0x7D }
  else if name == "f64" { 0x7C }
  else { 0x7F }
}

// === String helpers ===

let str_eq = (a: String, b: String) -> Bool {
  a == b
}

// === Name → index maps (parallel arrays) ===

let map_names_new = () -> Array[String] {
  Array::slice([""], 0, 0)
}

let map_indices_new = () -> Array[Int] {
  Array::slice([0], 0, 0)
}

let map_set = (names: Array[String], indices: Array[Int], name: String, idx: Int) -> Unit {
  Array::push(names, name)
  Array::push(indices, idx)
}

let map_get = (names: Array[String], indices: Array[Int], name: String) -> Int {
  let len = Array::length(names)
  let mut i = 0
  let mut found = -1
  while i < len {
    if Array::get(names, i) == name { found = Array::get(indices, i) }
    i = i + 1
  }
  found
}

// === Type signature (parallel arrays for params/results) ===

// types_params: Array[Array[Int]] - each entry is param valtypes
// types_results: Array[Array[Int]] - each entry is result valtypes

let empty_int_array = () -> Array[Int] {
  Array::slice([0], 0, 0)
}

// Find or add type, returns index
let find_or_add_type = (
  types_params: Array[Array[Int]],
  types_results: Array[Array[Int]],
  params: Array[Int],
  results: Array[Int]
) -> Int {
  let cnt = Array::length(types_params)
  let mut i = 0
  let mut found = -1
  while (i < cnt) && (found == -1) {
    let tp = Array::get(types_params, i)
    let tr = Array::get(types_results, i)
    if (Array::length(tp) == Array::length(params)) && (Array::length(tr) == Array::length(results)) {
      let mut match_ok = true
      let mut j = 0
      while j < Array::length(tp) {
        if Array::get(tp, j) != Array::get(params, j) { match_ok = false }
        j = j + 1
      }
      j = 0
      while j < Array::length(tr) {
        if Array::get(tr, j) != Array::get(results, j) { match_ok = false }
        j = j + 1
      }
      if match_ok { found = i }
    }
    i = i + 1
  }
  if found >= 0 { found }
  else {
    Array::push(types_params, params)
    Array::push(types_results, results)
    cnt
  }
}

// === Section emitters ===

let emit_section = (out: Bytes, section_id: Int, payload: Bytes) -> Unit {
  let plen = Bytes::length(payload)
  if plen > 0 {
    Bytes::push(out, section_id)
    write_uleb128(out, plen)
    let mut i = 0
    while i < plen {
      Bytes::push(out, payload[i])
      i = i + 1
    }
  }
}

let append_bytes = (dst: Bytes, src: Bytes) -> Unit {
  let len = Bytes::length(src)
  let mut i = 0
  while i < len {
    Bytes::push(dst, src[i])
    i = i + 1
  }
}

// Write a name (length-prefixed UTF-8 string)
let write_name = (buf: Bytes, s: String) -> Unit {
  let len = String::length(s)
  write_uleb128(buf, len)
  let mut i = 0
  while i < len {
    Bytes::push(buf, String::char_code_at(s, i))
    i = i + 1
  }
}

// === Instruction encoding ===

let emit_instruction = (
  buf: Bytes, src: String, tokens: Array[(Int, Int, Int)],
  pos: Int, end_pos: Int,
  func_names: Array[String], func_indices: Array[Int],
  local_names: Array[String], local_indices: Array[Int],
  global_names: Array[String], global_indices: Array[Int],
  label_names: Array[String], label_indices: Array[Int],
  label_depth: Int
) -> Int {
  if pos >= end_pos { pos }
  else {
    let ty = tok_type(tokens, pos)
    if ty == tok_lparen {
      // skip nested s-expr forms -- handle folded instructions
      pos + 1
    } else if ty == tok_rparen {
      pos + 1
    } else if ty != tok_keyword {
      pos + 1
    } else {
      let kw = tok_text(src, tokens, pos)
      if kw == "unreachable" { Bytes::push(buf, 0x00); pos + 1 }
      else if kw == "nop" { Bytes::push(buf, 0x01); pos + 1 }
      else if kw == "block" {
        Bytes::push(buf, 0x02)
        let mut next = pos + 1
        // Check for label
        if (next < end_pos) && (tok_type(tokens, next) == tok_ident) {
          let lbl = tok_text(src, tokens, next)
          map_set(label_names, label_indices, lbl, label_depth)
          next = next + 1
        }
        // Check for (result type)
        if (next < end_pos) && (tok_type(tokens, next) == tok_lparen) && ((next + 1) < end_pos) && (tok_text(src, tokens, next + 1) == "result") {
          let rpos = next + 2
          if (rpos < end_pos) && (tok_type(tokens, rpos) == tok_keyword) {
            Bytes::push(buf, valtype_code(tok_text(src, tokens, rpos)))
            // skip past (result type)
            let mut skip = rpos + 1
            if (skip < end_pos) && (tok_type(tokens, skip) == tok_rparen) { skip = skip + 1 }
            skip
          } else {
            Bytes::push(buf, 0x40)
            next
          }
        } else {
          Bytes::push(buf, 0x40)
          next
        }
      }
      else if kw == "loop" {
        Bytes::push(buf, 0x03)
        let mut next = pos + 1
        if (next < end_pos) && (tok_type(tokens, next) == tok_ident) {
          let lbl = tok_text(src, tokens, next)
          map_set(label_names, label_indices, lbl, label_depth)
          next = next + 1
        }
        // Check for (result type)
        if (next < end_pos) && (tok_type(tokens, next) == tok_lparen) && ((next + 1) < end_pos) && (tok_text(src, tokens, next + 1) == "result") {
          let rpos = next + 2
          if (rpos < end_pos) && (tok_type(tokens, rpos) == tok_keyword) {
            Bytes::push(buf, valtype_code(tok_text(src, tokens, rpos)))
            let mut skip = rpos + 1
            if (skip < end_pos) && (tok_type(tokens, skip) == tok_rparen) { skip = skip + 1 }
            skip
          } else {
            Bytes::push(buf, 0x40)
            next
          }
        } else {
          Bytes::push(buf, 0x40)
          next
        }
      }
      else if kw == "if" {
        Bytes::push(buf, 0x04)
        let mut next = pos + 1
        // Check for (result type)
        if (next < end_pos) && (tok_type(tokens, next) == tok_lparen) && ((next + 1) < end_pos) && (tok_text(src, tokens, next + 1) == "result") {
          let rpos = next + 2
          if (rpos < end_pos) && (tok_type(tokens, rpos) == tok_keyword) {
            Bytes::push(buf, valtype_code(tok_text(src, tokens, rpos)))
            let mut skip = rpos + 1
            if (skip < end_pos) && (tok_type(tokens, skip) == tok_rparen) { skip = skip + 1 }
            skip
          } else {
            Bytes::push(buf, 0x40)
            next
          }
        } else {
          Bytes::push(buf, 0x40)
          next
        }
      }
      else if kw == "else" { Bytes::push(buf, 0x05); pos + 1 }
      else if kw == "end" { Bytes::push(buf, 0x0B); pos + 1 }
      else if kw == "then" { pos + 1 }
      else if kw == "br" {
        Bytes::push(buf, 0x0C)
        let next = pos + 1
        if next < end_pos {
          let arg = tok_text(src, tokens, next)
          if tok_type(tokens, next) == tok_ident {
            let idx = map_get(label_names, label_indices, arg)
            let depth = if idx >= 0 { label_depth - idx - 1 } else { 0 }
            write_uleb128(buf, depth)
          } else {
            write_uleb128(buf, parse_int(arg))
          }
          next + 1
        } else { next }
      }
      else if kw == "br_if" {
        Bytes::push(buf, 0x0D)
        let next = pos + 1
        if next < end_pos {
          let arg = tok_text(src, tokens, next)
          if tok_type(tokens, next) == tok_ident {
            let idx = map_get(label_names, label_indices, arg)
            let depth = if idx >= 0 { label_depth - idx - 1 } else { 0 }
            write_uleb128(buf, depth)
          } else {
            write_uleb128(buf, parse_int(arg))
          }
          next + 1
        } else { next }
      }
      else if kw == "return" { Bytes::push(buf, 0x0F); pos + 1 }
      else if kw == "call" {
        Bytes::push(buf, 0x10)
        let next = pos + 1
        if next < end_pos {
          let arg = tok_text(src, tokens, next)
          if tok_type(tokens, next) == tok_ident {
            let idx = map_get(func_names, func_indices, arg)
            write_uleb128(buf, if idx >= 0 { idx } else { 0 })
