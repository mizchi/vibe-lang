// WebAssembly spec test: i32 operations
// Ported from WebAssembly/spec/test/core/i32.wast

//# Imports

import ./wasm_runtime/index.vibe { exec_module_with_args, exec_module }
import ./wat_encoder/index.vibe { compile }

//# Functions

let i32_module = () -> Bytes {
  compile("(module
    (func (export \"add\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.add)
    (func (export \"sub\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.sub)
    (func (export \"mul\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.mul)
    (func (export \"div_s\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.div_s)
    (func (export \"div_u\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.div_u)
    (func (export \"rem_s\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.rem_s)
    (func (export \"rem_u\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.rem_u)
    (func (export \"and\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.and)
    (func (export \"or\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.or)
    (func (export \"xor\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.xor)
    (func (export \"shl\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.shl)
    (func (export \"shr_s\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.shr_s)
    (func (export \"shr_u\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.shr_u)
    (func (export \"eq\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.eq)
    (func (export \"ne\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.ne)
    (func (export \"lt_s\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.lt_s)
    (func (export \"le_s\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.le_s)
    (func (export \"gt_s\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.gt_s)
    (func (export \"ge_s\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.ge_s)
    (func (export \"eqz\") (param i32) (result i32) local.get 0 i32.eqz)
    (func (export \"clz\") (param i32) (result i32) local.get 0 i32.clz)
    (func (export \"ctz\") (param i32) (result i32) local.get 0 i32.ctz)
    (func (export \"popcnt\") (param i32) (result i32) local.get 0 i32.popcnt)
  )")
}

let call2 = (wasm: Bytes, name: String, a: Int, b: Int) -> Int {
  let args = Array::slice([0], 0, 0)
  Array::push(args, a)
  Array::push(args, b)
  let (ec, result) = exec_module_with_args(wasm, name, args)
  if ec != 0 { -99999 } else { result }
}

let call1 = (wasm: Bytes, name: String, a: Int) -> Int {
  let args = Array::slice([0], 0, 0)
  Array::push(args, a)
  let (ec, result) = exec_module_with_args(wasm, name, args)
  if ec != 0 { -99999 } else { result }
}

//# Misc

// === i32.add (from spec) ===

test "spec i32: add(1,1)=2" {
  let m = i32_module()
  assert(call2(m, "add", 1, 1) == 2)
}

test "spec i32: add(1,0)=1" {
  assert(call2(i32_module(), "add", 1, 0) == 1)
}

test "spec i32: add(-1,-1)=-2" {
  assert(call2(i32_module(), "add", -1, -1) == -2)
}

test "spec i32: add(-1,1)=0" {
  assert(call2(i32_module(), "add", -1, 1) == 0)
}

// === i32.sub (from spec) ===

test "spec i32: sub(1,1)=0" {
  assert(call2(i32_module(), "sub", 1, 1) == 0)
}

test "spec i32: sub(1,0)=1" {
  assert(call2(i32_module(), "sub", 1, 0) == 1)
}

test "spec i32: sub(-1,-1)=0" {
  assert(call2(i32_module(), "sub", -1, -1) == 0)
}

// === i32.mul (from spec) ===

test "spec i32: mul(1,1)=1" {
  assert(call2(i32_module(), "mul", 1, 1) == 1)
}

test "spec i32: mul(1,0)=0" {
  assert(call2(i32_module(), "mul", 1, 0) == 0)
}

test "spec i32: mul(-1,-1)=1" {
  assert(call2(i32_module(), "mul", -1, -1) == 1)
}

// === i32.div_s (from spec) ===

test "spec i32: div_s(1,1)=1" {
  assert(call2(i32_module(), "div_s", 1, 1) == 1)
}

test "spec i32: div_s(0,1)=0" {
  assert(call2(i32_module(), "div_s", 0, 1) == 0)
}

test "spec i32: div_s(-1,-1)=1" {
  assert(call2(i32_module(), "div_s", -1, -1) == 1)
}

test "spec i32: div_s(7,2)=3" {
  assert(call2(i32_module(), "div_s", 7, 2) == 3)
}

test "spec i32: div_s(-7,2)=-3" {
  assert(call2(i32_module(), "div_s", -7, 2) == -3)
}

// === i32.rem_s (from spec) ===

test "spec i32: rem_s(7,2)=1" {
  assert(call2(i32_module(), "rem_s", 7, 2) == 1)
}

test "spec i32: rem_s(11,5)=1" {
  assert(call2(i32_module(), "rem_s", 11, 5) == 1)
}

// === i32.and/or/xor (from spec) ===

test "spec i32: and(1,0)=0" {
  assert(call2(i32_module(), "and", 1, 0) == 0)
}

test "spec i32: and(0xF,0xFF)=0xF" {
  assert(call2(i32_module(), "and", 0xF, 0xFF) == 0xF)
}

test "spec i32: or(1,2)=3" {
  assert(call2(i32_module(), "or", 1, 2) == 3)
}

test "spec i32: xor(1,0)=1" {
  assert(call2(i32_module(), "xor", 1, 0) == 1)
}

test "spec i32: xor(1,1)=0" {
  assert(call2(i32_module(), "xor", 1, 1) == 0)
}

// === i32.shl/shr_s (from spec) ===

test "spec i32: shl(1,1)=2" {
  assert(call2(i32_module(), "shl", 1, 1) == 2)
}

test "spec i32: shl(1,31)=0x80000000" {
  let r = call2(i32_module(), "shl", 1, 31)
  assert((r & 0xFFFFFFFF) == 0x80000000)
}

test "spec i32: shr_s(-1,1)=-1" {
  assert(call2(i32_module(), "shr_s", -1, 1) == -1)
}

// === i32.eq/ne/lt_s/gt_s/le_s/ge_s (from spec) ===

test "spec i32: eq(0,0)=1" {
  assert(call2(i32_module(), "eq", 0, 0) == 1)
}

test "spec i32: eq(1,0)=0" {
  assert(call2(i32_module(), "eq", 1, 0) == 0)
}

test "spec i32: ne(0,0)=0" {
  assert(call2(i32_module(), "ne", 0, 0) == 0)
}

test "spec i32: ne(1,0)=1" {
  assert(call2(i32_module(), "ne", 1, 0) == 1)
}

test "spec i32: lt_s(0,0)=0" {
  assert(call2(i32_module(), "lt_s", 0, 0) == 0)
}

test "spec i32: lt_s(-1,1)=1" {
  assert(call2(i32_module(), "lt_s", -1, 1) == 1)
}

test "spec i32: gt_s(0,0)=0" {
  assert(call2(i32_module(), "gt_s", 0, 0) == 0)
}

test "spec i32: gt_s(1,-1)=1" {
  assert(call2(i32_module(), "gt_s", 1, -1) == 1)
}

test "spec i32: le_s(0,0)=1" {
  assert(call2(i32_module(), "le_s", 0, 0) == 1)
}

test "spec i32: ge_s(0,0)=1" {
  assert(call2(i32_module(), "ge_s", 0, 0) == 1)
}

// === i32.eqz (from spec) ===

test "spec i32: eqz(0)=1" {
  assert(call1(i32_module(), "eqz", 0) == 1)
}

test "spec i32: eqz(1)=0" {
  assert(call1(i32_module(), "eqz", 1) == 0)
}

// === i32.clz/ctz/popcnt (from spec) ===

test "spec i32: clz(0)=32" {
  assert(call1(i32_module(), "clz", 0) == 32)
}

test "spec i32: clz(1)=31" {
  assert(call1(i32_module(), "clz", 1) == 31)
}

test "spec i32: ctz(0)=32" {
  assert(call1(i32_module(), "ctz", 0) == 32)
}

test "spec i32: ctz(1)=0" {
  assert(call1(i32_module(), "ctz", 1) == 0)
}

test "spec i32: popcnt(0)=0" {
  assert(call1(i32_module(), "popcnt", 0) == 0)
}

test "spec i32: popcnt(7)=3" {
  assert(call1(i32_module(), "popcnt", 7) == 3)
}
