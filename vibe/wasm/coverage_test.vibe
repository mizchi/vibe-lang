// Coverage entry for vibe/wasm — parser-only (no Bytes allocation)
// Run: VIBE_WASM_SOURCE_COVERAGE_RUN_TESTS=1 VIBE_WASM_SOURCE_COVERAGE_ALLOW_TRAP=1 scripts/coverage_wasm_source.sh vibe/wasm/coverage_test.vibe

//# Imports

import ./wasm_parser/index.vibe {
  validate_magic, read_version, section_name, valtype_name,
  read_init_expr, count_locals
}
import ./wasm_runtime/index.vibe { opcode_name }

//# Misc

// Pure function tests — no heap allocation needed

test "cov: validate_magic true" {
  // Inline header bytes (no make_bytes, no Bytes::new)
  assert(section_name(0) == "custom")
  assert(section_name(1) == "type")
  assert(section_name(2) == "import")
  assert(section_name(3) == "function")
  assert(section_name(4) == "table")
  assert(section_name(5) == "memory")
  assert(section_name(6) == "global")
  assert(section_name(7) == "export")
  assert(section_name(8) == "start")
  assert(section_name(9) == "element")
  assert(section_name(10) == "code")
  assert(section_name(11) == "data")
  assert(section_name(12) == "datacount")
  assert(section_name(99) == "unknown")
}

test "cov: valtype_name all" {
  assert(valtype_name(127) == "i32")
  assert(valtype_name(126) == "i64")
  assert(valtype_name(125) == "f32")
  assert(valtype_name(124) == "f64")
  assert(valtype_name(123) == "v128")
  assert(valtype_name(112) == "funcref")
  assert(valtype_name(111) == "externref")
  assert(valtype_name(110) == "ref_null_func")
  assert(valtype_name(109) == "ref_null_extern")
  assert(valtype_name(99) == "ref")
  assert(valtype_name(100) == "ref_null")
  assert(valtype_name(0) == "unknown")
}

test "cov: opcode_name coverage" {
  assert(opcode_name(0x00) == "unreachable")
  assert(opcode_name(0x01) == "nop")
  assert(opcode_name(0x02) == "block")
  assert(opcode_name(0x03) == "loop")
  assert(opcode_name(0x04) == "if")
  assert(opcode_name(0x05) == "else")
  assert(opcode_name(0x0B) == "end")
  assert(opcode_name(0x0C) == "br")
  assert(opcode_name(0x0D) == "br_if")
  assert(opcode_name(0x0E) == "br_table")
  assert(opcode_name(0x0F) == "return")
  assert(opcode_name(0x10) == "call")
  assert(opcode_name(0x11) == "call_indirect")
  assert(opcode_name(0x1A) == "drop")
  assert(opcode_name(0x1B) == "select")
  assert(opcode_name(0x20) == "local.get")
  assert(opcode_name(0x21) == "local.set")
  assert(opcode_name(0x22) == "local.tee")
  assert(opcode_name(0x23) == "global.get")
  assert(opcode_name(0x24) == "global.set")
  assert(opcode_name(0x41) == "i32.const")
  assert(opcode_name(0x42) == "i64.const")
  assert(opcode_name(0x6A) == "i32.add")
  assert(opcode_name(0x6B) == "i32.sub")
  assert(opcode_name(0x6C) == "i32.mul")
  assert(opcode_name(0x7C) == "i64.add")
  assert(opcode_name(0xA7) == "i32.wrap_i64")
  assert(opcode_name(0xAC) == "i64.extend_i32_s")
  assert(opcode_name(0xFF) == "unknown")
}

test "cov: count_locals empty" {
  let locals = Array::slice([(0, 0)], 0, 0)
  assert(count_locals(locals) == 0)
}

test "cov: count_locals with entries" {
  let locals = Array::slice([(0, 0)], 0, 0)
  Array::push(locals, (3, 127))
  Array::push(locals, (2, 126))
  assert(count_locals(locals) == 5)
}
