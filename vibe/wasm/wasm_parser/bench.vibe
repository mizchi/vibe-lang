//# Imports

import ./index.vibe {
  find_section, list_sections, module_exports, module_types, parse_code_entries, parse_exports, parse_functions, parse_types, validate_magic
}

//# Functions

let make_bytes = (values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

let small_module = () -> Bytes {
  make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    5,
    1,
    96,
    0,
    1,
    127,
    3,
    2,
    1,
    0,
    7,
    8,
    1,
    4,
    109,
    97,
    105,
    110,
    0,
    0,
    10,
    6,
    1,
    4,
    0,
    65,
    42,
    11
  ])
}

//# Misc

bench "wasmparser/validate_magic" {
  let _ = validate_magic(small_module())
}

bench "wasmparser/list_sections" {
  let _ = list_sections(small_module())
}

bench "wasmparser/find_section" {
  let _ = find_section(small_module(), 7)
}

bench "wasmparser/parse_types" {
  let m = small_module()
  let (off, sz) = find_section(m, 1)
  let _ = parse_types(m, off, sz)
}

bench "wasmparser/parse_exports" {
  let m = small_module()
  let (off, sz) = find_section(m, 7)
  let _ = parse_exports(m, off, sz)
}

bench "wasmparser/module_types" {
  let _ = module_types(small_module())
}

bench "wasmparser/module_exports" {
  let _ = module_exports(small_module())
}
