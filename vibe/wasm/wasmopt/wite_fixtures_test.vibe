}

// --- rume_gain_fixture.wasm (65 bytes): remove unused module elements ---

test "wite: rume_gain_fixture.wasm valid" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/rume_gain_fixture.wasm")
  assert(binary_size(bytes) == 65)
  assert(bytes[0] == 0)
  assert(bytes[4] == 1)
}

test "wite: rume_gain_fixture.wasm minify" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/rume_gain_fixture.wasm")
  let opt = minify(bytes)
  // wite reduces to ~33 bytes (49% reduction)
  assert(binary_size(opt) <= binary_size(bytes))
  assert(opt[0] == 0)
}

test "wite: rume_gain_fixture.wasm has functions" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/rume_gain_fixture.wasm")
  assert(count_functions(bytes) > 0)
}

// --- zlib.wasm (171100 bytes): real-world optimization ---
// (Detailed tests in minify_zlib_test.vibe)

test "wite: zlib.wasm minify_fast matches strip_custom" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/zlib.wasm")
  let fast = minify_fast(bytes)
  let stripped = strip_custom_sections(bytes)
  // minify_fast should produce same result as strip_custom (+ remove empty)
  assert(binary_size(fast) <= binary_size(stripped))
}

// --- Cross-fixture: determinism check ---

test "wite: minify is deterministic" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/complexBinaryNames.wasm")
  let opt1 = minify_fast(bytes)
  let opt2 = minify_fast(bytes)
  assert(binary_size(opt1) == binary_size(opt2))
}

// --- Cross-fixture: all fixtures produce valid WASM ---

test "wite: all fixtures valid magic" {
  let fixtures = [
    "vibe/wasm/wasmopt/__fixtures/empty.wasm",
    "vibe/wasm/wasmopt/__fixtures/br_to_exit.wasm",
    "vibe/wasm/wasmopt/__fixtures/elided-br.wasm",
    "vibe/wasm/wasmopt/__fixtures/complexBinaryNames.wasm",
    "vibe/wasm/wasmopt/__fixtures/directize_gain_fixture.wasm",
    "vibe/wasm/wasmopt/__fixtures/rume_gain_fixture.wasm"
  ]
  let mut i = 0
  while i < Array::length(fixtures) {
    let bytes = Fs::read_bytes(Array::get(fixtures, i))
    assert(bytes[0] == 0)
    assert(bytes[1] == 97)
    assert(bytes[2] == 115)
    assert(bytes[3] == 109)
    assert(bytes[4] == 1)
    i = i + 1
  }
}

test "wite: all fixtures minify_fast valid output" {
  let fixtures = [
    "vibe/wasm/wasmopt/__fixtures/empty.wasm",
    "vibe/wasm/wasmopt/__fixtures/br_to_exit.wasm",
    "vibe/wasm/wasmopt/__fixtures/elided-br.wasm",
    "vibe/wasm/wasmopt/__fixtures/complexBinaryNames.wasm",
    "vibe/wasm/wasmopt/__fixtures/directize_gain_fixture.wasm",
    "vibe/wasm/wasmopt/__fixtures/rume_gain_fixture.wasm"
  ]
  let mut i = 0
  while i < Array::length(fixtures) {
    let bytes = Fs::read_bytes(Array::get(fixtures, i))
    let opt = minify_fast(bytes)
    // Output must be valid WASM
    assert(opt[0] == 0)
    assert(opt[4] == 1)
    // Must not increase size
    assert(binary_size(opt) <= binary_size(bytes))
    i = i + 1
  }
}

// --- Step-by-step on each fixture ---

test "wite: strip then dce on complexBinaryNames" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/complexBinaryNames.wasm")
  let s1 = strip_custom_sections(bytes)
  let s2 = dce(s1)
  assert(binary_size(s2) <= binary_size(s1))
  assert(s2[0] == 0)
}

test "wite: strip then dce on rume fixture" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/rume_gain_fixture.wasm")
  let s1 = strip_custom_sections(bytes)
  let s2 = dce(s1)
  assert(binary_size(s2) <= binary_size(s1))
  assert(s2[0] == 0)
}

test "wite: strip then types on directize fixture" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/directize_gain_fixture.wasm")
  let s1 = strip_custom_sections(bytes)
  let s2 = remove_unused_types(s1)
  assert(binary_size(s2) <= binary_size(s1))
  assert(s2[0] == 0)
}
