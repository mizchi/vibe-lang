test "wite: directize_gain_fixture.wasm valid" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/directize_gain_fixture.wasm")
  assert(binary_size(bytes) == 56)
  assert(bytes[0] == 0)
  assert(bytes[4] == 1)
}

test "wite: directize_gain_fixture.wasm minify" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/directize_gain_fixture.wasm")
  let opt = minify(bytes)
  // wite reduces to ~35 bytes (37.5% reduction)
  assert(binary_size(opt) <= binary_size(bytes))
