//# Imports

import ./index.vibe {
  minify, minify_fast, binary_size, count_functions, count_exports, count_types,
  strip_custom_sections, optimize_code_section, dce,
  coalesce_locals, remove_unused_types, remove_empty_sections
}

//# Misc

// ============================================================
// Tests ported from mizchi/wite optimization test suite
// Fixtures from bench/corpus/core/binaryen/
// ============================================================

// --- empty.wasm (8 bytes): minimal valid module ---

test "wite: empty.wasm no change" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/empty.wasm")
  assert(binary_size(bytes) == 8)
  let opt = minify_fast(bytes)
  // Empty module: nothing to optimize
  assert(binary_size(opt) == 8)
}

test "wite: empty.wasm valid" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/empty.wasm")
  assert(bytes[0] == 0)
  assert(bytes[1] == 97)
  assert(bytes[4] == 1)
}

// --- br_to_exit.wasm (26 bytes): dead branch elimination ---

test "wite: br_to_exit.wasm reduces" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/br_to_exit.wasm")
  assert(binary_size(bytes) == 26)
  let opt = minify_fast(bytes)
  // wite reduces to 8 bytes (69% reduction)
  assert(binary_size(opt) <= 26)
  assert(opt[0] == 0)
  assert(opt[4] == 1)
}

test "wite: br_to_exit.wasm minify" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/br_to_exit.wasm")
  let opt = minify(bytes)
  assert(binary_size(opt) <= binary_size(bytes))
  assert(opt[0] == 0)
}

// --- elided-br.wasm (33 bytes): branch removal ---

test "wite: elided-br.wasm reduces" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/elided-br.wasm")
  assert(binary_size(bytes) == 33)
  let opt = minify_fast(bytes)
  assert(binary_size(opt) <= 33)
  assert(opt[0] == 0)
}

test "wite: elided-br.wasm minify" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/elided-br.wasm")
  let opt = minify(bytes)
  assert(binary_size(opt) <= binary_size(bytes))
  assert(opt[0] == 0)
}

// --- complexBinaryNames.wasm (73 bytes): custom section stripping ---

test "wite: complexBinaryNames.wasm strip custom" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/complexBinaryNames.wasm")
  assert(binary_size(bytes) == 73)
  let stripped = strip_custom_sections(bytes)
  // Has custom sections that get stripped
  assert(binary_size(stripped) < 73)
  assert(stripped[0] == 0)
}

test "wite: complexBinaryNames.wasm minify_fast" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/complexBinaryNames.wasm")
  let opt = minify_fast(bytes)
  // wite reduces to ~41 bytes (44% reduction)
  assert(binary_size(opt) < 73)
  assert(opt[0] == 0)
}

test "wite: complexBinaryNames.wasm minify" {
  let bytes = Fs::read_bytes("vibe/wasm/wasmopt/__fixtures/complexBinaryNames.wasm")
  let opt = minify(bytes)
  assert(binary_size(opt) < 73)
  assert(opt[0] == 0)
}

