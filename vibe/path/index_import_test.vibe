//# Imports

import .{
  type PathRef, type DynamicPath, dynamic, resolve, from_literal
}

//# Misc

test "path index exports facade symbols" {
  let path = from_literal("./vibe/prelude/string.vibe")
  assert(path.is_absolute())
  let dynamic_path = dynamic("./vibe/prelude/string.vibe")
  assert(string_equals(dynamic_path.as_string(), "./vibe/prelude/string.vibe"))
  let resolved = resolve(dynamic_path)
  assert(resolved.is_absolute())
}
