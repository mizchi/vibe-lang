//# Imports

import .{
  actor_spec, channel_new, channel_spec, deployment_plan, probe_wat,
  recommended_component_model_threading_wasi_env,
  recommended_component_model_threading_wasi_flags,
  recommended_component_model_threading_wasm_env,
  recommended_component_model_threading_wasm_flags,
  recommended_shared_everything_component_wasi_env,
  recommended_shared_everything_component_wasi_flags,
  recommended_shared_everything_component_wasm_env,
  recommended_shared_everything_component_wasm_flags,
  recommended_shared_everything_wasi_env,
  recommended_shared_everything_wasi_flags,
  recommended_shared_everything_wasm_env,
  recommended_shared_everything_wasm_flags, recommended_wasi_env,
  recommended_wasi_flags, recommended_wasm_env, recommended_wasm_flags, recv,
  runtime_hints, send, spawn, task_spec, wait
}

//# Misc

test "prelude/threads index exports stable and unstable symbols" {
  let _ = probe_wat
  let _ = runtime_hints
  let _ = channel_new
  let _ = spawn
  let _ = send
  let _ = recv
  let _ = wait
  let task = task_spec("worker", "worker_entry")
  let channel = channel_spec("jobs", 4)
  let actor = actor_spec("pool", "jobs", "handle_job")
  let plan = deployment_plan(task, channel, actor)
  assert(plan.wasm_env == recommended_wasm_env())
  assert(plan.wasi_env == recommended_wasi_env())
  assert(Array::length(recommended_wasm_flags()) == 2)
  assert(Array::length(recommended_wasi_flags()) == 1)
  assert(Array::length(recommended_shared_everything_wasm_flags()) == 3)
  assert(Array::length(recommended_shared_everything_wasi_flags()) == 0)
  assert(Array::length(recommended_component_model_threading_wasm_flags()) == 3)
  assert(Array::length(recommended_component_model_threading_wasi_flags()) == 0)
  assert(Array::length(recommended_shared_everything_component_wasm_flags()) == 6)
  assert(Array::length(recommended_shared_everything_component_wasi_flags()) == 0)
  assert(
    recommended_shared_everything_wasm_env() ==
      "gc=y function-references=y shared-everything-threads=y"
  )
  assert(recommended_shared_everything_wasi_env() == "")
  assert(
    recommended_component_model_threading_wasm_env() ==
      "component-model=y component-model-async=y component-model-threading=y"
  )
  assert(recommended_component_model_threading_wasi_env() == "")
  assert(
    recommended_shared_everything_component_wasm_env() ==
      "component-model=y component-model-async=y component-model-threading=y gc=y function-references=y shared-everything-threads=y"
  )
  assert(recommended_shared_everything_component_wasi_env() == "")
}
