//# Imports

import .{
  probe_wat, runtime_hints, task_spec, channel_spec, actor_spec, deployment_plan, recommended_wasm_flags, recommended_wasi_flags, recommended_wasm_env, recommended_wasi_env, channel_new, spawn, send, recv, wait
}

//# Misc

test "prelude/threads index exports stable and unstable symbols" {
  let _ = probe_wat
  let _ = runtime_hints
  let _ = channel_new
  let _ = spawn
  let _ = send
  let _ = recv
  let _ = wait
  let task = task_spec("worker", "worker_entry")
  let channel = channel_spec("jobs", 4)
  let actor = actor_spec("pool", "jobs", "handle_job")
  let plan = deployment_plan(task, channel, actor)
  assert(plan.wasm_env == recommended_wasm_env())
  assert(plan.wasi_env == recommended_wasi_env())
  assert(array_length(recommended_wasm_flags()) == 2)
  assert(array_length(recommended_wasi_flags()) == 1)
}
