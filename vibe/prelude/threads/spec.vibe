//# Functions

export let task_spec = (name: String, entry_symbol: String) {
  record {
    kind: "task",
    name: name,
    entry_symbol: entry_symbol
  }
}

export let actor_spec = (name: String, mailbox: String, handler_symbol: String) {
  record {
    kind: "actor",
    name: name,
    mailbox: mailbox,
    handler_symbol: handler_symbol
  }
}

export let channel_spec = (name: String, capacity: Int) {
  let normalized = if capacity < 0 {
    0
  } else capacity
  record {
    kind: "channel",
    name: name,
    capacity: normalized
  }
}

export let recommended_wasi_env = () -> String {
  "threads=y"
}

export let recommended_wasm_env = () -> String {
  "threads=y shared-memory=y"
}

export let recommended_wasi_flags = () -> Array[String] {
  [
    "threads=y"
  ]
}

export let recommended_wasm_flags = () -> Array[String] {
  [
    "threads=y",
    "shared-memory=y"
  ]
}

export let recommended_shared_everything_wasi_env = () -> String {
  ""
}

export let recommended_shared_everything_wasm_env = () -> String {
  "gc=y function-references=y shared-everything-threads=y"
}

export let recommended_shared_everything_wasi_flags = () -> Array[String] {
  []
}

export let recommended_shared_everything_wasm_flags = () -> Array[String] {
  [
    "gc=y",
    "function-references=y",
    "shared-everything-threads=y"
  ]
}

export let recommended_component_model_threading_wasi_env = () -> String {
  ""
}

export let recommended_component_model_threading_wasm_env = () -> String {
  "component-model=y component-model-async=y component-model-threading=y"
}

export let recommended_component_model_threading_wasi_flags = () -> Array[String] {
  []
}

export let recommended_component_model_threading_wasm_flags = () -> Array[String] {
  [
    "component-model=y",
    "component-model-async=y",
    "component-model-threading=y"
  ]
}

export let recommended_shared_everything_component_wasi_env = () -> String {
  ""
}

export let recommended_shared_everything_component_wasm_env = () -> String {
  "component-model=y component-model-async=y component-model-threading=y gc=y function-references=y shared-everything-threads=y"
}

export let recommended_shared_everything_component_wasi_flags = () -> Array[String] {
  []
}

export let recommended_shared_everything_component_wasm_flags = () -> Array[String] {
  [
    "component-model=y",
    "component-model-async=y",
    "component-model-threading=y",
    "gc=y",
    "function-references=y",
    "shared-everything-threads=y"
  ]
}

export let deployment_plan = [Task, Channel, Actor](task: Task, channel: Channel, actor: Actor) {
  record {
    task: task,
    channel: channel,
    actor: actor,
    wasm_flags: recommended_wasm_flags(),
    wasi_flags: recommended_wasi_flags(),
    wasm_env: recommended_wasm_env(),
    wasi_env: recommended_wasi_env(),
    unstable_flag: "--unstable-threads"
  }
}
