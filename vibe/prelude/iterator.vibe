//# Functions

export let Iterator::fold = [C: Iterable, T, B](xs: C, init: B, f: (acc: B, x: T) -> B) -> B {
  let len = xs|>iter_length
  let mut i = 0
  let mut acc = init
  while i < len {
    acc = f(acc, xs|>iter_get(i))
    i = i + 1
  }
  acc
}

export let Iterator::iter = [C: Iterable, T, R](xs: C, f: (x: T) -> R) -> Int {
  let len = xs|>iter_length
  let mut i = 0
  while i < len {
    f(xs|>iter_get(i))
    i = i + 1
  }
  i
}

export let Iterator::find = [C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Option[T] {
  let len = xs|>iter_length
  let mut i = 0
  let mut result = None
  while i < len {
    let value = xs|>iter_get(i)
    if pred(value) {
      result = Some(value)
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

export let Iterator::any = [C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Bool {
  let len = xs|>iter_length
  let mut i = 0
  let mut found = false
  while i < len {
    if pred(xs|>iter_get(i)) {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

export let Iterator::all = [C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Bool {
  let len = xs|>iter_length
  let mut i = 0
  let mut ok = true
  while i < len {
    if pred(xs|>iter_get(i)) {
      i = i + 1
    } else {
      ok = false
      i = len
    }
  }
  ok
}

export let Iterator::r#map = [C: Iterable, A, B](xs: C, f: (x: A) -> B) -> Array[B] {
  let len = xs|>iter_length
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      ArrayBuilder::push(acc, f(xs|>iter_get(i)))
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}

export let Iterator::filter = [C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Array[T] {
  let len = xs|>iter_length
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let value = xs|>iter_get(i)
      if pred(value) {
        ArrayBuilder::push(acc, value)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}

export let Iterator::flatmap = [C: Iterable, A, B](xs: C, f: (x: A) -> Array[B]) -> Array[B] {
  let len = xs|>iter_length
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let chunk = f(xs|>iter_get(i))
      let chunk_len = Array::length(chunk)
      let mut j = 0
      while j < chunk_len {
        ArrayBuilder::push(acc, Array::get(chunk, j))
        j = j + 1
      }
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}
