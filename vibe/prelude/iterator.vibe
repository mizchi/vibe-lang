//# Functions

export let Iterator::fold = [T, B](xs: Array[T], init: B, f: (acc: B, x: T) -> B) -> B {
  let len = Array::length(xs)
  let mut i = 0
  let mut acc = init
  while i < len {
    acc = f(acc, Array::get(xs, i))
    i = i + 1
  }
  acc
}

export let Iterator::iter = [T, R](xs: Array[T], f: (x: T) -> R) -> Int {
  let len = Array::length(xs)
  let mut i = 0
  while i < len {
    f(Array::get(xs, i))
    i = i + 1
  }
  i
}

export let Iterator::find = [T](xs: Array[T], pred: (x: T) -> Bool) -> Option[T] {
  let len = Array::length(xs)
  let mut i = 0
  let mut result = None
  while i < len {
    let value = Array::get(xs, i)
    if pred(value) {
      result = Some(value)
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

export let Iterator::any = [T](xs: Array[T], pred: (x: T) -> Bool) -> Bool {
  let len = Array::length(xs)
  let mut i = 0
  let mut found = false
  while i < len {
    if pred(Array::get(xs, i)) {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

export let Iterator::all = [T](xs: Array[T], pred: (x: T) -> Bool) -> Bool {
  let len = Array::length(xs)
  let mut i = 0
  let mut ok = true
  while i < len {
    if pred(Array::get(xs, i)) {
      i = i + 1
    } else {
      ok = false
      i = len
    }
  }
  ok
}

export let Iterator::r#map = [A, B](xs: Array[A], f: (x: A) -> B) -> Array[B] {
  let len = Array::length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      ArrayBuilder::push(acc, f(Array::get(xs, i)))
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}

export let Iterator::filter = [T](xs: Array[T], pred: (x: T) -> Bool) -> Array[T] {
  let len = Array::length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let value = Array::get(xs, i)
      if pred(value) {
        ArrayBuilder::push(acc, value)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}

export let Iterator::flatmap = [A, B](xs: Array[A], f: (x: A) -> Array[B]) -> Array[B] {
  let len = Array::length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let chunk = f(Array::get(xs, i))
      let chunk_len = Array::length(chunk)
      let mut j = 0
      while j < chunk_len {
        ArrayBuilder::push(acc, Array::get(chunk, j))
        j = j + 1
      }
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}
