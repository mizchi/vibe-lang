//# Functions

export let Iterator::fold = [T, B](xs: Array[T], init: B, f: (acc: B, x: T) -> B) -> B {
  let len = Array::length(xs)
  let mut i = 0
  let mut acc = init
  while i < len {
    acc = f(acc, Array::get(xs, i))
    i = i + 1
  }
  acc
}

export let Iterator::iter = [T, R](xs: Array[T], f: (x: T) -> R) -> Int {
  let len = Array::length(xs)
  let mut i = 0
  while i < len {
    f(Array::get(xs, i))
    i = i + 1
  }
  i
}

export let Iterator::find = [T](xs: Array[T], pred: (x: T) -> Bool) -> Option[T] {
  let len = Array::length(xs)
  let mut i = 0
  let mut result = None
  while i < len {
    let value = Array::get(xs, i)
    if pred(value) {
      result = Some(value)
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

export let Iterator::any = [T](xs: Array[T], pred: (x: T) -> Bool) -> Bool {
  let len = Array::length(xs)
  let mut i = 0
  let mut found = false
  while i < len {
    if pred(Array::get(xs, i)) {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

export let Iterator::all = [T](xs: Array[T], pred: (x: T) -> Bool) -> Bool {
  let len = Array::length(xs)
  let mut i = 0
  let mut ok = true
  while i < len {
    if pred(Array::get(xs, i)) {
      i = i + 1
    } else {
      ok = false
      i = len
    }
  }
  ok
}
