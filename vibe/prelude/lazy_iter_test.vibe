//# Imports

import ./lazy_iter.vibe {
  lazy_iter_arr, lazy_iter_collect, lazy_iter_count, lazy_iter_filter, lazy_iter_fold, lazy_iter_map
}

//# Misc

test "lazy_iter: collect from Array yields the same elements" {
  let arr = lazy_iter_arr([1, 2, 3, 4, 5]) |> lazy_iter_collect
  assert(Array::length(arr) == 5)
  assert(Array::get(arr, 0) == 1)
  assert(Array::get(arr, 4) == 5)
}

test "lazy_iter: map preserves length and applies f" {
  let arr = lazy_iter_arr([1, 2, 3]) |> lazy_iter_map((x: Int) -> Int { x * x }) |> lazy_iter_collect
  assert(Array::length(arr) == 3)
  assert(Array::get(arr, 0) == 1)
  assert(Array::get(arr, 1) == 4)
  assert(Array::get(arr, 2) == 9)
}

test "lazy_iter: map can change element type (Int to String)" {
  let arr = lazy_iter_arr([1, 2, 3]) |> lazy_iter_map((x: Int) -> String { __to_string(x) }) |> lazy_iter_collect
  assert(Array::length(arr) == 3)
  assert(String::equals(Array::get(arr, 0), "1"))
  assert(String::equals(Array::get(arr, 2), "3"))
}

test "lazy_iter: filter drops false elements" {
  let arr = lazy_iter_arr([1, 2, 3, 4, 5, 6]) |> lazy_iter_filter((x: Int) -> Bool { x % 2 == 0 }) |> lazy_iter_collect
  assert(Array::length(arr) == 3)
  assert(Array::get(arr, 0) == 2)
  assert(Array::get(arr, 1) == 4)
  assert(Array::get(arr, 2) == 6)
}

test "lazy_iter: fold sums elements" {
  let total = lazy_iter_arr([1, 2, 3, 4, 5]) |> lazy_iter_fold(0, (acc: Int, x: Int) -> Int { acc + x })
  assert(total == 15)
}

test "lazy_iter: count returns total yielded element count" {
  let n = lazy_iter_arr([10, 20, 30, 40]) |> lazy_iter_count
  assert(n == 4)
}

test "lazy_iter: chains map + filter + fold without intermediate Arrays" {
  // sum of squares of odd numbers in 1..6 = 1 + 9 + 25 = 35
  let total = lazy_iter_arr([1, 2, 3, 4, 5])
    |> lazy_iter_filter((x: Int) -> Bool { x % 2 == 1 })
    |> lazy_iter_map((x: Int) -> Int { x * x })
    |> lazy_iter_fold(0, (acc: Int, x: Int) -> Int { acc + x })
  assert(total == 35)
}

test "lazy_iter: empty source yields empty Array via collect" {
  let arr : Array[Int] = []
  let out = lazy_iter_arr(arr) |> lazy_iter_collect
  assert(Array::length(out) == 0)
}

// Trait-iterator element-type inference: `for x in <LazyIter[Int]>` binds `x`
// to the iterator's element type (`Int`), recovered from the iterable's type
// `LazyIter[Int]` even though the `impl Iterator for LazyIter` lives in the
// imported `lazy_iter.vibe`. So the loop body can use `x` directly in element
// arithmetic (`acc + x`) instead of routing it through a closure to dodge the
// previous `CtUnknown` element type.
let lazy_iter_sum_direct = (src: LazyIter[Int]) -> Int {
  let mut total = 0
  for x in src {
    total = total + x
  }
  total
}

test "lazy_iter: for-in over imported LazyIter binds the element type" {
  assert(lazy_iter_sum_direct(lazy_iter_arr([1, 2, 3, 4, 5])) == 15)
}
