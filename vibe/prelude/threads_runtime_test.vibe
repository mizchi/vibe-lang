//# Imports

import ./threads / runtime.vibe {
  channel_new, probe_wat, recv, runtime_hints, send, spawn, wait
}

//# Misc

test "threads/runtime probe and hints typecheck" {
  let _ = probe_wat
  let _ = runtime_hints
  assert(true)
}

test "threads/runtime unstable APIs stay thunk-only in std tests" {
  let _ = channel_new
  let _ = spawn
  let _ = send
  let _ = recv
  let _ = wait
  assert(true)
}
