//# Imports

import ./threads / runtime.vibe {
  probe_wat, runtime_hints, channel_new, spawn, send, recv, wait
}

//# Misc

test "threads/runtime probe and hints typecheck" {
  let _ = probe_wat
  let _ = runtime_hints
  assert(true)
}

test "threads/runtime unstable APIs stay thunk-only in std tests" {
  let _ = channel_new
  let _ = spawn
  let _ = send
  let _ = recv
  let _ = wait
  assert(true)
}
