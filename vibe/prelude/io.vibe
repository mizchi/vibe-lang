//# Functions

// stdin_read: (Int) -> String with {Stdin}
export let stdin_read = (max_bytes: Int) -> String {
  perform Stdin::ReadStream(max_bytes)
}

// ansi_escape: (String) -> Unit with {Stdout}
export let ansi_escape = (suffix: String) -> Unit {
  {
    perform Stdout::WriteChar(27)
    perform Stdout::WriteStream(suffix)
  }
}

// stdout_write: (String) -> Unit with {Stdout}
export let stdout_write = (s: String) -> Unit {
  perform Stdout::WriteStream(s)
}

// stdout_writeln: (String) -> Unit with {Stdout}
export let stdout_writeln = (s: String) -> Unit {
  {
    stdout_write(s)
    perform Stdout::WriteChar(10)
  }
}

// stdin_read_line: () -> String with {Stdin}
export let stdin_read_line = () -> String {
  {
    let mut acc = ""
    let mut done = false
    while not(done) {
      let c = Stdin::read_char()
      let stop = c < 0 || c == 10
      done = stop
      acc = if stop {
        acc
      } else "\{acc}\{String::from_char_code(c)}"
    }
    acc
  }
}

// tui_cursor_home: () -> Unit with {Stdout}
export let tui_cursor_home = () -> Unit {
  ansi_escape("[H")
}

// tui_clear_screen: () -> Unit with {Stdout}
export let tui_clear_screen = () -> Unit {
  ansi_escape("[2J")
}

// tui_enter_alt_screen: () -> Unit with {Stdout}
export let tui_enter_alt_screen = () -> Unit {
  ansi_escape("[?1049h")
}

// tui_leave_alt_screen: () -> Unit with {Stdout}
export let tui_leave_alt_screen = () -> Unit {
  ansi_escape("[?1049l")
}
