//# Types

export type Byte = Int

//# Functions

export let get = (bytes: Bytes, index: Int) -> Option[Int] {
  if index < 0 || index >= bytes_length(bytes) {
    None
  } else Some(bytes_get(bytes, index))
}

export let equals = (a: Bytes, b: Bytes) -> Bool {
  let len = bytes_length(a)
  if len != bytes_length(b) {
    false
  }
  else {
    let rec r#loop = (i: Int) -> Bool {
      if i >= len {
        true
      }
      else if bytes_get(a, i) != bytes_get(b, i) {
        false
      }
      else r#loop(i + 1)
    }
    r#loop(0)
  }
}

export let length = (bytes: Bytes) -> Int {
  bytes_length(bytes)
}

export let is_byte = (value: Int) -> Bool {
  value >= 0 && value <= 255
}

export let to_ascii = (bytes: Bytes) -> Option[String] {
  let len = bytes_length(bytes)
  let rec r#loop = (i: Int, sb: StringBuilder) -> Option[String] {
    if i >= len {
      Some(string_builder_freeze(sb))
    }
    else {
      let code = bytes_get(bytes, i)
      if code < 0 || code > 127 {
        None
      }
      else {
        string_builder_push(sb, string_from_char_code(code))
        r#loop(i + 1, sb)
      }
    }
  }
  r#loop(0, string_builder())
}

export let clamp_byte = (value: Int) -> Int {
  if value < 0 {
    0
  }
  else if value > 255 {
    255
  }
  else value
}

export let from_ascii = (s: String) -> Option[Bytes] {
  let len = string_length(s)
  let b = bytes_new()
  let rec r#loop = (i: Int) -> Option[Bytes] {
    if i >= len {
      Some(b)
    }
    else {
      let code = string_char_code_at(s, i)
      if code < 0 || code > 127 {
        None
      }
      else {
        bytes_push(b, code)
        r#loop(i + 1)
      }
    }
  }
  r#loop(0)
}

let hex_char_value = (code: Int) -> Int {
  if code >= 48 && code <= 57 {
    code - 48
  }
  else if code >= 65 && code <= 70 {
    code - 55
  }
  else if code >= 97 && code <= 102 {
    code - 87
  }
  else -1
}

export let from_hex = (hex: String) -> Option[Bytes] {
  let len = string_length(hex)
  if len % 2 != 0 {
    None
  }
  else {
    let b = bytes_new()
    let rec r#loop = (i: Int) -> Option[Bytes] {
      if i >= len {
        Some(b)
      }
      else {
        let hi = hex_char_value(string_char_code_at(hex, i))
        let lo = hex_char_value(string_char_code_at(hex, i + 1))
        if hi < 0 || lo < 0 {
          None
        }
        else {
          let value = hi * 16 + lo
          {
            bytes_push(b, value)
            r#loop(i + 2)
          }
        }
      }
    }
    r#loop(0)
  }
}

let hex_nibble_char = (value: Int) -> String {
  if value < 10 {
    string_from_char_code(48 + value)
  } else string_from_char_code(87 + value)
}

export let to_hex = (bytes: Bytes) -> String {
  let len = bytes_length(bytes)
  let rec r#loop = (i: Int, sb: StringBuilder) -> String {
    if i >= len {
      string_builder_freeze(sb)
    }
    else {
      let byte = clamp_byte(bytes_get(bytes, i))
      let hi = byte / 16
      let lo = byte % 16
      {
        string_builder_push(sb, hex_nibble_char(hi))
        string_builder_push(sb, hex_nibble_char(lo))
      }
      r#loop(i + 1, sb)
    }
  }
  r#loop(0, string_builder())
}
