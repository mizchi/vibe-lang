//# Imports

import ./iterator.vibe {
  Iterator::all, Iterator::any, Iterator::find, Iterator::fold, Iterator::iter, Iterator::r#map, Iterator::filter, Iterator::flatmap
}
import ../collection/list.vibe {
  list_of3
}

//# Misc

enum Trio[T] {
  Trio(T, T, T)
}

impl [T] Iterable for Trio[T]

let trio_of3 = [T](a: T, b: T, c: T) -> Trio[T] {
  Trio(a, b, c)
}

let _iterator_test_trio_keep = trio_of3(0, 1, 2)

let Trio::iter_length = [T](_xs: Trio[T]) -> Int {
  3
}

let Trio::iter_get = [T](xs: Trio[T], index: Int) -> T {
  match xs {
    Trio(a, b, c) => if index == 0 {
      a
    } else if index == 1 {
      b
    } else {
      c
    }
  }
}

test "iterator_fold_and_iter" {
  let xs = [
    1,
    2,
    3,
    4
  ]
  let total = Iterator::fold(xs, 0, (acc: Int, x: Int) -> Int {
    acc + x
  })
  assert(eq(total, 10))
  assert(eq(xs|>Iterator::fold(0, (acc: Int, x: Int) -> Int {
    acc + x
  }), 10))
  let threshold = 0
  let count = Iterator::iter(xs, (x: Int) -> Bool {
    x > threshold
  })
  assert(eq(count, 4))
}

test "iterator_find_and_predicates" {
  let xs = [
    3,
    7,
    9
  ]
  match Iterator::find(xs, (x: Int) -> Bool {
    x > 5
  }) {
    Some(v) => assert(eq(v, 7)),
    _ => assert(false)
  }
  assert(Iterator::any(xs, (x: Int) -> Bool {
    x == 7
  }))
  assert(not(Iterator::all(xs, (x: Int) -> Bool {
    x > 5
  })))
  assert(Iterator::all([
    2,
    4,
    6
  ], (x: Int) -> Bool {
    x % 2 == 0
  }))
}

test "iterator_transform" {
  let xs = [
    1,
    2,
    3
  ]
  let doubled = Iterator::r#map(xs, (x: Int) -> Int {
    x * 2
  })
  assert(eq(Array::length(doubled), 3))
  assert(eq(Array::get(doubled, 0), 2))
  assert(eq(Array::get(doubled, 2), 6))
  let evens = Iterator::filter([
    1,
    2,
    3,
    4
  ], (x: Int) -> Bool {
    x % 2 == 0
  })
  assert(eq(Array::length(evens), 2))
  assert(eq(Array::get(evens, 0), 2))
  assert(eq(Array::get(evens, 1), 4))
  let duplicated = Iterator::flatmap([
    1,
    3
  ], (x: Int) -> Array[Int] {
    [
      x,
      x + 1
    ]
  })
  assert(eq(Array::length(duplicated), 4))
  assert(eq(Array::get(duplicated, 0), 1))
  assert(eq(Array::get(duplicated, 1), 2))
  assert(eq(Array::get(duplicated, 2), 3))
  assert(eq(Array::get(duplicated, 3), 4))
}

test "iterator_supports_string_iterable" {
  // ADR-0044 Phase 3: String implements Iterable. Iterator::* combinators
  // see each char as its Int char code (consistent with String for-in).
  let s = "abc"
  let total = Iterator::fold(s, 0, (acc: Int, c: Int) -> Int {
    acc + c
  })
  // 'a'=97, 'b'=98, 'c'=99 -> 294
  assert(eq(total, 294))
  assert(Iterator::any(s, (c: Int) -> Bool {
    c == 98
  }))
  assert(not(Iterator::all(s, (c: Int) -> Bool {
    c > 97
  })))
  match Iterator::find(s, (c: Int) -> Bool {
    c == 99
  }) {
    Some(v) => assert(eq(v, 99)),
    _ => assert(false)
  }
  let shifted = Iterator::r#map(s, (c: Int) -> Int {
    c + 1
  })
  assert(eq(Array::length(shifted), 3))
  assert(eq(Array::get(shifted, 0), 98))
  assert(eq(Array::get(shifted, 2), 100))
}

test "iterator_supports_map_iterable" {
  // ADR-0044 Phase 3: Map[K, V] implements Iterable, yielding K (key) per
  // iteration. Iter_get is O(n) per call (Map::keys allocates), so the full
  // for-in / Iterator::* pass over a Map is O(n^2). Acceptable for small
  // maps; for hot paths use `Map::keys |> Iterator::*`.
  let m = map { "a": 1, "b": 2, "c": 3 }
  let total_keys = Iterator::fold(m, "", (acc: String, k: String) -> String {
    acc + k
  })
  // Iteration order matches insertion order for small linear-search maps.
  assert(eq(total_keys, "abc"))
  let total_vals = Iterator::fold(m, 0, (acc: Int, k: String) -> Int {
    acc + Map::get(m, k)
  })
  assert(eq(total_vals, 6))
  assert(Iterator::any(m, (k: String) -> Bool {
    k == "b"
  }))
}

test "iterator_supports_custom_iterable" {
  let xs = trio_of3(2, 4, 6)
  assert(eq(Iterator::fold(xs, 0, (acc: Int, x: Int) -> Int {
    acc + x
  }), 12))
  assert(eq(Iterator::fold(list_of3(1, 2, 3), 0, (acc: Int, x: Int) -> Int {
    acc + x
  }), 6))
  match Iterator::find(xs, (x: Int) -> Bool {
    x == 4
  }) {
    Some(v) => assert(eq(v, 4)),
    _ => assert(false)
  }
  let doubled = Iterator::r#map(xs, (x: Int) -> Int {
    x * 2
  })
  assert(eq(Array::length(doubled), 3))
  assert(eq(Array::get(doubled, 0), 4))
  assert(eq(Array::get(doubled, 1), 8))
  assert(eq(Array::get(doubled, 2), 12))
}
