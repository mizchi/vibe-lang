//# Imports

import ./iterator.vibe {
  Iterator::all, Iterator::any, Iterator::find, Iterator::fold, Iterator::iter, Iterator::r#map, Iterator::filter, Iterator::flatmap
}

//# Misc

test "iterator_fold_and_iter" {
  let xs = [
    1,
    2,
    3,
    4
  ]
  let total = Iterator::fold(xs, 0, (acc: Int, x: Int) -> Int {
    acc + x
  })
  assert(eq(total, 10))
  assert(eq(xs|>Iterator::fold(0, (acc: Int, x: Int) -> Int {
    acc + x
  }), 10))
  let threshold = 0
  let count = Iterator::iter(xs, (x: Int) -> Bool {
    x > threshold
  })
  assert(eq(count, 4))
}

test "iterator_find_and_predicates" {
  let xs = [
    3,
    7,
    9
  ]
  match Iterator::find(xs, (x: Int) -> Bool {
    x > 5
  }) {
    Some(v) => assert(eq(v, 7)),
    _ => assert(false)
  }
  assert(Iterator::any(xs, (x: Int) -> Bool {
    x == 7
  }))
  assert(not(Iterator::all(xs, (x: Int) -> Bool {
    x > 5
  })))
  assert(Iterator::all([
    2,
    4,
    6
  ], (x: Int) -> Bool {
    x % 2 == 0
  }))
}

test "iterator_transform" {
  let xs = [
    1,
    2,
    3
  ]
  let doubled = Iterator::r#map(xs, (x: Int) -> Int {
    x * 2
  })
  assert(eq(Array::length(doubled), 3))
  assert(eq(Array::get(doubled, 0), 2))
  assert(eq(Array::get(doubled, 2), 6))
  let evens = Iterator::filter([
    1,
    2,
    3,
    4
  ], (x: Int) -> Bool {
    x % 2 == 0
  })
  assert(eq(Array::length(evens), 2))
  assert(eq(Array::get(evens, 0), 2))
  assert(eq(Array::get(evens, 1), 4))
  let duplicated = Iterator::flatmap([
    1,
    3
  ], (x: Int) -> Array[Int] {
    [
      x,
      x + 1
    ]
  })
  assert(eq(Array::length(duplicated), 4))
  assert(eq(Array::get(duplicated, 0), 1))
  assert(eq(Array::get(duplicated, 1), 2))
  assert(eq(Array::get(duplicated, 2), 3))
  assert(eq(Array::get(duplicated, 3), 4))
}
