//# Imports

import ./bytes.vibe {
  is_byte, clamp_byte, length, get, equals, from_ascii, to_ascii, to_hex, from_hex
}

//# Functions

let rec repeat = (s: String, n: Int) -> String {
  let rec r#loop = (i: Int, acc: String) -> String {
    if i <= 0 {
      acc
    } else r#loop(i - 1, string_concat(acc, s))
  }
  r#loop(n, "")
}

//# Misc

test "bytes_byte_range" {
  assert(is_byte(0))
  assert(is_byte(255))
  assert(not(is_byte(-1)))
  assert(not(is_byte(256)))
  assert(eq(clamp_byte(-3), 0))
  assert(eq(clamp_byte(120), 120))
  assert(eq(clamp_byte(300), 255))
}

test "bytes_ascii_roundtrip" {
  match from_ascii("Az09") {
    Some(bytes) => {
      assert(eq(length(bytes), 4))
      match get(bytes, 0) {
        Some(v) => assert(eq(v, 65)),
        _ => assert(false)
      }
      match to_ascii(bytes) {
        Some(s) => assert(string_equals(s, "Az09")),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "bytes_ascii_invalid" {
  match from_ascii("あ") {
    None => assert(true),
    _ => assert(false)
  }
  match to_ascii([
    65,
    200
  ]) {
    None => assert(true),
    _ => assert(false)
  }
}

test "bytes_hex_roundtrip" {
  let hex = to_hex([
    0,
    15,
    16,
    255
  ])
  assert(string_equals(hex, "000f10ff"))
  match from_hex(hex) {
    Some(decoded) => assert(equals(decoded, [
      0,
      15,
      16,
      255
    ])),
    _ => assert(false)
  }
}

test "bytes_hex_invalid" {
  match from_hex("0") {
    None => assert(true),
    _ => assert(false)
  }
  match from_hex("0g") {
    None => assert(true),
    _ => assert(false)
  }
}

test "bytes_ascii_large_roundtrip" {
  let src = repeat("abCD09", 12)
  match from_ascii(src) {
    Some(bytes) => {
      assert(eq(length(bytes), string_length(src)))
      match to_ascii(bytes) {
        Some(decoded) => assert(string_equals(decoded, src)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "bytes_hex_large_roundtrip" {
  let hex = repeat("00ff10ab", 12)
  match from_hex(hex) {
    Some(bytes) => {
      assert(eq(string_length(hex), length(bytes) * 2))
      assert(string_equals(to_hex(bytes), hex))
    },
    _ => assert(false)
  }
}
