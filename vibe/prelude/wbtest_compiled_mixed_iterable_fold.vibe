import ./iterator.vibe {
  Iterator::fold
}
import ../collection/list.vibe {
  list_of3
}
enum Trio[T] {
  Trio(T, T, T)
}
impl [T] Iterable for Trio[T]
let trio_of3 = [T](a: T, b: T, c: T) -> Trio[T] {
  Trio(a, b, c)
}
let Trio::iter_length = [T](_xs: Trio[T]) -> Int {
  3
}
let Trio::iter_get = [T](xs: Trio[T], index: Int) -> T {
  match xs {
    Trio(a, b, c) => if index == 0 {
      a
    } else if index == 1 {
      b
    } else {
      c
    }
  }
}
test "mixed iterable fold specializations" {
  let xs = trio_of3(2, 4, 6)
  assert(eq(Iterator::fold(xs, 0, (acc: Int, x: Int) -> Int {
    acc + x
  }), 12))
  assert(eq(Iterator::fold(list_of3(1, 2, 3), 0, (acc: Int, x: Int) -> Int {
    acc + x
  }), 6))
}
