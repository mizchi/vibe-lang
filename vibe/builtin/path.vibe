//# Types

export struct PathRef {
  raw: String
}

export struct DynamicPath {
  raw: String
}

//# Functions

// dynamic: (String) -> DynamicPath
export let dynamic = (raw: String) -> DynamicPath {
  DynamicPath::{
    raw: raw
  }
}

// resolve: (DynamicPath) -> PathRef with {Env}
export let resolve = (path: DynamicPath) -> PathRef with { Env } {
  do {
    PathRef::{
      raw: path_to_string(dynamic_path_resolve(path.raw))
    }
  }
}

// from_literal: (String) -> PathRef
export let from_literal = (literal: String) -> PathRef {
  PathRef::{
    raw: path_to_string(path_ref(literal))
  }
}

export let PathRef::as_string = (self: PathRef) -> String {
  self.raw
}

export let DynamicPath::resolve = (path: DynamicPath) -> PathRef with { Env } {
  do {
    resolve(path)
  }
}

export let PathRef::is_absolute = (self: PathRef) -> Bool {
  path_is_absolute(path(self.raw))
}

export let DynamicPath::as_string = (path: DynamicPath) -> String {
  path.raw
}

//# Misc

export {
  PathRef, dynamic, resolve, DynamicPath, from_literal, PathRef::as_string, DynamicPath::resolve, PathRef::is_absolute, DynamicPath::as_string
}
