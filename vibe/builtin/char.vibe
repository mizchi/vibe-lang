//# Functions

// to_int: (Char) -> Int
export let to_int = (ch: Char) -> Int {
  char_to_int(ch)
}

// from_int: (Int) ->
export let from_int = (code: Int) -> Option[Char] {
  if code < 0 || code > 1114111 {
    None
  } else {
    Some(char_from_int(code))
  }
}

// is_ascii: (Char) -> Bool
export let is_ascii = (ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 0 && code <= 127
}

// to_string: (Char) -> String
export let to_string = (ch: Char) -> String {
  __to_string(ch)
}

// from_string: (String) ->
export let from_string = (s: String) -> Option[Char] {
  if string_length(s) == 1 {
    from_int(string_char_code_at(s, 0))
  } else {
    None
  }
}

// is_ascii_digit: (Char) -> Bool
export let is_ascii_digit = (ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 48 && code <= 57
}

// is_ascii_hexdigit: (Char) -> Bool
export let is_ascii_hexdigit = (ch: Char) -> Bool {
  let code = to_int(ch)
  is_ascii_digit(ch)
  || (code >= 65 && code <= 70)
  || (code >= 97 && code <= 102)
}

// is_ascii_lowercase: (Char) -> Bool
export let is_ascii_lowercase = (ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 97 && code <= 122
}

// is_ascii_uppercase: (Char) -> Bool
export let is_ascii_uppercase = (ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 65 && code <= 90
}

// to_ascii_lowercase: (Char) -> Char
export let to_ascii_lowercase = (ch: Char) -> Char {
  if is_ascii_uppercase(ch) {
    char_from_int(to_int(ch) + 32)
  } else {
    ch
  }
}

// to_ascii_uppercase: (Char) -> Char
export let to_ascii_uppercase = (ch: Char) -> Char {
  if is_ascii_lowercase(ch) {
    char_from_int(to_int(ch) - 32)
  } else {
    ch
  }
}

// is_ascii_alphabetic: (Char) -> Bool
export let is_ascii_alphabetic = (ch: Char) -> Bool {
  is_ascii_lowercase(ch) || is_ascii_uppercase(ch)
}

// is_ascii_alnum: (Char) -> Bool
export let is_ascii_alnum = (ch: Char) -> Bool {
  is_ascii_alphabetic(ch) || is_ascii_digit(ch)
}

// is_ascii_whitespace: (Char) -> Bool
export let is_ascii_whitespace = (ch: Char) -> Bool {
  let code = to_int(ch)
  code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}

//# Misc

export {
  to_int, from_int, is_ascii, to_string, from_string, is_ascii_alnum, is_ascii_digit, is_ascii_hexdigit, is_ascii_lowercase, is_ascii_uppercase, to_ascii_lowercase, to_ascii_uppercase, is_ascii_alphabetic, is_ascii_whitespace
}
