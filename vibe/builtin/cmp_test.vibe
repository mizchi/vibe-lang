//# Imports

use ./cmp.vibe {
  int_compare,
  string_compare,
  maximum,
  minimum,
  minmax,
  maximum_by,
  minimum_by,
  minmax_by,
  maximum_by_key,
  minimum_by_key,
  minmax_by_key
}

//# Misc

test "cmp_int_primitives" {
  assert(eq(int_compare(1, 2), -1))
  assert(eq(int_compare(2, 2), 0))
  assert(eq(int_compare(3, 2), 1))
  assert(eq(maximum(3, 9), 9))
  assert(eq(minimum(3, 9), 3))
  let p = minmax(9, 3)
  assert(eq(p.0, 3))
  assert(eq(p.1, 9))
}

test "cmp_by_comparator" {
  let by_abs = (a: Int, b: Int) -> Int {
    let abs_a = if a < 0 {
      0 - a
    } else a
    let abs_b = if b < 0 {
      0 - b
    } else b
    int_compare(abs_a, abs_b)
  }
  assert(eq(maximum_by(-2, 5, by_abs), 5))
  assert(eq(minimum_by(-2, 5, by_abs), -2))
  let p = minmax_by(-9, 3, by_abs)
  assert(eq(p.0, 3))
  assert(eq(p.1, -9))
}

test "cmp_by_key" {
  let neg = (x: Int) -> Int {
    0 - x
  }
  assert(eq(maximum_by_key(3, 9, neg, int_compare), 3))
  assert(eq(minimum_by_key(3, 9, neg, int_compare), 9))
  let first_char_code = (s: String) -> Int {
    string_char_code_at(s, 0)
  }
  let p = minmax_by_key("abc", "x", first_char_code, int_compare)
  assert(string_equals(p.0, "abc"))
  assert(string_equals(p.1, "x"))
}

test "cmp_string_compare" {
  assert(eq(string_compare("a", "b"), -1))
  assert(eq(string_compare("b", "b"), 0))
  assert(eq(string_compare("c", "b"), 1))
}
