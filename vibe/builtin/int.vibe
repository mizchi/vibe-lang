let int_max = (a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}
export let max = (a: Int, b: Int) -> Int {
  int_max(a, b)
}
let int_min = (a: Int, b: Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}
export let min = (a: Int, b: Int) -> Int {
  int_min(a, b)
