  }
  else if x < 0 {
    0 - x
  }
  else {
    x
  }
}
export let abs = (x: Int) -> Int {
  int_abs(x)
}
let rec int_gcd = (a: Int, b: Int) -> Int {
  let abs_a = int_abs(a)
  let abs_b = int_abs(b)
  if abs_b == 0 {
    abs_a
  }
  else {
    int_gcd(abs_b, abs_a % abs_b)
  }
}
export let gcd = (a: Int, b: Int) -> Int {
  int_gcd(a, b)
}
let int_lcm = (a: Int, b: Int) -> Int {
  if a == 0 || b == 0 {
    0
  }
  else {
    let g = int_gcd(a, b)
    let scaled = a / g
    int_abs(scaled * b)
  }
}
export let lcm = (a: Int, b: Int) -> Int {
  int_lcm(a, b)
}
