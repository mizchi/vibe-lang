let rec int_factorial = (n: Int) -> Int {
  if n <= 1 {
    1
  }
  else {
    n * int_factorial(n - 1)
  }
}
export let factorial = (n: Int) -> Int {
  int_factorial(n)
}
let int_fibonacci = (n: Int) -> Int {
  let rec fib = (a: Int, b: Int, count: Int) -> Int {
    if count <= 0 {
      a
    }
    else {
      fib(b, a + b, count - 1)
    }
  }
  fib(0, 1, n)
}
export let fibonacci = (n: Int) -> Int {
  int_fibonacci(n)
}
