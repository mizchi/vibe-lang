//# Imports

import ./path / ref.vibe {
  type PathRef,
  type DynamicPath,
  dynamic
}

import ./path / runtime.vibe {
  resolve
}

//# Misc

test "path/runtime resolve is Env effectful" {
  let path = resolve(dynamic("./vibe/builtin/string.vibe"))
  assert(path.is_absolute())
}

test "path/runtime DynamicPath::resolve is available" {
  let path = dynamic("./vibe/builtin/string.vibe").resolve()
  assert(path.is_absolute())
}
