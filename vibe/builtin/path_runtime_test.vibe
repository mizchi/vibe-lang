//# Imports

use ./path / ref.vibe {
  type PathRef,
  type DynamicPath,
  dynamic
}

use ./path / runtime.vibe {
  resolve
}

//# Misc

test "path/runtime resolve is Env effectful" {
  let path = do {
    resolve(dynamic("./vibe/builtin/string.vibe"))
  }
  assert(path.is_absolute())
}

test "path/runtime DynamicPath::resolve is available" {
  let path = do {
    dynamic("./vibe/builtin/string.vibe").resolve()
  }
  assert(path.is_absolute())
}
