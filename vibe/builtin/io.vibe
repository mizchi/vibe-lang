//# Functions

// stdin_read: (Int) -> String with {Stdin}
export let stdin_read = (max_bytes: Int) -> String with { Stdin } {
  stdin_read_stream(max_bytes)
}

// stdout_write: (String) -> Unit with {Stdout}
export let stdout_write = (s: String) -> Unit with { Stdout } {
  stdout_write_stream(s)
}

// stdout_writeln: (String) -> Unit with {Stdout}
export let stdout_writeln = (s: String) -> Unit with { Stdout } {
  {
    stdout_write(s)
    stdout_write_char(10)
  }
}

// stdin_read_line: () -> String with {Stdin}
export let stdin_read_line = () -> String with { Stdin } {
  {
    let mut acc = ""
    let mut done = false
    while not(done) {
      let c = stdin_read_char()
      let stop = c < 0 || c == 10
      done = stop
      acc = if stop {
        acc
      } else string_concat(acc, string_from_char_code(c))
    }
    acc
  }
}
