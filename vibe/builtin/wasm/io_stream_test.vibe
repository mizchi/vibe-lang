
use ./io_stream.vibe {
  stdout_write,
  stdout_writeln,
  stdin_read,
  ansi_escape,
  tui_enter_alt_screen,
  tui_leave_alt_screen,
  tui_cursor_home,
  tui_clear_screen
}
test "stream helpers run" {
  let run_stream = (n: Int, s: String) -> String with {
    Stdin, Stdout
  } {
    do {
      stdout_write(s)
      stdout_writeln(s)
      stdin_read(n)
    }
  }
  let read = do {
    run_stream(0, "")
  }
  assert(string_equals(read, ""))
}
test "ansi escape helper runs" {
  let run_ansi = (suffix: String) -> Unit with {
    Stdout
  } {
    do {
      ansi_escape(suffix)
    }
  }
  do {
    run_ansi("")
  }
  assert(true)
}
test "tui preset helpers run" {
  let run_tui = () -> Unit with {
    Stdout
  } {
    do {
      tui_enter_alt_screen()
      tui_clear_screen()
      tui_cursor_home()
      tui_leave_alt_screen()
    }
  }
  do {
    run_tui()
  }
  assert(true)
}
