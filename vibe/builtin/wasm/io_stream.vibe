
export let stdin_read = (max_bytes: Int) -> String with {
  Stdin
} {
  do {
    stdin_read_stream(max_bytes)
  }
}
export let ansi_escape = (suffix: String) -> Unit with {
  Stdout
} {
  do {
    stdout_write_char(27)
    stdout_write_stream(suffix)
  }
}
export let stdout_write = (s: String) -> Unit with {
  Stdout
} {
  do {
    stdout_write_stream(s)
  }
}
export let stdout_writeln = (s: String) -> Unit with {
  Stdout
} {
  do {
    stdout_write_stream(s)
    stdout_write_char(10)
  }
}
export let tui_cursor_home = () -> Unit with {
  Stdout
} {
  do {
    ansi_escape("[H")
  }
}
export let tui_clear_screen = () -> Unit with {
  Stdout
} {
  do {
    ansi_escape("[2J")
  }
}
export let tui_enter_alt_screen = () -> Unit with {
  Stdout
} {
  do {
    ansi_escape("[?1049h")
  }
}
export let tui_leave_alt_screen = () -> Unit with {
  Stdout
} {
  do {
    ansi_escape("[?1049l")
  }
}
export {
  stdin_read, ansi_escape, stdout_write, stdout_writeln, tui_cursor_home, tui_clear_screen, tui_enter_alt_screen, tui_leave_alt_screen
}
