//# Functions

export let i32_or = (a: i32, b: i32) -> i32 {
  a|b
}

export let f32_add = (a: f32, b: f32) -> f32 {
  a + b
}

export let f32_div = (a: f32, b: f32) -> f32 {
  a / b
}

export let f32_mul = (a: f32, b: f32) -> f32 {
  a * b
}

export let f32_sub = (a: f32, b: f32) -> f32 {
  a - b
}

export let f64_add = (a: f64, b: f64) -> f64 {
  a + b
}

export let f64_div = (a: f64, b: f64) -> f64 {
  a / b
}

export let f64_mul = (a: f64, b: f64) -> f64 {
  a * b
}

export let f64_sub = (a: f64, b: f64) -> f64 {
  a - b
}

export let i32_add = (a: i32, b: i32) -> i32 {
  a + b
}

export let i32_and = (a: i32, b: i32) -> i32 {
  a&b
}

export let i32_mul = (a: i32, b: i32) -> i32 {
  a * b
}

export let i32_shl = (a: i32, b: i32) -> i32 {
  a<<b
}

export let i32_sub = (a: i32, b: i32) -> i32 {
  a - b
}

export let i32_xor = (a: i32, b: i32) -> i32 {
  a^b
}

export let i32_div_s = (a: i32, b: i32) -> i32 {
  a / b
}

export let i32_rem_s = (a: i32, b: i32) -> i32 {
  a % b
}

export let i32_shr_s = (a: i32, b: i32) -> i32 {
  a>>b
}

let i32_from_bool = (b: Bool) -> i32 {
  if b {
    1
  } else {
    0
  }
}

export let f32_eq = (a: f32, b: f32) -> i32 {
  i32_from_bool(a == b)
}

export let f32_ge = (a: f32, b: f32) -> i32 {
  i32_from_bool(a >= b)
}

export let f32_gt = (a: f32, b: f32) -> i32 {
  i32_from_bool(a > b)
}

export let f32_le = (a: f32, b: f32) -> i32 {
  i32_from_bool(a <= b)
}

export let f32_lt = (a: f32, b: f32) -> i32 {
  i32_from_bool(a < b)
}

export let f32_ne = (a: f32, b: f32) -> i32 {
  i32_from_bool(a != b)
}

export let f64_eq = (a: f64, b: f64) -> i32 {
  i32_from_bool(a == b)
}

export let f64_ge = (a: f64, b: f64) -> i32 {
  i32_from_bool(a >= b)
}

export let f64_gt = (a: f64, b: f64) -> i32 {
  i32_from_bool(a > b)
}

export let f64_le = (a: f64, b: f64) -> i32 {
  i32_from_bool(a <= b)
}

export let f64_lt = (a: f64, b: f64) -> i32 {
  i32_from_bool(a < b)
}

export let f64_ne = (a: f64, b: f64) -> i32 {
  i32_from_bool(a != b)
}

export let i32_eq = (a: i32, b: i32) -> i32 {
  i32_from_bool(a == b)
}

export let i32_ne = (a: i32, b: i32) -> i32 {
  i32_from_bool(a != b)
}

export let i32_eqz = (x: i32) -> i32 {
  i32_from_bool(x == 0)
}

export let i32_ge_s = (a: i32, b: i32) -> i32 {
  i32_from_bool(a >= b)
}

export let i32_gt_s = (a: i32, b: i32) -> i32 {
  i32_from_bool(a > b)
}

export let i32_le_s = (a: i32, b: i32) -> i32 {
  i32_from_bool(a <= b)
}

export let i32_lt_s = (a: i32, b: i32) -> i32 {
  i32_from_bool(a < b)
}

export let f32_demote_f64 = (x: f64) -> f32 {
  double_to_float(x)
}

export let f64_promote_f32 = (x: f32) -> f64 {
  float_to_double(x)
}

export let i32_trunc_f32_s = (x: f32) -> i32 {
  float_to_int(x)
}

export let i32_trunc_f64_s = (x: f64) -> i32 {
  double_to_int(x)
}

export let f32_convert_i32_s = (x: i32) -> f32 {
  int_to_float(x)
}

export let f64_convert_i32_s = (x: i32) -> f64 {
  int_to_double(x)
}
