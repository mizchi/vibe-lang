//# Functions

// i32_or: (Int, Int) -> Int
export let i32_or = (a: i32, b: i32) -> i32 {
  a|b
}

// f32_add: (Float, Float) -> Float
export let f32_add = (a: f32, b: f32) -> f32 {
  a + b
}

// f32_div: (Float, Float) -> Float
export let f32_div = (a: f32, b: f32) -> f32 {
  a / b
}

// f32_mul: (Float, Float) -> Float
export let f32_mul = (a: f32, b: f32) -> f32 {
  a * b
}

// f32_sub: (Float, Float) -> Float
export let f32_sub = (a: f32, b: f32) -> f32 {
  a - b
}

// f64_add: (Double, Double) -> Double
export let f64_add = (a: f64, b: f64) -> f64 {
  a + b
}

// f64_div: (Double, Double) -> Double
export let f64_div = (a: f64, b: f64) -> f64 {
  a / b
}

// f64_mul: (Double, Double) -> Double
export let f64_mul = (a: f64, b: f64) -> f64 {
  a * b
}

// f64_sub: (Double, Double) -> Double
export let f64_sub = (a: f64, b: f64) -> f64 {
  a - b
}

// i32_add: (Int, Int) -> Int
export let i32_add = (a: i32, b: i32) -> i32 {
  a + b
}

// i32_and: (Int, Int) -> Int
export let i32_and = (a: i32, b: i32) -> i32 {
  a&b
}

// i32_mul: (Int, Int) -> Int
export let i32_mul = (a: i32, b: i32) -> i32 {
  a * b
}

// i32_shl: (Int, Int) -> Int
export let i32_shl = (a: i32, b: i32) -> i32 {
  a<<b
}

// i32_sub: (Int, Int) -> Int
export let i32_sub = (a: i32, b: i32) -> i32 {
  a - b
}

// i32_xor: (Int, Int) -> Int
export let i32_xor = (a: i32, b: i32) -> i32 {
  a^b
}

// i32_div_s: (Int, Int) -> Int
export let i32_div_s = (a: i32, b: i32) -> i32 {
  a / b
}

// i32_rem_s: (Int, Int) -> Int
export let i32_rem_s = (a: i32, b: i32) -> i32 {
  a % b
}

// i32_shr_s: (Int, Int) -> Int
export let i32_shr_s = (a: i32, b: i32) -> i32 {
  a>>b
}

// i32_from_bool: (Bool) -> Int
let i32_from_bool = (b: Bool) -> i32 {
  if b {
    1
  } else {
    0
  }
}

// f32_eq: (Float, Float) -> Int
export let f32_eq = (a: f32, b: f32) -> i32 {
  i32_from_bool(a == b)
}

// f32_ge: (Float, Float) -> Int
export let f32_ge = (a: f32, b: f32) -> i32 {
  i32_from_bool(a >= b)
}

// f32_gt: (Float, Float) -> Int
export let f32_gt = (a: f32, b: f32) -> i32 {
  i32_from_bool(a > b)
}

// f32_le: (Float, Float) -> Int
export let f32_le = (a: f32, b: f32) -> i32 {
  i32_from_bool(a <= b)
}

// f32_lt: (Float, Float) -> Int
export let f32_lt = (a: f32, b: f32) -> i32 {
  i32_from_bool(a < b)
}

// f32_ne: (Float, Float) -> Int
export let f32_ne = (a: f32, b: f32) -> i32 {
  i32_from_bool(a != b)
}

// f64_eq: (Double, Double) -> Int
export let f64_eq = (a: f64, b: f64) -> i32 {
  i32_from_bool(a == b)
}

// f64_ge: (Double, Double) -> Int
export let f64_ge = (a: f64, b: f64) -> i32 {
  i32_from_bool(a >= b)
}

// f64_gt: (Double, Double) -> Int
export let f64_gt = (a: f64, b: f64) -> i32 {
  i32_from_bool(a > b)
}

// f64_le: (Double, Double) -> Int
export let f64_le = (a: f64, b: f64) -> i32 {
  i32_from_bool(a <= b)
}

// f64_lt: (Double, Double) -> Int
export let f64_lt = (a: f64, b: f64) -> i32 {
  i32_from_bool(a < b)
}

// f64_ne: (Double, Double) -> Int
export let f64_ne = (a: f64, b: f64) -> i32 {
  i32_from_bool(a != b)
}

// i32_eq: (Int, Int) -> Int
export let i32_eq = (a: i32, b: i32) -> i32 {
  i32_from_bool(a == b)
}

// i32_ne: (Int, Int) -> Int
export let i32_ne = (a: i32, b: i32) -> i32 {
  i32_from_bool(a != b)
}

// i32_eqz: (Int) -> Int
export let i32_eqz = (x: i32) -> i32 {
  i32_from_bool(x == 0)
}

// i32_ge_s: (Int, Int) -> Int
export let i32_ge_s = (a: i32, b: i32) -> i32 {
  i32_from_bool(a >= b)
}

// i32_gt_s: (Int, Int) -> Int
export let i32_gt_s = (a: i32, b: i32) -> i32 {
  i32_from_bool(a > b)
}

// i32_le_s: (Int, Int) -> Int
export let i32_le_s = (a: i32, b: i32) -> i32 {
  i32_from_bool(a <= b)
}

// i32_lt_s: (Int, Int) -> Int
export let i32_lt_s = (a: i32, b: i32) -> i32 {
  i32_from_bool(a < b)
}

// f32_demote_f64: (Double) -> Float
export let f32_demote_f64 = (x: f64) -> f32 {
  double_to_float(x)
}

// f64_promote_f32: (Float) -> Double
export let f64_promote_f32 = (x: f32) -> f64 {
  float_to_double(x)
}

// i32_trunc_f32_s: (Float) -> Int
export let i32_trunc_f32_s = (x: f32) -> i32 {
  float_to_int(x)
}

// i32_trunc_f64_s: (Double) -> Int
export let i32_trunc_f64_s = (x: f64) -> i32 {
  double_to_int(x)
}

// f32_convert_i32_s: (Int) -> Float
export let f32_convert_i32_s = (x: i32) -> f32 {
  int_to_float(x)
}

// f64_convert_i32_s: (Int) -> Double
export let f64_convert_i32_s = (x: i32) -> f64 {
  int_to_double(x)
}

//# Misc

export {
  f32_eq, f32_ge, f32_gt, f32_le, f32_lt, f32_ne, f64_eq, f64_ge, f64_gt, f64_le, f64_lt, f64_ne, i32_eq, i32_ne, i32_or, f32_add, f32_div, f32_mul, f32_sub, f64_add, f64_div, f64_mul, f64_sub, i32_add, i32_and, i32_eqz, i32_mul, i32_shl, i32_sub, i32_xor, i32_ge_s, i32_gt_s, i32_le_s, i32_lt_s, i32_div_s, i32_rem_s, i32_shr_s, f32_demote_f64, f64_promote_f32, i32_trunc_f32_s, i32_trunc_f64_s, f32_convert_i32_s, f64_convert_i32_s
}
