//# Types

export type I32 = i32

export type F32 = f32

export type F64 = f64

//# Functions

// f32_id: (Float) -> Float
export let f32_id = (x: f32) -> f32 {
  x
}

// f64_id: (Double) -> Double
export let f64_id = (x: f64) -> f64 {
  x
}

// i32_add: (Int, Int) -> Int
export let i32_add = (a: i32, b: i32) -> i32 {
  a + b
}

//# Misc

export {
  F32, F64, I32, f32_id, f64_id, i32_add
}
