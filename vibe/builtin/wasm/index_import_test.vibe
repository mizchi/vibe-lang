//# Imports

import ./index.vibe {
  type I32,
  type F32,
  type F64,
  f32_id,
  f64_id,
  i32_add,
  i32_eqz,
  stdin_read,
  stdout_write,
}

//# Misc

test "builtin/wasm index exports core symbols" {
  let _i: I32 = 1
  let _f32: F32 = f32_id(1.0f)
  let _f64: F64 = f64_id(1.0)
  assert(i32_add(40, 2) == 42)
  assert(i32_eqz(0) == 1)
  let _ = stdin_read
  let _ = stdout_write
}
