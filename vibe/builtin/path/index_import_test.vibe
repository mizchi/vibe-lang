//# Imports

import ./index.vibe {
  type PathRef,
  type DynamicPath,
  dynamic,
  resolve,
  from_literal,
}

//# Misc

test "builtin/path index exports facade symbols" {
  let path = from_literal("./vibe/builtin/string.vibe")
  assert(path.is_absolute())
  let dynamic_path = dynamic("./vibe/builtin/string.vibe")
  assert(string_equals(dynamic_path.as_string(), "./vibe/builtin/string.vibe"))
  let resolved = resolve(dynamic_path)
  assert(resolved.is_absolute())
}
