
use ./ref.vibe {
  type PathRef,
  type DynamicPath
}
export let resolve = (path: DynamicPath) -> PathRef with {
  Env
} {
  do {
    PathRef::{
      raw: path_to_string(dynamic_path_resolve(path.raw))
    }
  }
}
export let DynamicPath::resolve = (path: DynamicPath) -> PathRef with {
  Env
} {
  do {
    resolve(path)
  }
}
export {
  resolve, DynamicPath::resolve
}
