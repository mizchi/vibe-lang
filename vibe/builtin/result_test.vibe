//# Imports

import ./result.vibe {
  Result,
  is_ok,
  is_err,
  ok,
  err,
  map_ok,
  map_err,
  map_or,
  bind,
  and_then,
  flatten,
  unwrap_or,
  unwrap_or_else,
  or,
  or_else,
  to_option,
  from_option,
  equals_by
}

//# Functions

let result_ok = ok

let result_or = or

let result_err = err

let result_bind = bind

let result_is_ok = is_ok

let result_is_err = is_err

let result_map_ok = map_ok

let result_map_or = map_or

let result_flatten = flatten

let result_map_err = map_err

let result_or_else = or_else

let result_and_then = and_then

let result_equals_by = equals_by

let result_to_option = to_option

let result_unwrap_or = unwrap_or

let result_from_option = from_option

let result_unwrap_or_else = unwrap_or_else

//# Misc

test "result_is_ok_err" {
  assert(result_is_ok(Ok(1)))
  assert(not(result_is_ok(Err("x"))))
  assert(result_is_err(Err("x")))
  assert(not(result_is_err(Ok(1))))
}

test "result_ok_err_extractors" {
  match result_ok(Ok(42)) {
    Some(v) => assert(eq(v, 42)),
    _ => assert(false)
  }
  match result_ok(Err("e")) {
    None => assert(true),
    _ => assert(false)
  }
  match result_err(Err("bad")) {
    Some(msg) => assert(string_equals(msg, "bad")),
    _ => assert(false)
  }
  match result_err(Ok(7)) {
    None => assert(true),
    _ => assert(false)
  }
}

test "result_map_and_bind" {
  let doubled = result_map_ok(Ok(5), (x: Int) -> Int {
    x * 2
  })
  assert(eq(result_unwrap_or(doubled, 0), 10))
  let tagged = result_map_err(Err("e1"), (e: String) -> String {
    string_concat("tag:", e)
  })
  match tagged {
    Err(msg) => assert(string_equals(msg, "tag:e1")),
    _ => assert(false)
  }
  let safe_half = (x: Int) -> Result[Int, String] {
    if x % 2 == 0 {
      Ok(x / 2)
    } else Err("odd")
  }
  assert(eq(result_unwrap_or(result_bind(Ok(8), safe_half), 0), 4))
  assert(eq(result_unwrap_or(result_and_then(Ok(10), safe_half), 0), 5))
  match result_bind(Ok(3), safe_half) {
    Err(msg) => assert(string_equals(msg, "odd")),
    _ => assert(false)
  }
}

test "result_flatten_and_map_or" {
  assert(eq(result_unwrap_or(result_flatten(Ok(Ok(9))), 0), 9))
  match result_flatten(Ok(Err("nested"))) {
    Err(msg) => assert(string_equals(msg, "nested")),
    _ => assert(false)
  }
  match result_flatten(Err("outer")) {
    Err(msg) => assert(string_equals(msg, "outer")),
    _ => assert(false)
  }
  let len = (s: String) -> Int {
    string_length(s)
  }
  assert(eq(result_map_or(Ok("abc"), 0, len), 3))
  assert(eq(result_map_or(Err("x"), 7, len), 7))
}

test "result_fallback_and_option_bridge" {
  assert(eq(result_unwrap_or(Ok(5), 0), 5))
  assert(eq(result_unwrap_or(Err("x"), 9), 9))
  let fallback = () -> Int {
    77
  }
  assert(eq(result_unwrap_or_else(Ok(3), fallback), 3))
  assert(eq(result_unwrap_or_else(Err("x"), fallback), 77))
  assert(eq(result_or(Ok(8), 1), 8))
  assert(eq(result_or(Err("x"), 1), 1))
  assert(eq(result_or_else(Ok(6), fallback), 6))
  assert(eq(result_or_else(Err("x"), fallback), 77))
  match result_to_option(Ok(12)) {
    Some(v) => assert(eq(v, 12)),
    _ => assert(false)
  }
  match result_to_option(Err("x")) {
    None => assert(true),
    _ => assert(false)
  }
  match result_from_option(Some(4), "missing") {
    Ok(v) => assert(eq(v, 4)),
    _ => assert(false)
  }
  let missing: Option[Int] = None
  match result_from_option(missing, "missing") {
    Err(msg) => assert(string_equals(msg, "missing")),
    _ => assert(false)
  }
}

test "result_equals_by_and_method_style" {
  let int_eq = (a: Int, b: Int) -> Bool {
    a == b
  }
  let str_eq = (a: String, b: String) -> Bool {
    string_equals(a, b)
  }
  assert(result_equals_by(Ok(1), Ok(1), int_eq, str_eq))
  assert(not(result_equals_by(Ok(1), Ok(2), int_eq, str_eq)))
  assert(result_equals_by(Err("x"), Err("x"), int_eq, str_eq))
  assert(not(result_equals_by(Err("x"), Ok(1), int_eq, str_eq)))
  assert(Result::is_ok(Ok(1)))
  assert(Result::is_err(Err("x")))
  assert(Ok(1).is_ok())
  assert(eq(Err("x").unwrap_or(9), 9))
}
