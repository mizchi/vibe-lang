
use ./json.vibe {
  Json, parse, stringify, json_get, json_as_str, json_as_num, json_as_obj
}
export enum RpcId {
  IdNum(Int);
  IdStr(String);
  IdNull
}
export enum RpcMessage {
  Request(String, Json, RpcId);
  Notification(String, Json);
  SuccessResponse(RpcId, Json);
  ErrorResponse(RpcId, Int, String, Json)
}
let require_key = (obj: Map[Json], key: String) -> Json with {
  Error
} {
  if map_has_key(obj, key) {
    map_get(obj, key)
  } else {
    throw(string_concat("missing key: ", key))
  }
}
let get_string = (obj: Map[Json], key: String) -> String with {
  Error
} {
  let v = require_key(obj, key)
  match v {
    JStr(s) => s,
    _ => throw(string_concat("expected string for key: ", key))
  }
}
let parse_rpc_id = (j: Json) -> RpcId with {
  Error
} {
  match j {
    JNum(n) => IdNum(double_to_int(n)),
    JStr(s) => IdStr(s),
    JNull => IdNull,
    _ => throw("invalid id")
  }
}
export let parse_message = (input: String) -> RpcMessage with {
  Error
} {
  let (json, _) = parse(input)
  let obj = match json {
    JObj(m) => m,
    _ => throw("expected object")
  }
  let jsonrpc = get_string(obj, "jsonrpc")
  if jsonrpc != "2.0" {
    throw("invalid jsonrpc version")
  }
  let has_method = map_has_key(obj, "method")
  let has_result = map_has_key(obj, "result")
  let has_error = map_has_key(obj, "error")
  if has_method {
    let method = get_string(obj, "method")
    let params = if map_has_key(obj, "params") {
      map_get(obj, "params")
    } else {
      JNull
    }
    if map_has_key(obj, "id") {
      let id = parse_rpc_id(map_get(obj, "id"))
      Request(method, params, id)
    } else {
      Notification(method, params)
    }
  } else if has_result {
    let id = parse_rpc_id(require_key(obj, "id"))
    let result = map_get(obj, "result")
    SuccessResponse(id, result)
  } else if has_error {
    let id = parse_rpc_id(require_key(obj, "id"))
    let err_json = map_get(obj, "error")
    let err_obj = match err_json {
      JObj(m) => m,
      _ => throw("error must be object")
    }
    let code = match require_key(err_obj, "code") {
      JNum(n) => double_to_int(n),
      _ => throw("error code must be number")
    }
    let message = get_string(err_obj, "message")
    let data = if map_has_key(err_obj, "data") {
      map_get(err_obj, "data")
    } else {
      JNull
    }
    ErrorResponse(id, code, message, data)
  } else {
    throw("invalid message: missing method, result, or error")
  }
}
let rpc_id_json_str = (id: RpcId) -> String {
  match id {
    IdNum(n) => stringify(JNum(int_to_double(n))),
    IdStr(s) => stringify(JStr(s)),
    IdNull => "null"
  }
}
export let stringify_error = (id: RpcId, code: Int, message: String, data: Json) -> String {
  let err_str = string_concat(string_concat(string_concat(string_concat("{\"code\":", stringify(JNum(int_to_double(code)))), ",\"message\":"), stringify(JStr(message))), string_concat(",\"data\":", string_concat(stringify(data), "}")))
  string_concat(string_concat("{\"jsonrpc\":\"2.0\",\"error\":", err_str), string_concat(",\"id\":", string_concat(rpc_id_json_str(id), "}")))
}
export let stringify_request = (method: String, params: Json, id: RpcId) -> String {
  string_concat(string_concat(string_concat(string_concat("{\"jsonrpc\":\"2.0\",\"method\":", stringify(JStr(method))), ",\"params\":"), stringify(params)), string_concat(",\"id\":", string_concat(rpc_id_json_str(id), "}")))
}
export let stringify_response = (id: RpcId, result: Json) -> String {
  string_concat(string_concat("{\"jsonrpc\":\"2.0\",\"result\":", stringify(result)), string_concat(",\"id\":", string_concat(rpc_id_json_str(id), "}")))
}
export let stringify_notification = (method: String, params: Json) -> String {
  string_concat(string_concat(string_concat("{\"jsonrpc\":\"2.0\",\"method\":", stringify(JStr(method))), ",\"params\":"), string_concat(stringify(params), "}"))
}
export {
  RpcId, RpcMessage, parse_message, stringify_error, stringify_request, stringify_response, stringify_notification
}
