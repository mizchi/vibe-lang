// SHA-1 hash (RFC 3174)
// Produces a 40-character lowercase hex string.

// 32-bit mask: 0xFFFFFFFF constructed without overflow
let mask32 = (65535 << 16) | 65535

// Unsigned right shift for 32-bit values (>> is arithmetic in vibe)
let ushr = (x: Int, n: Int) -> Int {
  if n == 0 { x }
  else if n >= 32 { 0 }
  else {
    (x >> n) & ((1 << (32 - n)) - 1)
  }
}

// 32-bit left rotate
let rotl = (x: Int, n: Int) -> Int {
  ((x << n) | ushr(x, 32 - n)) & mask32
}

// 32-bit addition (mod 2^32)
let add32 = (a: Int, b: Int) -> Int { (a + b) & mask32 }

// SHA-1 initial hash values
let h0_init = 1732584193                // 0x67452301
let h1_init = (61389 << 16) | 43913    // 0xEFCDAB89
let h2_init = (39098 << 16) | 56574    // 0x98BADCFE
let h3_init = 271733878                 // 0x10325476
let h4_init = (50130 << 16) | 57840    // 0xC3D2E1F0

// SHA-1 round constants
let k0 = 1518500249                     // 0x5A827999
let k1 = 1859775393                     // 0x6ED9EBA1
let k2 = (36635 << 16) | 48348         // 0x8F1BBCDC
let k3 = (51810 << 16) | 49622         // 0xCA62C1D6

// Hex encoding helpers
let hex_table = "0123456789abcdef"
let to_hex_char = (i: Int) -> String {
  hex_table.string_substring(i, i + 1)
}
let byte_to_hex = (b: Int) -> String {
  to_hex_char((b >> 4) & 15).string_concat(to_hex_char(b & 15))
}
let word_to_hex = (w: Int) -> String {
  byte_to_hex(ushr(w, 24) & 255)
    .string_concat(byte_to_hex(ushr(w, 16) & 255))
    .string_concat(byte_to_hex(ushr(w, 8) & 255))
    .string_concat(byte_to_hex(w & 255))
}

// --- String-based 32-bit word array ---
// Store words as 4-byte big-endian sequences in a string

let word_to_bytes = (w: Int) -> String {
  string_from_char_code(ushr(w, 24) & 255)
    .string_concat(string_from_char_code(ushr(w, 16) & 255))
    .string_concat(string_from_char_code(ushr(w, 8) & 255))
    .string_concat(string_from_char_code(w & 255))
}

let read_word = (s: String, idx: Int) -> Int {
  let offset = idx * 4
  let b0 = s.string_char_code_at(offset)
  let b1 = s.string_char_code_at(offset + 1)
  let b2 = s.string_char_code_at(offset + 2)
  let b3 = s.string_char_code_at(offset + 3)
  ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & mask32
}

// Build message schedule (80 words) from a 64-byte block
let build_schedule = (msg: String, block_start: Int) -> String {
  // First 16 words directly from message
  let rec build_initial = (i: Int, acc: String) -> String {
    if i >= 16 { acc }
    else {
      let w = read_word(msg, block_start / 4 + i)
      build_initial(i + 1, acc.string_concat(word_to_bytes(w)))
    }
  }
  let initial = build_initial(0, "")

  // Expand words 16-79
  let rec expand = (i: Int, arr: String) -> String {
    if i >= 80 { arr }
    else {
      let w = rotl(
        read_word(arr, i - 3) ^ read_word(arr, i - 8) ^ read_word(arr, i - 14) ^ read_word(arr, i - 16),
        1
      )
      expand(i + 1, arr.string_concat(word_to_bytes(w)))
    }
  }
  expand(16, initial)
}

// Process 80 rounds for one block
let rec process_rounds = (i: Int, a: Int, b: Int, c: Int, d: Int, e: Int, w: String) -> String {
  if i >= 80 {
    word_to_bytes(a).string_concat(word_to_bytes(b)).string_concat(word_to_bytes(c))
      .string_concat(word_to_bytes(d)).string_concat(word_to_bytes(e))
  } else {
    let f = if i < 20 {
      (b & c) ^ ((b ^ mask32) & d)
    } else if i < 40 {
      b ^ c ^ d
    } else if i < 60 {
      (b & c) ^ (b & d) ^ (c & d)
    } else {
      b ^ c ^ d
    }
    let k = if i < 20 { k0 }
      else if i < 40 { k1 }
      else if i < 60 { k2 }
      else { k3 }
    let temp = add32(add32(add32(add32(rotl(a, 5), f), e), k), read_word(w, i))
    process_rounds(i + 1, temp, a, rotl(b, 30), c, d, w)
  }
}

// Pad message according to SHA-1 spec
let pad_message = (msg: String) -> String {
  let len = msg.string_length()
  let bit_len = len * 8

  // Append 0x80
  let padded = msg.string_concat(string_from_char_code(128))

  // Pad with zeros until length ≡ 56 (mod 64)
  let rec pad_zeros = (s: String) -> String {
    if s.string_length() % 64 == 56 { s }
    else { pad_zeros(s.string_concat(string_from_char_code(0))) }
  }
  let padded2 = pad_zeros(padded)

  // Append 64-bit big-endian length (high 4 bytes are 0 for short messages)
  padded2
    .string_concat(string_from_char_code(0))
    .string_concat(string_from_char_code(0))
    .string_concat(string_from_char_code(0))
    .string_concat(string_from_char_code(0))
    .string_concat(string_from_char_code(ushr(bit_len, 24) & 255))
    .string_concat(string_from_char_code(ushr(bit_len, 16) & 255))
    .string_concat(string_from_char_code(ushr(bit_len, 8) & 255))
    .string_concat(string_from_char_code(bit_len & 255))
}

// Process all blocks
let rec process_blocks = (msg: String, block_idx: Int, num_blocks: Int, h0: Int, h1: Int, h2: Int, h3: Int, h4: Int) -> String {
  if block_idx >= num_blocks {
    word_to_hex(h0)
      .string_concat(word_to_hex(h1))
      .string_concat(word_to_hex(h2))
      .string_concat(word_to_hex(h3))
      .string_concat(word_to_hex(h4))
  } else {
    let w = build_schedule(msg, block_idx * 64)
    let result = process_rounds(0, h0, h1, h2, h3, h4, w)
    let new_h0 = add32(h0, read_word(result, 0))
    let new_h1 = add32(h1, read_word(result, 1))
    let new_h2 = add32(h2, read_word(result, 2))
    let new_h3 = add32(h3, read_word(result, 3))
    let new_h4 = add32(h4, read_word(result, 4))
    process_blocks(msg, block_idx + 1, num_blocks, new_h0, new_h1, new_h2, new_h3, new_h4)
  }
}

// Public API
export let sha1 = (msg: String) -> String {
  let padded = pad_message(msg)
  let num_blocks = padded.string_length() / 64
  process_blocks(padded, 0, num_blocks, h0_init, h1_init, h2_init, h3_init, h4_init)
}

export let String::sha1 = (s: String) -> String { sha1(s) }
