//# Imports

use ./index.vibe {
  encode, decode, stringify, parse, parse_ok, sha1
}

//# Misc

test "encoding index exports core symbols" {
  let text = "vibe"
  let encoded = encode(text)
  assert(string_equals(decode(encoded), text))
  assert(parse_ok("{\"a\":1}"))
  let (json_str, _) = parse("\"ok\"")
  assert(eq(string_length(stringify(json_str)), 4))
  assert(eq(string_length(sha1("abc")), 40))
}
