//# Imports

import ./index.vibe {
  encode, decode, stringify, parse, parse_ok, sha1,
  base64_encode, base64_decode, json_parse, json_parse_ok, json_stringify, sha1_hash
}

//# Misc

test "encoding index exports core symbols" {
  let text = "vibe"
  let encoded = encode(text)
  assert(string_equals(decode(encoded), text))
  assert(parse_ok("{\"a\":1}"))
  let (json_str, _) = parse("\"ok\"")
  assert(eq(string_length(stringify(json_str)), 4))
  assert(eq(string_length(sha1("abc")), 40))
}

test "encoding index exports canonical aliases" {
  let text = "vibe"
  let encoded = base64_encode(text)
  assert(string_equals(base64_decode(encoded), text))
  assert(json_parse_ok("{\"a\":1}"))
  let (json_str, _) = json_parse("\"ok\"")
  assert(eq(string_length(json_stringify(json_str)), 4))
  assert(eq(string_length(sha1_hash("abc")), 40))
}
