//# Imports

import ./base64.vibe {
  encode, decode
}

//# Misc

bench "encode short" {
  let _ = encode("Hello, Base64!")
}

bench "decode short" {
  let _ = decode("SGVsbG8sIEJhc2U2NCE=")
}

bench "encode medium" {
  let _ = encode("abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789")
}

bench "decode medium" {
  let _ = decode("YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5")
}

bench "round-trip" {
  let _ = decode(encode("The quick brown fox jumps over the lazy dog"))
}
