use ./json.vibe { Json, parse, stringify, parse_ok, parse_err }

test "parse_null" {
  let (j, _) = parse("null")
  match j {
    JNull => assert(true),
    _ => assert(false)
  }
}

test "parse_array" {
  let (j, _) = parse("[1,2,3]")
  match j {
    JArr(_) => assert(true),
    _ => assert(false)
  }
}

test "parse_object_multi" {
  let (j, _) = parse("{\"a\":1,\"b\":2}")
  match j {
    JObj(_) => assert(true),
    _ => assert(false)
  }
}

test "parse_complex" {
  let (j, _) = parse("{\"name\":\"vibe\",\"nums\":[1.5,2,3.25],\"ok\":true,\"meta\":null}")
  match j {
    JObj(_) => assert(true),
    _ => assert(false)
  }
}

test "roundtrip_array" {
  let (parsed, _) = parse("[1,2,3]")
  assert(string_equals(stringify(parsed), "[1,2,3]"))
}

test "parse_ok_test" {
  assert(parse_ok("null"))
  assert(parse_ok("42"))
  assert(parse_ok("\"hello\""))
  assert(parse_ok("[1,2]"))
  assert(parse_ok("{\"a\":1}"))
}

test "parse_err_test" {
  assert(parse_err("true false"))
  assert(parse_err(""))
}
