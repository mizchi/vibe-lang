//# Imports

import ./sha1.vibe {
  sha1
}

//# Misc

bench "sha1 empty" {
  let _ = sha1("")
}

bench "sha1 short" {
  let _ = sha1("Hello, SHA-1!")
}

bench "sha1 medium" {
  let _ = sha1("abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789")
}

bench "sha1 abc" {
  let _ = sha1("abc")
}
