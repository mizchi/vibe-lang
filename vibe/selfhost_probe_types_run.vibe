//# Imports

import ./compiler / lexer.vibe {
  lex
}

import ./compiler / parser.vibe {
  parse_program
}

import ./compiler / printer.vibe {
  print_program
}

//# Functions

let check_file = (path: String, strict: Bool) -> String with { Fs } {
  handle {
    let source = Fs::read_file(path)
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let printed = print_program(stmts)
    if strict {
      let tokens2 = lex(printed)
      let stmts2 = parse_program(tokens2)
      let printed2 = print_program(stmts2)
      if String::equals(printed, printed2) {
        "OK"
      }
      else {
        "MISMATCH"
      }
    } else {
      "OK"
    }
  } {
    Error(msg) => msg
  }
}

let main = () -> String with { Fs } {
  check_file("vibe/compiler/types.vibe", false)
}
