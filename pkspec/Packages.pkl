/// Canonical list of vibe-lang MoonBit packages that pkfire and pkspec
/// both shard tests over. Single source of truth — keep this in sync
/// with `src/<pkg>/moon.pkg.json` declarations. Adding a package here
/// makes it appear as both a `pkf run test:<pkg>` target and a
/// `moon-test-<pkg>-native` pkspec test.
module pkspec.Packages

/// Package paths relative to `src/`. Path separators stay `/`; pkfire
/// rewrites them to `-` for task-name use, pkspec keeps `-` for the
/// test name and translates back to `/` for the moon CLI invocation.
all: List<String> =
  List(
    "backend",
    "benches",
    "capability",
    "checker",
    "cmd/fbgen",
    "cmd/parser_contract",
    "cmd/typecheck_fixture",
    "cmd/vibe",
    "cmd/vibe_check_wasi",
    "cmd/vibe_compile_wasi",
    "cmd/vibe_wasm",
    "cmd/vibe_wite_optimize_wasi",
    "cmd/warning_fixture",
    "codebase",
    "codegen",
    "core",
    "frontend",
    "fs",
    "io",
    "lib",
    "loader",
    "lsp",
    "parser",
    "pipeline",
    "profiler",
    "runtime",
    "runtime_compile",
    "tests",
    "x/fp",
    "x/module_graph",
    "x/scoped_map",
    "x/threads",
  )

/// Canonical task-name form (pkfire). `cmd/vibe` → `test:cmd-vibe`.
function taskName(pkg: String): String = "test:\(pkg.replaceAll("/", "-"))"

/// Canonical pkspec test-name form. Mirrors `taskName` but drops the
/// `test:` prefix in favour of `moon-test-<...>-native` so it reads as
/// a runnable command rather than a Pkl identifier.
function specTestName(pkg: String): String = "moon-test-\(pkg.replaceAll("/", "-"))-native"
