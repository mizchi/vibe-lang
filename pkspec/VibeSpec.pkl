/// pkspec Spec for vibe-lang — high-level test goals and the
/// scenarios that VibeTest.pkl implements.
///
/// Usage:
///   pkspec check pkspec/VibeSpec.pkl pkspec/VibeTest.pkl   # CI gate
///   pkspec next pkspec/VibeSpec.pkl pkspec/VibeTest.pkl    # what to do next
///   pkspec coverage pkspec/VibeSpec.pkl pkspec/VibeTest.pkl
///
/// `Spec.pkl` is part of the schemas generated by `pkspec init --dir pkspec`
/// (git-ignored). Run that once after cloning.
amends "./Spec.pkl"

import "./Packages.pkl"

feature = "vibe-lang-test-runner"

goals {
  new Goal {
    id = "GOAL.test-coverage"
    name = "`moon test` keeps every supported target green"
    priority = 80
    reviewStatus = "approved"
    description =
      """
      Contributors expect a single command to confirm the full test
      suite passes on the targets we ship (native + JS). Anything that
      regresses one of those targets blocks the next release.
      """
  }

  new Goal {
    id = "GOAL.test-isolation"
    name = "every package can be tested in isolation"
    priority = 70
    reviewStatus = "approved"
    description =
      """
      `pkf affected --since=origin/main 'test:*'` and
      `pkspec exec --shard` need each package's tests to run as an
      independent moon invocation. A regression that breaks per-package
      isolation (e.g. cross-package test fixture leakage) defeats the
      diff-aware fast lane and forces every PR back to the full suite.
      """
  }
}

/// Per-package scenario factory. Each package gets its own
/// `VIBE-TEST-PKG-<name>` scenario so `pkspec coverage` shows per-package
/// implementation status, and broken packages can be tagged for triage
/// without disabling the umbrella `VIBE-TEST-NATIVE` gate.
local function pkgScenario(pkg: String) = new Scenario {
  id = "VIBE-TEST-PKG-\(pkg.replaceAll("/", "-").toUpperCase())"
  name = "moon_test_native_\(pkg.replaceAll("/", "_"))_passes"
  description = "`moon test --target native -p mizchi/vibe/\(pkg)` returns exit code 0."
  reviewStatus = "approved"
  severity = "major"
  contributes { "GOAL.test-isolation" }
  tags { "spec"; "per-package" }
}

scenarios {
  new {
    id = "VIBE-TEST-NATIVE"
    name = "moon_test_native_passes"
    description = "`moon test --target native` returns exit code 0 across all packages."
    reviewStatus = "approved"
    severity = "critical"
    contributes { "GOAL.test-coverage" }
    tags { "spec" }
  }

  new {
    id = "VIBE-TEST-JS"
    name = "moon_test_js_passes"
    description =
      "`moon test --target js -v` returns exit code 0 — the same command flaker uses for CI sampling."
    reviewStatus = "approved"
    severity = "critical"
    contributes { "GOAL.test-coverage" }
    tags { "spec" }
  }

  for (p in Packages.all) {
    pkgScenario(p)
  }
}
