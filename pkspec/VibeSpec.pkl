/// pkspec Spec for vibe-lang — high-level test goals and the
/// scenarios that VibeTest.pkl currently implements.
///
/// Usage:
///   pkspec check pkspec/VibeSpec.pkl pkspec/VibeTest.pkl   # CI gate
///   pkspec next pkspec/VibeSpec.pkl pkspec/VibeTest.pkl    # what to do next
///   pkspec coverage pkspec/VibeSpec.pkl pkspec/VibeTest.pkl
///
/// `Spec.pkl` is part of the schemas generated by `pkspec init --dir pkspec`
/// (git-ignored). Run that once after cloning.
amends "./Spec.pkl"

feature = "vibe-lang-test-runner"

goals {
  new Goal {
    id = "GOAL.test-coverage"
    name = "`moon test` keeps every supported target green"
    priority = 80
    reviewStatus = "approved"
    description = """
      Contributors expect a single command to confirm the full test
      suite passes on the targets we ship (native + JS). Anything that
      regresses one of those targets blocks the next release.
      """
  }
}

scenarios {
  new {
    id = "VIBE-TEST-NATIVE"
    name = "moon_test_native_passes"
    description = "`moon test --target native` returns exit code 0 across all packages."
    reviewStatus = "approved"
    severity = "critical"
    contributes { "GOAL.test-coverage" }
    tags { "spec" }
  }

  new {
    id = "VIBE-TEST-JS"
    name = "moon_test_js_passes"
    description = "`moon test --target js -v` returns exit code 0 — the same command flaker uses for CI sampling."
    reviewStatus = "approved"
    severity = "critical"
    contributes { "GOAL.test-coverage" }
    tags { "spec" }
  }
}
