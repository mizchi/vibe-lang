import ./lib/@vibe/prelude/io.vibe { stdout_write }
import ./lib/@vibe/compiler/codegen { compile_wasi_module }
import ./lib/@vibe/compiler/tests/selfhost_s5_test_support.vibe { load_selfhost_merged }

let p: (String) -> Unit with { Stdout } = (s) -> {
  stdout_write(String::concat(s, "\n"))
}

test "s5e dbg" {
  handle {
    let bytes = compile_wasi_module(load_selfhost_merged(), "selfbuild_entry")
    p(String::concat("bytes.len=", Int::to_string(Bytes::length(bytes))))
  } with Error {
    Throw(msg) => p(String::concat("THROWN: ", msg))
  }
}
