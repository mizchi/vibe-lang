// SIMD memchr (ADR-0054) correctness for String::index_of / String::contains,
// run via the compiled wasm backend (wasmtime). The first-byte scan uses
// i8x16.splat + i8x16.eq + v128.any_true to skip 16-byte windows. (The in-tree
// wasm eval interpreter does not yet model this scan; this is the
// authoritative correctness check — see ADR-0054.)
let rec repeat : (String, Int) -> String = (s, n) -> {
  if n == 0 { "" } else { String::concat(s, repeat(s = s, n = n - 1)) }
}

test "index_of: short (no SIMD window)" {
  assert_eq(String::index_of("abcdef", needle = "abc"), 0)
  assert_eq(String::index_of("xxabcyy", needle = "abc"), 2)
  assert_eq(String::index_of("hello", needle = "zzz"), -1)
  assert_eq(String::index_of("ab", needle = "abc"), -1)
  assert_eq(String::index_of("abc", needle = ""), 0)
}

test "index_of: SIMD window scan (len > 16)" {
  assert_eq(String::index_of("0123456789abcdefABCDEF", needle = "ABC"), 16)
  assert_eq(String::index_of("0123456789abcdefGHIJKLMNOP", needle = "Q"), -1)
  assert_eq(String::index_of("xxxxxxxxxxxxxxxxNEEDLExx", needle = "NEEDLE"), 16)
  assert_eq(String::index_of(repeat(s = "0123456789abcdef", n = 64), needle = "G"), -1)
  assert_eq(String::index_of(String::concat("X0X1X2X3X4X5X6X7X8", "Xtarget"), needle = "Xtarget"), 18)
  assert_eq(String::index_of(repeat(s = "0123456789abcdef", n = 8), needle = "abZ"), -1)
  assert_eq(String::index_of(String::concat(repeat(s = "0123456789abcdef", n = 3), "ABCXX"), needle = "ABC"), 48)
}

test "contains: SIMD window scan" {
  assert_eq(String::contains("hello world", needle = "world"), true)
  assert_eq(String::contains(repeat(s = "0123456789abcdef", n = 64), needle = "G"), false)
  assert_eq(String::contains(repeat(s = "0123456789abcdef", n = 64), needle = "cdef0123"), true)
  assert_eq(String::contains("0123456789abcdef", needle = "cdef"), true)
}
