//# Misc

test "set new and size" {
  let s = Set::new()
  assert(Set::size(s) == 0)
}

test "set add and contains" {
  let s0 = Set::new()
  let s1 = Set::add(s0, 1)
  let s2 = Set::add(s1, 2)
  let s3 = Set::add(s2, 3)
  assert(Set::size(s3) == 3)
  assert(Set::contains(s3, 1))
  assert(Set::contains(s3, 2))
  assert(Set::contains(s3, 3))
  assert(not(Set::contains(s3, 4)))
}

test "set remove" {
  let s0 = Set::new()
  let s1 = Set::add(s0, 10)
  let s2 = Set::add(s1, 20)
  let s3 = Set::remove(s2, 10)
  assert(Set::size(s3) == 1)
  assert(not(Set::contains(s3, 10)))
  assert(Set::contains(s3, 20))
}

test "set add duplicate" {
  let s0 = Set::new()
  let s1 = Set::add(s0, 5)
  let s2 = Set::add(s1, 5)
  assert(Set::size(s2) == 1)
}

test "set from_array" {
  let s = Set::from_array([1, 2, 3, 2, 1])
  assert(Set::size(s) == 3)
  assert(Set::contains(s, 1))
  assert(Set::contains(s, 2))
  assert(Set::contains(s, 3))
}

test "set to_array" {
  let s = Set::from_array([10, 20])
  let arr = Set::to_array(s)
  assert(Array::length(arr) == 2)
}

test "set immutability" {
  let s1 = Set::add(Set::new(), 1)
  let s2 = Set::add(s1, 2)
  assert(Set::size(s1) == 1)
  assert(Set::size(s2) == 2)
}

test "set string keys" {
  let s0 = Set::new()
  let s1 = Set::add(s0, "a")
  let s2 = Set::add(s1, "b")
  assert(Set::contains(s2, "a"))
  assert(Set::contains(s2, "b"))
  assert(not(Set::contains(s2, "c")))
}
