// Test: HTTP builtins on WASM throw catchable errors instead of trapping.
// This file is designed for --backend wasm execution.
// On native/interpreter, HTTP builtins actually work, so these tests
// verify handle structure only (both paths are valid).

test "Http::request handle compiles to wasm" {
  let result = handle {
    let h = Http::request("GET", "http://127.0.0.1:1/x", "", "")
    h
  } {
    Error(_) => -1
  }
  // On wasm: result == -1 (throw caught)
  // On native: result == -1 (connection refused, backend returns Err)
  assert(result == -1)
}

test "Http::response_status handle compiles to wasm" {
  let result = handle {
    Http::response_status(9999)
  } {
    Error(_) => -1
  }
  // Both wasm and native return error for invalid handle
  assert(result == -1)
}

test "Http::close handle compiles to wasm" {
  let result = handle {
    Http::close(9999)
    1
  } {
    Error(_) => -1
  }
  // Both wasm and native: invalid handle -> error
  assert(result == -1)
}
