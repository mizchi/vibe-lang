// Test: HTTP builtins on WASM raise catchable errors instead of trapping.
// This file is designed for --backend wasm execution.
// On native/interpreter, HTTP builtins actually work, so these tests
// verify try/catch structure only (both paths are valid).

test "http_request try-catch compiles to wasm" {
  let result = try {
    let h = http_request("GET", "http://127.0.0.1:1/x", "", "")
    h
  } catch {
    -1
  }
  // On wasm: result == -1 (raise caught)
  // On native: result == -1 (connection refused, backend returns Err)
  assert(result == -1)
}

test "http_response_status try-catch compiles to wasm" {
  let result = try {
    http_response_status(9999)
  } catch {
    -1
  }
  // Both wasm and native return error for invalid handle
  assert(result == -1)
}

test "http_close try-catch compiles to wasm" {
  let result = try {
    http_close(9999)
    1
  } catch {
    -1
  }
  // Both wasm and native: invalid handle -> error
  assert(result == -1)
}
